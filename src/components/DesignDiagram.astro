---
// Shared study-design timeline. Include once per builder page, then in the
// page's render() build a spec and call:
//   window.renderDesignDiagram(diagramEl, legendEl, spec)
//
// ── Putting the diagram into the Word export (HARPER item 7.2) ──────────
// HARPER REQUIRES a study design diagram. Every builder on this site drew one
// on screen and shipped a .docx without it, so every generated protocol failed
// a mandatory item — confirmed by running the site's own output through the
// site's own Protocol Checker. In buildDocx (NOT in render — see below):
//
//   const fig = await window.designDiagramFigure(document.getElementById("diagram"));
//   const figParas = window.designDiagramDocx(D, fig, { font: FONT });
//   figParas.forEach((c) => children.push(c));
//   if (!figParas.placed) setMsg("Exported without the design diagram: " +
//     (fig.reason || figParas.error) + ". The document says so where the figure
//     should be.", true);
//
// designDiagramDocx returns the picture, a numbered caption and a plain-text
// list of the windows. The text matters as much as the picture: a reviewer or
// an automated checker reading the .docx as text cannot see an embedded image
// at all, so a diagram with no caption is invisible to them. On failure it
// returns a visible note in the document saying the diagram is missing and why
// — never a silently absent figure — and sets `.placed = false` so the page can
// tell the user which of the two they got.
//
// CONTRACT, because several builders call renderDesignDiagram from a live
// keystroke-driven render loop, ahead of their consistency checks and their
// autosave:
//   * Nothing here rasterises on the render path. renderDesignDiagram adds only
//     a try-caught WeakMap write; all canvas work is in svgToPng/
//     designDiagramFigure, which are async and meant to be called at EXPORT time.
//   * svgToPng and designDiagramFigure never throw and never reject — they
//     resolve to { ok: false, reason }. designDiagramDocx never throws either.
//     A throw from here would otherwise skip a caller's checks panel and its
//     localStorage autosave while the page still promised "Auto-saved", and the
//     only trace would be a console error nobody has open.
// spec = {
//   windows: [{ label, kind, startDay, endDay, note? }],  // days relative to index (day 0)
//   indexLabel?: "Index (day 0)",   // vertical anchor line
//   unit?: "d",                       // axis unit suffix (default "d")
// }
// Kinds → colours: lookback, washout, eligibility, inclusion, exclusion,
// exposure, grace, followup, risk, control, hazard, outcome, study.
---

<script is:inline>
  (function () {
    const K = {
      lookback:    { c: "#8b5cf6", l: "Covariate look-back" },
      washout:     { c: "#6366f1", l: "Washout / new-user" },
      eligibility: { c: "#6366f1", l: "Eligibility assessment" },
      inclusion:   { c: "#0ea5e9", l: "Inclusion window" },
      exclusion:   { c: "#f43f5e", l: "Exclusion window" },
      exposure:    { c: "#14b8a6", l: "Exposure" },
      grace:       { c: "#f59e0b", l: "Grace period" },
      followup:    { c: "#10b981", l: "Follow-up" },
      risk:        { c: "#ec4899", l: "Risk window" },
      control:     { c: "#94a3b8", l: "Control window" },
      hazard:      { c: "#ef4444", l: "Hazard window" },
      outcome:     { c: "#dc2626", l: "Outcome window" },
      study:       { c: "#64748b", l: "Study period" },
    };
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    function fmtDay(d) {
      if (!d) return "0";
      const a = Math.abs(d), s = d < 0 ? "−" : "+";
      if (a >= 365) { const y = a / 365; return s + (Number.isInteger(y) ? y : y.toFixed(1)) + "y"; }
      if (a >= 60) { const mo = Math.round(a / 30); return s + (mo % 12 === 0 ? mo / 12 + "y" : mo + "mo"); }
      return s + a + "d";
    }

    // The spec behind whatever is currently drawn in each container, so the
    // Word export can describe the picture in words as well as embed it.
    const lastSpec = new WeakMap();

    window.renderDesignDiagram = function (diagramEl, legendEl, spec) {
      if (!diagramEl) return;
      try { lastSpec.set(diagramEl, spec); } catch (e) {}
      const wins = (spec.windows || []).filter((w) => w && Number.isFinite(+w.startDay) && Number.isFinite(+w.endDay));
      if (!wins.length) { diagramEl.innerHTML = ""; if (legendEl) legendEl.innerHTML = ""; return; }
      // Row order: sort by start day when idle, but FREEZE that order while an
      // edge is being dragged — otherwise the dragged bar would swap rows every
      // time its start crosses a neighbour's, which feels like the bars "stick"
      // to each other and jump.
      const keyOf = (w) => w.edit ? (w.edit.field + "#" + (w.edit.idx == null ? "" : w.edit.idx)) : ("_" + w.kind + "#" + (w.label || ""));
      let rows;
      if (window.__diagAxis && window.__diagRowKeys) {
        const ord = window.__diagRowKeys;
        const rank = (w) => { const i = ord.indexOf(keyOf(w)); return i < 0 ? 1e6 : i; };
        rows = wins.slice().sort((a, b) => rank(a) - rank(b));
      } else {
        rows = wins.slice().sort((a, b) => a.startDay - b.startDay);
        window.__diagRowKeys = rows.map(keyOf);
      }
      let lo = 0, hi = 0;
      for (const w of rows) { lo = Math.min(lo, w.startDay, w.endDay); hi = Math.max(hi, w.startDay, w.endDay); }
      if (lo === hi) hi = lo + 1;
      const pad = (hi - lo) * 0.04 || 1; lo -= pad; hi += pad;
      // While an edge is being dragged, freeze the axis so bars track the cursor.
      if (window.__diagAxis) { lo = window.__diagAxis.lo; hi = window.__diagAxis.hi; }

      const W = 860, plotL = 205, plotR = W - 18, plotW = plotR - plotL;
      const rowH = 30, top = 56, H = top + rows.length * rowH + 30;
      const x = (d) => plotL + ((d - lo) / (hi - lo)) * plotW;
      const x0 = x(0);
      let svg = '<svg viewBox="0 0 ' + W + ' ' + H + '" class="w-full h-auto" style="min-width:640px" xmlns="http://www.w3.org/2000/svg">';
      // index anchor
      svg += '<line x1="' + x0 + '" y1="28" x2="' + x0 + '" y2="' + (H - 16) + '" stroke="#0f766e" stroke-width="1.5" stroke-dasharray="4 3"/>';
      // Keep the index label inside the plot. When day 0 sits at the right-hand
      // edge — every look-back-only design, e.g. case-control — a centred label
      // hangs off the canvas and is cut off on screen and in the exported PNG.
      const idxAnchor = x0 > plotR - 90 ? "end" : x0 < plotL + 90 ? "start" : "middle";
      const idxX = idxAnchor === "end" ? plotR : idxAnchor === "start" ? plotL : x0;
      svg += '<text x="' + idxX + '" y="18" text-anchor="' + idxAnchor + '" font-size="11" font-weight="700" fill="#0f766e">' + esc(spec.indexLabel || "Index (day 0)") + '</text>';
      // baseline axis
      svg += '<line x1="' + plotL + '" y1="' + (H - 16) + '" x2="' + plotR + '" y2="' + (H - 16) + '" stroke="#cbd5e1"/>';
      const ticks = [...new Set([Math.ceil(lo), 0, Math.floor(hi)])];
      for (const d of ticks) svg += '<text x="' + x(d) + '" y="' + (H - 4) + '" text-anchor="middle" font-size="10" fill="#94a3b8">' + fmtDay(d) + '</text>';
      // rows
      rows.forEach((w, i) => {
        const y = top + i * rowH;
        const meta = K[w.kind] || { c: "#64748b", l: w.kind };
        const xa = x(Math.min(w.startDay, w.endDay)), xb = x(Math.max(w.startDay, w.endDay));
        const ww = Math.max(3, xb - xa);
        svg += '<text x="' + (plotL - 10) + '" y="' + (y + 15) + '" text-anchor="end" font-size="11" fill="#334155">' + esc(w.label || meta.l) + '</text>';
        svg += '<rect x="' + xa + '" y="' + (y + 3) + '" width="' + ww + '" height="18" rx="4" fill="' + meta.c + '" fill-opacity="0.88"/>';
        const dur = w.note || (fmtDay(w.startDay) + " → " + fmtDay(w.endDay));
        if (ww > 90) svg += '<text x="' + (xa + ww / 2) + '" y="' + (y + 16) + '" text-anchor="middle" font-size="9.5" fill="#fff" font-weight="600">' + esc(dur) + '</text>';
        else svg += '<text x="' + (xb + 5) + '" y="' + (y + 16) + '" font-size="9.5" fill="#64748b">' + esc(dur) + '</text>';
        // A window may expose one edge (w.edit) or both (w.edits: [start, end]).
        const edits = w.edits || (w.edit ? [w.edit] : []);
        for (const ed of edits) {
          const ex = ed.edge === "start" ? xa : xb;
          // dd-mark = editing furniture. Visible on the page, stripped from the
          // exported figure: in a formal protocol a reviewer reasonably asks
          // what the little white circles mean, and they carry no information a
          // reader of the figure needs.
          svg += '<line class="dd-mark" x1="' + ex + '" y1="' + (y + 1) + '" x2="' + ex + '" y2="' + (y + 23) + '" stroke="#0f172a" stroke-width="2" stroke-opacity="0.55"/>';
          svg += '<circle class="dd-mark" cx="' + ex + '" cy="' + (y + 12) + '" r="5" fill="#fff" stroke="' + meta.c + '" stroke-width="2"/>';
          svg += '<rect x="' + (ex - 8) + '" y="' + (y - 2) + '" width="16" height="28" fill="#fff" fill-opacity="0.001" class="dd-handle" data-field="' + ed.field + '" data-edge="' + ed.edge + '" data-idx="' + (ed.idx != null ? ed.idx : "") + '" data-past="' + (ed.allowPast ? "1" : "0") + '" style="cursor:ew-resize;touch-action:none"/>';
        }
      });
      // Dashed bands drawn ON TOP of the bars (e.g. a grace period)
      for (const b of (spec.bands || [])) {
        const bx0 = x(Math.min(b.startDay, b.endDay)), bx1 = x(Math.max(b.startDay, b.endDay));
        const col = b.color || "#f59e0b", bw = Math.max(1, bx1 - bx0);
        svg += '<rect x="' + bx0 + '" y="38" width="' + bw + '" height="' + (H - 54) + '" fill="' + col + '" fill-opacity="0.10" stroke="' + col + '" stroke-width="1.25" stroke-dasharray="4 3"/>';
        if (b.label) {
          if (bw >= 52) svg += '<text x="' + ((bx0 + bx1) / 2) + '" y="34" text-anchor="middle" font-size="10" fill="' + col + '" font-weight="700">' + esc(b.label) + '</text>';
          else svg += '<text x="' + (bx1 + 5) + '" y="34" font-size="10" fill="' + col + '" font-weight="700">' + esc(b.label) + '</text>';
        }
        if (b.edit) {
          const ex = b.edit.edge === "start" ? bx0 : bx1;
          svg += '<rect class="dd-mark" x="' + (ex - 2) + '" y="38" width="4" height="' + (H - 54) + '" fill="' + col + '" fill-opacity="0.6" style="pointer-events:none"/>';
          svg += '<rect x="' + (ex - 8) + '" y="30" width="16" height="' + (H - 44) + '" fill="#fff" fill-opacity="0.001" class="dd-handle" data-field="' + b.edit.field + '" data-edge="' + b.edit.edge + '" data-idx="" data-past="' + (b.edit.allowPast ? "1" : "0") + '" style="cursor:ew-resize;touch-action:none"/>';
        }
      }
      diagramEl.innerHTML = svg + "</svg>";

      // ── Drag-to-edit: edges call spec.onEdit(field, dayAtEdge) ──
      // Exactly ONE edge is ever draggable at a time. Each pointermove triggers a
      // re-render that replaces this SVG (and the handle you grabbed) — so we pin
      // the pointer capture to the stable container, keep the drag state in one
      // module-level slot, and always tear down on up OR cancel. Without this, a
      // pointercancel (fired when the grabbed handle is destroyed mid-drag) would
      // leak the move-listener and a later drag of a *different* edge would also
      // move this one.
      if (spec.onEdit) {
        const gLo = lo, gHi = hi, gL = plotL, gW = plotW, snap = spec.snap || 10;
        // NB: do NOT tear down window.__diagDrag here. This block re-runs on the
        // drag's own re-render, so cleaning up here would kill the live drag after
        // its first move. Orphans are prevented at pointerdown + pointercancel.
        const dayAt = (clientX) => {
          const s = diagramEl.querySelector("svg"); if (!s || !s.getScreenCTM) return null;
          const pt = s.createSVGPoint(); pt.x = clientX; pt.y = 0;
          const ctm = s.getScreenCTM(); if (!ctm) return null;
          const ux = pt.matrixTransform(ctm.inverse()).x;
          return Math.round((gLo + ((ux - gL) / gW) * (gHi - gLo)) / snap) * snap;
        };
        diagramEl.querySelectorAll(".dd-handle").forEach((h) => {
          h.addEventListener("pointerdown", (ev) => {
            ev.preventDefault();
            ev.stopPropagation();
            // Never let two edges be live at once.
            if (window.__diagDrag) { window.__diagDrag.cleanup(); }
            const field = h.getAttribute("data-field"), edge = h.getAttribute("data-edge"), allowPast = h.getAttribute("data-past") === "1";
            const idxAttr = h.getAttribute("data-idx"), idx = (idxAttr === "" || idxAttr == null) ? null : parseInt(idxAttr);
            window.__diagAxis = { lo: gLo, hi: gHi };
            const pid = ev.pointerId;
            // Capture on the container (survives the mid-drag innerHTML rebuild),
            // not the handle (which gets destroyed on the first re-render).
            try { diagramEl.setPointerCapture(pid); } catch (e) {}
            // Coalesce moves to one apply per animation frame — a full page
            // re-render on every raw pointermove is what made dragging feel
            // sticky and stutter. We keep the latest day and flush on rAF.
            let pendingDay = null, raf = 0, lastApplied = null;
            const flush = () => {
              raf = 0;
              if (pendingDay == null || pendingDay === lastApplied) return;
              lastApplied = pendingDay;
              spec.onEdit(field, pendingDay, { edge: edge, idx: idx });
            };
            const move = (e) => {
              if (e.pointerId !== pid) return;
              let day = dayAt(e.clientX); if (day == null) return;
              if (edge === "start" && !allowPast) day = Math.min(0, day);
              if (edge === "end" && !allowPast) day = Math.max(snap, day);
              pendingDay = day;
              if (!raf) raf = requestAnimationFrame(flush);
            };
            const end = (e) => {
              if (e && e.pointerId != null && e.pointerId !== pid) return;
              document.removeEventListener("pointermove", move);
              document.removeEventListener("pointerup", end);
              document.removeEventListener("pointercancel", end);
              if (raf) { cancelAnimationFrame(raf); raf = 0; }
              flush(); // apply the final position
              try { diagramEl.releasePointerCapture(pid); } catch (e2) {}
              window.__diagAxis = null;
              window.__diagRowKeys = null;
              window.__diagDrag = null;
              if (spec.onEditEnd) spec.onEditEnd();
            };
            window.__diagDrag = { cleanup: end };
            document.addEventListener("pointermove", move);
            document.addEventListener("pointerup", end);
            document.addEventListener("pointercancel", end);
          });
        });
      }

      if (legendEl) {
        const kinds = [...new Set(rows.map((w) => w.kind))];
        let html = kinds.map((k) => {
          const m = K[k] || { c: "#64748b", l: k };
          return '<span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm" style="background:' + m.c + '"></span>' + esc(m.l) + '</span>';
        }).join("");
        for (const b of (spec.bands || [])) {
          const col = b.color || "#f59e0b";
          html += '<span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm" style="border:1.5px dashed ' + col + ';background:' + col + '1a"></span>' + esc(b.label || "band") + '</span>';
        }
        legendEl.innerHTML = html;
      }
    };

    /* ── SVG → PNG, client-side, no dependency ───────────────────────────
       Used to get the study-design diagram into the Word export. Takes an SVG
       ELEMENT (not a container id) so it works for the shared timeline above
       and for the bespoke SVGs individual builders draw.

       The traps, and what is done about each:
       - An <img> renders an SVG in a sandbox with no access to the document's
         stylesheets. The shared diagram styles itself with presentation
         ATTRIBUTES and survives, but a diagram styled by CSS CLASS would come
         out unstyled — black on black. Every painting property is therefore
         read back with getComputedStyle and written inline on the clone.
       - The same sandbox cannot fetch web fonts. Whatever font-family the page
         resolved is kept, and a CJK-capable system chain is appended, so
         Chinese labels do not become boxes.
       - Without explicit width/height on the serialised root, browsers size the
         image inconsistently (Safari treats it as 0 or 300x150).
       - A transparent PNG looks fine on a white Word page and awful anywhere
         else, so the canvas is filled white first.
       - Rasterising at CSS pixels gives a diagram that is visibly soft at print
         size, so it is drawn at 2x (or the device ratio, whichever is larger). */
    const PAINT_PROPS = [
      "fill", "fill-opacity", "fill-rule", "stroke", "stroke-width", "stroke-opacity",
      "stroke-dasharray", "stroke-dashoffset", "stroke-linecap", "stroke-linejoin", "stroke-miterlimit",
      "opacity", "color", "visibility", "paint-order",
      "font-family", "font-size", "font-weight", "font-style", "font-variant", "letter-spacing",
      "word-spacing", "text-anchor", "dominant-baseline", "alignment-baseline",
      "marker-start", "marker-mid", "marker-end", "clip-rule", "shape-rendering",
    ];
    // Appended to every resolved font stack. Web fonts cannot load inside the
    // <img> sandbox, so the export must be able to fall back to something the
    // operating system actually has — including for Chinese and Japanese.
    const FONT_FALLBACK = ', "Noto Sans CJK TC", "Noto Sans CJK JP", "Microsoft JhengHei", "Microsoft YaHei", "PingFang TC", "PingFang SC", "Hiragino Sans", "Malgun Gothic", system-ui, sans-serif';

    function inlineStyles(srcRoot, cloneRoot) {
      const src = [srcRoot].concat([...srcRoot.querySelectorAll("*")]);
      const dst = [cloneRoot].concat([...cloneRoot.querySelectorAll("*")]);
      const n = Math.min(src.length, dst.length);
      for (let i = 0; i < n; i++) {
        let cs;
        try { cs = window.getComputedStyle(src[i]); } catch (e) { continue; }
        if (!cs) continue;
        let css = "";
        for (const p of PAINT_PROPS) {
          const v = cs.getPropertyValue(p);
          // Only empty values are skipped. "none" in particular must be kept —
          // dropping `fill:none` turns an outlined path into a solid black one.
          if (!v) continue;
          css += p + ":" + (p === "font-family" ? v + FONT_FALLBACK : v) + ";";
        }
        if (css) dst[i].setAttribute("style", css + (dst[i].getAttribute("style") || ""));
        dst[i].removeAttribute("class");
      }
    }

    // Resolves to { ok:true, data, dataUrl, width, height, docxWidth, docxHeight }
    // or { ok:false, reason }. It never throws and never rejects: a builder's
    // export must not die because a picture could not be drawn.
    window.svgToPng = async function (svgEl, opts) {
      opts = opts || {};
      try {
        if (!svgEl || svgEl.namespaceURI !== "http://www.w3.org/2000/svg" || svgEl.tagName.toLowerCase() !== "svg") {
          return { ok: false, reason: "no diagram was found on the page to export" };
        }
        // Size: what the page actually laid out, else the viewBox.
        const rect = svgEl.getBoundingClientRect();
        let w = Math.round(rect.width), h = Math.round(rect.height);
        const vb = (svgEl.getAttribute("viewBox") || "").trim().split(/[\s,]+/).map(Number);
        const hasVb = vb.length === 4 && vb.every(Number.isFinite);
        if ((!w || !h) && hasVb) { w = Math.round(vb[2]); h = Math.round(vb[3]); }
        if (!w || !h) return { ok: false, reason: "the diagram has no measurable size (it may be hidden)" };

        // A label near the edge of the viewBox overflows it. On the page that is
        // just a clipped word; in a PNG it is a figure with its own title cut in
        // half. Widen the box to whatever is actually inked before rasterising.
        let vx = hasVb ? vb[0] : 0, vy = hasVb ? vb[1] : 0, vw = hasVb ? vb[2] : w, vh = hasVb ? vb[3] : h;
        const unitPx = w / (vw || w);
        try {
          const bb = svgEl.getBBox();
          if (bb && Number.isFinite(bb.width) && bb.width > 0) {
            const pad = 2;
            const x1 = Math.min(vx, bb.x - pad), y1 = Math.min(vy, bb.y - pad);
            const x2 = Math.max(vx + vw, bb.x + bb.width + pad), y2 = Math.max(vy + vh, bb.y + bb.height + pad);
            vx = x1; vy = y1; vw = x2 - x1; vh = y2 - y1;
          }
        } catch (e) {}
        w = Math.max(1, Math.round(vw * unitPx));
        h = Math.max(1, Math.round(vh * unitPx));

        const clone = svgEl.cloneNode(true);
        // Editing furniture — invisible hit targets AND the visible drag handles
        // — is tagged now but removed AFTER the styles are inlined: inlineStyles
        // walks source and clone in parallel by index, so deleting nodes from the
        // clone first would shift every subsequent element's styles onto its
        // neighbour. Covers the shared diagram's .dd-mark handles and the
        // bespoke ones builders draw (its-handle, tit-handle, [data-field]);
        // any page can opt an element out with data-export="omit".
        clone.querySelectorAll('[data-field], [data-export="omit"], .dd-mark, [class*="handle"]')
          .forEach((el) => el.setAttribute("data-omit", "1"));
        inlineStyles(svgEl, clone);
        clone.querySelectorAll("[data-omit]").forEach((el) => el.remove());
        clone.setAttribute("xmlns", "http://www.w3.org/2000/svg");
        clone.setAttribute("xmlns:xlink", "http://www.w3.org/1999/xlink");
        clone.setAttribute("width", w);
        clone.setAttribute("height", h);
        clone.setAttribute("viewBox", vx + " " + vy + " " + vw + " " + vh);
        clone.setAttribute("preserveAspectRatio", "xMidYMid meet");
        // The on-page copy carries min-width for horizontal scrolling; inside an
        // <img> that only fights the explicit width we just set.
        clone.setAttribute("style", (clone.getAttribute("style") || "").replace(/(^|;)\s*min-width\s*:[^;]*/gi, ""));

        const xml = new XMLSerializer().serializeToString(clone);
        // A Blob carries UTF-8 directly, so accented and CJK labels survive
        // without the base64 round-trip that mangles them.
        const url = URL.createObjectURL(new Blob([xml], { type: "image/svg+xml;charset=utf-8" }));
        let img;
        try {
          img = new Image();
          img.decoding = "sync";
          await new Promise((res, rej) => {
            const timer = setTimeout(() => rej(new Error("timed out")), 15000);
            img.onload = () => { clearTimeout(timer); res(); };
            img.onerror = () => { clearTimeout(timer); rej(new Error("the browser could not render the diagram")); };
            img.src = url;
          });
          if (img.decode) { try { await img.decode(); } catch (e) {} }
        } finally {
          setTimeout(() => URL.revokeObjectURL(url), 5000);
        }

        // 2x minimum so it is not soft in print; capped so a very wide diagram
        // cannot allocate an enormous canvas.
        let scale = opts.scale || Math.max(2, window.devicePixelRatio || 1);
        if (w * scale > 3200) scale = 3200 / w;
        const canvas = document.createElement("canvas");
        canvas.width = Math.max(1, Math.round(w * scale));
        canvas.height = Math.max(1, Math.round(h * scale));
        const ctx = canvas.getContext("2d");
        ctx.fillStyle = opts.background || "#ffffff";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

        let dataUrl;
        try { dataUrl = canvas.toDataURL("image/png"); }
        catch (e) { return { ok: false, reason: "the diagram references an external image, so it cannot be exported" }; }
        const b64 = dataUrl.slice(dataUrl.indexOf(",") + 1);
        const bin = atob(b64);
        const data = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) data[i] = bin.charCodeAt(i);

        // Fit the usable width of a portrait A4/Letter page with 1in margins.
        const maxW = opts.docxMaxWidth || 600;
        const docxWidth = Math.min(maxW, w);
        const docxHeight = Math.round(docxWidth * (h / w));
        return { ok: true, data, dataUrl, width: w, height: h, scale, docxWidth, docxHeight };
      } catch (e) {
        return { ok: false, reason: (e && e.message) ? e.message : String(e) };
      }
    };

    /* Convenience for the builders: pass the container the diagram was rendered
       into (or the <svg> itself, or an id) and get back the picture PLUS the
       word-description of the same windows. */
    window.designDiagramFigure = async function (target, opts) {
      const el = typeof target === "string" ? document.getElementById(target) : target;
      if (!el) return { ok: false, reason: "no diagram container on the page" };
      const svg = el.tagName && el.tagName.toLowerCase() === "svg" ? el : el.querySelector("svg");
      const out = await window.svgToPng(svg, opts);
      let spec = null;
      try { spec = lastSpec.get(el) || null; } catch (e) {}
      out.lines = spec ? describeSpec(spec) : [];
      return out;
    };

    function describeSpec(spec) {
      const lines = [];
      // HARPER 7.2 asks for "time 0, time anchors, and assessment windows".
      // The windows were described but time zero was only ever implicit in each
      // page's caption, and a checker reading the text reasonably called that
      // short of the item. State it outright, once, for every page at a time.
      lines.push("Time zero (day 0): " + (spec.indexLabel || "the index date"));
      for (const w of (spec.windows || [])) {
        if (!Number.isFinite(+w.startDay) || !Number.isFinite(+w.endDay)) continue;
        const meta = K[w.kind] || { l: w.kind };
        lines.push((w.label || meta.l) + ": day " + fmtDay(w.startDay) + " to " + fmtDay(w.endDay) + (w.note ? " (" + w.note + ")" : ""));
      }
      for (const b of (spec.bands || [])) {
        if (!Number.isFinite(+b.startDay) || !Number.isFinite(+b.endDay)) continue;
        lines.push((b.label || "band") + ": day " + fmtDay(b.startDay) + " to " + fmtDay(b.endDay));
      }
      return lines;
    }

    /* Turn the figure into docx children. Pass the `docx` UMD namespace the
       page already loaded. Always returns something: when the picture could not
       be made, it returns a visible note rather than nothing at all. */
    window.designDiagramDocx = function (D, fig, opts) {
      opts = opts || {};
      const out = [];
      try {
        const FONT = opts.font || "Calibri";
        const caption = opts.caption || "Figure 1. Study design diagram — time zero, time anchors and the assessment windows on a day axis relative to the index date.";
        const note = (msg) => new D.Paragraph({
          spacing: { before: 160, after: 40 },
          children: [new D.TextRun({
            text: "[The study design diagram could not be included automatically — " + msg +
              ". HARPER item 7.2 requires a design diagram: please paste a screenshot of the on-screen diagram here before circulating this protocol.]",
            font: FONT, size: 18, italics: true, color: "B45309",
          })],
        });
        let placed = false;
        if (fig && fig.ok && fig.data) {
          // A malformed picture must never take the whole export down with it:
          // a protocol without its figure is far better than no protocol.
          try {
            out.push(new D.Paragraph({
              spacing: { before: 160, after: 40 },
              children: [new D.ImageRun({ data: fig.data, transformation: { width: fig.docxWidth, height: fig.docxHeight } })],
            }));
            placed = true;
          } catch (e) {
            out.length = 0;
            out.push(note("Word rejected the generated picture (" + ((e && e.message) || e) + ")"));
          }
        } else {
          out.push(note((fig && fig.reason) || "unknown reason"));
        }
        out.push(new D.Paragraph({
          spacing: { after: 60 },
          children: [new D.TextRun({ text: caption, font: FONT, size: 16, italics: true, color: "777777" })],
        }));
        // The written version of the same picture. An image is invisible to any
        // reader — human or machine — working from the document's text, which is
        // why a diagram alone does not satisfy a text-based conformance check.
        // Pages that draw their own SVG never register a spec, so fig.lines is
        // empty for them; they can pass their own description as opts.lines.
        const written = (fig && fig.lines && fig.lines.length) ? fig.lines : (opts.lines || []);
        for (const line of written) {
          out.push(new D.Paragraph({ spacing: { before: 0, after: 0 }, children: [new D.TextRun({ text: "•  " + line, font: FONT, size: 18, color: "555555" })] }));
        }
        out.placed = placed;
      } catch (e) {
        // Even the fallback failed. Return nothing rather than throwing: the
        // caller is mid-export and losing the whole document would be worse.
        out.length = 0;
        out.placed = false;
        out.error = (e && e.message) || String(e);
      }
      return out;
    };

    /* Markdown equivalent, for builders that also emit a .md protocol. */
    window.designDiagramMd = function (fig, opts) {
      opts = opts || {};
      const caption = opts.caption || "Figure 1. Study design diagram — time zero, time anchors and the assessment windows on a day axis relative to the index date.";
      let md = "";
      if (fig && fig.ok && fig.dataUrl) md += "![Study design diagram](" + fig.dataUrl + ")\n\n";
      else md += "> **The study design diagram could not be generated automatically** — " + ((fig && fig.reason) || "unknown reason") + ". HARPER item 7.2 requires one; paste a screenshot here.\n\n";
      md += "_" + caption + "_\n\n";
      const written = (fig && fig.lines && fig.lines.length) ? fig.lines : (opts.lines || []);
      for (const line of written) md += "- " + line + "\n";
      return md + "\n";
    };

    // Consistency-check panel: pass [{ level: "error"|"warn"|"info"|"ok", msg }].
    window.renderChecks = function (el, checks) {
      if (!el) return;
      if (!checks || !checks.length) { el.innerHTML = '<div class="flex items-start gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs"><span class="text-emerald-700 font-bold">✓</span><span class="text-slate-700">No consistency issues flagged.</span></div>'; return; }
      const M = {
        error: { c: "text-red-700", bg: "bg-red-50 border-red-200", i: "✕" },
        warn:  { c: "text-amber-700", bg: "bg-amber-50 border-amber-200", i: "!" },
        info:  { c: "text-slate-500", bg: "bg-slate-50 border-slate-200", i: "ⓘ" },
        ok:    { c: "text-emerald-700", bg: "bg-emerald-50 border-emerald-200", i: "✓" },
      };
      el.innerHTML = checks.map((c) => {
        const m = M[c.level] || M.info;
        return '<div class="flex items-start gap-2 rounded-lg border px-3 py-2 text-xs ' + m.bg + '"><span class="' + m.c + ' font-bold shrink-0">' + m.i + '</span><span class="text-slate-700 leading-snug">' + esc(c.msg) + '</span></div>';
      }).join("");
    };
  })();
</script>
