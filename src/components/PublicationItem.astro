---
// One publication row: citation (author bolded) + Full text/PubMed · DOI · Cite.
// Shared by the Publications page and the About page's Selected list so both
// stay identical and update together.
export interface Pub {
  year: string;
  doi: string;
  citation: string;
  pmid?: string;
  pmcid?: string;
  ris?: string;
  cover?: string;   // e.g. "papers/nhird.jpg" under public/images/
  tag?: string;     // category label, e.g. "Data Infrastructure" / "Methodology"
  journal?: string; // overrides the name parsed from the RIS record
}
import JCR_ABBREV from "../data/jcr-journals.json";
interface Props { pub: Pub; hideCover?: boolean }
const { pub, hideCover } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const unesc = (s: string) =>
  s.replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">")
   .replace(/&quot;/g, '"').replace(/&#39;/g, "'");
const highlight = (citation: string) =>
  esc(citation)
    .replace(/Tsai DHT/g, "<strong class='text-slate-900'>Tsai DHT</strong>")
    .replace(/Tsai HT(?!<)/g, "<strong class='text-slate-900'>Tsai HT</strong>");

// The journal name, taken from the RIS record (JO, else T2) unless overridden.
// Anything without one (a preprint) simply gets no JCR link.
const journalOf = (p: Pub): string | null => {
  if (p.journal) return p.journal;
  const m = (p.ris || "").match(/^JO  - (.+?)\r?$/m) || (p.ris || "").match(/^T2  - (.+?)\r?$/m);
  return m ? unesc(m[1].trim()).replace(/^[\s.]+|[\s.]+$/g, "") : null;
};

// Journal Citation Reports — where the journal's impact factor lives.
// Two things this URL is fussy about, both confirmed against a live JCR session:
//   * `journal` must be JCR's own abbreviation ("BRIT J PSYCHIAT"), never the
//     full title — hence the lookup table in jcr-journals.json.
//   * `year` is required. Without it JCR renders the profile shell with every
//     metric as N/A, which looks like a working page but shows nothing.
// Bump JCR_YEAR when the next edition lands (JCR publishes around June).
// JCR needs a Web of Science subscription — off-campus visitors get a sign-in page.
const JCR_YEAR = 2025;
const jcrUrl = (abbrev: string) =>
  `https://jcr.clarivate.com/jcr-jp/journal-profile?journal=${encodeURIComponent(abbrev)}&year=${JCR_YEAR}`;

// The article title, for the cover thumbnail's link label. The thumbnail image
// itself is decorative (alt=""), so without this the link has no accessible
// name and a screen reader announces a bare "link".
const titleOf = (p: Pub): string => {
  const m = (p.ris || "").match(/^TI  - (.+?)\r?$/m);
  return m ? unesc(m[1].trim()).replace(/[\s.]+$/, "") : p.citation;
};

const journal = journalOf(pub);
// No abbreviation on file → no link, rather than one that lands on an empty profile.
const jcrAbbrev = journal ? (JCR_ABBREV as Record<string, string>)[journal] : undefined;

const risName = (p: Pub) =>
  `${(p.citation.split(/[\s,]/)[0] || "ref").replace(/[^A-Za-z]/g, "")}-${p.year}.ris`;

// Full-text link: PubMed Central when the paper is there, else the PubMed
// abstract page (never a direct publisher PDF).
const pt = pub.pmcid
  ? { href: `https://pmc.ncbi.nlm.nih.gov/articles/${pub.pmcid}/`, label: "Full text", title: "Full text on PubMed Central" }
  : pub.pmid
  ? { href: `https://pubmed.ncbi.nlm.nih.gov/${pub.pmid}/`, label: "PubMed", title: "Abstract on PubMed" }
  : null;
---

<li class="border-l-2 pl-4" class:list={[pub.tag ? "border-brand-600" : pub.pmcid ? "border-accent-500" : "border-slate-200"]}>
  <div class="flex gap-4">
    {pub.cover && !hideCover && (
      <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener" aria-label={`${titleOf(pub)} — full article at the publisher`} class="shrink-0">
        <img src={`${base}/images/${pub.cover}`} alt="" width="56" height="79" loading="lazy" class="w-14 rounded ring-1 ring-slate-200 shadow-sm hover:shadow-md transition" />
      </a>
    )}
    <div class="min-w-0 flex-1">
      {pub.tag && (
        <span class="inline-flex items-center mb-1.5 text-[11px] font-bold uppercase tracking-wide text-brand-700 bg-brand-50 rounded-full px-2.5 py-0.5">{pub.tag}</span>
      )}
      <p class="text-sm text-slate-700 leading-relaxed" set:html={highlight(pub.citation)} />
      <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
        {pt && (
          <a href={pt.href} target="_blank" rel="noopener" title={pt.title} class="font-semibold text-brand-700 hover:underline">{pt.label} ↗</a>
        )}
        <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener" class="text-slate-500 hover:text-brand-700 hover:underline">DOI ↗</a>
        {pub.ris && (
          <button type="button" data-ris={pub.ris} data-filename={risName(pub)} title="Download RIS for EndNote / Zotero / Mendeley" class="font-semibold text-brand-700 hover:underline cursor-pointer">⧉ Cite</button>
        )}
        {jcrAbbrev && (
          <a href={jcrUrl(jcrAbbrev)} target="_blank" rel="noopener" title={`${journal} — impact factor on Journal Citation Reports (needs Web of Science access)`} class="text-slate-500 hover:text-brand-700 hover:underline">JCR ↗</a>
        )}
        {pub.pmcid && <span class="text-accent-500 font-medium">Open access</span>}
      </div>
    </div>
  </div>
</li>
