---
// Research map: the countries and databases behind the published papers.
//
// Everything here is derived at build time from publication-tags.json, so the
// map can only show a country or a database that a paper on the Publications
// page actually names. The world outline is drawn to static inline SVG (no map
// library ships to the browser); the small script at the bottom only switches
// which country's panel is visible.
//
//   <ResearchMap />          full, interactive (Networks page)
//   <ResearchMap compact />  picture only (home page), links to the full one
import { geoEqualEarth, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import world from "world-atlas/countries-110m.json";
import {
  ALL_PUBS, tagsOf, DATABASES, COUNTRIES, CORE, MIDAS65,
  paperTitle, paperJournal, paperLead, MAP_STATS,
} from "../data/research";
import type { PubRow } from "../data/research";

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// ── Data ─────────────────────────────────────────────────────────────────
const withDb = (db: string, extra: (p: PubRow) => boolean = () => true) =>
  ALL_PUBS.filter((p) => tagsOf(p.doi).data.includes(db) && extra(p));
const midasPapers = withDb("iqvia-midas");
const trinetxUS = withDb("trinetx", (p) => tagsOf(p.doi).countries.includes("US"));
const trinetxGlobal = withDb("trinetx", (p) => tagsOf(p.doi).countries.includes("GLOBAL"));

interface Entry { key: string; short: string; en: string; zh: string; typeEn: string; typeZh: string; papers: PubRow[] }
const entry = (id: string, papers: PubRow[], over: Partial<Entry> = {}): Entry => ({
  key: id, short: DATABASES[id].short, en: DATABASES[id].name.en, zh: DATABASES[id].name.zh,
  typeEn: DATABASES[id].type.en, typeZh: DATABASES[id].type.zh, papers, ...over,
});

const blocks = CORE.map((c) => {
  const entries: Entry[] = Object.keys(DATABASES)
    .filter((id) => DATABASES[id].country === c)
    .map((id) => entry(id, withDb(id)))
    .filter((e) => e.papers.length)
    .sort((a, b) => b.papers.length - a.papers.length);
  if (c === "US" && trinetxUS.length) {
    entries.push(entry("trinetx", trinetxUS, {
      key: "trinetx-us", short: "TriNetX US", en: "TriNetX US Collaborative Network", zh: "TriNetX 美國協作網絡",
    }));
  }
  if (MIDAS65.includes(c) && midasPapers.length) entries.push(entry("iqvia-midas", midasPapers));
  // Each paper once, newest first, with the databases it used in this country:
  // a paper that used four UK databases is one line, not four.
  const papers = ALL_PUBS
    .map((p) => ({ p, dbs: entries.filter((e) => e.papers.includes(p)).map((e) => e.short) }))
    .filter((x) => x.dbs.length);
  // Person-level databases only: the sales data is the same file in every country.
  const nDb = entries.filter((e) => e.key !== "iqvia-midas").length;
  return { code: c, name: COUNTRIES[c].name, entries, papers, nPapers: papers.length, nDb };
});
const salesOnly = MIDAS65.filter((c) => !CORE.includes(c)).sort((a, b) => COUNTRIES[a].name.en.localeCompare(COUNTRIES[b].name.en));

const stats = MAP_STATS;

// ── Geometry ─────────────────────────────────────────────────────────────
// Equal Earth, centred on the western Pacific so Asia-Pacific sits in the
// middle with Europe to the left and the Americas to the right.
const W = 960;
const projection = geoEqualEarth().rotate([-150, 0]).fitWidth(W, { type: "Sphere" } as any);
const path = geoPath(projection).digits(1);
const H = Math.ceil((path.bounds({ type: "Sphere" } as any)[1][1]) * 0.86); // crop Antarctica
const countries = (feature(world as any, (world as any).objects.countries) as any).features as any[];

const byId: Record<string, string> = {};
for (const [code, c] of Object.entries(COUNTRIES)) if (c.id) byId[c.id] = code;
const shapes = countries
  .filter((f) => f.id !== "010")
  .map((f) => {
    const code = byId[f.id as string];
    const kind = code && CORE.includes(code) ? "core" : code && MIDAS65.includes(code) ? "sales" : "land";
    return { d: path(f) || "", code, kind };
  })
  .filter((s) => s.d);
// Plain land is one path: it is never interactive, and one element is lighter
// than 110.
const land = shapes.filter((s) => s.kind === "land").map((s) => s.d).join("");
const sales = shapes.filter((s) => s.kind === "sales");
const core = shapes.filter((s) => s.kind === "core");

// Markers and labels for the person-level countries. dx/dy/anchor keep the
// labels of close neighbours (Taiwan–Hong Kong, UK–Netherlands) apart.
const LABEL: Record<string, { dx: number; dy: number; anchor: "start" | "end" | "middle" }> = {
  TW: { dx: 10, dy: 4, anchor: "start" },
  KR: { dx: 10, dy: -4, anchor: "start" },
  HK: { dx: -10, dy: 8, anchor: "end" },
  NZ: { dx: 10, dy: 4, anchor: "start" },
  AU: { dx: 0, dy: 22, anchor: "middle" },
  US: { dx: 0, dy: 22, anchor: "middle" },
  GB: { dx: -9, dy: 14, anchor: "end" },
  FI: { dx: 10, dy: -2, anchor: "start" },
  NL: { dx: 10, dy: 12, anchor: "start" },
};
const markers = CORE.map((c) => {
  const [x, y] = projection(COUNTRIES[c].at!) as [number, number];
  const b = blocks.find((k) => k.code === c)!;
  return { code: c, x: +x.toFixed(1), y: +y.toFixed(1), name: COUNTRIES[c].name, nPapers: b.nPapers, nDb: b.nDb, ...LABEL[c] };
});
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? "" : "s"}`;
const doi = (p: PubRow) => `https://doi.org/${p.doi}`;
---

<div class:list={["research-map", compact && "is-compact"]} data-research-map={compact ? undefined : ""}>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role={compact ? "img" : "group"}
    aria-label="World map of the countries and databases behind Daniel Tsai's publications"
    data-i18n-attr="aria-label"
    data-en-aria-label="World map of the countries and databases behind Daniel Tsai's publications"
    data-zh-aria-label="世界地圖：蔡相德已發表論文所使用的國家與資料庫"
    class="block w-full h-auto"
  >
    <path class="m-land" d={land} />
    {sales.map((s) => (
      compact
        ? <path class="m-sales" d={s.d} />
        : <path class="m-sales" d={s.d} data-c="MIDAS"><title>{COUNTRIES[s.code!].name.en}: IQVIA MIDAS sales data</title></path>
    ))}
    {core.map((s) => (
      compact
        ? <path class="m-core" d={s.d} />
        : <path class="m-core" d={s.d} data-c={s.code} />
    ))}
    {markers.map((m) => (
      compact ? (
        <circle class="m-dot" cx={m.x} cy={m.y} r="4.5" />
      ) : (
        <g
          class="m-marker"
          data-c={m.code}
          role="button"
          tabindex="0"
          aria-label={`${m.name.en}: ${plural(m.nDb, "database")}, ${plural(m.nPapers, "paper")}`}
          data-i18n-attr="aria-label"
          data-en-aria-label={`${m.name.en}: ${plural(m.nDb, "database")}, ${plural(m.nPapers, "paper")}`}
          data-zh-aria-label={`${m.name.zh}：${m.nDb} 個資料庫、${m.nPapers} 篇論文`}
        >
          <circle class="m-hit" cx={m.x} cy={m.y} r="16" />
          <circle class="m-dot" cx={m.x} cy={m.y} r="5.5" />
          <text class="m-label l-en" x={m.x + m.dx} y={m.y + m.dy} text-anchor={m.anchor}>{m.name.en}</text>
          <text class="m-label l-zh" x={m.x + m.dx} y={m.y + m.dy} text-anchor={m.anchor}>{m.name.zh}</text>
        </g>
      )
    ))}
  </svg>

  <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-xs text-slate-600">
    <li class="flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm" style="background:var(--color-brand-500)"></span><span class="l-en">Person-level database used in a published paper</span><span class="l-zh">已發表論文使用過的個人層級資料庫</span></li>
    <li class="flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm" style="background:var(--color-brand-100)"></span><span class="l-en">Pharmaceutical sales data only (IQVIA MIDAS)</span><span class="l-zh">僅藥品銷售資料（IQVIA MIDAS）</span></li>
  </ul>

  {!compact && (
    <div class="mt-8">
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
        {[
          { n: stats.countries, en: "countries and regions with person-level data", zh: "個國家與地區的個人層級資料" },
          { n: stats.databases, en: "named data sources", zh: "個具名資料來源" },
          { n: stats.papers, en: "papers that name their data source", zh: "篇論文明載資料來源" },
          { n: stats.multi, en: "of them use more than one country or a multinational network", zh: "篇跨國或使用跨國網絡" },
        ].map((s) => (
          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <dd class="text-2xl font-extrabold text-brand-700">{s.n}</dd>
            <dt class="mt-1 text-xs text-slate-500 leading-snug"><span class="l-en">{s.en}</span><span class="l-zh">{s.zh}</span></dt>
          </div>
        ))}
      </dl>

      <!-- The same choices as the map, as buttons: easier than a small country
           on a phone, and reachable without a pointer. -->
      <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Choose a country or network" data-i18n-attr="aria-label" data-en-aria-label="Choose a country or network" data-zh-aria-label="選擇國家或網絡">
        {blocks.map((b) => (
          <button type="button" data-pick={b.code} aria-pressed="false" class="m-pick">
            <span class="l-en">{b.name.en}</span><span class="l-zh">{b.name.zh}</span> <span class="m-pick-n">{b.nPapers}</span>
          </button>
        ))}
        <button type="button" data-pick="GLOBAL" aria-pressed="false" class="m-pick">
          <span class="l-en">TriNetX global network</span><span class="l-zh">TriNetX 全球網絡</span> <span class="m-pick-n">{trinetxGlobal.length}</span>
        </button>
        <button type="button" data-pick="MIDAS" aria-pressed="false" class="m-pick">
          <span class="l-en">Sales data, 65 countries</span><span class="l-zh">銷售資料，65 國</span> <span class="m-pick-n">{midasPapers.length}</span>
        </button>
        <button type="button" data-pick="ALL" aria-pressed="false" class="m-pick m-pick-all">
          <span class="l-en">Show the full list</span><span class="l-zh">顯示完整清單</span>
        </button>
      </div>

      <!-- Without the script every block below is visible: this is also the
           plain-text version of the map. -->
      <div class="mt-5 space-y-5" data-blocks>
        {blocks.map((b) => (
          <section data-block={b.code} class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
            <h3 class="text-lg font-bold text-slate-900"><span class="l-en">{b.name.en}</span><span class="l-zh">{b.name.zh}</span></h3>
            <ul class="mt-3 space-y-1.5">
              {b.entries.map((e) => (
                <li class="text-sm">
                  <span class="font-bold text-slate-900">{e.short}</span>
                  <span class="text-slate-600"> · <span class="l-en">{e.en}</span><span class="l-zh">{e.zh}</span></span>
                  <span class="ml-1 rounded-full bg-slate-100 text-slate-600 text-[11px] font-medium px-2 py-0.5 whitespace-nowrap"><span class="l-en">{e.typeEn}</span><span class="l-zh">{e.typeZh}</span></span>
                  <span class="text-xs text-slate-500 whitespace-nowrap"> · {e.papers.length} <span class="l-en">{e.papers.length === 1 ? "paper" : "papers"}</span><span class="l-zh">篇</span></span>
                </li>
              ))}
            </ul>
            <h4 class="mt-5 text-xs font-bold uppercase tracking-wide text-slate-500"><span class="l-en">Papers</span><span class="l-zh">論文</span></h4>
            <ul class="mt-2 space-y-2 border-l-2 border-brand-100 pl-3">
              {b.papers.map(({ p, dbs }) => (
                <li class="text-sm text-slate-700 leading-snug">
                  <a href={doi(p)} target="_blank" rel="noopener" class="hover:text-brand-700 hover:underline">{paperTitle(p)}</a>
                  <span class="text-slate-500"> — {paperLead(p)} {paperJournal(p)}, {p.year}</span>
                  <span class="text-xs text-brand-700 font-semibold whitespace-nowrap"> · {dbs.join(", ")}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}

        <section data-block="GLOBAL" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
          <h3 class="text-lg font-bold text-slate-900"><span class="l-en">TriNetX Global Collaborative Network</span><span class="l-zh">TriNetX 全球協作網絡</span></h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            <span class="l-en">A federated network of electronic health records from healthcare organisations in many countries. These papers analyse the network as a whole and do not report results by country, so it is not drawn on the map. Papers on the US Collaborative Network are listed under the United States.</span>
            <span class="l-zh">由多國醫療機構電子病歷組成的聯邦式網絡。這些論文把整個網絡當成一個資料來源來分析，沒有依國家分開報告，所以不畫在地圖上。使用美國協作網絡的論文列在美國底下。</span>
          </p>
          <ul class="mt-3 space-y-1.5 border-l-2 border-brand-100 pl-3">
            {trinetxGlobal.map((p) => (
              <li class="text-sm text-slate-700 leading-snug">
                <a href={doi(p)} target="_blank" rel="noopener" class="hover:text-brand-700 hover:underline">{paperTitle(p)}</a>
                <span class="text-slate-500"> — {paperLead(p)} {paperJournal(p)}, {p.year}</span>
              </li>
            ))}
          </ul>
        </section>

        <section data-block="MIDAS" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
          <h3 class="text-lg font-bold text-slate-900"><span class="l-en">Pharmaceutical sales data, 65 countries and regions</span><span class="l-zh">藥品銷售資料：65 個國家與地區</span></h3>
          <ul class="mt-3 space-y-1.5 border-l-2 border-brand-100 pl-3">
            {midasPapers.map((p) => (
              <li class="text-sm text-slate-700 leading-snug">
                <a href={doi(p)} target="_blank" rel="noopener" class="hover:text-brand-700 hover:underline">{paperTitle(p)}</a>
                <span class="text-slate-500"> — {paperLead(p)} {paperJournal(p)}, {p.year}</span>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            <span class="l-en">Country-level sales volumes, with no patient records. Besides the {MIDAS65.length - salesOnly.length} countries above that also have a person-level database, the study covers: {salesOnly.map((c) => COUNTRIES[c].name.en).join(", ")}.</span>
            <span class="l-zh">這是國家層級的銷售量，沒有病人層級的紀錄。除了上面 {MIDAS65.length - salesOnly.length} 個同時有個人層級資料庫的國家，這項研究還涵蓋：{salesOnly.map((c) => COUNTRIES[c].name.zh).join("、")}。</span>
          </p>
        </section>
      </div>

      <p class="mt-5 text-xs text-slate-500 leading-relaxed">
        <span class="l-en">Every country and database here is named in the paper it is listed under. Systematic reviews, and papers that do not name a database, are not on the map.</span>
        <span class="l-zh">這裡的每個國家與資料庫，都是所列論文自己寫明的。系統性回顧，以及沒有寫明資料庫的論文，不在地圖上。</span>
      </p>
    </div>
  )}
</div>

<style>
  .m-land { fill: #e2e8f0; }
  .m-sales { fill: var(--color-brand-100); stroke: #fff; stroke-width: 0.5; }
  .m-core { fill: var(--color-brand-500); stroke: #fff; stroke-width: 0.6; }
  .m-dot { fill: var(--color-brand-700); stroke: #fff; stroke-width: 1.5; }
  .m-hit { fill: transparent; }
  .m-label { font-size: 13px; font-weight: 700; fill: #0f172a; paint-order: stroke; stroke: #fff; stroke-width: 3px; stroke-linejoin: round; pointer-events: none; }
  .research-map:not(.is-compact) [data-c] { cursor: pointer; }
  .research-map:not(.is-compact) .m-sales:hover { fill: #a9cfc4; }
  .research-map:not(.is-compact) .m-core:hover { fill: var(--color-brand-600); }
  .m-sales.is-on { fill: #8fbfb2; }
  .m-core.is-on { fill: var(--color-brand-700); }
  .m-marker:focus { outline: none; }
  .m-marker:focus-visible .m-dot, .m-marker.is-on .m-dot { fill: var(--color-accent-500); stroke-width: 2.5; r: 7.5px; }
  .m-marker:focus-visible .m-hit { stroke: var(--color-brand-700); stroke-width: 2; }
  .m-pick { border: 1px solid #cbd5e1; background: #fff; color: #334155; border-radius: 9999px; padding: 0.35rem 0.8rem; font-size: 0.8125rem; font-weight: 600; transition: background 0.15s, border-color 0.15s; }
  .m-pick:hover { border-color: var(--color-brand-500); }
  .m-pick[aria-pressed="true"] { background: var(--color-brand-600); border-color: var(--color-brand-600); color: #fff; }
  .m-pick-n { font-weight: 500; opacity: 0.7; margin-left: 0.15rem; }
  .m-pick-all { border-style: dashed; }
  /* Country names crowd the map on a phone; the buttons below carry them. */
  @media (max-width: 639px) {
    .m-label { display: none !important; }
    /* The drawing is about a third of its desktop size here, so the dots and
       their touch targets are drawn larger to stay visible and tappable. */
    .m-dot { r: 11px; stroke-width: 3; }
    .m-hit { r: 36px; }
    .m-marker:focus-visible .m-dot, .m-marker.is-on .m-dot { r: 14px; stroke-width: 4; }
  }
</style>

{!compact && (
  <script is:inline>
    (function () {
      var root = document.querySelector("[data-research-map]");
      if (!root) return;
      var blocks = [].slice.call(root.querySelectorAll("[data-block]"));
      var picks = [].slice.call(root.querySelectorAll("[data-pick]"));
      var marks = [].slice.call(root.querySelectorAll("[data-c]"));
      function select(code) {
        blocks.forEach(function (b) { b.hidden = code !== "ALL" && b.getAttribute("data-block") !== code; });
        picks.forEach(function (p) { p.setAttribute("aria-pressed", String(p.getAttribute("data-pick") === code)); });
        marks.forEach(function (m) { m.classList.toggle("is-on", m.getAttribute("data-c") === code); });
      }
      picks.forEach(function (p) { p.addEventListener("click", function () { select(p.getAttribute("data-pick")); }); });
      marks.forEach(function (m) {
        m.addEventListener("click", function () { select(m.getAttribute("data-c")); });
        m.addEventListener("keydown", function (e) {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); select(m.getAttribute("data-c")); }
        });
      });
      // /networks?c=KR#map opens on that country (used by links elsewhere on the site).
      var want = new URLSearchParams(location.search).get("c");
      var ok = want && blocks.some(function (b) { return b.getAttribute("data-block") === want; });
      select(ok ? want : "TW");
    })();
  </script>
)}
