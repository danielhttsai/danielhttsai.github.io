<script is:inline>
  (function () {
    var root = document.querySelector("[data-research-map]");
    if (!root) return;
    var blocks = [].slice.call(root.querySelectorAll("[data-block]"));
    var nodes = [].slice.call(root.querySelectorAll(".m-node"));
    var arcs = [].slice.call(root.querySelectorAll(".m-arc"));
    var flows = [].slice.call(root.querySelectorAll(".m-flow"));
    var keys = [].slice.call(root.querySelectorAll("[data-pick]"));
    var selected = null;
    root.classList.add("is-live");

    // Highlight only: which bubble is emphasised, with its arcs and partners.
    function paint(code) {
      var partners = {};
      arcs.forEach(function (a) {
        var on = a.getAttribute("data-a") === code || a.getAttribute("data-b") === code;
        a.classList.toggle("is-on", on);
        a.classList.toggle("is-dim", !on);
        if (on) partners[a.getAttribute("data-a") === code ? a.getAttribute("data-b") : a.getAttribute("data-a")] = true;
      });
      var geographic = nodes.some(function (n) { return n.getAttribute("data-c") === code && !n.classList.contains("is-network"); });
      nodes.forEach(function (n) {
        var c = n.getAttribute("data-c");
        n.classList.toggle("is-on", c === code);
        n.classList.toggle("is-partner", !!partners[c]);
        n.classList.toggle("is-dim", geographic && c !== code && !partners[c] && !n.classList.contains("is-network"));
      });
      // Dots run along the emphasised place's arcs, away from it.
      flows.forEach(function (f) {
        var a = f.getAttribute("data-a"), b = f.getAttribute("data-b");
        f.classList.toggle("is-on", a === code || b === code);
        f.classList.toggle("is-rev", b === code);
      });
    }
    // Selection: the highlight plus the panel.
    var motionOK = !(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
    var ready = false; // no panel animation for the selection made at load
    function enter(block) {
      if (!block || !ready) return;
      block.classList.remove("is-enter");
      void block.offsetWidth;
      block.classList.add("is-enter");
      if (!motionOK) return;
      // Counts tick up from zero alongside the growing bars.
      var nums = [].slice.call(block.querySelectorAll(".rm-num"));
      var t0 = performance.now();
      nums.forEach(function (n) { n.textContent = "0"; });
      (function step(t) {
        var p = Math.min(1, (t - t0) / 700), e = 1 - Math.pow(1 - p, 3);
        nums.forEach(function (n) { n.textContent = String(Math.round(e * +n.getAttribute("data-n"))); });
        if (p < 1) requestAnimationFrame(step);
      })(t0);
      setTimeout(function () { nums.forEach(function (n) { n.textContent = n.getAttribute("data-n"); }); }, 900);
    }
    function select(code) {
      var changed = code !== selected;
      selected = code;
      blocks.forEach(function (b) { b.hidden = b.getAttribute("data-block") !== code; });
      if (changed) enter(root.querySelector('[data-block="' + code + '"]'));
      keys.forEach(function (k) { k.setAttribute("aria-pressed", String(k.getAttribute("data-pick") === code)); });
      paint(code);
    }
    nodes.forEach(function (n) {
      var c = n.getAttribute("data-c");
      n.addEventListener("click", function () { select(c); });
      n.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); select(c); } });
      n.addEventListener("mouseenter", function () { paint(c); });
      n.addEventListener("mouseleave", function () { paint(selected); });
      n.addEventListener("focus", function () { paint(c); });
      n.addEventListener("blur", function () { paint(selected); });
    });
    keys.forEach(function (k) { k.addEventListener("click", function () { select(k.getAttribute("data-pick")); }); });
    root.querySelectorAll("path[data-c]").forEach(function (p) { p.addEventListener("click", function () { select(p.getAttribute("data-c")); }); });

    // Paper marks: hover or focus previews a paper's card, a click or tap keeps it.
    var papers = root.querySelector("[data-papers]");
    var marks = [].slice.call(papers.querySelectorAll(".pm"));
    var cards = [].slice.call(papers.querySelectorAll(".pd"));
    var pinned = cards[0] ? cards[0].getAttribute("data-pd") : null; // the newest paper
    function show(id) { cards.forEach(function (c) { c.hidden = c.getAttribute("data-pd") !== id; }); }
    function pin(id) {
      pinned = id;
      marks.forEach(function (m) { m.setAttribute("aria-pressed", String(m.getAttribute("data-pm") === id)); });
      show(id);
    }
    marks.forEach(function (m) {
      var id = m.getAttribute("data-pm");
      m.addEventListener("click", function () { pin(id); });
      m.addEventListener("mouseenter", function () { show(id); });
      m.addEventListener("mouseleave", function () { show(pinned); });
      m.addEventListener("focus", function () { show(id); });
      m.addEventListener("blur", function () { show(pinned); });
    });
    if (pinned) pin(pinned);

    // A place chosen on the map brings its papers forward in the grid. Only a
    // visitor's own choice does this; the panel opening on Taiwan by default
    // leaves the grid showing everything.
    var focus = papers.querySelector("[data-focus]");
    function highlight(code) {
      marks.forEach(function (m) {
        var w = " " + (m.getAttribute("data-where") || "") + " ";
        m.classList.toggle("is-dim", !!code && w.indexOf(" " + code + " ") < 0);
      });
      focus.hidden = !code;
      if (code) {
        var b = root.querySelector('[data-block="' + code + '"] .rm-title');
        focus.querySelector("[data-focus-en]").textContent = b ? b.querySelector(".l-en").textContent : code;
        focus.querySelector("[data-focus-zh]").textContent = b ? b.querySelector(".l-zh").textContent : code;
      }
    }
    papers.querySelector("[data-focus-clear]").addEventListener("click", function () { highlight(null); });
    var chosen = function (c) { select(c); highlight(c); };
    nodes.forEach(function (n) {
      var c = n.getAttribute("data-c");
      n.addEventListener("click", function () { highlight(c); });
      n.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") highlight(c); });
    });
    keys.forEach(function (k) { k.addEventListener("click", function () { highlight(k.getAttribute("data-pick")); }); });
    root.querySelectorAll("path[data-c]").forEach(function (p) { p.addEventListener("click", function () { highlight(p.getAttribute("data-c")); }); });

    // /?c=KR#map opens on that country.
    var want = new URLSearchParams(location.search).get("c");
    var ok = want && blocks.some(function (b) { return b.getAttribute("data-block") === want; });
    if (ok) chosen(want); else select("TW");

    // ── Motion ──────────────────────────────────────────────────────────
    // One short opening sequence the first time the map scrolls into view
    // (Daniel, 2026-11-24: no camera, no tour). Taiwan appears with one subtle
    // pulse; its arcs draw out to its partners, overlapping, nearest first,
    // each partner fading in as its arc lands; then the TriNetX ring; then the
    // arcs between other places. About 4.5 s. The panel stays on Taiwan. A
    // click anywhere in the block finishes it at once. Afterwards a small
    // "Replay" link plays it again. Reduced motion: no sequence.
    var stage = root.querySelector(".rm-stage");
    var replayBtn = root.querySelector("[data-replay]");
    var ORDER = ["HK", "KR", "AU", "NZ", "FI", "NL", "GB", "US"];
    var START = 450, DRAW = 650, STEP = 280;
    var timers = [], running = false, seen = false;
    function later(fn, ms) { timers.push(setTimeout(fn, ms)); }

    var twArcs = arcs.filter(function (a) { return a.getAttribute("data-a") === "TW" || a.getAttribute("data-b") === "TW"; });
    twArcs.forEach(function (a) { a.classList.add("is-tw"); });
    var partner = function (a) { return a.getAttribute("data-a") === "TW" ? a.getAttribute("data-b") : a.getAttribute("data-a"); };
    // pathLength is 1: an offset of ±1 hides an arc; the sign makes it grow from Taiwan.
    var hideOffset = function (a) { return a.getAttribute("data-a") === "TW" ? "1" : "-1"; };
    function nodesOf(code) { return nodes.filter(function (n) { return n.getAttribute("data-c") === code; }); }

    function prime() {
      // The state before the sequence: nothing drawn, no bubble shown.
      root.classList.add("rm-seq");
      root.classList.remove("rm-done");
      nodes.forEach(function (n) { n.classList.remove("is-shown", "is-first"); });
      twArcs.forEach(function (a) { a.style.transition = "none"; a.style.strokeDashoffset = hideOffset(a); });
    }
    function finish() {
      timers.forEach(clearTimeout); timers = [];
      root.classList.remove("rm-seq");
      root.classList.add("rm-done");
      twArcs.forEach(function (a) { a.style.transition = ""; a.style.strokeDashoffset = ""; });
      nodes.forEach(function (n) { n.classList.remove("is-shown"); });
      running = false;
      if (replayBtn) replayBtn.hidden = !motionOK;
    }
    function play() {
      prime();
      void root.getBoundingClientRect();
      running = true;
      if (replayBtn) replayBtn.hidden = true;
      select("TW");
      nodesOf("TW").forEach(function (n) { n.classList.add("is-shown", "is-first"); });
      // Taiwan's arcs, nearest partner first, in both drawings.
      var order = ORDER.filter(function (c) { return twArcs.some(function (a) { return partner(a) === c; }); });
      order.forEach(function (c, k) {
        var at = START + k * STEP;
        later(function () {
          twArcs.forEach(function (a) {
            if (partner(a) !== c) return;
            a.style.transition = "stroke-dashoffset " + DRAW + "ms cubic-bezier(0.3, 0.1, 0.25, 1)";
            a.style.strokeDashoffset = "0";
          });
        }, at);
        later(function () { nodesOf(c).forEach(function (n) { n.classList.add("is-shown"); }); }, at + DRAW - 80);
      });
      var lastLand = START + (order.length - 1) * STEP + DRAW;
      later(function () { nodesOf("GLOBAL").forEach(function (n) { n.classList.add("is-shown"); }); }, lastLand + 150);
      // Then the arcs between other places fade in and the sequence ends.
      later(finish, lastLand + 150 + 900);
    }

    if (replayBtn) replayBtn.addEventListener("click", function () { play(); });
    // Clicking anywhere else in the block ends the sequence with everything drawn.
    root.addEventListener("pointerdown", function (e) {
      if (!running || (e.target.closest && e.target.closest(".rm-replaybar"))) return;
      finish();
    }, true);
    root.addEventListener("keydown", function (e) {
      if (running && e.key !== "Tab" && e.key !== "Shift") finish();
    }, true);

    ready = true;
    if (motionOK && !ok && "IntersectionObserver" in window && stage) {
      prime();
      new IntersectionObserver(function (es, io) {
        if (!es[es.length - 1].isIntersecting || seen) return;
        seen = true;
        io.disconnect();
        play();
      }, { threshold: 0.35 }).observe(stage);
    } else {
      root.classList.add("rm-done");
    }
  })();
</script>
