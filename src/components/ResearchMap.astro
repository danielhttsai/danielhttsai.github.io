<script is:inline>
  (function () {
    var root = document.querySelector("[data-research-map]");
    if (!root) return;
    var blocks = [].slice.call(root.querySelectorAll("[data-block]"));
    var nodes = [].slice.call(root.querySelectorAll(".m-node"));
    var arcs = [].slice.call(root.querySelectorAll(".m-arc"));
    var flows = [].slice.call(root.querySelectorAll(".m-flow"));
    var keys = [].slice.call(root.querySelectorAll("[data-pick]"));
    var selected = null;
    root.classList.add("is-live");

    // Highlight only: which bubble is emphasised, with its arcs and partners.
    function paint(code) {
      var partners = {};
      arcs.forEach(function (a) {
        var on = a.getAttribute("data-a") === code || a.getAttribute("data-b") === code;
        a.classList.toggle("is-on", on);
        a.classList.toggle("is-dim", !on);
        if (on) partners[a.getAttribute("data-a") === code ? a.getAttribute("data-b") : a.getAttribute("data-a")] = true;
      });
      var geographic = nodes.some(function (n) { return n.getAttribute("data-c") === code && !n.classList.contains("is-network"); });
      nodes.forEach(function (n) {
        var c = n.getAttribute("data-c");
        n.classList.toggle("is-on", c === code);
        n.classList.toggle("is-partner", !!partners[c]);
        n.classList.toggle("is-dim", geographic && c !== code && !partners[c] && !n.classList.contains("is-network"));
      });
      // Dots run along the emphasised place's arcs, away from it.
      flows.forEach(function (f) {
        var a = f.getAttribute("data-a"), b = f.getAttribute("data-b");
        f.classList.toggle("is-on", a === code || b === code);
        f.classList.toggle("is-rev", b === code);
      });
    }
    // Selection: the highlight plus the panel.
    var motionOK = !(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
    var ready = false; // no panel animation for the selection made at load
    function enter(block) {
      if (!block || !ready) return;
      block.classList.remove("is-enter");
      void block.offsetWidth;
      block.classList.add("is-enter");
      if (!motionOK) return;
      // Counts tick up from zero alongside the growing bars.
      var nums = [].slice.call(block.querySelectorAll(".rm-num"));
      var t0 = performance.now();
      nums.forEach(function (n) { n.textContent = "0"; });
      (function step(t) {
        var p = Math.min(1, (t - t0) / 700), e = 1 - Math.pow(1 - p, 3);
        nums.forEach(function (n) { n.textContent = String(Math.round(e * +n.getAttribute("data-n"))); });
        if (p < 1) requestAnimationFrame(step);
      })(t0);
      setTimeout(function () { nums.forEach(function (n) { n.textContent = n.getAttribute("data-n"); }); }, 900);
    }
    function select(code) {
      var changed = code !== selected;
      selected = code;
      blocks.forEach(function (b) { b.hidden = b.getAttribute("data-block") !== code; });
      if (changed) enter(root.querySelector('[data-block="' + code + '"]'));
      keys.forEach(function (k) { k.setAttribute("aria-pressed", String(k.getAttribute("data-pick") === code)); });
      paint(code);
    }
    nodes.forEach(function (n) {
      var c = n.getAttribute("data-c");
      n.addEventListener("click", function () { select(c); });
      n.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); select(c); } });
      n.addEventListener("mouseenter", function () { paint(c); });
      n.addEventListener("mouseleave", function () { paint(selected); });
      n.addEventListener("focus", function () { paint(c); });
      n.addEventListener("blur", function () { paint(selected); });
    });
    keys.forEach(function (k) { k.addEventListener("click", function () { select(k.getAttribute("data-pick")); }); });
    root.querySelectorAll("path[data-c]").forEach(function (p) { p.addEventListener("click", function () { select(p.getAttribute("data-c")); }); });

    // Paper marks: hover or focus previews a paper's card, a click or tap keeps it.
    var papers = root.querySelector("[data-papers]");
    var marks = [].slice.call(papers.querySelectorAll(".pm"));
    var cards = [].slice.call(papers.querySelectorAll(".pd"));
    var pinned = cards[0] ? cards[0].getAttribute("data-pd") : null; // the newest paper
    function show(id) { cards.forEach(function (c) { c.hidden = c.getAttribute("data-pd") !== id; }); }
    function pin(id) {
      pinned = id;
      marks.forEach(function (m) { m.setAttribute("aria-pressed", String(m.getAttribute("data-pm") === id)); });
      show(id);
    }
    marks.forEach(function (m) {
      var id = m.getAttribute("data-pm");
      m.addEventListener("click", function () { pin(id); });
      m.addEventListener("mouseenter", function () { show(id); });
      m.addEventListener("mouseleave", function () { show(pinned); });
      m.addEventListener("focus", function () { show(id); });
      m.addEventListener("blur", function () { show(pinned); });
    });
    if (pinned) pin(pinned);

    // A place chosen on the map brings its papers forward in the grid. Only a
    // visitor's own choice does this; the panel opening on Taiwan by default
    // leaves the grid showing everything.
    var focus = papers.querySelector("[data-focus]");
    function highlight(code) {
      marks.forEach(function (m) {
        var w = " " + (m.getAttribute("data-where") || "") + " ";
        m.classList.toggle("is-dim", !!code && w.indexOf(" " + code + " ") < 0);
      });
      focus.hidden = !code;
      if (code) {
        var b = root.querySelector('[data-block="' + code + '"] .rm-title');
        focus.querySelector("[data-focus-en]").textContent = b ? b.querySelector(".l-en").textContent : code;
        focus.querySelector("[data-focus-zh]").textContent = b ? b.querySelector(".l-zh").textContent : code;
      }
    }
    papers.querySelector("[data-focus-clear]").addEventListener("click", function () { highlight(null); });
    var chosen = function (c) { select(c); highlight(c); };
    nodes.forEach(function (n) {
      var c = n.getAttribute("data-c");
      n.addEventListener("click", function () { highlight(c); });
      n.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") highlight(c); });
    });
    keys.forEach(function (k) { k.addEventListener("click", function () { highlight(k.getAttribute("data-pick")); }); });
    root.querySelectorAll("path[data-c]").forEach(function (p) { p.addEventListener("click", function () { highlight(p.getAttribute("data-c")); }); });

    // /?c=KR#map opens on that country.
    var want = new URLSearchParams(location.search).get("c");
    var ok = want && blocks.some(function (b) { return b.getAttribute("data-block") === want; });
    if (ok) chosen(want); else select("TW");

    // ── Motion ──────────────────────────────────────────────────────────
    // The drawing comes in the first time it is seen, then a tour runs once:
    // from Taiwan, the hub, outward along the collaboration links (East Asia,
    // Oceania, Europe, North America), ending on the TriNetX network with every
    // arc drawn. At each stop the camera eases in on the place (wide map only),
    // its bubble pulses, the panel's bars grow and counts tick up; the camera
    // then eases back out while the place's arcs draw out to its partners, each
    // partner lighting up as its arc arrives. Only transform, opacity and
    // stroke-dashoffset move. Reduced motion: no camera, no drawing; the panel
    // steps with a cross-fade, and the tour waits for the button.
    var stage = root.querySelector(".rm-stage");
    var panel = root.querySelector("[data-blocks]");
    var view = root.querySelector(".rm-view");
    var wide = root.querySelector(".rm-wide");
    var tourBtn = root.querySelector("[data-tour]");
    var nextBtn = root.querySelector("[data-tour-next]");
    var ORDER = ["TW", "KR", "HK", "AU", "NZ", "GB", "NL", "FI", "US", "GLOBAL"].filter(function (c) {
      return nodes.some(function (n) { return n.getAttribute("data-c") === c; });
    });
    // How far the camera zooms on each place; Europe and East Asia need most.
    var ZOOM = { TW: 2.1, KR: 2.4, HK: 2.4, AU: 1.9, NZ: 1.9, GB: 2.9, NL: 2.9, FI: 2.9, US: 1.9 };
    var MOVE_MS = 1000, DRAW_MS = 1000, STAGGER = 70;
    var state = "idle", stopIdx = -1, timers = [], seen = false;
    var inView = !("IntersectionObserver" in window);

    function later(fn, ms) { timers.push(setTimeout(fn, ms)); }
    function clearTimers() { timers.forEach(clearTimeout); timers = []; }
    function cameraOn() { return motionOK && wide && view && getComputedStyle(wide).display !== "none"; }

    // While the tour runs the panel keeps the height of its tallest block, so
    // the page below it does not jump at every step.
    function reserve(on) {
      if (!panel) return;
      if (!on) { panel.style.minHeight = ""; return; }
      var max = 0;
      blocks.forEach(function (b) {
        var was = b.hidden;
        b.hidden = false;
        max = Math.max(max, b.offsetHeight);
        b.hidden = was;
      });
      panel.style.minHeight = max + "px";
    }

    // Camera: a CSS transform on the wide <svg>, which the browser composites.
    function camTo(code) {
      if (!cameraOn()) return;
      var s = ZOOM[code], n = wide.querySelector('.m-node[data-c="' + code + '"]');
      if (!s || !n) { camHome(); return; }
      var m = /translate\(([-\d.]+)[ ,]+([-\d.]+)\)/.exec(n.getAttribute("transform") || "");
      if (!m) return;
      var vb = wide.viewBox.baseVal, cw = view.clientWidth, ch = cw * vb.height / vb.width;
      var px = (+m[1] - vb.x) * cw / vb.width, py = (+m[2] - vb.y) * ch / vb.height;
      var tx = Math.min(0, Math.max(cw - s * cw, cw / 2 - s * px));
      var ty = Math.min(0, Math.max(ch - s * ch, ch / 2 - s * py));
      view.classList.add("is-zoomed");
      wide.style.transition = "transform " + MOVE_MS + "ms cubic-bezier(0.65, 0, 0.35, 1)";
      wide.style.transform = "translate(" + tx.toFixed(1) + "px, " + ty.toFixed(1) + "px) scale(" + s + ")";
    }
    function camHome() {
      if (!wide || !wide.style.transform) return;
      wide.style.transition = "transform " + MOVE_MS + "ms cubic-bezier(0.65, 0, 0.35, 1)";
      wide.style.transform = "";
      setTimeout(function () { if (!wide.style.transform) view.classList.remove("is-zoomed"); }, MOVE_MS + 50);
    }

    function resetArcs() {
      arcs.forEach(function (a) { a.style.transition = ""; a.style.strokeDashoffset = ""; });
      nodes.forEach(function (n) { n.classList.remove("is-arrive", "is-reached"); });
    }
    function arrive(code) {
      nodes.forEach(function (n) {
        if (n.getAttribute("data-c") !== code) return;
        n.classList.remove("is-arrive");
        void n.getBoundingClientRect();
        n.classList.add("is-arrive");
      });
    }
    function reach(svg, codes) {
      codes.forEach(function (c) {
        var n = svg.querySelector('.m-node[data-c="' + c + '"]');
        if (!n) return;
        n.classList.add("is-partner", "is-reached");
        later(function () { n.classList.remove("is-reached"); }, 700);
      });
    }
    // Arcs draw out from `code` (or every arc when code is null). pathLength is
    // 1, so an offset of ±1 hides an arc and 0 shows it; the sign picks the end
    // it grows from.
    function drawOut(code, delay) {
      var list = arcs.filter(function (a) { return !code || a.getAttribute("data-a") === code || a.getAttribute("data-b") === code; });
      list.forEach(function (a) {
        a.style.transition = "none";
        a.style.strokeDashoffset = code && a.getAttribute("data-b") === code ? "-1" : "1";
      });
      void root.getBoundingClientRect();
      var count = {};
      list.forEach(function (a) {
        var svg = a.ownerSVGElement, key = svg.getAttribute("class");
        var i = (count[key] = (count[key] || 0) + 1) - 1;
        var d = delay + i * STAGGER;
        a.style.transition = "stroke-dashoffset " + DRAW_MS + "ms cubic-bezier(0.3, 0.1, 0.25, 1) " + d + "ms, opacity 0.4s ease";
        a.style.strokeDashoffset = "0";
        var to = !code ? [a.getAttribute("data-a"), a.getAttribute("data-b")]
          : [a.getAttribute("data-a") === code ? a.getAttribute("data-b") : a.getAttribute("data-a")];
        later(function () { reach(svg, to); }, d + DRAW_MS * 0.9);
      });
      return delay + (list.length / 2) * STAGGER + DRAW_MS;
    }

    function runStop(i) {
      clearTimers();
      stopIdx = i;
      var code = ORDER[i];
      if (!code) { endTour(); return; }
      select(code);
      if (!motionOK) { later(next, 3200); return; }
      resetArcs();
      root.classList.add("rm-drawing");
      if (code === "GLOBAL") {
        // Finale: back to the whole world and every arc drawn at once.
        camHome();
        arcs.forEach(function (a) { a.classList.add("is-on"); a.classList.remove("is-dim"); });
        nodes.forEach(function (n) { n.classList.remove("is-dim", "is-partner"); });
        arrive(code);
        var done = drawOut(null, MOVE_MS * 0.5);
        later(function () { root.classList.remove("rm-drawing"); }, done + 200);
        later(next, done + 1600);
        return;
      }
      nodes.forEach(function (n) { n.classList.remove("is-partner"); }); // they light up as reached
      var cam = cameraOn();
      if (cam) camTo(code);
      later(function () { arrive(code); }, cam ? MOVE_MS * 0.55 : 0);
      var drawAt = cam ? MOVE_MS + 250 : 350;
      if (cam) later(camHome, drawAt);
      var finished = drawOut(code, drawAt);
      later(function () { root.classList.remove("rm-drawing"); }, finished + 200);
      later(next, Math.max(cam ? 3800 : 3200, finished + 700));
    }
    function next() {
      // Off screen or in a background tab, the tour waits where it is.
      if (!inView || document.hidden) { later(next, 600); return; }
      runStop(stopIdx + 1);
    }
    function setState(st) {
      state = st;
      root.classList.toggle("rm-touring", st === "playing");
      if (tourBtn) {
        tourBtn.setAttribute("data-state", st);
        [].slice.call(tourBtn.querySelectorAll("[data-when]")).forEach(function (el) { el.hidden = el.getAttribute("data-when") !== st; });
      }
      if (nextBtn) nextBtn.hidden = !(st === "playing" || st === "paused");
    }
    function settle() {
      clearTimers();
      camHome();
      resetArcs();
      root.classList.remove("rm-drawing");
      paint(selected);
    }
    function startTour(from) { reserve(true); setState("playing"); runStop(from); }
    function pauseTour() { settle(); setState("paused"); }
    function endTour() { settle(); reserve(false); select("TW"); paint("TW"); setState("ended"); }
    function stopTour() { settle(); reserve(false); setState("idle"); }

    if (tourBtn && ORDER.length > 1) {
      tourBtn.hidden = false;
      tourBtn.addEventListener("click", function () {
        if (state === "playing") pauseTour();
        else if (state === "paused") startTour(stopIdx);
        else startTour(0);
      });
    }
    if (nextBtn) nextBtn.addEventListener("click", function () { setState("playing"); runStop(stopIdx + 1); });
    // A press anywhere else in the block stops the tour; the press then does
    // what it would have done, so a clicked country stays selected.
    root.addEventListener("pointerdown", function (e) {
      if (e.target.closest && e.target.closest(".rm-tourbar")) return;
      if (state === "playing" || state === "paused") stopTour();
    }, true);
    root.addEventListener("keydown", function (e) {
      if (e.key === "Tab" || e.key === "Shift" || (e.target.closest && e.target.closest(".rm-tourbar"))) return;
      if (state === "playing" || state === "paused") stopTour();
    }, true);
    var resizeT = null;
    window.addEventListener("resize", function () {
      if (state !== "playing") return;
      clearTimeout(resizeT);
      resizeT = setTimeout(function () { reserve(true); if (ORDER[stopIdx] && ORDER[stopIdx] !== "GLOBAL") camTo(ORDER[stopIdx]); }, 200);
    });

    ready = true;
    if ("IntersectionObserver" in window && stage) {
      if (motionOK) root.classList.add("rm-pre");
      new IntersectionObserver(function (es) {
        inView = es[es.length - 1].isIntersecting;
        if (!inView || seen) return;
        seen = true;
        root.classList.remove("rm-pre");
        root.classList.add("rm-in");
        // Let the entrance finish, then hand over to the tour, unless the
        // visitor arrived on a chosen country (?c=) or has already taken over.
        setTimeout(function () {
          root.classList.remove("rm-in");
          root.classList.add("rm-done");
          if (motionOK && !ok && state === "idle") startTour(0);
        }, motionOK ? 2600 : 0);
      }, { threshold: 0.3 }).observe(stage);
    } else {
      root.classList.add("rm-done");
    }
  })();
</script>
