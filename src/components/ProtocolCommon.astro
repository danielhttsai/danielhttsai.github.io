---
// Shared "common protocol sections" so every generated protocol covers the
// HARPER / TARGET reporting items the Protocol Checker judges — a structured
// abstract, study size, data-source provenance, data management & QC, planned
// analytical outputs, limitations, human-subjects & governance, registration &
// amendments, adverse-event handling, and funding/COI. Include once per builder
// page (it exposes window.PC), then in buildMarkdown()/buildDocx() splice in:
//   md:   PC.abstractMd(pc) after the title/subtitle, PC.tailMd(pc) before "## References"
//   docx: ...PC.abstractDocx(D, pc) after the subtitle, ...PC.tailDocx(D, pc) before the References heading
//
// pc = {
//   design,            // e.g. "active-comparator new-user cohort"
//   tte,               // true for target-trial-emulation designs (ACNU/CCW/ST)
//   population, exposure, comparator, outcome, data, analysis,
//   groupBy,           // label for Table 1 columns (default "exposure group")
//   dataMeta, studySize, ethics, registration,  // optional; sensible defaults
//   limitations,       // optional design-specific sentence, appended to the generic one
//   plannedOutputs,    // optional array of extra shell tables/figures for this design
//   amendments,        // optional; the raw "amendments" field (see below)
//   version,           // optional; the builder's version/date string
// }
//
// ── HARPER item 3 (amendments and updates) — integrating a builder ──────────
//
// The amendments log is emitted by abstractMd()/abstractDocx(), which every
// builder already calls, so ITEM 3 IS SATISFIED WITH NO BUILDER CHANGE AT ALL:
// with no amendment data the protocol states, in its own front matter, that it
// is the original version and no amendments have been made. That is the correct
// claim for a first draft, not a placeholder.
//
// To let the user actually record amendments, a builder adds three lines:
//
//   1. Mount the editor into the form (either side of restore is fine —
//      PC.restore() creates the field itself and repaints afterwards):
//        window.PC && PC.mountAmendments(form);
//      It inserts its own <details> block just above the download buttons and
//      owns a hidden field named "amendments". Nothing else to add to the
//      markup: readForm(), localStorage and ?seed= pick the field up already
//      because it is a normal named form control.
//
//   2. Pass it through pcOf() so the export uses the state the builder read,
//      not the live DOM:
//        amendments: s.amendments, version: s.version,
//      (Omitting this still works — PC falls back to reading the field off the
//      page — but passing it is what keeps export and state in step.)
//
//   3. If the builder has a "Clear all"/reset that writes fields directly:
//        window.PC && PC.syncAmendments(form);
//      after resetting, so the rows repaint. (The editor also self-heals on the
//      form's change event, so forgetting this degrades rather than breaks.)
//
// Storage format: one line per amendment in the single field "amendments",
// pipe-delimited in HARPER's own column order —
//   version date | version number | section of protocol | amendment | reason
// Only the first four pipes split, so a reason may contain "|".
---

<script is:inline>
  (function () {
    const nz = (v, d) => (v && String(v).trim() ? String(v).trim() : d);
    const P = (s) => nz(s.population, "(population)");
    const E = (s) => nz(s.exposure, "(exposure/intervention)");
    const C = (s) => nz(s.comparator, "");
    const O = (s) => nz(s.outcome, "(outcome)");
    const contrast = (s) => E(s) + (C(s) ? " versus " + C(s) : "");

    const designLine = (s) => s.tte
      ? nz(s.design, "target-trial-emulation study") + " that emulates a target trial using observational data from " + nz(s.data, "(data source)")
      : nz(s.design, "observational study") + " using data from " + nz(s.data, "(data source)");

    const abstractLines = (s) => s.descriptive ? ([
      ["Objective. ", "To describe and quantify " + O(s) + " among " + P(s) + "."],
      ["Design. ", designLine(s) + "."],
      ["Data source(s). ", nz(s.data, "(data source)") + (s.dataMeta ? " — " + s.dataMeta : "") + "."],
      ["Measures. ", O(s) + ", overall and by the pre-specified strata."],
      ["Analysis. ", nz(s.analysis, "descriptive estimates with 95% confidence intervals") + "."],
      ["Reporting. ", "This protocol follows the HARPER template."],
    ]) : ([
      ["Objective. ", "To estimate the effect of " + contrast(s) + " on " + O(s) + " among " + P(s) + "."],
      ["Design. ", designLine(s) + "."],
      ["Data source(s). ", nz(s.data, "(data source)") + (s.dataMeta ? " — " + s.dataMeta : "") + "."],
      ["Population, exposure, comparator, outcome. ", P(s) + "; " + contrast(s) + "; " + O(s) + "."],
      ["Analysis. ", nz(s.analysis, "the pre-specified primary analysis with 95% confidence intervals") + "."],
      ["Reporting. ", "This protocol follows the HARPER template" + (s.tte ? "; target-trial-emulation elements follow the TARGET statement" : "") + "."],
    ]);

    // `abstractLines` above already branches on s.descriptive; these three did
    // not, so a descriptive protocol exported "Primary-results table — the
    // effect estimate", "Residual and unmeasured confounding cannot be
    // excluded" and a power calculation "to detect the smallest clinically
    // important effect" — three statements about an effect that the very next
    // sentence says is not being estimated. Only the descriptive-analysis
    // builder sets s.descriptive, so these branches reach exactly that one page.
    const defaultOutputs = (s) => {
      const base = s.descriptive ? [
        "Population-selection flow diagram (source population → analytic cohort, with exclusions and counts).",
        "Table 1 — characteristics of the study population by " + nz(s.groupBy, "stratum") + ".",
        "Primary-results table — each reported rate or proportion with its 95% confidence interval, by site and by stratum.",
      ] : [
        "Participant-flow diagram (source population → analytic cohort, with exclusions and counts).",
        "Table 1 — baseline characteristics by " + nz(s.groupBy, "exposure group") + ".",
        "Primary-results table — the effect estimate with its 95% confidence interval.",
      ];
      return base.concat(Array.isArray(s.plannedOutputs) ? s.plannedOutputs : []);
    };

    const limitationsText = (s) =>
      (s.descriptive
        ? "No causal contrast is estimated and none should be read into these numbers; the outcome and exposure may be misclassified in secondary data, and generalisability is bounded by the source populations of the contributing data sources."
        : "Residual and unmeasured confounding cannot be excluded; the outcome and exposure may be misclassified in secondary data; and generalisability is bounded by the source population.") +
      (s.limitations ? " " + s.limitations : "");

    const ethicsText = (s) => nz(s.ethics,
      "Each participating data source obtains local institutional review board / ethics approval (or a documented waiver) before data extraction; only de-identified data are analysed.");

    /* ── HARPER item 3: amendments and updates ─────────────────────────────
       Every builder failed this item, because a protocol that has never been
       amended still has to SAY so — "no log" and "no changes yet" look the
       same in an exported document, and a reader cannot tell which they are
       looking at. Built once here rather than nine times, so the nine builders
       cannot drift into nine incompatible amendment tables.

       Column order follows the HARPER template's own table
       (drugepi.gitlab-pages.partners.org/harper): version date, version
       number, section of protocol, amendment or update, reason.

       Storage is one line per amendment in a single form field named
       "amendments", pipe-delimited in that same order — the idiom the builders
       already use for their period strips and look-back windows, so their
       existing readForm / localStorage / ?seed= paths carry it with no change.
       A pipe typed into any cell survives, because it is escaped on the way
       into the field and unescaped on the way out. Only the trailing Reason
       column used to be protected, so a pipe in one of the first four — "7 | 8"
       in Section of protocol, meaning sections 7 and 8, is the obvious one —
       shifted every later cell one column left. The exported HARPER amendment
       table then read "Section: 7", "Amendment: 8", and the description of what
       changed appeared under Reason: a complete, plausible, wrong row. */
    const AM_FIELD = "amendments";
    const AM_COLS = ["Version date", "Version number", "Section of protocol", "Amendment or update", "Reason"];

    // Escape backslash first, so unescaping is unambiguous.
    var amEsc = function (c) { return String(c == null ? "" : c).replace(/\\/g, "\\\\").replace(/\|/g, "\\|"); };
    var amUnesc = function (c) { return String(c).replace(/\\([\\|])/g, "$1"); };
    // Split on pipes that are not escaped. Drafts written before this change
    // contain bare pipes and still split on them, which is the behaviour they
    // already had; anything typed from now on round-trips intact.
    function amSplit(line) {
      var out = [], cur = "", i = 0;
      while (i < line.length) {
        var ch = line.charAt(i);
        if (ch === "\\" && i + 1 < line.length) { cur += ch + line.charAt(i + 1); i += 2; continue; }
        if (ch === "|") { out.push(cur); cur = ""; i += 1; continue; }
        cur += ch; i += 1;
      }
      out.push(cur);
      // Five columns; anything beyond the fifth belongs to Reason.
      var cells = [];
      for (var j = 0; j < 4; j++) cells.push(amUnesc(out[j] === undefined ? "" : out[j]).trim());
      cells.push(amUnesc(out.slice(4).join("|")).trim());
      return cells;
    }

    // Read a builder field straight off the page. Used only as a fallback when
    // a builder has not yet been updated to pass the value through pcOf(), so
    // that shipping this component fixes the item everywhere at once instead of
    // waiting on nine separate edits. Export always runs from the live form, so
    // this reads the same values the builder itself would hand over.
    function fromForm(name) {
      try {
        var f = document.querySelector("[data-builder]") || document.querySelector("form");
        if (!f) return "";
        var el = f.querySelector('[name="' + name + '"]');
        return el && el.value != null ? String(el.value) : "";
      } catch (e) {
        console.warn("[PC] could not read field", name, e);
        return "";
      }
    }

    function amendmentRows(s) {
      var raw = (s && s.amendments != null) ? s.amendments : fromForm(AM_FIELD);
      return String(raw || "").split(/\r?\n/).map(function (line) {
        if (!line.trim()) return null;
        var cells = amSplit(line);
        return cells.some(function (c) { return c; }) ? cells : null;
      }).filter(Boolean);
    }

    function amendmentIntro(s, rows) {
      var v = nz(s && s.version, fromForm("version"));
      var at = v ? " (" + v + ")" : "";
      if (!rows.length) {
        return "This is the original version of the protocol" + at + "; no amendments have been made. " +
          "Any later change is recorded here as a numbered amendment with its date, the version it produced, " +
          "the section of the protocol affected, what changed, and the reason for the change.";
      }
      return "The protocol" + at + " has been amended " + rows.length + (rows.length === 1 ? " time" : " times") +
        " since its original version. Each amendment is listed below with its date, the version it produced, " +
        "the section of the protocol affected, what changed, and the reason for the change.";
    }

    function amendmentsMd(s) {
      var rows = amendmentRows(s);
      var out = "## Amendments and updates\n\n" + amendmentIntro(s, rows);
      if (!rows.length) return out + "\n";
      var esc = function (c) { return String(c || "—").replace(/\|/g, "\\|"); };
      out += "\n\n| No. | " + AM_COLS.join(" | ") + " |\n|---|" + AM_COLS.map(function () { return "---"; }).join("|") + "|\n";
      rows.forEach(function (r, i) { out += "| " + (i + 1) + " | " + r.map(esc).join(" | ") + " |\n"; });
      return out;
    }

    // Keyed tail sections. A builder can drop any it already prints itself via
    // pc.skip (e.g. AsPEN builders skip "studySize"/"ethics"). Each entry is
    // [key, heading, bodyLines[], kind?] where kind "bullets" renders a list.
    function tailSections(s) {
      const skip = s.skip || [];
      return [
        ["studySize", "Study size and feasibility", [nz(s.studySize, s.descriptive
          ? "There is no effect size to detect, so the study is sized for PRECISION rather than power: for every reported rate or proportion the expected number of events and the person-time available are established per data source and per stratum in a pilot extraction, and the expected width of the 95% confidence interval is reported alongside them. Cells that will fall below the small-cell suppression rule are identified before the analysis is executed."
          : "Power is assessed per data source from observed exposure and outcome frequencies in a pilot extraction; the study targets ≥ 80% power to detect the smallest clinically important effect at a two-sided α = 0.05. Feasibility (available person-time and event counts) is confirmed before the analysis is executed.")]],
        ["provenance", "Data sources and provenance", [nz(s.dataMeta, "For each source, we record its original purpose, type (claims / EHR / registry), geographic setting, calendar coverage, any record linkage, and the analytic software used.")]],
        ["dataMgmt", "Data management and quality control", ["Source data are extracted and transformed into the analytic dataset with all derived-variable definitions retained and version-controlled. Analytic code is peer-reviewed; variable distributions, cross-variable logic checks, and expected code frequencies are inspected; and missing data are quantified and handled as pre-specified."]],
        ["outputs", "Planned analytical outputs (shell tables and figures)", defaultOutputs(s), "bullets"],
        ["limitations", "Limitations", [limitationsText(s)]],
        ["ethics", "Human subjects, data governance, and dissemination", [ethicsText(s) + " Findings are disseminated via a peer-reviewed manuscript and conference presentation; data-sharing and code-availability follow each source's governance agreements."]],
        ["registration", "Registration and amendments", ["The protocol is registered before analysis (e.g. the EU PAS Register / ClinicalTrials.gov) where applicable" + (s.registration ? ": " + s.registration : "") + ". Amendments are version-controlled and logged with date and rationale."]],
        ["ae", "Adverse-event reporting", ["As a secondary-data analysis of a pre-specified outcome, individual adverse-event reporting does not apply; safety is addressed through the pre-specified outcome analyses."]],
        ["funding", "Funding and conflicts of interest", ["Funding source(s) and each author's conflicts of interest are declared in the final report."]],
      ].filter((x) => !skip.includes(x[0]));
    }

    /* The field has to exist before anything restores into it. If it were
       created only when the editor mounts — which a builder naturally does
       after restoring — then a saved draft's amendments would land nowhere,
       and the first render would write the now-empty field back over them.
       Silent loss of the user's own text, so restore() creates it too and the
       mount order stops mattering. */
    function ensureAmendmentField(form) {
      var field = form.querySelector('[name="' + AM_FIELD + '"]');
      if (!field) {
        // A hidden <input> looks like the obvious choice and is a trap: for
        // type="hidden" the value IDL attribute reflects the CONTENT attribute,
        // so assigning .value also moves .defaultValue. Every builder's
        // "Clear all" resets fields with `el.value = el.defaultValue`, which on
        // such an input is a no-op — the amendments would survive a reset that
        // cleared everything else. A textarea's defaultValue is its markup text
        // and never moves, so this field resets like all the others.
        field = document.createElement("textarea");
        field.name = AM_FIELD;
        field.hidden = true;
        field.setAttribute("aria-hidden", "true");
        field.tabIndex = -1;
        form.appendChild(field);
      }
      return field;
    }

    /* Mount the amendment editor into a builder's form. Idempotent, so a page
       may call it more than once, before or after restore. The rows are a view
       over one hidden field named "amendments"; the field is the single source
       of truth, so the builder's own readForm / localStorage / ?seed= paths
       need no change. */
    function mountAmendments(form, opts) {
      if (!form) return null;
      opts = opts || {};
      var existing = form.querySelector("[data-pc-amendments]");
      if (existing) { existing.__pcSync(); return existing; }

      var field = ensureAmendmentField(form);

      var box = document.createElement("details");
      box.setAttribute("data-pc-amendments", "");
      box.className = "border border-slate-200 rounded-2xl bg-white shadow-sm";
      box.innerHTML =
        '<summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">' +
        'Amendments and updates <span class="font-normal text-slate-500 text-sm">· HARPER front matter</span></summary>' +
        '<div class="px-5 pb-5 space-y-3">' +
        '<p class="text-xs text-slate-600 leading-relaxed">A protocol that has never been amended is not deficient — but it has to <em>say</em> so, ' +
        'because "no amendments yet" and "no log kept" look identical in a finished document. Leave this empty for version 1 and the protocol states ' +
        'that it is the original version. Add a row each time you change the protocol after circulating it.</p>' +
        '<div data-pc-am-rows class="space-y-2"></div>' +
        '<button type="button" data-pc-am-add class="text-xs font-semibold text-brand-700 border border-brand-300 hover:bg-brand-50 px-3 py-1.5 rounded transition">+ Add an amendment</button>' +
        "</div>";

      var anchor = opts.before && form.querySelector(opts.before);
      if (!anchor) { var dl = form.querySelector("[data-action='download-docx']"); anchor = dl ? dl.closest("div") : null; }
      if (anchor && anchor.parentNode === form) form.insertBefore(box, anchor); else form.appendChild(box);

      var rowsEl = box.querySelector("[data-pc-am-rows]");
      var lastWritten = null;
      var INPUT = "border border-slate-300 rounded px-2 py-1.5 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500";

      var readRows = function () {
        return String(field.value || "").split(/\r?\n/).filter(function (l) { return l.trim(); }).map(amSplit);
      };
      var writeRows = function (rows) {
        // Drop rows the user left entirely blank, so an accidental "+ Add"
        // never becomes an empty amendment in the exported protocol.
        var text = rows.filter(function (r) { return r.some(function (c) { return c.trim(); }); })
          .map(function (r) { return r.map(function (c) { return amEsc(String(c).replace(/\r?\n/g, " ").trim()); }).join(" | "); }).join("\n");
        field.value = text;
        lastWritten = text;
        form.dispatchEvent(new Event("input", { bubbles: true }));
      };
      var paint = function (rows) {
        rowsEl.innerHTML = "";
        rows.forEach(function (r, i) {
          var row = document.createElement("div");
          row.className = "grid gap-1.5 sm:grid-cols-[8rem_6rem_1fr_1.4fr_1.4fr_auto] items-start";
          AM_COLS.forEach(function (label, j) {
            var inp = document.createElement("input");
            inp.type = j === 0 ? "date" : "text";
            inp.className = INPUT;
            inp.value = r[j] || "";
            inp.placeholder = label;
            inp.setAttribute("aria-label", label + ", amendment " + (i + 1));
            inp.addEventListener("input", function () { r[j] = inp.value; writeRows(rows); });
            row.appendChild(inp);
          });
          var del = document.createElement("button");
          del.type = "button";
          del.className = "text-xs text-slate-400 hover:text-rose-600 px-2 py-1.5";
          del.textContent = "✕";
          del.setAttribute("aria-label", "Remove amendment " + (i + 1));
          del.addEventListener("click", function () { rows.splice(i, 1); writeRows(rows); paint(rows); });
          row.appendChild(del);
          rowsEl.appendChild(row);
        });
        if (!rows.length) {
          var none = document.createElement("p");
          none.className = "text-xs text-slate-500 italic";
          none.textContent = "No amendments — the protocol will state that this is the original version.";
          rowsEl.appendChild(none);
        }
      };
      var sync = function () { var rows = readRows(); lastWritten = field.value; paint(rows); };

      box.querySelector("[data-pc-am-add]").addEventListener("click", function () {
        var rows = readRows();
        rows.push([new Date().toISOString().slice(0, 10), "", "", "", ""]);
        writeRows(rows); paint(rows);
      });
      // A builder that resets or restores the form writes the hidden field
      // directly. Rebuild if that happened behind the editor's back, so the
      // rows can never disagree with the field the export reads.
      form.addEventListener("change", function () { if (field.value !== lastWritten) sync(); });
      box.__pcSync = sync;
      sync();
      return box;
    }
    function syncAmendments(form) {
      var b = form && form.querySelector("[data-pc-amendments]");
      if (b && b.__pcSync) b.__pcSync();
    }

    // ── Markdown ──────────────────────────────────────────────
    function abstractMd(s) {
      // The amendments log rides with the abstract because HARPER puts it in
      // front matter (item 3, right after item 2) and because every builder
      // already calls this one function — so the item is satisfied everywhere
      // without nine separate edits to nine export functions.
      return "## Structured abstract\n" + abstractLines(s).map((l) => "**" + l[0].trim() + "** " + l[1]).join(" ") + "\n\n"
        + amendmentsMd(s) + "\n";
    }
    function tailMd(s) {
      return tailSections(s).map(([key, h, lines, kind]) =>
        "## " + h + "\n" + (kind === "bullets" ? lines.map((x) => "- " + x).join("\n") : lines.join("\n"))
      ).join("\n\n");
    }

    // ── docx (needs the docx global D) ────────────────────────
    function docxKit(D) {
      const FONT = "Times New Roman";
      const text = (str, o = {}) => new D.TextRun({ text: String(str == null ? "" : str), font: FONT, size: 22, ...o });
      const p = (ch, o = {}) => new D.Paragraph({ children: Array.isArray(ch) ? ch : [ch], spacing: { before: 60, after: 60, ...(o.spacing || {}) }, ...o });
      const h1 = (str) => new D.Paragraph({ children: [text(str, { bold: true, size: 28 })], spacing: { before: 200, after: 80 }, heading: D.HeadingLevel.HEADING_1 });
      const bullet = (str) => new D.Paragraph({ children: [text(str)], bullet: { level: 0 }, spacing: { before: 0, after: 0 } });
      const border = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" };
      const cb = { top: border, bottom: border, left: border, right: border };
      const cell = (str, w, opt) => new D.TableCell(Object.assign({
        borders: cb, width: { size: w, type: D.WidthType.DXA },
        margins: { top: 60, bottom: 60, left: 100, right: 100 },
        children: [p([text(str)])],
      }, opt || {}));
      const headCell = (str, w) => new D.TableCell({
        borders: cb, width: { size: w, type: D.WidthType.DXA },
        shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR },
        margins: { top: 60, bottom: 60, left: 100, right: 100 },
        children: [p([text(str, { bold: true })])],
      });
      return { text, p, h1, bullet, cell, headCell };
    }
    function amendmentsDocx(D, s) {
      const k = docxKit(D);
      const rows = amendmentRows(s);
      const out = [k.h1("Amendments and updates"), k.p([k.text(amendmentIntro(s, rows))])];
      if (!rows.length) return out;
      const W = [560, 1180, 1180, 1560, 2400, 2146];
      const header = new D.TableRow({ tableHeader: true, children: ["No."].concat(AM_COLS).map((c, i) => k.headCell(c, W[i])) });
      const body = rows.map((r, i) => new D.TableRow({ children: [String(i + 1)].concat(r.map((c) => c || "—")).map((c, j) => k.cell(c, W[j])) }));
      out.push(new D.Table({ width: { size: 9026, type: D.WidthType.DXA }, columnWidths: W, rows: [header].concat(body) }));
      return out;
    }
    function abstractDocx(D, s) {
      const k = docxKit(D);
      const out = [k.h1("Structured abstract")];
      abstractLines(s).forEach((l) => out.push(k.p([k.text(l[0], { bold: true }), k.text(l[1])])));
      amendmentsDocx(D, s).forEach((c) => out.push(c));
      return out;
    }
    function tailDocx(D, s) {
      const k = docxKit(D), out = [];
      tailSections(s).forEach(([key, h, lines, kind]) => {
        out.push(k.h1(h));
        if (kind === "bullets") lines.forEach((b) => out.push(k.bullet(b)));
        else lines.forEach((b) => out.push(k.p([k.text(b)])));
      });
      return out;
    }

    /* ── Seeding a builder from a link ───────────────────────────────────
       A study proposal that already exists elsewhere — in the Hot Topic
       platform, in an email, in a colleague's notes — should not have to be
       retyped into these forms field by field. `?seed=` carries a state object
       in the same shape the builder already saves to localStorage.

       base64url, so the value survives being pasted into chat clients and
       mail readers that mangle raw JSON in a query string.

       Returns null when there is no seed, so callers keep their existing
       localStorage restore as the fallback and behave exactly as before. */
    function readSeed() {
      try {
        var raw = new URLSearchParams(location.search).get("seed");
        if (!raw) return null;
        var b64 = raw.replace(/-/g, "+").replace(/_/g, "/");
        while (b64.length % 4) b64 += "=";
        var json = decodeURIComponent(escape(atob(b64)));  // atob is byte-wise; undo UTF-8
        var obj = JSON.parse(json);
        return obj && typeof obj === "object" ? obj : null;
      } catch (e) {
        console.warn("[seed] ignoring unreadable seed:", e);
        return null;
      }
    }

    /* Write a flat {fieldName: value} object into a form. Mirrors what the
       builders' own writeForm does, for the pages that restore inline. */
    function applySeed(form, state) {
      if (!form || !state) return false;
      for (var k in state) {
        var els = form.elements[k];
        if (!els) continue;
        var val = state[k];

        // form.elements[name] is a single element only when the name is unique.
        // Share a name across several controls — every checkbox group here does
        // — and it is a RadioNodeList, which has no .type, so the old code fell
        // through to `els.value = val`. On a RadioNodeList that setter only
        // ticks a matching RADIO; for a checkbox group it is a silent no-op, so
        // a seeded set of ticks was dropped without a word.
        var many = els.tagName === undefined && typeof els.length === "number";
        var nodes = many ? Array.prototype.slice.call(els) : [els];
        var first = nodes[0];
        if (!first) continue;

        if (first.type === "checkbox") {
          if (Array.isArray(val)) {
            var want = val.map(String);
            nodes.forEach(function (n) { n.checked = want.indexOf(n.value) >= 0; });
          } else if (typeof val === "boolean" || val == null) {
            nodes.forEach(function (n) { n.checked = !!val; });
          } else {
            // A lone checkbox stored as its own value, or "true"/"1".
            var sv = String(val);
            nodes.forEach(function (n) { n.checked = n.value === sv || sv === "true" || sv === "1" || sv === "on"; });
          }
        } else if (first.type === "radio") {
          // Assigning .value here would rewrite the option a radio stands for.
          var rv = Array.isArray(val) ? String(val[0]) : String(val == null ? "" : val);
          nodes.forEach(function (n) { n.checked = n.value === rv; });
        } else if (Array.isArray(val)) {
          nodes.forEach(function (n, i) { if (val[i] != null) n.value = val[i]; });
        } else {
          nodes.forEach(function (n) { n.value = val == null ? "" : val; });
        }
      }
      syncAmendments(form);
      return true;
    }

    /* `?seed=paste` — the payload was too large to travel in the URL.
       A worked-up proposal carries 600-900 characters per operational
       definition, which base64-encodes past 20,000 characters and is refused
       as "URI Too Long", so the sender copies it and this offers somewhere to
       put it. Keeping it off the query string also keeps an unpublished study
       out of browser history. */
    function pastePanel(form, write) {
      if (document.getElementById("pc-paste")) return;

      var applyText = function (raw, onFail) {
        raw = (raw || "").trim();
        if (!raw) { onFail && onFail("剪貼簿是空的"); return false; }
        var obj;
        try { obj = JSON.parse(raw); } catch (e) {
          onFail && onFail("看不懂這段內容 — 請確認是從 Hot Topic 的「開啟 Protocol」複製的");
          return false;
        }
        write(obj);
        var b = document.getElementById("pc-paste");
        if (b) b.remove();
        banner();
        form.dispatchEvent(new Event("input", { bubbles: true }));
        return true;
      };

      /* Try to read the clipboard outright. A browser will not let a page do
         this silently the first time — it prompts, and the prompt needs the
         document focused — but once the user allows it for this site, every
         later hand-off fills the form with no interaction at all. The panel
         below only appears when that fails. */
      var auto = function () {
        if (!navigator.clipboard || !navigator.clipboard.readText) return Promise.resolve(false);
        return navigator.clipboard.readText().then(
          function (txt) { return applyText(txt); },
          function () { return false; }
        );
      };

      auto().then(function (done) {
        if (done) return;

        var box = document.createElement("div");
        box.id = "pc-paste";
        box.style.cssText =
          "margin:0 0 1rem;padding:.9rem 1rem;border-radius:10px;" +
          "background:#EAF3EE;border:1px solid #9CC9AE;";
        box.innerHTML =
          '<div style="font-weight:600;margin-bottom:.35rem">從 Hot Topic 帶入研究設計</div>' +
          '<div style="font-size:.85rem;color:#3D5560;margin-bottom:.6rem">' +
          '內容已複製到剪貼簿。按下面的按鈕貼上 — 瀏覽器會問一次是否允許讀取剪貼簿,' +
          '允許之後以後就會自動填入。你目前的草稿在套用前不會被改動。</div>' +
          '<div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">' +
          '<button type="button" id="pc-paste-read" style="font:inherit;cursor:pointer;' +
          'background:#3F8C6E;color:#fff;border:0;border-radius:6px;padding:.4rem 1rem">' +
          '從剪貼簿貼上</button>' +
          '<button type="button" id="pc-paste-manual" style="font:inherit;cursor:pointer;' +
          'background:transparent;color:#3D5560;border:1px solid #9CC9AE;border-radius:6px;' +
          'padding:.4rem .9rem">改用手動貼上</button>' +
          '<span id="pc-paste-msg" style="font-size:.85rem;color:#9E3A2C"></span></div>' +
          '<textarea id="pc-paste-in" rows="3" style="display:none;width:100%;margin-top:.6rem;' +
          'font-family:ui-monospace,monospace;font-size:.8rem;padding:.5rem;' +
          'border:1px solid #9CC9AE;border-radius:6px"></textarea>';
        var f = document.querySelector("form");
        if (f && f.parentNode) f.parentNode.insertBefore(box, f);

        var msg = box.querySelector("#pc-paste-msg");
        var ta = box.querySelector("#pc-paste-in");
        var fail = function (m) { msg.textContent = m; };

        box.querySelector("#pc-paste-read").addEventListener("click", function () {
          msg.textContent = "";
          if (!navigator.clipboard || !navigator.clipboard.readText) {
            ta.style.display = "block"; ta.focus();
            fail("這個瀏覽器不支援讀取剪貼簿,請手動貼上");
            return;
          }
          navigator.clipboard.readText().then(
            function (txt) { applyText(txt, fail); },
            function () {
              ta.style.display = "block"; ta.focus();
              fail("瀏覽器不允許讀取剪貼簿,請在下方手動貼上 (Ctrl+V)");
            }
          );
        });

        box.querySelector("#pc-paste-manual").addEventListener("click", function () {
          ta.style.display = "block"; ta.focus(); msg.textContent = "";
        });
        ta.addEventListener("paste", function () {
          setTimeout(function () { applyText(ta.value, fail); }, 0);
        });
      });
    }

    /* One call for the common case: seed if present, else restore the saved
       draft. Returns "seed" | "paste" | "saved" | "none" so a page can tell
       the user. */
    function restore(form, storageKey, writeForm) {
      if (form) ensureAmendmentField(form);   // must exist before anything writes into it
      var write = function (s) {
        (writeForm || function (x) { applySeed(form, x); })(s);
        syncAmendments(form);
      };
      if (new URLSearchParams(location.search).get("seed") === "paste") {
        pastePanel(form, write);
        return "paste";
      }
      var seeded = readSeed();
      if (seeded) {
        /* Copy the saved draft aside BEFORE the seed lands on top of it.
           Without this the banner below was simply untrue: a builder's first
           render() autosaves the form to the very same storage key, and that
           happens within a few milliseconds of the seed being applied — before
           the document has even finished parsing. So by the time the user read
           "your previous draft is still in the browser, reload without the seed
           parameter to get it back" and did exactly that, what came back was
           the seed. One key, no copy, nothing typed surviving: a draft built
           over an afternoon could be destroyed by opening a colleague's link,
           with the page asserting the opposite on screen. */
        var backup = null;
        try { backup = localStorage.getItem(storageKey); } catch (e) { console.warn("[PC] could not read the saved draft", e); }
        if (backup) {
          try { localStorage.setItem(storageKey + ".before-seed", backup); }
          catch (e) { console.warn("[PC] could not set the draft aside", e); backup = null; }
        }
        write(seeded);
        banner(backup ? storageKey : null);
        return "seed";
      }
      try {
        var saved = localStorage.getItem(storageKey);
        if (saved) { write(JSON.parse(saved)); return "saved"; }
      } catch (e) {
        console.warn("[PC] saved draft could not be read", e);
      }
      return "none";
    }

    /* Say where the values came from, and — when there was a draft to lose —
       give back the only thing that can actually recover it. The previous
       version told the user in Chinese, on pages written in English, to do
       something that did not work (see restore() above). It now states what
       happened and offers a button that puts the draft back and reloads
       without the seed. `storageKey` is null when there was no draft to
       displace, in which case there is nothing to offer. */
    function banner(storageKey) {
      if (document.getElementById("pc-seed-note")) return;
      var d = document.createElement("div");
      d.id = "pc-seed-note";
      d.setAttribute("role", "status");
      d.style.cssText =
        "margin:0 0 1rem;padding:.6rem .85rem;border-radius:8px;font-size:.85rem;" +
        "background:#E8F3EC;border:1px solid #9CC9AE;color:#1E5B3A;";

      var p = document.createElement("p");
      p.style.cssText = "margin:0";
      p.textContent = storageKey
        ? "This form was pre-filled from a link. Your previous draft has been set aside — it is NOT recoverable by reloading, because the link's values are saved over it. 此表單由連結預先填入,你原本的草稿已另存備份。"
        : "This form was pre-filled from a link. 此表單由連結預先填入。";
      d.appendChild(p);

      if (storageKey) {
        var b = document.createElement("button");
        b.type = "button";
        b.textContent = "Restore my previous draft / 取回我原本的草稿";
        b.style.cssText =
          "margin-top:.5rem;font:inherit;cursor:pointer;background:#3F8C6E;color:#fff;" +
          "border:0;border-radius:6px;padding:.35rem .9rem";
        b.addEventListener("click", function () {
          try {
            var saved = localStorage.getItem(storageKey + ".before-seed");
            if (saved == null) { b.textContent = "The backup could not be read."; return; }
            localStorage.setItem(storageKey, saved);
          } catch (e) {
            console.warn("[PC] could not restore the draft", e);
            b.textContent = "This browser would not let the draft be restored.";
            return;
          }
          // Reload WITHOUT the seed, so the restored draft is what loads.
          location.replace(location.pathname + location.hash);
        });
        d.appendChild(b);
      }

      var f = document.querySelector("form");
      if (f && f.parentNode) f.parentNode.insertBefore(d, f);
    }

    window.PC = { abstractMd, tailMd, abstractDocx, tailDocx,
                  readSeed: readSeed, applySeed: applySeed, restore: restore,
                  mountAmendments: mountAmendments, syncAmendments: syncAmendments,
                  amendmentRows: amendmentRows, amendmentsMd: amendmentsMd, amendmentsDocx: amendmentsDocx };
  })();
</script>
