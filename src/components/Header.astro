---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { label: "Home", zh: "首頁", href: `${base}/` || "/" },
  { label: "About", zh: "關於我", href: `${base}/about` },
  { label: "Publications", zh: "論文", href: `${base}/publications` },
  { label: "Writing", zh: "方法筆記", href: `${base}/writing` },
  { label: "Talks", zh: "演講", href: `${base}/talks` },
  { label: "RWE Tools", zh: "RWE 工具", href: `${base}/tools` },
  { label: "Networks", zh: "合作網絡", href: `${base}/networks` },
];

const isActive = (href: string) => {
  const clean = href.replace(/\/$/, "") || "/";
  if (clean === (base || "/")) return path === (base || "/");
  return path === clean || path.startsWith(clean + "/");
};
---

<header class="sticky top-0 z-40 bg-white/85 backdrop-blur border-b border-slate-200">
  <nav class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <a href={`${base}/` || "/"} class="flex items-center gap-2 font-extrabold text-slate-900 tracking-tight">
      <span aria-hidden="true" class="text-2xl leading-none font-extrabold tracking-tighter text-brand-700">dt<span class="text-accent-500">.</span></span>
      <span>Daniel Tsai</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-1 lg:gap-2 text-sm font-semibold">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "px-3 py-2 rounded-lg transition",
            isActive(item.href)
              ? "text-brand-700 bg-brand-50"
              : "text-slate-600 hover:text-brand-700 hover:bg-slate-50",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          <span class="l-en">{item.label}</span><span class="l-zh">{item.zh}</span>
        </a>
      ))}
    </div>

    <!-- Language switch: two buttons so the current language is always visible
         and the other one is one tap away, on phones too. -->
    <div class="flex items-center gap-1 ml-auto md:ml-0" role="group" aria-label="Language 語言">
      <button type="button" data-set-lang="en" aria-pressed="true" class="lang-btn px-2 py-1 rounded-md text-xs font-bold transition">EN</button>
      <button type="button" data-set-lang="zh" aria-pressed="false" lang="zh-Hant" class="lang-btn px-2 py-1 rounded-md text-xs font-bold transition">中文</button>
    </div>

    <!-- Mobile hamburger -->
    <button
      type="button"
      data-menu-btn
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden inline-grid place-items-center w-10 h-10 -mr-2 rounded-lg text-slate-700 hover:bg-slate-100 transition"
    >
      <svg data-menu-open class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
      <svg data-menu-close class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </nav>

  <!-- Mobile panel -->
  <div id="mobile-menu" data-menu-panel class="md:hidden hidden border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-3 flex flex-col gap-1 text-sm font-semibold">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "px-3 py-2.5 rounded-lg transition",
            isActive(item.href) ? "text-brand-700 bg-brand-50" : "text-slate-700 hover:bg-slate-50",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          <span class="l-en">{item.label}</span><span class="l-zh">{item.zh}</span>
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .lang-btn { color: #64748b; }
  .lang-btn:hover { color: var(--color-brand-700); background: #f1f5f9; }
  .lang-btn[aria-pressed="true"] { color: var(--color-brand-700); background: var(--color-brand-50); }
</style>

<script is:inline>
  // Language switch. The head script in BaseLayout has already set <html lang>
  // from the saved choice; this keeps the buttons in step and handles clicks.
  (function () {
    var h = document.documentElement;
    var btns = document.querySelectorAll("[data-set-lang]");
    function current() { return h.lang === "zh-Hant" ? "zh" : "en"; }
    function paint() {
      var l = current();
      btns.forEach(function (b) { b.setAttribute("aria-pressed", String(b.getAttribute("data-set-lang") === l)); });
      var t = l === "zh" ? h.dataset.titleZh : h.dataset.titleEn;
      if (t) document.title = t;
      var d = l === "zh" ? h.dataset.descZh : h.dataset.descEn;
      var m = document.querySelector('meta[name="description"]');
      if (m && d) m.setAttribute("content", d);
      // Attributes cannot be doubled up the way text can, so elements carry
      // data-zh-<attr> / data-en-<attr> and get the right one written in.
      document.querySelectorAll("[data-i18n-attr]").forEach(function (el) {
        el.getAttribute("data-i18n-attr").split(",").forEach(function (a) {
          var v = el.getAttribute("data-" + l + "-" + a);
          if (v !== null) el.setAttribute(a, v);
        });
      });
    }
    window.setLang = function (l) {
      h.lang = l === "zh" ? "zh-Hant" : "en";
      try { localStorage.setItem("lang", l === "zh" ? "zh" : "en"); } catch (e) {}
      paint();
      document.dispatchEvent(new CustomEvent("langchange", { detail: current() }));
    };
    window.getLang = current;
    btns.forEach(function (b) { b.addEventListener("click", function () { window.setLang(b.getAttribute("data-set-lang")); }); });
    paint();
    // This script runs while the header is being parsed, before the rest of
    // the page exists, so translated attributes further down are set once the
    // document is complete.
    document.addEventListener("DOMContentLoaded", paint);
  })();
  (function () {
    var btn = document.querySelector("[data-menu-btn]");
    var panel = document.querySelector("[data-menu-panel]");
    if (!btn || !panel) return;
    var openI = btn.querySelector("[data-menu-open]");
    var closeI = btn.querySelector("[data-menu-close]");
    function setOpen(open) {
      panel.classList.toggle("hidden", !open);
      btn.setAttribute("aria-expanded", String(open));
      // The label has to track the state, or a screen reader keeps offering
      // "Open menu" on a menu that is already open.
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      if (openI) openI.classList.toggle("hidden", open);
      if (closeI) closeI.classList.toggle("hidden", !open);
    }
    btn.addEventListener("click", function () {
      setOpen(panel.classList.contains("hidden"));
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !panel.classList.contains("hidden")) {
        setOpen(false);
        btn.focus();
      }
    });
  })();
</script>
