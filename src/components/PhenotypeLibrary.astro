---
// Reusable "Pick from library" modal. Drop it once on a page, then add
// trigger buttons anywhere with:
//   data-open-library data-category="exposures|outcomes|indications"
//   data-target-name="fieldName" [data-target-codes="…"] [data-target-def="…"] [data-also-fill="…"]
// Clicking a library row fills the named form fields on the page.
import { PHENOTYPES, tierOf, bestPpv } from "../data/phenotypes";
import type { Phenotype } from "../data/phenotypes";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// The full studies live on /tools/phenotypes; the modal carries a short form
// of them (tier, how many studies, the best PPV and where it was measured) and
// links each row to its full entry there.
const slugOf = (name: string) =>
  name.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const short = (p: Phenotype) => {
  const b = bestPpv(p);
  const hi = p.highImpact?.[0];
  return {
    name: p.name, codes: p.codes, definition: p.definition, notes: p.notes,
    slug: slugOf(p.name), tier: tierOf(p), n: p.validations?.length ?? 0,
    best: b ? { ppv: Math.round(b.ppv * 10) / 10, db: b.study.db, country: b.study.country } : null,
    hi: hi ? { journal: hi.journal, jif: hi.jif } : null,
    // what the search box looks through, beyond what the row shows
    hay: [...(p.validations ?? []), ...(p.highImpact ?? [])].map((v) => [v.db, v.country, v.icd10, v.icd9, v.short].join(" ")).join(" "),
  };
};
const LIB = Object.fromEntries(Object.entries(PHENOTYPES).map(([k, items]) => [k, items.map(short)]));
const FULL = `${base}/tools/phenotypes`;
---

<div data-library-modal class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-start justify-center p-4 sm:p-8 overflow-y-auto">
  <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full my-8">
    <div class="flex items-start justify-between p-5 border-b border-slate-200">
      <div>
        <p class="text-xs uppercase tracking-widest text-brand-700 font-bold">Phenotype library</p>
        <h3 class="text-lg font-bold text-slate-900 mt-0.5" data-library-title>Pick a phenotype</h3>
        <a href={`${base}/tools/phenotypes`} target="_blank" rel="noopener" class="mt-1 inline-block text-xs font-semibold text-brand-700 hover:underline">Open the full library ↗</a>
      </div>
      <button type="button" data-library-close class="text-slate-400 hover:text-slate-700 text-2xl leading-none">×</button>
    </div>
    <div class="p-5">
      <input type="text" data-library-search placeholder="Filter… (e.g. 'MI', 'SGLT2', 'suicide')" class="w-full rounded-lg border border-slate-300 p-2 text-sm mb-2" />
      <!-- The two things that are true of EVERY row live here, once. Repeating
           them per row cost this list half its visible height — measured at 2-3
           entries visible instead of 5-6 — for no per-row information. -->
      <p class="text-[11px] text-slate-500 leading-relaxed mb-3">
        Each entry says whether a study has measured how well it identifies what it names, with the best PPV found and
        where; "Full entry" opens every study. Nothing here is added to your protocol's reference list, so cite what you use yourself.
      </p>
      <div data-library-list class="space-y-2 max-h-[55vh] overflow-y-auto"></div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ PHENOTYPES: LIB, FULL }}>
  (function () {
    const modal = document.querySelector("[data-library-modal]");
    if (!modal) return;
    const listEl = modal.querySelector("[data-library-list]");
    const searchEl = modal.querySelector("[data-library-search]");
    const titleEl = modal.querySelector("[data-library-title]");
    let current = { category: "exposures", trigger: null };

    const close = () => modal.classList.add("hidden");
    modal.querySelector("[data-library-close]").addEventListener("click", close);
    modal.addEventListener("click", (e) => { if (e.target === modal) close(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    function fillFrom(item) {
      const t = current.trigger; if (!t) return;
      const set = (name, val) => {
        if (!name || val == null) return;
        const el = document.querySelector('[name="' + name + '"]');
        if (el) { el.value = val; el.dispatchEvent(new Event("input", { bubbles: true })); el.dispatchEvent(new Event("change", { bubbles: true })); }
      };
      set(t.dataset.targetName, item.name);
      set(t.dataset.targetCodes, item.codes || "");
      if (t.dataset.targetDef) set(t.dataset.targetDef, item.definition || item.codes || "");
      set(t.dataset.alsoFill, item.name);
      close();
    }

    // Whether a definition has ever been measured against a reference standard
    // is the single most important thing about it, so every row says which of
    // three tiers it is in, at the moment of picking: validated (with how many
    // studies and the best PPV found, and where), used in a high-impact study
    // (not validated), or no published source. The studies themselves are on
    // the library page; each row links to its full entry there. The link sits
    // beside the row's button, not inside it, so a click on it never fills the
    // form.
    //
    // The wording deliberately does NOT promise a citation reaches the
    // protocol: nothing here has a pickedCitations mechanism, so cite what you
    // use yourself.
    function tierLine(it) {
      if (it.tier === "validated") {
        const n = it.n + (it.n === 1 ? " study" : " studies");
        const best = it.best ? " · best PPV " + it.best.ppv + "% (" + esc(it.best.db) + ", " + esc(it.best.country) + ")" : "";
        return '<p class="mt-1.5 text-[11px] text-emerald-800 leading-relaxed"><span class="font-bold uppercase tracking-widest text-[9px]">Validated</span> · ' + n + best + "</p>";
      }
      if (it.tier === "highImpact") {
        return '<p class="mt-1.5 text-[11px] text-amber-800 leading-relaxed"><span class="font-bold uppercase tracking-widest text-[9px]">Used in a high-impact study (not validated)</span>' + (it.hi ? " · " + esc(it.hi.journal) + ", JIF " + esc(it.hi.jif) : "") + "</p>";
      }
      return '<p class="mt-1.5 text-[11px] text-amber-800 leading-relaxed"><span class="font-bold uppercase tracking-widest text-[9px]">No published source</span> · Nothing here measures how accurately this definition finds what it names. Check or validate it before use.</p>';
    }
    function renderList() {
      const items = PHENOTYPES[current.category] || [];
      const q = (searchEl.value || "").toLowerCase().trim();
      // Search what is on screen, plus the databases, codes and first authors
      // of the studies behind each row.
      const shown = items.filter((it) => !q || (it.name + " " + (it.codes || "") + " " + (it.definition || "") + " " + (it.notes || "") + " " + it.hay).toLowerCase().includes(q));
      listEl.innerHTML = shown.map((it) =>
        '<div class="relative">' +
        '<button type="button" data-idx="' + items.indexOf(it) + '" class="block w-full text-left rounded-lg border border-slate-200 p-3 pr-24 hover:border-brand-400 hover:bg-brand-50/40 transition">' +
        '<p class="text-sm font-semibold text-slate-900">' + esc(it.name) + "</p>" +
        (it.codes ? '<p class="text-xs text-slate-500 mt-0.5">' + esc(it.codes) + "</p>" : "") +
        (it.definition ? '<p class="text-xs text-slate-600 mt-1">' + esc(it.definition) + "</p>" : "") +
        (it.notes && it.notes.trim() ? '<p class="text-[11px] text-slate-500 mt-1 leading-relaxed">' + esc(it.notes) + "</p>" : "") +
        tierLine(it) +
        "</button>" +
        '<a href="' + FULL + "#" + it.slug + '" target="_blank" rel="noopener" class="absolute top-3 right-3 text-[11px] font-semibold text-brand-700 hover:underline">Full entry ↗</a>' +
        "</div>"
      ).join("") || '<p class="text-sm text-slate-400 p-3">No matches.</p>';
      listEl.querySelectorAll("[data-idx]").forEach((b) => b.addEventListener("click", () => fillFrom(items[+b.dataset.idx])));
    }
    searchEl.addEventListener("input", renderList);

    // Full phrase including the article — "Pick a " + "outcome" rendered
    // "Pick a outcome" on every outcome pick.
    const LABELS = { indications: "a population / indication", exposures: "a drug (exposure or comparator)", outcomes: "an outcome" };
    document.querySelectorAll("[data-open-library]").forEach((btn) => {
      btn.addEventListener("click", () => {
        current = { category: btn.dataset.category || "exposures", trigger: btn };
        titleEl.textContent = "Pick " + (LABELS[current.category] || "a phenotype");
        searchEl.value = ""; renderList();
        modal.classList.remove("hidden"); searchEl.focus();
      });
    });

    // ?library=indications&q=Lennox opens the library on load, exactly as a
    // click on the page's own Library button would, with the search filled in.
    // It lets other pages point at one entry (the Publications page links a
    // paper to the definition it validated).
    const want = new URLSearchParams(location.search);
    const cat = want.get("library");
    if (cat && Object.prototype.hasOwnProperty.call(PHENOTYPES, cat)) {
      const btn = document.querySelector('[data-open-library][data-category="' + cat + '"]');
      if (btn) {
        btn.click();
        const q = (want.get("q") || "").slice(0, 60);
        if (q) { searchEl.value = q; renderList(); }
      }
    }
  })();
</script>
