---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** Traditional Chinese versions; each falls back to the English one. */
  eyebrowZh?: string;
  titleZh?: string;
  descriptionZh?: string;
}
const { eyebrow, title, description, eyebrowZh, titleZh, descriptionZh } = Astro.props;
---

<header class="relative bg-gradient-to-br from-brand-50 via-white to-brand-100/40 border-b border-slate-200 overflow-hidden">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14">
    <div>
      {eyebrow && <p class="uppercase tracking-widest text-xs text-brand-600 font-semibold mb-2"><span class="l-en">{eyebrow}</span><span class="l-zh">{eyebrowZh ?? eyebrow}</span></p>}
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900"><span class="l-en">{title}</span><span class="l-zh">{titleZh ?? title}</span></h1>
      {description && <p class="mt-4 text-lg text-slate-600 max-w-3xl"><span class="l-en">{description}</span><span class="l-zh">{descriptionZh ?? description}</span></p>}
    </div>
  </div>
</header>
