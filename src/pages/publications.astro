---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PublicationItem from "../components/PublicationItem.astro";
import type { Pub } from "../components/PublicationItem.astro";
import CiteScript from "../components/CiteScript.astro";
import pubs from "../data/publications.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Strict newest → oldest by publication date.
const all = (pubs as (Pub & { date?: number; pmcid?: string })[]).slice().sort((a, b) => (b.date || 0) - (a.date || 0));

// Group by year (newest first)
const years = [...new Set(all.map((p) => p.year))].sort((a, b) => b.localeCompare(a));
const byYear = years.map((y) => ({ year: y, items: all.filter((p) => p.year === y) }));

---

<BaseLayout
  title="Publications — Daniel Tsai"
  titleZh="論文｜蔡相德 Daniel Tsai"
  description="Complete list of peer-reviewed publications by Daniel Tsai, tagged with study design and data source where the paper states them, with links to the tools that let you run the same design."
  descriptionZh="蔡相德的同儕審查論文完整清單，依論文所述標示研究設計與資料來源，並連到能讓你照同一個設計動手做的工具。"
>
  <PageHeader
    eyebrow="Research"
    eyebrowZh="研究"
    title="Publications"
    titleZh="論文"
    description={`${all.length} peer-reviewed publications, tagged with study design and data source where the paper states them. Where a tool on this site lets you run the same design, the paper links to it.`}
    descriptionZh={`共 ${all.length} 篇同儕審查論文，依論文所述標示研究設計與資料來源。本站若有能讓你照同一個設計做一次的工具，論文底下會附上連結。`}
  />

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-slate-600 border-b border-slate-200 pb-6 mb-8">
      <span><strong class="text-brand-700 text-base">{all.length}</strong> <span class="l-en">publications</span><span class="l-zh">篇論文</span></span>
      <a href="https://orcid.org/0000-0003-2841-0338" target="_blank" rel="noopener" class="font-semibold text-brand-700 hover:underline">ORCID 0000-0003-2841-0338 ↗</a>
      <a href={`${base}/about`} class="font-semibold text-brand-700 hover:underline"><span class="l-en">About &amp; CV</span><span class="l-zh">關於我與履歷</span> →</a>
      <a href={`${base}/#map`} class="font-semibold text-brand-700 hover:underline"><span class="l-en">Research map</span><span class="l-zh">研究地圖</span> →</a>
    </div>

    <p class="text-xs text-slate-500 mb-8">
      <span class="inline-flex items-center gap-1.5"><span class="inline-block w-2 h-2 rounded-full bg-accent-500"></span> <span class="l-en">Free full text on PubMed Central</span><span class="l-zh">PubMed Central 可免費閱讀全文</span></span>
      <span class="mx-3">·</span>
      <span class="l-en">Cite downloads a RIS file</span><span class="l-zh">「引用」會下載 RIS 檔</span>
      <span class="mx-3">·</span>
      <span class="l-en">JCR opens the journal's impact factor (needs Web of Science access)</span><span class="l-zh">JCR 會開啟期刊影響係數（需 Web of Science 權限）</span>
    </p>

    {byYear.map((grp) => (
      <section class="mb-10">
        <h2 class="text-xl font-extrabold text-brand-700 mb-4 sticky top-16 bg-white/90 backdrop-blur py-1">{grp.year}</h2>
        <ol class="space-y-5">
          {grp.items.map((p) => <PublicationItem pub={p} />)}
        </ol>
      </section>
    ))}
  </div>

  <CiteScript />

</BaseLayout>
