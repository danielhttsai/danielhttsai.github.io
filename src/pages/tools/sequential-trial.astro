---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhenotypeLibrary from "../../components/PhenotypeLibrary.astro";
import SitesPicker from "../../components/SitesPicker.astro";
import DesignDiagram from "../../components/DesignDiagram.astro";
import ProtocolCommon from "../../components/ProtocolCommon.astro";
import TargetChecklist from "../../components/TargetChecklist.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Curated lists surfaced as checkboxes (matching the ACNU/SCCS/CCO/DA builders).
const SUBGROUPS = [
  "Age group (e.g. ≥65 vs <65)",
  "Sex (male vs female)",
  "Comorbidity burden (e.g. CCI ≥2 vs <2)",
  "Prior cardiovascular disease",
  "Baseline disease severity",
  "Prior hospitalisation for the condition",
  "Index / calendar year (before vs after a cut-point)",
  "Baseline risk score (high vs low)",
];
const SENSITIVITY = [
  "Trial interval (e.g. quarterly vs yearly)",
  "Pooled vs trial-stratified estimates, compared descriptively across calendar time",
  "Maximum follow-up per trial",
  "Per-protocol (deviation censoring + IPCW) vs ITT",
  "Restrict outcomes to inpatient / emergency records",
  "Negative-control outcome",
  "Alternative propensity-score specification",
  "E-value for unmeasured confounding",
];
---

<BaseLayout
  title="Sequential Trial Emulation (ST) protocol — Daniel Tsai"
  description="A free, in-browser protocol builder for the sequential (nested) trial emulation approach to target-trial emulation, with one-click Word / Markdown export."
>
  <header class="relative bg-gradient-to-br from-brand-50 via-white to-brand-100/40 border-b border-slate-200 overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
      <p class="uppercase tracking-widest text-xs text-brand-600 font-semibold mb-2">Protocol Generator · ST</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">Sequential Trial Emulation protocol</h1>
      <p class="mt-3 text-base text-slate-600 max-w-3xl">
        Draft a target-trial-emulation protocol as a <strong>sequence of nested trials</strong> — one emulated trial at
        each eligible time origin. Where the control arm is those not yet treated, patients who stay eligible enter
        several trials, so estimates are pooled across trials and the uncertainty has to account for that re-use —
        by a bootstrap over patients, or a patient-clustered robust variance. Handles time-varying eligibility,
        staggered entry, and the prevalent-user problem. Everything runs in your browser.
      </p>
      <a class="mt-4 inline-block text-sm text-brand-700 hover:underline font-semibold" href={`${base}/tools/protocol-generator`}>← All designs</a>
    </div>
  </header>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid gap-8 lg:grid-cols-[1fr_1fr] items-start">
      <!-- Form -->
      <form id="form" class="protocol-form space-y-6">
        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">1 · Identity</legend>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Study title</span>
            <input name="title" placeholder="e.g. Metformin vs sulfonylurea and dementia: a sequential trial emulation" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Data source(s)</span>
            <input name="data" placeholder="e.g. Taiwan NHIRD (2003–2019)" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <SitesPicker target="data" />
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">2 · Causal question</legend>
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Population</span>
              <button type="button" data-open-library data-category="indications" data-target-name="population" class="text-[11px] text-brand-700 font-semibold hover:underline">📚 Library</button>
            </div>
            <input name="population" placeholder="e.g. Adults ≥ 50 with type 2 diabetes, no dementia at baseline" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Treatment (index)</span>
                <button type="button" data-open-library data-category="exposures" data-target-name="exposure" class="text-[11px] text-brand-700 font-semibold hover:underline">📚</button>
              </div>
              <input name="exposure" placeholder="e.g. Metformin use in the interval" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
            </div>
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Comparator</span>
                <button type="button" data-open-library data-category="exposures" data-target-name="comparator" class="text-[11px] text-brand-700 font-semibold hover:underline">📚</button>
              </div>
              <input name="comparator" placeholder="e.g. Sulfonylurea use (active comparator)" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Outcome</span>
              <button type="button" data-open-library data-category="outcomes" data-target-name="outcome" class="text-[11px] text-brand-700 font-semibold hover:underline">📚 Library</button>
            </div>
            <input name="outcome" placeholder="e.g. Incident all-cause dementia" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
          </div>
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">3 · Sequence of trials</legend>
          <details class="rounded-lg bg-slate-50 border border-slate-200 px-3 py-2 text-xs text-slate-600">
            <summary class="cursor-pointer font-semibold text-slate-700">In one sentence: instead of one trial starting on one day, you run the same trial again on every day someone could have been randomised.</summary>
            <p class="mt-2 leading-relaxed">A single-origin new-user study has to pick one moment and discard everyone who becomes eligible later. Here each origin gets its own trial: eligibility, treatment assignment and the start of follow-up are all re-assessed at that origin, so each nested trial is itself a complete new-user trial and time zero stays aligned — which is what keeps immortal time out.</p>
            <p class="mt-2 leading-relaxed">Two versions of this design exist and they are <strong>not interchangeable</strong>, so section 3 asks which you mean. If the control arm is <em>those not yet treated</em> at each origin (Hernán 2008, Danaei 2013, Gran 2010 — every paper cited on this page), a patient enters a trial at every origin until they initiate or have the outcome. If instead both arms initiate at the origin — an <em>active comparator</em> — a patient is assigned at the single origin at which they initiate.</p>
            <p class="mt-2 leading-relaxed">The price of the first is that <strong>the same person appears in several trials</strong>, often with overlapping follow-up. Those trials are not independent samples, and two things follow: the variance must account for the re-use (Section 10 of the protocol), and per-trial estimates cannot be pooled as if they came from separate studies. Under the second, each patient sits in one trial and none of that applies.</p>
          </details>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">First origin</span>
              <input name="first" placeholder="e.g. Jan 2003" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Last origin</span>
              <input name="last" placeholder="e.g. Dec 2015" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Interval</span>
              <select name="interval" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
                <option>monthly</option><option>quarterly</option><option>every 6 months</option><option>yearly</option><option>each eligible day</option>
              </select></label>
          </div>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Eligibility, re-assessed at each origin</span>
            <textarea name="eligibility" rows="2" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" placeholder="e.g. At each origin: meets the population definition and is outcome-free. Control arm = those not yet treated at that origin (so a patient enters a trial at every origin until they initiate or have the outcome). — or — Control arm = comparator initiators at that origin (so a patient is assigned at the one origin at which they initiate)."></textarea></label>
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">4 · Assignment &amp; enrolment</legend>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Assignment at each origin</span>
            <textarea name="assignment" rows="2" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" placeholder="e.g. Within each trial, patients initiating the index treatment in that interval form the treated arm; the control arm is as defined in section 3. Only information available at or before the origin enters the rule."></textarea></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Multiple enrolment</span>
            <input name="multiple" placeholder="e.g. With a not-yet-treated control arm: a patient enters every trial until they initiate or have the outcome, so the same person appears in several trials. With comparator initiators as controls: one trial per patient." class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">5 · Confounding, estimand &amp; analysis</legend>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Confounding adjustment</span>
            <input name="confounding" placeholder="e.g. PS estimated per trial (or pooled with a trial indicator); IPTW / matching within trial" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Estimand</span>
            <select name="estimand" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
              <option value="ITT">Intention-to-treat (assignment at the origin)</option>
              <option value="PP">Per-protocol (censor at deviation + IPCW; combine with CCW)</option>
              <option value="both">Both ITT and per-protocol</option>
            </select>
            <span class="mt-1 block text-[11px] text-slate-500">ITT here means <em>as assigned at the origin</em>: whatever the patient does afterwards is ignored, so switching and discontinuation pull the estimate toward the null. Per-protocol requires censoring at deviation, and that censoring is informative — it needs inverse-probability-of-censoring weights, which is the <a class="underline" href={`${base}/tools/clone-censor-weight`}>clone-censor-weight</a> machinery applied inside each trial.</span></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Effect measure</span>
            <select name="effect" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
              {/* Plain text only in an option label: an inline tag here (an <em>) makes the
                  HTML parser leave the select, and the four options below it vanished. */}
              <option value="RDRMST">Survival difference at the per-trial horizon + RMST difference</option>
              <option value="RD">Survival / risk difference at the per-trial horizon (with the risk ratio)</option>
              <option value="RMST">Restricted mean survival time (RMST) difference only</option>
              <option value="HR">Hazard ratio from the pooled model</option>
              <option value="both">Both absolute (RD/RR) and relative (HR)</option>
            </select>
            <span class="mt-1 block text-[11px] text-slate-500">A hazard ratio is the conventional report in this design and is available above. It cannot be read as a risk, so state an absolute contrast alongside it. It does <strong>not</strong> fail in the specific way a cloned design's does — there the two arms hold the same patients at time zero, because every patient is cloned into both, so the two hazards coincide at the origin and can separate only as clones are censored. But it is not guaranteed to be proportional here either: under an intention-to-treat contrast the arms converge as control patients start treatment, a weighted marginal hazard ratio need not be proportional even when the conditional one is, and one pooled coefficient over trials with different amounts of remaining follow-up is an average of time-varying hazard ratios whose value moves with the data cut-off.</span></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Follow-up window (per trial)</span>
            <input name="followup" placeholder="e.g. From each origin to outcome, death, disenrolment, or 8 years" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <div class="grid grid-cols-3 gap-3">
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">New-user washout (days before origin)</span>
              <input type="number" name="washout" value="365" min="0" step="1" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Covariate / eligibility look-back (days before origin)</span>
              <input type="number" name="covlookback" value="365" min="0" step="1" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Max follow-up per trial (days)</span>
              <input type="number" name="futrial" value="1825" min="1" step="1" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          </div>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Per-covariate look-back windows (optional)</span>
            <textarea name="covWindows" rows="3" placeholder="Comorbidities (CCI) | 365&#10;Comedications | 180" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm"></textarea>
            <div class="flex gap-1 mt-1 flex-wrap">
              {["Demographics (age, sex)", "Comorbidities (CCI)", "Comedications", "Disease severity", "Prior healthcare use", "Labs / vitals", "Frailty"].map((t) => (
                <button type="button" data-add-row data-target="covWindows" data-name={t} class="text-[10px] rounded-full border border-slate-200 px-2 py-0.5 text-slate-600 hover:border-brand-400 hover:text-brand-700">+ {t}</button>
              ))}
            </div>
            <span class="mt-1 block text-[11px] text-slate-500">Give each covariate its own look-back (<code>Name | days</code>), measured before <em>each trial's origin</em> — each becomes a draggable window in the diagram, exactly as in the active-comparator new-user builder. Leave empty to use the single look-back above for all covariates.</span>
          </label>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Subgroup analyses (tick to perform)</span>
            <div class="mt-1.5 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1">
              {SUBGROUPS.map((sg, i) => (
                <label class="flex items-start gap-2 text-xs text-slate-700">
                  <input type="checkbox" name="subgroupsPick" value={sg} checked={i < 4} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{sg}</span>
                </label>
              ))}
            </div>
            <textarea name="subgroupsCustom" rows="2" class="mt-2 w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="Custom subgroups (one per line)"></textarea>
          </div>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Sensitivity analyses (tick to perform)</span>
            <div class="mt-1.5 grid grid-cols-1 gap-y-1">
              {SENSITIVITY.map((sn, i) => (
                <label class="flex items-start gap-2 text-xs text-slate-700">
                  <input type="checkbox" name="sensitivityPick" value={sn} checked={i < 5} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{sn}</span>
                </label>
              ))}
            </div>
            <textarea name="sensitivityCustom" rows="2" class="mt-2 w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="Custom sensitivity analyses (one per line)"></textarea>
          </div>
        </fieldset>

        <div class="flex flex-wrap gap-3">
          <button type="button" data-action="download-docx" class="bg-brand-700 text-white hover:bg-brand-800 font-semibold px-5 py-2.5 rounded-lg text-sm">⬇ Word (.docx)</button>
          <button type="button" data-action="download-md" class="bg-white border border-brand-700 text-brand-700 hover:bg-brand-50 font-semibold px-5 py-2.5 rounded-lg text-sm">⬇ Markdown</button>
          <button type="button" data-action="download-target" class="text-brand-700 hover:underline font-semibold text-sm" title="TARGET checklist (Cashin et al, JAMA 2025) mapped to this protocol.">⬇ TARGET checklist</button>
          <button type="button" data-action="copy" class="text-brand-700 hover:underline font-semibold text-sm">Copy</button>
          <button type="button" data-action="reset" class="ml-auto text-slate-500 hover:text-rose-600 hover:underline text-sm font-semibold">Clear all</button>
          <span class="basis-full text-[11px] text-slate-400">Auto-saved to this browser.</span>
          <p data-action-msg class="basis-full text-xs"></p>
        </div>
      </form>

      <!-- Preview -->
      <div class="lg:sticky lg:top-20 self-start">
        <p class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-2">Live protocol preview</p>
        <pre id="preview" class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-xs leading-relaxed whitespace-pre-wrap overflow-auto max-h-[70vh]"></pre>
      </div>
    </div>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-base font-bold text-slate-900">Consistency checks <span class="text-xs font-normal text-slate-400">· target-trial 防呆</span></h2>
      <div id="checks" class="mt-3 space-y-1.5"></div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">Study design diagram</h2>
      <p id="dcap" class="mt-1 text-xs text-slate-500"></p>
      <p class="mt-4 text-xs font-semibold uppercase tracking-widest text-brand-700">Within one trial — anchored at its origin</p>
      <div class="mt-2 overflow-x-auto"><div id="diagram"></div></div>
      <div id="dlegend" class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-slate-600"></div>
      <p class="mt-6 text-xs font-semibold uppercase tracking-widest text-brand-700">Across trials — the same trial repeated at every origin</p>
      <div class="mt-2 overflow-x-auto"><div id="diagram2"></div></div>
    </div>

    <PhenotypeLibrary />
    <DesignDiagram />
    <TargetChecklist />
    <ProtocolCommon />
  </section>

  <script src="https://unpkg.com/docx@8.5.0/build/index.umd.js" is:inline></script>
  <script is:inline>
    const STORAGE_KEY = "daniel.st-builder";
    const form = document.getElementById("form");
    const preview = document.getElementById("preview");
    const V = (n) => (form.elements[n]?.value || "").trim();
    const MV = (n) => [...form.querySelectorAll('[name="' + n + '"]:checked')].map((c) => c.value);
    const mergeList = (pick, custom) => [...(pick || []), ...String(custom || "").split(/\r?\n/).map((x) => x.trim()).filter(Boolean)];

    // ONE reading of a day-count, shared by the protocol text, the diagram and the
    // checks, so they cannot tell three different stories about the same box.
    // They used to: the prose printed the raw string while everything else ran it
    // through parseInt. A `type=number` box hands back whatever survives its own
    // sanitiser, which includes negatives and exponent notation —
    //   "-5"    → prose "-5 days", checks "0", diagram no window at all
    //   "365.7" → prose "365.7 days", diagram drawn at 365
    //   "1e3"   → prose "1e3 days",  diagram drawn at 1  (parseInt("1e3") === 1)
    // Declared above every user of it, so no temporal-dead-zone hazard on first paint.
    // Returns null (blank), NaN (unusable), or a non-negative integer.
    const numDays = (v) => {
      const t = String(v == null ? "" : v).trim();
      if (t === "") return null;
      const n = Number(t);
      if (!Number.isFinite(n) || n < 0) return NaN;
      return Math.round(n);
    };
    const dayInt = (v) => { const n = numDays(v); return Number.isFinite(n) ? n : 0; };
    const daysTxt = (v) => {
      const n = numDays(v);
      if (n === null) return "(not specified)";
      if (!Number.isFinite(n)) return "(invalid — enter a whole number of days, 0 or more)";
      return n + " day" + (n === 1 ? "" : "s");
    };
    const blank = (v) => String(v == null ? "" : v).trim() === "";
    const badNum = (v) => !blank(v) && !Number.isFinite(numDays(v));
    const rounded = (v) => { const t = String(v == null ? "" : v).trim(); return t !== "" && Number.isFinite(numDays(v)) && Number(t) !== numDays(v); };

    const readForm = () => ({
      title: V("title"), data: V("data"), population: V("population"), exposure: V("exposure"), comparator: V("comparator"),
      outcome: V("outcome"), first: V("first"), last: V("last"), interval: V("interval"), eligibility: V("eligibility"),
      assignment: V("assignment"), multiple: V("multiple"), confounding: V("confounding"), estimand: V("estimand"), effect: V("effect"),
      followup: V("followup"), washout: V("washout"), covlookback: V("covlookback"), covWindows: V("covWindows"), futrial: V("futrial"),
      subgroupsPick: MV("subgroupsPick"), subgroupsCustom: V("subgroupsCustom"), sensitivityPick: MV("sensitivityPick"), sensitivityCustom: V("sensitivityCustom"),
    });
    // Numbers are read RAW above — no silent fallback. A blank washout / look-back /
    // follow-up box used to be quietly replaced by 365/365/1825 in the exported
    // protocol, so a half-finished form (or "Clear all", which blanks every box)
    // produced a document asserting windows nobody chose. Blank now travels as ""
    // and is printed as "(not specified)" and flagged in the checks panel.

    // ── A saved draft or a ?seed= link carrying a value a <select> no longer
    // offers. Assigning it leaves selectedIndex = -1, and a select with no
    // selection contributes nothing to the form — so the value read back is "",
    // and every consumer falls through to its default. Executed here, on this
    // page: a draft with interval "fortnightly", estimand "ITT-with-grace" and
    // effect "SDIFF" produced a protocol whose section 3 asserted **monthly**
    // origins, whose section 9 read "The target estimand is the treatment
    // effect", and whose section 10 step 3 said "run ITT and per-protocol
    // variants" — two different answers to one blanked field, neither of them
    // the draft's, and the checks panel said nothing at all.
    //
    // Three things this needs, each learnt the hard way elsewhere in this repo:
    // the substituted value must be recorded BEFORE the first render saves the
    // form back over the draft; the record must live in the saved draft itself,
    // or the warning survives exactly one page load; and it must be dismissible,
    // because re-picking the option a select is already showing fires no
    // `change` event, so a user who wants what it was left at has no action.
    const STALE_KEY = "__staleSelects";
    const SELECTS = [...form.querySelectorAll("select")].map((el) => ({
      name: el.name,
      label: (el.closest("label") ? (el.closest("label").querySelector("span") || {}).textContent : "") || el.name,
      options: [...el.options].map((o) => o.value),
      fallback: (([...el.options].find((o) => o.defaultSelected) || el.options[0] || {}).value) || "",
    }));
    let staleSelects = [];
    const noteStale = (obj) => {
      if (!obj || typeof obj !== "object") return;
      SELECTS.forEach((sel) => {
        const v = obj[sel.name];
        if (v == null || v === "") return;
        if (sel.options.indexOf(String(v)) < 0 && !staleSelects.some((x) => x.name === sel.name)) {
          staleSelects.push({ name: sel.name, label: String(sel.label).trim(), saved: String(v), used: sel.fallback });
        }
      });
    };
    // Two renderings, because this message goes to two audiences. On screen it
    // must tell the user what to press; in the exported protocol there is no
    // button to press, and an instruction to press one reads as a defect in the
    // document. The substance — what was saved, what was substituted, and that
    // the protocol describes the substitute — is identical in both.
    const staleMsg = (x) =>
      "“" + x.label + "” was saved as “" + x.saved + "”, and this page does not offer that choice. The field has been set to “" + x.used + "” and this protocol describes THAT — a different specification from the one the saved draft named.";
    const staleMsgs = () => staleSelects.map((x) => staleMsg(x) + " Pick the option you want, or press “Keep “" + x.used + "”” to confirm it.");
    const staleMsgsDoc = () => staleSelects.map(staleMsg);
    // Free text the user typed is followed by more of our prose. Without this the
    // exported Word ran the two together ("…or 5 years Maximum follow-up per trial…");
    // with a naive "." appended it double-punctuated anyone who typed one.
    const stop = (t) => { const s = String(t == null ? "" : t).trim(); return s && !/[.!?:;)]$/.test(s) ? s + "." : s; };

    const esc = (x) => String(x == null ? "" : x).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    // A per-covariate row is "Name | days". Two things the old reader got wrong.
    // It split on the FIRST "|", so a covariate whose name contains one ("Sex
    // (M|F)") lost half its name and read the rest as a day count; the last "|"
    // is the separator. And it coerced the day count with dayInt, so a line the
    // parser could not read came back as 0 — "Comedications | six months" became
    // a covariate measured only on the origin day. The raw text is kept beside
    // the number now, so `days` is a number, null (nothing after the "|") or NaN
    // (there was something and it was not a day count), and the three are told
    // apart everywhere downstream.
    const parseRows = (txt) => String(txt || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean).map((l) => {
      const i = l.lastIndexOf("|");
      const name = (i < 0 ? l : l.slice(0, i)).trim();
      const raw = i < 0 ? "" : l.slice(i + 1).trim();
      // `line` is the user's own text, kept verbatim. Splitting on the last "|"
      // is right when a day count follows it and wrong when one does not: for
      // "Sex (M|F)" it takes "F)" as the day count and leaves the name as
      // "Sex (M". Rather than guess where the name ends, an unreadable row is
      // never re-derived — it is written back and quoted exactly as typed.
      return { name: name, raw: raw, days: numDays(raw), line: l };
    }).filter((r) => r.name);
    // The write path has to carry the same distinction the read path just
    // learnt. rowsJoin rewrites the WHOLE textarea whenever a chip is clicked or
    // a handle dragged, and the textarea is the only copy of what was typed — so
    // a row whose length could not be read must come back as the user's own
    // words, not as the 0 the old reader had turned it into.
    const rowsJoin = (rows) => rows.map((r) => Number.isFinite(r.days) ? r.name + " | " + r.days : (r.line != null ? r.line : (r.raw ? r.name + " | " + r.raw : r.name))).join("\n");
    // An unreadable row is quoted whole, because the split that produced its
    // name is exactly the thing that could not be trusted.
    const rowLabel = (r) => Number.isFinite(r.days) ? r.name : "“" + (r.line != null ? r.line : r.name) + "”";
    const rowDays = (r) => Number.isFinite(r.days) ? r.days + " d" : (r.raw ? "(no readable number of days)" : "(no look-back given)");
    // The one place that still read a day count its own way. numDays exists so
    // the prose, the diagrams and the checks cannot tell three stories about one
    // box; this printed the raw string instead, so a look-back of "-5" — which
    // the panel refuses, and which the diagram draws no window for — was still
    // exported as "-5 days before each origin" into section 4, the Word design
    // summary and TARGET item 7a.
    const covLbText = (s) => {
      const r = parseRows(s.covWindows);
      if (r.length) return r.map((x) => rowLabel(x) + " " + rowDays(x)).join("; ");
      const n = numDays(s.covlookback);
      if (n === null) return "(not specified)";
      if (!Number.isFinite(n)) return "(not specified — “" + s.covlookback + "” could not be read as a whole number of days)";
      return n + " day" + (n === 1 ? "" : "s") + " before each origin";
    };
    const fmtDays = (d) => { const a = Math.abs(d); if (a >= 365) { const y = a / 365; return (Number.isInteger(y) ? y : y.toFixed(1)) + "y"; } if (a >= 60) return Math.round(a / 30) + "mo"; return a + "d"; };

    function renderScheme(s) {
      const interval = s.interval || "monthly";
      const lb = dayInt(s.covlookback);
      const wash = dayInt(s.washout);
      const fu = Math.max(1, dayInt(s.futrial) || 1825);

      // ── Part 1: within one trial. Uses the SAME shared renderer (and therefore the same
      //    window kinds, colours, labels and drag behaviour) as the ACNU builder — the only
      //    difference is that time zero is each trial's origin rather than a single index date.
      const covRows = parseRows(s.covWindows);
      const wins = [];
      // A row whose length could not be read gets no bar. Drawing it at 0 would
      // put "Comedications" flush against the origin, which is a positive claim
      // that the covariate is measured on the origin day alone — the checks panel
      // names those rows instead. The index passed to onEdit stays the row's
      // index in the FULL list, so dragging a drawn handle still edits its own row.
      if (covRows.length) covRows.forEach((r, i) => { if (Number.isFinite(r.days) && r.days > 0) wins.push({ label: r.name, kind: "lookback", startDay: -r.days, endDay: 0, edit: { field: "covWindows", edge: "start", idx: i } }); });
      else if (lb > 0) wins.push({ label: "Covariate / eligibility look-back", kind: "lookback", startDay: -lb, endDay: 0, edit: { field: "covlookback", edge: "start" } });
      if (wash > 0) wins.push({ label: "New-user washout (no prior exposure/comparator)", kind: "washout", startDay: -wash, endDay: 0, edit: { field: "washout", edge: "start" } });
      const fuSet = dayInt(s.futrial) > 0;
      wins.push(fuSet
        ? { label: "Follow-up (this trial)", kind: "followup", startDay: 0, endDay: fu, edit: { field: "futrial", edge: "end" } }
        : { label: "Follow-up (this trial)", kind: "followup", startDay: 0, endDay: fu, note: (blank(s.futrial) ? "length not set" : "“" + s.futrial + "” could not be read") + " — the bar is a placeholder, drag to set", edit: { field: "futrial", edge: "end" } });
      const onEdit = (field, day, meta) => {
        if (field === "covWindows") {
          const el = form.elements.covWindows, rows = parseRows(el.value), idx = meta && meta.idx != null ? meta.idx : 0;
          if (rows[idx]) { rows[idx].days = Math.max(1, Math.round(-day)); rows[idx].raw = String(rows[idx].days); el.value = rowsJoin(rows); render(); }
          return;
        }
        const el = form.elements[field]; if (!el) return;
        el.value = field === "futrial" ? Math.max(5, Math.round(day)) : Math.round(Math.max(0, -day));
        render();
      };
      window.renderDesignDiagram(document.getElementById("diagram"), document.getElementById("dlegend"), { windows: wins, indexLabel: "Trial origin (day 0) — eligibility, assignment & follow-up start", onEdit: onEdit, snap: 5 });

      // ── Part 2: across trials — that same trial repeated at every origin along calendar time.
      //    The pre-origin span must reflect the windows actually in force. It used to
      //    be max(covlookback, washout), which ignored the per-covariate rows entirely:
      //    with "CCI | 3650" typed in and covlookback left at 365, the strip drew a
      //    1-year look-back for a design that reaches back ten.
      //    A row the parser could not read has days = NaN, and one NaN in
      //    Math.max makes the whole span NaN — every rect x/width in the strip
      //    then comes out NaN and the picture silently disappears. Only readable
      //    rows contribute.
      const covSpans = covRows.map((r) => r.days).filter((d) => Number.isFinite(d) && d > 0);
      const preSpan = Math.max(covRows.length ? (covSpans.length ? Math.max(...covSpans) : 0) : lb, wash);
      renderTrialStrip(s, interval, preSpan, fu, fuSet);

      document.getElementById("dcap").textContent =
        "Top — what happens inside one trial, anchored at its origin (day 0): the same scheme as the active-comparator new-user design (washout and covariate look-back before time zero, follow-up after), because each nested trial IS a new-user trial started at that origin. Bottom — that trial is repeated at every origin (" + interval + ", " + (s.first || "start") + "–" + (s.last || "end") + "), staggered along calendar time; a patient enters every trial they stay eligible for. The strip is schematic: the number of trials drawn is illustrative, not the number your date range implies. Drag the ○ handles in the top panel to edit the windows.";
    }

    // `fuSet` is false when the per-trial follow-up box is blank or unreadable.
    // The bar still has to be drawn — the strip is about the staggered origins,
    // not about the length — but it must not be LABELLED. It used to read "+5y"
    // in every one of those cases, because renderScheme handed it a hard-coded
    // 1825-day placeholder: a blank box produced a picture asserting five years
    // of follow-up beside prose reading "(not specified)", and an unreadable one
    // produced the same picture beside "(invalid)".
    function renderTrialStrip(s, interval, pre, fu, fuSet) {
      const total = pre + fu || 1;
      const W = 860, gutter = 104, plotL = gutter, plotR = W - 18, plotW = plotR - plotL;
      const rowH = 36, top = 26, H = top + 4 * rowH + 26;
      const perW = plotW * 0.46, lbW = perW * (pre / total), fuW = perW - lbW, gap = plotW * 0.085;
      const baseOx = plotL + lbW + 4;
      const trials = [["Trial 1", 0], ["Trial 2", 1], ["Trial N (last)", 4]];
      const rowY = [top, top + rowH, top + 3 * rowH];
      let svg = '<svg viewBox="0 0 ' + W + ' ' + H + '" class="w-full h-auto" style="min-width:660px" xmlns="http://www.w3.org/2000/svg">';
      trials.forEach((t, i) => {
        const y = rowY[i], ox = baseOx + t[1] * gap;
        svg += '<line x1="' + ox + '" y1="' + (y - 2) + '" x2="' + ox + '" y2="' + (H - 24) + '" stroke="#eef2f7"/>';
        svg += '<text x="' + (gutter - 10) + '" y="' + (y + 16) + '" text-anchor="end" font-size="11" fill="#334155">' + esc(t[0]) + '</text>';
        if (lbW > 1) svg += '<rect x="' + (ox - lbW) + '" y="' + (y + 5) + '" width="' + lbW + '" height="16" rx="3" fill="#8b5cf6" fill-opacity="0.8"/>';
        svg += '<rect x="' + ox + '" y="' + (y + 5) + '" width="' + fuW + '" height="16" rx="3" fill="' + (fuSet ? "#10b981" : "#cbd5e1") + '" fill-opacity="0.85"/>';
        svg += '<circle cx="' + ox + '" cy="' + (y + 13) + '" r="4" fill="#0f766e"/>';
        if (i === 0) {
          if (lbW > 30) svg += '<text x="' + (ox - lbW / 2) + '" y="' + (y + 17) + '" text-anchor="middle" font-size="9" fill="#fff" font-weight="600">−' + fmtDays(pre) + '</text>';
          if (fuW > 44) svg += '<text x="' + (ox + fuW / 2) + '" y="' + (y + 17) + '" text-anchor="middle" font-size="9" fill="' + (fuSet ? "#fff" : "#475569") + '" font-weight="600">' + (fuSet ? "+" + fmtDays(fu) : "length not set") + '</text>';
        }
      });
      const dy = top + 2 * rowH + 14, dxA = baseOx + 1.7 * gap, dxB = baseOx + 3.3 * gap;
      for (let k = 0; k < 3; k++) { const dx = dxA + (dxB - dxA) * (k / 2); svg += '<circle cx="' + dx + '" cy="' + dy + '" r="2.6" fill="#94a3b8"/>'; }
      svg += '<text x="' + ((dxA + dxB) / 2) + '" y="' + (dy - 8) + '" text-anchor="middle" font-size="9.5" fill="#94a3b8">…a new trial at each origin…</text>';
      svg += '<line x1="' + plotL + '" y1="' + (H - 22) + '" x2="' + plotR + '" y2="' + (H - 22) + '" stroke="#cbd5e1"/>';
      svg += '<text x="' + plotR + '" y="' + (H - 8) + '" text-anchor="end" font-size="10" fill="#94a3b8">calendar time → (a new trial each ' + esc(interval) + ')</text>';
      const d2 = document.getElementById("diagram2"); if (d2) d2.innerHTML = svg + "</svg>";
    }

    const or = (s, d) => (s && s.length ? s : d);
    // One map, two renderings. There were three near-copies of this — here, in
    // the Word export and in the TARGET handler — and two had already drifted
    // apart ("assignment at each origin, ignoring later switching" against
    // "assignment at each origin"), which is how this codebase keeps getting a
    // document naming a different analysis from the one chosen.
    const ESTIMAND = {
      ITT: { md: "the **intention-to-treat effect** — the effect of the treatment strategy assigned at each origin, regardless of subsequent adherence", plain: "the intention-to-treat effect (assignment at each origin, ignoring later switching)" },
      PP: { md: "the **per-protocol effect** — the effect of receiving and adhering to the assigned strategy, with censoring at deviation and inverse-probability-of-censoring weights within each trial", plain: "the per-protocol effect (censoring at deviation, with inverse-probability-of-censoring weights, within each trial)" },
      both: { md: "both the **intention-to-treat** and the **per-protocol** effects (the latter using censoring at deviation with inverse-probability-of-censoring weights)", plain: "both the intention-to-treat and the per-protocol effects" },
    };
    const EST_MISSING = "(not specified — choose intention-to-treat, per-protocol, or both under “Estimand”)";
    const estimandText = (e) => (ESTIMAND[e] && ESTIMAND[e].md) || "**" + EST_MISSING + "**";
    const estimandPlain = (e) => (ESTIMAND[e] && ESTIMAND[e].plain) || EST_MISSING;
    // The horizon τ for the absolute measures is the per-trial maximum follow-up.
    const horizon = (s) => (blank(s.futrial) ? "the per-trial horizon (length not yet specified)" : "the per-trial horizon (τ = " + daysTxt(s.futrial) + " from each origin)");
    const effectText = (s) => {
      const H = horizon(s);
      return ({
        RD: "the difference in survival at " + H + " — equivalently the risk difference — together with the risk ratio, from the weighted survival / cumulative-incidence curves",
        RMST: "the difference in restricted mean survival time (RMST) up to " + H + ", as the area between the weighted survival curves",
        RDRMST: "two absolute contrasts of the weighted survival curves — the difference in survival at " + H + ", which is equivalently the risk difference, and the difference in restricted mean survival time (RMST) up to that same horizon",
        HR: "the pooled hazard ratio from the outcome model",
        both: "both absolute effects (the difference in survival at " + H + ", the risk difference and the risk ratio) and the relative effect (the pooled hazard ratio), the absolute contrast being the primary measure",
      })[s.effect] || "**(not specified — choose an effect measure under “Effect measure”)**";
    };
    const usesRMST = (e) => e === "RMST" || e === "RDRMST";

    // ── One copy of every default sentence, because there were three (Markdown,
    // Word, TARGET) and they had drifted into describing two different designs
    // at once.
    //
    // The assignment default said "patients initiating the comparator in that
    // interval form the control arm" — an ACTIVE-COMPARATOR sequential trial, in
    // which a patient is assigned only at the origin at which they initiate one
    // of the two drugs, and therefore enters exactly ONE trial. The enrolment
    // default, in the same exported document, said "A patient may enrol in
    // several consecutive trials until they are treated" — the
    // initiator-versus-not-yet-treated design of Hernán 2008 and Danaei 2013, in
    // which the control arm IS the untreated and a patient enters a trial at
    // every origin until they initiate. Each default deletes the other's control
    // arm. Every argument the protocol then makes about re-use — the
    // non-independence of the trials, the bootstrap over patients, the refusal
    // to meta-analyse, the limitations paragraph — belongs to the second design
    // and is simply idle under the first.
    //
    // Both designs are legitimate and the page has no field that chooses between
    // them, so it names the fork and asks, rather than picking one silently. All
    // four cited papers are the second design; the placeholders were the first.
    const DEF = {
      eligibility: "At each origin, a patient is eligible if they meet the population definition and are outcome-free. State also which control arm this study uses, because much of the protocol below depends on it: either the control arm is initiators of the comparator at that origin, in which case a patient is assigned at the one origin at which they initiate; or the control arm is those not yet treated at that origin, in which case a patient enters a trial at every origin until they initiate or have the outcome.",
      assignment: "Within each trial, patients initiating the index treatment in that interval form the treated arm. The control arm is whichever of the two was specified above — comparator initiators at that origin, or those not yet treated at that origin. Only information available at or before the origin may enter the rule.",
      multiple: "How many trials a patient enters follows from that choice. With comparator initiators as the control arm, a patient is assigned at the single origin at which they initiate. With the not-yet-treated as the control arm, a patient enters every trial for which they remain eligible until they initiate or have the outcome, so the same person appears in several trials with overlapping follow-up.",
      followup: "Within each trial, follow-up runs from the origin to the outcome, death, disenrolment, or the maximum follow-up, whichever comes first.",
      confounding: "The propensity score is estimated within each trial (or pooled across trials with a trial indicator) from baseline covariates measured at that origin; treated and control arms are balanced by inverse-probability-of-treatment weighting (or matching) within trial.",
    };
    // Stated conditionally, because whether it applies at all is the question
    // section 4 asks. It used to be flat ("The nested trials are NOT independent
    // samples"), which is false of an active-comparator sequential trial where
    // each patient sits in one trial.
    const REUSE = "Where a patient enters more than one trial — which is the usual case when the control arm is those not yet treated, and does not arise when both arms initiate at the origin — the nested trials are not independent samples. Standard errors computed as if each patient-trial record were a separate person are then too small, and per-trial estimates cannot be pooled as if they came from separate studies. How this is handled is set out in Section 10.";
    // The deviation-censoring rule IS the difference between the two estimands,
    // so it belongs in the analysis plan of both exported documents. The Word
    // version of step 3 stopped at "…follow-up time, and trial." in every
    // branch, so a per-protocol protocol's Word analysis plan never mentioned
    // deviation censoring or IPCW at all — the defining step of the estimand it
    // had just named in section 9. One clause, one copy.
    const censorClause = (s) => ({
      ITT: "no deviation censoring (ITT).",
      PP: "censor at deviation and apply inverse-probability-of-censoring weights (per-protocol).",
      both: "run ITT and per-protocol (deviation censoring + IPCW) variants.",
    })[s.estimand] || "the deviation-censoring rule follows from the estimand, which is not specified above.";

    // Normalised inputs for the shared HARPER/TARGET common sections (window.PC).
    const pcOf = (s) => ({
      design: "sequential (nested) trial emulation",
      tte: true,
      population: or(s.population, "(population)"),
      exposure: or(s.exposure, "(treatment)"),
      comparator: or(s.comparator, "(comparator)"),
      outcome: or(s.outcome, "(outcome)"),
      data: s.data,
      analysis: "a sequence of nested trials emulated at each eligible origin and pooled across trials, with the uncertainty from any re-use of patients across trials handled as in Section 10, estimating " + estimandText(s.estimand).replace(/\*\*/g, "") + ", reported as " + effectText(s),
      groupBy: "treatment arm",
      // ProtocolCommon's default sizes a cohort from "observed exposure and
      // outcome frequencies" and "available person-time and event counts". Read
      // off the stacked, trial-indexed dataset those counts are inflated by the
      // mean number of trials a patient enters — which is the very
      // non-independence `limitations` two lines below names as the design's
      // central statistical hazard, and which Section 10 handles with a
      // patient-level bootstrap. The document was therefore stating the trap in
      // one section and walking into it in another.
      //
      // Conditional in exactly the way REUSE is, and for the same reason: this
      // page has NO field that chooses between the not-yet-treated design (a
      // patient enters many trials) and the active-comparator design (one
      // trial per patient). It names the fork and asks. A flat "the same person
      // appears in several trials" here would re-introduce, in the study-size
      // section, the assumption the rest of the file was rewritten to stop
      // making.
      studySize: "A sequential trial emulation is not sized by the number of rows in its stacked, trial-indexed dataset. Where a patient enters more than one trial — the usual case when the control arm is those not yet treated, and not the case when both arms initiate at the origin — the same person supplies several patient-trial records, so those rows are larger in number than the study is in patients, and any figure computed from them overstates the information available for the same reason a model-based standard error does. What decides the answer is: the number of distinct eligible patients; how many trials each of them enters, which is how much of the apparent sample is duplication, and which is what the enrolment table commissioned below establishes; the number of initiators of the index treatment, usually the binding constraint because they are the treated arm of every trial; the variability of the propensity-score and censoring weights, which sets the effective sample size within each trial; and the size of the effect to be detected."
        + (s.estimand === "both" ? " Two figures are needed, not one: the intention-to-treat and per-protocol analyses do not have the same precision, because deviation censoring and its weights remove information the ITT analysis keeps." : "")
        + " Precision is therefore established by simulation, or by applying to a pilot extraction the same patient-level bootstrap that Section 10 specifies for the confidence intervals — never from a formula applied to patient-trial records. Feasibility is confirmed before the analysis is executed as the number of distinct eligible patients and the number of initiators at each origin.",
      limitations: "Where the control arm is those not yet treated, the same patient contributes to several trials, often with overlapping follow-up, so the nested trials are not independent: standard errors that ignore this are too small, and per-trial estimates cannot be treated as separate studies. Where both arms initiate at the origin, each patient sits in one trial and that does not arise. Residual and unmeasured confounding within each trial cannot be excluded, and confounders are measured only up to each origin.",
      // The shared "Table 1 — baseline characteristics by treatment arm" is a
      // pooled table across every trial, and section 3 of this page says why
      // that is not a table of any population: where the control arm is those
      // not yet treated, a patient enters a trial at every origin until they
      // initiate or have the outcome. So the same person is counted once per
      // trial entered — a multiplicity that varies by person and is heaviest
      // for those who stayed untreated longest — and the two columns are not
      // disjoint sets of people, because that patient sits in the control
      // column of every trial before initiating and in the treated column of
      // the trial at which they do. An SMD computed on it belongs to no trial
      // that was ever emulated. The within-trial version below is the one that
      // diagnoses the confounding control this design actually applies.
      //
      // The flow diagram and the results table are NOT dropped. The enrolment
      // bullet below is a tally, not an attrition diagram, and nothing else
      // says how the source population became the eligible one.
      skipOutputs: ["table1"],
      plannedOutputs: ["Baseline characteristics by arm WITHIN trial, for each of a pre-specified set of origins — not pooled across trials, where a patient may enter many and may appear in both columns.", "Number of trials, and the number of patients and of patient-trial records enrolled in each — with the distribution of how many trials each patient enters.", "Per-trial and pooled effect estimates, the per-trial estimates read as a descriptive check rather than as independent studies.", "Within-trial covariate-balance (SMD) diagnostics, before and after weighting or matching.", "Within-trial positivity diagnostics: the number assigned to each arm at every origin, the propensity-score overlap, and the number and size of extreme weights, with any truncation rule stated in advance.", "Cumulative-incidence or survival curves by arm, stated as cause-specific or as accounting for competing risks."],
    });

    // One list, shared by the Markdown and Word exports so they cannot drift.
    // Every DOI checked against Crossref/PubMed rather than written from memory;
    // Gran's page range (2757-2768, not -70) and Danaei's second author
    // ("García Rodríguez LA", not "Rodríguez LAG") were both wrong before.
    const REFS = [
      "Hernán MA, Alonso A, Logan R, et al. Observational studies analyzed like randomized experiments: an application to postmenopausal hormone therapy and coronary heart disease. Epidemiology 2008;19(6):766-779. doi:10.1097/EDE.0b013e3181875e61",
      "Danaei G, García Rodríguez LA, Fernández Cantero O, Logan R, Hernán MA. Observational data for comparative effectiveness research: an emulation of randomised trials of statins and primary prevention of coronary heart disease. Stat Methods Med Res 2013;22(1):70-96. doi:10.1177/0962280211403603",
      "Gran JM, Røysland K, Wolbers M, et al. A sequential Cox approach for estimating the causal effect of treatment in the presence of time-dependent confounding applied to data from the Swiss HIV Cohort Study. Stat Med 2010;29(26):2757-2768. doi:10.1002/sim.4048",
      "Keogh RH, Gran JM, Seaman SR, Davies G, Vansteelandt S. Causal inference in survival analysis using longitudinal observational data: sequential trials and marginal structural models. Stat Med 2023;42(13):2191-2225. doi:10.1002/sim.9718",
      "Hernán MA, Robins JM. Using big data to emulate a target trial when a randomized trial is not available. Am J Epidemiol 2016;183(8):758-764. doi:10.1093/aje/kwv254",
      "Cashin AG, Hansford HJ, Hernán MA, et al. Transparent reporting of observational studies emulating a target trial — the TARGET statement. JAMA 2025;334(12):1084-1093. doi:10.1001/jama.2025.13350",
    ];

    // A refusal that never leaves the screen is a refusal the person reading the
    // Word file never sees — and the Word file is what gets circulated. Every
    // blocking check is computed once and painted into the panel, the Markdown
    // and the .docx alike, so the three cannot disagree about what is wrong.
    // computeChecks is pure apart from reading staleSelects, so one call per
    // export is enough for both lists.
    const docChecks = (s) => computeChecks(s, true);
    const blockers = (s) => docChecks(s).filter((c) => c.level === "error").map((c) => c.msg);
    const cautions = (s) => docChecks(s).filter((c) => c.level === "warn").map((c) => c.msg);
