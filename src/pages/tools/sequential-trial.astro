      const origins = or(s.interval, "monthly") + " (" + or(s.first, "start") + "–" + or(s.last, "end") + ")";
      const estPlain = { ITT: "the intention-to-treat effect (assignment at each origin, ignoring later switching)", PP: "the per-protocol effect (deviation censoring + IPCW within each trial)", both: "both the intention-to-treat and per-protocol effects" }[s.estimand] || "the treatment effect";
      const subg = mergeList(s.subgroupsPick, s.subgroupsCustom).join("; ") || "none pre-specified";
      const sens = mergeList(s.sensitivityPick, s.sensitivityCustom).join("; ") || "(see protocol)";
      // Item 7 (a–h): one target trial specified per origin; emulated at each.
      const item7 = [
        ["a. Eligibility criteria",
          "At each origin, patients meeting the population definition, outcome-free, and not previously enrolled as an index initiator.",
          or(s.eligibility, "Meets the population definition, outcome-free, not already enrolled as an index-treatment initiator in an earlier trial.") + "\nRe-assessed at every origin, which is that trial's time zero: new-user washout " + daysTxt(s.washout) + " and covariate / eligibility look-back " + covLbText(s) + ", both measured before the origin (the same scheme as an active-comparator new-user design applied at every origin). Only information available at or before the origin may enter the rule."],
