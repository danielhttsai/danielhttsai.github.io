        rows.push({ name: name, days: parseInt(form.elements.covlookback && form.elements.covlookback.value) || 365 });
        el.value = rowsJoin(rows); render();
      }
    });

    document.querySelector("[data-action='download-md']").addEventListener("click", () => {
      try { dl(new Blob([preview.textContent || ""], { type: "text/markdown;charset=utf-8" }), fname("md")); setMsg("Markdown downloaded."); }
      catch (e) { console.error(e); setMsg("Markdown export failed: " + (e && e.message ? e.message : e), true); }
    });

