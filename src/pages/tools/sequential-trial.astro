        if (saved) {
          noteStale(saved);
          // A record carried over from an earlier load of this same draft. Kept
          // unless the user has since answered it — if the select now holds a
          // real option, the entry is dropped below.
          if (Array.isArray(saved[STALE_KEY])) saved[STALE_KEY].forEach((x) => {
            if (x && x.name && !staleSelects.some((y) => y.name === x.name)) staleSelects.push(x);
          });
          for (const k in saved) {
            if (k === STALE_KEY) continue;
            const els = form.elements[k]; if (!els) continue;
            const val = saved[k];
            if (Array.isArray(val)) form.querySelectorAll('[name="' + k + '"]').forEach((n) => { n.checked = val.includes(n.value); });
            else if (els.type === "checkbox") els.checked = !!val;
            else els.value = val;
          }
        }
        // Leave each blanked select showing the choice the protocol will
        // actually describe, rather than showing nothing, now that the blocker
        // above explains which choice that is and where it came from.
        // "Has the user answered this yet?" cannot be asked as "does the select
        // hold a valid value", because after the first load it holds the value
        // WE substituted — so the record was dropped on the very next reload and
        // the export went back to asserting the substituted choice as a
        // deliberate one. The record survives while the select still shows
        // exactly what was substituted, and is dropped the moment it shows
        // anything else; re-picking the substituted option fires no change
        // event, which is what the "Keep" button is for.
        staleSelects = staleSelects.filter((x) => {
          const el = form.elements[x.name];
          if (!el) return false;
          if (el.selectedIndex >= 0 && el.value && el.value !== x.used) return false;
          el.value = x.used;
          return true;
        });
      } catch (e) { console.error("[st] restore failed", e); }
      render();
    })();
    form.addEventListener("input", render);
    // Cleared per control, on the control the user actually touched. Clearing the
    // whole list on any change would dismiss a second blocker the user has not
    // seen; leaving it uncleared makes a blocker nobody can dismiss, which is
    // precisely what teaches people to ignore the panel.
    form.addEventListener("change", (e) => {
      const n = e.target && e.target.name;
      if (n && staleSelects.some((x) => x.name === n)) staleSelects = staleSelects.filter((x) => x.name !== n);
      render();
    });

    // Set by buildDocx when a figure could not be made, so the download handler
    // can tell the user which of the two documents they got.
    let lastFigNote = "";
    const actionMsg = document.querySelector("[data-action-msg]");
    const setMsg = (t, bad) => { if (actionMsg) { actionMsg.textContent = t || ""; actionMsg.className = "basis-full text-xs " + (bad ? "text-rose-600" : "text-emerald-600"); } };

    const slugify = () => (readForm().title || "sequential-trial-protocol").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60) || "sequential-trial-protocol";
    const fname = (ext) => slugify() + "-" + new Date().toISOString().slice(0, 10) + "." + ext;
    const dl = (blob, name) => { const u = URL.createObjectURL(blob); const a = document.createElement("a"); a.href = u; a.download = name; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(u), 1000); };

    // Chip row under the per-covariate look-back box (same convention as the ACNU builder).
    form.addEventListener("click", (e) => {
      const addRow = e.target && e.target.closest && e.target.closest("[data-add-row]");
      if (!addRow) return;
      const el = form.elements[addRow.dataset.target], name = addRow.dataset.name;
      if (!el) return;
      const rows = parseRows(el.value);
      if (!rows.some((r) => r.name === name)) {
        // The seed for a new row is whatever the single look-back box says, read
        // the one way this page reads day counts. It used to be
        // `parseInt(...) || 365`, which is two bugs in one expression: parseInt
        // stops at the "e", so a 1000-day look-back seeded a ONE-day row; and
        // the `|| 365` invented a year for anyone whose box was empty —
        // including immediately after "Clear all", which blanks it and then
        // promises "every number is now blank". Nothing is invented now: an
        // empty box seeds a row with no length, and the checks panel asks for one.
        const seed = String((form.elements.covlookback && form.elements.covlookback.value) || "").trim();
        rows.push({ name: name, raw: seed, days: numDays(seed) });
        el.value = rowsJoin(rows); render();
      }
    });

    document.querySelector("[data-action='download-md']").addEventListener("click", () => {
      try { dl(new Blob([preview.textContent || ""], { type: "text/markdown;charset=utf-8" }), fname("md")); setMsg("Markdown downloaded."); }
      catch (e) { console.error(e); setMsg("Markdown export failed: " + (e && e.message ? e.message : e), true); }
    });

    document.querySelector("[data-action='download-target']").addEventListener("click", async () => {
      const D = window.docx;
      // Silence here used to mean "click does nothing" — the docx UMD bundle is
      // loaded from a CDN and can simply not arrive.
      if (!D) { setMsg("The Word engine (docx) did not load — check the network, then reload the page.", true); return; }
      if (!window.buildTargetChecklistDocx) { setMsg("The TARGET checklist component did not load — reload the page.", true); return; }
      const s = readForm();
      const E = or(s.exposure, "(treatment)"), C = or(s.comparator, "(comparator)");
      const origins = or(s.interval, "monthly") + " (" + or(s.first, "start") + "–" + or(s.last, "end") + ")";
      const estPlain = estimandPlain(s.estimand);
      const subg = mergeList(s.subgroupsPick, s.subgroupsCustom).join("; ") || "none pre-specified";
      const sens = mergeList(s.sensitivityPick, s.sensitivityCustom).join("; ") || "(see protocol)";
      // A value this page had to substitute for one the saved draft named must
      // be declared in the checklist item that reports it — a TARGET checklist
      // whose item 7f states an estimand nobody chose is worse than no checklist.
      const staleFor = (n) => { const x = staleSelects.find((y) => y.name === n); return x ? "\nNOTE: " + staleMsg(x) : ""; };
      // Item 7 (a–h): one target trial specified per origin; emulated at each.
      const item7 = [
        ["a. Eligibility criteria",
          "At each origin, patients meeting the population definition, outcome-free, and not previously enrolled as an index initiator.",
          or(s.eligibility, DEF.eligibility) + "\nRe-assessed at every origin, which is that trial's time zero: new-user washout " + daysTxt(s.washout) + " and covariate / eligibility look-back " + covLbText(s) + ", both measured before the origin (the same window scheme as a new-user design, applied at every origin). Only information available at or before the origin may enter the rule."],
        ["b. Treatment strategies",
          "Initiate " + E + " vs " + C + ", assigned at each trial's origin.",
          E + " vs " + C + ".\n" + or(s.assignment, DEF.assignment)],
        ["c. Assignment procedures",
          "Random assignment at each origin.",
          "One nested trial is emulated at each origin (" + origins + "). Baseline confounding within each trial is addressed by " + or(s.confounding, "a propensity score estimated at that origin, with weighting or matching") + "." + staleFor("interval")],
        ["d. Follow-up",
          "Follow-up begins at assignment (each trial's origin) and ends at outcome, death, or end of study.",
          "Time zero = each trial's origin.\n" + or(s.followup, DEF.followup) + "\nMaximum follow-up per trial: " + daysTxt(s.futrial) + ".\n" + or(s.multiple, DEF.multiple) + "\nTrials with later origins have less calendar time before the data end, so long-term contrasts rest mainly on the earliest trials."],
        ["e. Outcomes",
          "Primary outcome: " + or(s.outcome, "(specify)") + ".",
          "Outcome: " + or(s.outcome, "(specify)") + "."],
        ["f. Causal contrasts",
          "Effect of being assigned (and, optionally, adhering to) the treatment strategy at the origin.",
          "Target estimand: " + estPlain + ".\nReported as: " + effectText(s) + "." + staleFor("estimand") + staleFor("effect")],
        ["g. Identifying assumptions",
          "Exchangeability, positivity, and consistency within each nested trial.",
          "Conditional exchangeability within each trial via " + or(s.confounding, "propensity-score methods at each origin") + ", with covariates re-measured at each origin (a patient in several trials has a different propensity score in each). Positivity and consistency are assumed within each trial." + (s.estimand === "PP" || s.estimand === "both" ? " Per-protocol contrasts censor at deviation and apply inverse-probability-of-censoring weights within each trial, which additionally assumes every predictor of deviation is measured." : "") + " Where the control arm is those not yet treated, a patient appears in several trials with overlapping follow-up, so the nested trials are not independent and the uncertainty must account for that (see h); where both arms initiate at the origin, each patient sits in one trial."],
        ["h. Data analysis plan",
          "An estimator that recovers the causal contrast under the identifying assumptions.",
          "Pooled logistic (or weighted Cox) regression across the stacked, trial-indexed dataset with terms for assigned treatment, follow-up time, and trial.\n95% CIs: reference method is a non-parametric bootstrap resampling PATIENTS, repeating trial construction, weight estimation and the outcome model in each replicate (Keogh 2023); a robust (sandwich) variance clustered on the patient is the cheaper alternative, described by Danaei et al. (2013) as conservative. Model-based standard errors are not used.\nPer-trial estimates are reported as a descriptive check, not as independent studies: the trials share patients, so I-squared and Cochran's Q do not carry their usual meaning.\nSubgroups: " + subg + ".\nSensitivity: " + sens + "." + (blockers(s).length ? "\nUNSETTLED AT EXPORT: " + blockers(s).join(" | ") : "")],
      ];
      const map = {
        "1a": "This study emulates a sequence of nested target trials of " + E + " vs " + C + " among " + or(s.population, "(population)") + ".",
        "1b": or(s.data, ""),
        "3": "Among " + or(s.population, "(population)") + ", what is the effect of " + E + " vs " + C + " on " + or(s.outcome, "(outcome)") + "?",
        "4": "A single-origin new-user design discards eligible person-time and cannot use patients who become eligible later; the target trial is emulated at every eligible origin (Hernán 2008; Danaei 2013; Gran 2010).",
        "5": or(s.data, ""),
        "6": "Target trial: at each origin (" + origins + "), randomise eligible patients to " + E + " vs " + C + " and follow per trial to the outcome, death, or end of study.",
        "16": "The sequential design mitigates prevalent-user and selection bias; residual and unmeasured confounding cannot be excluded.",
      };
      try {
        dl(await window.buildTargetChecklistDocx(D, { title: s.title || "Sequential trial study", designName: "sequential trial", item7: item7, map: map }), slugify() + "-TARGET-" + new Date().toISOString().slice(0, 10) + ".docx");
        setMsg("TARGET checklist downloaded.");
      } catch (e) { console.error(e); setMsg("TARGET checklist export failed: " + (e && e.message ? e.message : e), true); }
    });
    document.querySelector("[data-action='copy']").addEventListener("click", async (e) => {
      try { await navigator.clipboard.writeText(preview.textContent || ""); e.target.textContent = "Copied ✓"; setTimeout(() => (e.target.textContent = "Copy"), 1500); }
      catch (err) { console.error(err); setMsg("Could not copy — your browser blocked clipboard access. Select the preview text and copy it manually.", true); }
    });
    document.querySelector("[data-action='reset']").addEventListener("click", () => {
      if (!confirm("Clear every field and forget the saved draft?")) return;
      localStorage.removeItem(STORAGE_KEY);
      staleSelects = [];
      // True blank slate — form.reset() only restores HTML defaults and leaves
      // checkboxes ticked. Walk every control and zero it out.
      form.querySelectorAll("input, textarea, select").forEach((el) => {
        if (el.type === "checkbox" || el.type === "radio") el.checked = false;
        // selectedIndex = 0 is the authored default only while no option carries
        // a `selected` attribute. The brief records this exact line moving a
        // maximum follow-up from five years to one in another builder the day
        // someone added one. SELECTS already knows each authored default.
        else if (el.tagName === "SELECT") { const d = SELECTS.find((x) => x.name === el.name); el.value = d ? d.fallback : (el.options[0] || {}).value || ""; }
        else el.value = "";
      });
      render();
      setMsg("Cleared. Every number is now blank — the protocol says “(not specified)” rather than assuming a default.");
    });

    // Formatted Word protocol, matching the ACNU/SCCS/CCO/DA builders.
    const buildDocx = async (s) => {
      const D = window.docx;
      const today = new Date().toISOString().slice(0, 10);
      const FONT = "Times New Roman";
      const text = (str, o = {}) => new D.TextRun({ text: String(str ?? ""), font: FONT, size: 22, ...o });
      const p = (ch, o = {}) => new D.Paragraph({ children: Array.isArray(ch) ? ch : [ch], spacing: { before: 60, after: 60, ...(o.spacing || {}) }, ...o });
      const h1 = (str) => new D.Paragraph({ children: [text(str, { bold: true, size: 28 })], spacing: { before: 200, after: 80 }, heading: D.HeadingLevel.HEADING_1 });
      const para = (str) => p([text(str)]);
      const bullet = (str) => new D.Paragraph({ children: [text(str)], bullet: { level: 0 }, spacing: { before: 0, after: 0 } });
      const numItem = (str) => new D.Paragraph({ children: [text(str)], numbering: { reference: "ordered", level: 0 }, spacing: { before: 0, after: 0 } });
      const border = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" };
      const cb = { top: border, bottom: border, left: border, right: border };
      const labelTable = (rows) => new D.Table({
        width: { size: 9026, type: D.WidthType.DXA }, columnWidths: [3000, 6026],
        rows: rows.map(([label, value]) => new D.TableRow({ children: [
          new D.TableCell({ borders: cb, width: { size: 3000, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR }, children: [p([text(label, { bold: true })])] }),
          new D.TableCell({ borders: cb, width: { size: 6026, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, children: [p([text(value || "-")])] }),
        ] })),
      });

      const E = or(s.exposure, "(treatment)"), C = or(s.comparator, "(comparator)");
      const estPlain = estimandPlain(s.estimand);
      const subg = mergeList(s.subgroupsPick, s.subgroupsCustom);
      const sens = mergeList(s.sensitivityPick, s.sensitivityCustom);

      let __phdcLogo = null; try { const __r = await fetch("/images/networks/phdc.png"); if (__r.ok) __phdcLogo = new Uint8Array(await __r.arrayBuffer()); } catch (e) {}
      const children = [];
      if (__phdcLogo) children.push(new D.Paragraph({ spacing: { after: 120 }, children: [new D.ImageRun({ data: __phdcLogo, transformation: { width: 210, height: 51 } })] }));
      children.push(p([text(or(s.title, "(Untitled sequential trial emulation)"), { bold: true, size: 32 })], { spacing: { after: 40 } }));
      children.push(p([text("Study protocol · sequential (nested) trial emulation · drafted " + today, { italics: true, color: "777777", size: 18 })], { spacing: { after: 160 } }));
      const noteBlock = (head, list, colour) => {
        if (!list.length) return;
        children.push(p([text(head, { bold: true, color: colour })], { spacing: { after: 60 } }));
        list.forEach((m) => children.push(new D.Paragraph({ children: [text(m, { color: colour })], bullet: { level: 0 }, spacing: { before: 0, after: 0 } })));
        children.push(p([text("")], { spacing: { after: 120 } }));
      };
      noteBlock(BLK_HEAD, blockers(s), "9E3A2C");
      noteBlock(CAU_HEAD, cautions(s), "8A6100");
      window.PC.abstractDocx(window.docx, pcOf(s)).forEach((c) => children.push(c));

      const figs = figSpecs(s);
      // HARPER item 7.2 — the study design diagram. The picture alone does not
      // satisfy the item: an image-stripping extractor and a reviewer reading the .docx as text see
      // nothing — so designDiagramDocx emits the picture, a numbered caption and
      // a written description together, and that text is what carries the item.
      // It never throws; on failure it returns a visible note instead of a
      // silently absent figure, and the download handler says which you got.
      lastFigNote = "";
      for (const f of figs) {
        const fig = await window.designDiagramFigure(document.getElementById(f.el), { caption: f.cap });
        // opts.lines is the supported way to supply the written description, but
        // designDiagramDocx prefers fig.lines when the shared renderer has
        // registered a spec — which it has for Figure 1. Its spec lines are
        // rounded for display ("day −1y to 0"), and fmtDay turns 350 days into
        // "1y", so the only machine-readable description of the figure would
        // name a window the form does not hold. The lines below are built from
        // the same readers the prose uses, so they carry the exact counts;
        // fig.lines is cleared so they are the ones that survive.
        const paras = window.designDiagramDocx(D, Object.assign({}, fig, { lines: null }), { font: FONT, caption: f.cap, lines: f.lines });
        paras.forEach((c) => children.push(c));
        if (!paras.placed) lastFigNote += " Exported WITHOUT " + f.cap.split(".")[0] + ": " + (fig.reason || paras.error || "unknown reason") + ".";
      }

      children.push(h1("4. Eligibility (re-assessed at each origin)"));
      children.push(para(or(s.eligibility, DEF.eligibility)));
      children.push(para("Every nested trial is itself a new-user trial started at that origin, so the same windows as an active-comparator new-user design are applied at each origin, all measured before that origin: a new-user washout of " + daysTxt(s.washout) + " with no prior exposure or comparator, and a covariate / eligibility look-back of " + covLbText(s) + ". Because these windows move with the origin, eligibility, treatment assignment and the start of follow-up remain aligned at every trial's time zero — which is what prevents immortal-time bias. A patient who is ineligible at one origin may become eligible at a later one."));

      children.push(h1("5. Time zero and treatment assignment"));
      children.push(para("For each trial, time zero is that trial's origin, and each trial has a maximum follow-up of " + daysTxt(s.futrial) + ". " + stop(or(s.assignment, DEF.assignment))));
      children.push(para("Assignment is determined by what happens at the origin. Nothing after the origin may enter the eligibility or assignment rule — a rule that looks forward (for example, “initiated within the next 90 days”) reintroduces immortal time, because it can only be evaluated in patients who survived long enough for it to be evaluated."));

      children.push(h1("6. Enrolment across trials"));
      children.push(para(or(s.multiple, DEF.multiple)));
      children.push(para(REUSE));

      children.push(h1("7. Confounding adjustment"));
      children.push(para(or(s.confounding, DEF.confounding)));
      children.push(para("Covariates are re-measured at each origin, over the look-back windows above. A patient who enters several trials therefore carries a different covariate vector — and a different propensity score — in each. Balance (standardised mean differences) is assessed within trial, not only in the pooled dataset, because a pooled table can appear balanced while individual trials are not."));

      children.push(h1("8. Follow-up and outcome"));
      children.push(para(stop(or(s.followup, DEF.followup)) + " Maximum follow-up per trial: " + daysTxt(s.futrial) + ". Outcome: " + or(s.outcome, "(outcome)") + "."));
      children.push(para("Trials with later origins have less calendar time remaining before the data end, so they are administratively censored earlier. Long-term contrasts are therefore informed mainly by the earliest trials; we report how many trials are still contributing at each follow-up time."));
      children.push(para("Competing risks. The follow-up rule above censors at death from any cause, and the outputs below include cumulative-incidence or survival curves. Censoring at a competing death and fitting a Cox model estimates the cause-specific hazard, which is a defensible primary analysis; but one minus the Kaplan-Meier curve is NOT the cumulative incidence in that setting — it overstates it — and a survival difference or an RMST difference computed the same way is a quantity defined in a world where the competing event has been eliminated. State which of the two you intend, and if absolute risk is the target, estimate it with a method that keeps the competing event in the denominator."));

      children.push(h1("9. Estimand and effect measure"));
      children.push(para("The target estimand is " + estPlain + ". We report " + effectText(s) + "."));
      children.push(para("The pooled estimate is not the effect in one population: with a single treatment coefficient across all trials it is an average of the origin-specific effects, weighted by how much information each trial contributes — and those weights are data-dependent, because later trials carry less remaining follow-up (Section 8). We report the per-trial estimates and their sizes so the average can be read for what it is."));
      if (s.estimand === "ITT" || s.estimand === "both") children.push(para("The intention-to-treat contrast here is a contrast of initiation strategies. If control-arm patients later start the index treatment, or treated patients stop, the ITT effect is attenuated toward the null by an amount the ITT estimate alone cannot reveal. We therefore report the observed switching and discontinuation over follow-up alongside it. Where the control arm is those not yet treated, a control who later initiates stays in the control arm of the trials they had already entered, for the whole of their follow-up — that is precisely what produces the attenuation. Their records are not censored at the moment they initiate; censoring them is the per-protocol analysis, not this one."));
      if (s.effect === "HR" || s.effect === "both") children.push(para("Proportional hazards is not guaranteed here. This design does not fail in the way a cloned design does — there the two arms hold the same patients at time zero, because every patient is cloned into both, so the two hazards coincide at the origin. But under an intention-to-treat contrast the arms converge as control patients start treatment, so the hazard ratio drifts toward the null with follow-up time; a weighted marginal hazard ratio need not be proportional even when the conditional one is; and one pooled coefficient across trials with different amounts of remaining follow-up is an average of time-varying hazard ratios whose value moves with the data cut-off. Proportionality is therefore checked rather than assumed, and an absolute contrast is reported alongside."));
      if (s.estimand === "PP" || s.estimand === "both") children.push(para("The per-protocol contrast requires censoring patients when they stop following the strategy assigned at their origin. That censoring is informative — those who keep adhering differ from those who do not — so it is adjusted with inverse-probability-of-censoring weights, fitted separately per arm, and it assumes every predictor of deviation is measured. The censoring weights are the same machinery a clone-censor-weight analysis uses, but the cloning step is not: assignment here is determined at the origin, so the arms are different people, and the per-protocol estimator therefore needs the treatment weights AND the censoring weights together, where a cloned design needs only the latter. Note what this means for a control who later initiates: under this contrast their earlier control-arm records ARE censored at the moment they initiate, which is exactly the step the intention-to-treat contrast does not take."));

      children.push(h1("10. Statistical analysis"));
      ["Construct the nested trials at each origin and assemble the stacked, trial-indexed dataset (one record per patient per trial they enter).", "Within each trial, estimate the propensity score from covariates measured at that origin and apply weighting (or matching); check balance within trial.", "Fit a pooled logistic (or weighted Cox) model across all trials with terms for the assigned treatment, follow-up time, and trial; " + censorClause(s), "Derive the effect measure from the fitted model: " + effectText(s) + (usesRMST(s.effect) ? ", taking the RMST in each arm as the area under its weighted survival curve from the origin to the horizon" : "") + ".", "Uncertainty: because patients enter several trials, the reference method is a non-parametric bootstrap resampling PATIENTS (not patient-trial records), repeating trial construction, propensity-score and censoring-weight estimation, and the outcome model inside every replicate (Keogh 2023). A robust (sandwich) variance clustered on the patient is the cheaper alternative; Danaei et al. (2013) used it in this design and described the resulting intervals as conservative. State which was used; model-based standard errors are not appropriate under either choice.", "Report the pooled effect as the primary result. Per-trial estimates are a descriptive check on stability across calendar time, not independent studies: because the trials share patients, I-squared and Cochran's Q do not carry their usual meaning."].forEach((l) => children.push(numItem(l)));

      children.push(h1("11. Subgroup analyses"));
      (subg.length ? subg : ["(none pre-specified)"]).forEach((l) => children.push(bullet(l)));

      children.push(h1("12. Sensitivity analyses"));
      (sens.length ? sens : ["(none pre-specified)"]).forEach((l) => children.push(bullet(l)));

      window.PC.tailDocx(window.docx, pcOf(s)).forEach((c) => children.push(c));

      children.push(h1("References"));
      REFS.forEach((l) => children.push(bullet(l)));

      children.push(p([new D.TextRun({ text: "Drafted with the Protocol Generator (" + today + ").", font: FONT, size: 18, italics: true, color: "808080" })], { spacing: { before: 400 } }));

      const doc = new D.Document({
        creator: "Protocol Generator — Sequential Trial",
        title: "Sequential trial protocol — " + (s.title || "study"),
        styles: { default: { document: { run: { font: FONT, size: 22 } } }, paragraphStyles: [
          { id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 28, bold: true, font: FONT }, paragraph: { spacing: { before: 200, after: 80 }, outlineLevel: 0 } },
        ] },
        numbering: { config: [{ reference: "ordered", levels: [{ level: 0, format: D.LevelFormat.DECIMAL, text: "%1.", alignment: D.AlignmentType.LEFT, style: { paragraph: { indent: { left: 720, hanging: 360 } } } }] }] },
        sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }],
      });
      return await D.Packer.toBlob(doc);
    };

    document.querySelector("[data-action='download-docx']").addEventListener("click", async () => {
      if (!window.docx) { setMsg("The Word engine (docx) did not load — check the network, then reload the page.", true); return; }
      setMsg("Building the Word document…");
      try { const n = fname("docx"); dl(await buildDocx(readForm()), n); setMsg("Downloaded " + n + "." + lastFigNote, !!lastFigNote); }
      catch (e) { console.error(e); setMsg("Word export failed: " + (e && e.message ? e.message : e), true); }
    });
  </script>
</BaseLayout>
