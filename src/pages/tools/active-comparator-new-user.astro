                  : s.primaryAnalysisType === "landmark"
                    ? "Follow-up begins at the landmark and patients with the event or censored before it are excluded, so the estimate is conditional on surviving event-free to the landmark and early events do not contribute."
                    : "**(primary analysis not specified — the censoring rule cannot be stated; choose one in Section 7)**") +
              " Misclassification of outcome possible."],
          ]],
          ["Other information", [
            ["17", "Ethics approval and approval number(s).", s.ethics || "Each participating site obtains local IRB / ethics approval before data extraction."],
            ["18", "Study protocol registration (where).", "[Register on ENCePP EU PAS Register and/or ClinicalTrials.gov where applicable.]"],
            ["19", "Sharing of data, analytic code, materials.", "[To be specified.]"],
            ["20", "Funding source(s).", "[To be specified.]"],
            ["21", "Conflicts of interest.", "[To be specified for each author.]"],
          ]],
        ];

        const checklistRows = [
          new D.TableRow({ tableHeader: true, children: [
            headerCell("#"), headerCell("Item"), headerCell("Where reported in this protocol"),
          ]}),
        ];
        for (const [section, items] of fullChecklist) {
          checklistRows.push(new D.TableRow({ children: [
            new D.TableCell({ borders: cellBorders, columnSpan: 3,
              shading: { fill: "E8F0EE", type: D.ShadingType.CLEAR },
              margins: { top: 60, bottom: 60, left: 120, right: 120 },
              children: [p([text(section, { bold: true, color: "21443E" })])] }),
          ]}));
          for (const [n, label, mapped] of items) {
            checklistRows.push(new D.TableRow({ children: [
              new D.TableCell({ borders: cellBorders, margins: { top: 60, bottom: 60, left: 120, right: 120 },
                width: { size: 800, type: D.WidthType.DXA },
                shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR },
                children: [p([text(n, { bold: true })])] }),
              new D.TableCell({ borders: cellBorders, margins: { top: 60, bottom: 60, left: 120, right: 120 },
                width: { size: 4113, type: D.WidthType.DXA },
                children: [p([text(label)])] }),
              new D.TableCell({ borders: cellBorders, margins: { top: 60, bottom: 60, left: 120, right: 120 },
                width: { size: 4113, type: D.WidthType.DXA },
                children: mapped.split("\n").map((l) => p([text(l)])) }),
            ]}));
          }
        }
        const fullChecklistTable = new D.Table({
          width: { size: 9026, type: D.WidthType.DXA },
          columnWidths: [800, 4113, 4113],
          rows: checklistRows,
        });

        const children = [];
        children.push(new D.Paragraph({
          children: [text("TARGET checklist; " + (s.title || "(Untitled multi-national ACNU study)"), { bold: true, size: 32 })],
          spacing: { before: 0, after: 120 },
        }));
        children.push(p([new D.TextRun({
          text: "This document maps the protocol fields to the TARGET (TrAnsparent ReportinG of studies Emulating a Target trial) checklist as published in Cashin AG, Hansford HJ, Hernán MA, Swanson SA, Lee H, Jones MD, et al. JAMA 2025; PMID 40899949. The full checklist with elaboration is at target-guideline.org.",
          font: FONT, size: 20, italics: true, color: "555555",
        })]));
        children.push(p([new D.TextRun({
          text: "Generated " + today + " from the AsPEN ACNU protocol builder. Methods items 5-7 are pre-filled from your protocol; Results / Discussion / Other-information items are placeholders to be completed at the time of reporting.",
          font: FONT, size: 18, italics: true, color: "777777",
        })], { spacing: { after: 240 } }));

        // The checklist is a mapping of the protocol's fields, so a substituted
        // field is mapped here too — rows 7c, 7f, 7g and 7h are written from
        // psMethod, effectMeasure and metaMethod. A reviewer reading only the
        // checklist would otherwise see the substituted specification certified
        // against a reporting guideline.
        const staleTgt = staleMsgsDoc();
        if (staleTgt.length) {
          children.push(p([text(STALE_DOC_HEAD, { bold: true, color: "B00000" })]));
          staleTgt.forEach((m) => children.push(p([text("• " + m)])));
        }

        children.push(h1("Item 7; Target trial specification vs emulation"));
        children.push(p([text("Item 7 is the heart of TARGET. Rows a-h show what the target trial would specify and how this study emulates each piece in observational data.")]));
        children.push(item7Table);

        children.push(h1("Full TARGET checklist"));
        children.push(p([text("All 21 reporting items with the protocol's current mapping. Replace bracketed placeholders at the manuscript stage.")]));
        children.push(fullChecklistTable);

        children.push(p([new D.TextRun({
          text: "Citation for the framework: Cashin AG, Hansford HJ, Hernán MA, Swanson SA, et al. Transparent Reporting of Observational Studies Emulating a Target Trial: The TARGET Statement. JAMA 2025. PMID 40899949. License: CC BY-ND 4.0.",
          font: FONT, size: 18, italics: true, color: "777777",
        })], { spacing: { before: 400 } }));

        const doc = new D.Document({
          creator: "AsPEN protocol builder; TARGET checklist generator",
          title: "TARGET checklist; " + (s.title || "ACNU protocol"),
          styles: {
            default: { document: { run: { font: FONT, size: 22 } } },
            paragraphStyles: [
              { id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true,
                run: { size: 28, bold: true, font: FONT },
                paragraph: { spacing: { before: 240, after: 100 }, outlineLevel: 0 } },
              { id: "Heading2", name: "Heading 2", basedOn: "Normal", next: "Normal", quickFormat: true,
                run: { size: 24, bold: true, font: FONT },
                paragraph: { spacing: { before: 180, after: 60 }, outlineLevel: 1 } },
            ],
          },
          sections: [{
            properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } },
            children,
          }],
        });
        return await D.Packer.toBlob(doc);
      };

      // ── Phenotype library modal ─────────────────────
      const modal      = document.querySelector("[data-library-modal]");
      const modalTitle = document.querySelector("[data-library-title]");
      const modalList  = document.querySelector("[data-library-list]");
      const modalSearch= document.querySelector("[data-library-search]");
      let currentCategory = "indications";
      let currentTargets  = {}; // { name?, codes?, def?, validation? }

      const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
      }[c]));

      const renderLibrary = (filter = "") => {
        // Confounding library uses the PS_METHODS array (each has value + label
        // + definition + validation). Phenotype categories use PHENOTYPES.
        const items = currentCategory === "confounding"
          ? PS_METHODS.map((m) => ({ name: m.label, value: m.value, definition: m.definition, validation: m.validation }))
          : (PHENOTYPES[currentCategory] || []);
        const f = filter.trim().toLowerCase();
        const filtered = f
          ? items.filter((it) =>
              (it.name || "").toLowerCase().includes(f) ||
              (it.codes || "").toLowerCase().includes(f) ||
              (it.notes || "").toLowerCase().includes(f) ||
              (it.definition || "").toLowerCase().includes(f))
          : items;
        if (filtered.length === 0) {
          modalList.innerHTML = '<p class="px-3 py-6 text-sm text-slate-500 italic text-center">No matches.</p>';
          return;
        }
        // NOTE: validation citation is NOT shown in the modal; it accumulates
        // silently on pick and lands in the Word/MD References section at the
        // end of export. Modal stays focused on operational definitions.
        modalList.innerHTML = filtered.map((it, idx) => `
          <button type="button" data-phenotype-idx="${idx}"
                  class="block w-full text-left px-4 py-3 rounded-lg border border-transparent hover:border-brand-300 hover:bg-brand-50/40 transition">
            <p class="font-semibold text-slate-900 text-sm">${esc(it.name)}</p>
            ${it.codes ? `<p class="mt-1 text-xs text-slate-700 font-mono leading-relaxed">${esc(it.codes)}</p>` : ""}
            ${it.definition ? `<p class="mt-1 text-xs text-slate-600 leading-relaxed">${esc(it.definition)}</p>` : ""}
            ${it.notes ? `<p class="mt-1 text-[11px] text-slate-500 leading-relaxed">${esc(it.notes)}</p>` : ""}
          </button>
        `).join("");
        // Click handler; fill targets + close
        modalList.querySelectorAll("[data-phenotype-idx]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const it = filtered[parseInt(btn.dataset.phenotypeIdx, 10)];
            if (!it) return;
            const fill = (key, val) => {
              const fieldName = currentTargets[key];
              if (!fieldName || val === undefined) return;
              const el = form.querySelector(`[name="${fieldName}"]`);
              if (el) el.value = val;
            };
            fill("name",  it.name);
            fill("codes", it.codes);
            fill("def",   it.definition);
            // For confounding picks: drop the value into the <select> (psMethod)
            if (currentTargets.value && it.value !== undefined) {
              const el = form.querySelector(`[name="${currentTargets.value}"]`);
              if (el) el.value = it.value;
            }
            if (currentTargets.alsoFill) {
              const el = form.querySelector(`[name="${currentTargets.alsoFill}"]`);
              if (el && it.name) el.value = it.name;
            }
            // Record citation for the References section
            if (it.validation) {
              pickedCitations[it.name] = it.validation;
              savePickedCitations();
            }
            closeLibrary();
            render();
          });
        });
      };

      const openLibrary = (category, targets) => {
        currentCategory = category;
        currentTargets  = targets;
        modalTitle.textContent = ({
          indications: "Pick an indication (cohort definition)",
          exposures:   "Pick a drug class (exposure or comparator)",
          outcomes:    "Pick an outcome; fills definition + codes",
          confounding: "Pick a confounding-control method; fills the method + operational details",
        })[category] || "Pick from library";
        modalSearch.value = "";
        renderLibrary("");
        modal.classList.remove("hidden");
        setTimeout(() => modalSearch.focus(), 50);
      };
      const closeLibrary = () => modal.classList.add("hidden");

      // Bind library triggers (from form section headers)
      document.querySelectorAll("[data-open-library]").forEach((btn) => {
        btn.addEventListener("click", () => {
          openLibrary(btn.dataset.category, {
            name:     btn.dataset.targetName,
            codes:    btn.dataset.targetCodes,
            def:      btn.dataset.targetDef,
            value:    btn.dataset.targetValue,
            alsoFill: btn.dataset.alsoFill,
          });
        });
      });
      document.querySelector("[data-library-close]")?.addEventListener("click", closeLibrary);
      modal.addEventListener("click", (e) => { if (e.target === modal) closeLibrary(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeLibrary(); });
      modalSearch.addEventListener("input", () => renderLibrary(modalSearch.value));

      // Exported for testing (and any future reuse): the IIFE otherwise hides these.
      window.__builder = { readForm, buildMarkdown, buildDocx };

      setState("ready");
    })();
  </script>
</BaseLayout>
