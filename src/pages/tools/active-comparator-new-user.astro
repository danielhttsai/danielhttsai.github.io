  <!-- docx library (UMD bundle); used to generate Word files client-side -->
  <script src="https://unpkg.com/docx@8.5.0/build/index.umd.js" is:inline></script>

  <script is:inline define:vars={{ BASE: base, SITES_DETAIL_MAP, FEATURES, TIMELINE_PRESETS, PS_METHODS, PS_METHOD_DESCRIPTIONS, INDEX_DATE_OPTIONS, PHENOTYPES }}>
    (() => {
      const setState = (name) => {
        document.querySelectorAll("[data-state]").forEach((el) => {
          el.classList.toggle("hidden", el.dataset.state !== name);
        });
      };

      const STORAGE_KEY = "aspen.protocol-builder.acnu";
      const STORAGE_CITATIONS_KEY = "aspen.protocol-builder.acnu.citations";
      const form = document.querySelector("[data-builder]");
      const preview = document.querySelector("[data-preview]");
      const actionMsg = document.querySelector("[data-action-msg]");

      // ── Picked citations (from library picks); appended to References on export.
      // Stored as { phenotypeName: citationString } so we dedup and can clear.
      let pickedCitations = {};
      try { pickedCitations = JSON.parse(localStorage.getItem(STORAGE_CITATIONS_KEY) || "{}") || {}; } catch {}
      const savePickedCitations = () => {
        try { localStorage.setItem(STORAGE_CITATIONS_KEY, JSON.stringify(pickedCitations)); } catch {}
      };

      const setMsg = (msg, isError = false) => {
        if (!actionMsg) return;
        actionMsg.textContent = msg;
        actionMsg.classList.toggle("text-rose-700", isError);
        actionMsg.classList.toggle("text-brand-700", !isError);
      };

      // Format a site id into "Country · Short [Rx Dx ...]".
      const formatSiteFull = (id) => {
        const d = SITES_DETAIL_MAP[id];
        if (!d) return id;
        const feats = (d.features || []).map((f) => (FEATURES.find((x) => x.id === f) || {}).short || f).join(" ");
        return d.country + " · " + d.short + (feats ? " [" + feats + "]" : "");
      };

      // ── Feasibility detection ───────────────────────────────
      // Map the chair's typed text → which data features are needed.
      // These regexes lean on common English / shorthand terms; they're
      // intentionally permissive so a heads-up appears even on a quick
      // first draft. Always-required features (Rx + Dx) are added at the
      // top because this is an active-comparator pharmacoepi study.
      const FEATURE_TRIGGERS = {
        labs:      /\b(hba1c|egfr|creatinine|bmi|blood\s*pressure|systolic|diastolic|ldl|hdl|cholesterol|glucose|albumin|hemoglobin|haemoglobin|inr|tsh|lipid|biochemical|biochemist|labora?tor[yi]|lab[s]?\b)/i,
        mortality: /\b(mortality|all-?cause death|cv death|cardiovascular death|cause of death|died|fatal|death|survival)\b/i,
        cancer:    /\b(cancer|carcinom|malignan|neoplasm|tumou?r|sarcoma|leuk[ae]mia|lymphoma|registr[yi].*cancer|cancer.*registr[yi])\b/i,
        pregnancy: /\b(pregnan|birth|neonatal|gestation|trimester|maternal|fetal|foetal|infant)\b/i,
        imaging:   /\b(imaging|mri|ct\s*scan|x-?ray|ultrasound|echocardio|angio|radiolog)\b/i,
        genomics:  /\b(genomic|snp|gwas|biobank|genotype|exome|gene(?:tic)?\b)\b/i,
      };
      const FEATURE_TEXT_FIELDS = [
        "outcomeDef","outcomeCodes",
        "covariatesCustom","inclusionCustom","exclusionCustom",
        "picoP","picoI","picoO","secondaryOutcomesCustom",
        "indication","exposureName","comparatorName","emulatedTrial",
        "psMethodDetails","subgroupsCustom","sensitivityCustom",
      ];
      const FEATURE_MULTI_FIELDS = [
        "covariatesPick","secondaryOutcomesPick","inclusionPick","exclusionPick",
        "subgroupsPick","sensitivityPick","censoringPick",
      ];

      const computeRequiredFeatures = (state) => {
        let blob = "";
        for (const f of FEATURE_TEXT_FIELDS) blob += " " + (state[f] || "");
        for (const f of FEATURE_MULTI_FIELDS) blob += " " + ((state[f] || []).join(" "));
        const req = new Set(["rx","dx"]);    // ACNU always needs prescriptions + diagnoses
        for (const [feat, rx] of Object.entries(FEATURE_TRIGGERS)) {
          if (rx.test(blob)) req.add(feat);
        }
        return req;
      };

      const renderFeasibility = (state) => {
        const panel  = document.querySelector("[data-feasibility]");
        const list   = document.querySelector("[data-feasibility-list]");
        if (!panel || !list) return;
        const required = computeRequiredFeatures(state);
        const selected = state.sites || [];
        if (selected.length === 0) { panel.classList.add("hidden"); return; }

        const gaps = [];
        for (const featId of required) {
          if (featId === "rx" || featId === "dx") continue; // these are universal in claims/EHR
          const featLabel = (FEATURES.find((f) => f.id === featId) || {}).label || featId;
          const missing = [];
          const have    = [];
          for (const sid of selected) {
            const d = SITES_DETAIL_MAP[sid];
            if (!d) continue;
            (d.features.includes(featId) ? have : missing).push(d.short);
          }
          if (missing.length > 0) {
            gaps.push({ feature: featLabel, missing, have });
          }
        }

        if (gaps.length === 0) { panel.classList.add("hidden"); return; }
        list.innerHTML = gaps.map((g) =>
          `<li><strong>${g.feature}</strong>; implied by your study text. Missing at: <strong>${g.missing.join(", ")}</strong>` +
          (g.have.length > 0 ? `. Available at: ${g.have.join(", ")}.` : `.`) + `</li>`
        ).join("");
        panel.classList.remove("hidden");
      };

      // ── Form state read / write ─────────────────────
      const readForm = () => {
        const data = new FormData(form);
        const out = {};
        // Multi-value keys → arrays
        const multi = new Set(["sites", "censoringPick", "covariatesPick", "subgroupsPick", "sensitivityPick", "inclusionPick", "exclusionPick", "secondaryOutcomesPick"]);
        for (const k of multi) out[k] = [];
        for (const [k, v] of data.entries()) {
          if (multi.has(k)) out[k].push(String(v));
          else out[k] = String(v);
        }
        return out;
      };

      const writeForm = (state) => {
        const multi = new Set(["sites", "censoringPick", "covariatesPick", "subgroupsPick", "sensitivityPick", "inclusionPick", "exclusionPick", "secondaryOutcomesPick"]);
        for (const el of form.querySelectorAll("input, textarea, select")) {
          const name = el.name;
          if (!name) continue;
          if (el.type === "checkbox" && multi.has(name)) {
            el.checked = (state[name] || []).includes(el.value);
          } else if (el.type === "checkbox") {
            // Single (non-list) checkbox, e.g. pscEnable. FormData omits it
            // entirely when unchecked, so an absent key means unchecked —
            // assigning to .value here would silently do nothing.
            el.checked = state[name] === el.value;
          } else if (state[name] !== undefined) {
            el.value = state[name];
          }
        }
      };

      // ── Merge built-in checkboxes + custom textarea ───
      const mergeList = (picks, customText) => {
        const lines = (customText || "")
          .split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        return [...(picks || []), ...lines];
      };

      const bullets = (arr) =>
        arr.length === 0 ? "_(none specified)_" : arr.map((l) => "- " + l).join("\n");
      const numbered = (arr) =>
        arr.length === 0 ? "_(none)_" : arr.map((l, i) => (i + 1) + ". " + l).join("\n");

      const orFb = (s, fb) => (s && s.trim()) ? s : fb;
      const pcOf = (s) => ({
        design: "active-comparator new-user cohort study under a target-trial-emulation framework",
        tte: true,
        population: orFb(s.picoP, "(population)"),
        exposure: orFb(s.picoI, "(exposure)"),
        comparator: orFb(s.picoC, "(active comparator)"),
        outcome: orFb(s.picoO, "(primary outcome)"),
        data: (s.sites && s.sites.length ? s.sites.length + " AsPEN data source(s)" : "multi-national AsPEN data sources"),
        analysis: "propensity-score confounding control with an intention-to-treat / on-treatment Cox analysis, pooled across sites by meta-analysis",
        groupBy: "treatment group",
        skip: ["studySize", "ethics"],
        limitations: "The active comparator must share the indication and have no a-priori association with the outcome; residual confounding by unmeasured indication severity and informative censoring under the on-treatment analysis remain possible.",
        plannedOutputs: ["Cohort-attrition / participant-flow diagram.", "Table 1 with standardised mean differences before/after PS adjustment (Love plot).", "Kaplan–Meier / cumulative-incidence curves and a forest plot of site-specific and pooled effects."],
      });
      const sitesLine = (ids, otherText) => {
        const parts = (ids || []).map((c) => "- " + formatSiteFull(c));
        const others = (otherText || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        if (parts.length === 0 && others.length === 0) return "_(no sites selected)_";
        let out = parts.join("\n");
        if (others.length > 0) {
          out += (out ? "\n\n**Other sites:**\n" : "**Other sites:**\n");
          out += others.map((o) => "- " + o).join("\n");
        }
        return out;
      };

      // ══ Propensity-score calibration ══════════════════════════════════
      // Stürmer T, Schneeweiss S, Avorn J, Glynn RJ. Adjusting effect estimates
      // for unmeasured confounding with validation data using propensity score
      // calibration. Am J Epidemiol 2005;162(3):279-89.
      //
      // The algebra, so the code below is checkable. Write C for the covariates
      // the claims database records and U for the clinical ones only the
      // validation dataset has. PS_ep = P(T=1 | C); PS_gs = P(T=1 | C, U).
      // The outcome model we WANT (and cannot fit in claims) is
      //     g(E[Y | T, PS_gs]) = b0 + bT·T + bP·PS_gs
      // and the calibration model, fitted in the validation dataset, is
      //     E[PS_gs | PS_ep, T] = a0 + a1·PS_ep + a2·T.
      // Substituting and taking the expectation over PS_gs given (T, PS_ep) —
      // which is legitimate only under SURROGACY, Y ⫫ PS_ep | (T, PS_gs) —
      //     g(E[Y | T, PS_ep]) = (b0 + bP·a0) + (bT + bP·a2)·T + (bP·a1)·PS_ep
      // so the naive claims-only coefficients are bT* = bT + bP·a2 and
      // bP* = bP·a1, and inverting gives the correction used here:
      //     bT = bT* − (a2/a1)·bP*        bP = bP*/a1
      // This is Rosner/Spiegelman regression calibration with the PS as the
      // mismeasured covariate; it assumes the outcome model adjusts for the PS
      // as a LINEAR term, not by matching, stratification or weighting.
      const PSC_STORAGE_KEY = "aspen.protocol-builder.acnu.psc";
      let pscClass = {};
      try { pscClass = JSON.parse(localStorage.getItem(PSC_STORAGE_KEY) || "{}") || {}; } catch {}
      let pscAi = {};      // { name: {source, confounding, role, reason} } from the Worker
      const savePscClass = () => { try { localStorage.setItem(PSC_STORAGE_KEY, JSON.stringify(pscClass)); } catch {} };
      const pscEsc = (v) => String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

      // Deterministic first guess. Claims hold codes, not measurements: lab
      // RESULTS, vitals/anthropometry, imaging and test readings, severity
      // scores and lifestyle are the things a claims database cannot see.
      // Anything else defaults to claims, because the rest of this builder's
      // covariate vocabulary (diagnoses, comedications, utilisation) is claims.
      //
      // Names are normalised to lower case with every separator turned into a
      // space FIRST. Real column names are written HbA1c_first / eGFR_last /
      // IOP-post, and \b does not fire against an underscore (it is a word
      // character), so testing the raw name silently misses them.
      // Normalise before matching. Three things bite here, all found by testing
      // names from other specialties and languages:
      //   * \b never fires against "_", so HbA1c_first / eGFR_last were missed;
      //   * the CJK range alone drops Hangul and kana entirely, so every Korean
      //     and Japanese name was stripped to spaces and fell through to claims;
      //   * accented Latin ("Créatinine") did not match its unaccented pattern.
      // NFD + combining-mark removal fixes the third.
      // The NFC at the end is load-bearing: NFD decomposes Hangul syllables into
      // conjoining jamo (U+1100 block), which fall outside the kept ranges, so
      // without recomposing, every Korean name was stripped to an empty string
      // and classified claims by fallthrough.
      const pscNorm = (n) => String(n).normalize("NFD").replace(/[̀-ͯ]/g, "").normalize("NFC")
        .toLowerCase().replace(/[^a-z0-9぀-ヿ㐀-鿿가-힯]+/g, " ").trim();
      const PSC_CLINICAL_RX = new RegExp([
        "hba1c|glycated|glycosylated|creatinine|\\begfr\\b|\\bgfr\\b|\\bldl\\b|\\bhdl\\b|cholesterol|triglycerid|albumin|h[ae]moglobin|\\bplatelet|\\bwbc\\b|leu[ck]ocyte|neutrophil|lymphocyte|\\binr\\b|\\btsh\\b|\\bft4\\b|blood glucose|fasting glucose|\\bast\\b|\\balt\\b|\\bggt\\b|bilirubin|ferritin|\\bcrp\\b|\\besr\\b|uric acid|proteinuria|albuminuria|lab result|laborator",
        "\\bbmi\\b|body mass|\\bheight\\b|\\bweight\\b|waist|blood pressure|systolic|diastolic|\\bsbp\\b|\\bdbp\\b|heart rate|\\bpulse\\b|respiratory rate|body temperature|\\bspo2\\b|oxygen satur|vital sign",
        "visual acuity|intraocular|\\biop\\b|ejection fraction|\\blvef\\b|\\bfev1\\b|\\bfvc\\b|spiromet|macular thickness|retinal thickness|\\boct\\b|tumou?r (?:size|stage|grade)|\\btnm\\b|biops|histolog|patholog|imaging|\\bmri\\b|ct scan|echocardiogra|ultrasound",
        "\\bnyha\\b|\\bgcs\\b|glasgow|\\bnihss\\b|child ?pugh|\\bmeld\\b|\\becog\\b|karnofsky|apache|\\bsofa\\b|severity score|disease severity|performance status",
        "smok|tobacco|cigarette|alcohol|drinking|betel|\\bdiet\\b|physical activity|exercise habit|lifestyle|\\badl\\b|\\biadl\\b|\\bmmse\\b|cognitive score|frailty (?:index|scale|score)",
        "\\b(?:dm|diabet\\w*|disease|illness|hypertension) duration|duration of (?:dm|diabet|disease|illness)",
        // Rating scales, indices and stage/grade readings — clinical instruments,
        // never billed. Whole specialties fell through without these.
        "\\bpanss\\b|\\bbprs\\b|ham ?[ad]\\b|\\bhamd\\b|\\bhama\\b|\\bmadrs\\b|\\bymrs\\b|\\bphq ?9\\b|\\bgad ?7\\b|\\bcdr\\b|\\badas\\b|\\bupdrs\\b|\\bmoca\\b|\\bmmse\\b|\\bdas28\\b|\\bhaq\\b|\\bodi\\b|\\beq ?5d\\b|\\bsf ?36\\b|\\bvas\\b|\\bnrs\\b|\\basa (?:class|status|grade)|\\bfrs\\b|risk score",
        "\\bki ?67\\b|pd ?l1|\\btps\\b|\\bcps\\b|recist|gleason|\\bbreslow\\b|\\bnottingham\\b|allred|mitotic|\\bher2\\b|\\bmsi\\b|\\btmb\\b|tumou?r burden|lesion (?:size|count)|\\bejection\\b",
        "\\bkt ?v\\b|\\burr\\b|dialysis adequacy|\\bktv\\b",
        "gestational age|\\bapgar\\b|birth ?weight|\\bcrown rump\\b|\\bfundal\\b|cervical length",
        "\\bsodium\\b|\\bpotassium\\b|\\bchloride\\b|bicarbonate|\\bmagnesium\\b|\\bphosphate\\b|troponin|\\bbnp\\b|nt ?pro ?bnp|\\bd ?dimer\\b|\\blactate\\b|\\bprocalcitonin\\b|\\bcpk\\b|\\bck ?mb\\b|\\bamylase\\b|\\blipase\\b|\\btitre\\b|\\btiter\\b|serum \\w+|plasma \\w+|urine \\w+",
        "family history|\\bpolygenic\\b|genetic risk|\\bgenotype\\b|\\bgwas\\b|\\bsnp\\b|functional status|\\bkarnofsky\\b|quality of life",
        // Traditional Chinese, Japanese and Korean equivalents of the above.
        "收縮壓|舒張壓|血壓|身高|體重|視力|眼壓|抽菸|吸菸|飲酒|檳榔|血糖|糖化|腰圍|心跳|體溫|檢驗|檢查值",
        "身長|体重|血圧|喫煙|飲酒|眼圧|血糖|体温|脈拍|検査値|検査結果|腹囲",
        "혈압|체중|신장|키|흡연|음주|안압|혈당|크레아티닌|체온|맥박|검사|검사결과|허리둘레",
        // Other European languages, after diacritics are stripped.
        "tension arterielle|pression arterielle|presion arterial|blutdruck|korpergewicht|korpergrosse|glycemie|glucemia|tabagisme|tabaquismo|rauchen",
      ].join("|"), "i");
      // Tested BEFORE the clinical rule. A coded diagnosis, procedure, dispensing
      // or encounter IS in claims even when the underlying measurement is not —
      // "weight loss diagnosis" and "smoking cessation counselling visit" are
      // billable, "weight" and "smoking" are not. The Worker prompt has always
      // said this; the keyword seed did not.
      const PSC_CLAIMS_OVERRIDE_RX = new RegExp([
        "\\bdiagnos\\w*|\\bdx\\b|\\bicd\\b|\\bicd ?9\\b|\\bicd ?10\\b|\\bcoded\\b|\\bcode\\b|\\bcodes\\b|code list",
        "\\bprocedure\\w*|\\bproc\\b|\\bsurger\\w*|\\boperation\\b|\\bcpt\\b|\\bhcpcs\\b|\\batc\\b|\\bndc\\b",
        "\\bdispens\\w*|\\bprescri\\w*|\\brefill\\w*|\\bdays supply\\b|\\bdefined daily dose\\b|\\bddd\\b",
        // NB: no bare "claim" token — investigators write "absent from claims"
        // inside a clinical variable's own description, and it flipped those.
        "\\bbilled\\b|\\bbilling\\b|\\breimburse\\w*|\\bcopay\\w*|\\bexpenditure\\b",
        "\\bvisit\\w*|\\bencounter\\w*|\\badmission\\w*|\\bhospitali[sz]\\w*|\\binpatient\\b|\\boutpatient\\b|\\bemergency\\b|\\breferral\\b|\\bcounsel\\w*|\\bscreening (?:visit|programme|program)\\b",
        "\\bcount\\b|\\bcounts\\b|\\bnumber of\\b|\\bfrequency of\\b|\\butilis\\w*|\\butiliz\\w*|\\bepisodes?\\b",
        "\\bhistory of\\b|\\bhistory_\\w*|\\bprior\\b|\\bprevious\\b|\\bcomorbid\\w*|charlson|elixhauser|\\bcci\\b",
        "就診|就醫|處方|健保|申報|門診|住院|診斷|受診|外来|入院|処方|診断|진료|처방|외래|입원|진단",
      ].join("|"), "i");
      // Things that belong in neither propensity score.
      const PSC_EXCLUDE_RX = new RegExp([
        "\\b(?:id|ids|identifier|uid|mrn|serial|ref)\\b|\\bsubject ?(?:ref|id|no|number)\\b",
        "\\b(?:patient|chart|record|case|enrol\\w*|enroll\\w*|registration|study) ?(?:no|number|id|ref)\\b",
        "^outcome\\b|\\boutcome \\w|^index date\\b|^end ?point\\b",
        "病歷號|病案號|身分證|去識別|案例編號|編號",
        "登録番号|患者番号|症例番号",
        "환자번호|등록번호|대상자번호",
      ].join("|"), "i");
      // Never claims however it is worded — no billing code carries these.
      const PSC_CLINICAL_ALWAYS_RX = /family history|polygenic|genetic risk|\bgenotype\b|\bgwas\b|\bbiobank\b/i;
      const pscHeuristic = (name) => {
        const n = pscNorm(name);
        if (PSC_EXCLUDE_RX.test(n)) return "exclude";
        if (PSC_CLINICAL_ALWAYS_RX.test(n)) return "clinical";
        // Investigators write covariates as whole sentences, and the coded/billed
        // words often live in the explanation rather than in the concept ("...
        // absent from claims but proxiable by opioid dispensing"). The head of
        // the name is the concept, so a clinical head with no coded word in it
        // wins; otherwise the coded reading wins anywhere in the name.
        const head = n.slice(0, 40);
        if (PSC_CLINICAL_RX.test(head) && !PSC_CLAIMS_OVERRIDE_RX.test(head)) return "clinical";
        // A coded diagnosis, procedure, dispensing or encounter IS in claims
        // even when the underlying measurement is not. Getting this backwards
        // is the dangerous direction: a clinical variable wrongly placed in C
        // enters PS_ep, drives PS_gs toward PS_ep, and collapses the correction
        // to a no-op that reads as "no unmeasured confounding".
        if (PSC_CLAIMS_OVERRIDE_RX.test(n)) return "claims";
        return PSC_CLINICAL_RX.test(n) ? "clinical" : "claims";
      };
      const pscClassOf = (name) => pscClass[name] || pscHeuristic(name);

      // Candidate variables = every covariate ticked in Section 8 (plus custom
      // ones), then anything typed as validation-only. Order preserved, deduped.
      const pscCandidates = (s) => {
        const seen = new Set(); const out = [];
        const push = (n) => { const t = String(n || "").trim(); if (!t || seen.has(t)) return; seen.add(t); out.push(t); };
        mergeList(s.covariatesPick, s.covariatesCustom).forEach(push);
        (s.pscVarsExtra || "").split(/\r?\n/).forEach(push);
        return out;
      };
      const pscNoteMap = (s) => {
        const m = {};
        (s.pscNotes || "").split(/\r?\n/).forEach((l) => {
          const i = l.indexOf("|");
          if (i > 0) m[l.slice(0, i).trim()] = l.slice(i + 1).trim();
        });
        return m;
      };

      const pscNum = (v) => { const x = parseFloat(v); return isFinite(x) ? x : null; };
      const pscFmt = (x, d) => (x === null || x === undefined || !isFinite(x)) ? "" : (Math.abs(x) >= 1e4 || (x !== 0 && Math.abs(x) < 1e-4) ? x.toExponential(3) : String(Math.round(x * Math.pow(10, d === undefined ? 4 : d)) / Math.pow(10, d === undefined ? 4 : d)));
      const pscSigned = (x, d) => (x === null ? "" : (x < 0 ? "− " + pscFmt(-x, d) : "+ " + pscFmt(x, d)));

      // Whether the calibrated number may be shown at all. A page that prints
      // "do not report this as a correction" and then prints the correction is
      // how the method gets misapplied by someone who read the warning.
      //   "ok"          — surrogacy supported; show it, allow the reuse claim.
      //   "provisional" — surrogacy not yet established; show it, labelled, no reuse.
      //   "withheld"    — surrogacy absent, partial, or unmeasurable; do not show it.
      const pscRelease = (v) =>
        (v === "s-low" || v === "s-mid" || v === "untestable") ? "withheld"
        : v === "s-high" ? "ok" : "provisional";

      // Reconcile the declared variable split against the entered coefficients.
      // If no covariate is marked clinical-only then U is empty, PS_gs is the
      // same model as PS_ep, and the calibration model can only return α₁ = 1,
      // α₂ = 0 — a correction of exactly zero. Coefficients saying otherwise
      // mean the split and the numbers came from different analyses.
      const pscContradiction = (clinical, claims, a1, a2) => {
        if (!clinical.length && (a1 !== null || a2 !== null)) {
          const identity = (a1 === null || Math.abs(a1 - 1) < 0.02) && (a2 === null || Math.abs(a2) < 0.02);
          if (!identity) {
            return "No covariate is marked clinical-only, so the gold-standard score is fitted from exactly the same variables as the error-prone score. PS_gs and PS_ep are then the same quantity, the calibration model can only return α₁ = 1 and α₂ = 0, and the correction is identically zero. The coefficients entered (α₁ = " + pscFmt(a1, 4) + ", α₂ = " + pscFmt(a2, 4) + ") cannot have come from this variable split. Either mark the variables the claims database cannot see, or re-enter coefficients from the analysis that matches this split.";
          }
        }
        if (!claims.length && (a1 !== null || a2 !== null)) {
          return "No covariate is marked claims-available, so there is no error-prone propensity score to calibrate and PS_ep is undefined. The coefficients entered cannot have come from this variable split.";
        }
        return null;
      };

      // Everything the exports and the on-screen card need, derived once.
      const pscModel = (s) => {
        const claims = [], clinical = [], excluded = [];
        pscCandidates(s).forEach((n) => {
          const c = pscClassOf(n);
          (c === "clinical" ? clinical : c === "exclude" ? excluded : claims).push(n);
        });
        const a0 = pscNum(s.pscA0), a1 = pscNum(s.pscA1), a2 = pscNum(s.pscA2);
        const a1se = pscNum(s.pscA1se), a2se = pscNum(s.pscA2se);
        const bT = pscNum(s.pscBt), bTse = pscNum(s.pscBtse), bP = pscNum(s.pscBp);
        const k = (a1 !== null && a2 !== null && a1 !== 0) ? a2 / a1 : null;
        const bC = (k !== null && bT !== null && bP !== null) ? bT - k * bP : null;
        // Interval for the NAIVE estimate only — that one comes straight out of
        // a single fitted model and is honest. The calibrated estimate gets an
        // interval only from the bootstrap the researcher actually ran: it is a
        // ratio of estimated coefficients across two models in two samples, and
        // a first-order delta method understates its width (measured here at
        // SE 0.014 against an empirical SD of 0.024), so no closed form is shown.
        const naiveLo = (bT !== null && bTse !== null) ? bT - 1.959964 * bTse : null;
        const naiveHi = (bT !== null && bTse !== null) ? bT + 1.959964 * bTse : null;
        const bootLo = pscNum(s.pscBootLo), bootHi = pscNum(s.pscBootHi);
        const hasBoot = bootLo !== null && bootHi !== null;
        const ratio = s.effectMeasure !== "RD";
        const measure = ({ HR: "HR", RR: "RR", RD: "RD", IRR: "IRR" })[s.effectMeasure] || "HR";
        const nonCollapsible = s.effectMeasure !== "RD";   // HR / RR-from-logistic / IRR: Wan bias source 1
        const scaleLabel = s.pscScale === "logit" ? "logit(PS)" : "PS (probability scale)";
        // Surrogacy verdict. S (Lunt 2012, Table 2 footnote g) is the primary
        // instrument and the p-value is demoted to a secondary one, because the
        // p-value is a test of an exact null in a sample of arbitrary size: on
        // our own angle sweep it rejected at p < 0.001 while S was 92.5% and
        // calibration was still removing most of the bias. Bands below are a
        // reading of Lunt's Table 2 plus our simulation, not a published cut-off.
        const surroP = pscNum(s.pscSurroP), surroCoef = pscNum(s.pscSurroCoef);
        const surroS = pscNum(s.pscSurroS);
        const surroTestable = s.pscSurroTestable !== "no";
        // A supplied S or p wins over the "no outcomes" dropdown: neither can be
        // computed without outcomes, so their presence is the better evidence
        // and a stale dropdown should not label a real measurement unmeasurable.
        const surroVerdict = surroS !== null ? (surroS >= 90 ? "s-high" : surroS >= 50 ? "s-mid" : "s-low")
          : surroP !== null ? (surroP < 0.05 ? "p-rejected" : "p-ok")
          : !surroTestable ? "untestable"
          : "untested";
        return {
          claims, clinical, excluded, a0, a1, a2, a1se, a2se, bT, bTse, bP,
          k, bC, naiveLo, naiveHi, bootLo, bootHi, hasBoot,
          ratio, measure, nonCollapsible, scaleLabel,
          surroP, surroCoef, surroS, surroTestable, surroVerdict,
          releaseLevel: pscRelease(surroVerdict), contradiction: pscContradiction(clinical, claims, a1, a2),
          bootB: (s.pscBootB || "").trim() || "1000",
          r2: pscNum(s.pscR2),
          claimsDb: (s.pscClaimsDb || "").trim() || "the claims database",
          valName: (s.pscValName || "").trim() || "(validation dataset not named)",
          valN: (s.pscValN || "").trim(),
          valType: s.pscValType === "external" ? "external" : "internal",
          treatLabel: (s.exposureName || s.picoI || "the exposure").trim() + " vs " + ((s.comparatorName || s.picoC || "the active comparator").trim()),
        };
      };

      // The validity gate, in the order a researcher should work through it.
      // Framed as: here is the condition, here is how to check it, here is what
      // to report. Wan F. Am J Epidemiol 2024;193(2):360-9 (doi:10.1093/aje/kwad189)
      // is the reason this is a gate and not a footnote.
      const pscValidity = (m) => {
        const out = [];
        out.push(["1. Surrogacy, and the proportionality condition behind it",
          "PSC assumes the error-prone score is a surrogate for the gold-standard score: Y ⫫ PS_ep | (T, PS_gs). Wan (2024) shows what that really demands — \"confounders cannot directly impact the outcome and … their effects on the outcome are solely mediated through the propensity score\" — and proves PSC \"is generally biased unless the effects of confounders on the outcome and treatment are proportional to each other\". Proportional means the covariate coefficient vector in the outcome model is a scalar multiple of the one in the treatment model. Nothing guarantees that in a real cohort."]);
        out.push([m.surroTestable ? "2. Measure it — you can, because the validation data have outcomes" : "2. You cannot measure it here, which is a reason not to proceed",
          m.surroTestable
            ? "Use S, not a p-value. S (Lunt et al., Am J Epidemiol 2012, Table 2 footnote g) is the percentage of the outcome information carried by both propensity scores that is carried by the gold-standard score alone, computed as a ratio of likelihood-ratio statistics against a treatment-only model; 100% is perfect surrogacy. The p-value from the same model tests an exact null, so in a validation sample of any size it rejects on departures far too small to matter — in our own simulation it returned p < 0.001 while S was 92.5% and calibration was still removing most of the bias. Anchors: Lunt's published scenarios gave 75-114% bias reduction at S of 88-99% and −132% to −189% at S of 6-14%; our simulation had calibration helping in 5/5 replicates at S ≥ 92% and hurting in 5/5 at S ≈ 82% (reproducible: scripts/psc-simulations.py in this tool's repository)."
            : "Neither S nor the p-value can be computed without outcomes in the validation dataset. This is precisely the cross-sectional-validation setting Lunt et al. (2012) address, and their conclusion is not to trust the point correction but to present PSC as a bias analysis over a plausible range for the unmeasured confounder's outcome association. Either obtain outcomes in the validation data, or take that route."]);
        out.push(["3. Failing the test is not a caveat — the correction reverses",
          "When surrogacy fails, calibration does not merely lose power; it moves the estimate the wrong way. Our simulation (linear outcome, so no non-collapsibility involved) gave a naive bias of +0.53 and a calibrated bias of −0.83 on the log scale at a moderate departure from proportionality; at a larger departure the naive estimate was nearly unbiased (+0.09) while calibration introduced −1.02. Stürmer's own 2007 simulation reports the same direction of failure: \"If surrogacy is violated, PSC can lead to an increase in bias.\" If S is low, report the naive estimate, report S, and follow the route under 'If surrogacy cannot be supported' rather than presenting a correction."]);
        if (m.nonCollapsible) {
          out.push(["4. Your effect measure is non-collapsible, so a residual gap remains even when surrogacy holds",
            "This protocol reports a " + m.measure + ". Wan identifies non-collapsibility of the odds and hazard ratio as an independent source of PSC bias: conditioning on a propensity score is not the same as conditioning on the covariates, and for a non-collapsible measure that changes the coefficient being estimated. So the calibrated " + m.measure + " is conditional on the gold-standard propensity score, not on baseline covariates — a subtly different estimand from the one the protocol otherwise describes. The gap shrinks as the outcome becomes rarer. In our simulation with proportional coefficients the calibrated log odds ratio still sat 0.13 below the truth, against a naive bias of +0.84. State the estimand you are reporting."]);
        } else {
          out.push(["4. Your effect measure is collapsible, which removes one of the two bias sources",
            "A risk difference is collapsible, so Wan's non-collapsibility bias does not apply. Residual confounding — the calibrated score not being a valid propensity score — still does, and is still governed by the proportionality condition above."]);
        }
        out.push(["5. What to report",
          "Report the naive claims-only estimate as the primary result and the calibrated estimate as a pre-specified sensitivity analysis, never the calibrated one alone. Report the surrogacy test with it. Report the calibration coefficients α₀, α₁, α₂ with standard errors and R² so the correction is reproducible and reusable. Give the calibrated estimate a bootstrap interval, not a closed-form one. If surrogacy is doubtful or untestable, Lunt et al. (Am J Epidemiol 2012;175(12):1294-1302, doi:10.1093/aje/kwr463) give a bias formula that lets you present PSC as a sensitivity analysis over a plausible range for the unmeasured confounder's outcome association rather than as a point correction."]);
        return out;
      };

      const pscRCode = (s, m) => {
        const rv = (a) => a.length ? a.map((x) => '  "' + String(x).replace(/["\\]/g, "") + '"').join(",\n") : '  # (none listed yet)';
        const link = s.pscScale === "logit" ? "link" : "response";
        const surv = m.ratio && (s.effectMeasure === "HR" || !s.effectMeasure);
        return [
          "## Propensity-score calibration — Stürmer et al., Am J Epidemiol 2005;162:279-89",
          "## Study      : " + (s.title || "(untitled)"),
          "## Main study : " + m.claimsDb + " (error-prone PS: claims covariates only)",
          "## Validation : " + m.valName + (m.valN ? ", n = " + m.valN : "") + " (" + m.valType + ")",
          "## PS scale   : " + m.scaleLabel + "   <- calibration and outcome models MUST agree",
          "",
          "library(survival)",
          "",
          "## Covariates the claims database records — these build BOTH scores.",
          "C <- c(",
          rv(m.claims),
          ")",
          "## Covariates only the validation dataset has — these are the unmeasured",
          "## confounding the claims study suffers, and the whole point of the exercise.",
          "U <- c(",
          rv(m.clinical),
          ")",
          "",
          'f <- function(y, v) as.formula(paste(y, "~", paste(sprintf("`%s`", v), collapse = " + ")))',
          '## Rename to your columns: treat = 1 for ' + (s.exposureName || s.picoI || "exposure") + ', 0 for ' + (s.comparatorName || s.picoC || "comparator") + '.',
          "",
          "## ── STEP 1 — validation dataset ────────────────────────────────────",
          "## 1a. The error-prone PS: EXACTLY the model the claims study will fit.",
          'ep_fit <- glm(f("treat", C),        data = val, family = binomial)',
          "## 1b. The gold-standard PS: the same covariates PLUS the clinical ones.",
          'gs_fit <- glm(f("treat", c(C, U)),  data = val, family = binomial)',
          'val$ps_ep <- predict(ep_fit, type = "' + link + '")',
          'val$ps_gs <- predict(gs_fit, type = "' + link + '")',
          "",
          "## 1c. THE CALIBRATION MODEL. Regress the gold-standard PS on the",
          "##     error-prone PS AND on treatment. Treatment belongs in this model:",
          "##     it is in the outcome model and is measured without error, so",
          "##     omitting it biases the correction.",
          "cal <- lm(ps_gs ~ ps_ep + treat, data = val)",
          'a0 <- coef(cal)[["(Intercept)"]]; a1 <- coef(cal)[["ps_ep"]]; a2 <- coef(cal)[["treat"]]',
          "c(a0 = a0, a1 = a1, a2 = a2, R2 = summary(cal)$r.squared)   # <- publish these",
          "",
          "## ── STEP 1d — MEASURE SURROGACY. DO THIS BEFORE TRUSTING ANYTHING ──",
          "## Surrogacy says PS_ep tells you nothing about the outcome once you know",
          "## treatment and PS_gs. It is measurable only because the validation data",
          "## have outcomes. Wan (Am J Epidemiol 2024;193:360-9) shows the assumption",
          "## holds only when the covariates' effects on the OUTCOME are proportional",
          "## to their effects on TREATMENT, so this is the practical check on that.",
          "##",
          "## S = of the outcome information carried by BOTH propensity scores, the",
          "## percentage carried by the gold-standard score alone. 100% = surrogacy.",
          "## Lunt et al., Am J Epidemiol 2012;175:1294-1302, Table 2 footnote (g).",
          "m0 <- " + (surv ? "coxph(Surv(time, event) ~ treat, data = val)" : "glm(event ~ treat, data = val, family = binomial)"),
          "m1 <- " + (surv ? "coxph(Surv(time, event) ~ treat + ps_gs, data = val)" : "glm(event ~ treat + ps_gs, data = val, family = binomial)"),
          "m2 <- " + (surv ? "coxph(Surv(time, event) ~ treat + ps_gs + ps_ep, data = val)" : "glm(event ~ treat + ps_gs + ps_ep, data = val, family = binomial)"),
          "ll <- function(m) if (inherits(m, \"coxph\")) m$loglik[length(m$loglik)] else as.numeric(logLik(m))",
          "S <- 100 * (ll(m1) - ll(m0)) / (ll(m2) - ll(m0))",
          "S                                            # <- publish this; enter it in Section 8b",
          'summary(m2)$coefficients["ps_ep", ]          # secondary: the coefficient and its p-value',
          "##",
          "## Reading S. Lunt's published scenarios: S of 88-99% gave 75-114% bias",
          "## reduction; S of 6-14% gave -132% to -189%, i.e. calibration roughly",
          "## doubled the error. Our own simulation: PSC helped at S >= 92% (5/5",
          "## replicates) and hurt at S ~ 82% (0/5). Judge on S, NOT on the p-value —",
          "## the p-value tests an exact null and rejects on departures too small to",
          "## matter (we saw p < 0.001 at S = 92.5%, where calibration still worked).",
          "## If S is low, do not report the calibrated estimate as a correction;",
          "## see 'If surrogacy cannot be supported' in the protocol section.",
          "",
          "## ── STEP 2 — claims study (this is all a later study needs to repeat) ─",
          'main$ps_ep <- predict(glm(f("treat", C), data = main, family = binomial), type = "' + link + '")',
          surv
            ? "naive <- coxph(Surv(time, event) ~ treat + ps_ep, data = main)"
            : (s.effectMeasure === "RD"
              ? "naive <- glm(event ~ treat + ps_ep, data = main, family = gaussian)"
              : "naive <- glm(event ~ treat + ps_ep + offset(log(pt)), data = main, family = poisson)"),
          "## NOTE: the PS must enter LINEARLY. Matching, decile stratification or",
          "## IPT weighting do not give the b_ps this correction needs.",
          'b_t <- coef(naive)[["treat"]]; b_ps <- coef(naive)[["ps_ep"]]',
          "",
          "## ── STEP 3 — the correction ───────────────────────────────────────",
          "b_corrected <- b_t - (a2 / a1) * b_ps",
          m.ratio
            ? "exp(c(naive = b_t, calibrated = b_corrected))    # " + m.measure
            : "c(naive = b_t, calibrated = b_corrected)         # risk difference",
          "",
          "## ── STEP 4 — the interval. Bootstrap; there is no usable closed form ─",
          "## The correction is a ratio of estimated coefficients from two models",
          "## fitted in two samples. A first-order delta method understates its",
          "## width — measured at SE 0.014 against an empirical SD of 0.024 in our",
          "## own simulation — so this tool deliberately reports no closed-form CI.",
          "## Run this, then paste the two bounds back into Section 8b.",
          "set.seed(20260808); B <- " + m.bootB,
          m.valType === "internal"
            ? [
              "## INTERNAL validation sample: the validation rows ARE main-study rows.",
              "## Resample the main study once per replicate and take the validation",
              "## rows from that same resample, otherwise the shared patients are",
              "## counted as two independent samples and the interval comes out too narrow.",
              "## `val_id` / `id` are the patient key linking the two frames.",
              "boot <- replicate(B, {",
              "  ids <- sample(main$id, nrow(main), replace = TRUE)",
              "  m <- main[match(ids, main$id), ]",
              "  v <- val[val$id %in% ids, ]",
            ].join("\n")
            : [
              "## EXTERNAL validation sample: the two datasets are independent, so",
              "## resampling them independently is correct.",
              "boot <- replicate(B, {",
              "  v <- val[sample(nrow(val),  replace = TRUE), ]",
              "  m <- main[sample(nrow(main), replace = TRUE), ]",
            ].join("\n"),
          '  v$ps_ep <- predict(glm(f("treat", C),       data = v, family = binomial), type = "' + link + '")',
          '  v$ps_gs <- predict(glm(f("treat", c(C, U)), data = v, family = binomial), type = "' + link + '")',
          "  cc <- coef(lm(ps_gs ~ ps_ep + treat, data = v))",
          '  m$ps_ep <- predict(glm(f("treat", C), data = m, family = binomial), type = "' + link + '")',
          "  bb <- coef(" + (surv ? "coxph(Surv(time, event) ~ treat + ps_ep, data = m)" : "glm(event ~ treat + ps_ep, data = m, family = binomial)") + ")",
          '  bb[["treat"]] - (cc[["treat"]] / cc[["ps_ep"]]) * bb[["ps_ep"]]',
          "})",
          "ci <- quantile(boot, c(0.025, 0.975)); ci        # log scale — paste these in",
          m.ratio ? "exp(ci)                                          # " + m.measure + " scale" : "",
          "",
          "## ── REUSE — a later claims-only study skips steps 1 and 4 ─────────",
          "## Take the published calibration coefficients and apply them:",
          "## a1 <- " + (m.a1 !== null ? pscFmt(m.a1, 4) : "<published>") + "; a2 <- " + (m.a2 !== null ? pscFmt(m.a2, 4) : "<published>"),
          "## b_corrected <- b_t - (a2 / a1) * b_ps",
          "## Valid only if that study's PS_ep uses the SAME covariates C, the same",
          "## PS scale, and a population in which the calibration model transports.",
        ].join("\n");
      };

      // Operational assumptions, over and above the validity gate above.
      const pscAssumptions = (m) => ([
        ["Transportability of the calibration coefficients",
          "α₁ and α₂ are estimated in " + m.valName + " and applied in " + m.claimsDb + ". This requires the relationship between the two propensity scores — and hence the joint distribution of the claims and clinical covariates given treatment — to be the same in both. An " + m.valType + " validation sample" + (m.valType === "internal" ? " makes this credible by construction, but the shared patients must be carried through the variance calculation." : " makes this an empirical claim: compare the distributions of the claims covariates and of PS_ep between the two datasets and report the comparison."),
        ],
        ["The PS must enter the outcome model linearly",
          "The correction is the inverse of a linear map between two coefficient vectors, so it applies to an outcome model of the form g(E[Y]) = β₀ + β_T·T + β_PS·PS_ep. PS matching, decile stratification and inverse-probability weighting do not produce a β_PS, and the algebra does not carry over to them. If the primary analysis uses one of those, fit this linear-adjustment model alongside it as the calibrated analysis and say so."],
        ["Same PS scale throughout, and the scale the original method uses",
          "The propensity score is treated as a probability and the calibration model is linear in it; that is the default here. Provenance, so you can check it: this follows the formal restatements of the method in Wan (2024) and in Lunt et al. (2012), whose equations use e(C) and ê(X) directly as probabilities with no logit or log transformation. It was NOT confirmed against the Methods section of Stürmer et al. (2005), which is paywalled — worth a two-minute check against the original via institutional access if you have it. This protocol uses " + m.scaleLabel + " in both the calibration model and the outcome model. α₁ and α₂ are not scale-free, so mixing PS in one model with logit(PS) in the other silently invalidates the correction."],
        ["Positivity and overlap",
          "Both propensity scores must have common support across treatment groups in both datasets. Report the overlap of PS_ep in the main study and of PS_ep and PS_gs in the validation dataset."],
        ["Variance",
          "α and β are estimated, so the corrected estimate carries the uncertainty of both. Bootstrap the entire two-stage procedure — resampling the validation and main data as their design requires — rather than reporting the naive standard error, which is always too small. No closed-form interval is offered here, deliberately: a first-order delta method measured SE 0.014 against an empirical SD of 0.024 in our own simulation, so it would understate the width by roughly a third."],
      ]);

      // Full citations for everything the section relies on, appended to the
      // protocol's reference list so the exported document stands alone.
      const PSC_REFERENCES = [
        "Stürmer T, Schneeweiss S, Avorn J, Glynn RJ. Adjusting effect estimates for unmeasured confounding with validation data using propensity score calibration. Am J Epidemiol 2005;162(3):279-289. doi:10.1093/aje/kwi192. (The method.)",
        "Stürmer T, Schneeweiss S, Rothman KJ, Avorn J, Glynn RJ. Performance of propensity score calibration — a simulation study. Am J Epidemiol 2007;165(10):1110-1118. doi:10.1093/aje/kwm074. (Bias reduction of 32-106% when surrogacy holds; an increase in bias when it does not; proposes testing surrogacy using outcomes in the validation data.)",
        "Lunt M, Glynn RJ, Rothman KJ, Avorn J, Stürmer T. Propensity score calibration in the absence of surrogacy. Am J Epidemiol 2012;175(12):1294-1302. doi:10.1093/aje/kwr463. PMID 22688682. (Source of the graded surrogacy measure S used above, Table 2 footnote g; and of a path-analytic bias formula, equation 9, that turns PSC into a sensitivity analysis over a plausible range for the unmeasured confounder's outcome association. The formula is derived for one measured and one unmeasured confounder, assumed independent and linearly related; see the Web Appendices for the estimation of its terms.)",
        "Wan F. A cautionary note on using propensity score calibration to control for unmeasured confounding bias when the surrogacy assumption is absent. Am J Epidemiol 2024;193(2):360-369. doi:10.1093/aje/kwad189. PMID 37759344. (PSC is generally biased unless confounder effects on outcome and treatment are proportional; identifies non-collapsibility and residual confounding as the two bias sources.)",
        "Rosner B, Spiegelman D, Willett WC. Correction of logistic regression relative risk estimates and confidence intervals for measurement error: the case of multiple covariates measured with error. Am J Epidemiol 1990;132(4):734-745. (The regression-calibration machinery PSC applies to the propensity score.)",
        "Figures in this section attributed to \"our own simulation\" are unpublished in-house simulations, not published results. The script that produces every one of them is scripts/psc-simulations.py in the source repository of this tool (github.com/danielhttsai/danielhttsai.github.io); it is seeded, so the numbers reproduce run to run. Cite it as such, or re-run it, rather than treating these figures as literature.",
      ];

      const pscCannotFix = [
        "Confounding by variables absent from BOTH datasets. Calibration transfers the information in the validation dataset's extra variables; it invents nothing. Anything neither database records stays unmeasured, and the corrected estimate is no more protected against it than the naive one.",
        "Measurement error in the clinical variables themselves. PS_gs is called gold-standard by convention; if the validation dataset's HbA1c or blood pressure is measured with error, or missing non-randomly, that error propagates into α₁ and α₂ unadjusted.",
        "Selection into the validation dataset. A hospital cohort is not a random sample of a national claims population; if selection depends on the clinical variables, α₁ and α₂ are estimated in the wrong population.",
        "Bias from post-baseline variables. Anything measured after treatment start belongs in neither propensity score. Excluding it is a design decision, not something calibration repairs.",
        "Immortal-time, prevalent-user and outcome-misclassification bias. These are design and measurement problems; calibration touches only confounding by the specific covariates the validation dataset adds.",
      ];

      // Shared result formatting: the naive estimate carries the interval from
      // its own fitted model; the calibrated estimate only ever carries the
      // bootstrap interval the researcher pasted back in.
      // The reuse claim is the most dangerous sentence in the section — it tells
      // a future study it may apply these coefficients without validation data
      // of its own. It is only true when surrogacy was actually established.
      const pscReuseText = (m) =>
        m.contradiction
          ? "These coefficients must NOT be reused: they are inconsistent with the variable split declared above, so it is not clear what analysis produced them."
          : m.releaseLevel === "ok"
            ? "A later " + m.claimsDb + "-only study of the same contrast can cite this protocol, fit PS_ep from the same covariate list C, and apply the correction directly — no validation data of its own required, provided surrogacy is as well supported in its population as it is here (S = " + pscFmt(m.surroS, 1) + "%) and the assumptions below still hold."
            : m.releaseLevel === "provisional"
              ? "These coefficients are NOT yet reusable. Surrogacy has not been established with S in this study, so a later claims-only study applying them would inherit an unexamined assumption. Compute S first, then this paragraph becomes a reuse licence."
              : "These coefficients must NOT be reused. " + PSC_SURRO_TEXT[m.surroVerdict][0] + " — the correction they encode is not supported in this study, so it cannot be lent to another.";

      const pscResultLines = (m) => {
        if (m.bT === null) return null;
        const show = (b) => m.ratio ? pscFmt(Math.exp(b), 3) : pscFmt(b, 4);
        const naive = m.measure + " " + show(m.bT) +
          (m.naiveLo !== null ? " (95% CI " + show(m.naiveLo) + " to " + show(m.naiveHi) + ")" : "");
        // The variable split contradicting the coefficients outranks everything
        // else: the number is not merely unsupported, it is not reproducible.
        if (m.contradiction) {
          return { naive, withheld: true,
            calibrated: "not shown — the variable split and the entered coefficients are inconsistent",
            note: m.contradiction };
        }
        if (m.bC === null) return { naive, withheld: true,
          calibrated: "not yet computed — enter α₁, α₂ and the naive coefficients",
          note: "The calibration coefficients from the validation analysis are needed before a calibrated estimate exists." };
        if (m.releaseLevel === "withheld") {
          return { naive, withheld: true,
            calibrated: "withheld — " + PSC_SURRO_TEXT[m.surroVerdict][0].replace(/ —.*$/, ""),
            note: "The calibrated estimate is deliberately not shown. " + PSC_SURRO_TEXT[m.surroVerdict][1] + " Showing the number here, under a panel saying it should not be reported as a correction, is how the method gets misapplied. Establish surrogacy with S and it will appear." };
        }
        const calibrated = (m.releaseLevel === "provisional" ? "PROVISIONAL — " : "") + m.measure + " " + show(m.bC) +
          (m.hasBoot ? " (95% bootstrap CI " + show(m.bootLo) + " to " + show(m.bootHi) + ", " + m.bootB + " replicates)" : "");
        const note = (m.releaseLevel === "provisional"
          ? "Marked provisional because surrogacy has not been established with S — compute it before this number leaves the protocol. "
          : "") + (m.hasBoot
          ? "The calibrated interval is the bootstrap percentile interval you supplied. Report the naive estimate as primary and this as a pre-specified sensitivity analysis."
          : "No interval is shown for the calibrated estimate on purpose: the correction is a ratio of estimated coefficients across two models in two samples, and no closed form is reliable. Run the bootstrap in the R code below and paste the bounds into Section 8b.");
        return { naive, calibrated, note, withheld: false };
      };

      const PSC_SURRO_TEXT = {
        "s-high": ["Surrogacy supported (S ≥ 90%) — calibration may proceed, as a sensitivity analysis",
          "Almost all of the outcome information carried by the two propensity scores is carried by the gold-standard score, which is what surrogacy asserts. Lunt's published scenarios at S of 88-99% achieved 75-114% bias reduction, and our own simulation found calibration helping in 5 of 5 replicates at S ≥ 92%. This supports the assumption; it does not prove it. Report S alongside the calibrated estimate, and still report the naive estimate as primary."],
        "s-mid": ["Partial surrogacy (50% ≤ S < 90%) — calibration is more likely to add bias than remove it",
          "A material share of the outcome information sits in the error-prone score rather than the gold-standard one. This is the region where our simulation turned: at S ≈ 82% calibration was worse than doing nothing in 5 of 5 replicates, with the naive bias at +0.41 and the calibrated bias at −0.72. Do not present the calibrated estimate as a correction. Report the naive estimate, report S, and treat calibration at most as a bounding exercise in the direction it moves."],
        "s-low": ["Surrogacy absent (S < 50%) — do not calibrate",
          "The error-prone score carries most of the outcome information, which is the opposite of what the method requires. Lunt's scenarios at S of 6-14% produced bias reduction of −132% to −189%: calibration roughly doubled the error. Report the naive estimate and report S as the reason calibration was not applied."],
        "p-rejected": ["The p-value rejects — but compute S before abandoning calibration",
          "A significant PS_ep coefficient means some departure from surrogacy, not necessarily one that matters. The p-value tests an exact null, so in a validation sample of any size it rejects on departures too small to affect the estimate: in our own simulation it returned p < 0.001 while S was 92.5% and calibration still removed most of the bias. Compute S and judge on that."],
        "p-ok": ["The p-value does not reject — now compute S, which is the better instrument",
          "Failing to reject is weak evidence, especially in a small validation sample where the test has little power. Compute the graded measure S from the same models and judge on its magnitude rather than on a significance verdict."],
        untested: ["Surrogacy NOT YET MEASURED — do this before using the correction",
          "Your validation dataset has outcomes, so the assumption is measurable. Fit outcome ~ treatment + PS_gs and outcome ~ treatment + PS_gs + PS_ep in the validation data, take the ratio of their likelihood-ratio statistics against the treatment-only model, and enter S in Section 8b. The R code below does it. Until then the calibrated estimate rests on an unexamined assumption that Wan (2024) argues is usually false."],
        untestable: ["Surrogacy UNMEASURABLE here — the weakest position to be in",
          "Without outcomes in the validation dataset neither S nor the p-value can be computed. This is exactly the cross-sectional-validation setting Lunt et al. (2012) address, and their answer is not to trust the point correction: present PSC as a bias analysis over a plausible range for the unmeasured confounder's outcome association instead. See 'If surrogacy cannot be supported' below."],
      };

      // What to do when the gate does not open. This is the constructive route
      // and it is deliberately bounded by what could be read: Lunt's bias
      // equation is quoted, but this tool does not compute it — see the note.
      const pscNoSurrogacyRoute = (m) => ([
        ["Report the naive estimate as the result, and say why",
          "A claims-only estimate with its confounding honestly described is a publishable result. A calibrated estimate whose validity condition failed is not. State the covariates the claims database could not see, and report S (or that it could not be computed) as the reason calibration was not applied."],
        ["Bound the direction, not the magnitude",
          "Lunt et al. show the scenarios in which PSC worked shared one feature: the observed confounders X and the unobserved confounder C bias the exposure-outcome association in the SAME direction. Where your clinical variables plausibly push the estimate the same way as the claims variables already do, the naive estimate is likely conservative in a known direction. Where they push the other way, calibration is precisely what fails. That directional statement is defensible from the validation data alone."],
        ["Use PSC as a bias analysis over a range, not as a point correction",
          "Lunt et al. derive a formula (their equation 9) that predicts the PSC bias from parameters estimable in the main and validation studies plus one unidentifiable parameter — IRR_CY, the association of the unmeasured confounder with the outcome. Their recommendation is to substitute a plausible range for that parameter, or sample from a prior for it, and present an uncertainty interval rather than a single corrected number. In their simulations the formula predicted the observed bias almost exactly (correlation 0.998 across 24 scenarios)."],
        ["Why this tool does not compute that formula for you",
          "The bias term is r(λ2_PEP)·{r(λ3_PEP)·β3 − (β4 + λ5T·β3)/λ1T}. Two of its pieces map onto numbers you already have — from Lunt's equation 8, the calibration model's treatment coefficient IS r(λ2_PEP), i.e. α₂, and its PS_ep coefficient is r(λ4T)·λ1T, i.e. α₁ — so the entire bias is proportional to α₂, and a large α₂ means both a large correction and a large possible error in it. But the regressions that identify r(λ3_PEP), β4, λ1T and λ5T are specified in the paper's Web Appendices, which are paywalled and served behind a bot challenge; they could not be read, and implementing them from the main text alone would be guesswork. Get the paper and follow it directly."],
        ["And note what the formula assumes even then",
          "Lunt et al. derive it for the simplest possible setting — one measured confounder and one unmeasured confounder, assumed independent, with linear (path-analytic) associations throughout and a Poisson outcome model. They call this the major limitation of the work. A protocol with " + m.claims.length + " claims covariates and " + m.clinical.length + " clinical ones is a long way from that setting, so treat any number it produces as an order-of-magnitude bias analysis, not a correction."],
        ["Alternatives that do not need surrogacy at all",
          "Wan (2024) points to two: rigorous pre-design identification of the confounders with a conventional propensity-score analysis plus sensitivity analysis, and instrumental-variable methods. Lunt et al. add maximum likelihood or multiple imputation with the unidentified parameters fixed at a range of values, and Bayesian analysis with priors on them. An E-value on the naive estimate is the cheapest honest statement of how strong unmeasured confounding would have to be to explain the finding."],
      ]);
      // Full literal class strings — Tailwind scans source text, so a class
      // name assembled at runtime ("border-" + colour + "-300") is never
      // generated and the box would render unstyled.
      const PSC_ROSE  = { box: "rounded-xl border border-rose-300 bg-rose-50 p-4",       head: "text-xs uppercase tracking-widest font-bold text-rose-800" };
      const PSC_AMBER = { box: "rounded-xl border border-amber-300 bg-amber-50 p-4",     head: "text-xs uppercase tracking-widest font-bold text-amber-800" };
      const PSC_GREEN = { box: "rounded-xl border border-emerald-300 bg-emerald-50 p-4", head: "text-xs uppercase tracking-widest font-bold text-emerald-800" };
      const PSC_SURRO_CLS = {
        "s-low": PSC_ROSE, untestable: PSC_ROSE,
        "s-mid": PSC_AMBER, untested: PSC_AMBER, "p-rejected": PSC_AMBER, "p-ok": PSC_AMBER,
        "s-high": PSC_GREEN,
      };
      // The constructive route is shown whenever the gate does not clearly open.
      const pscNeedsRoute = (v) => v === "s-low" || v === "s-mid" || v === "untestable" || v === "p-rejected";

      // ── On-screen card + the classification grid ──────────────────────
      let pscVarsSig = "";
      const PSC_CHIP = { claims: "bg-emerald-100 text-emerald-800 border-emerald-300", clinical: "bg-amber-100 text-amber-800 border-amber-300", exclude: "bg-slate-100 text-slate-500 border-slate-300" };
      const PSC_STRENGTH = { strong: "bg-rose-100 text-rose-800", moderate: "bg-amber-100 text-amber-800", weak: "bg-slate-100 text-slate-600", none: "bg-slate-100 text-slate-400" };
      const renderPscVars = (s) => {
        const host = document.querySelector("[data-psc-vars]");
        if (!host) return;
        const cands = pscCandidates(s);
        const sig = cands.map((n) => n + ":" + pscClassOf(n) + ":" + (pscAi[n] ? pscAi[n].confounding + pscAi[n].source : "")).join("|");
        // Where the AI overruled the keyword rule is the most informative thing
        // on this panel — those are the rows the rule would have got wrong.
        if (sig === pscVarsSig) return;
        pscVarsSig = sig;
        if (!cands.length) {
          host.innerHTML = '<p class="text-[11px] text-slate-500 italic">Tick some baseline covariates in Section 8, or list validation-only variables below, and they will appear here.</p>';
          return;
        }
        host.innerHTML = cands.map((n) => {
          const cls = pscClassOf(n);
          const ai = pscAi[n];
          const changed = ai && cls !== pscHeuristic(n);
          const badge = ai
            ? '<span class="ml-1 text-[9px] uppercase tracking-wider font-bold px-1.5 py-0.5 rounded ' + (PSC_STRENGTH[ai.confounding] || "bg-slate-100 text-slate-500") + '">' + pscEsc(ai.confounding) + '</span>'
              + (ai.role && ai.role !== "baseline" ? '<span class="ml-1 text-[9px] uppercase tracking-wider font-bold px-1.5 py-0.5 rounded bg-violet-100 text-violet-800">' + pscEsc(ai.role) + '</span>' : "")
              + (changed ? '<span class="ml-1 text-[9px] uppercase tracking-wider font-bold px-1.5 py-0.5 rounded bg-sky-100 text-sky-800" title="The AI overruled the keyword rule here">AI changed · rule said ' + pscEsc(pscHeuristic(n)) + "</span>" : "")
            : "";
          const btn = (val, label) =>
            '<button type="button" data-psc-set="' + pscEsc(val) + '" data-psc-var="' + pscEsc(n) + '" class="text-[10px] font-semibold px-2 py-0.5 rounded border transition ' +
            (cls === val ? PSC_CHIP[val] : "bg-white text-slate-500 border-slate-200 hover:border-slate-400") + '">' + label + "</button>";
          return '<div class="flex items-center gap-2 text-xs bg-white border border-slate-200 rounded px-2 py-1" title="' + pscEsc(ai ? ai.reason : "") + '">' +
            '<span class="flex-1 min-w-0 truncate">' + pscEsc(n) + badge + "</span>" +
            '<span class="flex gap-1 shrink-0">' + btn("claims", "Claims") + btn("clinical", "Clinical-only") + btn("exclude", "Exclude") + "</span></div>";
        }).join("");
      };

      const renderPscCard = (s) => {
        const card = document.querySelector("[data-psc-card]");
        const out  = document.querySelector("[data-psc-out]");
        const rpre = document.querySelector("[data-psc-r]");
        if (!card || !out || !rpre) return;
        if (s.pscEnable !== "yes") { card.classList.add("hidden"); return; }
        card.classList.remove("hidden");
        const m = pscModel(s);
        const eq = (m.a1 !== null && m.a2 !== null && m.a0 !== null)
          ? "PS_gs = " + pscFmt(m.a0, 4) + " " + pscSigned(m.a1, 4) + " × PS_ep " + pscSigned(m.a2, 4) + " × T"
          : "PS_gs = α₀ + α₁ × PS_ep + α₂ × T";
        const corr = (m.k !== null)
          ? "β_T(calibrated) = β_T(naive) − (" + pscFmt(m.a2, 4) + " / " + pscFmt(m.a1, 4) + ") × β_PS(naive) = β_T(naive) − " + pscFmt(m.k, 4) + " × β_PS(naive)"
          : "β_T(calibrated) = β_T(naive) − (α₂ / α₁) × β_PS(naive)";
        const r = pscResultLines(m);
        const result = r
          ? '<div class="' + (r.withheld ? "rounded-xl border border-rose-300 bg-rose-50 p-4" : "rounded-xl border border-brand-200 bg-brand-50/60 p-4") + '">' +
            '<p class="text-xs uppercase tracking-widest font-bold ' + (r.withheld ? "text-rose-800" : "text-brand-700") + '">Estimates</p>' +
            '<p class="mt-1 text-sm text-slate-800">Naive (claims only) — <em>report this as primary</em>: <strong>' + pscEsc(r.naive) + "</strong></p>" +
            '<p class="text-sm text-slate-800">Calibrated — <em>sensitivity analysis</em>: <strong>' + pscEsc(r.calibrated) + "</strong></p>" +
            '<p class="mt-1 text-[11px] text-slate-600">' + pscEsc(r.note) + "</p></div>"
          : "";

        // The validity gate goes ABOVE the numbers, because the numbers are
        // meaningless if the gate fails.
        const sv = PSC_SURRO_TEXT[m.surroVerdict];
        const svc = PSC_SURRO_CLS[m.surroVerdict];
        const surroBox =
