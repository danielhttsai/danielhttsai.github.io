            const yrs = day / 365;
            if (form.elements.maxFollowupChoice) form.elements.maxFollowupChoice.value = "custom";
            if (form.elements.maxFollowupCustom) form.elements.maxFollowupCustom.value = (yrs >= 1 ? (Math.round(yrs * 10) / 10) + " years" : Math.max(1, Math.round(day)) + " days");
            render(); return;
          }
          const el = form.elements[field]; if (!el) return;
          el.value = Math.round(Math.max(0, -day));
          render();
        };
        // Belt and braces: nothing degenerate reaches the figure or any export
        // path built from it. A window whose start equals its end is not a
        // window, and drawing one states a methodological fact — a zero-day
        // baseline period — that no user ever asked for.
        const drawn = wins.filter((w) => w.endDay > w.startDay);
        window.renderDesignDiagram(document.getElementById("diagram"), document.getElementById("dlegend"), { windows: drawn, indexLabel: "Index (day 0) — treatment start", onEdit: onEdit, snap: 5 });
      };

      const computeChecks = (s) => {
        const checks = [];
        // First, above everything: a value the page could not honour is the one
        // finding that invalidates every other line in this panel, because the
        // panel is reading a form that no longer says what the draft said.
        staleSelects.forEach((x) => checks.push({ level: "error", msg: staleMsg(x, staleSelects.length > 1) }));
        const washR = readDays(s.washout), lbR = readDays(s.lookback), graceR = readDays(s.grace);
        const wash = washR.days || 0, lb = lbR.days || 0, grace = graceR.days || 0;
        // Name the window the protocol is declining to state, and why. A
        // refusal nobody can see on screen is just a slower silent default.
        [["Washout", washR], ["Covariate look-back", lbR], ["Grace period", graceR]].forEach(function (pair) {
          const label = pair[0], r = pair[1];
          if (r.ok) return;
          if (r.empty) checks.push({ level: "warn", msg: label + " is blank, so the protocol prints “(not specified)” rather than filling in a default. Type the number of days you mean." });
          else checks.push({ level: "warn", msg: label + ": “" + r.raw + "” could not be read as a number of days, so the protocol, the figure and this panel all decline to state one. Write digits — 365, or 365 days; not “1e3”, “1,000” or “about a year”." });
        });
        if (washR.ok && wash <= 0) checks.push({ level: "warn", msg: "Washout is 0 — prevalent (non-new) users may be included. A new-user design needs a washout window with no prior exposure or comparator." });
        else if (washR.ok && wash < 180) checks.push({ level: "info", msg: "Washout < 180 days — consider a longer washout to be confident users are truly new." });
        if (lbR.ok && lb <= 0) checks.push({ level: "warn", msg: "No covariate look-back — baseline confounders are unmeasured. Set a look-back window before index." });
        const cwp = covWindowPlan(s);
        if (cwp.notes.length) checks.push({ level: "info", msg: cwp.notes.length + " line(s) in the per-covariate look-back box carry no readable “| days” — " + cwp.notes.slice(0, 3).map((r) => "“" + r.name.slice(0, 48) + (r.name.length > 48 ? "…" : "") + "”").join(", ") + ". They are treated as notes, not windows, so the diagram shows " + (cwp.mode === "rows" ? "only the " + cwp.usable.length + " window(s) it could read" : "the shared look-back of " + daysText(s.lookback) + " instead") + ". To make one a window, write it as “Name | 365”." });
        const fuChk = resolveFollowupDays(s);
        if (!fuChk.known) checks.push({ level: "warn", msg: "The maximum follow-up could not be read as a duration, so the study-design diagram is drawing a 5-year default. The protocol text still says what you typed, so the words and the picture disagree — write a duration the diagram can read, e.g. “18 months”, “90 days”, “2 years”." });
        if (graceR.ok && grace <= 0) checks.push({ level: "info", msg: "Grace period 0 — the on-treatment analysis will censor at the first dispensing gap." });
        if (!s.exposureName || !s.comparatorName) checks.push({ level: "info", msg: "Specify the exposure and the active comparator." });
        if (!s.picoO && !s.outcomeDef) checks.push({ level: "info", msg: "Specify the outcome." });
        const pa = s.primaryAnalysisType;
        if (pa === "ITT" || pa === "both") checks.push({ level: "info", msg: "ITT (as-assigned): the treatment strategy is fixed at the index date — later switching or add-on therapy is ignored (no deviation censoring)." });
        if (pa === "OT" || pa === "both") checks.push({ level: "info", msg: "On-treatment (per-protocol): follow-up is censored at deviation (discontinuation/switch), so this informative censoring should be adjusted with IPCW." });
        if (pa === "landmark") checks.push({ level: "warn", msg: "Landmark analysis is conditional on patients who survive event-free to the landmark time — it estimates a conditional effect and drops early events; state the landmark time and interpret accordingly." });
        // An "ITT" analysis that censors at deviation is a per-protocol analysis
        // under the wrong name, and it is one click from the defaults: the first
        // two censoring rules ship ticked. The panel already tells the user ITT
        // ignores switching while the document beside it instructs the site to
        // censor on exactly that.
        if (pa === "ITT") {
          const deviation = mergeList(s.censoringPick, s.censoringCustom)
            .filter((l) => /discontinu|switch|add-on|non-adheren|deviat/i.test(l));
          if (deviation.length) checks.push({ level: "warn", msg: "The primary analysis is ITT (as-assigned), but the censoring rules include " + deviation.map((l) => "“" + l + "”").join(", ") + ". An ITT analysis does not censor at deviation — censoring there makes it a per-protocol analysis under an ITT label, and puts back the selection bias the as-assigned contrast is chosen to avoid. Untick those rules, or set the primary analysis to on-treatment or both. The grace period the protocol prints applies to the on-treatment analysis only." });
        }
        // This was pushed on every render, so nothing could falsify it. It sat
        // directly under the panel's own "Washout is 0 — prevalent (non-new)
        // users may be included" and certified that follow-up began at
        // treatment initiation, on a form nobody had touched; and it stayed
        // green under a landmark analysis, which creates immortal time by
        // construction. A check that cannot come out false is not a check.
        if (pa === "landmark") {
          checks.push({ level: "warn", msg: "Follow-up does not start at time zero under a landmark analysis: patients who die or have the event before the landmark are excluded, so the interval between the index date and the landmark is immortal time by construction. Say how you handle it." });
        } else if (!washR.ok || wash <= 0) {
          checks.push({ level: "warn", msg: "Time zero cannot be certified while the washout is 0 or unreadable — a cohort that may contain prevalent users is one whose follow-up does not start at treatment initiation. Set a washout and this check can pass." });
        } else {
          checks.push({ level: "ok", msg: "Eligibility, treatment assignment, and follow-up start are aligned at the index date (time zero) — this is what avoids immortal-time bias. A post-index eligibility criterion (for example “≥2 dispensings within 90 days”) would reintroduce it; this check reads the windows, not your custom criteria." });
        }
        if (s.pscEnable === "yes") {
          const m = pscModel(s);
          if (m.clinical.length === 0) checks.push({ level: "warn", msg: "PS calibration is switched on but no covariate is marked clinical-only — the gold-standard and error-prone scores would be identical and the correction would be a no-op. Mark the variables the claims database cannot see." });
          if (m.claims.length === 0) checks.push({ level: "warn", msg: "PS calibration is switched on but no covariate is marked claims-available — there is no error-prone propensity score to calibrate." });
          if (!(s.pscValName || "").trim()) checks.push({ level: "info", msg: "Name the validation dataset that holds both the claims and the clinical variables (Section 8b)." });
          if (m.surroSBad) checks.push({ level: "warn", msg: "Surrogacy S was entered as " + pscFmt(m.surroSRaw, 1) + "%, which S cannot be: it is the percentage of the outcome information carried by both propensity scores that the gold-standard score carries alone, so it lies between 0 and 100. This value is being ignored rather than read as strong surrogacy, so no calibrated estimate is released on the strength of it. Re-run the S block in the R code and enter the number it prints — if you meant a proportion such as 0.93, enter 93." });
          // Wan F, Am J Epidemiol 2024;193(2):360-9 — the two bias sources.
          if (m.surroVerdict === "s-low") checks.push({ level: "warn", msg: "Surrogacy is absent (S = " + pscFmt(m.surroS, 1) + "%): the error-prone PS carries most of the outcome information. Lunt's scenarios at this level produced bias reduction of −132% to −189% — calibration roughly doubled the error. Report the naive estimate and report S as the reason calibration was not applied." });
          if (m.surroVerdict === "s-mid") checks.push({ level: "warn", msg: "Partial surrogacy (S = " + pscFmt(m.surroS, 1) + "%). This is the region where our simulation turned: at S ≈ 82% calibration was worse than doing nothing in 5 of 5 replicates. Do not present the calibrated estimate as a correction — see 'If surrogacy cannot be supported' in Section 7b of the export." });
          if (m.surroVerdict === "p-rejected") checks.push({ level: "info", msg: "The surrogacy p-value rejects, but that alone is not a reason to abandon calibration: the p-value tests an exact null and rejects on departures too small to matter. Compute S (the R code does it) and judge on its magnitude — we observed p < 0.001 at S = 92.5%, where calibration still removed most of the bias." });
          if (m.surroVerdict === "p-ok") checks.push({ level: "info", msg: "The surrogacy p-value does not reject, which is weak evidence. Compute S from the same models and judge on its magnitude." });
          if (m.surroVerdict === "untested") checks.push({ level: "warn", msg: "Surrogacy has not been measured. Your validation data have outcomes, so compute S — of the outcome information carried by both propensity scores, the percentage carried by the gold-standard score alone (Lunt 2012) — and enter it in Section 8b. Wan (2024) shows PS calibration is generally biased unless surrogacy holds." });
          if (m.surroVerdict === "untestable") checks.push({ level: "warn", msg: "Surrogacy cannot be measured because the validation dataset has no outcomes. This is the cross-sectional-validation setting Lunt et al. (2012) address, and their answer is to present PS calibration as a bias analysis over a range for the unmeasured confounder's outcome association rather than as a point correction." });
          if (!m.em) checks.push({ level: "warn", msg: "PS calibration is enabled but no effect measure has been chosen, so this panel cannot say whether Wan's non-collapsibility bias applies to you — it applies to the hazard ratio and not to the risk ratio, the incidence rate ratio or the risk difference. The generated R also has to assume an outcome model. Set the “Effect estimate” field and both will follow it." });
          else if (m.nonCollapsible) checks.push({ level: "info", msg: "You are reporting a " + m.measure + ", which is non-collapsible. Wan (2024) identifies this as an independent source of PS-calibration bias: the calibrated estimate is conditional on the gold-standard propensity score, not on baseline covariates, so it is a slightly different estimand. The gap narrows as the outcome becomes rarer — state which estimand you report." });
          if (pscImport && pscImport.ageDays !== null && pscImport.ageDays !== undefined && pscImport.ageDays > 30) checks.push({ level: "info", msg: "The imported calibration handoff was generated " + pscImport.ageDays + " days ago. If the covariate list has moved since, α₁ and α₂ no longer belong to it — re-export from RWE Studio and import again." });
          if (pscImport && !pscImport.varsApplied) checks.push({ level: "info", msg: "The calibration coefficients were imported but the covariate split was not taken from the handoff. The method assumes PS_ep uses the same C the coefficients were fitted from — confirm the two agree." });
          if (!Object.keys(pscAi).length && (m.claims.length + m.clinical.length) > 0) checks.push({ level: "info", msg: "The claims/clinical split is still the keyword rule's guess. It reads names only, so it cannot distinguish a measurement from a billing code and it misses unfamiliar instruments — run 'Let AI classify' in Section 8b and check the rows it changes. A clinical variable left in the claims list collapses the correction toward zero, which reads as 'no unmeasured confounding'." });
          if (m.contradiction) checks.push({ level: "warn", msg: "The variable split and the entered calibration coefficients are inconsistent, so the calibrated estimate is not shown. " + m.contradiction });
          if (m.releaseLevel === "withheld" && m.bC !== null) checks.push({ level: "warn", msg: "A calibrated estimate is computable from the coefficients you entered but is deliberately withheld from the protocol, because surrogacy is not supported. Establish surrogacy with S and it will be released." });
          if (m.bC !== null && !m.hasBoot && m.releaseLevel !== "withheld") checks.push({ level: "info", msg: "The calibrated estimate has no interval. There is no reliable closed-form CI for a ratio of coefficients estimated across two samples — run the bootstrap in the generated R code and paste the percentile bounds into Section 8b." });
          if (m.a1 !== null && Math.abs(m.a1) < 0.05) checks.push({ level: "warn", msg: "α₁ is close to zero, so the correction factor α₂/α₁ explodes and the calibrated estimate is unstable. A near-zero α₁ means the error-prone PS carries almost no information about the gold-standard PS — calibration is not trustworthy here." });
          if (m.a1 !== null && m.a1 < 0) checks.push({ level: "warn", msg: "α₁ is negative — the error-prone PS moves opposite to the gold-standard PS. Check the two PS models use the same treatment coding and the same scale before applying the correction." });
          if (/match|strat|iptw|overlap|weight/i.test(String(s.psMethod || ""))) checks.push({ level: "info", msg: "Your primary confounding-control method is matching/stratification/weighting, which produces no β_PS coefficient. PS calibration needs an outcome model that adjusts for the PS as a linear term — fit that model alongside the primary one as the calibrated analysis." });
        }
        return checks;
      };

      // Re-picking the option a <select> is already showing fires no `change`
      // event, so a user who is content with the value it was left at has no
      // way to answer a blocker that names it. Give them one.
      const mountKeepButton = () => {
        const host = document.getElementById("checks");
        if (!host || !staleSelects.length) return;
        const b = document.createElement("button");
        b.type = "button";
        b.className = "mt-2 rounded-lg border border-brand-700 px-3 py-1 text-xs font-semibold text-brand-700 hover:bg-brand-50";
        b.textContent = staleSelects.length === 1
          ? "Keep “" + clipTxt(shownText(staleSelects[0].name) || staleSelects[0].used, 40) + "”"
          : "Keep all " + staleSelects.length + " substituted choices";
        b.addEventListener("click", () => { staleSelects = []; render(); });
        host.appendChild(b);
      };

      // Retire by VALUE, not by event. Listening for `change` missed every
      // control this page writes to itself: the "📚 Pick from library" button
      // beside the confounding-control method does `el.value = …; render()`,
      // and dragging the follow-up handle on the diagram sets maxFollowupChoice
      // to "custom" — neither fires `change`. So the red line survived, and
      // then described the option the user had just picked with the page's own
      // picker as "a specification nobody chose". Anything that moves the
      // select off the value it was left at is an answer, however it moved.
      const retireAnswered = () => {
        if (!staleSelects.length) return;
        staleSelects = staleSelects.filter((x) => {
          const el = form.elements[x.name];
          return !el || !el.options || el.value === x.used;
        });
      };

      const render = () => {
        retireAnswered();
        const state = readForm();
        preview.textContent = buildMarkdown(state);
        renderFeasibility(state);
        try { renderScheme(state); } catch (e) { console.error(e); }
        try { window.renderChecks(document.getElementById("checks"), computeChecks(state)); mountKeepButton(); } catch (e) { console.error(e); }
        renderPscVars(state);
        renderPscCard(state);
        // The report of what was dropped rides in the draft under a reserved
        // key. Without this the warning is destroyed by the render that raised
        // it: readForm() omits the dead value, this line writes the substituted
        // state back, and one reload later nothing on the page or in the draft
        // remembers that a choice was ever overridden.
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(
            staleSelects.length ? Object.assign({}, state, { [STALE_KEY]: staleSelects }) : state));
        } catch {}
      };

      // ── Restore saved state, then render ────────────
      try { PC.restore(form, STORAGE_KEY, writeForm); } catch {}
      // Always pre-fill a default timeline so the section isn't empty
      const timelineTa = form.querySelector('[name="timeline"]');
      if (timelineTa && !timelineTa.value) timelineTa.value = TIMELINE_PRESETS["12-month"];
      // HARPER item 3. Mounted after the restore paths have written the field,
      // and OUTSIDE their catch, so a throw in the restore cannot remove the
      // panel with nothing on screen to say it is gone.
      if (window.PC && PC.mountAmendments) PC.mountAmendments(form);
      render();

      form.addEventListener("input", render);
      form.addEventListener("change", render);

      // Timeline preset buttons + numeric chip presets
      form.addEventListener("click", (e) => {
        const tl = e.target?.closest?.("[data-timeline-preset]");
        if (tl) {
          const ta = form.querySelector('[name="timeline"]');
          if (ta) { ta.value = TIMELINE_PRESETS[tl.dataset.timelinePreset] || ta.value; render(); }
          return;
        }
        const addRow = e.target?.closest?.("[data-add-row]");
        if (addRow) {
          const el = form.elements[addRow.dataset.target], name = addRow.dataset.name;
          if (el) {
            const rows = parseRows(el.value);
            if (!rows.some((r) => r.name === name)) {
              // Seed the new row from the shared look-back, but read it the same
              // way every other day count is read. `parseInt(v) || 365` turned a
              // deliberate 0 into 365 and "1e3" into 1; an unreadable value is
              // now carried through as typed so the row is flagged rather than
              // silently given a number nobody chose.
              const shared = String((form.elements.lookback && form.elements.lookback.value) || "").trim();
              const ok = DAYS_RE.test(shared);
              rows.push(ok
                ? { name: name, days: parseInt(shared, 10), bad: false, raw: shared }
                : { name: name, days: 0, bad: true, raw: shared || "(no shared look-back set)" });
              el.value = rowsJoin(rows);
              render();
            }
          }
          return;
        }
        const chip = e.target?.closest?.("[data-set-input]");
        if (chip) {
          const target = form.querySelector(`[name="${chip.dataset.setInput}"]`);
          if (target) { target.value = chip.dataset.value; render(); }
          return;
        }
        const pscChip = e.target?.closest?.("[data-psc-set]");
        if (pscChip) {
          pscClass[pscChip.dataset.pscVar] = pscChip.dataset.pscSet;
          savePscClass(); render();
          return;
        }
        const pscBulk = e.target?.closest?.("[data-psc-bulk]");
        if (pscBulk) {
          const mode = pscBulk.dataset.pscBulk;
          if (mode === "reset") { pscClass = {}; pscAi = {}; }
          // "All claims"/"All clinical" must not sweep identifiers, outcomes and
          // post-baseline measurements back into a propensity score — those are
          // never a C-vs-U question, and the AI's judgement on them stands.
          else pscCandidates(readForm()).forEach((n) => {
            if (pscAi[n] && pscAi[n].role && pscAi[n].role !== "baseline") return;
            if (!pscAi[n] && pscHeuristic(n) === "exclude") return;
            pscClass[n] = mode;
          });
          savePscClass(); render();
          return;
        }
      });

      // ── Calibration handoff from RWE Studio ──────────────────────────────
      // Schema: scratchpad/BRIDGE_NOTE.md, kind "rwe-studio/psc-handoff" v1.
      // Metadata and model output only. The importer's job is to be suspicious:
      // refuse anything row-shaped, refuse a PS-scale mismatch rather than
      // coerce it, never overwrite the variable split without being asked, and
      // never quietly accept the claims-study coefficients it must not have.
      const PSC_ROWKEYS = /^(rows|records|data|patients|observations|individuals|subjects|cells|values|raw|dataset_rows)$/i;
      // Walk the payload and refuse anything that looks like patient data. The
      // handoff is a fixed, shallow shape; an array of objects in it means the
      // sending side changed into something this page must not accept.
      const pscScanRows = (o, path) => {
        path = path || "$";
        if (o === null || typeof o !== "object") return null;
        if (Array.isArray(o)) {
          if (o.length > 1000) return path + " has " + o.length + " elements";
          for (let i = 0; i < o.length; i++) {
            const v = o[i];
            if (v !== null && typeof v === "object") return path + "[" + i + "] is a nested record";
          }
          return null;
        }
        for (const k of Object.keys(o)) {
          if (PSC_ROWKEYS.test(k) && o[k] !== null && typeof o[k] === "object") return path + "." + k + " looks like a table";
          const hit = pscScanRows(o[k], path + "." + k);
          if (hit) return hit;
        }
        return null;
      };

      const pscNumOrNull = (v) => (typeof v === "number" && isFinite(v)) ? v : null;
      const pscStrList = (v) => Array.isArray(v) ? v.filter((x) => typeof x === "string").map((x) => x.trim()).filter(Boolean) : null;
      const pscDiff = (a, b) => { const B = new Set(b); return a.filter((x) => !B.has(x)); };

      // Parse + validate. Returns { ok, error } or { ok:true, plan } where plan
      // lists exactly what would be written, so the user sees it before and
      // after. Nothing is applied here.
      const pscParseHandoff = (text, s) => {
        let raw = String(text || "").trim();
        if (!raw) return { error: "Nothing to import — choose a file or paste the JSON first." };
        if (raw.length > 262144) return { error: "That file is " + Math.round(raw.length / 1024) + " KB. A calibration handoff is a few kilobytes of coefficients; a file this large is not one, and is not being parsed." };
        let j; try { j = JSON.parse(raw); } catch (e) { return { error: "That is not valid JSON (" + (e && e.message ? e.message : e) + ")." }; }
        if (!j || typeof j !== "object" || Array.isArray(j)) return { error: "The handoff must be a JSON object." };
        if (j.kind && String(j.kind) !== "rwe-studio/psc-handoff") return { error: "This file says it is “" + String(j.kind).slice(0, 60) + "”, not a calibration handoff (kind: \"rwe-studio/psc-handoff\")." };
        const rowHit = pscScanRows(j);
        if (rowHit) return { error: "Refused: the payload contains what looks like patient data (" + rowHit + "). A calibration handoff carries coefficients and variable NAMES only — never rows or cell values. Nothing was imported." };

        const cal = j.calibration || {}, sur = j.surrogacy || {}, ds = j.dataset || {}, bs = j.bootstrap || {};
        const warn = [], fills = [], gaps = [];

        // PS scale: refuse, never coerce. Getting this wrong is silent and large.
        const hs = j.psScale === "logit" ? "logit" : j.psScale === "ps" ? "ps" : null;
        const cur = s.pscScale === "logit" ? "logit" : "ps";
        const lbl = (x) => x === "logit" ? "logit(PS)" : "PS (probability scale)";
        if (hs && hs !== cur) {
          return { error: "Refused: scale mismatch. The handoff was fitted on " + lbl(hs) + "; this protocol is set to " + lbl(cur) +
            ". α₁ and α₂ are not scale-free, so importing them across scales would be a silent and large error. Set “PS scale” in Section 8b to " + lbl(hs) +
            " and import again, or refit the calibration on " + lbl(cur) + ". Nothing was imported." };
        }
        if (!hs) warn.push("The handoff does not state its PS scale, so it is assumed to match this protocol (" + lbl(cur) + "). Confirm that against whatever produced it.");

        const put = (field, value, label, src) => { if (value === null || value === undefined) return; fills.push({ field: field, value: value, label: label, src: src }); };
        put("pscA0", pscNumOrNull(cal.a0), "α₀ intercept", "calibration.a0");
        put("pscA1", pscNumOrNull(cal.a1), "α₁ on PS_ep", "calibration.a1");
        put("pscA1se", pscNumOrNull(cal.a1se), "SE(α₁)", "calibration.a1se");
        put("pscA2", pscNumOrNull(cal.a2), "α₂ on treatment", "calibration.a2");
        put("pscA2se", pscNumOrNull(cal.a2se), "SE(α₂)", "calibration.a2se");
        put("pscR2", pscNumOrNull(cal.r2), "Calibration R²", "calibration.r2");
        put("pscSurroCoef", pscNumOrNull(sur.coef), "Surrogacy: coefficient on PS_ep", "surrogacy.coef");
        put("pscSurroP", pscNumOrNull(sur.p), "Surrogacy: p-value", "surrogacy.p");
        // S is the instrument this page judges on, and it is NOT in the v1
        // schema. Accept the obvious spellings; if none is present, say so
        // loudly, because a p-value alone leaves the verdict at "compute S".
        const S = pscNumOrNull(sur.S) !== null ? pscNumOrNull(sur.S)
          : pscNumOrNull(sur.s) !== null ? pscNumOrNull(sur.s)
          : pscNumOrNull(sur.luntS) !== null ? pscNumOrNull(sur.luntS) : pscNumOrNull(sur.lunt_s);
        put("pscSurroS", S, "Surrogacy: S (%)", "surrogacy.S");
        if (S === null) gaps.push("Lunt's S — the graded surrogacy measure this section judges on — was not in the handoff. A p-value alone cannot open the gate: compute S in the validation data (the R code below does it) and enter it by hand.");
        if (sur.testable === false) put("pscSurroTestable", "no", "Validation outcomes available", "surrogacy.testable");
        else if (sur.testable === true) put("pscSurroTestable", "yes", "Validation outcomes available", "surrogacy.testable");
        put("pscValN", pscNumOrNull(ds.n), "Validation sample size", "dataset.n");
        if (typeof ds.label === "string" && ds.label.trim()) put("pscValName", ds.label.trim().slice(0, 200), "Validation dataset", "dataset.label");
        // Validation type is discussed in the note's failure modes but is not in
        // the v1 JSON block; accept the plausible spellings.
        const vt = [ds.valType, ds.validationType, j.validationType, (j.validation || {}).type].find((x) => x === "internal" || x === "external");
        if (vt) put("pscValType", vt, "Validation sample type", "dataset.valType");
        else gaps.push("Whether the validation sample is internal or external was not in the handoff. It is already set to “" + (s.pscValType === "external" ? "external" : "internal") + "” here — check it, because the bootstrap in the generated R resamples differently for each.");
        if (pscNumOrNull(bs.lo) !== null && pscNumOrNull(bs.hi) !== null) {
          put("pscBootLo", bs.lo, "Bootstrap 2.5%", "bootstrap.lo");
          put("pscBootHi", bs.hi, "Bootstrap 97.5%", "bootstrap.hi");
          if (pscNumOrNull(bs.B)) put("pscBootB", bs.B, "Bootstrap replicates", "bootstrap.B");
        }
        // The claims-only coefficients cannot come from a validation dataset.
        const nv = j.naive || {};
        const naiveOffered = [nv.bT, nv.bTse, nv.bPS].some((x) => pscNumOrNull(x) !== null);
        if (naiveOffered) warn.push("The handoff carried naive treatment coefficients (naive.bT / bTse / bPS). They were NOT imported: those belong to the claims-only study, which is a different dataset from the validation sample that produced everything else here. Enter them by hand.");

        const cv = pscStrList(j.claimsVars), uv = pscStrList(j.clinicalVars);
        const m = pscModel(s);
        const varPlan = (cv || uv) ? {
          claims: cv || [], clinical: uv || [],
          addC: pscDiff(cv || [], m.claims), dropC: pscDiff(m.claims, cv || []),
          addU: pscDiff(uv || [], m.clinical), dropU: pscDiff(m.clinical, uv || []),
        } : null;

        const gen = typeof j.generated === "string" ? j.generated : "";
        let ageDays = null;
        if (gen) { const t = Date.parse(gen); if (!isNaN(t)) ageDays = Math.round((Date.now() - t) / 86400000); }
        return { plan: {
          fills: fills, warn: warn, gaps: gaps, varPlan: varPlan, generated: gen, ageDays: ageDays,
          scale: hs || cur, naiveOffered: naiveOffered,
          prov: (j.provenance && typeof j.provenance === "object") ? j.provenance : {},
          ds: { label: typeof ds.label === "string" ? ds.label : "", n: pscNumOrNull(ds.n), events: pscNumOrNull(ds.events), treated: pscNumOrNull(ds.treated) },
        } };
      };

      const pscApplyHandoff = (plan, alsoVars) => {
        plan.fills.forEach((f) => {
          const el = form.elements[f.field];
          if (el) el.value = String(f.value);
        });
        if (alsoVars && plan.varPlan) {
          const vp = plan.varPlan;
          // "Adopt" has to make the split actually match, or the next import
          // reports the same difference and the button did nothing useful. The
          // method needs PS_ep built from exactly the C the coefficients were
          // fitted from, so anything the handoff does not name leaves both
          // scores. It stays in Section 8's adjustment set — this only governs
          // 7b — and "Reset to rules" undoes it.
          const named = new Set(vp.claims.concat(vp.clinical));
          pscCandidates(readForm()).forEach((n) => { if (!named.has(n)) pscClass[n] = "exclude"; });
          vp.claims.forEach((n) => { pscClass[n] = "claims"; });
          vp.clinical.forEach((n) => { pscClass[n] = "clinical"; });
          savePscClass();
          // Anything the handoff names that the protocol has not listed must
          // become a candidate, or the split silently stays different.
          const known = new Set(pscCandidates(readForm()));
          const extra = vp.claims.concat(vp.clinical).filter((n) => !known.has(n));
          if (extra.length) {
            const ta = form.elements.pscVarsExtra;
            if (ta) ta.value = (ta.value ? ta.value.replace(/\s*$/, "") + "\n" : "") + extra.join("\n");
          }
        }
        pscImport = {
          at: new Date().toISOString(), generated: plan.generated, ageDays: plan.ageDays,
          fills: plan.fills.map((f) => ({ label: f.label, value: f.value, src: f.src })),
          warn: plan.warn, gaps: plan.gaps, prov: plan.prov, ds: plan.ds, scale: plan.scale,
          varsApplied: !!alsoVars, naiveOffered: plan.naiveOffered,
        };
        savePscImport();
        render();
      };

      // ── AI variable triage for PS calibration ────────
      // Metadata only: the causal question, the name of the claims database,
      // and variable NAMES plus whatever codebook text the investigator typed.
      // No cell values, no rows — the Worker has no way to receive them.
      const PSC_WORKER_URL = "https://target-checker.danielhttsai.workers.dev";
      const setPscAiMsg = (t, bad) => {
        const el = document.querySelector("[data-psc-ai-msg]");
        if (el) { el.textContent = t || ""; el.className = "text-[11px] " + (bad ? "text-rose-600" : "text-emerald-700"); }
      };
      document.querySelector("[data-psc-ai]")?.addEventListener("click", async (ev) => {
        const btn = ev.currentTarget;
        const s = readForm();
        const notes = pscNoteMap(s);
        // Stable ids, because names are not usable as keys: the model re-cases
        // them, appends the note, and long descriptive covariate names get
        // truncated in transit. Found live — a real protocol whose covariates
        // were written as full sentences had 9 of 19 rows come back unmatched.
        const vars = pscCandidates(s).map((n, i) => ({ id: "v" + i, name: n, note: notes[n] || "" }));
        if (!vars.length) { setPscAiMsg("Tick some covariates in Section 8 first, or list validation-only variables.", true); return; }
        btn.disabled = true;
        setPscAiMsg("Asking the AI which of these " + vars.length + " variables a claims database can see (only names and your notes are sent — never data)…");
        try {
          const res = await fetch(PSC_WORKER_URL, {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              mode: "psvars",
              claimsDb: (s.pscClaimsDb || "Taiwan NHIRD").trim(),
              question: {
                population: s.picoP || "", outcome: s.picoO || "",
                exposure: s.picoI || s.exposureName || "",
                comparator: s.picoC || s.comparatorName || "",
              },
              variables: vars,
            }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || !Array.isArray(data.items)) { setPscAiMsg(data.error || "The AI could not classify the variables.", true); return; }
          // Match the reply back to our variables: by id first, then by name as
          // a fallback for anything the model returns without one. Name
          // matching alone silently drops rows — the model echoes the " :: note"
          // suffix, changes the case, and only ever sees a truncated copy of a
          // very long name.
          const byId = new Map(vars.map((v) => [v.id, v.name]));
          const byName = new Map();
          vars.forEach((v) => { byName.set(v.name, v.name); byName.set(pscNorm(v.name).trim(), v.name); });
          const resolve = (it) => {
            if (it.id && byId.has(String(it.id).trim())) return byId.get(String(it.id).trim());
            const t = String(it.name || "").split("::")[0].trim();
            if (byName.has(t)) return byName.get(t);
            const n = pscNorm(t).trim();
            if (byName.has(n)) return byName.get(n);
            // Last resort: the model saw a truncated name, so match on prefix.
            if (n.length >= 24) {
              for (const v of vars) { if (pscNorm(v.name).trim().startsWith(n)) return v.name; }
            }
            return null;
          };
          let nClin = 0, nExcl = 0;
          data.items.forEach((it) => {
            const name = it && resolve(it);
            if (!name) return;
            pscAi[name] = { source: it.source, confounding: it.confounding, role: it.role, reason: it.reason || "" };
            if (it.role && it.role !== "baseline") { pscClass[name] = "exclude"; nExcl++; }
            else if (it.source === "clinical") { pscClass[name] = "clinical"; nClin++; }
            else if (it.source === "claims") { pscClass[name] = "claims"; }
            else delete pscClass[name];   // "unclear" — fall back to the keyword rule
          });
          savePscClass(); render();
          const unseen = vars.filter((v) => !pscAi[v.name]).length;
          const changed = vars.filter((v) => pscAi[v.name] && pscClassOf(v.name) !== pscHeuristic(v.name));
          setPscAiMsg(
            (changed.length
              ? "The AI overruled the keyword rule on " + changed.length + " of " + (vars.length - unseen) + " variable(s) — those rows carry an 'AI changed' badge and are the ones worth checking first: " + changed.slice(0, 6).map((v) => v.name.slice(0, 28)).join(", ") + (changed.length > 6 ? ", …" : "") + ". "
              : "The AI agreed with the keyword rule on every variable it could read. ")
            + nClin + " marked clinical-only, " + nExcl + " excluded as non-baseline."
            + (unseen ? " " + unseen + " came back unmatched and keep their rule position — check those rows." : "")
            + " Review every one: the AI is working from names alone and the clinical call is yours.", unseen > 0);
        } catch (e) {
          setPscAiMsg("Couldn't reach the AI: " + (e && e.message ? e.message : e), true);
        } finally { btn.disabled = false; }
      });
      // ── Handoff import UI ────────────────────────────
      const pscImpReport = document.querySelector("[data-psc-import-report]");
      let pscPending = null;   // a parsed plan awaiting the variable-split decision
      const setImpMsg = (html) => { if (pscImpReport) pscImpReport.innerHTML = html; };
      const li = (arr) => "<ul class='mt-1 ml-4 list-disc space-y-0.5'>" + arr.map((x) => "<li>" + pscEsc(x) + "</li>").join("") + "</ul>";

      const pscRenderPlan = (plan) => {
        const vp = plan.varPlan;
        const diffs = vp ? vp.addC.length + vp.dropC.length + vp.addU.length + vp.dropU.length : 0;
        let h = "<div class='rounded border border-emerald-300 bg-emerald-50 p-2'>";
        h += "<p class='font-semibold text-emerald-900'>Imported " + plan.fills.length + " field(s)" +
             (plan.generated ? " from a handoff generated " + pscEsc(plan.generated.slice(0, 10)) + (plan.ageDays !== null ? " (" + plan.ageDays + " day(s) ago)" : "") : "") + ".</p>";
        h += "<div class='mt-1 grid sm:grid-cols-2 gap-x-4'>" + plan.fills.map((f) =>
              "<div class='text-slate-700'>" + pscEsc(f.label) + " = <strong>" + pscEsc(String(f.value)) + "</strong> <span class='text-slate-400'>← " + pscEsc(f.src) + "</span></div>").join("") + "</div>";
        h += "<p class='mt-1 text-slate-600'>β̂ treatment, its SE and β̂ PS_ep were <strong>not</strong> imported and cannot be — they come from the claims-only outcome model, a different dataset. They are the remaining gap.</p>";
        h += "</div>";
        if (plan.warn.length) h += "<div class='mt-1 rounded border border-amber-300 bg-amber-50 p-2 text-amber-900'><p class='font-semibold'>Check</p>" + li(plan.warn) + "</div>";
        if (plan.gaps.length) h += "<div class='mt-1 rounded border border-amber-300 bg-amber-50 p-2 text-amber-900'><p class='font-semibold'>Not supplied by the handoff</p>" + li(plan.gaps) + "</div>";
        if (vp) {
          if (!diffs) h += "<div class='mt-1 rounded border border-slate-300 bg-white p-2 text-slate-700'>The handoff's covariate split matches this protocol's exactly (" + vp.claims.length + " claims, " + vp.clinical.length + " clinical-only).</div>";
          else {
            h += "<div class='mt-1 rounded border border-rose-300 bg-rose-50 p-2 text-rose-900'><p class='font-semibold'>The covariate split differs — α₁ and α₂ only apply to the split they were fitted from</p>";
            if (vp.addC.length) h += "<p class='mt-1'>In the handoff's claims list but not here: " + pscEsc(vp.addC.join(", ")) + "</p>";
            if (vp.dropC.length) h += "<p>Claims here but not in the handoff: " + pscEsc(vp.dropC.join(", ")) + "</p>";
            if (vp.addU.length) h += "<p>In the handoff's clinical list but not here: " + pscEsc(vp.addU.join(", ")) + "</p>";
            if (vp.dropU.length) h += "<p>Clinical here but not in the handoff: " + pscEsc(vp.dropU.join(", ")) + "</p>";
            h += "<p class='mt-1'>Nothing has been changed. Either adopt the handoff's split, or refit the calibration against this protocol's split.</p>" +
                 "<button type='button' data-psc-import-vars class='mt-1 text-[10px] uppercase tracking-widest font-bold text-rose-800 border border-rose-400 bg-white hover:bg-rose-100 px-2 py-1 rounded'>Adopt the handoff's split</button><span class='ml-1 text-[10px] text-rose-800'>Variables the handoff does not name leave both propensity scores (they stay in Section 8's adjustment set).</span></div>";
          }
        }
        return h;
      };

      const pscDoImport = (text) => {
        const s = readForm();
        const res = pscParseHandoff(text, s);
        if (res.error) { setImpMsg("<div class='rounded border border-rose-300 bg-rose-50 p-2 text-rose-800'>" + pscEsc(res.error) + "</div>"); return; }
        pscPending = res.plan;
        pscApplyHandoff(res.plan, false);
        setImpMsg(pscRenderPlan(res.plan));
      };

      document.querySelector("[data-psc-import-file]")?.addEventListener("change", async (ev) => {
        const f = ev.target.files && ev.target.files[0]; if (!f) return;
        if (f.size > 262144) { setImpMsg("<div class='rounded border border-rose-300 bg-rose-50 p-2 text-rose-800'>" + pscEsc("That file is " + Math.round(f.size / 1024) + " KB. A calibration handoff is a few kilobytes; this was not read.") + "</div>"); ev.target.value = ""; return; }
        try { pscDoImport(await f.text()); } catch (e) { setImpMsg("<div class='rounded border border-rose-300 bg-rose-50 p-2 text-rose-800'>Could not read that file.</div>"); }
        ev.target.value = "";
      });
      document.querySelector("[data-psc-import-paste]")?.addEventListener("click", () => {
        document.querySelector("[data-psc-import-text]")?.classList.toggle("hidden");
        document.querySelector("[data-psc-import-actions]")?.classList.toggle("hidden");
      });
      document.querySelector("[data-psc-import-go]")?.addEventListener("click", () => {
        pscDoImport((document.querySelector("[data-psc-import-text]") || {}).value || "");
      });
      pscImpReport?.addEventListener("click", (e) => {
        if (!e.target?.closest?.("[data-psc-import-vars]")) return;
        if (!pscPending) return;
        pscApplyHandoff(pscPending, true);
        setImpMsg(pscRenderPlan(Object.assign({}, pscPending, { varPlan: null })) +
          "<div class='mt-1 rounded border border-slate-300 bg-white p-2 text-slate-700'>The handoff's covariate split has been adopted; any variable it named that this protocol did not list has been added to the validation-only box.</div>");
      });

      document.querySelector("[data-psc-copy-r]")?.addEventListener("click", async () => {
        const pre = document.querySelector("[data-psc-r]");
        try { await navigator.clipboard.writeText(pre ? pre.textContent : ""); setPscAiMsg("R code copied to the clipboard."); }
        catch { setPscAiMsg("Couldn't copy; your browser may block clipboard access.", true); }
      });

      // ── Filename ─────────────────────────────────────
      const buildFilename = (ext) => {
        const state = readForm();
        const slug = (state.shortId || "aspen-protocol-acnu")
          .toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60) || "aspen-protocol-acnu";
        const today = new Date().toISOString().slice(0, 10);
        return slug + "-" + today + "." + ext;
      };

      // ── Markdown download / copy ─────────────────────
      document.querySelector("[data-action='download-md']")?.addEventListener("click", async () => {
        let body = preview.textContent || "";
        try {
          const fig = await window.designDiagramFigure(document.getElementById("diagram"));
          body = body.replace(FIG1_MARK, window.designDiagramMd(fig).trimEnd());
          if (!fig.ok) setMsg("Downloaded without the design diagram image: " + (fig.reason || "unknown reason") + ". The caption and window list are still there, and the file says the picture is missing.", true);
        } catch (e) { console.error(e); }
        const blob = new Blob([body], { type: "text/markdown;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url; a.download = buildFilename("md");
        document.body.appendChild(a); a.click(); a.remove();
        URL.revokeObjectURL(url);
        setMsg("Downloaded " + a.download);
      });

      document.querySelector("[data-action='copy']")?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(preview.textContent || "");
          setMsg("Copied to clipboard.");
        } catch {
          setMsg("Couldn't copy; your browser may block clipboard access.", true);
        }
      });

      const doReset = () => {
        if (!confirm("Clear every field and forget the saved draft?")) return;
        localStorage.removeItem(STORAGE_KEY);
        localStorage.removeItem(STORAGE_CITATIONS_KEY);
        localStorage.removeItem(PSC_STORAGE_KEY);
        localStorage.removeItem(PSC_IMPORT_KEY);
        pickedCitations = {};
        pscClass = {}; pscAi = {}; pscVarsSig = ""; pscImport = null;
        // The draft that carried the dead value is gone, so the question about
        // it is answered; leaving it would strand a red blocker on a form the
        // user has just emptied.
        staleSelects = [];
        // True blank slate; form.reset() only restores HTML defaults, which
        // leaves all the pre-checked checkboxes ticked. Walk every form
        // control and zero it out so "Clear" actually means clear.
        //
        // A <select> is the exception, because it has no blank state: it always
        // contributes a value, so "cleared" can only mean the page's own
        // default. selectedIndex = 0 was not that. Maximum follow-up is authored
        // `selected={i === 3}`, five years, so clearing the form moved the study
        // to one year — a design parameter changed by the one button whose whole
        // promise is that it changes nothing.
        form.querySelectorAll("input, textarea, select").forEach((el) => {
          if (el.type === "checkbox" || el.type === "radio") {
            el.checked = false;
          } else if (el.tagName === "SELECT") {
            const def = Array.prototype.findIndex.call(el.options, (o) => o.defaultSelected);
            el.selectedIndex = def >= 0 ? def : 0;
          } else {
            el.value = "";
          }
        });
        // The reset blanks the hidden amendments field by assigning .value,
        // which fires no event, so the editor has to be told: without this it
        // goes on showing rows the reset has deleted.
        if (window.PC && PC.syncAmendments) PC.syncAmendments(form);
        render();
        setMsg("Cleared.");
      };
      document.querySelector("[data-action='reset']")?.addEventListener("click", doReset);
      document.querySelector("[data-action='reset-top']")?.addEventListener("click", doReset);

      // ── Word .docx download (Times New Roman, with tables) ─
      document.querySelector("[data-action='download-docx']")?.addEventListener("click", async () => {
        if (typeof docx === "undefined") {
          setMsg("Word library failed to load; check your network and try again.", true);
          return;
        }
        setMsg("Building Word document…");
        try {
          const blob = await buildDocx(readForm());
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url; a.download = buildFilename("docx");
          document.body.appendChild(a); a.click(); a.remove();
          URL.revokeObjectURL(url);
          setMsg("Downloaded " + a.download);
        } catch (e) {
          console.error(e);
          setMsg("Couldn't build the Word file: " + String(e), true);
        }
      });

      // ── TARGET checklist download ─────────────────────
      document.querySelector("[data-action='download-target']")?.addEventListener("click", async () => {
        if (typeof docx === "undefined") {
          setMsg("Word library failed to load; check your network and try again.", true);
          return;
        }
        setMsg("Building TARGET checklist…");
        try {
          const blob = await buildTargetDocx(readForm());
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          const state = readForm();
          const slug = (state.shortId || "aspen-protocol-acnu").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60) || "aspen-protocol-acnu";
          const today = new Date().toISOString().slice(0, 10);
          a.href = url; a.download = slug + "-TARGET-checklist-" + today + ".docx";
          document.body.appendChild(a); a.click(); a.remove();
          URL.revokeObjectURL(url);
          setMsg("Downloaded " + a.download);
        } catch (e) {
          console.error(e);
          setMsg("Couldn't build the TARGET checklist: " + String(e), true);
        }
      });

      const buildDocx = async (s) => {
        const D = docx;
        const today = new Date().toISOString().slice(0, 10);

        // ── Style helpers (Times New Roman everywhere) ────
        const FONT = "Times New Roman";
        const text = (str, opts = {}) => new D.TextRun({ text: String(str ?? ""), font: FONT, size: 22, ...opts });
        const p = (children, opts = {}) => new D.Paragraph({
          children: Array.isArray(children) ? children : [children],
          spacing: { before: 60, after: 60, ...(opts.spacing || {}) },
          ...opts,
        });
        const h1 = (str) => new D.Paragraph({
          children: [text(str, { bold: true, size: 28 })],
          spacing: { before: 200, after: 80 },
          heading: D.HeadingLevel.HEADING_1,
        });
        const h2 = (str) => new D.Paragraph({
          children: [text(str, { bold: true, size: 24 })],
          spacing: { before: 160, after: 60 },
          heading: D.HeadingLevel.HEADING_2,
        });
        const para = (str) => p([text(str)]);
        const bullet = (str) => new D.Paragraph({
          children: [text(str)],
          bullet: { level: 0 },
          spacing: { before: 0, after: 0 },
        });
        const numItem = (str) => new D.Paragraph({
          children: [text(str)],
          numbering: { reference: "ordered", level: 0 },
          spacing: { before: 0, after: 0 },
        });

        const border = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" };
        const cellBorders = { top: border, bottom: border, left: border, right: border };

        // Build a 2-col labelled table (label · value rows).
        // Total width 9026 DXA (A4 minus 1" margins).
        const labelTable = (rows) => new D.Table({
          width: { size: 9026, type: D.WidthType.DXA },
          columnWidths: [3000, 6026],
          rows: rows.map(([label, value]) => new D.TableRow({
            children: [
              new D.TableCell({
                borders: cellBorders,
                width: { size: 3000, type: D.WidthType.DXA },
                margins: { top: 60, bottom: 60, left: 100, right: 100 },
                shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR },
                children: [p([text(label, { bold: true })])],
              }),
              new D.TableCell({
                borders: cellBorders,
                width: { size: 6026, type: D.WidthType.DXA },
                margins: { top: 60, bottom: 60, left: 100, right: 100 },
                children: [p([text(value || "-")])],
              }),
            ],
          })),
        });

        // 3-col table for exposure/comparator
        const threeColTable = (header, rows) => new D.Table({
          width: { size: 9026, type: D.WidthType.DXA },
          columnWidths: [2200, 3000, 3826],
          rows: [
            new D.TableRow({
              tableHeader: true,
              children: header.map((h, i) => new D.TableCell({
                borders: cellBorders,
                width: { size: [2200, 3000, 3826][i], type: D.WidthType.DXA },
                margins: { top: 60, bottom: 60, left: 100, right: 100 },
                shading: { fill: "21443E", type: D.ShadingType.CLEAR },
                children: [p([text(h, { bold: true, color: "FFFFFF" })])],
              })),
            }),
            ...rows.map((cells) => new D.TableRow({
              children: cells.map((c, i) => new D.TableCell({
                borders: cellBorders,
                width: { size: [2200, 3000, 3826][i], type: D.WidthType.DXA },
                margins: { top: 60, bottom: 60, left: 100, right: 100 },
                children: [p([text(c || "-")])],
              })),
            })),
          ],
        });

        const inclusion  = mergeList(s.inclusionPick,    s.inclusionCustom);
        const exclusion  = mergeList(s.exclusionPick,    s.exclusionCustom);
        const refsUser   = (s.references || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const refs       = (() => {
          const set = new Set(refsUser);
