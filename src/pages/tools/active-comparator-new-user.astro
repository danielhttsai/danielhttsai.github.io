                  <button type="button" data-add-row data-target="covWindows" data-name={t} class="text-[10px] rounded-full border border-slate-200 px-2 py-0.5 text-slate-600 hover:border-brand-400 hover:text-brand-700">+ {t}</button>
                ))}
              </div>
              <span class="text-[11px] text-slate-500">Give each covariate its own look-back (<code>Name | days</code>) — each becomes a draggable window in the diagram, like the clone-censor-weight builder. Leave empty to use the single look-back above for all covariates.</span>
            </label>
            <label class="flex flex-col gap-1">
