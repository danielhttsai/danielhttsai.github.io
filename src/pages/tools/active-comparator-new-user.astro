      };

      // ── Render preview from current form state ──────
      const parseRows = (txt) => String(txt || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean).map((l) => { const p = l.split("|"); return { name: (p[0] || "").trim(), days: Math.max(0, parseInt(p[1]) || 0) }; }).filter((r) => r.name);
      const rowsJoin = (rows) => rows.map((r) => r.name + " | " + r.days).join("\n");
      const covLbText = (s) => { const r = parseRows(s.covWindows); return r.length ? r.map((x) => x.name + " " + x.days + " d").join("; ") : ((s.lookback || "365") + " days prior to index date"); };
      const renderScheme = (s) => {
        const wash = Math.max(0, parseInt(s.washout) || 0);
        const lb = Math.max(0, parseInt(s.lookback) || 0);
        const grace = Math.max(0, parseInt(s.grace) || 0);
        let fu = 1825;
        const mfc = (s.maxFollowupChoice || "") + " " + (s.maxFollowupCustom || "");
        const ym = mfc.match(/(\d+(?:\.\d+)?)\s*year/i), dm = mfc.match(/(\d+)\s*day/i);
        if (ym) fu = Math.round(parseFloat(ym[1]) * 365); else if (dm) fu = parseInt(dm[1]);
        const covRows = parseRows(s.covWindows);
        const wins = [];
        // Per-covariate look-back windows if listed; else a single shared look-back — like the clone builder.
        if (covRows.length) covRows.forEach((r, i) => wins.push({ label: r.name, kind: "lookback", startDay: -r.days, endDay: 0, edit: { field: "covWindows", edge: "start", idx: i } }));
        else if (lb > 0) wins.push({ label: "Covariate look-back", kind: "lookback", startDay: -lb, endDay: 0, edit: { field: "lookback", edge: "start" } });
        if (wash > 0) wins.push({ label: "New-user washout (no prior exposure/comparator)", kind: "washout", startDay: -wash, endDay: 0, edit: { field: "washout", edge: "start" } });
        wins.push({ label: "Follow-up", kind: "followup", startDay: 0, endDay: fu, edit: { field: "maxFollowup", edge: "end" } });
        const onEdit = (field, day, meta) => {
          if (field === "covWindows") {
            const el = form.elements.covWindows; const rows = parseRows(el.value);
            const idx = meta && meta.idx != null ? meta.idx : 0;
            if (rows[idx]) { rows[idx].days = Math.max(1, Math.round(-day)); el.value = rowsJoin(rows); render(); }
            return;
          }
          if (field === "maxFollowup") {
            const yrs = day / 365;
            if (form.elements.maxFollowupChoice) form.elements.maxFollowupChoice.value = "custom";
            if (form.elements.maxFollowupCustom) form.elements.maxFollowupCustom.value = (yrs >= 1 ? (Math.round(yrs * 10) / 10) + " years" : Math.max(1, Math.round(day)) + " days");
            render(); return;
          }
          const el = form.elements[field]; if (!el) return;
          el.value = Math.round(Math.max(0, -day));
          render();
        };
        window.renderDesignDiagram(document.getElementById("diagram"), document.getElementById("dlegend"), { windows: wins, indexLabel: "Index (day 0) — treatment start", onEdit: onEdit, snap: 5 });
      };

      const computeChecks = (s) => {
        const checks = [];
        const wash = parseInt(s.washout) || 0, lb = parseInt(s.lookback) || 0, grace = parseInt(s.grace) || 0;
        if (wash <= 0) checks.push({ level: "warn", msg: "Washout is 0 — prevalent (non-new) users may be included. A new-user design needs a washout window with no prior exposure or comparator." });
        else if (wash < 180) checks.push({ level: "info", msg: "Washout < 180 days — consider a longer washout to be confident users are truly new." });
        if (lb <= 0) checks.push({ level: "warn", msg: "No covariate look-back — baseline confounders are unmeasured. Set a look-back window before index." });
        if (grace <= 0) checks.push({ level: "info", msg: "Grace period 0 — the on-treatment analysis will censor at the first dispensing gap." });
        if (!s.exposureName || !s.comparatorName) checks.push({ level: "info", msg: "Specify the exposure and the active comparator." });
        if (!s.picoO && !s.outcomeDef) checks.push({ level: "info", msg: "Specify the outcome." });
        const pa = s.primaryAnalysisType;
        if (pa === "ITT" || pa === "both") checks.push({ level: "info", msg: "ITT (as-assigned): the treatment strategy is fixed at the index date — later switching or add-on therapy is ignored (no deviation censoring)." });
        if (pa === "OT" || pa === "both") checks.push({ level: "info", msg: "On-treatment (per-protocol): follow-up is censored at deviation (discontinuation/switch), so this informative censoring should be adjusted with IPCW." });
        if (pa === "landmark") checks.push({ level: "warn", msg: "Landmark analysis is conditional on patients who survive event-free to the landmark time — it estimates a conditional effect and drops early events; state the landmark time and interpret accordingly." });
        checks.push({ level: "ok", msg: "Eligibility, treatment assignment, and follow-up start are aligned at the index date (time zero) — this is what avoids immortal-time bias." });
        if (s.pscEnable === "yes") {
          const m = pscModel(s);
          if (m.clinical.length === 0) checks.push({ level: "warn", msg: "PS calibration is switched on but no covariate is marked clinical-only — the gold-standard and error-prone scores would be identical and the correction would be a no-op. Mark the variables the claims database cannot see." });
          if (m.claims.length === 0) checks.push({ level: "warn", msg: "PS calibration is switched on but no covariate is marked claims-available — there is no error-prone propensity score to calibrate." });
          if (!(s.pscValName || "").trim()) checks.push({ level: "info", msg: "Name the validation dataset that holds both the claims and the clinical variables (Section 8b)." });
          // Wan F, Am J Epidemiol 2024;193(2):360-9 — the two bias sources.
          if (m.surroVerdict === "s-low") checks.push({ level: "warn", msg: "Surrogacy is absent (S = " + pscFmt(m.surroS, 1) + "%): the error-prone PS carries most of the outcome information. Lunt's scenarios at this level produced bias reduction of −132% to −189% — calibration roughly doubled the error. Report the naive estimate and report S as the reason calibration was not applied." });
          if (m.surroVerdict === "s-mid") checks.push({ level: "warn", msg: "Partial surrogacy (S = " + pscFmt(m.surroS, 1) + "%). This is the region where our simulation turned: at S ≈ 82% calibration was worse than doing nothing in 5 of 5 replicates. Do not present the calibrated estimate as a correction — see 'If surrogacy cannot be supported' in Section 7b of the export." });
          if (m.surroVerdict === "p-rejected") checks.push({ level: "info", msg: "The surrogacy p-value rejects, but that alone is not a reason to abandon calibration: the p-value tests an exact null and rejects on departures too small to matter. Compute S (the R code does it) and judge on its magnitude — we observed p < 0.001 at S = 92.5%, where calibration still removed most of the bias." });
          if (m.surroVerdict === "p-ok") checks.push({ level: "info", msg: "The surrogacy p-value does not reject, which is weak evidence. Compute S from the same models and judge on its magnitude." });
          if (m.surroVerdict === "untested") checks.push({ level: "warn", msg: "Surrogacy has not been measured. Your validation data have outcomes, so compute S — of the outcome information carried by both propensity scores, the percentage carried by the gold-standard score alone (Lunt 2012) — and enter it in Section 8b. Wan (2024) shows PS calibration is generally biased unless surrogacy holds." });
          if (m.surroVerdict === "untestable") checks.push({ level: "warn", msg: "Surrogacy cannot be measured because the validation dataset has no outcomes. This is the cross-sectional-validation setting Lunt et al. (2012) address, and their answer is to present PS calibration as a bias analysis over a range for the unmeasured confounder's outcome association rather than as a point correction." });
          if (m.nonCollapsible) checks.push({ level: "info", msg: "You are reporting a " + m.measure + ", which is non-collapsible. Wan (2024) identifies this as an independent source of PS-calibration bias: the calibrated estimate is conditional on the gold-standard propensity score, not on baseline covariates, so it is a slightly different estimand. The gap narrows as the outcome becomes rarer — state which estimand you report." });
          if (!Object.keys(pscAi).length && (m.claims.length + m.clinical.length) > 0) checks.push({ level: "info", msg: "The claims/clinical split is still the keyword rule's guess. It reads names only, so it cannot distinguish a measurement from a billing code and it misses unfamiliar instruments — run 'Let AI classify' in Section 8b and check the rows it changes. A clinical variable left in the claims list collapses the correction toward zero, which reads as 'no unmeasured confounding'." });
          if (m.contradiction) checks.push({ level: "warn", msg: "The variable split and the entered calibration coefficients are inconsistent, so the calibrated estimate is not shown. " + m.contradiction });
          if (m.releaseLevel === "withheld" && m.bC !== null) checks.push({ level: "warn", msg: "A calibrated estimate is computable from the coefficients you entered but is deliberately withheld from the protocol, because surrogacy is not supported. Establish surrogacy with S and it will be released." });
          if (m.bC !== null && !m.hasBoot && m.releaseLevel !== "withheld") checks.push({ level: "info", msg: "The calibrated estimate has no interval. There is no reliable closed-form CI for a ratio of coefficients estimated across two samples — run the bootstrap in the generated R code and paste the percentile bounds into Section 8b." });
          if (m.a1 !== null && Math.abs(m.a1) < 0.05) checks.push({ level: "warn", msg: "α₁ is close to zero, so the correction factor α₂/α₁ explodes and the calibrated estimate is unstable. A near-zero α₁ means the error-prone PS carries almost no information about the gold-standard PS — calibration is not trustworthy here." });
          if (m.a1 !== null && m.a1 < 0) checks.push({ level: "warn", msg: "α₁ is negative — the error-prone PS moves opposite to the gold-standard PS. Check the two PS models use the same treatment coding and the same scale before applying the correction." });
          if (/match|strat|iptw|overlap|weight/i.test(String(s.psMethod || ""))) checks.push({ level: "info", msg: "Your primary confounding-control method is matching/stratification/weighting, which produces no β_PS coefficient. PS calibration needs an outcome model that adjusts for the PS as a linear term — fit that model alongside the primary one as the calibrated analysis." });
        }
        return checks;
      };

      const render = () => {
        const state = readForm();
        preview.textContent = buildMarkdown(state);
        renderFeasibility(state);
        try { renderScheme(state); } catch (e) { console.error(e); }
        try { window.renderChecks(document.getElementById("checks"), computeChecks(state)); } catch (e) { console.error(e); }
        renderPscVars(state);
        renderPscCard(state);
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch {}
      };

      // ── Restore saved state, then render ────────────
      try { PC.restore(form, STORAGE_KEY, writeForm); } catch {}
      // Always pre-fill a default timeline so the section isn't empty
      const timelineTa = form.querySelector('[name="timeline"]');
      if (timelineTa && !timelineTa.value) timelineTa.value = TIMELINE_PRESETS["12-month"];
      render();

      form.addEventListener("input", render);
      form.addEventListener("change", render);

      // Timeline preset buttons + numeric chip presets
      form.addEventListener("click", (e) => {
        const tl = e.target?.closest?.("[data-timeline-preset]");
        if (tl) {
          const ta = form.querySelector('[name="timeline"]');
          if (ta) { ta.value = TIMELINE_PRESETS[tl.dataset.timelinePreset] || ta.value; render(); }
          return;
        }
        const addRow = e.target?.closest?.("[data-add-row]");
        if (addRow) {
          const el = form.elements[addRow.dataset.target], name = addRow.dataset.name;
          if (el) { const rows = parseRows(el.value); if (!rows.some((r) => r.name === name)) { rows.push({ name: name, days: parseInt(form.elements.lookback && form.elements.lookback.value) || 365 }); el.value = rowsJoin(rows); render(); } }
          return;
        }
        const chip = e.target?.closest?.("[data-set-input]");
        if (chip) {
          const target = form.querySelector(`[name="${chip.dataset.setInput}"]`);
          if (target) { target.value = chip.dataset.value; render(); }
          return;
        }
        const pscChip = e.target?.closest?.("[data-psc-set]");
        if (pscChip) {
          pscClass[pscChip.dataset.pscVar] = pscChip.dataset.pscSet;
          savePscClass(); render();
          return;
        }
        const pscBulk = e.target?.closest?.("[data-psc-bulk]");
        if (pscBulk) {
          const mode = pscBulk.dataset.pscBulk;
          if (mode === "reset") { pscClass = {}; pscAi = {}; }
          // "All claims"/"All clinical" must not sweep identifiers, outcomes and
          // post-baseline measurements back into a propensity score — those are
          // never a C-vs-U question, and the AI's judgement on them stands.
          else pscCandidates(readForm()).forEach((n) => {
            if (pscAi[n] && pscAi[n].role && pscAi[n].role !== "baseline") return;
            if (!pscAi[n] && pscHeuristic(n) === "exclude") return;
            pscClass[n] = mode;
          });
          savePscClass(); render();
          return;
        }
      });

      // ── AI variable triage for PS calibration ────────
      // Metadata only: the causal question, the name of the claims database,
      // and variable NAMES plus whatever codebook text the investigator typed.
      // No cell values, no rows — the Worker has no way to receive them.
      const PSC_WORKER_URL = "https://target-checker.danielhttsai.workers.dev";
      const setPscAiMsg = (t, bad) => {
        const el = document.querySelector("[data-psc-ai-msg]");
        if (el) { el.textContent = t || ""; el.className = "text-[11px] " + (bad ? "text-rose-600" : "text-emerald-700"); }
      };
      document.querySelector("[data-psc-ai]")?.addEventListener("click", async (ev) => {
        const btn = ev.currentTarget;
        const s = readForm();
        const notes = pscNoteMap(s);
        // Stable ids, because names are not usable as keys: the model re-cases
        // them, appends the note, and long descriptive covariate names get
        // truncated in transit. Found live — a real protocol whose covariates
        // were written as full sentences had 9 of 19 rows come back unmatched.
        const vars = pscCandidates(s).map((n, i) => ({ id: "v" + i, name: n, note: notes[n] || "" }));
        if (!vars.length) { setPscAiMsg("Tick some covariates in Section 8 first, or list validation-only variables.", true); return; }
        btn.disabled = true;
        setPscAiMsg("Asking the AI which of these " + vars.length + " variables a claims database can see (only names and your notes are sent — never data)…");
        try {
          const res = await fetch(PSC_WORKER_URL, {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              mode: "psvars",
              claimsDb: (s.pscClaimsDb || "Taiwan NHIRD").trim(),
              question: {
                population: s.picoP || "", outcome: s.picoO || "",
                exposure: s.picoI || s.exposureName || "",
                comparator: s.picoC || s.comparatorName || "",
              },
              variables: vars,
            }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || !Array.isArray(data.items)) { setPscAiMsg(data.error || "The AI could not classify the variables.", true); return; }
          // Match the reply back to our variables: by id first, then by name as
          // a fallback for anything the model returns without one. Name
          // matching alone silently drops rows — the model echoes the " :: note"
          // suffix, changes the case, and only ever sees a truncated copy of a
          // very long name.
          const byId = new Map(vars.map((v) => [v.id, v.name]));
          const byName = new Map();
          vars.forEach((v) => { byName.set(v.name, v.name); byName.set(pscNorm(v.name).trim(), v.name); });
          const resolve = (it) => {
            if (it.id && byId.has(String(it.id).trim())) return byId.get(String(it.id).trim());
            const t = String(it.name || "").split("::")[0].trim();
            if (byName.has(t)) return byName.get(t);
            const n = pscNorm(t).trim();
            if (byName.has(n)) return byName.get(n);
            // Last resort: the model saw a truncated name, so match on prefix.
            if (n.length >= 24) {
              for (const v of vars) { if (pscNorm(v.name).trim().startsWith(n)) return v.name; }
            }
            return null;
          };
          let nClin = 0, nExcl = 0;
          data.items.forEach((it) => {
            const name = it && resolve(it);
            if (!name) return;
            pscAi[name] = { source: it.source, confounding: it.confounding, role: it.role, reason: it.reason || "" };
            if (it.role && it.role !== "baseline") { pscClass[name] = "exclude"; nExcl++; }
            else if (it.source === "clinical") { pscClass[name] = "clinical"; nClin++; }
            else if (it.source === "claims") { pscClass[name] = "claims"; }
            else delete pscClass[name];   // "unclear" — fall back to the keyword rule
          });
          savePscClass(); render();
          const unseen = vars.filter((v) => !pscAi[v.name]).length;
          const changed = vars.filter((v) => pscAi[v.name] && pscClassOf(v.name) !== pscHeuristic(v.name));
          setPscAiMsg(
            (changed.length
              ? "The AI overruled the keyword rule on " + changed.length + " of " + (vars.length - unseen) + " variable(s) — those rows carry an 'AI changed' badge and are the ones worth checking first: " + changed.slice(0, 6).map((v) => v.name.slice(0, 28)).join(", ") + (changed.length > 6 ? ", …" : "") + ". "
              : "The AI agreed with the keyword rule on every variable it could read. ")
            + nClin + " marked clinical-only, " + nExcl + " excluded as non-baseline."
            + (unseen ? " " + unseen + " came back unmatched and keep their rule position — check those rows." : "")
            + " Review every one: the AI is working from names alone and the clinical call is yours.", unseen > 0);
        } catch (e) {
          setPscAiMsg("Couldn't reach the AI: " + (e && e.message ? e.message : e), true);
        } finally { btn.disabled = false; }
      });
      document.querySelector("[data-psc-copy-r]")?.addEventListener("click", async () => {
        const pre = document.querySelector("[data-psc-r]");
        try { await navigator.clipboard.writeText(pre ? pre.textContent : ""); setPscAiMsg("R code copied to the clipboard."); }
        catch { setPscAiMsg("Couldn't copy; your browser may block clipboard access.", true); }
      });

      // ── Filename ─────────────────────────────────────
      const buildFilename = (ext) => {
        const state = readForm();
        const slug = (state.shortId || "aspen-protocol-acnu")
          .toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60) || "aspen-protocol-acnu";
        const today = new Date().toISOString().slice(0, 10);
        return slug + "-" + today + "." + ext;
      };

      // ── Markdown download / copy ─────────────────────
      document.querySelector("[data-action='download-md']")?.addEventListener("click", () => {
        const blob = new Blob([preview.textContent || ""], { type: "text/markdown;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url; a.download = buildFilename("md");
        document.body.appendChild(a); a.click(); a.remove();
        URL.revokeObjectURL(url);
        setMsg("Downloaded " + a.download);
      });

      document.querySelector("[data-action='copy']")?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(preview.textContent || "");
          setMsg("Copied to clipboard.");
        } catch {
          setMsg("Couldn't copy; your browser may block clipboard access.", true);
        }
      });

      const doReset = () => {
        if (!confirm("Clear every field and forget the saved draft?")) return;
        localStorage.removeItem(STORAGE_KEY);
        localStorage.removeItem(STORAGE_CITATIONS_KEY);
        localStorage.removeItem(PSC_STORAGE_KEY);
        pickedCitations = {};
        pscClass = {}; pscAi = {}; pscVarsSig = "";
        // True blank slate; form.reset() only restores HTML defaults, which
        // leaves all the pre-checked checkboxes ticked. Walk every form
        // control and zero it out so "Clear" actually means clear.
        form.querySelectorAll("input, textarea, select").forEach((el) => {
          if (el.type === "checkbox" || el.type === "radio") {
            el.checked = false;
          } else if (el.tagName === "SELECT") {
            el.selectedIndex = 0;
          } else {
            el.value = "";
          }
        });
        render();
