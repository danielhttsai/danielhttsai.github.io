            ? '<p class="mt-1 text-[11px] text-slate-600">Entered: ' +
              (m.surroS !== null ? "S = " + pscEsc(pscFmt(m.surroS, 1)) + "%" : "S not given") +
              (m.surroCoef !== null ? "; coefficient on PS_ep = " + pscEsc(pscFmt(m.surroCoef, 4)) : "") +
              (m.surroP !== null ? "; p = " + pscEsc(pscFmt(m.surroP, 4)) : "") + ".</p>"
            : "") +
          "</div>" +
          (pscNeedsRoute(m.surroVerdict)
            ? '<details open class="rounded-xl border border-slate-300 bg-white p-4"><summary class="cursor-pointer text-xs uppercase tracking-widest font-bold text-slate-800">If surrogacy cannot be supported — what to do instead</summary>' +
              '<div class="mt-3 space-y-2">' + pscNoSurrogacyRoute(m).map((v) =>
                '<p class="text-xs text-slate-700 leading-relaxed"><strong>' + pscEsc(v[0]) + ".</strong> " + pscEsc(v[1]) + "</p>").join("") +
              "</div></details>"
            : "");
        const validity =
          '<details class="rounded-xl border border-slate-200 bg-slate-50 p-4"><summary class="cursor-pointer text-xs uppercase tracking-widest font-bold text-slate-700">When this method is valid, and what to report — read before using the number</summary>' +
          '<div class="mt-3 space-y-2">' + pscValidity(m).map((v) =>
            '<p class="text-xs text-slate-700 leading-relaxed"><strong>' + pscEsc(v[0]) + ".</strong> " + pscEsc(v[1]) + "</p>").join("") +
          "</div></details>";

        const list = (arr, empty) => arr.length
          ? '<ul class="mt-1 grid sm:grid-cols-2 gap-x-4 text-xs text-slate-700 list-disc pl-5">' + arr.map((x) => "<li>" + pscEsc(x) + "</li>").join("") + "</ul>"
          : '<p class="mt-1 text-xs text-slate-400 italic">' + empty + "</p>";
        out.innerHTML =
          surroBox +
          '<div class="rounded-xl bg-slate-900 text-slate-100 p-4 font-mono text-xs sm:text-sm overflow-x-auto">' +
          '<p class="text-slate-400 text-[10px] uppercase tracking-widest">Calibration model (fitted in ' + pscEsc(m.valName) + ')</p>' +
          "<p class=\"mt-1\">" + pscEsc(eq) + "</p>" +
          '<p class="mt-3 text-slate-400 text-[10px] uppercase tracking-widest">Correction applied to the ' + pscEsc(m.claimsDb) + " estimate</p>" +
          "<p class=\"mt-1\">" + pscEsc(corr) + "</p>" +
          "</div>" +
          result +
          validity +
          '<div class="grid sm:grid-cols-2 gap-4">' +
          '<div><p class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Claims-available (C) — error-prone PS · ' + m.claims.length + "</p>" + list(m.claims, "(none)") + "</div>" +
          '<div><p class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Clinical-only (U) — added for the gold-standard PS · ' + m.clinical.length + "</p>" + list(m.clinical, "(none — with no extra variables there is nothing to calibrate against)") + "</div>" +
          "</div>" +
          (m.excluded.length ? '<p class="text-[11px] text-slate-500">Excluded from both scores: ' + pscEsc(m.excluded.join("; ")) + "</p>" : "");
        rpre.textContent = pscRCode(s, m);
      };

      // ── Markdown / Word sections ──────────────────────────────────────
      const pscMarkdownSection = (s) => {
        if (s.pscEnable !== "yes") return "";
        const m = pscModel(s);
        const eqNum = (m.a1 !== null && m.a2 !== null && m.a0 !== null)
          ? "PS_gs = " + pscFmt(m.a0, 4) + " " + pscSigned(m.a1, 4) + " × PS_ep " + pscSigned(m.a2, 4) + " × T"
          : "";
        const r = pscResultLines(m);
        const res = r
          ? "- **Naive (claims only) — report as primary:** " + r.naive +
            "\n- **Calibrated — pre-specified sensitivity analysis:** " + r.calibrated +
            "\n\n" + r.note
          : "";
        const sv = PSC_SURRO_TEXT[m.surroVerdict];
        return `## 7b. Propensity-score calibration for unmeasured confounding

${m.claimsDb} records diagnoses, procedures, dispensings, demographics and enrolment. It does not record laboratory values, vital signs, imaging or test measurements, clinical severity scores, or lifestyle. The propensity score fitted there is therefore built from a strict subset of the confounders and is *error-prone* (PS_ep). ${m.valName}${m.valN ? " (n = " + m.valN + ")" : ""} holds the same claims covariates **and** the clinical ones, so a *gold-standard* propensity score (PS_gs) can be fitted in it. Propensity-score calibration uses the relationship between the two scores, estimated in the validation dataset, to correct the treatment-effect estimate from the claims-only study for the confounding it could not see. It is regression calibration with the propensity score as the mismeasured covariate (Stürmer T, Schneeweiss S, Avorn J, Glynn RJ. Adjusting effect estimates for unmeasured confounding with validation data using propensity score calibration. Am J Epidemiol 2005;162(3):279-89).

| | |
|---|---|
| **Main (error-prone) data source** | ${m.claimsDb} |
| **Validation dataset** | ${m.valName}${m.valN ? ", n = " + m.valN : ""} (${m.valType}) |
| **Treatment contrast** | ${m.treatLabel} |
| **PS scale (both models)** | ${m.scaleLabel} |
| **Surrogacy (S)** | ${sv[0]}${m.surroS !== null ? " — S = " + pscFmt(m.surroS, 1) + "%" : ""}${m.surroP !== null ? " (PS_ep coefficient " + (m.surroCoef === null ? "not given" : pscFmt(m.surroCoef, 4)) + ", p = " + pscFmt(m.surroP, 4) + ")" : ""} |

> **Before the numbers: when this method is valid.** ${sv[1]}
${pscNeedsRoute(m.surroVerdict) ? "\n#### If surrogacy cannot be supported\n\n" + pscNoSurrogacyRoute(m).map((v) => "- **" + v[0] + ".** " + v[1]).join("\n") + "\n" : ""}

**Claims-available covariates C (${m.claims.length}) — enter PS_ep and PS_gs**

${bullets(m.claims)}

**Clinical-only covariates U (${m.clinical.length}) — enter PS_gs only; the unmeasured confounding of the claims study**

${bullets(m.clinical)}
${m.excluded.length ? "\n**Excluded from both scores** (identifiers, outcomes, post-baseline measurements)\n\n" + bullets(m.excluded) + "\n" : ""}
### Estimation

1. In ${m.valName}, fit PS_ep = P(T = 1 | C) and PS_gs = P(T = 1 | C, U) by logistic regression. PS_ep must use exactly the model the claims study will fit.
2. Fit the **calibration model** in the same dataset, on the ${m.scaleLabel}:

   > PS_gs = α₀ + α₁ · PS_ep + α₂ · T + ε

   Treatment enters this model because it is in the outcome model and is measured without error; omitting it biases the correction.
3. In ${m.claimsDb}, fit the outcome model adjusting for PS_ep **as a linear term**:

   > g(E[Y | T, PS_ep]) = β₀\\* + β_T\\* · T + β_PS\\* · PS_ep

4. Correct the treatment coefficient:

   > **β_T(calibrated) = β_T\\* − (α₂ / α₁) · β_PS\\***${m.k !== null ? "  =  β_T\\* − " + pscFmt(m.k, 4) + " · β_PS\\*" : ""}

   and, if wanted, β_PS(calibrated) = β_PS\\* / α₁. For a ratio measure the calibrated ${m.measure} is exp(β_T(calibrated)).

**Where the correction comes from.** The outcome model we want but cannot fit in claims is g(E[Y | T, PS_gs]) = β₀ + β_T·T + β_PS·PS_gs. Averaging it over PS_gs given (T, PS_ep), and substituting the calibration model, gives g(E[Y | T, PS_ep]) = (β₀ + β_PS·α₀) + (β_T + β_PS·α₂)·T + (β_PS·α₁)·PS_ep. So the claims-only coefficients are β_T\\* = β_T + β_PS·α₂ and β_PS\\* = β_PS·α₁; inverting those two equations gives the correction above. The averaging step is valid only under surrogacy.

### Calibration equation${eqNum ? "" : " (to be filled once the validation analysis has run)"}

${eqNum ? "> **" + eqNum + "**\n\n> Correction factor α₂ / α₁ = **" + pscFmt(m.k, 4) + "**" + (m.r2 !== null ? "\n\n> Calibration-model R² = " + pscFmt(m.r2, 3) : "") + "\n\n" + pscReuseText(m) : "> PS_gs = α₀ + α₁ · PS_ep + α₂ · T\n\nOnce fitted, report α₀, α₁, α₂ with their standard errors and the calibration-model R². Those three numbers plus the covariate list C are the reusable artefact: a later " + m.claimsDb + "-only study applies them without repeating the validation work — but only once surrogacy has been established with S, and this protocol must say so before anyone reuses it."}
${res ? "\n**Result**\n\n" + res + "\n" : ""}
### When this method is valid, and what to report

${pscValidity(m).map((v) => "- **" + v[0] + ".** " + v[1]).join("\n")}

### Operational assumptions

${pscAssumptions(m).map((a) => "- **" + a[0] + ".** " + a[1]).join("\n")}

### What calibration cannot fix

${bullets(pscCannotFix)}

### Analysis code

\`\`\`r
${pscRCode(s, m)}
\`\`\`

### References for this section

${numbered(PSC_REFERENCES)}
`;
      };

      // Word rendering of the same section. `h` carries the style helpers that
      // live inside buildDocx (text/p/h1/h2/para/bullet/labelTable).
      const pscDocxSection = (D, h, s) => {
        if (s.pscEnable !== "yes") return [];
        const m = pscModel(s);
        const c = [];
        const mono = (str) => new D.Paragraph({
          children: String(str).split("\n").flatMap((line, i) => (i ? [new D.TextRun({ break: 1 })] : []).concat([
            new D.TextRun({ text: line, font: "Courier New", size: 16 }),
          ])),
          spacing: { before: 40, after: 40 },
        });
        c.push(h.h1("7b. Propensity-score calibration for unmeasured confounding"));
        c.push(h.para(m.claimsDb + " records diagnoses, procedures, dispensings, demographics and enrolment. It does not record laboratory values, vital signs, imaging or test measurements, clinical severity scores, or lifestyle. The propensity score fitted there is therefore built from a strict subset of the confounders and is error-prone (PS_ep). " + m.valName + (m.valN ? " (n = " + m.valN + ")" : "") + " holds the same claims covariates AND the clinical ones, so a gold-standard propensity score (PS_gs) can be fitted in it. Propensity-score calibration uses the relationship between the two scores, estimated in the validation dataset, to correct the treatment-effect estimate from the claims-only study for the confounding it could not see. It is regression calibration with the propensity score as the mismeasured covariate (Stürmer T, Schneeweiss S, Avorn J, Glynn RJ. Adjusting effect estimates for unmeasured confounding with validation data using propensity score calibration. Am J Epidemiol 2005;162(3):279-89)."));
        c.push(h.labelTable([
          ["Main (error-prone) data source", m.claimsDb],
          ["Validation dataset", m.valName + (m.valN ? ", n = " + m.valN : "") + " (" + m.valType + ")"],
          ["Treatment contrast", m.treatLabel],
          ["PS scale (both models)", m.scaleLabel],
          ["Surrogacy (S)", PSC_SURRO_TEXT[m.surroVerdict][0] + (m.surroS !== null ? " — S = " + pscFmt(m.surroS, 1) + "%" : "") + (m.surroP !== null ? " (PS_ep coefficient " + (m.surroCoef === null ? "not given" : pscFmt(m.surroCoef, 4)) + ", p = " + pscFmt(m.surroP, 4) + ")" : "")],
        ]));
        c.push(h.p([h.text("Before the numbers: when this method is valid. ", { bold: true }), h.text(PSC_SURRO_TEXT[m.surroVerdict][1])]));
        if (pscNeedsRoute(m.surroVerdict)) {
          c.push(h.h2("If surrogacy cannot be supported"));
          pscNoSurrogacyRoute(m).forEach((v) => c.push(new D.Paragraph({
            children: [h.text(v[0] + ". ", { bold: true }), h.text(v[1])],
            bullet: { level: 0 }, spacing: { before: 40, after: 40 },
          })));
        }
        c.push(h.h2("Claims-available covariates C (" + m.claims.length + ") — enter PS_ep and PS_gs"));
        m.claims.length ? m.claims.forEach((x) => c.push(h.bullet(x))) : c.push(h.para("(none)"));
        c.push(h.h2("Clinical-only covariates U (" + m.clinical.length + ") — enter PS_gs only"));
        m.clinical.length ? m.clinical.forEach((x) => c.push(h.bullet(x))) : c.push(h.para("(none — with no extra variables there is nothing to calibrate against)"));
        if (m.excluded.length) {
          c.push(h.h2("Excluded from both scores"));
          m.excluded.forEach((x) => c.push(h.bullet(x)));
        }
        c.push(h.h2("Estimation"));
        c.push(h.bullet("1. In " + m.valName + ", fit PS_ep = P(T = 1 | C) and PS_gs = P(T = 1 | C, U) by logistic regression. PS_ep must use exactly the model the claims study will fit."));
        c.push(h.bullet("2. Fit the calibration model in the same dataset, on the " + m.scaleLabel + ":  PS_gs = a0 + a1 · PS_ep + a2 · T + e.  Treatment enters this model because it is in the outcome model and is measured without error; omitting it biases the correction."));
        c.push(h.bullet("3. In " + m.claimsDb + ", fit the outcome model adjusting for PS_ep as a LINEAR term:  g(E[Y | T, PS_ep]) = b0* + bT* · T + bPS* · PS_ep."));
        c.push(h.bullet("4. Correct the treatment coefficient:  bT(calibrated) = bT* − (a2 / a1) · bPS*" + (m.k !== null ? "  =  bT* − " + pscFmt(m.k, 4) + " · bPS*" : "") + ".  Also bPS(calibrated) = bPS* / a1. For a ratio measure the calibrated " + m.measure + " is exp(bT(calibrated))."));
        c.push(h.p([h.text("Where the correction comes from. ", { bold: true }), h.text("The outcome model we want but cannot fit in claims is g(E[Y | T, PS_gs]) = b0 + bT·T + bPS·PS_gs. Averaging it over PS_gs given (T, PS_ep), and substituting the calibration model, gives g(E[Y | T, PS_ep]) = (b0 + bPS·a0) + (bT + bPS·a2)·T + (bPS·a1)·PS_ep. So the claims-only coefficients are bT* = bT + bPS·a2 and bPS* = bPS·a1; inverting those two equations gives the correction above. The averaging step is valid only under surrogacy.")]));
        c.push(h.h2("Calibration equation"));
        if (m.a0 !== null && m.a1 !== null && m.a2 !== null) {
          c.push(mono("PS_gs = " + pscFmt(m.a0, 4) + " " + pscSigned(m.a1, 4) + " * PS_ep " + pscSigned(m.a2, 4) + " * T"));
          c.push(h.para("Correction factor a2 / a1 = " + pscFmt(m.k, 4) + (m.r2 !== null ? "; calibration-model R2 = " + pscFmt(m.r2, 3) : "") + "."));
          c.push(h.para(pscReuseText(m)));
        } else {
          c.push(mono("PS_gs = a0 + a1 * PS_ep + a2 * T"));
          c.push(h.para("Once fitted, report a0, a1, a2 with their standard errors and the calibration-model R2. Those three numbers plus the covariate list C are the reusable artefact: a later " + m.claimsDb + "-only study applies them without repeating the validation work — but only once surrogacy has been established with S, and this protocol must say so before anyone reuses it."));
        }
        const rr = pscResultLines(m);
        if (rr) {
          c.push(h.h2("Result"));
          c.push(h.bullet("Naive (claims only) — report as primary: " + rr.naive));
          c.push(h.bullet("Calibrated — pre-specified sensitivity analysis: " + rr.calibrated));
          c.push(h.para(rr.note));
        }
        c.push(h.h2("When this method is valid, and what to report"));
        pscValidity(m).forEach((v) => c.push(new D.Paragraph({
          children: [h.text(v[0] + ". ", { bold: true }), h.text(v[1])],
          bullet: { level: 0 }, spacing: { before: 40, after: 40 },
        })));
        c.push(h.h2("Operational assumptions"));
        pscAssumptions(m).forEach((a) => c.push(new D.Paragraph({
          children: [h.text(a[0] + ". ", { bold: true }), h.text(a[1])],
          bullet: { level: 0 }, spacing: { before: 40, after: 40 },
        })));
        c.push(h.h2("What calibration cannot fix"));
        pscCannotFix.forEach((x) => c.push(h.bullet(x)));
        c.push(h.h2("Analysis code (R)"));
        c.push(mono(pscRCode(s, m)));
        c.push(h.h2("References for this section"));
        PSC_REFERENCES.forEach((x) => c.push(h.bullet(x)));
        return c;
      };

      // ── Markdown template ───────────────────────────
      const buildMarkdown = (s) => {
        const today    = new Date().toISOString().slice(0, 10);
        const title    = orFb(s.title,    "(Untitled multi-national ACNU study)");
        const shortId  = orFb(s.shortId,  "(short id)");
        const lead     = orFb(s.leadInvestigator, "(lead investigator)");
        const version  = orFb(s.version,  "v0.1 draft · " + today);

        // Resolve dropdown choices to free-text used in the protocol body
        const indexDateLabel = (val) => (INDEX_DATE_OPTIONS.find((o) => o.value === val) || {}).label || "";
        const resolvedIndexDate = s.indexDateChoice === "custom"
          ? (s.indexDateCustom || "Custom; see study-specific protocol")
          : indexDateLabel(s.indexDateChoice) || indexDateLabel("after-washout");
        const resolvedMaxFu = s.maxFollowupChoice === "custom"
          ? (s.maxFollowupCustom || "Custom; see study-specific protocol")
          : (s.maxFollowupChoice || "5 years per patient, or until censoring (whichever first)");

        const sex      = ({ both: "both sexes", female: "female only", male: "male only" })[s.sex] || "both sexes";
        const primAn   = ({ ITT: "Intention-to-treat (ITT)", OT: "On-treatment (per-protocol)", both: "Both ITT and on-treatment" })[s.primaryAnalysisType] || "On-treatment";
        const psM      = PS_METHOD_DESCRIPTIONS[s.psMethod] || "PS-based adjustment";
        const eff      = ({
          HR: "Hazard ratio (95% CI) from Cox proportional-hazards models",
          RR: "Risk ratio (95% CI) from Poisson regression",
          RD: "Risk difference (95% CI)",
          IRR: "Incidence rate ratio (95% CI)",
        })[s.effectMeasure] || "Hazard ratio";
        const meta     = ({
          re: "Random-effects (DerSimonian-Laird) meta-analysis pooling site-specific estimates; report I² and τ². Forest plot per outcome.",
          "re-reml": "Random-effects (REML) meta-analysis pooling site-specific estimates; report I² and τ². Forest plot per outcome.",
          fe: "Fixed-effects (inverse-variance) meta-analysis pooling site-specific estimates. Forest plot per outcome.",
        })[s.metaMethod] || "Random-effects meta-analysis.";
        const arch     = ({
          federated:   "Federated; each AsPEN site executes a common analytic package locally and shares only aggregate site-level estimates with the coordinating centre.",
          cdm:         "Common Data Model; each site first transforms its source database into the agreed CDM (e.g. OMOP), then runs the shared SQL/R/Python package.",
          centralised: "Centralised; site-level individual data are pooled at the coordinating centre under appropriate data-sharing agreements.",
        })[s.arch] || "Federated";

        const refsUser   = (s.references || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        // Merge user-typed references with citations harvested from library
        // picks (dedup by exact string).
        const refsAll    = (() => {
          const set = new Set(refsUser);
          for (const cite of Object.values(pickedCitations)) {
            if (cite && cite.trim()) set.add(cite.trim());
          }
          return Array.from(set);
        })();
        const refs       = refsAll;
        const milestones = (s.timeline   || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const inclusion  = mergeList(s.inclusionPick,    s.inclusionCustom);
        const exclusion  = mergeList(s.exclusionPick,    s.exclusionCustom);
        const censoring  = mergeList(s.censoringPick,    s.censoringCustom);
        const covariates = mergeList(s.covariatesPick,   s.covariatesCustom);
        const subgroups  = mergeList(s.subgroupsPick,    s.subgroupsCustom);
        const sensitivity = mergeList(s.sensitivityPick, s.sensitivityCustom);
        const secondary   = mergeList(s.secondaryOutcomesPick, s.secondaryOutcomesCustom);
        const resolvedAge = s.ageRangeChoice === "custom"
          ? (s.ageRangeCustom || "(specify)")
          : (s.ageRangeChoice || "≥18, no upper limit");

        return `# ${title}

**Study ID:** ${shortId}
**Lead investigator(s):** ${lead}
**Version:** ${version}
**Design:** Multi-national active-comparator new-user (ACNU) cohort study under a target trial emulation framework${s.emulatedTrial ? ` (emulating ${s.emulatedTrial})` : ""}.

The active comparator is used as an emulated placebo arm; a drug class with similar indication, similar temporal trends in use, and no known a priori association with the outcome of interest. This minimises confounding by indication and addresses immortal-time / prevalent-user bias by anchoring follow-up at the moment of treatment commencement, similar to randomisation in a target RCT (Hernán & Robins 2016).

---

${window.PC.abstractMd(pcOf(s))}
## 1. Research question

