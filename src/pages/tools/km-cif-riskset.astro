---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="TriNetX Survival Probability & Cumulative Incidence — Daniel Tsai"
  description="A plain-language interactive guide to when 1 minus Kaplan–Meier survival can be interpreted as cumulative incidence, and how TriNetX database follow-up can help approximate the number at risk."
>
  <header class="relative bg-gradient-to-br from-brand-50 via-white to-brand-100/40 border-b border-slate-200 overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14">
      <p class="uppercase tracking-widest text-xs text-brand-600 font-semibold mb-2">RWE Tools · TriNetX</p>
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900">
        1 − Survival Probability 可以當 Cumulative Incidence 嗎？
      </h1>
      <p class="mt-4 text-lg text-slate-600 max-w-3xl leading-relaxed">
        TriNetX 常直接提供 survival probability。很多分析會用 <strong>1 − survival probability</strong>
        當作事件的累積風險。這在某些情況是合理的；但如果有 competing event，意思就會改變。
        TriNetX 另外提供的 <strong>database follow-up duration</strong>，則可以幫我們估計某個時間點大約還有多少人在 risk set。
      </p>
    </div>
  </header>

  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a class="text-brand-700 hover:underline font-semibold" href={`${base}/tools`}>← All RWE tools</a>
      <a class="text-brand-700 hover:underline font-semibold" href={`${base}/tools/protocol-checker`}>Protocol Checker →</a>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Short answer</p>
      <h2 class="mt-1 text-xl font-bold text-slate-900">先問：有沒有會讓 outcome 永遠不可能再發生的 competing event？</h2>

      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-5">
          <p class="text-sm font-bold text-brand-900">沒有重要 competing event</p>
          <p class="mt-2 text-sm text-brand-900 leading-relaxed">
            通常可以把 <strong>1 − KM survival</strong> 解讀成到這個時間點為止的 cumulative risk / cumulative incidence，
            前提是一般 censoring 可以合理視為 non-informative。
          </p>
        </div>
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-5">
          <p class="text-sm font-bold text-rose-950">有 competing event</p>
          <p class="mt-2 text-sm text-rose-900 leading-relaxed">
            要小心。若 death 等 competing event 在 KM 裡只是被當 censoring，
            <strong>1 − KM survival 就不是真實世界的 cumulative incidence function (CIF)</strong>。
          </p>
        </div>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[22rem_minmax(0,1fr)]">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-6">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Try a TriNetX-like scenario</p>
          <h2 class="mt-1 text-lg font-bold text-slate-900">輸入你在平台上看得到的資訊</h2>
        </div>

        <label class="block">
          <span class="flex items-center justify-between text-sm font-semibold text-slate-700">
            起始人數 N
            <input id="N" type="number" min="10" max="1000000" step="10" value="1000"
              class="w-28 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
          </span>
        </label>

        <label class="block">
          <span class="flex items-center justify-between text-sm font-semibold text-slate-700">
            時間點 t（年）
            <input id="time" type="number" min="0.1" max="50" step="0.5" value="5"
              class="w-28 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
          </span>
        </label>

        <label class="block">
          <span class="flex items-center justify-between text-sm font-semibold text-slate-700">
            Survival probability S(t)
            <span id="spv" class="text-brand-700">0.87</span>
          </span>
          <input id="sp" type="range" min="0.40" max="1" step="0.01" value="0.87" class="mt-2 w-full accent-[#2e5a52]" />
          <span class="mt-1 block text-xs text-slate-500">這是 TriNetX survival curve 在時間 t 的高度。</span>
        </label>

        <label class="block">
          <span class="flex items-center justify-between gap-3 text-sm font-semibold text-slate-700">
            t 時仍可在 database 被觀察的人
            <input id="observable" type="number" min="0" max="1000000" step="10" value="600"
              class="w-28 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
          </span>
          <span class="mt-1 block text-xs text-slate-500 leading-relaxed">
            由每個人的 database follow-up duration 直接數：follow-up ≥ t 的人數。
          </span>
        </label>

        <fieldset class="border-t border-slate-100 pt-5">
          <legend class="text-sm font-bold text-slate-800">這個 outcome 有重要 competing event 嗎？</legend>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <label class="cursor-pointer">
              <input type="radio" name="competing" value="no" checked class="peer sr-only" />
              <span class="block rounded-xl border border-slate-200 px-4 py-3 text-center text-sm font-semibold text-slate-600 peer-checked:border-brand-500 peer-checked:bg-brand-50 peer-checked:text-brand-700">
                沒有 / 可忽略
              </span>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="competing" value="yes" class="peer sr-only" />
              <span class="block rounded-xl border border-slate-200 px-4 py-3 text-center text-sm font-semibold text-slate-600 peer-checked:border-rose-400 peer-checked:bg-rose-50 peer-checked:text-rose-700">
                有
              </span>
            </label>
          </div>
          <p class="mt-2 text-xs text-slate-500 leading-relaxed">
            例如研究 CRC 時，death 會讓之後的 CRC 永遠不可能再發生。
          </p>
        </fieldset>
      </div>

      <div class="space-y-6">
        <div id="interpretCard" class="rounded-2xl border border-brand-200 bg-brand-50 p-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Can I call 1 − S(t) cumulative incidence?</p>
          <div class="mt-2 flex flex-wrap items-end gap-x-4 gap-y-2">
            <p id="failureProb" class="text-4xl font-bold text-brand-900">13.0%</p>
            <p id="interpretBadge" class="mb-1 rounded-full bg-white px-3 py-1 text-xs font-bold text-brand-700 border border-brand-200">
              Usually acceptable
            </p>
          </div>
          <p id="interpretText" class="mt-3 text-sm text-brand-900 leading-relaxed">
            沒有重要 competing event 時，1 − KM survival 可以作為到 5 年為止的 cumulative risk，
            前提是 ordinary censoring 可以合理視為 non-informative。
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">What the follow-up distribution gives you</p>
          <h2 class="mt-1 text-lg font-bold text-slate-900">它先告訴你：時間 t 還有多少人「看得到」</h2>

          <div class="mt-5 grid gap-4 sm:grid-cols-3">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <p class="text-xs text-slate-500">Baseline</p>
              <p id="baselineN" class="mt-1 text-2xl font-bold text-slate-900">1,000</p>
              <p class="mt-1 text-xs text-slate-500">一開始全部的人</p>
            </div>

            <div class="rounded-xl border border-slate-200 bg-white p-4">
              <p id="observableLabel" class="text-xs text-slate-500">Observable at 5 years</p>
              <p id="observableN" class="mt-1 text-2xl font-bold text-slate-900">600</p>
              <p id="retentionP" class="mt-1 text-xs text-slate-500">database retention = 60.0%</p>
            </div>

            <div id="riskBox" class="rounded-xl border border-brand-200 bg-brand-50 p-4">
              <p id="riskLabel" class="text-xs font-semibold text-brand-700">Approx. at risk at 5 years</p>
              <p id="riskN" class="mt-1 text-2xl font-bold text-brand-900">522</p>
              <p id="riskSmall" class="mt-1 text-xs text-brand-800">600 × 0.87</p>
            </div>
          </div>

          <div class="mt-6">
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
              <span>Baseline</span><span>→</span><span>Still observable</span><span>→</span><span>Still event-free</span>
            </div>
            <div class="mt-3 grid grid-cols-[1fr_auto_1fr_auto_1fr] items-center gap-2 text-center">
              <div class="rounded-xl bg-slate-100 px-3 py-5">
                <p id="flowN" class="text-xl font-bold text-slate-900">1,000</p>
              </div>
              <span class="text-slate-400">→</span>
              <div class="rounded-xl bg-slate-100 px-3 py-5">
                <p id="flowObs" class="text-xl font-bold text-slate-900">600</p>
              </div>
              <span class="text-slate-400">→</span>
              <div id="flowRiskBox" class="rounded-xl bg-brand-50 border border-brand-200 px-3 py-5">
                <p id="flowRisk" class="text-xl font-bold text-brand-900">≈522</p>
              </div>
            </div>
          </div>

          <p id="riskExplanation" class="mt-5 text-sm text-slate-600 leading-relaxed">
            如果 database follow-up duration 是「這個人在資料庫還能被觀察多久」，而且 outcome 發生後仍會繼續累積 follow-up，
            那 600 是可以直接由 follow-up distribution 數出來的。再乘上 event-free probability，可在 independent censoring
            的假設下近似 5 年時的 risk set。
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <div class="rounded-2xl border border-brand-200 bg-brand-50 p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">When 1 − S(t) is reasonable</p>
            <h3 class="mt-1 text-base font-bold text-brand-950">可以這樣用的情況</h3>
            <ul class="mt-3 space-y-2 text-sm text-brand-900 leading-relaxed">
              <li>• 主要只有一種會終止 outcome risk 的 event。</li>
              <li>• 沒有重要 competing event，或它幾乎不會影響結果。</li>
              <li>• 一般 loss to follow-up / database end 可合理視為 non-informative censoring。</li>
              <li>• 你只是把 KM survival 轉成同一個 endpoint 的 cumulative risk。</li>
            </ul>
          </div>

          <div class="rounded-2xl border border-rose-200 bg-rose-50 p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-rose-700">When it can mislead</p>
            <h3 class="mt-1 text-base font-bold text-rose-950">不應直接叫 CIF 的情況</h3>
            <ul class="mt-3 space-y-2 text-sm text-rose-900 leading-relaxed">
              <li>• Death 或其他 event 會讓 target outcome 永遠不可能再發生。</li>
              <li>• 這些 competing events 在 KM 中被當作 censoring。</li>
              <li>• 離開資料庫的人和留下的人，outcome risk 明顯不同。</li>
              <li>• 你要報的是現實世界 absolute incidence，而不是 cause-specific KM failure。</li>
            </ul>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">A subtle but important point</p>
          <h2 class="mt-1 text-lg font-bold text-slate-900">Database follow-up ≠ outcome follow-up</h2>
          <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700 overflow-x-auto">
            Index ───── outcome ───────────────── last observable record<br/>
            &nbsp;0&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 years&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;5 years
          </div>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            這個人可能在第 2 年就已經不再屬於 target-outcome risk set，但他的 TriNetX database follow-up 仍然可以是 5 年。
            所以 follow-up distribution 很適合拿來估「還有多少人能被觀察」，卻不能單獨告訴你「還有多少人尚未發生 outcome」。
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Bottom line for TriNetX</p>
          <div class="mt-4 grid gap-3">
            <div class="rounded-xl border border-slate-200 px-4 py-3">
              <p class="text-sm font-bold text-slate-900">1 − survival probability</p>
              <p class="mt-1 text-sm text-slate-600">
                可以是 cumulative risk；但有 competing event 時，不要直接稱為 competing-risk CIF。
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 px-4 py-3">
              <p class="text-sm font-bold text-slate-900">Database follow-up distribution</p>
              <p class="mt-1 text-sm text-slate-600">
                可以直接告訴你某時間點還有多少人可被資料庫觀察。
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 px-4 py-3">
              <p class="text-sm font-bold text-slate-900">Observable × survival probability</p>
              <p class="mt-1 text-sm text-slate-600">
                沒有重要 competing event、且 censoring reasonably independent 時，可以作為 number at risk 的近似；不是 observed risk table。
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Formulas — only if you want the math</p>
          <div class="mt-4 space-y-5 text-sm text-slate-700">
            <div>
              <p class="font-bold text-slate-900">1. Kaplan–Meier survival</p>
              <div class="mt-2 font-mono rounded-lg bg-slate-50 px-3 py-2">
                Ŝ<sub>KM</sub>(t) = ∏<sub>tⱼ≤t</sub> (1 − dⱼ / nⱼ)
              </div>
            </div>

            <div>
              <p class="font-bold text-slate-900">2. 沒有 competing risk 時</p>
              <div class="mt-2 font-mono rounded-lg bg-slate-50 px-3 py-2">
                Cumulative risk(t) = 1 − Ŝ<sub>KM</sub>(t)
              </div>
            </div>

            <div>
              <p class="font-bold text-slate-900">3. Database retention from individual follow-up durations</p>
              <div class="mt-2 font-mono rounded-lg bg-slate-50 px-3 py-2">
                Ĝ(t) = count(follow-upᵢ ≥ t) / N
              </div>
              <p class="mt-1 text-xs text-slate-500">因此 N × Ĝ(t) 就是時間 t 仍可在 database 被觀察的人數。</p>
            </div>

            <div>
              <p class="font-bold text-slate-900">4. 沒有重要 competing risk、且 independent censoring 時的 risk-set 近似</p>
              <div class="mt-2 font-mono rounded-lg bg-slate-50 px-3 py-2">
                E[R(t)] ≈ N × Ĝ(t) × Ŝ<sub>KM</sub>(t)
              </div>
              <p class="mt-1 text-xs text-slate-500">
                等價地：Estimated risk set ≈ N<sub>observable</sub>(t) × Ŝ<sub>KM</sub>(t)。
              </p>
            </div>

            <div>
              <p class="font-bold text-slate-900">5. 有 competing risk 時</p>
              <div class="mt-2 font-mono rounded-lg bg-slate-50 px-3 py-2">
                1 − Ŝ<sub>KM,target</sub>(t) ≠ CIF<sub>target</sub>(t)
              </div>
              <p class="mt-1 text-xs text-slate-500">
                真正的 target risk set 需要同時知道：尚未 target event、尚未 competing event、而且仍可被觀察。只靠 target KM survival + database follow-up 無法唯一重建。
              </p>
            </div>
          </div>
        </div>

        <p class="text-xs text-slate-400 leading-relaxed">
          Teaching note: this page treats TriNetX database follow-up as observation availability beyond the target outcome.
          The risk-set reconstruction is therefore explicitly labelled an approximation and depends on the stated censoring assumptions.
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    const $ = (id) => document.getElementById(id);

    function update() {
      const N = Math.max(1, Math.round(+$("N").value || 1));
      const t = Math.max(0, +$("time").value || 0);
      const S = +$("sp").value;
      const obsRaw = Math.max(0, Math.round(+$("observable").value || 0));
      const observable = Math.min(obsRaw, N);
      const competing = document.querySelector('input[name="competing"]:checked')?.value === "yes";

      $("spv").textContent = S.toFixed(2);

      const failure = Math.max(0, 1 - S);
      const retention = observable / N;
      const naiveRisk = Math.round(observable * S);
      const tLabel = Number.isInteger(t) ? String(t) : t.toFixed(1);

      $("failureProb").textContent = (failure * 100).toFixed(1) + "%";
      $("baselineN").textContent = N.toLocaleString();
      $("observableN").textContent = observable.toLocaleString();
      $("retentionP").textContent = "database retention = " + (retention * 100).toFixed(1) + "%";
      $("observableLabel").textContent = "Observable at " + tLabel + " years";
      $("flowN").textContent = N.toLocaleString();
      $("flowObs").textContent = observable.toLocaleString();

      if (!competing) {
        $("interpretCard").className = "rounded-2xl border border-brand-200 bg-brand-50 p-6";
        $("interpretBadge").className = "mb-1 rounded-full bg-white px-3 py-1 text-xs font-bold text-brand-700 border border-brand-200";
        $("interpretBadge").textContent = "Usually acceptable";
        $("failureProb").className = "text-4xl font-bold text-brand-900";
        $("interpretText").className = "mt-3 text-sm text-brand-900 leading-relaxed";
        $("interpretText").innerHTML =
          "沒有重要 competing event 時，<strong>1 − KM survival</strong> 可以作為到 " + tLabel +
          " 年為止的 cumulative risk，前提是 ordinary censoring 可以合理視為 non-informative。";

        $("riskBox").className = "rounded-xl border border-brand-200 bg-brand-50 p-4";
        $("riskLabel").className = "text-xs font-semibold text-brand-700";
        $("riskLabel").textContent = "Approx. at risk at " + tLabel + " years";
        $("riskN").className = "mt-1 text-2xl font-bold text-brand-900";
        $("riskN").textContent = naiveRisk.toLocaleString();
        $("riskSmall").className = "mt-1 text-xs text-brand-800";
        $("riskSmall").textContent = observable.toLocaleString() + " × " + S.toFixed(2);

        $("flowRiskBox").className = "rounded-xl bg-brand-50 border border-brand-200 px-3 py-5";
        $("flowRisk").className = "text-xl font-bold text-brand-900";
        $("flowRisk").textContent = "≈" + naiveRisk.toLocaleString();

        $("riskExplanation").innerHTML =
          "如果 database follow-up duration 是「這個人在資料庫還能被觀察多久」，而且 outcome 發生後仍會繼續累積 follow-up，" +
          "那 <strong>" + observable.toLocaleString() + "</strong> 是可以直接由 follow-up distribution 數出來的。" +
          "再乘上 event-free probability，可在 <strong>independent censoring</strong> 的假設下近似 " + tLabel + " 年時的 risk set。";
      } else {
        $("interpretCard").className = "rounded-2xl border border-rose-200 bg-rose-50 p-6";
        $("interpretBadge").className = "mb-1 rounded-full bg-white px-3 py-1 text-xs font-bold text-rose-700 border border-rose-200";
        $("interpretBadge").textContent = "Do not call this CIF";
        $("failureProb").className = "text-4xl font-bold text-rose-950";
        $("interpretText").className = "mt-3 text-sm text-rose-900 leading-relaxed";
        $("interpretText").innerHTML =
          "有 competing event 時，這個 <strong>" + (failure * 100).toFixed(1) +
          "%</strong> 是 KM-derived failure probability。若 competing event 被當作 censoring，" +
          "它不是現實世界真正的 target cumulative incidence function。";

        $("riskBox").className = "rounded-xl border border-rose-200 bg-rose-50 p-4";
        $("riskLabel").className = "text-xs font-semibold text-rose-700";
        $("riskLabel").textContent = "Naive S(t) × observable";
        $("riskN").className = "mt-1 text-2xl font-bold text-rose-950";
        $("riskN").textContent = "≈" + naiveRisk.toLocaleString();
        $("riskSmall").className = "mt-1 text-xs text-rose-800";
        $("riskSmall").textContent = "不能當真正 target risk set";

        $("flowRiskBox").className = "rounded-xl bg-rose-50 border border-rose-200 px-3 py-5";
        $("flowRisk").className = "text-xl font-bold text-rose-950";
        $("flowRisk").textContent = "≈" + naiveRisk.toLocaleString() + "*";

        $("riskExplanation").innerHTML =
          "Follow-up distribution 仍然可以告訴你 <strong>" + observable.toLocaleString() +
          "</strong> 人在 " + tLabel + " 年時還能被 database 觀察；但 target KM survival 如果把 competing event 當 censoring，" +
          "那再乘出來的 <strong>" + naiveRisk.toLocaleString() +
          "</strong> 只是 naive reconstruction。真正 target risk set 還必須排除已經發生 competing event 的人，單靠這兩個資訊無法唯一知道。";
      }
    }

    ["N","time","sp","observable"].forEach(id => $(id)?.addEventListener("input", update));
    document.querySelectorAll('input[name="competing"]').forEach(el => el.addEventListener("change", update));
    update();
  </script>
</BaseLayout>
