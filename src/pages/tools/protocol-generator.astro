---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// The questions that actually decide the design. `q` is plain language; `a`
// carries the methodological detail underneath it. Nothing is hidden — the
// layering is by reading order and weight, so a beginner can stop after the
// question and an expert can skip straight to the grid.
//
// Every question has more than one answer, so a route must name the answer it
// belongs to. A bare list of designs under a two-answer question is a positive
// claim with its condition stripped off: it reads as true whichever way the
// reader answered, and for three of these six questions it was then false for
// half of them. `routes` therefore carries `{ if, to }`, and a branch that
// leads nowhere says so in `note` rather than being left off the page.
const questions = [
  {
    q: "Do you have an active comparator — another drug, not 'nobody'?",
    a: "That means a drug used for the same indication, at the same point in the treatment pathway, with no a-priori link to your outcome. If one exists, a cohort design is available and is usually the better choice: people who get drug A and people who get drug B are far more alike than people who get a drug and people who get nothing, so confounding by indication is much smaller to begin with. If no such comparator exists, you are pushed towards a self-controlled or calendar-time design.",
    routes: [
      { if: "If yes", to: ["ACNU", "CCW", "ST"] },
      { if: "If no", to: ["SCCS", "CCO", "ITS", "TIT"], note: "and question 6 still applies — a rare outcome or a purely descriptive aim does not need a comparator either." },
    ],
  },
  {
    q: "Can you tell the two strategies apart on day one?",
    a: "If your strategies are 'start within 90 days', 'stay on treatment', or 'treat to target', then on day one nobody has yet declared which arm they are in. Sorting patients by what they later did credits one arm with follow-up during which they could not yet have had the event — immortal time — and that alone can manufacture a protective effect. Cloning every patient into both strategies, or emulating a fresh trial at each eligible date, is what prevents it.",
    routes: [
      { if: "If yes — each arm is declared at time zero", to: [], note: "this question does not narrow anything on its own: an ordinary new-user cohort is available, but only if question 1 found you a comparator." },
      { if: "If no — they only diverge later", to: ["CCW", "ST"] },
    ],
  },
  {
    q: "Is the exposure short-lived and the outcome sudden?",
    a: "A transient exposure plus an acute, datable onset is what makes a self-controlled design work: exposed and unexposed time both exist within the same person, so the comparison can be made inside them. Choose SCCS if you can lay out each case's whole observation period as exposed and unexposed person-time; choose case-crossover if you can only look back a short way from the event.",
    routes: [
      { if: "If yes, and you can lay out the whole observation period", to: ["SCCS"] },
      { if: "If yes, but you can only look back a short way", to: ["CCO"] },
      { if: "If no", to: [], note: "no self-controlled design applies — the other questions are the ones that route you." },
    ],
  },
  {
    q: "Is the confounding you are worried about fixed, or does it change over time?",
    a: "Genetics, lifelong habits, stable frailty — self-controlled designs remove all of these by construction, and trend-in-trend removes them through the trend contrast, in both cases without your ever having to measure them. That is a genuinely strong property. It does not extend to time-varying confounding: ageing, season, worsening disease and calendar trends in prescribing all survive, and must still be modelled explicitly.",
    routes: [
      { if: "If it is fixed", to: ["SCCS", "CCO", "TIT"] },
      { if: "If it changes over time", to: ["ACNU", "CCW", "ST"], note: "and you must have measured it — none of these removes a time-varying confounder you did not record. Where the confounder is itself affected by earlier treatment, a baseline propensity score is not enough and a g-method is needed." },
    ],
  },
  {
    q: "Was there a date — or a gradual change over the years?",
    a: "A policy, reimbursement or label change with a clear start date makes interrupted time series available: the outcome's own pre-intervention trend, extrapolated forward, becomes the counterfactual. If uptake was gradual rather than a step, there is no date to interrupt at, and trend-in-trend uses the gradient of uptake instead.",
    routes: [
      { if: "If there was a date", to: ["ITS"] },
      { if: "If uptake was gradual", to: ["TIT"] },
    ],
  },
  {
    q: "Is the outcome rare — or are you not really comparing anything?",
    a: "These are two separate questions that happen to point the same way. For a rare outcome, following an entire cohort spends most of its effort on people who never have the event; sampling controls from the source population instead is far more efficient for the same precision. And if what you want is a rate, a trend or a utilisation pattern rather than an effect, that is a descriptive analysis — legitimate and often the most useful output, provided it is not written up as though it were causal.",
    routes: [
      { if: "If the outcome is rare", to: ["CC"], note: "though a rare outcome with a good active comparator is often still a cohort study, with case-control sampling inside it for efficiency." },
      { if: "If you are not comparing treatments", to: ["DA"] },
    ],
  },
];

const families = [
  {
    id: "cohort",
    name: "Cohort designs with a comparator",
    plain: "Follow two groups of patients forward in time from the day they start treatment.",
    lede: "You can define a common time zero and follow comparable groups forward. Strongest when a genuine active comparator exists; all three are framed as target-trial emulations, which forces you to state the trial you would have run.",
  },
  {
    id: "self-controlled",
    name: "Self-controlled designs",
    plain: "No comparison group at all — each patient is compared with themselves at a different time.",
    lede: "Cases only. Every time-invariant between-person confounder is removed by construction, measured or not. The price is a strong assumption about how exposure and the event relate in time.",
  },
  {
    id: "outcome-sampled",
    name: "Outcome-sampled designs",
    plain: "Start from the people who already had the outcome, and work backwards.",
    lede: "Enrol on the outcome, sample a comparison group from the population that produced the cases, then look back for exposure. Efficient when the outcome is rare.",
  },
  {
    id: "calendar",
    name: "Calendar-time quasi-experiments",
    plain: "The comparison runs across calendar time rather than between individual patients.",
    lede: "The contrast comes from how an outcome moves over calendar time — around an intervention date, or across groups that took a drug up at different speeds. No individual-level comparator is needed.",
  },
  {
    id: "descriptive",
    name: "Descriptive",
    plain: "Counting and describing, not comparing treatments.",
    lede: "No causal contrast is attempted. Characterise a population — and supply the denominators that causal studies depend on.",
  },
];

const designs = [
  {
    family: "cohort",
    slug: "active-comparator-new-user",
    short: "ACNU",
    title: "Active-Comparator New-User Design",
    studio: true,
    plain: "Two drugs for the same condition, compared from the day each patient starts.",
    when: "The comparator behaves as an 'emulated placebo' drawn from the same therapeutic context, so confounding by indication is minimised. Aligning eligibility, treatment assignment and follow-up at time zero is what avoids immortal-time bias; requiring a washout with no prior use of either drug is what avoids prevalent-user bias.",
    assumes: "The comparator shares the indication and has no a-priori association with the outcome; no unmeasured confounding remains after propensity-score adjustment; and under an on-treatment analysis, censoring at switch or discontinuation is informative if the reasons for stopping are associated with the outcome — in which case it needs IPCW.",
    fails: "No genuine comparator exists and the honest question is 'drug vs nothing'; the comparator is chosen by disease severity; or the washout is too short, so prevalent users leak in and bring their already-survived early risk with them.",
    example: "SGLT2 inhibitors vs DPP-4 inhibitors and risk of MACE",
    cite: "Lund JL, Richardson DB, Stürmer T. Curr Epidemiol Rep 2015;2:221–228.",
    doi: "10.1007/s40471-015-0053-5",
  },
  {
    family: "cohort",
    slug: "clone-censor-weight",
    short: "CCW",
    title: "Clone-Censor-Weight",
    plain: "The strategies differ only in what happens after treatment starts, so everyone is counted in both — then dropped when they stop matching.",
    when: "Use when the strategies cannot be distinguished at time zero: grace periods ('start within X days'), sustained use, or treat-to-target. Each patient is cloned into every strategy at time zero, censored when their data stop matching the assigned strategy, and reweighted by inverse-probability-of-censoring weights to recover the per-protocol effect.",
    assumes: "Exchangeability, positivity and consistency — plus, because the artificial censoring is informative by design, no unmeasured predictors of deviation. It also requires you to give up the hazard ratio: the arms hold the same patients at time zero by construction and separate only as patients act, so the contrast begins at no difference and emerges over follow-up; proportional hazards is violated by design, and Maringe et al. advise reporting an absolute contrast — a difference in survival at the end of follow-up, or in restricted mean survival time — rather than reading a Cox hazard ratio causally.",
    fails: "The grace period is zero — the strategies are then already distinguishable at time zero, which is the situation cloning exists to avoid: each patient's two clones split at once, no person-time is shared between the arms, and an active-comparator new-user cohort is the design you want instead. It also fails if the grace period swallows most of the follow-up, or if deviation is driven by something you never measured, in which case the weights cannot repair it.",
    example: "Statin vs no statin within 90 days of MI (90-day grace period)",
    cite: "Maringe C, Benitez Majano S, Exarchakou A, et al. Int J Epidemiol 2020;49:1719–1729.",
    doi: "10.1093/ije/dyaa057",
  },
  {
    family: "cohort",
    slug: "sequential-trial",
    short: "ST",
    title: "Sequential Trial Emulation",
    plain: "Run the same small trial again and again — once at every date a patient becomes eligible — then pool the results.",
    when: "Use when eligibility is time-varying and a single index date discards everyone who qualifies later. Patients who remain eligible can enter several nested trials, so no eligible person-time is wasted, and the prevalent-user problem is handled trial by trial.",
    assumes: "Exchangeability, positivity and consistency within each nested trial — the last two assessed trial by trial, not only in the pooled data. Whether a patient can appear in more than one trial depends on which version you are running, and the two are different studies: if the control arm is those not yet treated, a patient enters a trial at every origin until they initiate, the trials are not independent samples, and the uncertainty must account for the re-use; if both arms initiate at the origin, each patient sits in one trial and it does not arise. The correction for re-use is an analysis requirement rather than an identifying assumption, and the builder will not guess which version you mean.",
    fails: "Eligibility does not actually vary over time, so every patient has one possible origin and the design collapses back to a single-origin new-user study; positivity fails within trial, because at some origins there are too few initiators for the propensity score to have support; or the confounders are themselves affected by earlier treatment, in which case a baseline propensity score fitted at each origin is not enough and a g-method is needed.",
    example: "Benzodiazepine vs no use in pregnancy, a trial at each gestational week",
    cite: "Hernán MA, Alonso A, Logan R, et al. Epidemiology 2008;19:766–779.",
    doi: "10.1097/EDE.0b013e3181875e61",
  },
  {
    family: "self-controlled",
    slug: "self-controlled-case-series",
    short: "SCCS",
    title: "Self-Controlled Case Series",
    studio: true,
    plain: "Only people who had the event; compare their risk during exposed and unexposed stretches of their own lives.",
    when: "Use for transient exposures and acute outcomes, especially where cases are far easier to identify than the source population. Each case's observation period is split into exposed and unexposed person-time and the incidence-rate ratio is estimated within the person, so all time-invariant between-person confounding disappears.",
    assumes: "The event does not alter the probability of subsequent exposure, and does not end observation; repeat events within a person are independent, which fails for clustered outcomes such as recurrent falls or repeat admissions for one episode and makes the confidence intervals too narrow — restrict to the first event per person, or justify independence explicitly; and time-varying confounders such as age and season are modelled explicitly. A pre-exposure window is conventionally separated out and its incidence-rate ratio reported as a parameter in its own right — a raised one is a finding about confounding by indication, not a nuisance to be absorbed.",
    fails: "The outcome is fatal or otherwise censors follow-up; the event itself changes prescribing (event-dependent exposure — e.g. the drug is stopped after the event); or the exposure is chronic and continuous, leaving no unexposed person-time to contrast.",
    example: "Antipsychotic dispensing and risk of falls in older adults",
    cite: "Petersen I, Douglas I, Whitaker H. BMJ 2016;354:i4515.",
    doi: "10.1136/bmj.i4515",
  },
  {
    family: "self-controlled",
    slug: "case-crossover",
    short: "CCO",
    title: "Case-crossover",
    studio: true,
    plain: "Only people who had the event; ask whether they were exposed just before it more often than at earlier moments.",
    when: "Outcome-anchored: enrol patients on the acute event itself, then look back and compare exposure prevalence in a short hazard window immediately before onset with prevalence in matched control windows further back. Because each case is their own control, the matched analysis removes time-invariant between-person confounding automatically; what it cannot remove is anything that changes within the person across the look-back.",
    assumes: "Exposure is transient and its prevalence does not trend over time — within the person, not only across the calendar; the outcome has abrupt onset; and there is no carry-over from the control windows into the hazard window.",
    fails: "Exposure prevalence trends over time, because the hazard window is always more recent than the control windows. A time-stratified referent removes the calendar-time part of that, and a case-time-control or case-case-time-control subtracts the part shared with a comparison series; none of them removes a trend specific to the individual, such as a dose escalated as that person deteriorates. Chronic exposure or insidious onset breaks the design outright.",
    example: "Triggers of acute MI in the 24 hours before onset",
    cite: "Maclure M. Am J Epidemiol 1991;133:144–153.",
    doi: "10.1093/oxfordjournals.aje.a115853",
  },
  {
    family: "outcome-sampled",
    slug: "case-control",
    short: "CC",
    title: "Case-Control",
    plain: "Take the people who had the outcome and similar people who did not, then look back at who was exposed.",
    when: "Use when the outcome is rare and following a whole cohort is wasteful. Enrol on the outcome, sample controls from the source population — risk-set, cumulative, or case-cohort — optionally match, and ascertain exposure before the index date.",
    assumes: "Controls come from the same source population that produced the cases, and exposure is ascertained identically in both. Under risk-set (incidence-density) sampling the odds ratio estimates the incidence-rate ratio with no rare-disease assumption; under cumulative sampling it approximates the risk ratio only if the outcome is rare; under case-cohort sampling it estimates the risk ratio over a fixed cohort with complete follow-up, whereas the Prentice-weighted analysis used when follow-up is censored estimates a hazard ratio instead.",
    fails: "Controls are drawn from a different population (selection bias), or exposure is measured differently in cases and controls. Individually matched sets must be analysed by conditional logistic regression — and the matching factors must not then also be adjusted as covariates; frequency matching reverses both halves of that rule.",
    example: "NSAIDs and hospitalised upper-GI bleeding, 4:1 risk-set-matched controls",
    cite: "Vandenbroucke JP, Pearce N. Int J Epidemiol 2012;41:1480–1489.",
    doi: "10.1093/ije/dys147",
  },
  {
    family: "calendar",
    slug: "interrupted-time-series",
    short: "ITS",
    title: "Interrupted Time Series",
    studio: true,
    plain: "Something changed on a known date — did the outcome jump, or bend away from where it was already heading?",
    when: "Use for a population-level intervention or policy with a clear date. Segmented regression separates an immediate change in level from a change in slope, using the extrapolated pre-intervention trend as the counterfactual. A control series turns it into a controlled ITS.",
    assumes: "The pre-intervention trend would have continued unchanged had the intervention not happened; there are enough points either side to estimate that trend (the ITS template asks for at least 8 on each side of the interruption, ideally 12 — a conventional minimum, not a threshold from the tutorial cited below); and seasonality and autocorrelation are handled rather than ignored.",
    fails: "A co-intervention or secular change coincides with the interruption — a control series differences that out. Too few pre-period points, or unmodelled seasonality, and the level and slope estimates are not trustworthy even when they look clean.",
    example: "Effect of a 2019 reimbursement policy on monthly SGLT2-inhibitor initiation rates",
    cite: "Lopez Bernal J, Cummins S, Gasparrini A. Int J Epidemiol 2017;46:348–355.",
    doi: "10.1093/ije/dyw098",
  },
  {
    family: "calendar",
    slug: "trend-in-trend",
    short: "TIT",
    title: "Trend-in-Trend",
    plain: "A drug's use climbed over the years — did the outcome climb faster in the groups where it caught on faster?",
    when: "Use when there is no single intervention date, but the drug's prevalence of use rises or falls markedly over calendar time. Strata are defined by each person's cumulative probability of exposure (CPE) — the probability of being exposed at some point in the study period, predicted from a stage-1 model of covariates that affect exposure, not an observed percentage exposed; if the outcome tracks the exposure trend more steeply where uptake was faster, that supports a causal effect — and the estimate is robust to time-invariant unmeasured confounding.",
    assumes: "Exposure prevalence genuinely trends over calendar time; the unmeasured confounding is time-invariant; and the outcome trend is otherwise stable across CPE strata.",
    fails: "The prevalence trend is flat or weak, so the design has no power; or a differential secular trend or co-intervention tracks faster uptake, which biases it — pre-specify a negative-control outcome or a pseudo-period to check.",
    example: "Statins and incident diabetes, using the rise in statin prevalence 2005–2018",
    cite: "Ji X, Small DS, Leonard CE, Hennessy S. Epidemiology 2017;28:529–536.",
    doi: "10.1097/EDE.0000000000000579",
  },
  {
    family: "descriptive",
    slug: "descriptive-analysis",
    short: "DA",
    title: "Descriptive analysis",
    plain: "How common is it, who gets it, how is the drug used — and is that changing? No treatments are compared.",
    when: "Use when you want to characterise a population rather than test a causal hypothesis. Covers incidence, prevalence, mortality, drug utilisation and switching, with age-standardisation and joinpoint trend detection built in. The standard output for multi-country comparisons, and the denominator that causal studies depend on.",
    assumes: "Case ascertainment and denominator definitions are comparable across the sites and periods you compare, and the denominator is built on the same rule as the numerator. No causal interpretation is intended, and none should be written in.",
    fails: "Coding and capture practices differ between databases and the difference is read as a real one; or the denominator is aggregated by a different rule from the outcome, which manufactures a trend that is not there.",
    example: "DDD/1000/day for anticonvulsants across Asian sites, 2010–2023, with joinpoint break detection",
    cite: "Lai ECC, Stang P, Yang YHK, et al. Curr Epidemiol Rep 2015;2:229–238.",
    doi: "10.1007/s40471-015-0059-z",
  },
];

const byFamily = families.map((f) => ({
  ...f,
  items: designs.filter((d) => d.family === f.id),
}));

// One map, derived from the cards themselves, so a chip can never name a design
// the page does not define — the failure this codebase keeps finding is a
// hand-kept lookup drifting away from the list it was copied from. Build-time,
// so a typo fails `astro build` rather than shipping a chip that scrolls nowhere.
const titleOf = Object.fromEntries(designs.map((d) => [d.short, d.title]));
for (const q of questions) {
  for (const r of q.routes) {
    for (const s of r.to) {
      if (!titleOf[s]) throw new Error(`protocol-generator: route "${r.if}" of "${q.q}" names "${s}", which is not one of the ${designs.length} designs.`);
    }
  }
}

const studioShorts = designs.filter((d) => d.studio).map((d) => d.short);
const studioDesigns =
  studioShorts.length > 1
    ? studioShorts.slice(0, -1).join(", ") + " and " + studioShorts[studioShorts.length - 1]
    : studioShorts[0] ?? "no designs yet";
---

<BaseLayout
  title="Protocol Generator — Daniel Tsai"
  description="A free, in-browser protocol generator for multi-national pharmacoepidemiology study designs — nine designs, a guide to choosing between them, a phenotype library that says which definitions carry a validation study, and one-click Word / Markdown export."
>
  <header class="relative bg-gradient-to-br from-brand-50 via-white to-brand-100/40 border-b border-slate-200 overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14">
      <p class="uppercase tracking-widest text-xs text-brand-600 font-semibold mb-2">RWE Tools</p>
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900">Protocol Generator</h1>
      <p class="mt-4 text-lg text-slate-600 max-w-3xl">
        Nine pharmacoepidemiology study designs, each with a guided form that drafts a multi-country protocol —
        a phenotype library of published code sets that says which definitions carry a validation study and which
        do not, feasibility checks across Asian databases, consistency checks that flag
        design errors as you type, and one-click Word / Markdown export. Everything runs in your browser; nothing
        is uploaded.
      </p>
      <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <a href="#choosing" class="font-semibold text-brand-700 hover:underline">Help me choose a design ↓</a>
        <a href="#designs" class="font-semibold text-slate-600 hover:underline">I know what I want — go to the nine designs ↓</a>
      </p>
      <p class="mt-4 text-sm text-slate-500 max-w-3xl">
        Templates curated from <a href="https://ocean-dev.phdcenter.org.tw" target="_blank" rel="noopener" class="text-brand-700 font-semibold hover:underline">OCEAN</a>,
        the Open Causal Effect Analysis Network operated by the
        <a href="https://www.phdcenter.org.tw/" target="_blank" rel="noopener" class="text-brand-700 hover:underline">PHDc</a>, NCKU.
        Maintained by Daniel Tsai.
      </p>
    </div>
  </header>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <a class="text-sm text-brand-700 hover:underline font-semibold" href={`${base}/tools`}>← All RWE tools</a>

    <div id="choosing" class="scroll-mt-24">
      <h2 class="text-2xl font-bold text-slate-900">Which design does my question need?</h2>

      <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50/70 p-6">
        <p class="text-sm font-semibold text-slate-900">If study design is new to you, start here</p>
        <p class="mt-2 text-sm text-slate-600 leading-relaxed">
          A study design is the recipe for three things: who gets counted, when each person's clock starts, and what
          they are compared with. In pharmacoepidemiology, most serious errors are design errors rather than
          statistical ones — people already taking the drug get counted as new starters, follow-up during which an
          event could not yet have been recorded gets credited to one arm, or two groups turn out to differ by how
          sick they were rather than by the drug. Each design below arranges the data so that one particular error
          cannot happen, and pays for it with an assumption you then have to defend. The six questions below narrow
          the nine designs to the few worth considering. They are <strong>not a decision tree</strong>: more than one
          design is often defensible, and when two questions point different ways that is a real feature of your
          research question rather than a defect in these six.
        </p>
      </div>

      <p class="mt-5 text-sm text-slate-600 max-w-3xl leading-relaxed">
        A good protocol names the design it did <em>not</em> choose, and says why.
      </p>

      <ol class="mt-5 space-y-3">
        {questions.map((q, i) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-start gap-4">
              <span class="shrink-0 mt-0.5 inline-flex h-7 w-7 items-center justify-center rounded-full bg-brand-100 text-brand-700 text-xs font-bold">{i + 1}</span>
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-slate-900">{q.q}</p>
                <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">{q.a}</p>
                <div class="mt-3 space-y-3">
                  {q.routes.map((r) => (
                    <p class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1">
                      <span class="text-[11px] font-semibold text-slate-500">{r.if} →</span>
                      {r.to.map((s) => (
                        <a href={`#${s}`} title={titleOf[s]} aria-label={`${s} — ${titleOf[s]}`}
                           class="inline-block rounded-full border border-brand-200 bg-brand-50 px-2.5 py-1 text-[11px] font-bold tracking-wide text-brand-700 hover:bg-brand-100 transition">{s}</a>
                      ))}
                      {r.note && <span class="text-[11px] text-slate-500 italic leading-relaxed">{r.note}</span>}
                    </p>
                  ))}
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <p class="mt-5 rounded-2xl border border-amber-200 bg-amber-50/70 p-5 text-sm text-slate-700 leading-relaxed">
        <span class="font-semibold text-slate-900">One caution.</span> Every design here removes some confounding and
        leaves the rest. The self-controlled designs remove time-invariant confounding without measuring it, but that
        does not make the two interchangeable: SCCS uses the whole observation period, so it is unusable if the event
        changes later exposure, while a case-crossover looking only backwards never samples post-event exposure and is
        untouched by it — the bidirectional referent offered as a sensitivity analysis gives that immunity up. What
        breaks the case-crossover is a trend in exposure prevalence, and chronic exposure or insidious onset breaks it
        outright. The cohort designs handle time-varying
        confounding, but only for what you actually measured. Choose on the assumption you can defend, not on the
        estimate you would prefer — and pre-specify the analysis that would show you were wrong.
      </p>
    </div>

    <div id="designs" class="scroll-mt-24 space-y-12">
      {byFamily.map((f) => (
        <div>
          <h2 class="text-2xl font-bold text-slate-900">{f.name}</h2>
          <p class="mt-1.5 text-base text-slate-700 max-w-3xl leading-relaxed">{f.plain}</p>
          <p class="mt-1.5 text-sm text-slate-500 max-w-3xl leading-relaxed">{f.lede}</p>

          <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {f.items.map((d) => (
              <div id={d.short}
                   class="scroll-mt-24 flex flex-col border border-slate-200 rounded-2xl p-6 bg-white hover:shadow-md hover:border-brand-400 transition">
                <div class="flex items-center justify-between gap-2">
                  <p class="text-[10px] uppercase tracking-[0.2em] text-brand-700 font-bold">{d.short}</p>
                  {d.studio && (
                    <span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-slate-500">Runs in Studio</span>
                  )}
                </div>

                <h3 class="mt-2 text-lg font-bold text-slate-900 leading-snug">
                  <a href={`${base}/tools/${d.slug}`} class="hover:text-brand-700 hover:underline transition">{d.title}</a>
                </h3>

                <p class="mt-2 text-sm text-slate-800 leading-relaxed">{d.plain}</p>

                <p class="mt-4 text-[11px] font-semibold text-slate-500 uppercase tracking-widest">Use when</p>
                <p class="text-xs text-slate-600 leading-relaxed">{d.when}</p>

                <p class="mt-3 text-[11px] font-semibold text-slate-500 uppercase tracking-widest">Assumes</p>
                <p class="text-xs text-slate-600 leading-relaxed">{d.assumes}</p>

                <p class="mt-3 text-[11px] font-semibold text-rose-700 uppercase tracking-widest">Breaks when</p>
                <p class="text-xs text-slate-600 leading-relaxed">{d.fails}</p>

                <p class="mt-3 text-[11px] font-semibold text-brand-700">Typical example</p>
                <p class="text-xs text-slate-700 italic leading-relaxed">{d.example}</p>

                <p class="mt-3 text-[11px] text-slate-500 leading-relaxed flex-1">
                  {d.cite}{" "}
                  <a href={`https://doi.org/${d.doi}`} target="_blank" rel="noopener"
                     class="text-brand-700 hover:underline break-all">doi:{d.doi}</a>
                </p>

                <a href={`${base}/tools/${d.slug}`}
                   class="mt-4 text-xs text-brand-700 font-semibold hover:underline">Open this template →</a>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      <a href={`${base}/tools/protocol-checker`}
         class="group flex flex-col rounded-2xl border border-brand-200 bg-brand-50/60 p-6 hover:shadow-md hover:border-brand-400 transition">
        <p class="text-[10px] uppercase tracking-[0.2em] text-brand-700 font-bold">Already have a protocol?</p>
        <h2 class="mt-1 text-lg font-bold text-slate-900 group-hover:text-brand-700 transition">Check it against HARPER or TARGET</h2>
        <p class="mt-2 text-sm text-slate-600 leading-relaxed flex-1">
          The flip side of the generator. Upload an existing protocol and get an AI-assisted, item-by-item read on
          whether it conforms to HARPER (the ISPE/ISPOR protocol template) or TARGET — with an auto-drawn study-design
          scheme, a planned-outputs review, and fixes for anything missing.
        </p>
        <span class="mt-4 text-sm font-semibold text-brand-700 group-hover:underline">Open the checker →</span>
      </a>

      <a href={`${base}/tools/rwe-studio`}
         class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md hover:border-brand-400 transition">
        <p class="text-[10px] uppercase tracking-[0.2em] text-brand-700 font-bold">Already have the data?</p>
        <h2 class="mt-1 text-lg font-bold text-slate-900 group-hover:text-brand-700 transition">Run the analysis in RWE Studio</h2>
        <p class="mt-2 text-sm text-slate-600 leading-relaxed flex-1">
          The templates above draft the protocol. RWE Studio takes a small, messy dataset, profiles and cleans it,
          maps your columns to a design and runs the analysis in real R via WebR — in the browser, with nothing
          uploaded. It currently runs {studioDesigns}; the other templates here are protocol builders only.
        </p>
        <span class="mt-4 text-sm font-semibold text-brand-700 group-hover:underline">Open RWE Studio →</span>
      </a>
    </div>
  </section>
</BaseLayout>
