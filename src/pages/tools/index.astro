---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { toolsList } from "../../data/tools";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const tools = toolsList(base);
---

<BaseLayout
  title="RWE Tools — Daniel Tsai"
  titleZh="RWE 工具｜蔡相德 Daniel Tsai"
  descriptionZh="打開瀏覽器就能用的 real-world evidence 工具：Protocol Generator、Protocol Checker、NHIRD 資料字典、ACB 計算機、phenotype library 等。"
  description="Open real-world-evidence tools in the browser: Protocol Generator, Protocol Checker, NHIRD data dictionary, ACB calculator, phenotype library and more."
>
  <header class="relative bg-gradient-to-br from-brand-50 via-white to-brand-100/40 border-b border-slate-200 overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14">
      <p class="uppercase tracking-widest text-xs text-brand-600 font-semibold mb-2"><span class="l-en">Infrastructure</span><span class="l-zh">基礎建設</span></p>
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900"><span class="l-en">RWE Tools</span><span class="l-zh">RWE 工具</span></h1>
      <p class="mt-4 text-lg text-slate-600 max-w-3xl l-zh">
        打開瀏覽器就能用的 real-world evidence 工具。
      </p>
      <p class="mt-4 text-lg text-slate-600 max-w-3xl l-en">
        Open tools for real-world evidence, in your browser.
      </p>
    </div>
  </header>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
    <a class="text-sm text-brand-700 hover:underline font-semibold" href={`${base}/`}>← <span class="l-en">Back to home</span><span class="l-zh">回首頁</span></a>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((t) => (
        <a href={t.href}
           class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:border-brand-400 transition">
          <h2 class="text-lg font-bold text-slate-900 group-hover:text-brand-700">{t.name}</h2>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed flex-1"><span class="l-en">{t.blurb}</span><span class="l-zh">{t.blurbZh}</span></p>
          <p class="mt-3 text-xs text-slate-500"><span class="l-en italic">{t.note}</span><span class="l-zh">{t.noteZh}</span></p>
          <span class="mt-4 text-sm font-semibold text-brand-700 group-hover:underline"><span class="l-en">{t.cta}</span><span class="l-zh">{t.ctaZh}</span> →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
