      // amber note rather than a silently absent figure, so the protocol still
      // exports and the page can say which of the two you got.
      lastFigNote = "";
      const __cap = "Figure 1. Study design diagram — segmented regression on a calendar-time axis: the pre-intervention trend, the interruption, the post-intervention trend, and the pre-intervention trend extrapolated forward as the counterfactual.";
      const fig = await window.designDiagramFigure(document.getElementById("diagram"), { caption: __cap });
      // This page draws its own SVG rather than calling renderDesignDiagram, so
      // the shared component holds no window spec for it and fig.lines comes back
      // empty. opts.lines is the supported way to supply the written description;
      // without it the figure reaches a text-only reader as a caption with
      // nothing under it, and that text is what carries HARPER 7.2.
      const __figLines = [
        "Time axis: " + unitPhrase(s.unit) + " intervals of calendar time (this design is not anchored to a person-level day 0).",
        "Pre-intervention segment: " + ptsText(prePts(s)) + " " + unitPhrase(s.unit) + " point(s) before the interruption; the trend fitted here is extrapolated forward as the counterfactual.",
        "Interruption: " + Dt + (I ? " — " + I : "") + (s.lag ? " (transition / phase-in: " + s.lag + ")" : ""),
        "Post-intervention segment: " + ptsText(postPts(s)) + " " + unitPhrase(s.unit) + " point(s) from the interruption onward.",
        "Estimated at the interruption: the change in level (immediate step) and the change in slope (trend).",
      ].concat(s.controlled ? ["Control series: " + or(s.controlSeries, "(a comparison series unaffected by the intervention)") + " — same calendar periods, differenced against the intervention series."] : [])
      // The picture draws at most 36 points a segment and the on-screen caption
      // says so; that sentence never travelled, so a 60-point series exported a
      // figure of 36 under bullets asserting 60. This is the figure's only
      // machine-readable description, so it has to carry the disclaimer too.
      .concat((() => {
        const pp = prePts(s), qp = postPts(s);
        const drawn = (p) => Math.max(2, Math.min(36, p.state === "ok" && p.n > 0 ? p.n : 24));
        if ((pp.state === "ok" && pp.n > 36) || (qp.state === "ok" && qp.n > 36))
          return ["Schematic: the figure draws at most 36 points per segment, so it shows " + drawn(pp) + " before and " + drawn(qp) + " after. The counts above are the protocol's; the picture is illustrative."];
        if (pp.state !== "ok" || qp.state !== "ok" || pp.n === 0 || qp.n === 0)
          return ["Schematic: at least one segment length was left empty, zero or unreadable, so the figure falls back to an illustrative " + drawn(pp) + " / " + drawn(qp) + " points and is NOT showing this study's series."];
        return [];
      })());
      const figParas = window.designDiagramDocx(D, fig, { font: FONT, caption: __cap, lines: __figLines });
      figParas.forEach((c) => children.push(c));
      if (!figParas.placed) lastFigNote = " Exported WITHOUT the design diagram: " + (fig.reason || figParas.error || "unknown reason") + ". The document says so where the figure should be.";

      children.push(h1("4. Time series construction"));
      // The full stop used to live INSIDE the or() fallback, so a supplied
      // denominator ran two sentences together ("…person-months Each interval
      // is indexed…") in the Word file while the Markdown, which puts it
      // outside, read correctly. Two exports of one section, differing.
      children.push(para("The outcome is aggregated per " + unitPhrase(s.unit) + " interval (" + ptsText(prePts(s)) + " pre + " + ptsText(postPts(s)) + " post points)." + (s.model === "poisson" ? " Denominator / offset: " + or(s.denom, "(person-time / eligible population, entered as a log offset)") + "." : "") + " Each interval is indexed by a continuous time variable; an interruption indicator marks intervals from " + Dt + " onward; and a time-since-interruption variable is coded 0 at the first affected period and counts up from there. " + CODING_NOTE + (s.lag ? " Transition / phase-in: " + s.lag + "." : "")));

      children.push(h1("5. Model specification"));
      children.push(para("The outcome is modelled with " + modelText(s.model) + ". The segmented model estimates the baseline level and pre-intervention slope, the change in level (step at the interruption), and the change in slope (post minus pre). " + seasonText(s.seasonality) + ". " + autocorrText(s.autocorr) + "." + (s.controlled ? " A control series (" + or(s.controlSeries, "a comparison series unaffected by the intervention") + ") is included with group-by-segment interactions, so the difference in level and slope changes is the primary estimate." : "")));

      children.push(h1("6. Estimand and effect measures"));
      children.push(para("Primary estimands: " + effectText(s) + "."));
      children.push(para("We also report the absolute and relative difference between the observed outcome and " + cfText(s) + ", with 95% confidence intervals, " + HORIZON_AT + ". " + HORIZON_WHY));

      children.push(h1("7. Statistical analysis"));
      ["Construct the aggregated series and the segmented-regression design matrix (time, interruption, time-since-interruption" + (s.controlled ? ", control group, and interactions" : "") + ").",
       "Fit the " + (s.model === "linear" ? "segmented linear" : "segmented Poisson / negative-binomial") + " model. " + autocorrText(s.autocorr) + ".",
       (s.seasonality === "none" ? "Assess seasonality and, if present, adjust for it." : "Fit the seasonality terms specified in §5 (" + SEASON_LABEL[s.seasonality] + ") and report how many terms were used."),
       "Report the level change and slope change (95% CI); plot the observed series with fitted segments and the counterfactual; estimate the difference-from-counterfactual " + HORIZON_AT + ".",
       "Check model fit and residual autocorrelation (Durbin–Watson, ACF/PACF) and refit if indicated."].forEach((l) => children.push(numItem(l)));

      children.push(h1("8. Subgroup analyses"));
      (subg.length ? subg : ["(none pre-specified)"]).forEach((l) => children.push(bullet(l)));

      children.push(h1("9. Sensitivity analyses"));
      (sens.length ? sens : ["(none pre-specified)"]).forEach((l) => children.push(bullet(l)));

      window.PC.tailDocx(D, pcOf(s)).forEach((c) => children.push(c));

      children.push(h1("References"));
      REFS.forEach((l) => children.push(bullet(l)));

      children.push(p([new D.TextRun({ text: "Drafted with the Protocol Generator (" + today + ").", font: FONT, size: 18, italics: true, color: "808080" })], { spacing: { before: 400 } }));

      const doc = new D.Document({
        creator: "Protocol Generator — Interrupted Time Series",
        title: "ITS protocol — " + (s.title || "study"),
        styles: { default: { document: { run: { font: FONT, size: 22 } } }, paragraphStyles: [
          { id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 28, bold: true, font: FONT }, paragraph: { spacing: { before: 200, after: 80 }, outlineLevel: 0 } },
        ] },
        numbering: { config: [{ reference: "ordered", levels: [{ level: 0, format: D.LevelFormat.DECIMAL, text: "%1.", alignment: D.AlignmentType.LEFT, style: { paragraph: { indent: { left: 720, hanging: 360 } } } }] }] },
        sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }],
      });
      return await D.Packer.toBlob(doc);
    };

    // A failed Word export used to do nothing and say nothing: `catch (e) {}`
    // around the whole thing, and a bare `return` when the docx library had not
    // loaded. The button simply appeared not to work.
    document.querySelector("[data-action='download-docx']").addEventListener("click", async () => {
      if (!window.docx) {
        setMsg("The Word library has not loaded, so the .docx cannot be built. Check your connection and reload the page — the Markdown export still works meanwhile.", true);
        return;
      }
      setMsg("Building the Word document…");
      try {
        const name = fname("docx");
        dl(await buildDocx(readForm()), name);
        setMsg("Downloaded " + name + "." + lastFigNote, !!lastFigNote);
      } catch (err) {
        console.error("[ITS] Word export failed", err);
        setMsg("Could not build the Word file: " + ((err && err.message) || err) + ". Nothing was downloaded.", true);
      }
    });
  </script>
</BaseLayout>
