---
// Phenotype library as a page of its own. It reads src/data/phenotypes.ts, the
// same data the protocol builders' "Library" modal uses, so there is one
// source; the studies behind each entry come from phenotype-evidence.ts. Every
// entry has a stable anchor (#slug of its name): a link such as
// /tools/phenotypes#lennox-gastaut-syndrome-lgs scrolls to that entry and
// briefly highlights it. ?q=… fills the search box.
//
// Entries and studies are reference data and stay in English in both
// languages; the page around them is translated.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { PHENOTYPES, AREAS, tierOf } from "../../data/phenotypes";
import type { Phenotype, Validation, HighImpactUse, Area } from "../../data/phenotypes";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const NHI_DRUGS = "https://danielhttsai.github.io/nhird-data-dictionary/drugs/";

const slugOf = (name: string) =>
  name.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

const SECTIONS = [
  { key: "indications", en: "Conditions and populations", zh: "疾病與族群" },
  { key: "exposures", en: "Drugs (exposure or comparator)", zh: "藥品（暴露或對照）" },
  { key: "outcomes", en: "Outcomes", zh: "Outcome" },
] as const;

// Within a section, entries are grouped by clinical area in the order AREAS
// lists them; inside an area they keep the data file's order.
const areaOrder = Object.keys(AREAS) as Area[];
const groups = SECTIONS.map((s) => {
  const items = (PHENOTYPES as Record<string, Phenotype[]>)[s.key] ?? [];
  const areas = areaOrder
    .map((a) => ({ key: a, ...AREAS[a], items: items.filter((p) => (p.area ?? "other") === a) }))
    .filter((a) => a.items.length);
  return { ...s, items, areas };
});
const all = groups.flatMap((g) => g.items);
const total = all.length;
const nValidated = all.filter((p) => tierOf(p) === "validated").length;
const nHigh = all.filter((p) => tierOf(p) === "highImpact").length;
const nNone = total - nValidated - nHigh;
const nStudies = all.reduce((n, p) => n + (p.validations?.length ?? 0), 0);

// Filter choices: countries, and databases grouped by country. A database
// label such as "Hospital data" recurs across countries, so a row is keyed by
// "country|database".
type Row = Validation | HighImpactUse;
const rowsOf = (p: Phenotype): Row[] => [...(p.validations ?? []), ...(p.highImpact ?? [])];
const COUNTRY_ORDER = ["Taiwan", "Korea", "Japan", "Hong Kong", "China", "Singapore", "Thailand", "Malaysia", "Australia", "New Zealand"];
const byCountry = new Map<string, Map<string, number>>();
for (const p of all) for (const r of rowsOf(p)) {
  const m = byCountry.get(r.country) ?? new Map<string, number>();
  m.set(r.db, (m.get(r.db) ?? 0) + 1);
  byCountry.set(r.country, m);
}
const rank = (c: string) => (COUNTRY_ORDER.includes(c) ? COUNTRY_ORDER.indexOf(c) : 100);
const countries = [...byCountry.keys()].sort((a, b) => rank(a) - rank(b) || a.localeCompare(b));
const countryZh: Record<string, string> = {
  Taiwan: "台灣", Korea: "韓國", Japan: "日本", "Hong Kong": "香港", China: "中國", Singapore: "新加坡", Thailand: "泰國",
  Malaysia: "馬來西亞", Australia: "澳洲", "New Zealand": "紐西蘭", USA: "美國", Canada: "加拿大", Denmark: "丹麥",
  Finland: "芬蘭", France: "法國", Germany: "德國", Italy: "義大利", Netherlands: "荷蘭",
};
const dbCount = (c: string) => [...(byCountry.get(c)?.values() ?? [])].reduce((a, b) => a + b, 0);

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const linkify = (s: string) =>
  esc(s)
    .replace(/\b(10\.\d{4,9}\/[^\s;,)]+[^\s;,.)])/g, '<a href="https://doi.org/$1" target="_blank" rel="noopener">$1</a>')
    .replace(/\bPMID:? ?(\d{6,9})\b/g, '<a href="https://pubmed.ncbi.nlm.nih.gov/$1/" target="_blank" rel="noopener">PMID $1</a>');
const rowHay = (r: Row) => Object.values(r).filter((v) => typeof v === "string").join(" ");
const haystack = (p: Phenotype) =>
  [p.name, p.codes, p.definition, p.notes, ...(p.atc ?? []), ...rowsOf(p).map(rowHay)].filter(Boolean).join(" ").toLowerCase();
// Long lists show the first few studies (Taiwan first, then the region) and a
// button for the rest; a country or database filter shows every match.
const SHOW = 4;
const others = (v: Validation) =>
  [v.spec && `Spec ${v.spec}`, v.npv && `NPV ${v.npv}`, v.kappa && `κ ${v.kappa}`, v.agree].filter(Boolean) as string[];
---

<BaseLayout
  title="Phenotype library — Daniel Tsai"
  titleZh="Phenotype library｜蔡相德 Daniel Tsai"
  description="Code sets for conditions, drugs and outcomes, ICD-10 first, with the studies that validated them in NHIRD, CGRD, Korean, Japanese, Hong Kong and other databases."
  descriptionZh="疾病、藥品與 outcome 的代碼定義，以 ICD-10 為主，附 NHIRD、CGRD、韓國、日本、香港等資料庫的驗證研究。"
>
  <PageHeader
    eyebrow="RWE Tools"
    eyebrowZh="RWE 工具"
    title="Phenotype library"
    titleZh="Phenotype library"
    description={`${total} code sets for conditions, drugs and outcomes, ICD-10 first, with ${nStudies} validation studies from Taiwan, Asia and beyond.`}
    descriptionZh={`${total} 組疾病、藥品與 outcome 的代碼定義，以 ICD-10 為主，附台灣、亞洲及其他地區的 ${nStudies} 篇驗證研究。`}
  />

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
    <a class="text-sm text-brand-700 hover:underline font-semibold" href={`${base}/tools`}>← <span class="l-en">RWE Tools</span><span class="l-zh">RWE 工具</span></a>

    <p class="mt-6 text-sm text-slate-700 leading-relaxed max-w-3xl">
      <span class="l-en"><b class="text-brand-700">Validated ({nValidated})</b>: compared with a reference standard such as chart review, accuracy measured. <b class="text-amber-700">Used in a high-impact study ({nHigh})</b>: a definition from a journal with impact factor ≥ 15, not validated. <b class="text-slate-600">No published source ({nNone})</b>: check or validate before use.</span>
      <span class="l-zh"><b class="text-brand-700">已驗證（{nValidated}）</b>：與病歷審查等參考標準比對，量過準確度。<b class="text-amber-700">高影響力期刊研究使用（{nHigh}）</b>：影響係數 ≥ 15 期刊用過的定義，未經驗證。<b class="text-slate-600">無公開來源（{nNone}）</b>：使用前請先檢查或驗證。</span>
    </p>

    <div class="mt-4 sticky top-16 z-10 bg-white/95 backdrop-blur py-3 border-b border-slate-200">
      <div class="flex flex-wrap gap-2">
        <label class="w-full sm:w-auto sm:flex-1">
          <span class="sr-only"><span class="l-en">Search the library</span><span class="l-zh">搜尋 phenotype library</span></span>
          <input
            type="search"
            data-ph-search
            autocomplete="off"
            placeholder="Search: MI, SGLT2, I21, Cheng …"
            data-i18n-attr="placeholder"
            data-en-placeholder="Search: MI, SGLT2, I21, Cheng …"
            data-zh-placeholder="搜尋：MI、SGLT2、I21、Cheng …"
            class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-base sm:text-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100"
          />
        </label>
        <label class="flex-1 sm:flex-none">
          <span class="sr-only"><span class="l-en">Country</span><span class="l-zh">國家</span></span>
          <select data-ph-country class="w-full sm:w-40 rounded-lg border border-slate-300 bg-white px-2 py-2.5 text-base sm:text-sm focus:border-brand-600 focus:outline-none">
            <option value="" data-i18n-attr="label" data-en-label="All countries" data-zh-label="所有國家" label="All countries">All countries</option>
            {countries.map((c) => (
              <option value={c} data-i18n-attr="label" data-en-label={`${c} (${dbCount(c)})`} data-zh-label={`${countryZh[c] ?? c}（${dbCount(c)}）`} label={`${c} (${dbCount(c)})`}>{c}</option>
            ))}
          </select>
        </label>
        <label class="flex-1 sm:flex-none">
          <span class="sr-only"><span class="l-en">Database</span><span class="l-zh">資料庫</span></span>
          <select data-ph-db class="w-full sm:w-48 rounded-lg border border-slate-300 bg-white px-2 py-2.5 text-base sm:text-sm focus:border-brand-600 focus:outline-none">
            <option value="" data-i18n-attr="label" data-en-label="All databases" data-zh-label="所有資料庫" label="All databases">All databases</option>
            {countries.map((c) => (
              <optgroup label={c} data-i18n-attr="label" data-en-label={c} data-zh-label={countryZh[c] ?? c} data-country={c}>
                {[...(byCountry.get(c) ?? new Map()).entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([d, n]) => (
                  <option value={`${c}|${d}`}>{`${d} (${n})`}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </label>
      </div>
      <p class="mt-1.5 text-xs text-slate-500 min-h-[1rem]" aria-live="polite" data-ph-status></p>
      <nav class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label="Sections" data-i18n-attr="aria-label" data-en-aria-label="Sections" data-zh-aria-label="分類">
        {groups.map((g) => (
          <a href={`#${g.key}`} class="font-semibold text-brand-700 hover:underline"><span class="l-en">{g.en}</span><span class="l-zh">{g.zh}</span> <span class="font-normal text-slate-500" data-ph-count={g.key}>{g.items.length}</span></a>
        ))}
      </nav>
    </div>

    {groups.map((g) => (
      <section id={g.key} class="ph-section mt-10" data-ph-section={g.key}>
        <h2 class="text-xl font-extrabold text-slate-900">
          <span class="l-en">{g.en}</span><span class="l-zh">{g.zh}</span>
          <span class="ml-1 text-base font-semibold text-slate-500" data-ph-count={g.key}>{g.items.length}</span>
        </h2>
        {g.key === "exposures" && (
          <p class="mt-1 text-sm text-slate-500">
            <span class="l-en">Validation here means a study measured how accurately dispensing or prescription records capture use of the drug (against medical records, self-report or another source). For NHIRD, each class links to its NHI drug codes.</span>
            <span class="l-zh">這裡的驗證指研究量過調劑或處方紀錄捕捉用藥的準確度（對照病歷、自述或其他來源）。每個藥品類別都連到 NHIRD 對應的健保藥品代碼。</span>
          </p>
        )}
        {g.areas.map((a) => (
          <div class="ph-area" data-ph-area>
            <h3 class="mt-7 text-xs font-bold uppercase tracking-widest text-slate-500"><span class="l-en">{a.en}</span><span class="l-zh">{a.zh}</span></h3>
            <ol class="mt-2 divide-y divide-slate-200 border-y border-slate-200">
              {a.items.map((p) => {
                const tier = tierOf(p);
                const vs = p.validations ?? [];
                const hs = p.highImpact ?? [];
                const refs = [...vs, ...hs];
                return (
                  <li id={slugOf(p.name)} class="ph-entry py-4" data-ph-entry data-hay={haystack(p)}>
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                      <h4 class="text-base font-bold text-slate-900">
                        <a href={`#${slugOf(p.name)}`} class="hover:text-brand-700">{p.name}</a>
                      </h4>
                      {tier === "validated" && <span class="text-[11px] font-bold tracking-wide text-brand-700"><span class="l-en uppercase">Validated · {vs.length} {vs.length === 1 ? "study" : "studies"}</span><span class="l-zh">已驗證 · {vs.length} 篇</span></span>}
                      {tier === "highImpact" && <span class="text-[11px] font-bold tracking-wide text-amber-700"><span class="l-en uppercase">Used in a high-impact study (not validated)</span><span class="l-zh">高影響力期刊研究使用（未經驗證）</span></span>}
                      {tier === "none" && <span class="text-[11px] font-bold tracking-wide text-slate-500"><span class="l-en uppercase">No published source</span><span class="l-zh">無公開來源</span></span>}
                    </div>
                    {p.codes && <p class="mt-1.5 text-sm text-slate-700 leading-relaxed font-mono break-words">{p.codes}</p>}
                    {p.definition && <p class="mt-1.5 text-sm text-slate-700 leading-relaxed">{p.definition}</p>}
                    {p.notes && p.notes.trim() && <p class="mt-1.5 text-sm text-slate-500 leading-relaxed" set:html={linkify(p.notes)} />}
                    {p.atc && (
                      <p class="mt-1.5 text-sm text-slate-500">
                        <span class="l-en">NHI drug codes for this class:</span><span class="l-zh">這類藥品的健保藥品代碼：</span>
                        {p.atc.map((c, i) => (<>{i > 0 && " · "}<a class="ph-link" href={`${NHI_DRUGS}?q=${c}`} target="_blank" rel="noopener">{c}</a></>))}
                      </p>
                    )}

                    {vs.length > 0 && (
                      <table class="ph-table mt-3">
                        <thead>
                          <tr>
                            <th><span class="l-en">Database</span><span class="l-zh">資料庫</span></th>
                            <th><span class="l-en">Algorithm as validated</span><span class="l-zh">驗證的演算法</span></th>
                            <th><span class="l-en">Reference standard</span><span class="l-zh">參考標準</span></th>
                            <th>PPV</th>
                            <th><span class="l-en">Sensitivity, other</span><span class="l-zh">敏感度及其他</span></th>
                            <th><span class="l-en">Study</span><span class="l-zh">研究</span></th>
                          </tr>
                        </thead>
                        <tbody>
                          {vs.map((v, i) => (
                            <tr data-ph-row data-key={`${v.country}|${v.db}`} data-country={v.country} class={i >= SHOW ? "ph-extra" : undefined}>
                              <td data-th="">
                                <b class="text-slate-900">{v.db}</b>
                                <span class="block text-xs text-slate-500">{[v.country, v.period].filter(Boolean).join(" · ")}</span>
                              </td>
                              <td data-th="Algorithm" data-th-zh="演算法">
                                {v.icd10 && <span class="block"><span class="ph-tag">ICD-10</span> <span class="font-mono text-[12.5px] break-words">{v.icd10}</span></span>}
                                {v.icd9 && <span class="block"><span class="ph-tag ph-tag9">ICD-9-CM</span> <span class="font-mono text-[12.5px] break-words">{v.icd9}</span></span>}
                                {v.rule && <span class="block">{v.rule}</span>}
                                {(v.setting || v.n) && <span class="ph-clamp block text-xs text-slate-500" data-ph-clamp>{[v.setting, v.n && `n: ${v.n}`].filter(Boolean).join(" · ")}</span>}
                                {v.note && <span class="block text-xs text-amber-800">{v.note}</span>}
                              </td>
                              <td data-th="Reference" data-th-zh="參考標準">{v.ref ?? "—"}</td>
                              <td data-th="PPV" data-th-zh="PPV" class="ph-num">{v.ppv ?? "—"}</td>
                              <td data-th="Sensitivity" data-th-zh="敏感度" class="ph-num">
                                {v.sens ?? (others(v).length ? "" : "—")}
                                {others(v).map((o) => <span class="block text-xs text-slate-500">{o}</span>)}
                              </td>
                              <td data-th="Study" data-th-zh="研究">
                                {v.doi ? <a class="ph-link" href={`https://doi.org/${v.doi}`} target="_blank" rel="noopener" title={v.cite}>{v.short}</a> : <span title={v.cite}>{v.short}</span>}
                                {v.pmid && <a class="block text-xs text-slate-500 hover:text-brand-700" href={`https://pubmed.ncbi.nlm.nih.gov/${v.pmid}/`} target="_blank" rel="noopener">PMID {v.pmid}</a>}
                                {v.abstractOnly && <span class="block text-xs text-slate-500"><span class="l-en">from abstract</span><span class="l-zh">僅依摘要</span></span>}
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    )}
                    {vs.length > SHOW && (
                      <button type="button" data-ph-more class="mt-1 text-xs font-semibold text-brand-700 hover:underline">
                        <span class="l-en">Show all {vs.length} studies</span><span class="l-zh">顯示全部 {vs.length} 篇</span>
                      </button>
                    )}

                    {hs.length > 0 && (
                      <table class="ph-table mt-3">
                        <thead>
                          <tr>
                            <th><span class="l-en">Database</span><span class="l-zh">資料庫</span></th>
                            <th><span class="l-en">Definition as used</span><span class="l-zh">使用的定義</span></th>
                            <th><span class="l-en">Journal</span><span class="l-zh">期刊</span></th>
                            <th><span class="l-en">Study</span><span class="l-zh">研究</span></th>
                          </tr>
                        </thead>
                        <tbody>
                          {hs.map((h) => (
                            <tr data-ph-row data-key={`${h.country}|${h.db}`} data-country={h.country}>
                              <td data-th="">
                                <b class="text-slate-900">{h.db}</b>
                                <span class="block text-xs text-slate-500">{[h.country, h.period].filter(Boolean).join(" · ")}</span>
                              </td>
                              <td data-th="Definition" data-th-zh="定義">
                                {h.icd10 && <span class="block"><span class="ph-tag">ICD-10</span> <span class="font-mono text-[12.5px] break-words">{h.icd10}</span></span>}
                                {h.icd9 && <span class="block"><span class="ph-tag ph-tag9">ICD-9-CM</span> <span class="font-mono text-[12.5px] break-words">{h.icd9}</span></span>}
                                {h.rule && <span class="block">{h.rule}</span>}
                                {h.setting && <span class="ph-clamp block text-xs text-slate-500" data-ph-clamp>{h.setting}</span>}
                              </td>
                              <td data-th="Journal" data-th-zh="期刊">
                                {h.journal}
                                <a class="block text-xs text-slate-500 hover:text-brand-700" href={h.jifSource} target="_blank" rel="noopener">JIF {h.jif} ({h.jifYear})</a>
                              </td>
                              <td data-th="Study" data-th-zh="研究">
                                {h.doi ? <a class="ph-link" href={`https://doi.org/${h.doi}`} target="_blank" rel="noopener" title={h.cite}>{h.short}</a> : <span title={h.cite}>{h.short}</span>}
                                {h.pmid && <a class="block text-xs text-slate-500 hover:text-brand-700" href={`https://pubmed.ncbi.nlm.nih.gov/${h.pmid}/`} target="_blank" rel="noopener">PMID {h.pmid}</a>}
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    )}

                    {refs.length > 0 && (
                      <details class="ph-refs mt-2">
                        <summary class="text-xs font-semibold text-slate-500 hover:text-brand-700 cursor-pointer"><span class="l-en">References ({refs.length})</span><span class="l-zh">參考文獻（{refs.length}）</span></summary>
                        <ol class="mt-1 list-decimal pl-5 text-xs text-slate-600 leading-relaxed space-y-1">
                          {refs.map((r) => (
                            <li>
                              {r.cite}
                              {r.doi && <> doi:<a class="ph-link" href={`https://doi.org/${r.doi}`} target="_blank" rel="noopener">{r.doi}</a></>}
                              {r.pmid && <> PMID <a class="ph-link" href={`https://pubmed.ncbi.nlm.nih.gov/${r.pmid}/`} target="_blank" rel="noopener">{r.pmid}</a></>}
                            </li>
                          ))}
                        </ol>
                      </details>
                    )}
                  </li>
                );
              })}
            </ol>
          </div>
        ))}
      </section>
    ))}

    <p data-ph-none hidden class="mt-10 text-sm text-slate-600">
      <span class="l-en">No entry matches. Try a shorter word, a code, or another database.</span><span class="l-zh">沒有符合的項目。試試較短的字、代碼，或換一個資料庫。</span>
    </p>
  </div>

  <style is:global>
    .ph-entry { scroll-margin-top: 13rem; margin: 0 -0.75rem; padding-left: 0.75rem; padding-right: 0.75rem; transition: background-color 1.2s ease; }
    .ph-entry.is-target { background: var(--color-brand-50); transition: none; }
    .ph-section { scroll-margin-top: 13rem; }
    .ph-entry a[target], .ph-link { color: var(--color-brand-700); text-decoration: underline; text-underline-offset: 2px; }
    .ph-table { width: 100%; border-collapse: collapse; font-size: 13px; line-height: 1.45; color: var(--color-slate-700); }
    .ph-table th { text-align: left; font-size: 11px; font-weight: 700; color: var(--color-slate-500); padding: 0 0.5rem 0.3rem 0; border-bottom: 1px solid var(--color-slate-200); white-space: nowrap; }
    .ph-table td { vertical-align: top; padding: 0.45rem 0.5rem 0.45rem 0; border-bottom: 1px solid var(--color-slate-100); }
    .ph-table tbody tr:last-child td { border-bottom: 0; }
    .ph-table td:nth-child(1) { width: 15%; }
    .ph-table td:nth-child(2) { width: 34%; }
    .ph-table .ph-num { white-space: normal; }
    .ph-tag { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 0.02em; color: var(--color-brand-700); border: 1px solid currentColor; border-radius: 3px; padding: 0 3px; line-height: 14px; vertical-align: 1px; }
    .ph-tag9 { color: var(--color-slate-500); }
    .ph-entry:not(.show-all) tr.ph-extra { display: none; }
    .ph-entry.show-all [data-ph-more] { display: none; }
    .ph-clamp { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; cursor: pointer; }
    .ph-clamp.open { display: block; -webkit-line-clamp: unset; }
    .ph-refs summary { list-style: none; }
    .ph-refs summary::-webkit-details-marker { display: none; }
    .ph-refs summary::before { content: "▸ "; }
    .ph-refs[open] summary::before { content: "▾ "; }
    /* Phone: each study becomes a short stack, labels in front of the values. */
    @media (max-width: 700px) {
      .ph-table thead { display: none; }
      .ph-table, .ph-table tbody, .ph-table tr, .ph-table td { display: block; width: auto !important; }
      .ph-table tr { padding: 0.6rem 0; border-bottom: 1px solid var(--color-slate-200); }
      .ph-table tbody tr:last-child { border-bottom: 0; }
      .ph-table td { border: 0; padding: 0.1rem 0; }
      .ph-table td[data-th]:not([data-th=""])::before { content: attr(data-th) ": "; font-weight: 700; font-size: 11px; color: var(--color-slate-500); }
      html[lang="zh-Hant"] .ph-table td[data-th-zh]::before { content: attr(data-th-zh) "："; }
    }
  </style>

  <script is:inline>
    (function () {
      var input = document.querySelector("[data-ph-search]");
      var selCountry = document.querySelector("[data-ph-country]");
      var selDb = document.querySelector("[data-ph-db]");
      var entries = [].slice.call(document.querySelectorAll("[data-ph-entry]"));
      var sections = [].slice.call(document.querySelectorAll("[data-ph-section]"));
      var areas = [].slice.call(document.querySelectorAll("[data-ph-area]"));
      var status = document.querySelector("[data-ph-status]");
      var none = document.querySelector("[data-ph-none]");
      var total = entries.length;

      // The database list follows the country choice.
      function syncDbOptions() {
        var c = selCountry.value;
        [].forEach.call(selDb.querySelectorAll("optgroup"), function (g) {
          var off = c && g.getAttribute("data-country") !== c;
          g.hidden = off; g.disabled = off;
        });
        if (c && selDb.value && selDb.value.split("|")[0] !== c) selDb.value = "";
      }

      // Every word typed must appear somewhere in the entry; no syntax. A
      // country or database choice keeps the entries with a study from it and
      // shows only those studies.
      function filter() {
        var words = (input.value || "").toLowerCase().split(/\s+/).filter(Boolean);
        var c = selCountry.value, d = selDb.value;
        var byPlace = !!(c || d);
        var shown = 0;
        entries.forEach(function (e) {
          var hay = e.getAttribute("data-hay");
          var ok = words.every(function (w) { return hay.indexOf(w) >= 0; });
          var rows = [].slice.call(e.querySelectorAll("[data-ph-row]"));
          var hit = 0;
          rows.forEach(function (r) {
            var m = (!c || r.getAttribute("data-country") === c) && (!d || r.getAttribute("data-key") === d);
            r.hidden = !m;
            if (m) hit++;
          });
          [].forEach.call(e.querySelectorAll(".ph-table"), function (t) {
            t.hidden = !t.querySelector("[data-ph-row]:not([hidden])");
          });
          if (byPlace && !hit) ok = false;
          e.classList.toggle("show-all", byPlace || e.hasAttribute("data-open"));
          e.hidden = !ok;
          if (ok) shown++;
        });
        areas.forEach(function (a) { a.hidden = !a.querySelector("[data-ph-entry]:not([hidden])"); });
        sections.forEach(function (s) {
          var n = s.querySelectorAll("[data-ph-entry]:not([hidden])").length;
          s.hidden = n === 0;
          document.querySelectorAll('[data-ph-count="' + s.getAttribute("data-ph-section") + '"]').forEach(function (el) { el.textContent = String(n); });
        });
        none.hidden = shown !== 0;
        var zh = document.documentElement.lang === "zh-Hant";
        status.textContent = words.length || byPlace ? (zh ? "符合 " + shown + " 筆，共 " + total + " 筆" : shown + " of " + total + " match") : "";
      }
      input.addEventListener("input", filter);
      // "Show all N studies", and a click on a clamped setting line, open in place.
      document.addEventListener("click", function (ev) {
        var more = ev.target.closest("[data-ph-more]");
        if (more) { var e = more.closest("[data-ph-entry]"); e.setAttribute("data-open", ""); e.classList.add("show-all"); return; }
        var cl = ev.target.closest("[data-ph-clamp]");
        if (cl) cl.classList.toggle("open");
      });
      selCountry.addEventListener("change", function () { syncDbOptions(); filter(); });
      selDb.addEventListener("change", function () {
        if (selDb.value) selCountry.value = selDb.value.split("|")[0];
        syncDbOptions(); filter();
      });
      document.addEventListener("langchange", filter);

      // ?q= fills the search; #slug scrolls to one entry and highlights it.
      var q = new URLSearchParams(location.search).get("q");
      if (q) { input.value = q.slice(0, 80); }
      filter();
      // Place the entry just below the sticky search bar, immediately (not
      // with the page's smooth scrolling, which a late layout shift can throw off).
      function scrollToEntry(el) {
        var bar = document.querySelector("[data-ph-search]").closest(".sticky");
        var below = bar ? bar.getBoundingClientRect().height + 64 + 12 : 200;
        window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - below, behavior: "instant" });
      }
      function goTo() {
        var id = decodeURIComponent((location.hash || "").slice(1));
        var el = id && document.getElementById(id);
        if (!el || !el.hasAttribute("data-ph-entry")) return;
        if (el.hidden) { input.value = ""; selCountry.value = ""; selDb.value = ""; syncDbOptions(); filter(); }
        scrollToEntry(el);
        el.classList.add("is-target");
        setTimeout(function () { el.classList.remove("is-target"); }, 2500);
      }
      window.addEventListener("hashchange", goTo);
      // Run now (the list is already laid out) and once more after images and
      // fonts have loaded, in case they moved the entry.
      if (location.hash) {
        goTo();
        window.addEventListener("load", function () {
          var el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
          if (el && el.hasAttribute("data-ph-entry")) scrollToEntry(el);
        });
      }
    })();
  </script>
</BaseLayout>
