        }
      });

      const buildFilename = (ext) => {
        const state = readForm();
        const slug = (state.shortId || "aspen-protocol-sccs").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60) || "aspen-protocol-sccs";
        const today = new Date().toISOString().slice(0, 10);
        return slug + "-" + today + "." + ext;
      };

      document.querySelector("[data-action='download-md']")?.addEventListener("click", () => {
        const blob = new Blob([preview.textContent || ""], { type: "text/markdown;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url; a.download = buildFilename("md");
        document.body.appendChild(a); a.click(); a.remove();
        URL.revokeObjectURL(url);
        setMsg("Downloaded " + a.download);
      });

      document.querySelector("[data-action='copy']")?.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(preview.textContent || ""); setMsg("Copied to clipboard."); }
        catch { setMsg("Couldn't copy; your browser may block clipboard access.", true); }
      });

      const doReset = () => {
        if (!confirm("Reset every field to its default and forget the saved draft?")) return;
        localStorage.removeItem(STORAGE_KEY);
        localStorage.removeItem(STORAGE_CITATIONS_KEY);
        pickedCitations = {};
        // The draft that was stale is gone, so the warning about it must go too.
        staleSelects = [];
        // "Start over" means exactly the page a first-time visitor sees, not an
        // empty one. Emptying instead of resetting used to leave the timeline
        // anchor with no radio ticked, and stripped defaults the protocol goes
        // on asserting anyway (the period strip, the primary model, the
        // reference list) — a blank field that the export silently refills is
        // the same trap as a blank field that silently becomes a default.
        form.querySelectorAll("input, textarea, select").forEach((el) => {
          if (el.type === "checkbox" || el.type === "radio") el.checked = el.defaultChecked;
          else if (el.tagName === "SELECT") { const i = [...el.options].findIndex((o) => o.defaultSelected); el.selectedIndex = i < 0 ? 0 : i; }
          else el.value = el.defaultValue;
        });
