        const ageTxt = ({ "6m": "6-month", "1m": "1-month", "3m": "3-month", "12m": "12-month" })[s.ageBands] || "6-month";
        const seasonTxt = ({ month: "calendar month", season: "season", none: "not adjusted" })[s.seasonAdj] || "calendar month";
