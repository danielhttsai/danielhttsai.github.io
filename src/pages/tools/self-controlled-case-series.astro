---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import DesignDiagram from "../../components/DesignDiagram.astro";
import ProtocolCommon from "../../components/ProtocolCommon.astro";
import databasesRaw from "../../data/databases.json";
import { STROBE_ITEMS } from "../../data/strobe";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Feature taxonomy + per-database site catalogue (mirrors ACNU template).
const FEATURES = [
  { id: "rx",        short: "Rx",   label: "Prescriptions" },
  { id: "dx",        short: "Dx",   label: "Diagnoses" },
  { id: "labs",      short: "Lab",  label: "Lab results" },
  { id: "imaging",   short: "Img",  label: "Imaging" },
  { id: "mortality", short: "Mor",  label: "Mortality linkage" },
  { id: "cancer",    short: "Can",  label: "Cancer-registry linkage" },
  { id: "pregnancy", short: "Preg", label: "Pregnancy / birth linkage" },
  { id: "genomics",  short: "Gen",  label: "Genomics / biobank linkage" },
];
const shortDbName = (full: string): string => {
  const m = full.match(/\(([^)]+)\)$/);
  return m ? m[1] : full;
};
const COUNTRY_ORDER = ["TW", "KR", "JP", "HK", "AU", "FI", "GB", "NL", "US"];
type DbRow = typeof databasesRaw[number] & { hidden?: boolean; features?: string[] };
const SITES_DB = (databasesRaw as DbRow[])
  .filter((d) => !d.hidden && COUNTRY_ORDER.includes(d.code))
  .map((d) => ({
    id:       `${d.code}-${shortDbName(d.name).replace(/[^A-Za-z0-9]/g, "")}`,
    country:  d.country,
    code:     d.code,
    short:    shortDbName(d.name),
    features: (d.features ?? []) as string[],
  }))
  .sort((a, b) => {
    const ai = COUNTRY_ORDER.indexOf(a.code);
    const bi = COUNTRY_ORDER.indexOf(b.code);
    if (ai !== bi) return ai - bi;
    return a.short.localeCompare(b.short);
  });
const SITES_DETAIL_MAP: Record<string, { country: string; code: string; short: string; features: string[] }> =
  Object.fromEntries(SITES_DB.map((d) => [d.id, d]));
const SITES_BY_COUNTRY: Record<string, typeof SITES_DB> = SITES_DB.reduce((acc, d) => {
  (acc[d.country] ??= []).push(d);
  return acc;
}, {} as Record<string, typeof SITES_DB>);

// Shared phenotype library (subset; same shape as ACNU page).
const PHENOTYPES = {
  exposures: [
    { name: "SGLT2 inhibitors",            codes: "ATC A10BK* (canagliflozin A10BK02, dapagliflozin A10BK01, empagliflozin A10BK03, ertugliflozin A10BK04)" },
    { name: "DPP-4 inhibitors",            codes: "ATC A10BH* (sitagliptin A10BH01, vildagliptin A10BH02, saxagliptin A10BH03, linagliptin A10BH05, alogliptin A10BH04)" },
    { name: "GLP-1 receptor agonists",     codes: "ATC A10BJ* (exenatide A10BJ01, liraglutide A10BJ02, dulaglutide A10BJ05, semaglutide A10BJ06). Tirzepatide is A10BX16, OUTSIDE this wildcard, and is a dual GIP/GLP-1 receptor agonist rather than a GLP-1 receptor agonist; add A10BX16 explicitly if your class definition covers it, and say which definition you used." },
    { name: "Antipsychotics (any)",        codes: "ATC N05A* excluding N05AN (lithium, a mood stabiliser). The atypicals are not a contiguous range — N05AH, N05AL and N05AX, plus ziprasidone and sertindole inside N05AE — so a first- versus second-generation split has to be by code, not by range." },
    { name: "ADHD stimulants",             codes: "ATC N06BA01, N06BA02, N06BA04, N06BA12 (amphetamine, dexamfetamine, methylphenidate, lisdexamfetamine). Listed by code, not as N06BA*, which also contains atomoxetine (N06BA09) — a non-stimulant, often the comparator rather than the exposure — and modafinil (N06BA07), which is not an ADHD stimulant either." },
    { name: "Opioid analgesics",           codes: "ATC N02A* (excluding diamorphine where required)" },
    { name: "NSAIDs",                      codes: "ATC M01A* (excluding M01AX)" },
    { name: "Bisphosphonates",             codes: "ATC M05BA* / M05BB*" },
    { name: "Anticoagulants; DOACs",      codes: "ATC B01AE07 (dabigatran), B01AF01 (rivaroxaban), B01AF02 (apixaban), B01AF03 (edoxaban)" },
    { name: "Anticoagulants; warfarin",   codes: "ATC B01AA03" },
    { name: "Statins",                     codes: "ATC C10AA*" },
    { name: "Cholinesterase inhibitors",   codes: "ATC N06DA02 donepezil, N06DA03 rivastigmine, N06DA04 galantamine. Listed by molecule, not as N06DA*: memantine (N06DX01) is an NMDA-receptor antagonist, not a cholinesterase inhibitor, and is excluded here — for the broader class see the 'Anti-dementia drugs' entry on the active-comparator builder, which also holds ginkgo (N06DX02) and the anti-amyloid antibodies (N06DX03-05). Kept named 'Cholinesterase inhibitors' rather than renamed, because this builder's own exemplar (Wang GH BMJ 2021) studies that class as distinct from memantine." },
  ],
  // `validation` and `provenance` are deliberately two fields.
  //
  // They used to be one, and the one was called `validation`, sat under a modal
  // captioned "Validated phenotype library", and was appended verbatim to the
  // protocol's numbered reference list. Most of the entries were not validation
  // studies and several were not citations at all, so a reference list an IRB
  // reads carried lines like "NHIRD-validated; CGRD-confirmed in Shao SC et al
  // DOAC studies" — no title, no year, no journal, nothing a referee can follow.
  //
  // One was worse than uncheckable. The self-harm entry read "Man KKC et al
  // Lancet Psychiatry 2024 (PMID 39241791) used a comparable composite
  // definition". PMID 39241791 is Luo H, Chai Y, Li S, et al, "Psychotropic drug
  // prescribing before and during the COVID-19 pandemic among people with
  // depressive and anxiety disorders: a multinational network study", Lancet
  // Psychiatry 2024;11(10):807-817 — a drug-utilisation trends study that
  // defines no self-harm outcome, and whose first author is not Man. A real
  // identifier welded to a false claim about what it contains is the most
  // dangerous shape a citation can have, because the PMID resolves.
  //
  // The GI-bleeding entry cited "Andersen M, Pratt N et al. PDS 2013" for "AsPEN
  // PSSA NSAID/PPI safety work". That record is the AsPEN network description
  // paper (PDS 2013;22(7):700-704, PMID 23653370) — not PSSA work, not about
  // NSAIDs or PPIs, and not a validation of anything.
  //
  // Both were confirmed twice, independently, from search records. Crossref,
  // PubMed and doi.org are blocked from the sandbox these agents run in, so this
  // is search-record evidence and not a Crossref check. NEITHER WAS REPLACED
  // WITH A SUBSTITUTE CITATION: removing a claim that has been shown false is
  // safe, and inventing its replacement from memory is exactly how a fabricated
  // reference entered this repository once already.
  //
  // So: `validation` is a real validation study and is the only thing that
  // reaches the reference list. `provenance` is a "used in / see also" note; it
  // is shown in the modal and never becomes a numbered reference. An entry with
  // no validation study says so, on screen, at the moment it is picked.
  //
  // WHICH FIELD REACHES THE DOCUMENT, measured 2026-08-24 by picking each entry
  // and grepping the exported Markdown. This decides where a caveat may live:
  //
  //   codes       -> `outcomeCodes`  -> exported Section 3 table   REACHES
  //   definition  -> `outcomeDef`    -> exported Section 3 table   REACHES
  //   validation  -> pickedCitations -> exported reference list    REACHES
  //   provenance  -> nothing at all                                MODAL ONLY
  //
  // Two caveats were parked in `provenance` and therefore reached no artefact:
  // that both Taiwanese validation studies were carried out in ICD-9-CM against
  // an ICD-10 code set, and that I64 is unspecified stroke. A qualification
  // parked beside a citation it cannot travel with is not a disclosure; it is
  // visible for as long as the modal is open. So: a caveat a SITE needs in
  // order to execute the definition goes in `definition`, and a caveat about
  // the validation study goes INSIDE the `validation` string. `provenance` is
  // for what is worth knowing before you pick and nothing that qualifies a
  // claim the document makes. descriptive-analysis.astro:70-88 records the same
  // rule, reached independently; this file now follows it.
  outcomes: [
    {
      name: "Myocardial infarction (MI)",
      codes: "ICD-10 I21.*, I22.* (primary discharge diagnosis)",
      definition: "First hospitalisation with a primary discharge diagnosis of acute MI during the observation period. Note that I22 is SUBSEQUENT myocardial infarction (a recurrent event within 28 days) and so is not itself a first event: include it to identify prior MI or to define recurrence, and drop it from the numerator of an incident-MI rate.",
      validation: "Cheng CL et al. Validation of acute myocardial infarction cases in the National Health Insurance Research Database in Taiwan. J Epidemiol 2014;24(6):500-7 (PMID 25174915). Conducted on ICD-9-CM coding, against the ICD-10 code set above; Taiwan's NHIRD coded in ICD-9-CM until 2016, so confirm the mapping for your study period.",
    },
    {
      name: "Ischemic stroke",
      codes: "ICD-10 I63.*, I64.* (primary discharge diagnosis)",
      definition: "First hospitalisation with primary discharge diagnosis of ischemic stroke. Note that I64 is stroke NOT SPECIFIED as haemorrhage or infarction, and its share varies widely between countries and with local diagnostic practice — so including it can dominate a cross-country comparison. Report the I64 share per site, or treat the I64-inclusive definition as a pre-specified sensitivity analysis.",
      validation: "Hsieh CY et al. Validating the diagnosis of acute ischemic stroke in a National Health Insurance claims database. J Formos Med Assoc 2015;114(3):254-9 (PMID 24140108). A second validation of the same construct is Cheng CL et al. Pharmacoepidemiol Drug Saf 2011;20(3):236-42 (PMID 21351304). Both were conducted on ICD-9-CM coding, against the ICD-10 code set above, and neither says anything about the I64 decision, which is a separate choice you have to defend.",
    },
    {
      name: "Falls and/or fractures",
      codes: "Falls ICD-10 W00-W19 (external cause); fracture ICD-10 S02/S12/S22/S32/S42/S52/S62/S72/S82/S92.",
      definition: "ED / hospital encounter carrying a fall-injury or fracture code during the observation period. State which operation you mean and use it consistently: the UNION of the two code sets captures more events at lower specificity, and it is requiring a fall code AND an injury code on the same encounter that raises specificity — the opposite trade-off, not a stronger version of the same one.",
      validation: "",
      provenance: "Used as the primary outcome in Wang GH, Man KKC, Chang WH, Liao TC, Lai ECC. BMJ 2021;374:n1925 (PMID 34503972), a Taiwan NHIRD self-controlled case series. That study used this outcome; it did not validate the code set.",
    },
    {
      name: "Hip fracture",
      codes: "ICD-10 S72.0, S72.1, S72.2 (primary discharge diagnosis), ideally paired with surgical-fixation procedure code.",
      definition: "First hospitalisation with primary discharge hip-fracture diagnosis.",
      validation: "",
      // "Used in AsPEN multi-country hip-fracture work" was withdrawn here on
      // 2026-08-24. The thirty-fourth run traced that attribution to a paper
      // first-authored by Sing C-W which is a study protocol — a protocol
      // declares a phenotype rather than measuring one — and withdrew it from
      // descriptive-analysis and then, after its own reviewer caught the second
      // copy, from src/data/phenotypes.ts. This was the third copy. It named no
      // study, site, year or number, so nobody relying on it could look it up.
      // Withdrawn, not replaced: inventing the replacement is how a fabricated
      // reference entered this repository once already.
      provenance: "Pairing the diagnosis with a surgical-fixation procedure code is what raises specificity here; nothing in this library measures how well the pair performs.",
    },
    {
      name: "Acute kidney injury (AKI)",
      codes: "ICD-10 N17.* (primary discharge diagnosis)",
      definition: "First hospitalisation with primary discharge AKI diagnosis in the observation period.",
      validation: "",
      provenance: "Pair with eGFR / serum-creatinine where lab linkage exists. No specific validation record is attached to this definition here.",
    },
    {
      name: "Suicide / self-harm",
      codes: "ICD-10 X60-X84, Y87.0; T-codes for intentional poisoning; combined with mortality-record cause of death.",
      definition: "First ED / hospital / mortality record with suicide / intentional self-harm code.",
      validation: "",
      provenance: "No validation record is attached to this definition. Note also that suicide and self-harm are not one outcome for a case series: self-harm recurs, suicide cannot, and the event-handling and observation-period assumptions differ accordingly.",
    },
    {
      name: "Intracranial haemorrhage",
      codes: "ICD-10 I60.*, I61.*, I62.* (primary discharge diagnosis)",
      definition: "First hospitalisation with primary discharge ICH diagnosis.",
      validation: "",
      provenance: "No specific validation record is attached to this definition here.",
    },
    {
      name: "GI bleeding",
      codes: "ICD-10 K25.0/.2/.4/.6, K26.0/.2/.4/.6, K27.*, K28.*, K29.0, K92.0/.1/.2 (primary discharge diagnosis)",
      definition: "First hospitalisation with primary discharge GI bleeding diagnosis.",
      validation: "",
      provenance: "No specific validation record is attached to this definition here.",
    },
  ],
};

const SUBGROUPS = [
  "Age (≥65 vs <65 years)",
  "Age (≥75 vs <75 years)",
  "Sex (male vs female)",
  "Country / site",
  "First-ever vs repeated exposure",
  "Index calendar year stratum",
  "Baseline CV disease (yes vs no)",
  "Baseline CKD (eGFR <60 vs ≥60)",
  "Frailty / Charlson Comorbidity Index (high vs low)",
  "Concomitant exposure (yes vs no)",
];

// The assumptions SCCS stands on. Layered deliberately: `plain` is what someone
// meeting SCCS for the first time needs in order to decide whether the design
// fits at all; `precise` is the version for a methods section or a reviewer;
// `check` is the thing you actually do. Each is traceable to a cited paper.
const ASSUMPTIONS = [
  {
    t: "Having the event must not change the chance of later exposure",
    plain: "If the event — or the illness that produced it — makes a clinician start, stop, or delay the drug, the design is biased.",
    precise: "The SCCS likelihood conditions on each case's whole exposure history being fixed in advance. If exposure after the event differs from what it would have been, that condition fails. The mirror image is what you can actually see in the data: an excess (or dearth) of exposures after an event is the same thing as an excess (or dearth) of events just before an exposure, which is why a pre-exposure risk window measures it directly.",
    check: "Put a short pre-exposure (pretreatment) window immediately before exposure start and report its incidence rate ratio as a separate parameter, never folded into the baseline. A raised pre-exposure IRR is a finding, not a nuisance: in the AsPEN antipsychotic-falls series a 14-day pretreatment window carried an IRR of 6.17, which the authors read as the underlying disease rather than the drug.",
    cite: "Whitaker 2006; Whitaker 2018; Wang GH BMJ 2021",
  },
  {
    t: "The length of observation must not depend on the event",
    plain: "If having the event can end the person's follow-up, the design is biased. Death is the obvious case.",
    precise: "The standard model requires each case's observation period to be fixed independently of when their events occur. Censoring at death breaks this whenever the outcome itself raises mortality; the extreme case is an outcome that is death, for which the standard SCCS is simply not applicable.",
    check: "If the outcome is fatal or raises short-term mortality, say so and either restrict to non-fatal events or use a method for event-dependent observation periods (Farrington et al, JASA 2011). Do not silently keep the standard model.",
    cite: "Farrington 2011; Petersen 2016",
  },
  {
    t: "Repeat events in the same person must be independent",
    plain: "If one event makes the next one more likely, counting them all makes the study look more precise than it is.",
    precise: "The Poisson likelihood treats a person's events as independent given their exposure and age. For clustered outcomes — repeat falls in the same frail patient, repeat admissions for the same episode — that fails, and confidence intervals are too narrow.",
    check: "Either restrict to the first event per person (the Event handling field, under the case definition) or justify independence explicitly. If the outcome can only happen once, first-event handling is the only coherent choice.",
    cite: "Whitaker 2006",
  },
  {
    t: "Only time-invariant confounding is removed; time-varying confounding is not",
    plain: "Being your own control removes anything about you that does not change — genes, sex, lifelong habits. It does nothing about things that change while you are being observed.",
    precise: "Age and season are the two that change in every study and are handled by splitting person-time into age bands and calendar strata inside the same conditional Poisson model. Anything else that varies within a person over the observation period — an intercurrent illness, a concomitant drug, a change in care setting — remains a confounder unless it is modelled as time-varying.",
    check: "Set age bands and season in the time-varying confounders section, and list any other time-varying covariate explicitly. If you leave season unadjusted for a seasonal outcome, state why.",
    cite: "Whitaker 2006; Petersen 2016",
  },
];

const SENSITIVITY = [
  "Alternative risk window length (e.g., 7-30, 0-90, 0-180 d)",
  "Alternative pre-risk window (0, 30, 60 d); checks for event-dependent exposure",
  "Alternative post-risk window (washout) (0, 30, 90 d)",
  "Restrict to first event only (vs all events)",
  "Method of Farrington for event-dependent exposure (SCCS-EDE)",
  "Negative-control outcome; should show null",
  "Exclude seasonal months (if outcome is seasonal)",
  "Restrict to patients with ≥1 year of observation before first exposure",
  "Sub-divide risk window into early (0-14 d) vs late (15+ d) to look at risk attenuation",
];

const TIMELINE_PRESETS: Record<string, string> = {
  "12-month": [
    "Month 0: Protocol finalised, site IRB submissions begin",
    "Month 3: All site IRB approvals received",
    "Month 4-6: Local case identification and exposure window construction",
    "Month 7-9: Conditional Poisson regression at each site",
    "Month 10-11: Site IRRs returned to coordinating centre; meta-analysis",
    "Month 12: First manuscript draft circulated",
  ].join("\n"),
  "18-month": [
    "Month 0-3: Protocol finalisation, code-set harmonisation, IRB submissions",
    "Month 4-7: Local case identification and exposure construction",
    "Month 8-12: Primary SCCS analysis, sensitivity analyses (alt risk windows, SCCS-EDE)",
    "Month 13-15: Meta-analysis and forest plots",
    "Month 16-18: Manuscript drafting and submission",
  ].join("\n"),
};
---

<BaseLayout
  title="Self-controlled case series (SCCS) protocol template"
  description="Guided form for drafting a multi-national self-controlled case series (SCCS) protocol."
>
  <PageHeader
    eyebrow="Protocol templates → Self-controlled case series"
    title="Multi-national SCCS protocol builder"
    description="Self-controlled case series. Each case acts as their own control; all time-invariant between-person confounding (genetics, lifelong habits) is automatically removed. AsPEN convention: separate a short pretreatment window (e.g., 14 days) before the first dispensing to absorb confounding by indication and benchmark the underlying-disease risk before therapy (see Wang GH et al BMJ 2021; PMID 34503972)."
  />

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <a class="text-sm text-brand-700 hover:underline font-semibold" href={`${base}/tools/protocol-generator/`}>← All designs</a>
      <button type="button" data-action="reset-top" class="text-xs font-semibold text-rose-700 border border-rose-300 hover:bg-rose-50 px-3 py-1.5 rounded transition">
        ⟲ Clear &amp; start over
      </button>
    </div>

    <!-- Assumptions first: SCCS fails silently, and returns an IRR either way. -->
    <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">Before you use this design</h2>
      <p class="mt-1 text-sm text-slate-600">An SCCS that breaks one of these four assumptions still returns an incidence rate ratio with a confidence interval. Nothing warns you. Read the plain line first; the paragraph under it is the version for a methods section or a reviewer.</p>
      <ol class="mt-4 space-y-3">
        {ASSUMPTIONS.map((a, i) => (
          <li class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
            <p class="text-sm font-bold text-slate-900"><span class="text-brand-700">{i + 1}.</span> {a.t}</p>
            <p class="mt-1 text-sm text-slate-700">{a.plain}</p>
            <details class="mt-2">
              <summary class="cursor-pointer select-none text-[11px] font-bold uppercase tracking-widest text-brand-700 hover:underline">Why it matters, and what to do</summary>
              <p class="mt-2 text-xs text-slate-600 leading-relaxed"><span class="uppercase tracking-widest font-bold text-slate-500 text-[10px]">Why</span> · {a.precise}</p>
              <p class="mt-1.5 text-xs text-slate-600 leading-relaxed"><span class="uppercase tracking-widest font-bold text-slate-500 text-[10px]">What to do</span> · {a.check} <span class="text-slate-400">[{a.cite}]</span></p>
            </details>
          </li>
        ))}
      </ol>
      <div data-checks class="mt-4 hidden"></div>
    </div>

    <div data-state="ready" class="grid gap-8 lg:grid-cols-[1fr_1fr] items-start">

      <form data-builder class="protocol-form space-y-6">

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">1 · Study identification</summary>
          <div class="px-5 pb-5 grid sm:grid-cols-2 gap-3">
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Study title</span>
              <input type="text" name="title" placeholder="e.g. Antipsychotic dispensing and risk of falls in older adults: an AsPEN multi-country self-controlled case series" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Short ID</span>
              <input type="text" name="shortId" placeholder="AsPEN-AP-FALLS-SCCS-2026" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Version · Date</span>
              <input type="text" name="version" placeholder="v0.1 draft · 2026-05-29" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Lead investigator(s)</span>
              <input type="text" name="leadInvestigator" placeholder="Name, affiliation; co-leads if any" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">2 · Research question</summary>
          <div class="px-5 pb-5 grid sm:grid-cols-2 gap-3">
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Population</span>
              <input type="text" name="picoP" placeholder="Adults ≥65y with ≥1 antipsychotic dispensing during the observation period" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Exposure</span>
              <input type="text" name="picoI" placeholder="Antipsychotic dispensing" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Outcome</span>
              <input type="text" name="picoO" placeholder="Hospitalisation for fall-related injury or fracture" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">3 · Sites</summary>
          <div class="px-5 pb-5 space-y-4">
            <p class="text-xs text-slate-500">
              Tick every <strong>database</strong> (not just country). Feature chips indicate what each database can support; only tick a site whose features cover what your case definition / exposure / time-varying covariates need.
            </p>
            <div class="flex flex-wrap items-center gap-2 text-[10px] text-slate-500 border-y border-slate-100 py-2">
              <span class="uppercase tracking-widest font-bold text-slate-600">Legend</span>
              {FEATURES.map((f) => (
                <span class="inline-flex items-center gap-1">
                  <span class="text-[10px] bg-brand-50 text-brand-700 border border-brand-100 px-1.5 py-0.5 rounded font-mono font-semibold">{f.short}</span>
                  <span>{f.label}</span>
                </span>
              ))}
            </div>
            <div class="space-y-3">
              {Object.entries(SITES_BY_COUNTRY).map(([country, dbs]) => (
                <div>
                  <p class="text-[11px] font-semibold text-slate-700">{country}</p>
                  <div class="mt-1 grid grid-cols-1 sm:grid-cols-2 gap-1.5">
                    {dbs.map((d) => (
                      <label class="flex items-center gap-2 text-xs border border-slate-200 rounded px-3 py-2 hover:bg-slate-50 cursor-pointer">
                        <input type="checkbox" name="sites" value={d.id} class="rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                        <span class="font-semibold text-slate-800 shrink-0">{d.short}</span>
                        <span class="flex flex-wrap gap-1 ml-auto">
                          {FEATURES.filter((f) => d.features.includes(f.id)).map((f) => (
                            <span class="text-[10px] bg-brand-50 text-brand-700 border border-brand-100 px-1.5 py-0.5 rounded font-mono font-semibold" title={f.label}>{f.short}</span>
                          ))}
                        </span>
                      </label>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            <label class="flex flex-col gap-1">
              <span class="text-[11px] uppercase tracking-widest text-slate-500 font-semibold">Others (one per line)</span>
              <textarea name="sitesOther" rows="2" placeholder="Sites beyond the active databases list" class="w-full border border-slate-300 rounded px-3 py-2 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
            </label>
            <div data-feasibility class="hidden bg-amber-50 border border-amber-200 rounded-lg p-3 text-xs leading-relaxed">
              <p class="font-bold text-amber-800 uppercase tracking-[0.2em] text-[10px]">⚠ Feasibility heads-up; not a blocker</p>
              <p class="mt-1 text-amber-900">Your study question implies data features that some selected sites don't carry. Multi-country SCCS protocols often accommodate this; just be explicit in the per-site analytic plan.</p>
              <ul data-feasibility-list class="mt-2 space-y-1 text-amber-900 list-disc list-inside"></ul>
            </div>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">4 · Case definition (outcome)</summary>
          <div class="px-5 pb-5 space-y-3">
            <div>
              <button type="button" data-open-library data-category="outcomes" data-target-def="outcomeDef" data-target-codes="outcomeCodes" data-also-fill="picoO" class="text-[10px] uppercase tracking-widest font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 px-2 py-1 rounded transition">📚 Pick outcome from library</button>
              <span class="ml-2 text-[11px] text-slate-500">Validation citation auto-appends to References on export.</span>
            </div>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Operational definition</span>
              <textarea name="outcomeDef" rows="3" placeholder="First hospital admission with primary discharge diagnosis of …" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Code set</span>
              <input type="text" name="outcomeCodes" placeholder="ICD-10 W00-W19, S72.* …" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Event handling</span>
              <select name="eventHandling" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="all" selected>All events per person (recurrent)</option>
                <option value="first">First event only</option>
              </select>
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">5 · Exposure definition</summary>
          <div class="px-5 pb-5 grid sm:grid-cols-2 gap-3">
            <div class="sm:col-span-2">
              <button type="button" data-open-library data-category="exposures" data-target-name="exposureName" data-target-codes="exposureCodes" data-also-fill="picoI" class="text-[10px] uppercase tracking-widest font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 px-2 py-1 rounded transition">📚 Pick exposure from library</button>
            </div>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Exposure; name</span>
              <input type="text" name="exposureName" placeholder="Antipsychotics" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Exposure; code set</span>
              <input type="text" name="exposureCodes" placeholder="ATC N05A*" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Exposure period definition</span>
              <input type="text" name="exposurePeriodDef" value="Continuous exposure inferred from sequential dispensings; gap > grace period ends the episode" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Days of supply default (days)</span>
              <input type="number" name="daysOfSupply" value="30" min="1" step="1" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Grace period (days)</span>
              <input type="number" name="grace" value="14" min="0" step="1" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">6 · Design variant</summary>
          <div class="px-5 pb-5 grid sm:grid-cols-2 gap-3">
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">SCCS variant</span>
              <select name="sccsVariant" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="standard" selected>Standard SCCS (Farrington 1995); within-person exposed vs unexposed time</option>
                <option value="extended-unexposed">SCCS extended with unexposed reference cases; augments within-person estimation with never-exposed cohort members (Whitaker et al, Stat Med 2006)</option>
                <option value="active-comparator">Active-comparator within-person SCCS; case-time on the index drug compared with case-time on a comparator drug (no reliance on a 'no-drug' baseline)</option>
              </select>
              <span class="text-[11px] text-slate-500">Choose Standard when most cases have substantial unexposed time. Choose Extended when within-person unexposed time is sparse and you want to borrow strength from a never-exposed cohort. Choose Active-comparator when patients are continuously on some therapy of the same indication and the relevant question is 'drug A vs drug B'.</span>
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">7 · Risk windows</summary>
          <div class="px-5 pb-5 grid sm:grid-cols-2 gap-3">
            <div class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Timeline anchor — how is time measured &amp; where does baseline come from?</span>
              <div class="grid sm:grid-cols-2 gap-2 mt-1">
                <label class="flex items-start gap-2 rounded-xl border border-slate-200 p-3 cursor-pointer hover:border-brand-400 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50/60">
                  <input type="radio" name="sccsAnchor" value="exposure" checked class="mt-0.5" />
                  <span><span class="text-sm font-semibold text-slate-800">Exposure-anchored <span class="font-normal text-slate-500">(per person)</span></span><br /><span class="text-xs text-slate-600 leading-snug">Day 0 = <strong>each case's own first exposure</strong>. Periods are counted in days before/after that day (baseline 90 d, risk 30 d…) — like a cohort look-back. Different cases sit at different calendar dates. Use when what matters is time <em>since exposure</em>.</span></span>
                </label>
                <label class="flex items-start gap-2 rounded-xl border border-slate-200 p-3 cursor-pointer hover:border-brand-400 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50/60">
                  <input type="radio" name="sccsAnchor" value="calendar" class="mt-0.5" />
                  <span><span class="text-sm font-semibold text-slate-800">Calendar-anchored <span class="font-normal text-slate-500">(shared dates)</span></span><br /><span class="text-xs text-slate-600 leading-snug"><strong>Everyone is followed from the same calendar date</strong> (e.g. 1 Jan 2012), and baseline is a <strong>fixed prior calendar period</strong> (e.g. all of 2011 = 1 year). Use when you want a common calendar reference window, not per-person exposure timing.</span></span>
                </label>
              </div>
            </div>
            <div data-cal class="hidden sm:col-span-2 grid sm:grid-cols-2 gap-3">
              <label class="flex flex-col gap-1">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Common follow-up start (calendar date)</span>
                <input type="text" name="cohortStart" value="2012-01-01" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
              </label>
              <label class="flex flex-col gap-1">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Baseline before start (years)</span>
                <input type="number" name="baselineYears" value="1" min="0" step="1" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
              </label>
            </div>
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Risk / reference periods — one continuous strip (Type | days, in order)</span>
              <textarea name="periods" rows="5" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">Reference | 90
Pre-exposure risk | 14
Exposure risk | 30
Post-exposure risk | 14
Reference | 90</textarea>
              <div class="flex gap-1 mt-1 flex-wrap">
                {["Reference", "Pre-exposure risk", "Exposure risk", "Post-exposure risk", "Washout"].map((t) => (
                  <button type="button" data-add-period data-name={t} class="text-[10px] rounded-full border border-slate-200 px-2 py-0.5 text-slate-600 hover:border-brand-400 hover:text-brand-700">+ {t}</button>
                ))}
              </div>
              <span class="text-[11px] text-slate-500">The case's observation time as <strong>one continuous strip</strong> of consecutive periods — each line is a segment (<code>Type | days</code>), in order. Add any period anywhere (chips append; edit the text to insert/reorder), or drag a segment's right edge in the diagram. <span id="stripDay0Hint">Day 0 = the start of the first <em>Exposure risk</em> segment.</span> Types are auto-coloured (reference / exposure / pre / post risk).</span>
            </label>
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Risk window definition (justification)</span>
              <select name="riskWindowDef" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="entire" selected>Entire exposure episode</option>
                <option value="0-30">Days 0-30 after exposure start</option>
                <option value="0-90">Days 0-90 after exposure start</option>
                <option value="0-180">Days 0-180 after exposure start</option>
                <option value="early-late">Early (0-14 d) vs Late (15+ d) split</option>
              </select>
            </label>
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Baseline (control) period — definition / justification</span>
              <input type="text" name="baselinePeriod" value="All observation time NOT in pre-risk, risk, or post-risk windows" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Covariate / eligibility look-back windows (measurement)</span>
              <textarea name="covWindows" rows="2" placeholder="Comorbidity (CCI) | 365&#10;Prior enrolment (eligibility) | 365" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
              <div class="flex gap-1 mt-1 flex-wrap">
                {["Comorbidity (CCI)", "Comedications", "Prior enrolment (eligibility)", "Frailty", "Disease severity"].map((t) => (
                  <button type="button" data-add-row data-target="covWindows" data-name={t} class="text-[10px] rounded-full border border-slate-200 px-2 py-0.5 text-slate-600 hover:border-brand-400 hover:text-brand-700">+ {t}</button>
                ))}
              </div>
              <span class="text-[11px] text-slate-500">Measure baseline covariates / eligibility <em id="covAnchorHint">before exposure start</em> (day 0) — each is a draggable window, exactly like the cohort builder (<code>Name | days</code>). This is the <strong>measurement</strong> layer; the risk-vs-reference windows above are SCCS's within-person estimand, <strong>not</strong> a cohort follow-up.<br /><strong class="text-slate-600">These windows do not adjust anything.</strong> A covariate measured once before day 0 is constant within a person, and the conditional Poisson likelihood conditions on the person — so it drops out of the model entirely. Use these to decide who is eligible, to describe the cases, and to define subgroups; anything that must be <em>adjusted</em> for has to vary within the observation period, and belongs under time-varying confounders below.</span>
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">8 · Observation period</summary>
          <div class="px-5 pb-5 grid sm:grid-cols-2 gap-3">
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Period starts at</span>
              <select name="obsStart" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="age-cohort" selected>Later of: (a) calendar start of study period, (b) cohort entry age</option>
                <option value="study-start">Calendar start of study period</option>
                <option value="age-onset">Age at first eligibility (e.g., age 65)</option>
                <option value="enrolment">Date of database registration</option>
              </select>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Period ends at</span>
              <select name="obsEnd" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="earliest-of" selected>Earliest of: end of study period, death, disenrolment</option>
                <option value="study-end">Calendar end of study period</option>
                <option value="death">Death</option>
                <option value="disenrol">Disenrolment from database</option>
              </select>
            </label>
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Study calendar period</span>
              <input type="text" name="studyCalendar" placeholder="e.g., 2010-01-01 to 2023-12-31" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">9 · Time-varying confounders</summary>
          <div class="px-5 pb-5 grid sm:grid-cols-2 gap-3">
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Age band width</span>
              <select name="ageBands" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="6m" selected>6-month bands (default)</option>
                <option value="1m">1-month bands (fine)</option>
                <option value="3m">3-month bands</option>
                <option value="12m">12-month bands</option>
              </select>
              <span class="text-[11px] text-slate-500">Adjusts for within-person ageing within the observation period.</span>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Season adjustment</span>
              <select name="seasonAdj" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="month" selected>Calendar month (12-level)</option>
                <option value="season">Season (4-level)</option>
                <option value="none">None</option>
              </select>
            </label>
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Other time-varying covariates (one per line)</span>
              <textarea name="tvCovariates" rows="3" placeholder="Concomitant benzodiazepine dispensing (binary, time-varying)&#10;Hospitalisation for any cause (time-varying)" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">10 · Statistical analysis</summary>
          <div class="px-5 pb-5 grid sm:grid-cols-2 gap-3">
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Primary model</span>
              <input type="text" name="primaryModel" value="Conditional Poisson regression with offset for log person-time; person is the conditioning stratum" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Effect estimate</span>
              <input type="text" name="effectMeasure" value="Incidence rate ratio (IRR) with 95% CI" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Meta-analysis</span>
              <select name="metaMethod" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="re" selected>Random-effects (DerSimonian-Laird)</option>
                <option value="re-reml">Random-effects (REML)</option>
                <option value="fe">Fixed-effects (inverse-variance)</option>
              </select>
            </label>
            <div class="sm:col-span-2">
              <p class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Subgroup analyses; tick those to perform</p>
              <div class="mt-2 grid sm:grid-cols-2 gap-1.5">
                {SUBGROUPS.map((g, i) => (
                  <label class="flex items-start gap-2 text-xs border border-slate-200 rounded px-3 py-2 hover:bg-slate-50 cursor-pointer">
                    <input type="checkbox" name="subgroupsPick" value={g} checked={[0,2,3,4].includes(i)} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                    <span>{g}</span>
                  </label>
                ))}
              </div>
              <label class="flex flex-col gap-1 mt-3">
                <span class="text-[11px] uppercase tracking-widest text-slate-500 font-semibold">Custom subgroups (one per line)</span>
                <textarea name="subgroupsCustom" rows="2" class="w-full border border-slate-300 rounded px-3 py-2 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
              </label>
            </div>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">11 · Sensitivity analyses</summary>
          <div class="px-5 pb-5 space-y-3">
            <div class="grid sm:grid-cols-2 gap-1.5">
              {SENSITIVITY.map((s, i) => (
                <label class="flex items-start gap-2 text-xs border border-slate-200 rounded px-3 py-2 hover:bg-slate-50 cursor-pointer">
                  <input type="checkbox" name="sensitivityPick" value={s} checked={i < 5} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{s}</span>
                </label>
              ))}
            </div>
            <label class="flex flex-col gap-1">
              <span class="text-[11px] uppercase tracking-widest text-slate-500 font-semibold">Custom sensitivity analyses (one per line)</span>
              <textarea name="sensitivityCustom" rows="2" class="w-full border border-slate-300 rounded px-3 py-2 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">12 · Execution &amp; timeline</summary>
          <div class="px-5 pb-5 space-y-3">
            <div class="grid sm:grid-cols-2 gap-3">
              <label class="flex flex-col gap-1">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Architecture</span>
                <select name="arch" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                  <option value="federated" selected>Federated</option>
                  <option value="cdm">Common Data Model</option>
                  <option value="centralised">Centralised (DUA permits)</option>
                </select>
              </label>
            </div>
            <div>
              <p class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Timeline preset</p>
              <div class="mt-2 flex gap-2 flex-wrap">
                <button type="button" data-timeline-preset="12-month" class="text-xs border border-brand-300 text-brand-700 hover:bg-brand-50 font-semibold px-3 py-1.5 rounded transition">Use 12-month plan</button>
                <button type="button" data-timeline-preset="18-month" class="text-xs border border-brand-300 text-brand-700 hover:bg-brand-50 font-semibold px-3 py-1.5 rounded transition">Use 18-month plan</button>
              </div>
              <label class="flex flex-col gap-1 mt-3">
                <span class="text-[11px] uppercase tracking-widest text-slate-500 font-semibold">Milestones (one per line)</span>
                <textarea name="timeline" rows="6" class="w-full border border-slate-300 rounded px-3 py-2 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
              </label>
            </div>
          </div>
        </details>

        <details class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">13 · Ethics, dissemination, references (optional)</summary>
          <div class="px-5 pb-5 space-y-3">
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Ethics</span>
              <textarea name="ethics" rows="2" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">Each participating site obtains local IRB / ethics approval before data extraction. Under a federated design only aggregate site-level estimates are shared with the coordinating centre.</textarea>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Dissemination</span>
              <textarea name="dissemination" rows="2" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">Primary manuscript to a peer-reviewed pharmacoepidemiology journal; presentation at ICPE / ISPE Asian conference.</textarea>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Key references (one per line)</span>
              <textarea name="references" rows="8" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">Whitaker HJ, Farrington CP, Spiessens B, Musonda P. Tutorial in biostatistics: the self-controlled case series method. Stat Med 2006;25(10):1768-97. doi:10.1002/sim.2302
Farrington CP. Relative incidence estimation from case series for vaccine safety evaluation. Biometrics 1995;51(1):228-35. doi:10.2307/2533328
Petersen I, Douglas I, Whitaker H. Self controlled case series methods: an alternative to standard epidemiological study designs. BMJ 2016;354:i4515. doi:10.1136/bmj.i4515
Whitaker HJ, Ghebremichael-Weldeselassie Y, Douglas IJ, Smeeth L, Farrington CP. Investigating the assumptions of the self-controlled case series method. Stat Med 2018;37(4):643-58. doi:10.1002/sim.7536 (tests and graphical checks for the assumptions above.)
Farrington CP, Anaya-Izquierdo K, Whitaker HJ, Hocine MN, Douglas I, Smeeth L. Self-controlled case series analysis with event-dependent observation periods. J Am Stat Assoc 2011;106(494):417-26. doi:10.1198/jasa.2011.ap10108 (the method to use when the event curtails observation, e.g. a fatal outcome.)
Musonda P, Farrington CP, Whitaker HJ. Sample sizes for self-controlled case series studies. Stat Med 2006;25(15):2618-31. doi:10.1002/sim.2477 (sample-size formulae for this likelihood, including the age-adjusted case.)
Wang GH, Man KKC, Chang WH, Liao TC, Lai EC. Use of antipsychotic drugs and cholinesterase inhibitors and risk of falls and fractures: self-controlled case series. BMJ 2021;374:n1925. doi:10.1136/bmj.n1925; PMID 34503972. (AsPEN exemplar; 14-day pretreatment window, pretreatment IRR 6.17.)
Hsieh CY, Su CC, Shao SC, Sung SF, Lin SJ, Kao Yang YH, Lai EC. Taiwan's NHIRD: past and future. Clin Epidemiol 2019;11:349-358.
Shao SC, Chan YY, Kao Yang YH, Lin SJ, Hung MJ, Chien RN, Lai CC, Lai EC. The Chang Gung Research Database. Pharmacoepidemiol Drug Saf 2019;28(5):593-600.</textarea>
            </label>
          </div>
        </details>

        <div class="flex flex-wrap gap-3 pt-2 items-center">
          <button type="button" data-action="download-docx" class="bg-white border border-brand-700 text-brand-700 hover:bg-brand-50 font-semibold px-5 py-2.5 rounded-lg transition text-sm">⬇ Download Word (.docx)</button>
          <button type="button" data-action="download-md" class="text-brand-700 hover:underline font-semibold text-sm">⬇ Markdown</button>
          <button type="button" data-action="download-strobe" class="text-brand-700 hover:underline font-semibold text-sm" title="Generate the STROBE reporting checklist (von Elm 2007; strobe-statement.org) as a Word document, pre-filled from your protocol fields.">⬇ STROBE checklist</button>
          <button type="button" data-action="copy" class="text-brand-700 hover:underline font-semibold text-sm">📋 Copy</button>
          <button type="button" data-action="reset" class="ml-auto text-slate-500 hover:text-rose-600 hover:underline text-sm font-semibold">Clear all</button>
          <p data-action-msg class="basis-full text-xs"></p>
        </div>
      </form>

      <aside class="lg:sticky lg:top-20">
        <div class="border border-slate-200 rounded-2xl bg-slate-50 shadow-sm overflow-hidden">
          <header class="flex items-center justify-between px-4 py-2 bg-white border-b border-slate-200">
            <p class="text-xs uppercase tracking-widest text-brand-700 font-bold">Live preview</p>
            <p class="text-[10px] text-slate-500">Auto-saved to this browser</p>
          </header>
          <pre data-preview class="text-xs leading-relaxed text-slate-800 p-4 overflow-auto max-h-[calc(100vh-12rem)] whitespace-pre-wrap font-mono"></pre>
        </div>
      </aside>
    </div>

    <!-- Study design diagram -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">Study design diagram</h2>
      <p class="mt-1 text-xs text-slate-500">Pick the <strong>timeline anchor</strong> above (exposure-anchored vs calendar-anchored). <strong>Two layers:</strong> (1) covariate / eligibility <em>look-back</em> before the anchor — the same measurement windows as the cohort builder; (2) the case's observation time as <strong>one continuous strip</strong> of consecutive periods (reference / pre-exposure risk / exposure / post-exposure), which you edit freely — add any period, reorder in the text, or drag a segment's ○ edge. This is a within-person time partition, <strong>not</strong> a cohort follow-up.</p>
      <div class="mt-4 overflow-x-auto"><div id="diagram"></div></div>
      <div id="dlegend" class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-slate-600"></div>
    </div>
    <DesignDiagram />
    <ProtocolCommon />

    <!-- Phenotype library modal -->
    <div data-library-modal class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-start justify-center p-4 sm:p-8 overflow-y-auto">
      <div class="bg-white border border-slate-200 rounded-2xl shadow-2xl w-full max-w-3xl my-8">
        <header class="flex items-center justify-between gap-3 px-5 py-4 border-b border-slate-100">
          <div>
            <p class="text-xs uppercase tracking-widest text-brand-700 font-bold">Phenotype library</p>
            <h3 class="text-lg font-bold text-slate-900 mt-0.5" data-library-title>Pick a phenotype</h3>
          </div>
          <button type="button" data-library-close class="text-slate-400 hover:text-slate-700 text-2xl leading-none">×</button>
        </header>
        <div class="px-5 py-3 border-b border-slate-100">
          <input type="text" data-library-search placeholder="Filter…" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
        </div>
        <div data-library-list class="px-2 py-2 max-h-[60vh] overflow-y-auto"></div>
      </div>
    </div>
  </section>

  <script src="https://unpkg.com/docx@8.5.0/build/index.umd.js" is:inline></script>

  <script is:inline define:vars={{ BASE: base, SITES_DETAIL_MAP, FEATURES, PHENOTYPES, TIMELINE_PRESETS, STROBE_ITEMS, ASSUMPTIONS }}>
    (() => {
      const setState = (name) => {
        document.querySelectorAll("[data-state]").forEach((el) => {
          el.classList.toggle("hidden", el.dataset.state !== name);
        });
      };

      const STORAGE_KEY = "aspen.protocol-builder.sccs";
      const STORAGE_CITATIONS_KEY = "aspen.protocol-builder.sccs.citations";
      const form = document.querySelector("[data-builder]");
      const preview = document.querySelector("[data-preview]");
      const actionMsg = document.querySelector("[data-action-msg]");
      const setMsg = (msg, isError = false) => {
        if (!actionMsg) return;
        actionMsg.textContent = msg;
        actionMsg.classList.toggle("text-rose-700", isError);
        actionMsg.classList.toggle("text-brand-700", !isError);
      };

      let pickedCitations = {};
      try { pickedCitations = JSON.parse(localStorage.getItem(STORAGE_CITATIONS_KEY) || "{}") || {}; } catch {}
      const savePickedCitations = () => { try { localStorage.setItem(STORAGE_CITATIONS_KEY, JSON.stringify(pickedCitations)); } catch {} };

      // Format a site id into "Country · Short [Rx Dx ...]".
      const formatSiteFull = (id) => {
        const d = SITES_DETAIL_MAP[id];
        if (!d) return id;
        const feats = (d.features || []).map((f) => (FEATURES.find((x) => x.id === f) || {}).short || f).join(" ");
        return d.country + " · " + d.short + (feats ? " [" + feats + "]" : "");
      };

      // ── Feasibility detection ───────────────────────────────
      // Map the chair's typed text → which data features are needed.
      // Permissive regex so a heads-up appears even on a quick first draft.
      // SCCS still leans on Rx (exposure) + Dx (outcome) almost universally;
      // those two are added at the top.
      // Every group but `labs` was wrapped `\b( … )\b`, which makes the TRAILING
      // boundary mandatory and so kills every stem in it: `carcinom\b` cannot
      // match "carcinoma", and executed in Chromium neither did "malignancy",
      // "malignant", "tumours", "tumors", "pregnancy", "pregnant women",
      // "gestational age", "births", "echocardiogram", "angiography",
      // "radiology", "genomics" or "deaths". `labs` was the one group written
      // without the trailing `\b` and the one group that worked. Same defect,
      // same fix, as descriptive-analysis.astro.
      //
      // Two deliberate narrowings carried over from that file: "angio" matches
      // nothing with the boundary and matches "angiotensin" — an entire drug
      // class, and one an SCCS is very likely to be studying — without it, so
      // the imaging cue is the narrower "angiograph"; and `leuk[ae]mia` covered
      // "leukemia" and "leukamia", i.e. neither the British spelling nor
      // anything else anyone writes, so it is `leuk[ae]?[ae]mia`.
      const FEATURE_TRIGGERS = {
        labs:      /\bhba1c|\begfr|\bcreatinine|\bbmi\b|\bblood\s*pressure|\bsystolic|\bdiastolic|\bldl\b|\bhdl\b|\bcholesterol|\bglucose|\balbumin|\bh[ae]?emoglobin|\binr\b|\btsh\b|\blipid|\bbiochemi|\blabora?tor[yi]|\blabs?\b/i,
        mortality: /\bmortality|\ball-?cause\s+death|\bcv\s+death|\bcardiovascular\s+death|\bcause[\s-]of[\s-]death|\bdied\b|\bfatal|\bdeath|\bsurvival/i,
        cancer:    /\bcancer|\bcarcinom|\bmalignan|\bneoplas|\btumou?r|\bsarcoma|\bleuk[ae]?[ae]mia|\blymphom|\bmyeloma|\boncolog/i,
        pregnancy: /\bpregnan|\bbirth|\bneonat|\bgestation|\btrimester|\bmaternal|\bfo?etal|\binfant|\bmother/i,
        imaging:   /\bimaging|\bmri\b|\bct\s*scan|\bx-?ray|\bultrasound|\bechocardio|\bangiograph|\bradiolog/i,
        genomics:  /\bgenomic|\bsnp\b|\bgwas\b|\bbiobank|\bgenotyp|\bexome|\bgene\b|\bgenetic/i,
      };
      const FEATURE_TEXT_FIELDS = [
        "outcomeDef","outcomeCodes",
        "picoP","picoI","picoO",
        "exposureName","exposureCodes","exposurePeriodDef",
        "baselinePeriod","tvCovariates",
        "subgroupsCustom","sensitivityCustom",
      ];
      const FEATURE_MULTI_FIELDS = ["subgroupsPick","sensitivityPick"];

      const computeRequiredFeatures = (state) => {
        let blob = "";
        for (const f of FEATURE_TEXT_FIELDS) blob += " " + (state[f] || "");
        for (const f of FEATURE_MULTI_FIELDS) blob += " " + ((state[f] || []).join(" "));
        const req = new Set(["rx","dx"]);    // SCCS in AsPEN: Rx exposure + Dx outcome are typical
        for (const [feat, rx] of Object.entries(FEATURE_TRIGGERS)) {
          if (rx.test(blob)) req.add(feat);
        }
        return req;
      };

      const renderFeasibility = (state) => {
        const panel  = document.querySelector("[data-feasibility]");
        const list   = document.querySelector("[data-feasibility-list]");
        if (!panel || !list) return;
        const required = computeRequiredFeatures(state);
        const selected = state.sites || [];
        if (selected.length === 0) { panel.classList.add("hidden"); return; }

        const gaps = [];
        for (const featId of required) {
          if (featId === "rx" || featId === "dx") continue; // universal in claims/EHR
          const featLabel = (FEATURES.find((f) => f.id === featId) || {}).label || featId;
          const missing = [];
          const have    = [];
          for (const sid of selected) {
            const d = SITES_DETAIL_MAP[sid];
            if (!d) continue;
            (d.features.includes(featId) ? have : missing).push(d.short);
          }
          if (missing.length > 0) {
            gaps.push({ feature: featLabel, missing, have });
          }
        }

        if (gaps.length === 0) { panel.classList.add("hidden"); return; }
        list.innerHTML = gaps.map((g) =>
          `<li><strong>${g.feature}</strong>; implied by your study text. Missing at: <strong>${g.missing.join(", ")}</strong>` +
          (g.have.length > 0 ? `. Available at: ${g.have.join(", ")}.` : `.`) + `</li>`
        ).join("");
        panel.classList.remove("hidden");
      };

      const readForm = () => {
        const data = new FormData(form);
        const out = {};
        const multi = new Set(["sites", "sensitivityPick", "subgroupsPick"]);
        for (const k of multi) out[k] = [];
        for (const [k, v] of data.entries()) {
          if (multi.has(k)) out[k].push(String(v));
          else out[k] = String(v);
        }
        return out;
      };
      // Captured at restore, because it cannot be recovered afterwards: a
      // <select> left at selectedIndex = -1 contributes NOTHING to FormData, so
      // by the time anything reads the state the dead value is simply gone.
      let staleSelects = [];
      // Carried in the saved draft under a key outside the form's namespace, so
      // readForm() — which is FormData-derived — cannot see it and therefore
      // cannot leak it into an export as a field.
      const STALE_KEY = "__staleSelects";
      const writeForm = (state) => {
        const multi = new Set(["sites", "sensitivityPick", "subgroupsPick"]);
        staleSelects = [];
        for (const el of form.querySelectorAll("input, textarea, select")) {
          const name = el.name;
          if (!name) continue;
          // hasOwnProperty, not a truthiness test on the value: an ABSENT key
          // means the sender did not mention this group, not that they chose
          // none of it. Run unconditionally, this branch unticked all 9 default
          // ticks here whenever a ?seed= link carried only the few fields a
          // colleague had written down — which is what a seed link always is.
          // readForm() pre-seeds every multi key with [], so a saved draft
          // always owns the key and a deliberate untick still restores.
          if (el.type === "checkbox" && multi.has(name)) {
            if (Object.prototype.hasOwnProperty.call(state, name)) el.checked = (state[name] || []).includes(el.value);
          }
          // Radios carry the option value in .value — assigning to it would rewrite the option
          // itself (collapsing the group), so restore by ticking the matching radio instead.
          else if (el.type === "radio") { if (state[name] !== undefined) el.checked = String(state[name]) === el.value; }
          else if (state[name] !== undefined) {
            // A <select> whose stored value is no longer one of its options was
            // assigned anyway. `el.value = x` is a silent no-op there: it leaves
            // selectedIndex = -1, so the box renders empty, FormData omits the
            // control, the state key is `undefined`, and each export's `|| …`
            // fallback then supplied a definite choice of its own. Reproduced
            // with a draft carrying sccsVariant "nested-case-control": the
            // protocol's Design line and section 5 both asserted "Standard SCCS
            // (Farrington 1995); within-person comparison of exposed vs
            // unexposed time" — a design variant nobody picked — with nothing
            // on screen to say so. Keep what the markup declares, and name what
            // was dropped.
            //
            // String(), because option.value is always a string and a seed is
            // JSON: a numeric value would fail a strict === against an option
            // this page does offer, and the page would refuse a choice it has
            // while blaming a rename that never happened. No SCCS option value
            // looks numeric today, so this is a guard, not a fix.
            if (el.tagName === "SELECT" && ![...el.options].some((o) => o.value === (state[name] === null ? "" : String(state[name])))) {
              staleSelects.push({
                name,
                // JSON has no `undefined`, so a `null` is an upstream system
                // saying "no value". Recorded as a blank rather than quoted
                // back at the user as the word "null".
                value: state[name] === null ? "" : String(state[name]),
                label: (el.closest("label")?.querySelector("span")?.textContent || name).trim(),
                kept: (el.options[el.selectedIndex] || {}).text || el.value,
                // The raw value it was left at, so the note can be retired by
                // asking what the box holds now rather than by listening for a
                // `change` that the page's own writes never fire.
                keptValue: el.value,
              });
              continue;
            }
            el.value = state[name];
          }
        }
        // Anything still unanswered from an earlier visit. Its select now holds
        // the substituted value, so this pass cannot rediscover it — the note
        // above says so itself: "it is not recoverable from the saved draft
        // once the page has loaded". Until this existed the page then threw
        // that record away on the very next render, so the refusal reached the
        // Markdown, the Word file and STROBE item 19 on ONE load and never
        // again, while all three went on asserting the substituted variant.
        // Validated against the live markup rather than trusted: a carried
        // entry may only name a select this page still has, and nothing from
        // it is ever assigned to a control.
        //
        // A carried record is only ever THIS BROWSER'S own, and the test for
        // that is localStorage, not the URL.
        //
        // It must not be accepted from a ?seed= link: its text is written by
        // whoever made the link, and it now prints into the exported protocol.
        // Measured — a link carrying no effectMeasure key at all, plus a forged
        // __staleSelects entry, put “Effect estimate” was saved as “HR —
        // superseded by sponsor addendum 3; report RR” into the recipient's
        // panel and their Word file, where it reads as a refusal their own
        // draft provoked. (The sender cannot go the other way and suppress a
        // real warning: noteStale runs on the keys the seed actually carries.)
        //
        // Asking the URL for that looks obvious and is wrong twice over: a
        // truncated "?seed=" carries nothing and falls back to the draft, and
        // "?seed=paste" LOADS the draft — so it read the user's own record as a
        // stranger's and the next render saved the draft back without it.
        // Opening a hand-off link and pasting nothing destroyed the warning
        // permanently: the self-erasing refusal, for the third time in this
        // codebase. A link can only pass the test below by carrying the
        // reader's own record, which is the case it is meant to allow.
        const ownRecord = (() => {
          try {
            const d = JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");
            return (d && Array.isArray(d[STALE_KEY])) ? JSON.stringify(d[STALE_KEY]) : null;
          } catch (e) { return null; }
        })();
        const carried = (ownRecord && Array.isArray(state[STALE_KEY]) && JSON.stringify(state[STALE_KEY]) === ownRecord)
          ? state[STALE_KEY] : [];
        for (const c of carried) {
          if (!c || !c.name || staleSelects.some((x) => x.name === c.name)) continue;
          const el = form.elements[c.name];
          if (!el || !el.options) continue;
          staleSelects.push({
            name: c.name,
            value: String(c.value == null ? "" : c.value),
            label: (el.closest("label")?.querySelector("span")?.textContent || c.name).trim(),
            kept: (el.options[el.selectedIndex] || {}).text || el.value,
            keptValue: el.value,
          });
        }
      };
      // A picked citation travels only while the phenotype it validates is still
      // named somewhere in the form. `pickedCitations` has its own localStorage
      // key and was cleared only by "Clear all", so picking MI and then picking
      // stroke left an MI validation study in the reference list of a
      // stroke-only protocol — and a reload brought it back. The reference list
      // was also assembled by two copies of the same expression, one in the
      // Markdown builder and one in the Word builder, which is how the pairs of
      // lookups in this codebase have drifted before; there is one now.
      //
      // The first version of this searched four fields for the phenotype's name
      // as a substring, and got it wrong in both directions. Rewording the
      // outcome from "Myocardial infarction (MI)" to "Acute myocardial
      // infarction" — the most ordinary edit there is — deleted the validation
      // reference with no notice; and naming MI as an *inclusion criterion*
      // ("Hip fracture in patients with prior myocardial infarction") revived an
      // MI outcome-validation study into a hip-fracture protocol, which is the
      // same bug from the other side.
      //
      // A citation is stored against the FIELD it was written into, so picking a
      // new outcome evicts the previous one deterministically instead of by
      // substring luck. And because neither dropping nor keeping is safe to do
      // in silence, an entry whose field no longer names its phenotype is
      // withheld AND reported, rather than either one quietly.
      const citeEntries = () => Object.entries(pickedCitations)
        .map(([field, v]) => (v && typeof v === "object" && v.cite) ? { field, name: String(v.name || ""), cite: String(v.cite) } : { field, legacy: true })
        .filter(Boolean);
      const citeState = (s) => {
        const live = [], lapsed = [];
        for (const e of citeEntries()) {
          if (e.legacy) { lapsed.push({ name: "(a phenotype picked before this page stored which field it filled)", field: e.field }); continue; }
          const val = String(s[e.field] || "");
          if (val && val.toLowerCase().includes(e.name.toLowerCase())) live.push(e.cite.trim());
          else lapsed.push({ name: e.name, field: e.field });
        }
        return { live, lapsed };
      };
      const refsOf = (s) => {
        const set = new Set(String(s.references || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean));
        for (const c of citeState(s).live) set.add(c);
        return Array.from(set);
      };
      const mergeList = (picks, customText) => {
        const lines = (customText || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        return [...(picks || []), ...lines];
      };
      // A "|" anywhere in a Markdown table cell ends the cell. Typing
      // "ATC N05A* | excluding N05AN01" in the code set emitted a three-cell row
      // against a two-column header, and GFM drops the cells past the header
      // width — so the Markdown silently lost "excluding N05AN01" while the
      // .docx kept it, and the two exported documents specified different code
      // sets for the same study. Period names can contain a "|" too, now that
      // the parser splits on the last one. Same defect and same fix as
      // descriptive-analysis.astro.
      //
      // It escaped the pipe and not the backslash, and this page had the most to
      // lose from that: the whole risk/reference strip is ONE cell (see the
      // "Risk / reference periods" row below), so a `\|` anywhere in a period
      // name truncated the cell there and deleted every period after it — a
      // Markdown protocol specifying an SCCS with no exposure risk window,
      // beside a .docx specifying the full strip. In a self-controlled design
      // the period strip IS the analysis. The escaper now lives once in
      // ProtocolCommon, which also collapses newlines; this copy was the only
      // one of the three that did not, and nothing reaching it can carry one
      // today, so that part is hardening rather than a fix.
      const tc = (v) => window.PC.mdCell(v);
      const bullets = (arr) => arr.length === 0 ? "_(none specified)_" : arr.map((l) => "- " + l).join("\n");
      const numbered = (arr) => arr.length === 0 ? "_(none)_" : arr.map((l, i) => (i + 1) + ". " + l).join("\n");
      const orFb = (s, fb) => (s && s.trim()) ? s : fb;
      // What the abstract is allowed to say the analysis was.
      //
