          out.push({ lvl: "info", t: "A look-back window is zero days long", d: zeroCov.map((r) => "“" + r.name + "”").join(", ") + " " + (zeroCov.length > 1 ? "have" : "has") + " a look-back of 0 days, so nothing is measured in " + (zeroCov.length > 1 ? "them" : "it") + ". " + (zeroCov.length > 1 ? "They are" : "It is") + " not drawn on the figure, but the exported protocol still names " + (zeroCov.length > 1 ? "them" : "it") + " — give a length or delete the line." });
        }
        // The mirror of the "No reference (baseline) period" stop below. Without
        // it, a strip of nothing but Reference segments exported "Time zero (day
        // 0): each case's own first exposure" into the Word figure's window list
        // and drew an "Exposure start (day 0)" anchor, both describing an
        // exposure the strip does not contain.
        if (periods.length && !expSegs.length) {
          out.push({ lvl: "stop", t: "No exposure risk period", d: "The strip has no exposure risk period, so no person-time is classified as exposed and there is nothing to compare the reference time against — and because day 0 is defined as the start of the first exposure segment, the figure and its written window list have no anchor to describe. Add an Exposure risk period from the chips under the strip." });
        }
        // Choosing the active-comparator variant used to export a protocol that
        // contradicts itself one table later. Section 5 says "case-time on the
        // index drug compared with case-time on a comparator drug (no reliance
        // on a 'no-drug' baseline)"; section 6's baseline field still carries
        // its authored default, "All observation time NOT in pre-risk, risk, or
        // post-risk windows" — which is precisely a no-drug baseline. And the
        // comparator drug itself is named nowhere in the document, because the
        // form has no field for it. The tool cannot supply the drug, so it says
        // where to put it rather than inventing one.
        if (s.sccsVariant === "active-comparator" && !/comparator|reference drug/i.test(String(s.baselinePeriod || ""))) {
          out.push({ lvl: "stop", t: "An active-comparator SCCS with no comparator", d: "The design variant is active-comparator, whose whole point is that the baseline is time on a comparator drug rather than untreated time — but the baseline (control) period is still defined as all observation time outside the risk windows, which is the untreated baseline this variant exists to avoid, and no comparator drug is named anywhere in the protocol. The exported document therefore states both things, two sections apart. Name the comparator drug and its code set in the baseline (control) period definition." });
        }
        if (periods.some((p) => p.kind === "washout")) {
          out.push({ lvl: "warn", t: "Say what happens to the washout time", d: "The strip contains a washout / carry-over period. That is not the same thing as a post-exposure risk window: a post-risk window is a parameter the conditional Poisson model estimates, whereas washout time is often removed from the likelihood altogether so that carry-over does not contaminate the reference rate. Both treatments appear in the SCCS literature, this tool cannot tell which you mean, and they give different reference rates, so state which one applies in the baseline (control) period definition." });
        }
        if (periods.length && !periods.some((p) => p.kind === "reference")) {
          out.push({ lvl: "stop", t: "No reference (baseline) period", d: "The strip has no unexposed reference time, so there is nothing for the risk window to be a rate ratio against. Add a Reference period, or switch to the active-comparator variant in the design-variant section, where the comparator drug's time supplies the baseline." });
        }
        const censorsAtDeath = s.obsEnd === "death" || s.obsEnd === "earliest-of";
        if (censorsAtDeath && FATAL_RX.test(outcomeBlob)) {
          out.push({ lvl: "stop", t: "The outcome looks fatal, and observation ends at death", d: "Assumption 2. Observation time then ends because the event happened, which is exactly the dependence the standard SCCS likelihood forbids; when the outcome is death the standard model does not apply at all. Restrict to non-fatal events, or use a method for event-dependent observation periods (Farrington et al, JASA 2011), and say which in the design assumptions section." });
        } else if (censorsAtDeath && HIGH_MORTALITY_RX.test(outcomeBlob)) {
          out.push({ lvl: "warn", t: "This outcome may raise short-term mortality, and observation ends at death", d: "Assumption 2. Case-fatal events shorten the observation period for the people who have them, which biases the standard SCCS. Report the case-fatality of the outcome in your data; if it is appreciable, either restrict to survivors of the index event or use a method for event-dependent observation periods." });
        }
        if (s.eventHandling !== "first" && FATAL_RX.test(outcomeBlob)) {
          out.push({ lvl: "warn", t: "Recurrent-event handling with an outcome that can happen only once", d: "Assumption 3. The Event handling field is set to all events per person, but the outcome as written cannot recur. Set it to first event only." });
        }
        // "Restrict to first event only (vs all events)" ships ticked. When the
        // primary analysis is already first-event-only, the protocol
        // pre-specifies a sensitivity analysis identical to its own primary
        // analysis — and both statements are exported, three sections apart.
        if (s.eventHandling === "first" && (s.sensitivityPick || []).some((x) => /Restrict to first event only/i.test(x))) {
          out.push({ lvl: "warn", t: "A sensitivity analysis that repeats the primary analysis", d: "The case definition is set to first event only per person, and \"Restrict to first event only (vs all events)\" is also ticked as a sensitivity analysis — so the protocol pre-specifies, as a check on its primary analysis, the primary analysis. If the point is to test the independence assumption, the informative direction is the other one: run it with all events per person and compare. Note which way round that reads — under clustering it is the all-events interval that is too narrow, and the first-event analysis that is conservative." });
        }
        if (s.seasonAdj === "none") {
          out.push({ lvl: "info", t: "Season not adjusted", d: "Assumption 4. Seasonality is a within-person time-varying confounder that the self-controlled design does not remove. If the outcome or the prescribing has any seasonal pattern, adjust for calendar month; if you leave it out, state why in the protocol." });
        }
        return out;
      };
      const renderSccsChecks = (s) => {
        const box = document.querySelector("[data-checks]"); if (!box) return;
        const notes = sccsChecks(s);
        if (!notes.length) { box.classList.add("hidden"); box.innerHTML = ""; return; }
        const style = { stop: ["bg-rose-50 border-rose-300", "text-rose-900", "⛔"], warn: ["bg-amber-50 border-amber-300", "text-amber-900", "⚠"], info: ["bg-slate-50 border-slate-300", "text-slate-700", "ℹ"] };
        box.innerHTML = '<p class="text-[10px] uppercase tracking-[0.2em] font-bold text-slate-500">Checks against what you entered</p><div class="mt-2 space-y-2">' +
          notes.map((n) => { const st = style[n.lvl]; return '<div class="rounded-lg border ' + st[0] + ' p-3 text-xs ' + st[1] + '"><p class="font-bold">' + st[2] + " " + esc(n.t) + '</p><p class="mt-1 leading-relaxed">' + esc(n.d) + "</p></div>"; }).join("") + "</div>";
        box.classList.remove("hidden");
        // Re-picking the option a select already shows fires no event at all,
        // so a user content with the value it was left at had no way to answer
        // a stop that names it — and the note now survives every reload and
        // prints in every export. A stop nobody can dismiss is what teaches
        // people to ignore the panel.
        if (staleSelects.length) {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "mt-2 rounded-lg border border-rose-400 px-3 py-1 text-xs font-semibold text-rose-900 hover:bg-rose-100";
          b.textContent = staleSelects.length === 1
            ? "Keep “" + clipOne(staleSelects[0].kept, 40) + "”"
            : "Keep all " + staleSelects.length + " substituted choices";
          b.addEventListener("click", () => { staleSelects = []; render(); });
          box.appendChild(b);
        }
      };

      // Once the user has set the control the warning is about, the warning is
      // not merely stale — it is false, and it is a blocker. Left uncleared it
      // said "SCCS variant … has been left at Standard SCCS" in section 8 of a
      // protocol whose section 5 read "Active-comparator within-person SCCS",
      // and it travelled into the Word file and STROBE item 19 that way. A stop
      // nobody can dismiss is exactly what teaches people to ignore the panel.
      // Retire by VALUE, not by event. Listening for input/change missed every
      // control this page writes to itself — the phenotype library's picker
      // sets el.value and re-renders without firing either — so the note
      // survived and then called the option the user had just picked with the
      // page's own picker a specification nobody chose. Anything that moves the
      // select off the value it was left at is an answer, however it moved.
      const retireAnswered = () => {
        if (!staleSelects.length) return;
        staleSelects = staleSelects.filter((x) => {
          const el = form.elements[x.name];
          return !el || !el.options || el.value === x.keptValue;
        });
      };

      const render = () => {
        const state = readForm();
        retireAnswered();
        preview.textContent = buildMarkdown(state);
        // Without the reserved key this line destroys the note it just raised.
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(
            staleSelects.length ? Object.assign({}, state, { [STALE_KEY]: staleSelects }) : state));
        } catch (e) { console.warn("draft not saved", e); }
        renderFeasibility(state);
        try { renderSccsChecks(state); } catch (e) { console.error("assumption checks failed", e); }
        try { renderScheme(state); } catch (e) { console.error("renderScheme failed", e); }
      };
      // Never a bare catch here: this is the only path that restores a saved
      // draft or a ?seed= link, and swallowing its failure loses the user's work
      // with no trace on screen or in the console.
      try { window.PC && PC.restore ? PC.restore(form, STORAGE_KEY, writeForm) : (localStorage.getItem(STORAGE_KEY) && writeForm(JSON.parse(localStorage.getItem(STORAGE_KEY)))); }
      catch (e) { console.error("could not restore the saved draft", e); setMsg("Your saved draft could not be restored; the form has been left at its defaults.", true); }
      const timelineTa = form.querySelector('[name="timeline"]');
      if (timelineTa && !timelineTa.value) timelineTa.value = TIMELINE_PRESETS["12-month"];
      // HARPER item 3. Mounted after restore so the editor paints the rows the
      // saved draft (or a ?seed= link) actually carried.
      if (window.PC && PC.mountAmendments) PC.mountAmendments(form);
      render();
      form.addEventListener("input", render);
      form.addEventListener("change", render);

      form.addEventListener("click", (e) => {
        const addRow = e.target?.closest?.("[data-add-row]");
        if (addRow) {
          const el = form.elements[addRow.dataset.target], name = addRow.dataset.name;
          if (el) { const rows = parseRows(el.value); if (!rows.some((r) => r.name === name)) { rows.push({ name: name, days: 365, ok: true, empty: false, raw: "365" }); el.value = rowsJoin(rows); render(); } }
          return;
        }
        const addP = e.target?.closest?.("[data-add-period]");
        if (addP) {
          const el = form.elements.periods, name = addP.dataset.name;
          if (el) { const ps = parsePeriods(el.value); const d = /reference/i.test(name) ? 90 : 14; ps.push({ name: name, days: d, ok: true, empty: false, raw: String(d) }); el.value = periodsJoin(ps); render(); }
          return;
        }
