      const buildStrobeDocx = async (s) => {
        const D = docx;
        const FONT = "Times New Roman";
        const today = new Date().toISOString().slice(0, 10);
        const text = (str, o = {}) => new D.TextRun({ text: String(str ?? ""), font: FONT, size: 22, ...o });
        const p = (ch, o = {}) => new D.Paragraph({ children: Array.isArray(ch) ? ch : [ch], spacing: { before: 50, after: 50 }, ...o });
        const border = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" };
        const cb = { top: border, bottom: border, left: border, right: border };
        const cell = (children, opt = {}) => new D.TableCell({ borders: cb, margins: { top: 60, bottom: 60, left: 120, right: 120 }, ...opt, children });
        const headerCell = (str) => new D.TableCell({ borders: cb, shading: { fill: "21443E", type: D.ShadingType.CLEAR }, margins: { top: 80, bottom: 80, left: 120, right: 120 }, children: [p([text(str, { bold: true, color: "FFFFFF" })])] });
        const where = strobeWhere(s);
        const rows = [new D.TableRow({ tableHeader: true, children: [headerCell("#"), headerCell("STROBE recommendation"), headerCell("Where addressed in this protocol")] })];
        for (const sec of STROBE_ITEMS) {
          rows.push(new D.TableRow({ children: [new D.TableCell({ borders: cb, columnSpan: 3, shading: { fill: "E8F0EE", type: D.ShadingType.CLEAR }, margins: { top: 60, bottom: 60, left: 120, right: 120 }, children: [p([text(sec.section, { bold: true, color: "21443E" })])] })] }));
          for (const [n, rec] of sec.items) {
            const w = where[n] || "[To be completed at the time of reporting.]";
            rows.push(new D.TableRow({ children: [
              cell([p([text(n, { bold: true })])], { width: { size: 700, type: D.WidthType.DXA }, shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR } }),
              cell([p([text(rec)])], { width: { size: 4163, type: D.WidthType.DXA } }),
              cell(String(w).split("\n").map((l) => p([text(l)])), { width: { size: 4163, type: D.WidthType.DXA } }),
            ] }));
          }
        }
        const table = new D.Table({ width: { size: 9026, type: D.WidthType.DXA }, columnWidths: [700, 4163, 4163], rows });
        const children = [
          new D.Paragraph({ children: [text("STROBE checklist; " + (s.title || "(Untitled multi-national SCCS study)"), { bold: true, size: 32 })], spacing: { after: 120 } }),
          p([new D.TextRun({ text: "This document maps the protocol fields to the STROBE statement (von Elm E, et al. PLoS Med 2007;4:e296). Methods items are pre-filled from your protocol; Results / Discussion items are placeholders to complete at the time of reporting. Full checklist with elaboration: strobe-statement.org.", font: FONT, size: 20, italics: true, color: "555555" })]),
          p([new D.TextRun({ text: "Generated " + today + " from the AsPEN SCCS protocol builder.", font: FONT, size: 18, italics: true, color: "777777" })]),
          table,
        ];
        const doc = new D.Document({ sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }] });
        return await D.Packer.toBlob(doc);
      };

      const buildDocx = async (s) => {
        const D = docx;
        const FONT = "Times New Roman";
        const today = new Date().toISOString().slice(0, 10);
        const text = (str, opts = {}) => new D.TextRun({ text: String(str ?? ""), font: FONT, size: 22, ...opts });
        const p = (children, opts = {}) => new D.Paragraph({ children: Array.isArray(children) ? children : [children], spacing: { before: 60, after: 60, ...(opts.spacing || {}) }, ...opts });
        const h1 = (str) => new D.Paragraph({ children: [text(str, { bold: true, size: 28 })], spacing: { before: 200, after: 80 }, heading: D.HeadingLevel.HEADING_1 });
        const h2 = (str) => new D.Paragraph({ children: [text(str, { bold: true, size: 24 })], spacing: { before: 160, after: 60 }, heading: D.HeadingLevel.HEADING_2 });
        const para = (str) => p([text(str)]);
        const bullet = (str) => new D.Paragraph({ children: [text(str)], bullet: { level: 0 }, spacing: { before: 0, after: 0 } });
        const numItem = (str) => new D.Paragraph({ children: [text(str)], numbering: { reference: "ordered", level: 0 }, spacing: { before: 0, after: 0 } });
        const border = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" };
        const cellBorders = { top: border, bottom: border, left: border, right: border };
        const labelTable = (rows) => new D.Table({
          width: { size: 9026, type: D.WidthType.DXA },
          columnWidths: [3000, 6026],
          rows: rows.map(([l, v]) => new D.TableRow({
            children: [
              new D.TableCell({ borders: cellBorders, width: { size: 3000, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR }, children: [p([text(l, { bold: true })])] }),
              new D.TableCell({ borders: cellBorders, width: { size: 6026, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, children: [p([text(v || "-")])] }),
            ],
          })),
        });

        const refs = refsOf(s);
        const milestones  = (s.timeline || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const subgroups   = mergeList(s.subgroupsPick, s.subgroupsCustom);
        const tvCovs      = (s.tvCovariates || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const sensitivity = mergeList(s.sensitivityPick, s.sensitivityCustom);
        const sitesPart = (s.sites && s.sites.length > 0) ? s.sites.map((c) => formatSiteFull(c)).join("; ") : "";
        const sitesOthersList = (s.sitesOther || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const sitesText = !sitesPart && sitesOthersList.length === 0 ? "(no sites selected)" : [sitesPart, sitesOthersList.length > 0 ? ("Others: " + sitesOthersList.join("; ")) : ""].filter(Boolean).join(" | ");
        const ageBand = ({ "6m": "6-month", "1m": "1-month", "3m": "3-month", "12m": "12-month" })[s.ageBands] || "6-month";
        const season  = ({ month: "Calendar month (12-level)", season: "Season (4-level)", none: "Not adjusted" })[s.seasonAdj] || "Calendar month";
        const riskWin = ({ entire: "Entire exposure episode", "0-30": "Days 0-30 after exposure start", "0-90": "Days 0-90 after exposure start", "0-180": "Days 0-180 after exposure start", "early-late": "Early (0-14 d) and Late (15+ d) split" })[s.riskWindowDef] || "Entire exposure episode";
        const meta = ({ re: "Random-effects (DerSimonian-Laird) meta-analysis; report I² and τ²; forest plot per outcome.", "re-reml": "Random-effects (REML); report I² and τ²; forest plot per outcome.", fe: "Fixed-effects (inverse-variance) meta-analysis; forest plot per outcome." })[s.metaMethod] || "Random-effects meta-analysis";
        const arch = ({ federated: "Federated; each AsPEN site executes locally; only aggregate site-level estimates leave.", cdm: "Common Data Model; site transforms to agreed CDM, runs shared package.", centralised: "Centralised; pooled individual data under DUA." })[s.arch] || "Federated";
        const eventHandling = s.eventHandling === "first" ? "First event only per person" : "All events per person (recurrent events allowed)";
        const sccsVariantText = ({
          "standard":           "Standard SCCS (Farrington 1995); within-person comparison of exposed vs unexposed time.",
          "extended-unexposed": "SCCS extended with unexposed reference cases (Whitaker et al, Stat Med 2006); augments within-person estimation with never-exposed cohort members.",
          "active-comparator":  "Active-comparator within-person SCCS; case-time on the index drug compared with case-time on a comparator drug.",
        })[s.sccsVariant] || "Standard SCCS";
        const sccsVariantShort = ({
          "standard":           "Standard SCCS",
          "extended-unexposed": "SCCS extended with unexposed reference cases",
          "active-comparator":  "Active-comparator within-person SCCS",
        })[s.sccsVariant] || "Standard SCCS";

        let __phdcLogo = null; try { const __r = await fetch("/images/networks/phdc.png"); if (__r.ok) __phdcLogo = new Uint8Array(await __r.arrayBuffer()); } catch (e) {}
        const children = [];
        if (__phdcLogo) children.push(new D.Paragraph({ spacing: { after: 120 }, children: [new D.ImageRun({ data: __phdcLogo, transformation: { width: 210, height: 51 } })] }));
        children.push(new D.Paragraph({ children: [text(s.title || "(Untitled multi-national SCCS study)", { bold: true, size: 32 })], spacing: { before: 0, after: 120 } }));
        children.push(labelTable([
          ["Study ID", s.shortId || ""],
          ["Lead investigator(s)", s.leadInvestigator || ""],
          ["Version", s.version || ("v0.1 draft · " + today)],
          ["Design", "Multi-national self-controlled case series (SCCS); " + sccsVariantShort],
        ]));

        window.PC.abstractDocx(D, pcOf(s)).forEach((c) => children.push(c));
        children.push(h1("1. Research question"));
        children.push(labelTable([["Population", s.picoP || ""], ["Exposure", s.picoI || ""], ["Outcome", s.picoO || ""]]));

        children.push(h1("2. Sites"));
        children.push(para(sitesText));

        children.push(h1("3. Case definition (outcome)"));
        children.push(p([text("Operational definition. ", { bold: true }), text(s.outcomeDef || "-")]));
        children.push(p([text("Code set. ", { bold: true }), text(s.outcomeCodes || "-")]));
        children.push(p([text("Event handling. ", { bold: true }), text(eventHandling)]));

        children.push(h1("4. Exposure definition"));
        children.push(labelTable([
          ["Name", s.exposureName || ""],
          ["Code set", s.exposureCodes || ""],
          ["Days of supply (default)", rowDays(readDays(s.daysOfSupply))],
          ["Grace period", rowDays(readDays(s.grace))],
          ["Exposure period rule", s.exposurePeriodDef || "Continuous exposure inferred from sequential dispensings; gap > grace period ends the episode."],
        ]));

        children.push(h1("5. Design variant"));
        children.push(para(sccsVariantText));

        children.push(h1("6. Risk windows"));
        children.push(labelTable([
          ["Timeline anchor", s.sccsAnchor === "calendar" ? "Calendar-anchored — common start " + (s.cohortStart || "(date)") + "; baseline " + (s.baselineYears || "1") + " calendar year(s)" : "Exposure-anchored — day 0 = first exposure"],
          ["Risk / reference periods", parsePeriods(s.periods).map((p) => p.name + " " + rowDays(p)).join(" → ") || "(define the period strip)"],
          ["Risk window definition", riskWin],
          ["Baseline (control) period", s.baselinePeriod || "All observation time NOT in pre-risk, risk, or post-risk windows"],
          ["Covariate / eligibility look-back", covLookbackText(s)],
        ]));

        // HARPER item 7.2. Placed with section 6 because in an SCCS the figure
        // IS the risk-window specification; `designDiagramDocx` emits a visible
        // note in the document when the picture cannot be made, never a silently
        // absent figure.
        const FIG_CAPTION = "Figure 1. SCCS design diagram — the case's observation time as one continuous strip of consecutive periods, with covariate look-back windows, on a day axis relative to day 0.";
        // When the strip cannot be read there is deliberately no SVG on the
        // page, and the shared helper's stock note — "please paste a screenshot
        // of the on-screen diagram here" — then asks for something that does not
        // exist and describes a principled refusal as a missing element. Say
        // what actually happened instead, and keep the written window list,
        // which is the only description of the design the document can carry.
        const stripBad = badRows(parsePeriods(s.periods));
        lastFigNote = "";
        if (stripBad.length) {
          children.push(new D.Paragraph({ spacing: { before: 160, after: 40 }, children: [new D.TextRun({
            text: "[No study design diagram is included, because the period strip does not specify one: " +
              stripBad.map((r) => "“" + r.name + "” " + (r.empty ? "has no length" : "gives its length as “" + r.raw + "”, which is not a whole number of days")).join("; ") +
              ". HARPER item 7.2 requires a design diagram; give every period a length in whole days and export again. No figure has been drawn rather than one asserting a window this protocol does not define.]",
            font: FONT, size: 18, italics: true, color: "B45309" })] }));
          stripLines(s).forEach((l) => children.push(bullet(l)));
          lastFigNote = " Exported WITHOUT the design diagram: a window length could not be read, and the document says which.";
        } else {
          const fig = await window.designDiagramFigure(document.getElementById("diagram"), { caption: FIG_CAPTION });
          fig.lines = stripLines(s);
          const figParas = window.designDiagramDocx(D, fig, { font: FONT, caption: FIG_CAPTION });
          figParas.forEach((c) => children.push(c));
          if (!figParas.placed) lastFigNote = " Exported WITHOUT the design diagram: " + (fig.reason || figParas.error || "unknown reason") + ". The document says so where the figure should be.";
        }

        children.push(h1("7. Observation period"));
        children.push(labelTable([
          ["Period starts at", ({ "age-cohort": "Later of (a) calendar start or (b) cohort entry age", "study-start": "Calendar start of study period", "age-onset": "Age at first eligibility", enrolment: "Date of database registration" })[s.obsStart] || "-"],
          ["Period ends at", ({ "earliest-of": "Earliest of: end of study period, death, disenrolment", "study-end": "Calendar end of study period", death: "Death", disenrol: "Disenrolment from database" })[s.obsEnd] || "-"],
          ["Study calendar period", s.studyCalendar || "-"],
        ]));

        children.push(h1("8. Design assumptions and checks"));
        ASSUMPTIONS.forEach((a, i) => {
          children.push(p([text((i + 1) + ". " + a.t + ". ", { bold: true }), text(a.plain)]));
          children.push(p([text("Why it matters. ", { italics: true }), text(a.precise)]));
          children.push(p([text("What we do about it. ", { italics: true }), text(a.check + " [" + a.cite + "]")]));
        });
        const openChecks = sccsChecks(s, true);
        if (openChecks.length) {
          children.push(h2("Outstanding issues in this draft"));
          openChecks.forEach((x) => children.push(bullet(x.t + ". " + x.d)));
        } else {
          children.push(para("The automated checks found nothing outstanding. They test only what the form can see — the structure of the period strip, the censoring rule, the season setting and the wording of the outcome — and are not a substitute for the investigator's judgement on assumptions 1-4 above."));
        }

        children.push(h1("9. Time-varying confounders"));
        children.push(labelTable([["Age bands", ageBand + " bands"], ["Season", season]]));
        children.push(h2("Other time-varying covariates"));
        tvCovs.length ? tvCovs.forEach((l) => children.push(bullet(l))) : children.push(para("(none specified)"));

        children.push(h1("10. Statistical analysis"));
        children.push(labelTable([
          ["Primary model", s.primaryModel || "Conditional Poisson regression with offset for log person-time"],
          ["Effect estimate", s.effectMeasure || "Incidence rate ratio (IRR) with 95% CI"],
          ["Meta-analysis", meta],
        ]));
        children.push(h2("Subgroup analyses"));
        subgroups.length ? subgroups.forEach((l) => children.push(bullet(l))) : children.push(para("(none specified)"));
        children.push(h2("Sensitivity analyses"));
        sensitivity.length ? sensitivity.forEach((l) => children.push(bullet(l))) : children.push(para("(none specified)"));

        children.push(h1("11. Execution and timeline"));
        children.push(labelTable([["Architecture", arch]]));
        children.push(h2("Timeline milestones"));
        milestones.length ? milestones.forEach((l) => children.push(numItem(l))) : children.push(para("(none)"));

        children.push(h1("12. Ethics, data sharing, dissemination"));
        children.push(p([text("Ethics. ", { bold: true }), text(s.ethics || "Each participating site obtains local IRB / ethics approval before data extraction.")]));
        children.push(p([text("Dissemination. ", { bold: true }), text(s.dissemination || "Primary manuscript to a peer-reviewed pharmacoepidemiology journal.")]));

        window.PC.tailDocx(D, pcOf(s)).forEach((c) => children.push(c));
        children.push(h1("13. Key references"));
        refs.length ? refs.forEach((l) => children.push(numItem(l))) : children.push(para("(none)"));

        children.push(p([new D.TextRun({ text: "Drafted with the AsPEN SCCS protocol builder (" + today + ").", font: FONT, size: 18, italics: true, color: "808080" })], { spacing: { before: 400 } }));

        const doc = new D.Document({
          creator: "AsPEN protocol builder",
          title: s.title || "AsPEN SCCS protocol",
          styles: {
            default: { document: { run: { font: FONT, size: 22 } } },
            paragraphStyles: [
              { id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 28, bold: true, font: FONT }, paragraph: { spacing: { before: 200, after: 80 }, outlineLevel: 0 } },
              { id: "Heading2", name: "Heading 2", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 24, bold: true, font: FONT }, paragraph: { spacing: { before: 160, after: 60 }, outlineLevel: 1 } },
            ],
          },
          numbering: { config: [{ reference: "ordered", levels: [{ level: 0, format: D.LevelFormat.DECIMAL, text: "%1.", alignment: D.AlignmentType.LEFT, style: { paragraph: { indent: { left: 720, hanging: 360 } } } }] }] },
          sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }],
        });
        return await D.Packer.toBlob(doc);
      };

      // ── Phenotype library modal (same shape as ACNU) ──
      const modal = document.querySelector("[data-library-modal]");
      const modalTitle = document.querySelector("[data-library-title]");
      const modalList = document.querySelector("[data-library-list]");
      const modalSearch = document.querySelector("[data-library-search]");
      let currentCategory = "outcomes";
      let currentTargets = {};

      const renderLibrary = (filter = "") => {
        const items = PHENOTYPES[currentCategory] || [];
        const f = filter.trim().toLowerCase();
        const filtered = f ? items.filter((it) => (it.name || "").toLowerCase().includes(f) || (it.codes || "").toLowerCase().includes(f) || (it.definition || "").toLowerCase().includes(f) || (it.validation || "").toLowerCase().includes(f)) : items;
        if (filtered.length === 0) { modalList.innerHTML = '<p class="px-3 py-6 text-sm text-slate-500 italic text-center">No phenotype matches.</p>'; return; }
        // The validation citation used to be hidden here and appended silently
        // to the reference list at export. Under a modal captioned "Validated
        // phenotype library" that is the wrong way round: the one thing a user
        // picking a validated definition needs to see is what the validation
        // actually is, and — more often than not — that there isn't one.
        modalList.innerHTML = filtered.map((it, idx) => `
          <button type="button" data-phenotype-idx="${idx}" class="block w-full text-left px-4 py-3 rounded-lg border border-transparent hover:border-brand-300 hover:bg-brand-50/40 transition">
            <p class="font-semibold text-slate-900 text-sm">${esc(it.name)}</p>
            ${it.codes ? `<p class="mt-1 text-xs text-slate-700 font-mono leading-relaxed">${esc(it.codes)}</p>` : ""}
            ${it.definition ? `<p class="mt-1 text-xs text-slate-600 leading-relaxed">${esc(it.definition)}</p>` : ""}
            ${it.validation
              ? `<p class="mt-1.5 text-[11px] text-emerald-800 leading-relaxed"><span class="font-bold uppercase tracking-widest text-[9px]">Validation</span> · ${esc(it.validation)} <span class="text-slate-500">(added to your reference list)</span></p>`
              : `<p class="mt-1.5 text-[11px] text-amber-800 leading-relaxed"><span class="font-bold uppercase tracking-widest text-[9px]">No validation study attached</span> · nothing is added to your reference list; supply one before relying on this definition.</p>`}
            ${it.provenance ? `<p class="mt-1 text-[11px] text-slate-500 leading-relaxed">${esc(it.provenance)}</p>` : ""}
          </button>
        `).join("");
        modalList.querySelectorAll("[data-phenotype-idx]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const it = filtered[parseInt(btn.dataset.phenotypeIdx, 10)];
            if (!it) return;
            const fill = (key, val) => { const fieldName = currentTargets[key]; if (!fieldName || val === undefined) return; const el = form.querySelector(`[name="${fieldName}"]`); if (el) el.value = val; };
            fill("name", it.name);
            fill("codes", it.codes);
            fill("def", it.definition);
            if (currentTargets.alsoFill) { const el = form.querySelector(`[name="${currentTargets.alsoFill}"]`); if (el && it.name) el.value = it.name; }
            // Keyed by the field the phenotype's name was written into, not by
            // the phenotype's name — so picking a second outcome replaces the
            // first one's citation instead of accumulating beside it.
            const citeField = currentTargets.alsoFill || currentTargets.name;
            if (citeField) {
              if (it.validation) pickedCitations[citeField] = { name: it.name, cite: it.validation };
              else delete pickedCitations[citeField];
              savePickedCitations();
            }
            closeLibrary();
            render();
          });
        });
      };
      const openLibrary = (category, targets) => {
        currentCategory = category;
        currentTargets = targets;
        modalTitle.textContent = ({ outcomes: "Pick an outcome (case definition)", exposures: "Pick a drug class (exposure)" })[category] || "Pick a phenotype";
        modalSearch.value = "";
        renderLibrary("");
        modal.classList.remove("hidden");
        setTimeout(() => modalSearch.focus(), 50);
      };
      const closeLibrary = () => modal.classList.add("hidden");
      document.querySelectorAll("[data-open-library]").forEach((btn) => {
        btn.addEventListener("click", () => openLibrary(btn.dataset.category, { name: btn.dataset.targetName, codes: btn.dataset.targetCodes, def: btn.dataset.targetDef, alsoFill: btn.dataset.alsoFill }));
      });
      document.querySelector("[data-library-close]")?.addEventListener("click", closeLibrary);
      modal.addEventListener("click", (e) => { if (e.target === modal) closeLibrary(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeLibrary(); });
      modalSearch.addEventListener("input", () => renderLibrary(modalSearch.value));

      // Exported for testing (and any future reuse): the IIFE otherwise hides these.
      window.__builder = { readForm, buildMarkdown, buildDocx };

      setState("ready");
    })();
  </script>
</BaseLayout>
