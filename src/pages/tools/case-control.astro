---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhenotypeLibrary from "../../components/PhenotypeLibrary.astro";
import SitesPicker from "../../components/SitesPicker.astro";
import DesignDiagram from "../../components/DesignDiagram.astro";
import ProtocolCommon from "../../components/ProtocolCommon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const MATCHING = [
  "Age (± 2–5 years)",
  "Sex",
  "Index / calendar date",
  "Region / site",
  "Primary-care practice",
  "Duration of database enrolment",
];
const COVARIATES = [
  "Comorbidities (e.g. Charlson index)",
  "Comedications",
  "Smoking status",
  "Body-mass index",
  "Alcohol use",
  "Prior healthcare utilisation",
  "Socioeconomic status",
];
const SUBGROUPS = [
  "Age group (e.g. ≥65 vs <65)",
  "Sex (male vs female)",
  "Region / hospital level",
  "Comorbidity burden",
  "Calendar sub-period",
  "Duration / dose of exposure",
];
const SENSITIVITY = [
  "Controls per case (1:1 vs 1:4)",
  "Alternative exposure-ascertainment window",
  "Matched vs unmatched analysis",
  "Exclude exposure in the immediate pre-index window (latency)",
  "Negative-control exposure",
  "Alternative outcome / case definition",
  "Alternative control-sampling scheme",
];
---

<BaseLayout
  title="Case-Control protocol — Daniel Tsai"
  description="A free, in-browser protocol builder for case-control studies — risk-set / cumulative / case-cohort sampling, matching, exposure ascertainment, and conditional or unconditional logistic regression. One-click Word / Markdown export."
>
  <header class="relative bg-gradient-to-br from-brand-50 via-white to-brand-100/40 border-b border-slate-200 overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
      <p class="uppercase tracking-widest text-xs text-brand-600 font-semibold mb-2">Protocol Generator · CC</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">Case-Control protocol</h1>
      <p class="mt-3 text-base text-slate-600 max-w-3xl">
        <strong>In plain terms.</strong> You find the people who got the disease, then you find comparable people who
        did not, and you look backwards to see who had the exposure. It is efficient because you only have to look at
        a sample of the people who stayed well. Nearly everything that goes wrong with a case-control study goes wrong
        in <em>how that sample is chosen</em>.
      </p>
      <details class="mt-3 max-w-3xl text-sm text-slate-600">
        <summary class="cursor-pointer font-semibold text-brand-700">The one rule that decides whether the study is valid</summary>
        <p class="mt-2">
          <strong>Controls must represent the source population — the person-time — that produced the cases.</strong>
          Controls are not a "healthy comparison group": they are a sample of the denominator. If a person in your
          control sample had developed the outcome, they would have been captured as one of your cases. If that is not
          true, the sample is not of the study base and the odds ratio is biased no matter how the analysis is done
          (Wacholder 1992; Vandenbroucke &amp; Pearce 2012).
        </p>
        <p class="mt-2">
          <strong>How you sample decides what the odds ratio means</strong>, and it is not always an approximation:
        </p>
        <ul class="mt-1 ml-4 list-disc space-y-1">
          <li><strong>Incidence-density (risk-set) sampling</strong> — a control is drawn from those still at risk at
            the moment each case occurs. The odds ratio estimates the <strong>incidence-rate ratio</strong>, with
            <em>no rare-disease assumption</em>. Controls may later become cases, and a person may be sampled more
            than once; that is correct, not an error.</li>
          <li><strong>Cumulative (survivor) sampling</strong> — controls are drawn from those still outcome-free at the
            end of follow-up. The odds ratio approximates the risk ratio <strong>only if the outcome is rare</strong>;
            otherwise it overstates it.</li>
          <li><strong>Case-cohort (case-base) sampling</strong> — controls are a random subcohort drawn at baseline.
            The odds ratio estimates the <strong>risk ratio</strong>, again with no rare-disease assumption, and one
            subcohort can serve several outcomes. It needs an analysis that accounts for subcohort members appearing
            in several risk sets (weighted estimation with a robust variance), not a plain matched-set analysis.</li>
        </ul>
        <p class="mt-2">
          Knol et al (2008) found that 90% of published case-control studies reported an "odds ratio" when their
          sampling scheme entitled them to name a rate ratio or a risk ratio. Say which one you are estimating.
        </p>
      </details>
      <a class="mt-4 inline-block text-sm text-brand-700 hover:underline font-semibold" href={`${base}/tools/protocol-generator`}>← All designs</a>
    </div>
  </header>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid gap-8 lg:grid-cols-[1fr_1fr] items-start">
      <form id="form" class="protocol-form space-y-6">
        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">1 · Identity</legend>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Study title</span>
            <input name="title" placeholder="e.g. NSAIDs and upper-GI bleeding: a matched case-control study" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Data source(s)</span>
            <input name="data" placeholder="e.g. Taiwan NHIRD (2010–2020)" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <SitesPicker target="data" />
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">2 · Question</legend>
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Source population</span>
              <button type="button" data-open-library data-category="indications" data-target-name="population" class="text-[11px] text-brand-700 font-semibold hover:underline">📚 Library</button>
            </div>
            <input name="population" placeholder="e.g. Adults in the NHI database, 2010–2020" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Exposure</span>
                <button type="button" data-open-library data-category="exposures" data-target-name="exposure" class="text-[11px] text-brand-700 font-semibold hover:underline">📚</button>
              </div>
              <input name="exposure" placeholder="e.g. NSAID dispensing" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
            </div>
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Outcome (defines cases)</span>
                <button type="button" data-open-library data-category="outcomes" data-target-name="outcome" class="text-[11px] text-brand-700 font-semibold hover:underline">📚</button>
              </div>
              <input name="outcome" placeholder="e.g. Hospitalised upper-GI bleeding" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
            </div>
          </div>
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">3 · Cases, index date &amp; controls</legend>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Case definition</span>
            <input name="casedef" placeholder="e.g. First hospitalisation with a primary diagnosis of upper-GI bleeding" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Index date</span>
            <input name="indexdate" placeholder="e.g. The case's event (admission) date; matched controls take the same date" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Control sampling</span>
              <select name="sampling" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
                <option value="riskset">Incidence-density (risk-set) sampling</option>
                <option value="cumulative">Cumulative (survivor) sampling</option>
                <option value="casecohort">Case-cohort (controls = random subcohort)</option>
              </select></label>
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Controls per case</span>
              <input type="number" name="nControls" value="4" min="1" max="20" step="1" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          </div>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Matching factors (tick to match on)</span>
            <div class="mt-1.5 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1">
              {MATCHING.map((mf, i) => (
                <label class="flex items-start gap-2 text-xs text-slate-700">
                  <input type="checkbox" name="matchingPick" value={mf} checked={i < 3} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{mf}</span>
                </label>
              ))}
            </div>
            <textarea name="matchingCustom" rows="1" class="mt-2 w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="Custom matching factors (one per line)"></textarea>
          </div>
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">4 · Exposure &amp; covariate ascertainment</legend>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Exposure definition</span>
            <input name="expdef" placeholder="e.g. ≥ 1 NSAID dispensing in the ascertainment window before index" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <div class="grid grid-cols-2 gap-3">
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Exposure look-back (days before index)</span>
              <input type="number" name="lookback" value="90" min="0" step="1" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Covariate look-back (days before index)</span>
              <input type="number" name="covlookback" value="365" min="0" step="1" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          </div>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Covariates / potential confounders (tick to adjust)</span>
            <div class="mt-1.5 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1">
              {COVARIATES.map((cv, i) => (
                <label class="flex items-start gap-2 text-xs text-slate-700">
                  <input type="checkbox" name="covariatesPick" value={cv} checked={i < 2} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{cv}</span>
                </label>
              ))}
            </div>
            <textarea name="covariatesCustom" rows="2" class="mt-2 w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="Custom covariates (one per line)"></textarea>
          </div>
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">5 · Subgroups &amp; sensitivity</legend>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Subgroup analyses (tick to perform)</span>
            <div class="mt-1.5 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1">
              {SUBGROUPS.map((sg, i) => (
                <label class="flex items-start gap-2 text-xs text-slate-700">
                  <input type="checkbox" name="subgroupsPick" value={sg} checked={i < 2} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{sg}</span>
                </label>
              ))}
            </div>
            <textarea name="subgroupsCustom" rows="2" class="mt-2 w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="Custom subgroups (one per line)"></textarea>
          </div>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Sensitivity analyses (tick to perform)</span>
            <div class="mt-1.5 grid grid-cols-1 gap-y-1">
              {SENSITIVITY.map((sn, i) => (
                <label class="flex items-start gap-2 text-xs text-slate-700">
                  <input type="checkbox" name="sensitivityPick" value={sn} checked={i < 4} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{sn}</span>
                </label>
              ))}
            </div>
            <textarea name="sensitivityCustom" rows="2" class="mt-2 w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="Custom sensitivity analyses (one per line)"></textarea>
          </div>
        </fieldset>

        <div class="flex flex-wrap gap-3">
          <button type="button" data-action="download-docx" class="bg-brand-700 text-white hover:bg-brand-800 font-semibold px-5 py-2.5 rounded-lg text-sm">⬇ Word (.docx)</button>
          <button type="button" data-action="download-md" class="bg-white border border-brand-700 text-brand-700 hover:bg-brand-50 font-semibold px-5 py-2.5 rounded-lg text-sm">⬇ Markdown</button>
          <button type="button" data-action="copy" class="text-brand-700 hover:underline font-semibold text-sm">Copy</button>
          <button type="button" data-action="reset" class="ml-auto text-slate-500 hover:text-rose-600 hover:underline text-sm font-semibold">Clear all</button>
          <span class="basis-full text-[11px] text-slate-400">Auto-saved to this browser.</span>
          <p data-action-msg class="basis-full text-xs"></p>
        </div>
      </form>

      <div class="lg:sticky lg:top-20 self-start">
        <p class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-2">Live protocol preview</p>
        <pre id="preview" class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-xs leading-relaxed whitespace-pre-wrap overflow-auto max-h-[70vh]"></pre>
      </div>
    </div>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-base font-bold text-slate-900">Consistency checks <span class="text-xs font-normal text-slate-400">· case-control 防呆</span></h2>
      <div id="checks" class="mt-3 space-y-1.5"></div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">Study design diagram</h2>
      <p class="mt-1 text-xs text-slate-500">Exposure and covariates are assessed in look-back windows before the index date. <strong>Drag the ● handles</strong> to adjust the windows.</p>
      <div class="mt-4 overflow-x-auto"><div id="diagram"></div></div>
      <div id="dlegend" class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-slate-600"></div>
    </div>

    <PhenotypeLibrary />
    <DesignDiagram />
    <ProtocolCommon />
  </section>

  <script src="https://unpkg.com/docx@8.5.0/build/index.umd.js" is:inline></script>
  <script is:inline>
    const STORAGE_KEY = "daniel.cc-builder";
    const form = document.getElementById("form");
    const preview = document.getElementById("preview");
    const V = (n) => (form.elements[n]?.value || "").trim();
    const MV = (n) => [...form.querySelectorAll('[name="' + n + '"]:checked')].map((c) => c.value);
    const mergeList = (pick, custom) => [...(pick || []), ...String(custom || "").split(/\r?\n/).map((x) => x.trim()).filter(Boolean)];
    const or = (s, d) => (s && s.length ? s : d);

    const readForm = () => ({
      title: V("title"), data: V("data"), population: V("population"), exposure: V("exposure"), outcome: V("outcome"),
      casedef: V("casedef"), indexdate: V("indexdate"), sampling: V("sampling") || "riskset", nControls: V("nControls") || "4",
      matchingPick: MV("matchingPick"), matchingCustom: V("matchingCustom"),
      expdef: V("expdef"), lookback: V("lookback") || "90", covlookback: V("covlookback") || "365",
      covariatesPick: MV("covariatesPick"), covariatesCustom: V("covariatesCustom"),
      subgroupsPick: MV("subgroupsPick"), subgroupsCustom: V("subgroupsCustom"), sensitivityPick: MV("sensitivityPick"), sensitivityCustom: V("sensitivityCustom"),
    });

    const isMatched = (s) => mergeList(s.matchingPick, s.matchingCustom).length > 0;
    const samplingText = (v) => ({
      riskset: "incidence-density (risk-set) sampling — for each case, controls are sampled from those still at risk at the case's index date. A sampled control may later become a case, and a person may be sampled into more than one risk set; both are correct under this scheme",
      cumulative: "cumulative (survivor) sampling — controls are sampled from those still outcome-free at the end of the follow-up period",
      casecohort: "case-cohort (case-base) sampling — controls are a random subcohort of the source population drawn at baseline, so one subcohort can serve several outcomes",
    })[v] || "the specified control-sampling scheme";
    const samplingShort = (v) => ({ riskset: "Incidence-density (risk-set)", cumulative: "Cumulative (survivor)", casecohort: "Case-cohort (case-base)" })[v] || "-";

    // What the exposure odds ratio actually estimates under each sampling scheme.
    // Source: Vandenbroucke JP, Pearce N. Case-control studies: basic concepts.
    // Int J Epidemiol 2012;41:1480-9 (doi:10.1093/ije/dys147).
    const orMeans = (v) => ({
      riskset: "the **incidence-rate ratio**, with no rare-disease assumption",
      cumulative: "the odds ratio of the full cohort; it approximates the **risk ratio only if the outcome is rare**, and overstates it otherwise",
      casecohort: "the **risk ratio** of the full cohort, with no rare-disease assumption",
    })[v] || "the effect measure implied by the sampling scheme";
    const orMeansPlain = (v) => String(orMeans(v)).replace(/\*\*/g, "");

    const analysisText = (s) => s.sampling === "casecohort"
      ? "a case-cohort estimator — weighted (pseudo-likelihood) estimation with a robust variance, because subcohort members contribute to several risk sets and an unweighted logistic fit would misstate the precision"
      : (isMatched(s)
        ? "conditional logistic regression (conditioning on the matched sets)"
        : "unconditional logistic regression (adjusting for the covariates)");

    const pcOf = (s) => ({
      design: (isMatched(s) ? "matched " : "") + "case-control study",
      tte: false,
      population: or(s.population, "(source population)"),
      exposure: or(s.exposure, "(exposure)"),
      comparator: "no/less exposure",
      outcome: or(s.outcome, "(outcome)"),
      data: s.data,
      analysis: analysisText(s) + ", giving an exposure odds ratio that estimates " + orMeansPlain(s.sampling) + ", with 95% confidence intervals",
      groupBy: "case/control status",
      limitations: "The dominant threat is control selection: if the controls do not represent the person-time of the source population that produced the cases, the estimate is biased however it is analysed. Exposure is ascertained before the index date from records collected for other purposes, so exposure misclassification and protopathic bias (early symptoms of the outcome prompting the exposure) also apply.",
      plannedOutputs: ["Case/control selection flow (source population → eligible cases → sampled controls, with counts and matching yield).", "Table 1 — characteristics of cases vs controls.", "Odds ratio (crude and adjusted) with 95% CI, named as the rate ratio or risk ratio the sampling scheme entitles."],
    });

    function renderScheme(s) {
      const lb = Math.max(0, parseInt(s.lookback) || 0);
      const cb = Math.max(0, parseInt(s.covlookback) || 0);
      const wins = [];
      if (cb > 0) wins.push({ label: "Covariate look-back", kind: "lookback", startDay: -cb, endDay: 0, edit: { field: "covlookback", edge: "start" } });
      if (lb > 0) wins.push({ label: "Exposure ascertainment", kind: "exposure", startDay: -lb, endDay: 0, edit: { field: "lookback", edge: "start" } });
      const onEdit = (field, day) => { const el = form.elements[field]; if (!el) return; el.value = Math.round(Math.max(0, -day)); render(); };
      window.renderDesignDiagram(document.getElementById("diagram"), document.getElementById("dlegend"), { windows: wins, indexLabel: "Index date (event / matched time)", onEdit: onEdit, snap: 5 });
    }

    // What is still blank. A case-control protocol without a case definition, an
    // index date or a control-sampling rule is not a protocol, so the gap list
    // travels into the preview, the Markdown and the Word file alike.
    const missing = (s) => [
      [!s.population, "the source population"],
      [!s.exposure, "the exposure"],
      [!s.outcome, "the outcome that defines cases"],
      [!s.casedef, "the operational case definition (code set and setting)"],
      [!s.indexdate, "the index date, and how it is assigned to controls"],
      [!s.expdef, "the exposure definition"],
      [!s.data, "the data source"],
    ].filter((x) => x[0]).map((x) => x[1]);
    const missingMd = (s) => {
      const m = missing(s);
      return m.length ? "> **This draft is incomplete.** Still to be specified: " + m.join("; ") + ".\n\n" : "";
    };

    const buildMarkdown = (s) => {
      const today = new Date().toISOString().slice(0, 10);
      const P = or(s.population, "(source population)"), E = or(s.exposure, "(exposure)"), O = or(s.outcome, "(outcome)");
      const match = mergeList(s.matchingPick, s.matchingCustom);
      const covs = mergeList(s.covariatesPick, s.covariatesCustom);
      return `# ${or(s.title, "(Untitled case-control study)")}

_Study protocol · ${isMatched(s) ? "matched " : ""}case-control study · drafted ${today}_

${missingMd(s)}${window.PC.abstractMd(pcOf(s))}
## 1. Background and rationale
This ${isMatched(s) ? "matched " : ""}**case-control** study estimates the effect of **${E}** on **${O}** in **${P}**.

*In plain terms:* we identify everyone in ${P} who developed ${O}, take a comparable sample of people who did not, and look backwards to see who had ${E}. Sampling rather than following the whole population is what makes the design efficient when ${O} is uncommon.

*Precisely:* the design samples the **study base** — the person-time of the source population that gave rise to the cases. The controls are a sample of that denominator, not a "healthy comparison group": a control who had developed ${O} would have been captured as one of our cases. Exposure is ascertained identically in cases and controls, and only from the window **before the index date**.

## 2. Question
Among **${P}**, does **${E}** affect the incidence of **${O}**?

## 3. Study design
A ${isMatched(s) ? "matched " : ""}case-control study using observational data from **${or(s.data, "(data source)")}**, with **${samplingShort(s.sampling).toLowerCase()} sampling** and **${s.nControls}** control(s) per case.

## 4. Cases and index date
- **Case definition:** ${or(s.casedef, "_(not yet specified — define the outcome that identifies cases, with the code set and care setting)_")}
- **Index date:** ${or(s.indexdate, "_(not yet specified — the case's event date, and the rule that assigns the same date to their controls)_")}

## 5. Control selection${isMatched(s) ? " and matching" : ""}
**The principle.** Controls must represent the source population — the person-time — that produced the cases. If a sampled control had developed ${O}, they would have been ascertained as a case in this study. Failure of this condition biases the estimate whatever the analysis does about it (Wacholder 1992; Vandenbroucke & Pearce 2012).

**The scheme.** Controls are selected by ${samplingText(s.sampling)}, at a ratio of **${s.nControls}:1**.${isMatched(s) ? ` Cases and controls are **matched** on: ${match.join("; ")}.` : " No matching is applied; confounders are adjusted for in the analysis."}

**What this buys.** Under this scheme the exposure odds ratio estimates ${orMeans(s.sampling)}.

## 6. Exposure ascertainment
${or(s.expdef, "_(not yet specified — e.g. at least one qualifying dispensing record in the ascertainment window before the index date)_")} Exposure is assessed in the **${s.lookback}-day** window before index; covariates in the **${s.covlookback}-day** window before index. Exposure is ascertained by the same procedure, from the same data, over the same window relative to index, for cases and for controls.

## 7. Covariates
${(covs.length ? covs : ["(none specified)"]).map((l) => "- " + l).join("\n")}

## 8. Estimand and analysis
The estimand is the effect of ${E} on ${O}. It is estimated as the **exposure odds ratio** (95% CI) by ${analysisText(s)}, and — because of the control-sampling scheme above — that odds ratio estimates ${orMeans(s.sampling)}. It is reported under that name, not merely as "an odds ratio" (Knol 2008; Labrecque 2021). A crude and a covariate-adjusted estimate are both reported.${isMatched(s) && s.sampling !== "casecohort" ? " Because the design is matched, the matching factors are **not** additionally entered as covariates." : ""}

## 9. Subgroup analyses
${(mergeList(s.subgroupsPick, s.subgroupsCustom).length ? mergeList(s.subgroupsPick, s.subgroupsCustom) : ["(none pre-specified)"]).map((l) => "- " + l).join("\n")}

## 10. Sensitivity analyses
${(mergeList(s.sensitivityPick, s.sensitivityCustom).length ? mergeList(s.sensitivityPick, s.sensitivityCustom) : ["(none pre-specified)"]).map((l) => "- " + l).join("\n")}

${window.PC.tailMd(pcOf(s))}

## References
- Vandenbroucke JP, Pearce N. Case-control studies: basic concepts. Int J Epidemiol 2012;41(5):1480-1489. doi:10.1093/ije/dys147
- Wacholder S, McLaughlin JK, Silverman DT, Mandel JS. Selection of controls in case-control studies. I. Principles. Am J Epidemiol 1992;135(9):1019-1028. doi:10.1093/oxfordjournals.aje.a116396 (II. Types of controls, 1029-1041; III. Design options, 1042-1050)
- Knol MJ, Vandenbroucke JP, Scott P, Egger M. What do case-control studies estimate? Survey of methods and assumptions in published case-control research. Am J Epidemiol 2008;168(9):1073-1081. doi:10.1093/aje/kwn217
- Labrecque JA, Hunink MGM, Ikram MA, Ikram MK. Do case-control studies always estimate odds ratios? Am J Epidemiol 2021;190(2):318-321. doi:10.1093/aje/kwaa167
- Essebag V, Genest J, Suissa S, Pilote L. The nested case-control study in cardiology. Am Heart J 2003;146(4):581-590. doi:10.1016/S0002-8703(03)00512-X
`;
    };

    const computeChecks = (s) => {
      const checks = [];
      const lb = parseInt(s.lookback) || 0, cvb = parseInt(s.covlookback) || 0, nc = parseInt(s.nControls) || 0;
      const miss = missing(s);
      if (miss.length) checks.push({ level: "error", msg: "This protocol is not yet complete. Still to be specified: " + miss.join("; ") + ". The draft below is printed with placeholders so you can see its shape — it is not a finished protocol." });

      // The one rule, stated first, every time.
      checks.push({ level: "info", msg: "The control-selection rule: controls must represent the person-time of the source population that produced the cases. Test it by asking — if this control had developed the outcome, would my study have captured them as a case? If not, the sample is not of the study base and no analysis can repair it." });

      if (s.sampling === "riskset") checks.push({ level: "ok", msg: "Incidence-density (risk-set) sampling: the odds ratio estimates the INCIDENCE-RATE RATIO with no rare-disease assumption. A sampled control who later becomes a case, or a person sampled into more than one risk set, is correct here — do not 'clean' those out." });
      else if (s.sampling === "cumulative") checks.push({ level: "warn", msg: "Cumulative (survivor) sampling: the odds ratio approximates the RISK RATIO only if the outcome is rare (roughly <10%); above that it overstates it. Sampling only end-of-period survivors also excludes people who died of other causes, which can select on exposure. Consider risk-set sampling instead." });
      else if (s.sampling === "casecohort") checks.push({ level: "warn", msg: "Case-cohort (case-base) sampling: the odds ratio relative to the subcohort estimates the RISK RATIO with no rare-disease assumption — but the subcohort contains people who later become cases and who contribute to several risk sets, so it needs weighted (pseudo-likelihood) estimation with a robust variance, not a plain matched or unmatched logistic fit." });

      if (s.sampling === "casecohort" && isMatched(s)) checks.push({ level: "error", msg: "Case-cohort sampling with individual matching is incoherent: a random subcohort is drawn once at baseline, so there are no case-specific matched sets to condition on, and conditional logistic regression does not apply. Either drop the matching factors and adjust for them in the weighted model, or switch to incidence-density (risk-set) sampling, which is what matching on index date actually implements." });
      else if (isMatched(s)) checks.push({ level: "info", msg: "Matched design → conditional logistic regression, conditioning on the matched sets. Do NOT additionally enter the matching factors as covariates: within a matched set they are constant and the coefficient is not identified." });
      else checks.push({ level: "info", msg: "Unmatched design → unconditional logistic regression, adjusting for the confounders you listed." });

      if (s.sampling === "casecohort" && nc >= 1) checks.push({ level: "info", msg: "'Controls per case' is a risk-set concept. In a case-cohort study the subcohort is a fixed random sample of the cohort (a sampling fraction), so state the fraction or the subcohort size rather than a ratio per case." });

      if (lb <= 0) checks.push({ level: "warn", msg: "Exposure look-back is 0 days — no window means no exposure can be ascertained. Set the window before the index date over which exposure is measured." });
      if (lb > 0 && cvb > 0 && cvb < lb) checks.push({ level: "warn", msg: "The covariate look-back (" + cvb + " d) is shorter than the exposure look-back (" + lb + " d), so some confounders are measured over a narrower history than the exposure they are meant to control. Usually the covariate window should be at least as long." });
      if (nc < 1) checks.push({ level: "warn", msg: "Set at least 1 control per case (commonly up to 4; beyond about 4:1 the precision gain is small)." });

      checks.push({ level: "info", msg: "Ascertain exposure by the same procedure, from the same data, over the same window relative to index, for cases and for controls. Differential ascertainment is the classical case-control bias and secondary data does not make it go away." });
      checks.push({ level: "info", msg: "Protopathic bias: if early, undiagnosed symptoms of the outcome prompt the exposure, a look-back that runs right up to the index date will read that as causation. A lag (excluding exposure in the days immediately before index) is the standard probe — it is in the sensitivity list." });
      return checks;
    };

    const render = () => {
      const s = readForm();
      preview.textContent = buildMarkdown(s);
      // A throw in here used to abort the rest of render(): the checks panel
      // froze on the previous design while the protocol text moved on (so the
      // two disagreed on screen, with the stale one showing a red error), and
      // the autosave below never ran even though the page promises
      // "Auto-saved to this browser". The diagram is the least important thing
      // here; it must not be able to take the checks and the draft down with it.
      try { renderScheme(s); }
      catch (err) {
        console.error("[case-control] study-design diagram failed to render", err);
        const el = document.getElementById("diagram");
        if (el) el.innerHTML = '<p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">The design diagram could not be drawn. It is blank because of an error, not because there is nothing to show &mdash; details are in the browser console. The protocol text and the consistency checks are unaffected.</p>';
      }
      // Never swallow a render failure silently: a blank checks panel that looks
      // like "no issues" is exactly the failure mode this page is meant to avoid.
      try { window.renderChecks(document.getElementById("checks"), computeChecks(s)); }
      catch (err) {
        console.error("[case-control] consistency checks failed to render", err);
        const el = document.getElementById("checks");
        if (el) el.innerHTML = '<div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">The consistency checks could not be rendered, so this panel is showing nothing rather than showing "no issues". Details are in the browser console.</div>';
      }
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch (err) { console.warn("[case-control] could not save draft", err); }
    };

    (() => {
      try {
        // A ?seed= link wins over the saved draft; PC.restore falls back to
        // localStorage on its own and tells the user which one it used.
        const seeded = (window.PC && PC.restore)
          ? PC.restore(form, STORAGE_KEY, (s) => PC.applySeed(form, s)) === "seed"
          : false;
        const saved = seeded ? null : JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");
        if (saved) for (const k in saved) {
          const els = form.elements[k]; if (!els) continue;
          const val = saved[k];
          if (Array.isArray(val)) form.querySelectorAll('[name="' + k + '"]').forEach((n) => { n.checked = val.includes(n.value); });
          else if (els.type === "checkbox") els.checked = !!val;
          else els.value = val;
        }
      } catch {}
      render();
    })();
    form.addEventListener("input", render);
    form.addEventListener("change", render);

    const slugify = () => (readForm().title || "case-control-protocol").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60) || "case-control-protocol";
    const fname = (ext) => slugify() + "-" + new Date().toISOString().slice(0, 10) + "." + ext;
    const dl = (blob, name) => { const u = URL.createObjectURL(blob); const a = document.createElement("a"); a.href = u; a.download = name; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(u), 1000); };

    document.querySelector("[data-action='download-md']").addEventListener("click", () =>
      dl(new Blob([preview.textContent || ""], { type: "text/markdown;charset=utf-8" }), fname("md")));
    document.querySelector("[data-action='copy']").addEventListener("click", async (e) => {
      try { await navigator.clipboard.writeText(preview.textContent || ""); e.target.textContent = "Copied ✓"; setTimeout(() => (e.target.textContent = "Copy"), 1500); } catch {}
    });

    // Caption for the exported figure, and the note buildDocx leaves behind when
    // the picture could not be made, so the click handler can tell the user.
    const FIG_CAPTION = "Figure 1. Study design diagram — the index date (day 0) and the exposure and covariate ascertainment windows that precede it, on a day axis.";
    let lastFigNote = "";

    const actionMsg = document.querySelector("[data-action-msg]");
    const setMsg = (t, bad) => { if (actionMsg) { actionMsg.textContent = t || ""; actionMsg.className = "basis-full text-xs " + (bad ? "text-rose-600" : "text-emerald-600"); } };
    document.querySelector("[data-action='reset']").addEventListener("click", () => {
      if (!confirm("Clear every field and forget the saved draft?")) return;
      localStorage.removeItem(STORAGE_KEY);
      form.querySelectorAll("input, textarea, select").forEach((el) => {
        if (el.type === "checkbox" || el.type === "radio") el.checked = false;
        else if (el.tagName === "SELECT") el.selectedIndex = 0;
        // Blanking a numeric field while readForm() silently substitutes a default
        // makes the protocol assert a number the form is not showing (a cleared
        // form still printed "90-day window"). Put the markup default back.
        else el.value = el.getAttribute("value") || "";
      });
      render();
      setMsg("Cleared.");
    });

    const buildDocx = async (s) => {
      const D = window.docx;
      const today = new Date().toISOString().slice(0, 10);
      const FONT = "Times New Roman";
      const text = (str, o = {}) => new D.TextRun({ text: String(str ?? ""), font: FONT, size: 22, ...o });
      const p = (ch, o = {}) => new D.Paragraph({ children: Array.isArray(ch) ? ch : [ch], spacing: { before: 60, after: 60, ...(o.spacing || {}) }, ...o });
      const h1 = (str) => new D.Paragraph({ children: [text(str, { bold: true, size: 28 })], spacing: { before: 200, after: 80 }, heading: D.HeadingLevel.HEADING_1 });
      const para = (str) => p([text(str)]);
      const bullet = (str) => new D.Paragraph({ children: [text(str)], bullet: { level: 0 }, spacing: { before: 0, after: 0 } });
      const border = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" };
      const cb = { top: border, bottom: border, left: border, right: border };
      const labelTable = (rows) => new D.Table({
        width: { size: 9026, type: D.WidthType.DXA }, columnWidths: [3000, 6026],
        rows: rows.map(([label, value]) => new D.TableRow({ children: [
          new D.TableCell({ borders: cb, width: { size: 3000, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR }, children: [p([text(label, { bold: true })])] }),
          new D.TableCell({ borders: cb, width: { size: 6026, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, children: [p([text(value || "-")])] }),
        ] })),
      });

      const P = or(s.population, "(source population)"), E = or(s.exposure, "(exposure)"), O = or(s.outcome, "(outcome)");
      const match = mergeList(s.matchingPick, s.matchingCustom);
      const covs = mergeList(s.covariatesPick, s.covariatesCustom);
      const subg = mergeList(s.subgroupsPick, s.subgroupsCustom);
      const sens = mergeList(s.sensitivityPick, s.sensitivityCustom);

      let __phdcLogo = null; try { const __r = await fetch("/images/networks/phdc.png"); if (__r.ok) __phdcLogo = new Uint8Array(await __r.arrayBuffer()); } catch (e) {}
      const children = [];
      if (__phdcLogo) children.push(new D.Paragraph({ spacing: { after: 120 }, children: [new D.ImageRun({ data: __phdcLogo, transformation: { width: 210, height: 51 } })] }));
      children.push(p([text(or(s.title, "(Untitled case-control study)"), { bold: true, size: 32 })], { spacing: { after: 40 } }));
      children.push(p([text("Study protocol · " + (isMatched(s) ? "matched " : "") + "case-control study · drafted " + today, { italics: true, color: "777777", size: 18 })], { spacing: { after: 160 } }));
      const miss = missing(s);
      if (miss.length) children.push(p([text("This draft is incomplete. Still to be specified: " + miss.join("; ") + ".", { bold: true, color: "9E3A2C" })], { spacing: { after: 160 } }));
      window.PC.abstractDocx(D, pcOf(s)).forEach((c) => children.push(c));

      children.push(h1("1. Background and rationale"));
      children.push(para("This " + (isMatched(s) ? "matched " : "") + "case-control study estimates the effect of " + E + " on " + O + " in " + P + "."));
      children.push(para("In plain terms: we identify everyone in " + P + " who developed " + O + ", take a comparable sample of people who did not, and look backwards to see who had " + E + ". Sampling rather than following the whole population is what makes the design efficient when " + O + " is uncommon."));
      children.push(para("Precisely: the design samples the study base — the person-time of the source population that gave rise to the cases. The controls are a sample of that denominator, not a healthy comparison group: a control who had developed " + O + " would have been captured as one of our cases. Exposure is ascertained identically in cases and controls, and only from the window before the index date."));

      children.push(h1("2. Design summary"));
      children.push(labelTable([
        ["Design", (isMatched(s) ? "Matched " : "") + "case-control study"],
        ["Data source(s)", or(s.data, "-")],
        ["Source population", P],
        ["Exposure", E],
        ["Outcome (cases)", O],
        ["Control sampling", samplingShort(s.sampling)],
        ["Controls per case", s.sampling === "casecohort" ? s.nControls + " (state the subcohort sampling fraction instead)" : String(s.nControls)],
        ["Matching", match.length ? match.join("; ") : "None (unmatched)"],
        ["Exposure look-back", s.lookback + " days"],
        ["Covariate look-back", s.covlookback + " days"],
        ["Analysis", analysisText(s)],
        ["The odds ratio estimates", orMeansPlain(s.sampling)],
      ]));

      // HARPER item 7.2 — the study design diagram. The picture alone does not
      // satisfy it: an image-stripping extractor, and a reviewer reading the
      // .docx as text, see nothing. designDiagramDocx emits the picture, a
      // numbered caption and the written window list together, and that text is
      // what carries the item. It never throws; on failure it returns a visible
      // amber note instead of a silently absent figure, so the protocol still
      // exports and the page can say which of the two you got.
      lastFigNote = "";
      const fig = await window.designDiagramFigure(document.getElementById("diagram"), { caption: FIG_CAPTION });
      const figParas = window.designDiagramDocx(D, fig, { font: FONT, caption: FIG_CAPTION });
      figParas.forEach((c) => children.push(c));
      if (!figParas.placed) lastFigNote = " Exported WITHOUT the design diagram: " + (fig.reason || figParas.error || "unknown reason") + ". The document says so where the figure should be.";

      children.push(h1("3. Cases and index date"));
      children.push(p([text("Case definition. ", { bold: true }), text(or(s.casedef, "(not yet specified — define the outcome that identifies cases, with the code set and care setting)"))]));
      children.push(p([text("Index date. ", { bold: true }), text(or(s.indexdate, "(not yet specified — the case's event date, and the rule that assigns the same date to their controls)"))]));

      children.push(h1("4. Control selection" + (isMatched(s) ? " and matching" : "")));
      children.push(p([text("The principle. ", { bold: true }), text("Controls must represent the source population — the person-time — that produced the cases. If a sampled control had developed " + O + ", they would have been ascertained as a case in this study. Failure of this condition biases the estimate whatever the analysis does about it (Wacholder 1992; Vandenbroucke & Pearce 2012).")]));
      children.push(p([text("The scheme. ", { bold: true }), text("Controls are selected by " + samplingText(s.sampling) + ", at " + s.nControls + ":1." + (isMatched(s) ? " Matched on: " + match.join("; ") + "." : " No matching; confounders adjusted in the analysis."))]));
      children.push(p([text("What this buys. ", { bold: true }), text("Under this scheme the exposure odds ratio estimates " + orMeansPlain(s.sampling) + ".")]));

      children.push(h1("5. Exposure ascertainment"));
      children.push(para(or(s.expdef, "(not yet specified — e.g. at least one qualifying dispensing record in the ascertainment window before the index date)") + " Exposure window: " + s.lookback + " days before index; covariate window: " + s.covlookback + " days before index. Exposure is ascertained by the same procedure, from the same data, over the same window relative to index, for cases and for controls."));

      children.push(h1("6. Covariates"));
      (covs.length ? covs : ["(none specified)"]).forEach((l) => children.push(bullet(l)));

      children.push(h1("7. Estimand and analysis"));
      children.push(para("The estimand is the effect of " + E + " on " + O + ". It is estimated as the exposure odds ratio (95% CI) by " + analysisText(s) + ", and — because of the control-sampling scheme above — that odds ratio estimates " + orMeansPlain(s.sampling) + ". It is reported under that name, not merely as 'an odds ratio' (Knol 2008; Labrecque 2021). Crude and covariate-adjusted estimates are both reported." + (isMatched(s) && s.sampling !== "casecohort" ? " Because the design is matched, the matching factors are not additionally entered as covariates." : "")));

      children.push(h1("8. Subgroup analyses"));
      (subg.length ? subg : ["(none pre-specified)"]).forEach((l) => children.push(bullet(l)));
      children.push(h1("9. Sensitivity analyses"));
      (sens.length ? sens : ["(none pre-specified)"]).forEach((l) => children.push(bullet(l)));

      window.PC.tailDocx(D, pcOf(s)).forEach((c) => children.push(c));

      children.push(h1("References"));
      ["Vandenbroucke JP, Pearce N. Case-control studies: basic concepts. Int J Epidemiol 2012;41(5):1480-1489. doi:10.1093/ije/dys147",
       "Wacholder S, McLaughlin JK, Silverman DT, Mandel JS. Selection of controls in case-control studies. I. Principles. Am J Epidemiol 1992;135(9):1019-1028. doi:10.1093/oxfordjournals.aje.a116396 (II. Types of controls, 1029-1041; III. Design options, 1042-1050)",
       "Knol MJ, Vandenbroucke JP, Scott P, Egger M. What do case-control studies estimate? Survey of methods and assumptions in published case-control research. Am J Epidemiol 2008;168(9):1073-1081. doi:10.1093/aje/kwn217",
       "Labrecque JA, Hunink MGM, Ikram MA, Ikram MK. Do case-control studies always estimate odds ratios? Am J Epidemiol 2021;190(2):318-321. doi:10.1093/aje/kwaa167",
       "Essebag V, Genest J, Suissa S, Pilote L. The nested case-control study in cardiology. Am Heart J 2003;146(4):581-590. doi:10.1016/S0002-8703(03)00512-X"].forEach((l) => children.push(bullet(l)));

      children.push(p([new D.TextRun({ text: "Drafted with the Protocol Generator (" + today + ").", font: FONT, size: 18, italics: true, color: "808080" })], { spacing: { before: 400 } }));

      const doc = new D.Document({
        creator: "Protocol Generator — Case-Control",
        title: "Case-control protocol — " + (s.title || "study"),
        styles: { default: { document: { run: { font: FONT, size: 22 } } }, paragraphStyles: [
          { id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 28, bold: true, font: FONT }, paragraph: { spacing: { before: 200, after: 80 }, outlineLevel: 0 } },
        ] },
        numbering: { config: [{ reference: "ordered", levels: [{ level: 0, format: D.LevelFormat.DECIMAL, text: "%1.", alignment: D.AlignmentType.LEFT, style: { paragraph: { indent: { left: 720, hanging: 360 } } } }] }] },
        sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }],
      });
      return await D.Packer.toBlob(doc);
    };

    // A failed Word export used to do nothing and say nothing: `catch (e) {}`
    // around the whole thing, and a bare `return` when the docx library had not
    // loaded. The button simply appeared not to work.
    document.querySelector("[data-action='download-docx']").addEventListener("click", async () => {
      if (!window.docx) {
        setMsg("The Word library has not loaded, so the .docx cannot be built. Check your connection and reload the page — the Markdown export still works meanwhile.", true);
        return;
      }
      setMsg("Building the Word document…");
      try {
        const name = fname("docx");
        dl(await buildDocx(readForm()), name);
        setMsg("Downloaded " + name + "." + lastFigNote, !!lastFigNote);
      } catch (err) {
        console.error("[case-control] Word export failed", err);
        setMsg("Could not build the Word file: " + ((err && err.message) || err) + ". Nothing was downloaded.", true);
      }
    });
  </script>
</BaseLayout>
