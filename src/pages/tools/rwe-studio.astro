        (withheld.length ? '<span class="text-[11px] font-bold text-rose-700">' + esc(withheld.map((s) => s.label).join(" · ")) + " withheld</span>" : "") + "</div>";
      h += '<p class="mt-1 text-[11px] text-slate-600">Two separate questions, in order. First: is there anyone to compare with? Second: are the weights that answer it stable? The first cannot be fixed by fixing the second.</p>';
      h += '<div class="mt-2 rounded-lg border px-3 py-2 text-xs ' + ovTone + '"><strong>1 · Common support</strong> — ' +
        (okOverlap
          ? "every patient has a counterpart in the other arm across the whole propensity range. Positivity is satisfied here."
          : "<strong>" + outN + " of " + (nT + nC) + " patients (" + outPct.toFixed(1) + "%) — " + outT + " exposed and " + outC + " comparator — lie outside the propensity range the other arm occupies.</strong> For them there is nobody to compare with, so the model is extrapolating rather than contrasting. " +
            "<span class='block mt-1'>Stabilising or truncating the weights will <em>not</em> repair this: they make the arithmetic behave, and a tidy weight profile below is not evidence that this is resolved. The honest routes are to restrict to common support, or to narrow the eligibility criteria so the question is one the data can answer.</span>") + "</div>";
      if (ntrim) h += '<p class="mt-1 text-[11px] text-amber-700">' + ntrim + " row(s) were removed before estimating (" + esc(dg.trim) + "). The estimates refer to the remaining patients.</p>";
      h += g ? '<div class="mt-2">' + g + "</div>" : "";
      // ── Section 2: weights ──
      h += '<div class="mt-3 text-xs font-semibold text-slate-800">2 · Weight stability <span class="font-normal text-slate-500">— ' +
        (schemes.length
          ? "one verdict per weighting scheme you selected" + (hasIptw ? "; the inverse-probability weights are " + (dg.wtmode === "stab" ? "stabilised" : "unstabilised") + (num("ntrunc") ? ", truncated at the " + esc(dg.trunc) : "") : "")
          : "no weighted estimator was selected, so there is nothing here to judge") + "</span></div>";
      if (!schemes.length) h += '<p class="mt-1 text-[11px] text-slate-500">Matching and fine stratification do not weight, so the weight diagnostics do not apply to them. Their own diagnostic is how many patients survived the matching or the stratification — reported beside each estimate above.</p>';
      // One refusal box per withheld scheme, each quoting its own numbers. The old
      // single box always said "IPTW" and always closed by certifying that "the
      // other estimators are unaffected" — which was exactly wrong when a second
      // weighted estimator was failing the same test.
      withheld.forEach((s) => {
        const essPct = s.z[1], top1 = s.z[3];
        const isIptw = /^IPTW/.test(s.label);
        const others = schemes.filter((x) => x !== s && !(x.bad && x.gated)).map((x) => x.label);
        h += '<div class="mt-1 rounded-lg border border-rose-300 bg-rose-50 px-3 py-2 text-xs text-rose-900"><strong>The ' + esc(s.label) + ' estimate was not reported.</strong> ' +
          (essPct < 10 ? "The effective sample size fell to " + essPct.toFixed(0) + "% of the cohort. " : "") + (top1 > 25 ? "The heaviest 1% of patients hold " + top1.toFixed(0) + "% of the weight. " : "") +
          "A weighted hazard ratio here would be an artefact of a few patients rather than an effect. " +
          (isIptw
            ? (dg.rescuable !== "1"
              ? "Truncation has already been applied and did not rescue it, which points at the overlap problem above rather than at the arithmetic — restrict to common support, or narrow the eligibility criteria."
              : (okOverlap
                ? "The arms do overlap, so this is an arithmetic problem: <strong>truncate at the 1st/99th percentile</strong> first, and restrict to common support only if that is not enough. Both controls are in step 3."
                : "<strong>Restrict to common support first</strong> — the overlap problem above is the likelier cause, and truncating would tidy these numbers without fixing it. Both controls are in step 3."))
            : "The truncation control in step 3 caps the inverse-probability weights only, so it will not move this scheme. " +
              (okOverlap
                ? "The arms do overlap, so the propensity model itself is producing the extreme weights — a sparser model, or restricting to common support, is the route out."
                : "<strong>Restrict to common support</strong> — the overlap problem above is the cause.")) +
          (others.length ? " " + esc(others.join(" and ")) + " passed the same test and " + (others.length > 1 ? "are" : "is") + " still shown." : "") + "</div>";
      });
      // What stabilisation actually bought, side by side. This comparison is about
      // the inverse-probability weights specifically, so it is shown only with them.
      if (hasIptw && dU.length === 4 && dS.length === 4) {
        const cell = (v, d) => '<td class="py-1 pr-3 text-right tabular-nums">' + (isFinite(v) ? v.toFixed(d) : "—") + "</td>";
        h += '<div class="mt-1 overflow-x-auto"><table class="w-full text-[11px] border-collapse"><thead><tr class="text-slate-500 border-b border-slate-200">' +
          '<th class="py-1 pr-3 text-left font-semibold">Inverse-probability weights</th><th class="py-1 pr-3 text-right font-semibold">Effective n</th><th class="py-1 pr-3 text-right font-semibold">% of cohort</th><th class="py-1 pr-3 text-right font-semibold">Largest weight</th><th class="py-1 pr-3 text-right font-semibold">Top 1% share</th></tr></thead><tbody>' +
          '<tr class="border-b border-slate-100"><td class="py-1 pr-3">Unstabilised</td>' + cell(dU[0], 0) + cell(dU[1], 1) + cell(dU[2], 1) + cell(dU[3], 1) + "</tr>" +
          '<tr class="border-b border-slate-100"><td class="py-1 pr-3">Stabilised</td>' + cell(dS[0], 0) + cell(dS[1], 1) + cell(dS[2], 1) + cell(dS[3], 1) + "</tr>" +
          (num("ntrunc") ? '<tr class="border-b border-slate-100 font-semibold"><td class="py-1 pr-3">Used (truncated ' + esc(dg.trunc) + ", " + num("ntrunc") + " capped)</td>" + cell(dF[0], 0) + cell(dF[1], 1) + cell(dF[2], 1) + cell(dF[3], 1) + "</tr>" : "") +
          "</tbody></table></div>";
        h += '<p class="mt-1 text-[11px] text-slate-500">Stabilising took the effective sample from ' + (isFinite(dU[1]) ? dU[1].toFixed(0) : "—") + "% to " + (isFinite(dS[1]) ? dS[1].toFixed(0) : "—") +
          "% of the cohort and the largest weight from " + (isFinite(dU[2]) ? dU[2].toFixed(0) : "—") + "× to " + (isFinite(dS[2]) ? dS[2].toFixed(0) : "—") + "×. It changes the estimand not at all — only the arithmetic.</p>";
      }
      h += '<div class="mt-1 overflow-x-auto"><table class="w-full text-xs border-collapse"><tbody>' + rows.join("") + "</tbody></table></div>";
      el.classList.remove("hidden");
      el.innerHTML = h;
    }

    // ── PS-calibration result: the formula, the verdict, and the handoff ──────
    // The release rule matches the ACNU protocol page exactly (S >= 90 releases,
    // 50-90 and below withhold), because the two pages have to agree about when
    // this correction may be used at all.
    const pscVerdict = (S) => (S == null || !isFinite(S)) ? "untested" : (S >= 90 ? "s-high" : (S >= 50 ? "s-mid" : "s-low"));
    const PSC_VERDICT_TEXT = {
      "s-high": ["Surrogacy supported", "emerald", "S ≥ 90%: almost all of the outcome information carried by the two scores is carried by the gold-standard score, which is what surrogacy asserts. The correction is released below, for use as a pre-specified sensitivity analysis — never as the primary result."],
      "s-mid": ["Partial surrogacy — correction withheld", "amber", "S between 50% and 90%. This is the region where calibration starts to hurt: published scenarios at this level lose much of the bias reduction, and it can move the estimate the wrong way. The correction factor is not released."],
      "s-low": ["Surrogacy absent — correction withheld", "rose", "S below 50%: the error-prone score carries most of the outcome information, the opposite of what the method requires. In Lunt's scenarios at this level calibration roughly doubled the error. The correction factor is not released."],
      "untested": ["Surrogacy could not be measured — correction withheld", "slate", "S needs outcomes and both scores to carry information. Without it there is no evidence the correction is safe to apply, so it is not released."],
    };
    function renderPsc(m) {
      const el = $("pscresults"); if (!el || !m) return;
      const num = (k) => { const v = parseFloat(m[k]); return isFinite(v) ? v : null; };
      const S = num("S"), v = pscVerdict(S), vt = PSC_VERDICT_TEXT[v];
      const released = v === "s-high";
      const f = (x, d) => (x == null ? "—" : x.toFixed(d == null ? 4 : d));
      const ci = (lo, hi, d) => (lo == null || hi == null) ? "" : " (95% CI " + f(lo, d) + " to " + f(hi, d) + ")";
      const tone = { emerald: "border-emerald-300 bg-emerald-50 text-emerald-900", amber: "border-amber-300 bg-amber-50 text-amber-900", rose: "border-rose-300 bg-rose-50 text-rose-900", slate: "border-slate-300 bg-slate-100 text-slate-700" }[vt[1]];
      const hr = (b) => { if (b == null) return "—"; const x = Math.exp(b); return (x >= 0.001 && x < 1000) ? x.toFixed(3) : x.toPrecision(3); };
      let h = '<div class="text-xs uppercase tracking-widest text-violet-800 font-semibold mb-2">Propensity-score calibration formula</div>';
      h += '<div class="rounded-lg bg-white border border-violet-200 px-3 py-2 font-mono text-sm text-slate-900">PS_gs = ' + f(num("a0")) + " + " + f(num("a1")) + " × PS_ep + " + f(num("a2")) + " × T</div>";
      h += '<p class="mt-1 text-[11px] text-slate-600">α₁ = ' + f(num("a1")) + " (SE " + f(num("a1se")) + ")" + ci(num("a1lo"), num("a1hi")) + " · α₂ = " + f(num("a2")) + " (SE " + f(num("a2se")) + ")" + ci(num("a2lo"), num("a2hi")) +
        " · R² = " + f(num("r2"), 3) + " · n = " + (m.n || "—") + " · " + (m.nC || "—") + " claims / " + (m.nU || "—") + " clinical-only covariates · both scores on the probability scale.</p>" +
        (num("a1lo") != null ? '<p class="text-[11px] text-slate-500">Use the bootstrap interval, not the standard error beside it: the SE from the calibration regression treats PS_ep as a fixed, known quantity when it was itself estimated, and its residual spread is structural rather than sampling noise. The bootstrap refits both scores in every replicate.</p>' : "");
      h += '<div class="mt-2 rounded-lg border px-3 py-2 text-xs ' + tone + '"><strong>' + esc(vt[0]) + "</strong> — S = " + (S == null ? "not computable" : S.toFixed(1) + "%") +
        " (PS_ep coefficient " + f(num("scoef")) + ", p = " + (num("sp") == null ? "—" : num("sp").toPrecision(3)) + ")<br><span class='opacity-90'>" + esc(vt[2]) + "</span></div>";
      if (released) {
        h += '<div class="mt-2 rounded-lg bg-white border border-violet-200 px-3 py-2 text-sm"><span class="text-slate-600 text-xs uppercase tracking-widest font-semibold">Correction a claims-only study applies</span><br>' +
          '<span class="font-mono">β_T(calibrated) = β_T(naive) − ' + f(num("ratio")) + " × β_PS(naive)</span>" +
          (num("rlo") != null ? '<span class="block text-[11px] text-slate-500">correction factor α₂/α₁ bootstrap 95% CI ' + f(num("rlo")) + " to " + f(num("rhi")) + ", " + (m.B || 0) + " replicates" + (Number(m.bfail) ? ", " + m.bfail + " failed" : "") + "</span>" : '<span class="block text-[11px] text-slate-500">no bootstrap interval — set replicates above</span>') + "</div>";
      } else {
        h += '<div class="mt-2 rounded-lg bg-white border border-slate-200 px-3 py-2 text-xs text-slate-600"><strong>The correction factor is withheld.</strong> α₂/α₁ was computed, but printing it here would invite exactly the use this page has just advised against. Fix surrogacy — a richer claims-available set, or a different validation population — or present this as a bias analysis rather than a point correction.</div>';
      }
      if (num("bT") != null) {
        // The same three numbers either way, but framed so a withheld correction
        // is not quietly re-served as "the calibrated HR".
        h += '<p class="mt-2 text-[11px] ' + (released ? "text-slate-600" : "text-rose-700") + '"><strong>Does the correction help on this data?</strong> ' +
          "Fitting the claims-only analogue here (treatment + PS_ep only) gives HR " + hr(num("bT")) +
          ", against a gold-standard fit (treatment + PS_gs) of HR " + hr(num("bG")) + ". " +
          (released
            ? "Applying the correction gives HR " + hr(num("bcal")) + "."
            : "Applying the correction anyway would give HR " + hr(num("bcal")) + " — further from the gold standard than doing nothing. That is what the withheld verdict is protecting you from.") +
          " A self-check on the validation data, not the study estimate.</p>";
      }
      h += '<p class="mt-2 text-[11px] text-slate-500">Still missing, and not obtainable here: <strong>β̂_T, its standard error, and β̂_PS</strong>. Those come from the claims-only study — a different dataset — and are typed into the protocol builder.</p>';
      h += '<div class="mt-2"><button id="dlpsc" type="button" class="bg-violet-700 text-white hover:bg-violet-800 font-semibold px-3 py-1.5 rounded text-xs">⬇ Calibration handoff (JSON)</button></div>';
      el.classList.remove("hidden");
      el.innerHTML = h;
      $("dlpsc").addEventListener("click", () => {
        const j = pscHandoff(m);
        dl(new Blob([JSON.stringify(j, null, 2)], { type: "application/json" }), DATA.name + "-psc-handoff.json");
      });
    }
    function pscHandoff(m) {
      const num = (k) => { const v = parseFloat(m[k]); return isFinite(v) ? v : null; };
      const S = num("S"), v = pscVerdict(S), ready = PSCRUN || pscReady();
      const valType = ready ? ready.valType : null;
      return {
        kind: "rwe-studio/psc-handoff", version: 1, generated: new Date().toISOString(),
        // valType appears in two places on purpose: the importer accepts either,
        // and a consumer reading only `dataset` should not miss it.
        dataset: { label: DATA.name, n: num("n"), events: num("ev"), valType: valType },
        claimsVars: (ready && ready.C) ? ready.C.map((c) => (typeof c === "string" ? c : c.src)) : [],
        clinicalVars: (ready && ready.U) ? ready.U.map((c) => (typeof c === "string" ? c : c.src)) : [],
        psScale: "ps",
        validationType: valType,
        calibration: { a0: num("a0"), a1: num("a1"), a1se: num("a1se"), a2: num("a2"), a2se: num("a2se"), r2: num("r2") },
        correctionFactor: { value: num("ratio"), lo: num("rlo"), hi: num("rhi"), bootstrapB: Number(m.B) || 0, bootstrapFailures: Number(m.bfail) || 0 },
        surrogacy: { S: S, coef: num("scoef"), p: num("sp"), verdict: v, testable: true },
        released: v === "s-high",
        naive: { bT: null, bTse: null, bPS: null },
        // Estimand and method travel with the coefficients: alpha2 is only
        // transportable to a study estimating the same thing the same way.
        provenance: {
          tool: "RWE Studio", engine: "WebR", design: "acnu", outcomeModel: "coxph",
          estimand: (ready && ready.estimands) ? ready.estimands.join("+") : null,
          psMethods: (ready && ready.methods) ? ready.methods : null,
          note: "beta_T, its SE and beta_PS belong to the claims-only study and are not computable from the validation data.",
        },
      };
    }

    $("runanalysis").addEventListener("click", async () => {
      if (!MASTER) buildMaster();
      if (!MASTER) return;
      const { csv } = analysisCSV(); const script = buildScript();
      const setS = (m) => { $("anastatus").textContent = m; };
      $("runanalysis").disabled = true; $("anaresults").classList.add("hidden"); $("table1").classList.add("hidden"); $("itschart").classList.add("hidden"); $("dlfitted").classList.add("hidden"); $("pscresults").classList.add("hidden"); $("psdiag").classList.add("hidden");
      try {
        const out = await window.RWEngine.run(script, csv, setS);
        setS("Done ✓");
        const ests = [], t1 = [], notes = [], fitted = [], psw = []; let meta = {}, psc = null, psdiag = null, psbal = null, pshist = null;
        out.split("\n").forEach((l) => {
          if (l.indexOf("RESULT_ESTIMATE|") === 0) { const p = l.split("|"); ests.push({ label: p[1], value: p.slice(2).join("|") }); }
          else if (l.indexOf("TABLE1|") === 0) { t1.push(l.split("|").slice(1)); }
          else if (l.indexOf("RESULT_NOTE|") === 0) { notes.push(l.split("|").slice(1).join("|")); }
          else if (l.indexOf("FITTED|") === 0) { fitted.push(l.split("|").slice(1)); }
          else if (l.indexOf("ITSMETA|") === 0) { l.split("|").slice(1).forEach((kv) => { const i = kv.indexOf("="); if (i > 0) meta[kv.slice(0, i)] = kv.slice(i + 1); }); }
          else if (l.indexOf("PSC|") === 0) { psc = {}; l.split("|").slice(1).forEach((kv) => { const i = kv.indexOf("="); if (i > 0) psc[kv.slice(0, i)] = kv.slice(i + 1); }); }
          else if (l.indexOf("PSDIAG|") === 0) { psdiag = {}; l.split("|").slice(1).forEach((kv) => { const i = kv.indexOf("="); if (i > 0) psdiag[kv.slice(0, i)] = kv.slice(i + 1); }); }
          else if (l.indexOf("PSBAL|") === 0) { psbal = {}; l.split("|").slice(1).forEach((kv) => { const i = kv.indexOf("="); if (i > 0) psbal[kv.slice(0, i)] = kv.slice(i + 1); }); }
          else if (l.indexOf("PSHIST|") === 0) { const p = l.split("|"); pshist = { t: p[1].split(",").map(Number), c: p[2].split(",").map(Number) }; }
          // PSW|<scheme label>|ess,pct,maxw,top1|<failed its own rule>|<failing withholds>
          else if (l.indexOf("PSW|") === 0) { const p = l.split("|"); psw.push({ label: p[1], z: (p[2] || "").split(",").map(Number), bad: p[3] === "1", gated: p[4] === "1" }); }
        });
        const display = out.replace(/^(RESULT_ESTIMATE|RESULT_NOTE|TABLE1|FITTED|ITSMETA|PSC|PSCSKIP|PSDIAG|PSBAL|PSHIST|PSW)\|.*$/gm, "").replace(/\n{3,}/g, "\n\n").trim();
        if (ests.length || notes.length) {
          $("anaresults").classList.remove("hidden");
          const noteHtml = notes.length ? '<div class="mt-3 space-y-1">' + notes.map((n) => '<p class="text-[11px] text-slate-600">' + esc(n) + "</p>").join("") + "</div>" : "";
          const tblHtml = ests.length ? '<div class="overflow-x-auto"><table class="w-full text-sm border-collapse"><thead><tr class="text-left text-slate-500 border-b border-slate-200"><th class="py-1.5 pr-4 font-semibold">Method / estimand</th><th class="py-1.5 font-semibold">Estimate (95% CI)</th></tr></thead><tbody>' + ests.map((e) => '<tr class="border-b border-slate-100"><td class="py-1.5 pr-4 text-slate-700">' + esc(e.label) + '</td><td class="py-1.5 font-bold text-slate-900">' + esc(e.value) + "</td></tr>").join("") + "</tbody></table></div>" : "";
          $("anaresults").innerHTML = '<div class="text-xs uppercase tracking-widest text-brand-700 font-semibold mb-2">Effect estimates</div>' + tblHtml + noteHtml;
        }
        if (fitted.length > 1) { renderITSChart(fitted, meta); $("dlfitted").classList.remove("hidden"); }
        if (psdiag) { try { renderPsDiag(psdiag, pshist, psbal, psw); } catch (e) { console.error(e); } }
        if (psc) { try { renderPsc(psc); } catch (e) { console.error(e); } }
        if (t1.length) {
          $("table1").classList.remove("hidden");
          const head = t1[0], body = t1.slice(1);
          $("table1").innerHTML = '<div class="text-xs uppercase tracking-widest text-brand-700 font-semibold mb-2">Patient characteristics (Table 1)</div><table class="w-full text-xs border-collapse"><thead><tr class="text-left text-slate-500 border-b border-slate-200">' + head.map((h) => '<th class="py-1.5 pr-4 font-semibold">' + esc(h) + "</th>").join("") + "</tr></thead><tbody>" + body.map((rr) => '<tr class="border-b border-slate-100">' + rr.map((c, i) => '<td class="py-1.5 pr-4 ' + (i === 0 ? "text-slate-700" : "text-slate-600") + '">' + esc(c) + "</td>").join("") + "</tr>").join("") + "</tbody></table>";
        }
        $("routput").classList.remove("hidden"); $("routput").textContent = display || "(no output)";
        LAST = { out: display, script: script, ests: ests, t1: t1, notes: notes, fitted: fitted, meta: meta };
      } catch (e) { setS("Error"); $("routput").classList.remove("hidden"); $("routput").textContent = "Error: " + (e && e.message ? e.message : e); }
      finally { $("runanalysis").disabled = false; }
    });

    const readQ = () => { const g = (n) => { const e = document.querySelector('[name="' + n + '"]'); return e ? e.value : ""; }; return { pop: g("q_pop"), exp: g("q_exp"), comp: g("q_comp"), out: g("q_out"), design: getDesign() }; };
    function buildReport(q) {
      const today = new Date().toISOString().slice(0, 10);
      const label = (SPEC[q.design] || {}).label || q.design || "(design)";
      const ests = (LAST && LAST.ests) || [], t1 = (LAST && LAST.t1) || [], notes = (LAST && LAST.notes) || [], fit = (LAST && LAST.fitted) || [];
      const resTbl = ests.length ? ("| Method / estimand | Estimate (95% CI) |\n|---|---|\n" + ests.map((e) => "| " + e.label + " | " + e.value + " |").join("\n")) : "(run the analysis first)";
      const t1Tbl = t1.length ? (t1.map((r, i) => "| " + r.join(" | ") + " |" + (i === 0 ? "\n|" + r.map(() => "---").join("|") + "|" : "")).join("\n")) : "";
      const fitTbl = fit.length > 1 ? (fit.map((r, i) => "| " + r.join(" | ") + " |" + (i === 0 ? "\n|" + r.map(() => "---").join("|") + "|" : "")).join("\n")) : "";
      return "# RWE Studio analysis report\n\n_Generated " + today + " · analysis run locally in the browser via WebR (real R)_\n\n" +
        "## Question\n- Population: " + (q.pop || "(specify)") + "\n- Exposure: " + (q.exp || "(specify)") + "\n- Comparator: " + (q.comp || "—") + "\n- Outcome: " + (q.out || "(specify)") + "\n- Design: " + label + "\n\n" +
        "## Effect estimates\n\n" + resTbl + "\n\n" +
        (notes.length ? "### How the model was fitted\n\n" + notes.map((n) => "- " + n).join("\n") + "\n\n" : "") +
        (t1.length ? "## Patient characteristics (Table 1)\n\n" + t1Tbl + "\n\n" : "") +
        (fitTbl ? "## Fitted series — observed vs counterfactual\n\n" + fitTbl + "\n\n" : "") +
        "## R output\n\n```\n" + (LAST ? LAST.out : "(run the analysis first)") + "\n```\n\n" +
        "## Reproducible R script\n\n```r\n" + (LAST ? LAST.script : buildScript()) + "\n```\n";
    }
    async function buildReportDocx(q) {
      const D = window.docx; if (!D) return null;
      const today = new Date().toISOString().slice(0, 10);
      const label = (SPEC[q.design] || {}).label || q.design || "(design)";
      const FONT = "Times New Roman";
      const text = (t, o = {}) => new D.TextRun({ text: String(t == null ? "" : t), font: FONT, size: 22, ...o });
      const p = (ch, o = {}) => new D.Paragraph({ children: Array.isArray(ch) ? ch : [ch], spacing: { before: 60, after: 60, ...(o.spacing || {}) }, ...o });
      const h1 = (t) => new D.Paragraph({ children: [text(t, { bold: true, size: 28 })], spacing: { before: 200, after: 80 }, heading: D.HeadingLevel.HEADING_1 });
      const mono = (l) => new D.Paragraph({ children: [new D.TextRun({ text: l, font: "Consolas", size: 16 })], spacing: { before: 0, after: 0 } });
      const brd = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" }; const cbr = { top: brd, bottom: brd, left: brd, right: brd };
      const tbl = (rows, hdr) => new D.Table({ width: { size: 9026, type: D.WidthType.DXA }, rows: rows.map((cells, ri) => new D.TableRow({ children: cells.map((c) => new D.TableCell({ borders: cbr, margins: { top: 60, bottom: 60, left: 100, right: 100 }, shading: (hdr && ri === 0) ? { fill: "F5F5F5", type: D.ShadingType.CLEAR } : undefined, children: [p([text(c, { bold: hdr && ri === 0 })])] })) })) });
      let logo = null; try { const rr = await fetch("/images/networks/phdc.png"); if (rr.ok) logo = new Uint8Array(await rr.arrayBuffer()); } catch (e) {}
      const ch = [];
      if (logo) ch.push(new D.Paragraph({ spacing: { after: 120 }, children: [new D.ImageRun({ data: logo, transformation: { width: 210, height: 51 } })] }));
      ch.push(p([text("RWE Studio analysis report", { bold: true, size: 32 })], { spacing: { after: 40 } }));
      ch.push(p([text("Generated " + today + " · analysis run locally in the browser via WebR (real R).", { italics: true, color: "777777", size: 18 })], { spacing: { after: 160 } }));
      ch.push(h1("Question"));
      ch.push(tbl([["Population", q.pop || "(specify)"], ["Exposure", q.exp || "(specify)"], ["Comparator", q.comp || "—"], ["Outcome", q.out || "(specify)"], ["Design", label]], false));
      const ests = (LAST && LAST.ests) || [], t1 = (LAST && LAST.t1) || [], notes = (LAST && LAST.notes) || [], fit = (LAST && LAST.fitted) || [];
      ch.push(h1("Effect estimates"));
      if (ests.length) ch.push(tbl([["Method / estimand", "Estimate (95% CI)"]].concat(ests.map((e) => [e.label, e.value])), true)); else ch.push(p([text("(run the analysis first)")]));
      notes.forEach((n) => ch.push(p([text(n, { size: 18, color: "555555" })])));
      if (t1.length) { ch.push(h1("Patient characteristics (Table 1)")); ch.push(tbl(t1, true)); }
      if (fit.length > 1) { ch.push(h1("Fitted series — observed vs counterfactual")); ch.push(tbl(fit, true)); }
      ch.push(h1("R output"));
      (LAST ? LAST.out : "(run the analysis first)").split("\n").forEach((l) => ch.push(mono(l)));
      ch.push(h1("Reproducible R script"));
      (LAST ? LAST.script : buildScript()).split("\n").forEach((l) => ch.push(mono(l)));
      const doc = new D.Document({ creator: "RWE Studio", title: "RWE Studio report", styles: { default: { document: { run: { font: FONT, size: 22 } } }, paragraphStyles: [{ id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 28, bold: true, font: FONT }, paragraph: { spacing: { before: 200, after: 80 }, outlineLevel: 0 } }] }, sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children: ch }] });
      return await D.Packer.toBlob(doc);
    }
    $("dlmaster2").addEventListener("click", () => { if (!MASTER) buildMaster(); if (MASTER) dl(new Blob(["﻿" + toCSV(DATA.columns, MASTER)], { type: "text/csv;charset=utf-8" }), DATA.name + "-master.csv"); });
    $("dlscript").addEventListener("click", () => { const s = LAST ? LAST.script : buildScript(); dl(new Blob(["# Analysis script generated by RWE Studio — reads the master file as data.csv\n# Reproduces the on-screen result in desktop R.\n\n" + s + "\n"], { type: "text/plain;charset=utf-8" }), DATA.name + "-analysis.R"); });
    $("dlfitted").addEventListener("click", () => {
      const f = LAST && LAST.fitted; if (!f || f.length < 2) return;
      dl(new Blob(["﻿" + f.map((r) => r.map(csvCell).join(",")).join("\n")], { type: "text/csv;charset=utf-8" }), DATA.name + "-fitted-series.csv");
    });
    $("dlreport").addEventListener("click", () => { dl(new Blob([buildReport(readQ())], { type: "text/markdown;charset=utf-8" }), DATA.name + "-report.md"); });
    $("dlreportword").addEventListener("click", async () => { const b = await buildReportDocx(readQ()); if (b) dl(b, DATA.name + "-report.docx"); });
  </script>
</BaseLayout>
