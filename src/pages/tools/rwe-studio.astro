          "if(is.null(s) || !is.finite(or) || !is.finite(lci) || !is.finite(uci) || or>1e6 || or<1e-6){\n" +
          "  cat(sprintf('RESULT_ESTIMATE|%s|not estimable\\n', EST))\n" +
          "  cat('RESULT_NOTE|Not estimable: the conditional logistic fit did not converge to a finite odds ratio on this data.\\n')\n" +
          "} else {\n" +
          "cat(sprintf('Conditional logistic odds ratio (case vs control windows): %.3f (95%% CI %.3f to %.3f)\\n', or, lci, uci))\n" +
          "cat(sprintf('Strata (cases): %d; rows: %d\\n', length(unique(a$ID)), nrow(a)))\n" +
          "cat(sprintf('RESULT_ESTIMATE|%s|%.2f (95%% CI %.2f-%.2f)\\n', EST, or, lci, uci))\n" +
          "# The same windows analysed as one pool, so the value of the matching shows.\n" +
          "u<-tryCatch(glm(CASE ~ EXPOSED, family=binomial, data=a), error=function(e) NULL)\n" +
          "if(!is.null(u)){ bu<-coef(u)['EXPOSED']; su<-sqrt(diag(vcov(u)))['EXPOSED']\n" +
          "  if(is.finite(bu) && is.finite(su) && su<10) cat(sprintf('RESULT_ESTIMATE|Unmatched, pairing discarded (contrast only)|%.2f (95%% CI %.2f-%.2f)\\n', exp(bu), exp(bu-1.96*su), exp(bu+1.96*su))) }\n" +
          "cat(sprintf('RESULT_NOTE|%d of %d case(s) are a proper matched set and discordant on exposure, and so carry the estimate; the rest contribute nothing to a matched analysis. This is the same test the conditional likelihood applies, so it is the number of cases the result actually rests on.\\n', ninf, ncase))\n" +
          "cat('RESULT_NOTE|The unmatched row throws the pairing away and is shown only as a contrast. It differs from the matched row both because an odds ratio is not collapsible and because it reintroduces between-person differences. Report the matched row.\\n')\n" +
          "}}\n" +
          "if(nrow(a0)>0){\n" +
          "hz<-a0$EXPOSED[a0$CASE==1]; ct<-a0$EXPOSED[a0$CASE==0]\n" +
          "cat('TABLE1|Characteristic|Value\\n')\n" +
          "cat(sprintf('TABLE1|Cases in the file|%d\\n', ncase))\n" +
          "cat(sprintf('TABLE1|Windows, total|%d\\n', nrow(a0)))\n" +
          "cat(sprintf('TABLE1|Windows per case, median (range)|%s (%s-%s)\\n', fmn(median(nwin0)), fmn(min(nwin0)), fmn(max(nwin0))))\n" +
          "cat(sprintf('TABLE1|Hazard windows per case, median (range)|%s (%s-%s)\\n', fmn(median(hpc0)), fmn(min(hpc0)), fmn(max(hpc0))))\n" +
          "if(length(hz)>0) cat(sprintf('TABLE1|Exposed in the hazard window|%d of %d (%.1f%%)\\n', sum(hz==1), length(hz), 100*mean(hz==1))) else cat('TABLE1|Exposed in the hazard window|no hazard window in the file\\n')\n" +
          "if(length(ct)>0) cat(sprintf('TABLE1|Exposed in control windows|%d of %d (%.1f%%)\\n', sum(ct==1), length(ct), 100*mean(ct==1))) else cat('TABLE1|Exposed in control windows|no control window in the file\\n')\n" +
          "cat(sprintf('TABLE1|Cases discordant on exposure|%d\\n', ndisc))\n" +
          "cat(sprintf('TABLE1|Cases carrying the estimate (matched set and discordant)|%d\\n', ninf))\n" +
          "if(ndropna>0) cat(sprintf('RESULT_NOTE|%d row(s) were dropped because the case indicator or the exposure indicator was missing. Dropping a window changes the matched set it belonged to, so check the missingness is not concentrated in the hazard windows.\\n', ndropna))\n" +
          "}\n" +
          "for(s in warnq) cat('RESULT_NOTE|',s,'\\n',sep='')\n" +
          "cat('RESULT_NOTE|What this tool cannot check: it reads only the case, the hazard flag and the exposure - never the window dates - so it cannot tell whether the chance of being exposed was drifting over calendar time. That is the assumption this design stands or falls on. Control windows are drawn from a case s own past, so if use of the drug was rising through the study period the control windows understate exposure and the matched odds ratio is biased away from the null; a case-time-control or case-case-time-control design is what addresses that. The design also assumes exposure is transient with a short-lived effect, and that nothing carries over from the hazard window into the control windows.\\n')",
      },
      its: {
        label: "Interrupted time series",
        hint: "A series over time. Map the time column and the event count (or rate/level) per period; a denominator becomes a log offset. Per-patient rows are aggregated into periods for you — set the interruption point below.",
        covariates: false,
        roles: [
          { k: "TIDX", label: "Time index / period (date or period label)", types: ["date", "number", "categorical", "text", "id"], req: true },
          { k: "YCOUNT", label: "Event count, rate, or level", types: ["number", "binary"], req: true },
          { k: "DENOM", label: "Population denominator / offset", types: ["number"], req: false },
          { k: "SEAS", label: "Season / cycle position (e.g. calendar month)", types: ["number", "categorical", "binary"], req: false },
          { k: "SERIES", label: "Control-series indicator (1=intervention, 0=control)", types: ["binary", "number"], req: false },
        ],
        // Segmented regression, written to run on base R only (stats::glm / lm).
        // Newey–West HAC standard errors and the Durbin–Watson statistic are
        // computed by hand so no package beyond base R is required; MASS is used
        // for the negative binomial only if it happens to be available.
        rscript: (cov, o) => {
          o = o || {};
          const q = (s) => "'" + PIPE_SAFE(s).replace(/\\/g, "\\\\").replace(/'/g, "\\'") + "'";
          const L = [];
          L.push("d<-read.csv('/data.csv', stringsAsFactors=FALSE)");
          L.push(R_CHK01.trim());
          L.push(R_CHKNUM.trim());
          L.push(R_SQ.trim());
          L.push("CUT<-" + q(o.cut) + "; UNIT<-" + q(o.unit || "month") + "; COMBF<-" + q(o.comb || "sum") + "; MODEL<-" + q(o.model || "auto") + "; SEASON<-" + q(o.season || "none") + "; CYC<-" + (o.cycle || 12) + "; AC<-" + q(o.ac || "auto") + "; ORDER<-" + q(o.order || "auto") + "; DCOMB<-" + q(o.denomcomb || "auto"));
          L.push("");
          L.push("# --- parse the time column (ISO dates, slashes, datetimes, YYYY-MM) ---");
          // Period labels arrive in more shapes than ISO. Every shape this fails to
          // parse falls through to a fallback that must NOT quietly sort text.
          L.push("MONNM<-c(jan=1,feb=2,mar=3,apr=4,may=5,jun=6,jul=7,aug=8,sep=9,oct=10,nov=11,dec=12)");
          L.push("pdate<-function(x){");
          L.push("  x<-trimws(as.character(x)); x[x=='' | x=='NA' | x=='NaN']<-NA; y<-x");
          L.push("  cj<-!is.na(y) & grepl('^[0-9]{4}\\u5e74',y)");                       // 2019年3月15日
          L.push("  if(any(cj)){ z<-gsub('\\u5e74','-',y[cj]); z<-gsub('\\u6708','-',z); z<-gsub('\\u65e5','',z); z<-sub('-+$','',z); y[cj]<-z }");
          L.push("  y<-gsub('[./]','-',y); y<-sub('[ T].*$','',y)");
          L.push("  q<-!is.na(y) & grepl('^[0-9]{4}-?[Qq][1-4]$',y)");                   // 2019Q1 / 2019-Q3
          L.push("  if(any(q)) y[q]<-sprintf('%s-%02d-01', substr(y[q],1,4), (as.integer(sub('^.*[Qq]','',y[q]))-1)*3+1)");
          L.push("  mn<-!is.na(y) & grepl('^[A-Za-z]{3,9}-[0-9]{2,4}$',y)");             // Mar-19 / March-2019
          L.push("  if(any(mn)) y[mn]<-vapply(strsplit(y[mn],'-'), function(p){ m<-MONNM[substr(tolower(p[1]),1,3)]; yy<-suppressWarnings(as.integer(p[2])); if(is.na(m)||is.na(yy)) return(NA_character_); if(yy<100) yy<-2000+yy; sprintf('%04d-%02d-01',yy,m) }, '')");
          L.push("  nm<-!is.na(y) & grepl('^[0-9]{4}-[A-Za-z]{3,9}$',y)");               // 2019-Mar
          L.push("  if(any(nm)) y[nm]<-vapply(strsplit(y[nm],'-'), function(p){ m<-MONNM[substr(tolower(p[2]),1,3)]; if(is.na(m)) return(NA_character_); sprintf('%s-%02d-01',p[1],m) }, '')");
          L.push("  c8<-!is.na(y) & grepl('^[0-9]{8}$',y)");                             // 20190315
          L.push("  if(any(c8)) y[c8]<-paste0(substr(y[c8],1,4),'-',substr(y[c8],5,6),'-',substr(y[c8],7,8))");
          L.push("  my<-!is.na(y) & grepl('^[0-9]{1,2}-[0-9]{4}$',y)");                  // 3-2019 (month-year)
          L.push("  if(any(my)) y[my]<-vapply(strsplit(y[my],'-'), function(p) sprintf('%s-%02d-01',p[2],as.integer(p[1])), '')");
          L.push("  ym<-!is.na(y) & grepl('^[0-9]{4}-[0-9]{1,2}$',y); y[ym]<-paste0(y[ym],'-01')");
          L.push("  suppressWarnings(as.Date(y, format='%Y-%m-%d')) }");
          L.push("floorp<-function(dt,u){ if(u=='day') return(dt); if(u=='week') return(dt-(as.integer(format(dt,'%u'))-1)); if(u=='month') return(as.Date(paste0(format(dt,'%Y-%m'),'-01'))); if(u=='quarter'){ m<-as.integer(format(dt,'%m')); return(as.Date(sprintf('%s-%02d-01',format(dt,'%Y'),(m-1)%/%3*3+1))) }; if(u=='year') return(as.Date(paste0(format(dt,'%Y'),'-01-01'))); dt }");
          L.push("tid<-d$TIDX; dts<-pdate(tid); nz<-sum(!is.na(tid) & trimws(as.character(tid))!='')");
          L.push("isdate<-nz>0 && sum(!is.na(dts))>=0.8*nz");
          L.push("if(UNIT!='none' && !isdate){ cat('The time column does not parse as dates, so its literal values are used as the periods.\\n'); UNIT<-'none' }");
          L.push("key<-if(UNIT!='none') format(floorp(dts,UNIT),'%Y-%m-%d') else trimws(as.character(tid))");
          L.push("");
          L.push("Y<-chknum(d$YCOUNT,'Event count / rate / level')");
          L.push("HASN<-'DENOM' %in% names(d); HASG<-'SERIES' %in% names(d); HASS<-'SEAS' %in% names(d)");
          L.push("N<-if(HASN) chknum(d$DENOM,'Population denominator') else rep(NA_real_,nrow(d))");
          // A text control-series indicator used to become NA and then 0, quietly
          // collapsing both series into one. Refuse rather than merge them.
          L.push("G<-if(HASG) chk01(d$SERIES,'the control-series indicator (1=intervention, 0=control)') else rep(0,nrow(d))");
          L.push("SS<-if(HASS) d$SEAS else rep(NA,nrow(d))");
          L.push("ok<-!is.na(key) & key!='' & !is.na(Y); if(sum(!ok)>0) cat(sprintf('Dropped %d row(s) with a missing time or outcome value.\\n',sum(!ok)))");
          L.push("key<-key[ok]; Y<-Y[ok]; N<-N[ok]; G<-G[ok]; SS<-SS[ok]");
          L.push("if(length(Y)<6) stop('Fewer than 6 usable rows — an interrupted time series needs a series, not a handful of points.')");
          L.push("");
          L.push("# --- collapse rows into one row per period (and per series) ---");
          L.push("cmb<-if(COMBF=='mean') function(z) mean(z,na.rm=TRUE) else function(z) sum(z,na.rm=TRUE)");
          L.push("kk<-data.frame(g=G,key=key,stringsAsFactors=FALSE); a<-kk[!duplicated(kk),,drop=FALSE]; rownames(a)<-NULL");
          L.push("gid<-match(paste0(G,'\\r',key), paste0(a$g,'\\r',a$key))");
          L.push("a$nrows<-vapply(seq_len(nrow(a)),function(i) sum(gid==i),0)");
          L.push("a$Y<-vapply(seq_len(nrow(a)),function(i) cmb(Y[gid==i]),0)");
          // The denominator must NOT inherit the outcome's rule. A population figure
          // repeated on every patient row gets multiplied by the row count if summed,
          // so log(rows per period) leaks into the offset and bends both the step and
          // the trend. Default to "first" when it is constant within a period.
          L.push("dmode<-DCOMB");
          L.push("if(HASN){ dconst<-all(vapply(seq_len(nrow(a)), function(i){ z<-N[gid==i]; z<-z[!is.na(z)]; length(z)<2 || all(abs(z-z[1])<1e-9) }, TRUE))");
          L.push("  if(dmode=='auto') dmode<-if(dconst) 'first' else 'sum'");
          L.push("  dfun<-if(dmode=='first') function(z){ z<-z[!is.na(z)]; if(length(z)) z[1] else NA_real_ } else if(dmode=='mean') function(z) mean(z,na.rm=TRUE) else function(z) sum(z,na.rm=TRUE)");
          L.push("  a$N<-vapply(seq_len(nrow(a)),function(i) as.numeric(dfun(N[gid==i])),0) }");
          L.push("if(HASS) a$seas<-vapply(seq_len(nrow(a)),function(i){ z<-SS[gid==i]; as.character(z[1]) },'')");
          L.push("if(max(a$nrows)>1) cat(sprintf('Aggregated %d row(s) into %d period-row(s) by %s (%s).\\n', length(Y), nrow(a), UNIT, COMBF))");
          L.push("");
          // Getting the order of the periods wrong does not blur the answer, it
          // reverses it: alphabetical "Apr-18, Apr-19, Aug-18 ..." turns a rise into
          // a fall. So the order must be ESTABLISHED, never assumed. If nothing here
          // establishes it, the run stops and asks, rather than sorting text.
          L.push("ukey<-unique(a$key); kd<-pdate(ukey); kn<-suppressWarnings(as.numeric(ukey)); ordmode<-''");
          // Kept on one line: in R a top-level `else` beginning a new line is a parse error.
          // The last branch used to strip every non-digit and sort the concatenation.
          // For "Q1 2015 … Q4 2020" that is quarter-then-year: the order came out
          // Q1 2015, Q1 2016, … Q1 2020, Q2 2015, and a monotonically rising series
          // reported a significant 42% immediate drop, under a note stating the
          // periods had been "ordered by the number inside each label". Unpadded
          // week labels scramble the same way. Concatenating two numbers only
          // preserves order if you know which one is the more significant, and
          // nothing here does — so a label with more than one number is now refused
          // rather than guessed at, which is what the panel above the control says
          // this branch does.
          L.push("if(ORDER=='file'){ ord<-seq_along(ukey); ordmode<-'the order the periods first appear in the file (which you told the tool is chronological)' } else if(ORDER=='alpha'){ ord<-order(ukey); ordmode<-'alphabetical order of the labels (which you told the tool is chronological)' } else if(all(!is.na(kd))){ ord<-order(kd); ordmode<-'dates parsed from the period labels' } else if(all(!is.na(kn))){ ord<-order(kn); ordmode<-'the numeric value of each label' } else { stub<-gsub('[0-9]+','#',ukey); ngrp<-vapply(gregexpr('[0-9]+',ukey), function(m) if(m[1]==-1) 0L else length(m), 0L); num<-suppressWarnings(as.numeric(gsub('[^0-9]','',ukey))); if(length(unique(stub))==1 && all(ngrp==1) && !any(is.na(num)) && !any(duplicated(num))){ ord<-order(num); ordmode<-'the single number inside each label' } }");
          L.push("if(ordmode==''){ stop(paste0('Cannot work out the chronological order of the period labels: they do not parse as dates, they are not numbers, and they do not share a single numbered pattern. Sorting them as text would give ', paste(head(sort(ukey),5),collapse=' -> '), ' ... which is very unlikely to be chronological, and analysing periods in the wrong order can reverse the direction of the estimate. Set \"Period order\" to \"the order they appear in the file\" if the file is already sorted, or map a numeric period index instead.')) }");
          L.push("ukey<-ukey[ord]; a$t<-match(a$key,ukey); a<-a[order(a$g,a$t),,drop=FALSE]; rownames(a)<-NULL; np<-length(ukey)");
          // Period labels are data, and they end up inside pipe-delimited estimate
          // labels, ITSMETA and every FITTED row. A month written "2019|03" would
          // shift the fitted series one column and break the chart. Cleaned only
          // after a$t has been matched, so the ordering is unaffected.
          L.push("ukey<-sq(ukey); a$key<-sq(a$key)");
          L.push("");
          L.push("# --- place the interruption: exact period label, then date, then index ---");
          L.push("cut<-trimws(CUT); t0<-NA");
          L.push("if(cut!=''){ m<-match(cut,ukey); if(!is.na(m)) t0<-m");
          // The comparison used to be against the raw date while kd holds period
          // STARTS, so any interruption date after the 1st of its month selected the
          // NEXT month, and the month the intervention actually happened in was
          // analysed as a pre-intervention period. The field asks for "the first
          // period affected", and 15 January is in it. Floor the date to the period
          // unit first, and say below when the date given was not a period start.
          L.push("cutmoved<-''");
          L.push("  if(is.na(t0)){ cd<-pdate(cut); if(!is.na(cd) && all(!is.na(kd))){ cdf<-if(UNIT!='none') floorp(cd,UNIT) else cd; w<-which(kd[ord]>=cdf); if(length(w)){ t0<-min(w); if(cd!=kd[ord][t0]) cutmoved<-format(cd,'%Y-%m-%d') } } }");
          L.push("  if(is.na(t0)){ ci<-suppressWarnings(as.integer(cut)); if(!is.na(ci) && ci>=2 && ci<=np) t0<-ci } }");
          L.push("if(is.na(t0)) stop(paste0(\"Could not place the interruption '\",cut,\"' in this series. The \",np,\" periods run from \",ukey[1],\" to \",ukey[np],\". Give a date inside that range, one of those exact period labels, or a period number between 2 and \",np,\".\"))");
          // Wagner (2002) convention: time-since-intervention is 0 at the first
          // affected period, so the "level change" coefficient IS the immediate step
          // and the slope change accrues from the period after. Both conventions are
          // in use, which is why the note below says which one this is.
          L.push("a$level<-as.integer(a$t>=t0); a$tsince<-pmax(0,a$t-t0)");
          L.push("");
          L.push("# --- seasonality ---");
          L.push("seasok<-FALSE");
          L.push("if(SEASON!='none'){ if(!('seas' %in% names(a))){ kd2<-pdate(a$key); if(all(!is.na(kd2))) a$seas<-if(CYC==4) as.character((as.integer(format(kd2,'%m'))-1)%/%3+1) else as.character(as.integer(format(kd2,'%m'))) else a$seas<-as.character(((a$t-1)%%CYC)+1) }");
          L.push("  seasok<-TRUE; if(SEASON=='dummies' && length(unique(a$seas))>max(2,nrow(a)-6)){ cat('RESULT_NOTE|Too few periods per season to fit calendar dummies — seasonality was dropped.\\n'); seasok<-FALSE }");
          // A cycle no shorter than the series is not a cycle over that series: the
          // harmonic pair is a constant and a near-zero column, which R fits as a
          // coefficient of the order 1e12 on floating-point noise rather than
          // refusing. Caught in the browser too, but the browser cannot know how
          // many periods survive aggregation, and this is where that is known.
          L.push("  nper0<-if(HASG) min(as.numeric(table(a$g))) else nrow(a)");
          L.push("  if(seasok && SEASON=='harmonic' && CYC>=nper0){ cat(sprintf('RESULT_NOTE|A cycle of %g period(s) cannot be estimated from a series of %d period(s): over less than one full cycle the sine and cosine terms are not a season, they are a constant and a straight line, and fitting them silently changes the level and slope estimates. Seasonality was dropped. Shorten the cycle or lengthen the series.\\n',CYC,nper0)); seasok<-FALSE } }");
          L.push("");
          L.push("rhs<-if(HASG) 'g + t + level + tsince + g:t + g:level + g:tsince' else 't + level + tsince'");
          L.push("if(seasok && SEASON=='dummies') rhs<-paste(rhs,'+ factor(seas)')");
          // A harmonic term whose column is numerically constant is not a season.
          // sin(2*pi*t/2) is sin(pi*t), which is zero for every whole t — but in
          // double precision it is ~1e-16 rather than 0, so R's rank detection does
          // NOT alias it and fits it instead, giving a coefficient of the order
          // 1e13 with a standard error and a p-value, printed in the coefficient
          // table that goes into the exported report. CYC=2 is the input's own
          // documented minimum and a legitimate choice for a biweekly or
          // semiannual cycle, so the guard has to be on the column, not the number.
          L.push("if(seasok && SEASON=='harmonic'){ hterm<-c(); for(hn in c('sin','cos')){ hv<-if(hn=='sin') sin(2*pi*a$t/CYC) else cos(2*pi*a$t/CYC)");
          L.push("  if(sd(hv)>1e-8) hterm<-c(hterm,paste0(hn,'(2*pi*t/',CYC,')')) else cat(sprintf('RESULT_NOTE|The %s term of a %g-period cycle takes the same value in every period of this series, so it carries no seasonal information. It was left out rather than fitted: in floating point it is not exactly constant, and R would estimate it as a coefficient of the order 1e13 on rounding error rather than refusing it.\\n', hn, CYC)) }");
          L.push("  if(length(hterm)) rhs<-paste0(rhs,' + ',paste(hterm,collapse=' + ')) else { seasok<-FALSE; cat('RESULT_NOTE|Neither harmonic term varies over this series, so no seasonality was fitted at all.\\n') } }");
          L.push("if(HASN){ bad<-is.na(a$N)|a$N<=0; if(any(bad)){ cat(sprintf('Dropped %d period(s) with a missing or non-positive denominator.\\n',sum(bad))); a<-a[!bad,,drop=FALSE] } }");
          // Counted after the drop above, so the summary describes what was fitted
          // rather than what was collected.
          L.push("gref<-if(HASG) max(a$g) else 0; tt<-sort(unique(a$t[a$g==gref]))");
          L.push("npre<-sum(tt<t0); npost<-sum(tt>=t0); nfit<-length(tt)");
          L.push("if(npre<2 || npost<2) stop(sprintf('After aggregation there are only %d period(s) before and %d from the interruption onward. Segmented regression needs at least 2 of each, and really wants 8.', npre, npost))");
          L.push("counts<-all(abs(a$Y-round(a$Y))<1e-8) && all(a$Y>=0)");
          L.push("fam<-if(MODEL=='linear') 'linear' else if(MODEL=='poisson') 'poisson' else if(counts) 'poisson' else 'linear'");
          L.push("if(fam=='poisson' && !counts) cat('The outcome is not whole counts; a Poisson/quasi-Poisson fit is still reported as requested.\\n')");
          L.push("# A log offset only makes sense on a log link. For a linear fit the denominator");
          L.push("# is applied by modelling the rate itself rather than the count.");
          L.push("useoff<-FALSE; ratemode<-FALSE");
          L.push("if(HASN){ if(fam=='poisson'){ a$logN<-log(a$N); useoff<-TRUE } else { a$Y<-a$Y/a$N; ratemode<-TRUE; cat('Linear model with a denominator: the outcome is modelled as a rate (value divided by the denominator), not with a log offset.\\n') } }");
          L.push("f<-as.formula(paste('Y ~',rhs, if(useoff) '+ offset(logN)' else ''))");
          L.push("if(fam=='poisson'){");
          L.push("  fit<-suppressWarnings(glm(f,family=poisson,data=a))");
          L.push("  disp<-sum(residuals(fit,type='pearson')^2)/df.residual(fit)");
          L.push("  famlab<-sprintf('Poisson (dispersion %.2f)',disp)");
          L.push("  if(is.finite(disp) && disp>1.5){ nb<-NULL");
          L.push("    if(requireNamespace('MASS',quietly=TRUE)) nb<-tryCatch(MASS::glm.nb(f,data=a),error=function(e) NULL)");
          L.push("    if(!is.null(nb)){ fit<-nb; famlab<-sprintf('negative binomial (Poisson dispersion was %.2f)',disp) }");
          L.push("    else { fit<-suppressWarnings(glm(f,family=quasipoisson,data=a)); famlab<-sprintf('quasi-Poisson (dispersion %.2f)',disp) } }");
          L.push("  expo<-TRUE");
          L.push("} else { fit<-lm(f,data=a); famlab<-'linear (ordinary least squares)'; expo<-FALSE }");
          L.push("");
          L.push("# --- Durbin-Watson on the residuals, within each series ---");
          L.push("e<-residuals(fit,type=if(inherits(fit,'glm')) 'pearson' else 'response')");
          L.push("num<-0; den<-0");
          L.push("for(gg in unique(a$g)){ ee<-e[a$g==gg]; if(length(ee)>2){ num<-num+sum(diff(ee)^2); den<-den+sum(ee^2) } }");
          L.push("dw<-if(den>0) num/den else NA_real_; r1<-if(is.na(dw)) NA_real_ else 1-dw/2");
          L.push("");
          L.push("# --- Newey-West HAC sandwich, base R only. Terms R could not estimate");
          L.push("# (collinear with the rest of the model) are dropped everywhere, or the");
          L.push("# bread matrix is singular and every variance comes back NA. ---");
          L.push("cf<-coef(fit); alias<-names(cf)[is.na(cf)]; gdn<-names(cf)[!is.na(cf)]");
          L.push("mmk<-function(fit) model.matrix(fit)[,gdn,drop=FALSE]");
          L.push("brd<-function(fit){ X<-mmk(fit); w<-fit$weights; if(is.null(w)||length(w)!=nrow(X)) w<-rep(1,nrow(X)); solve(crossprod(X*sqrt(w))) }");
          L.push("ef<-function(fit){ X<-mmk(fit); if(inherits(fit,'glm')){ mu<-fitted(fit); dm<-fit$family$mu.eta(fit$linear.predictors); V<-fit$family$variance(mu); r<-dm*(fit$y-mu)/V } else r<-residuals(fit); X*r }");
          // Lag is measured in PERIODS, not in rows. A missing month, or a period
          // dropped for a bad denominator, leaves neighbouring rows several periods
          // apart; treating them as lag 1 mis-weights the correction.
          // The meat is scaled by n/(n-k). Without it the sandwich is HC0: the
          // score contributions are shrunk by the hat matrix, so over a couple of
          // dozen periods the correction it applies is smaller than the one it
          // needs, and the interval comes out NARROWER than the model-based one it
          // replaced. On the cohort demo (24 periods, 4 parameters) the shipped
          // interval for the pre-intervention slope was 2.9x narrower on the log
          // scale than the model-based interval for the same coefficient.
          L.push("hacv<-function(fit,Lg,gv,tv){ U<-ef(fit); n<-nrow(U); k<-ncol(U); M<-crossprod(U); if(Lg>0) for(l in 1:Lg){ w<-1-l/(Lg+1); same<-as.numeric(gv[(l+1):n]==gv[1:(n-l)] & (tv[(l+1):n]-tv[1:(n-l)])==l); Gm<-crossprod(U[(l+1):n,,drop=FALSE]*same, U[1:(n-l),,drop=FALSE]); M<-M+w*(Gm+t(Gm)) }; M<-M*n/max(1,n-k); B<-brd(fit); B%*%M%*%B }");
          // Bandwidth and series length are properties of ONE series. Using
          // nrow(a) meant a controlled ITS of two six-period series counted as
          // twelve, so the correction was applied to a six-period series and the
          // lag was chosen for a series twice as long as any that exists.
          L.push("nser<-if(HASG) min(as.numeric(table(a$g))) else nrow(a)");
          L.push("Lg<-max(1,floor(4*(nser/100)^(2/9)))");
          L.push("Vm<-vcov(fit)[gdn,gdn,drop=FALSE]; Vh<-tryCatch(hacv(fit,Lg,a$g,a$t),error=function(e) NULL)");
          // Durbin-Watson on GLM Pearson residuals has no standard null distribution,
          // and over 24-36 periods it has little power anyway, so it is far too weak
          // to decide which standard error is used. It is reported for information;
          // the choice is made by "semode" below, which does not consult it.
          // A (near-)perfect fit makes every score contribution zero, so the sandwich
          // meat vanishes and the intervals come out zero-width. Never report that.
          L.push("hacdeg<-FALSE; hacfail<-is.null(Vh)");
          L.push("if(!is.null(Vh)){ dg<-diag(Vh); dm<-diag(Vm); if(any(!is.finite(dg)) || any(dg<=0) || any(dg < 1e-6*dm)){ Vh<-NULL; hacdeg<-TRUE } }");
          // "auto" used to mean "apply the sandwich to anything with >= 12 rows".
          // Simulating this file's own sandwich under the null (segmented model,
          // 2000-2500 replicates, two seeds) put the rejection rate of a nominal
          // 5% test at 0.38 at 12 periods, 0.21 at 24 and 0.09 at 100 — and worse
          // than the model-based SE it replaces at every length below about 60,
          // INCLUDING under the AR(1) errors it exists to handle. The model-based
          // SE is not a safe default either: it is nominal only when the residuals
          // are independent, and rejects at 0.19-0.39 once they are not.
          // Neither is right, and nothing in the data says which regime you are in,
          // so "auto" takes the WIDER of the two, coefficient by coefficient. That
          // rule was simulated alongside the other two and is at least as good as
          // whichever happens to be better, in every cell tested: 0.05 at rho=0 at
          // every length, and below both alternatives at rho=0.3/0.5/0.7.
          L.push("semode<-if(AC=='none' || is.null(Vh)) 'model' else if(AC=='newey') 'hac' else 'wider'");
          L.push("sem<-sqrt(diag(Vm)); seh<-if(is.null(Vh)) sem else sqrt(diag(Vh))");
          L.push("selab<-if(semode=='hac') sprintf('Newey-West HAC standard errors (Bartlett kernel, lag %d, meat scaled by n/(n-k))',Lg) else if(semode=='wider') sprintf('the wider of the model-based and the Newey-West HAC standard error (Bartlett kernel, lag %d), taken coefficient by coefficient',Lg) else 'model-based standard errors'");
          // R itself uses t for lm and quasi-Poisson and z for Poisson and negative
          // binomial. A blanket 1.96 was therefore too narrow for two of the four
          // families this file can fit. The sandwich is finite-sample sensitive
          // whatever the family, so it always gets t.
          L.push("dfres<-df.residual(fit); ist<-any(grepl('^t ',colnames(summary(fit)$coefficients)))");
          L.push("crit<-if((semode!='model' || ist) && is.finite(dfres) && dfres>0) qt(0.975,dfres) else 1.96");
          L.push("critlab<-if(crit>1.9601) sprintf('t with %d degrees of freedom',dfres) else 'a normal approximation'");
          L.push("");
          L.push("nmv<-gdn; se<-if(semode=='model') sem else if(semode=='hac') seh else pmax(sem,seh); names(se)<-nmv");
          L.push("# rates can be tiny, so fall back to significant digits rather than printing +0.000");
          L.push("fmt<-function(x) if(!is.finite(x)) 'NA' else if(abs(x)>=0.01 || x==0) sprintf('%+.3f',x) else sprintf('%+.3g',x)");
          L.push("rep1<-function(lab,nm){ if(!(nm %in% nmv) || is.na(cf[[nm]])) return(invisible()); b<-as.numeric(cf[[nm]]); s<-as.numeric(se[[nm]]); lo<-b-crit*s; hi<-b+crit*s");
          L.push("  if(expo) cat(sprintf('RESULT_ESTIMATE|%s|%.3f (95%% CI %.3f-%.3f)\\n',lab,exp(b),exp(lo),exp(hi)))");
          L.push("  else cat(sprintf('RESULT_ESTIMATE|%s|%s (95%% CI %s to %s)\\n',lab,fmt(b),fmt(lo),fmt(hi))) }");
          L.push("sc<-if(expo) ' (rate ratio)' else ' (absolute change)'");
          // Under the controlled parameterisation `t` is the slope at g=0, which is
          // the CONTROL series, not the intervention series. It was labelled
          // "Pre-intervention slope" in both cases, so a controlled run told the
          // reader the baseline trend was flat while the intervention series was
          // rising 5% a month.
          L.push("rep1(paste0(if(HASG) 'Pre-intervention slope, control series, per period' else 'Pre-intervention slope, per period',sc),'t')");
          // g:t IS the parallel-pre-trends test the whole controlled estimand rests
          // on. It was fitted and never shown.
          L.push("if(HASG){ rep1(paste0('Difference in pre-intervention slope, intervention vs control',sc),'g:t')");
          L.push("  if('g:t' %in% nmv && !is.na(cf[['g:t']])){ zpt<-abs(as.numeric(cf[['g:t']])/as.numeric(se[['g:t']])); if(is.finite(zpt) && zpt>crit) cat(sprintf('RESULT_NOTE|The two series were NOT on parallel trends before the intervention: the difference in pre-intervention slope is %.3f per period, %.1f standard errors from zero. A controlled interrupted time series estimates the intervention effect by assuming the control series shows what the intervention series would have done, and that assumption is contradicted here. The difference-in-differences rows below inherit the divergence and should not be read as an effect.\\n', if(expo) exp(as.numeric(cf[['g:t']])) else as.numeric(cf[['g:t']]), zpt)) } }");
          L.push("if(HASG){ rep1(paste0('Level change, control series',sc),'level'); rep1(paste0('Slope change per period, control series',sc),'tsince')");
          L.push("  rep1(paste0('Difference in level change, intervention vs control',sc),'g:level'); rep1(paste0('Difference in slope change per period, intervention vs control',sc),'g:tsince')");
          L.push("} else { rep1(paste0('Level change, immediate step',sc),'level'); rep1(paste0('Slope change, per period',sc),'tsince') }");
          L.push("");
          L.push("# --- observed vs counterfactual at the end of follow-up ---");
          L.push("gmax<-max(a$g); tn<-max(a$t[a$g==gmax]); tsn<-max(0,tn-t0)");
          L.push("L0<-setNames(rep(0,length(nmv)),nmv)");
          L.push("zn<-if(HASG) c('g:level','g:tsince') else c('level','tsince')");
          L.push("if(zn[1] %in% nmv) L0[zn[1]]<-1; if(zn[2] %in% nmv) L0[zn[2]]<-tsn");
          L.push("cfv<-cf[nmv]; cfv[is.na(cfv)]<-0");
          // The contrast is a linear combination, so "the wider of the two" has to
          // be applied to the two quadratic forms, not to the two diagonals.
          L.push("ct<-sum(L0*cfv)");
          L.push("vm0<-as.numeric(t(L0)%*%Vm%*%L0); vh0<-if(is.null(Vh)) vm0 else as.numeric(t(L0)%*%Vh%*%L0)");
          L.push("vct<-if(semode=='model') vm0 else if(semode=='hac') vh0 else max(vm0,vh0)");
          L.push("sct<-if(is.finite(vct) && vct>0) sqrt(vct) else NA_real_");
          L.push("endlab<-ukey[tn]");
          // "Observed" was wrong: ct is built from the model's own coefficients, so
          // this is the FITTED value against the counterfactual, not the observed
          // one. On the cohort demo the last period's observed count is 16 and its
          // fitted value 18.73, so the row labelled "observed vs counterfactual"
          // was 0.655 where observed/counterfactual is 0.559.
          L.push("if(!is.na(sct)){ if(expo) cat(sprintf('RESULT_ESTIMATE|Fitted vs counterfactual at %s (end of follow-up)|%.3f (95%% CI %.3f-%.3f)\\n',endlab,exp(ct),exp(ct-crit*sct),exp(ct+crit*sct)))");
          L.push("  else cat(sprintf('RESULT_ESTIMATE|Fitted minus counterfactual at %s (end of follow-up)|%s (95%% CI %s to %s)\\n',endlab,fmt(ct),fmt(ct-crit*sct),fmt(ct+crit*sct))) }");
          L.push("if(!is.na(sct)) cat(sprintf('RESULT_NOTE|The end-of-follow-up row compares the model%s fitted value at %s with the counterfactual the model projects from the pre-intervention trend. It is not the observed value at that period divided by the counterfactual - a single period%s observation carries its own noise, which is why the model value is used.\\n', \"'s\", endlab, \"'s\"))");
          L.push("");
          L.push("# --- fitted and counterfactual series ---");
          L.push("X<-model.matrix(fit); Xc<-X");
          L.push("zc<-if(HASG) grepl('^g:(level|tsince)$',colnames(X)) else colnames(X) %in% c('level','tsince')");
          L.push("Xc[,zc]<-0");
          L.push("off<-fit$offset; if(is.null(off)) off<-rep(0,nrow(X))");
          L.push("bb<-cfv[colnames(X)]; bb[is.na(bb)]<-0");
          L.push("inv<-if(inherits(fit,'glm')) fit$family$linkinv else function(z) z");
          L.push("fv<-inv(as.numeric(X%*%bb)+off); cv<-inv(as.numeric(Xc%*%bb)+off)");
          L.push("cat('FITTED|series|period|t|observed|denominator|fitted|counterfactual\\n')");
          L.push("for(i in seq_len(nrow(a))) cat(sprintf('FITTED|%s|%s|%d|%.6g|%s|%.6g|%.6g\\n', if(HASG) (if(a$g[i]>0) 'intervention' else 'control') else 'series', a$key[i], a$t[i], a$Y[i], if(useoff) sprintf('%.6g',a$N[i]) else '', fv[i], cv[i]))");
          L.push("cat(sprintf('ITSMETA|t0=%d|cutlabel=%s|np=%d|pre=%d|post=%d|controlled=%s\\n',t0,ukey[t0],np,npre,npost,if(HASG) 'yes' else 'no'))");
          L.push("");
          // A series should describe itself before it is modelled.
          L.push("pre<-a$g==gref & a$t<t0; pst<-a$g==gref & a$t>=t0");
          L.push("rt<-function(m) if(useoff) sum(a$Y[m])/sum(a$N[m]) else mean(a$Y[m])");
          L.push("cat('TABLE1|Characteristic|Before|From ',ukey[t0],'\\n',sep='')");
          L.push("cat(sprintf('TABLE1|Periods|%d|%d\\n', npre, npost))");
          L.push("cat(sprintf('TABLE1|Total outcome|%.6g|%.6g\\n', sum(a$Y[pre]), sum(a$Y[pst])))");
          L.push("cat(sprintf('TABLE1|%s|%.6g|%.6g\\n', if(useoff) 'Rate per period (outcome/denominator)' else 'Mean per period', rt(pre), rt(pst)))");
          L.push("if(useoff) cat(sprintf('TABLE1|Denominator per period, mean|%.6g|%.6g\\n', mean(a$N[pre]), mean(a$N[pst])))");
          L.push("if(HASG) cat(sprintf('TABLE1|Control-series periods|%d|%d\\n', sum(a$g!=gref & a$t<t0), sum(a$g!=gref & a$t>=t0)))");
          L.push("dwt<-if(is.na(dw)) 'not computable' else sprintf('%.2f (lag-1 residual autocorrelation %+.2f)',dw,r1)");
          L.push("cat(sprintf('RESULT_NOTE|Segmented %s regression over %d period(s) fitted: %d before and %d from %s onward%s. Inference uses %s, with %s for the 95%% intervals. Durbin-Watson %s (descriptive only - on GLM Pearson residuals it has no standard null distribution).\\n', famlab, nfit, npre, npost, ukey[t0], if(useoff) ', with log(denominator) as an offset' else '', selab, critlab, dwt))");
          L.push("cat(sprintf('RESULT_NOTE|Periods were ordered by %s. Level change is the immediate step at %s; slope change accrues from the period after it (Wagner 2002 convention, time-since-intervention = 0 at the first affected period).\\n', ordmode, ukey[t0]))");
          L.push("if(cutmoved!='') cat(sprintf('RESULT_NOTE|The interruption you gave (%s) falls inside period %s rather than at its start, so that whole period is treated as the first affected one. If the intervention only applied to part of it, that period is partly pre-intervention and the step will be diluted; consider dropping it or using a finer period unit.\\n', cutmoved, ukey[t0]))");
          L.push("if(HASN) cat(sprintf('RESULT_NOTE|The denominator was combined within each period by taking the %s of the rows in that period%s.\\n', dmode, if(DCOMB=='auto' && dmode=='first') ' (chosen automatically because it is constant within every period)' else ''))");
          // A count model with no offset silently assumes a constant population.
          L.push("if(hacdeg) cat('RESULT_NOTE|The Newey-West correction was skipped: the model fits the series so closely that the sandwich estimator degenerates to zero variance, which would print impossibly narrow intervals. Model-based standard errors are reported instead.\\n')");
          // The sandwich failing outright used to be completely silent: useh was
          // set FALSE and the run carried on with model-based SEs. Someone who
          // explicitly chose "always use Newey-West" got the opposite, and was then
          // told they had requested it.
          L.push("if(hacfail) cat(sprintf('RESULT_NOTE|The Newey-West correction could not be computed on this fit%s, so the model-based standard errors are reported instead. That is not a request you made; if the residuals are correlated from one period to the next these intervals are too narrow.\\n', if(AC=='newey') ' even though you asked for it' else ''))");
          L.push("if(expo && !useoff) cat('RESULT_NOTE|No denominator was mapped, so this models the count per period and assumes the population at risk is the same in every period. If your outcome is already a rate, map its denominator or choose the linear model - otherwise a changing population will be read as a trend.\\n')");
          L.push("if(length(alias)>0) cat(sprintf('RESULT_NOTE|%d model term(s) could not be estimated because they are collinear with the rest of the model (%s), and were dropped. Over only a couple of complete cycles, calendar dummies and a linear time trend are not separately identifiable — shorten the seasonal terms, switch to harmonic terms, or lengthen the series.\\n', length(alias), paste(alias,collapse=', ')))");
          L.push("if(ratemode) cat('RESULT_NOTE|A denominator was mapped with a linear model, so the outcome is the rate (value divided by the denominator); the level and slope changes are on that rate scale.\\n')");
          L.push("if(npre<8) cat(sprintf('RESULT_NOTE|Only %d pre-intervention period(s) — the baseline trend, and therefore the counterfactual, is poorly estimated. Aim for at least 8 (ideally 12).\\n',npre))");
          L.push("if(npost<8) cat(sprintf('RESULT_NOTE|Only %d post-intervention period(s) — a slope change is hard to detect. Aim for at least 8 (ideally 12).\\n',npost))");
          // One note used to cover both of these, and got two things wrong. It said
          // the model-based SEs "were requested" in every branch that reached it,
          // including the ones where nothing was requested and the run had fallen
          // back on its own; and it asserted a single direction under a two-sided
          // condition, when a Durbin-Watson above 2.5 is NEGATIVE serial
          // correlation, where ignoring it makes the intervals too wide.
          L.push("if(!is.na(dw) && dw<1.5 && semode=='model' && AC=='none') cat(sprintf('RESULT_NOTE|Durbin-Watson %.2f: the residuals are positively correlated from one period to the next, and you asked for model-based standard errors, which assume they are not. These intervals are too narrow.\\n', dw))");
          L.push("if(!is.na(dw) && dw>2.5 && semode=='model' && AC=='none') cat(sprintf('RESULT_NOTE|Durbin-Watson %.2f: the residuals alternate in sign from one period to the next (negative serial correlation). Model-based standard errors are conservative in that case, so these intervals are if anything too wide - but alternation this strong usually means the period length or the aggregation rule does not match how the data were collected, which is worth checking before reading the estimates.\\n', dw))");
          // This note is gated on LENGTH ALONE, deliberately. An earlier version of
          // it also required a residual autocorrelation above 0.2, which is the
          // very statistic the comment above says is too weak to gate on — and
          // simulating that gate showed it firing in 30% of runs at 24 periods and
          // 55% at 36 under the same true rho, while the worst-coverage cell tested
          // (60 periods, rho 0.7, both estimators rejecting a true null a fifth to a
          // quarter of the time) could never fire it at all. Whether the residuals
          // are correlated is exactly what a series this short cannot establish, so
          // the warning has to be about the length. r1 is reported inside it as
          // information, not used as the trigger.
          L.push("if(nser<60) cat(sprintf('RESULT_NOTE|Read this interval as indicative rather than as a 95%% interval. With %d period(s) per series there is not enough data to establish whether the residuals are correlated from one period to the next, and if they are, no standard error on offer here delivers its nominal coverage: in simulation both the model-based and the Newey-West interval reject a true null well over 5%% of the time once the residuals are correlated, at every length up to at least 60 periods. The lag-1 residual autocorrelation here is %s, which is itself too imprecise at this length to settle the question. Treat an interval that only just excludes the null as inconclusive; a longer series is the only real remedy.\\n', nser, if(is.na(r1)) 'not computable' else sprintf('%+.2f',r1)))");
          // Explicitly choosing the sandwich is a request, so it is honoured rather
          // than overridden — but on a short series it is the anti-conservative
          // choice, and the option text cannot say so per-series.
          L.push("if(semode=='hac' && nser<60) cat(sprintf('RESULT_NOTE|You asked for Newey-West standard errors and they were used. On a series of %d period(s) that is the narrower of the two options and the anti-conservative one: simulated on this model with independent residuals, the sandwich rejects a true null roughly two to four times as often as it should at this length, while the model-based standard error is close to nominal. \"Auto\" reports the wider of the two.\\n', nser))");
          // Say where the HAC correction stops, next to the numbers it produced.
          L.push("if(HASG && semode!='model') cat('RESULT_NOTE|With a control series the HAC correction is applied within each series: lag products that cross the two series are excluded, so serial correlation is handled but any contemporaneous correlation between the intervention and control series at the same time point is assumed to be zero. If the two series move together period by period, these standard errors are too narrow.\\n')");
          L.push("");
          L.push("cat('\\n--- Segmented regression coefficients ---\\n'); print(summary(fit)$coefficients)");
          L.push("cat(sprintf('\\nPeriods: %d (%s to %s); interruption at %s (period %d).\\n',np,ukey[1],ukey[np],ukey[t0],t0))");
          L.push("cat(sprintf('Model: %s. Standard errors: %s. Durbin-Watson: %s.\\n',famlab,selab,dwt))");
          return L.join("\n");
        },
      },
    };

    const KW = {
      TREAT: /treat|exposure|exposed|arm|drug|group/i, TIME: /time|fu|follow|days|duration|survtime/i,
      EVENT: /event|outcome|death|died|dead|case|status/i, DISC: /disc|discont|switch|stop|cessation|deviat/i,
      ID: /(^|_)id$|patient|subject|caseid|pid/i, EXPOSED: /expos|treat|drug/i, EVENTS: /event|count|nevent/i,
      INTERVAL: /interval|persontime|offset|length|days|time/i, CASE: /case|hazard|window|status/i,
      TIDX: /date|time|period|month|quarter|week|year|index|日期|時間|月|年|季|期/i,
      YCOUNT: /count|events|cases|rate|incid|outcome|n_|_n$|num|次數|人次|件數|率/i,
      DENOM: /denom|popul|offset|persontime|person_time|at_?risk|exposed_pop|py$|人口|母數|分母/i,
      SEAS: /season|month|quarter|cycle|月份|季節/i,
      SERIES: /control|series|region|site|area|arm|group|對照|組別/i,
    };
    const getDesign = () => { const r = document.querySelector('[name="design"]:checked'); return r ? r.value : ""; };
    let MAP = {}, COVS = [], MASTER = null, LAST = null, COVROLE = {};
    let PSCSPLIT = {};   // source column → "claims" | "clinical" | "" (undecided, and blocking)
    let PSCRUN = null;   // snapshot of what the last run actually fitted

    // Role suggestions lean on three sources, in this order: the column name, the
    // codebook definition (which carries the meaning when the name is opaque or in
    // another language), and what the structure panel established about the file.
    const ROLE_BOOST = {
      ID: (p) => (p.name === STRUCT.idCol ? 4 : 0),
      TIDX: (p) => (p.type === "date" ? 2 : 0),
      DENOM: (p) => (/pop|risk|denom|母數|人口|人數/i.test(p.name) ? 1 : 0),
      SERIES: (p) => (p.type === "binary" ? 1 : 0),
    };
    function suggestCol(role) {
      const kw = KW[role.k];
      let best = "", score = 0;
      for (const p of DATA.profile) {
        // A name match is not enough on its own. "clinic_site" matches the
        // control-series keywords, but a 26-level text column cannot be a 0/1
        // indicator, and offering it only sends the user to an error message.
        if (!role.types.includes(p.type)) continue;
        let sc = 1;
        if (kw && kw.test(p.name)) sc += 3;
        if (kw && p.def && kw.test(p.def)) sc += 2;
        const b = ROLE_BOOST[role.k]; if (b) sc += b(p);
        if (sc > score) { score = sc; best = p.name; }
      }
      return score >= 4 ? best : "";
    }
    function renderMap() {
      const spec = SPEC[getDesign()];
      if (!spec || !DATA.columns.length) { $("mapcard").classList.add("hidden"); return; }
      $("mapcard").classList.remove("hidden");
      $("designname").textContent = spec.label;
      $("maphint").textContent = spec.hint;
      const opts = (sel) => '<option value="">— choose —</option>' + DATA.columns.map((c) => '<option value="' + esc(c) + '"' + (sel === c ? " selected" : "") + ">" + esc(c) + "</option>").join("");
      $("maproles").innerHTML = spec.roles.map((r) => {
        if (!(r.k in MAP)) MAP[r.k] = suggestCol(r);
        return '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">' + esc(r.label) + (r.req ? " *" : " (optional)") + '</span><select data-role="' + r.k + '" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">' + opts(MAP[r.k]) + "</select></label>";
      }).join("");
      $("maproles").querySelectorAll("select[data-role]").forEach((sel) => sel.addEventListener("change", () => { MAP[sel.getAttribute("data-role")] = sel.value; invalidateMaster(); renderCovs(spec); validateMap(); }));
      $("itsopts").classList.toggle("hidden", getDesign() !== "its");
      renderCovs(spec);
      try { renderDupUI(); } catch (e) {}
      try { renderDedupeUI(); } catch (e) {}
      validateMap();
    }
    function detectIdCol() {
      const spec = SPEC[getDesign()];
      if (spec && spec.roles.some((r) => r.k === "ID") && MAP.ID) return MAP.ID;
      if (STRUCT.idCol && DATA.columns.indexOf(STRUCT.idCol) >= 0) return STRUCT.idCol;
      const byType = DATA.profile.find((p) => p.type === "id");
      if (byType) return byType.name;
      const byName = DATA.columns.find((c) => /(^|_)id$|patient|subject|pid|caseid/i.test(c));
      return byName || "";
    }
    // The same rule the duplicate-ID resolver below already follows, applied to the
    // exact-duplicate-ROW dropper: only a one-row-per-person cohort can have one.
    const dedupeAllowed = () => { const s = SPEC[getDesign()]; return !!(s && s.onePerPerson) && $("c_dedupe").checked; };
    // What a row actually IS in each design — the reason an identical one is data. A
    // case-crossover row is a window and an ITS row is a record inside a period; only
    // the self-controlled series measures person-time.
    const ROW_UNIT = { sccs: "repeated person-time", cco: "another window", its: "another record inside the same period" };
    const rowUnit = () => ROW_UNIT[getDesign()] || "a separate observation";
    // What the user last chose while the control actually applied. Unticking the box to
    // show it is off must not throw that choice away: switching to a long-format design
    // and back would otherwise leave the cohort silently un-deduplicated.
    let dedupePref = true;
    function renderDedupeUI() {
      const spec = SPEC[getDesign()], onePer = !!(spec && spec.onePerPerson);
      const box = $("c_dedupe"), lab = $("c_dedupe_l"), note = $("dedupenote");
      if (!box || !lab || !note) return;
      if (!box.disabled) dedupePref = box.checked;
      // A ticked box beside a note saying it is switched off is a contradiction the
      // reader has to resolve, so untick it — and put it back when it applies again.
      box.disabled = !onePer;
      box.checked = onePer ? dedupePref : false;
      lab.classList.toggle("opacity-45", !onePer);
      note.classList.toggle("hidden", onePer || !spec);
      if (!onePer && spec) note.textContent = "“Drop exact duplicate rows” is switched off for " + (spec.label || "this design") +
        ": here an identical row is " + rowUnit() + ", not a duplicate, so removing one would quietly drop real data and move the estimate.";
    }
    function renderDupUI() {
      const spec = SPEC[getDesign()];
      // Duplicate-ID resolution only makes sense where each person is meant to
      // appear ONCE — i.e. the ACNU new-user cohort. SCCS / case-crossover repeat
      // IDs by design and ITS collapses rows into periods, so hide it for those.
      const onePer = spec && spec.onePerPerson;
      $("dupwrap").classList.toggle("hidden", !onePer);
      if (!onePer || !DATA.columns.length) return;
      const idSel = $("dup_id"), dateSel = $("dup_date");
      const cur = idSel.value || detectIdCol();
      idSel.innerHTML = '<option value="">— none —</option>' + DATA.columns.map((c) => '<option value="' + esc(c) + '"' + (c === cur ? " selected" : "") + ">" + esc(c) + "</option>").join("");
      const dcur = dateSel.value;
      const dateCols = DATA.profile.filter((p) => p.type === "date").map((p) => p.name);
      dateSel.innerHTML = '<option value="">— none —</option>' + dateCols.map((c) => '<option value="' + esc(c) + '"' + (c === dcur ? " selected" : "") + ">" + esc(c) + "</option>").join("");
      // Default to what the structure panel concluded: repeats that are exact
      // copies are duplicates to drop; repeats that differ are real records.
      if (!$("dup_strategy").dataset.touched) $("dup_strategy").value = STRUCT.repeatKind === "measures" || STRUCT.repeatKind === "mixed" ? "all" : "first";
      updateDupCount();
    }
    function updateDupCount() {
      const idc = $("dup_id").value;
      if (!idc) { $("dupcount").textContent = "no ID column selected"; $("dupcount").className = "text-[11px] font-semibold text-slate-400"; return; }
      const counts = {};
      (DATA.rows || []).forEach((r) => { const k = String(r[idc] == null ? "" : r[idc]).trim(); if (k !== "") counts[k] = (counts[k] || 0) + 1; });
      const dup = Object.values(counts).filter((c) => c > 1);
      const extra = dup.reduce((a, c) => a + (c - 1), 0);
      $("dupcount").textContent = dup.length ? (dup.length + " ID(s) repeat · " + extra + " extra row(s)") : "no repeated IDs ✓";
      $("dupcount").className = "text-[11px] font-semibold " + (dup.length ? "text-amber-700" : "text-emerald-600");
    }
    $("dup_id").addEventListener("change", () => { invalidateMaster(); updateDupCount(); });
    // Every cleaning tick is an input to buildMaster and none of them invalidated
    // it: un-ticking "Drop rows missing a required mapped variable" after building
    // changed nothing at all about the run that followed.
    ["c_trim", "c_std", "c_dates", "c_dedupe", "c_dropmiss", "dup_date"].forEach((id) => {
      const e = $(id); if (e) e.addEventListener("change", invalidateMaster);
    });
    $("dup_strategy").addEventListener("change", () => { $("dup_strategy").dataset.touched = "1"; });
    function renderCovs(spec) {
      if (!spec.covariates) { $("covwrap").classList.add("hidden"); return; }
      $("covwrap").classList.remove("hidden");
      const used = new Set(spec.roles.map((r) => MAP[r.k]).filter(Boolean));
      $("covlist").innerHTML = DATA.columns.filter((c) => !used.has(c)).map((c) => {
        const rc = COVROLE[c];
        const badge = rc ? ' <span class="rounded px-1 py-0.5 text-[9px] font-semibold ' + ROLE_CLS(rc.role) + '">' + esc(rc.role) + "</span>" : "";
        return '<label class="flex items-start gap-1.5" title="' + (rc ? esc(rc.reason) : "") + '"><input type="checkbox" data-cov="' + esc(c) + '"' + (COVS.includes(c) ? " checked" : "") + ' class="mt-0.5"/> <span>' + esc(c) + badge + "</span></label>";
      }).join("");
      $("covlist").querySelectorAll("input[data-cov]").forEach((cb) => cb.addEventListener("change", () => { const c = cb.getAttribute("data-cov"); if (cb.checked) { if (!COVS.includes(c)) COVS.push(c); } else COVS = COVS.filter((x) => x !== c); invalidateMaster(); renderCovNote(); validateMap(); }));
      $("acnuopts").classList.toggle("hidden", getDesign() !== "acnu");
      renderCovNote();
      try { renderPscSplit(); } catch (e) { console.error(e); }
    }
    // ── Propensity-score calibration: which covariates does a claims database see? ──
    // NFC first, for the same reason the codebook matcher needs it: a name written
    // on one platform and a rule written on another compare unequal while rendering
    // identically. Skipping this is why an earlier classifier silently mislabelled
    // every Korean and accented-Latin column.
    const PSC_NORM = (s) => String(s == null ? "" : s).normalize("NFC").toLowerCase().replace(/[_\-.]+/g, " ").replace(/\s+/g, " ").trim();
    // Tested FIRST: a coded diagnosis, procedure, dispensing or visit is in claims
    // even when the measurement behind it is not. Obesity is claims; BMI is not.
    const PSC_CODED = /diagnos|\bdx\b|icd\b|procedure|\bcode[ds]?\b|claim|\bvisit|admission|hospitali[sz]|dispens|prescri|refill|\brx\b|count|次數|就醫|住院|處方|診斷|手術/;
    const PSC_CLINICAL = /hba1c|glycated|a1c|egfr|creatinin|albumin|bilirubin|\balt\b|\bast\b|ldl|hdl|cholesterol|triglycerid|glucose|blood pressure|systolic|diastolic|\bbp\b|bmi|body mass|height|weight|waist|pulse|heart rate|temperature|oxygen|spo2|ejection fraction|\blvef\b|fev1|\bfvc\b|spiromet|visual acuity|intraocular|\biop\b|ecog|karnofsky|performance status|\bstage\b|\bgrade\b|severit|ki67|pd-?l1|biomarker|\blab\b|laborator|panss|ham-?d|madrs|mmse|apgar|gestational|birth weight|smok|pack.?year|frailty|symptom|functional status|family history|genetic|genotype|polygenic|dialysis vintage|kt.?v\b|\burr\b|troponin|sodium|potassium|haemoglobin|hemoglobin|收縮壓|舒張壓|血壓|血圧|혈압|身高|身長|체중|體重|体重|眼壓|眼圧|視力|抽菸|吸菸|喫煙|흡연|飲酒|檳榔|血糖|糖化|檢驗|クレアチニン|크레아티닌|ヘモグロビン|重症度/;
    const PSC_CLAIMS = /\bage\b|年齡|年龄|\bsex\b|gender|性別|region|urban|rural|area|\bsite\b|clinic|hospital|centre|center|provider|facility|insur|income|\bses\b|deprivation|year|calendar|index date|\bhistory\b|\bhx\b|prior |comorbid|charlson|elixhauser|\bcci\b|drug|medication|therapy|保險|地區|病史|藥/;
    function pscSeed(name, def) {
      const n = PSC_NORM(name), d = PSC_NORM(def || "");
      if (PSC_CODED.test(n) || PSC_CODED.test(d)) return "claims";
      if (PSC_CLINICAL.test(n) || PSC_CLINICAL.test(d)) return "clinical";
      if (PSC_CLAIMS.test(n) || PSC_CLAIMS.test(d)) return "claims";
      return "";                                   // undecided, and blocking
    }
    function pscReseed(force) {
      covPlan(MASTER || DATA.rows).info.forEach((c) => {
        if (force || !PSCSPLIT[c.src]) {
          const p = DATA.profile.find((x) => x.name === c.src);
          PSCSPLIT[c.src] = pscSeed(c.src, p ? p.def : "");
        }
      });
    }
    const PSC_CLS = { claims: "bg-emerald-100 text-emerald-800 border-emerald-300", clinical: "bg-violet-100 text-violet-800 border-violet-300", "": "bg-white text-slate-500 border-slate-200" };
    function renderPscSplit() {
      const body = $("pscbody"); if (!body) return;
      const on = getDesign() === "acnu" && $("psc_on").checked;
      body.classList.toggle("hidden", !$("psc_on").checked);
      if (!on || !COVS.length) { $("psclist").innerHTML = ""; $("pscmsg").textContent = ""; return; }
      pscReseed(false);
      const info = covPlan(MASTER || DATA.rows).info;
      $("psclist").innerHTML = info.map((c) => {
        const cur = PSCSPLIT[c.src] || "";
        const btn = (v, label) => '<button type="button" data-pscset="' + v + '" data-pscvar="' + esc(c.src) + '" class="text-[10px] font-semibold px-2 py-0.5 rounded border transition ' + (cur === v ? PSC_CLS[v] : "bg-white text-slate-400 border-slate-200 hover:border-slate-400") + '">' + label + "</button>";
        return '<div class="flex items-center gap-2 bg-white border border-slate-200 rounded px-2 py-1">' +
          '<span class="flex-1 min-w-0 truncate" title="' + esc(c.src) + '">' + esc(c.src) + (cur ? "" : ' <span class="text-rose-600 font-bold">?</span>') + "</span>" +
          '<span class="flex gap-1 shrink-0">' + btn("claims", "Claims") + btn("clinical", "Clinical-only") + "</span></div>";
      }).join("");
      $("psclist").querySelectorAll("[data-pscset]").forEach((b) => b.addEventListener("click", () => {
        const v = b.getAttribute("data-pscset"), k = b.getAttribute("data-pscvar");
        PSCSPLIT[k] = PSCSPLIT[k] === v ? "" : v;
        renderPscSplit();
      }));
      const nC = info.filter((c) => PSCSPLIT[c.src] === "claims").length;
      const nU = info.filter((c) => PSCSPLIT[c.src] === "clinical").length;
      const un = info.filter((c) => !PSCSPLIT[c.src]).map((c) => c.src);
      const m = $("pscmsg");
      if (un.length) { m.innerHTML = '<span class="text-rose-700 font-semibold">Undecided: ' + un.map(esc).join(", ") + ".</span> The formula is not computed until every covariate is placed — a variable guessed into the wrong side silently breaks the correction."; m.className = "text-[11px] text-rose-700"; }
      else if (!nU) { m.textContent = "No clinical-only covariates, so the two propensity scores would be identical and there is nothing to calibrate against. Mark at least one covariate a claims database could not see."; m.className = "text-[11px] text-amber-700"; }
      else if (!nC) { m.textContent = "No claims-available covariates, so there is no error-prone score to calibrate."; m.className = "text-[11px] text-amber-700"; }
      else { m.textContent = nC + " claims-available (error-prone score) · " + nU + " clinical-only (added for the gold-standard score). β̂ for the treatment and the score come from the claims-only study and cannot be computed here."; m.className = "text-[11px] text-slate-500"; }
    }
    function pscReady() {
      if (getDesign() !== "acnu" || !$("psc_on").checked) return null;
      const info = covPlan(MASTER || DATA.rows).info;
      if (!info.length || info.some((c) => !PSCSPLIT[c.src])) return null;
      const C = info.filter((c) => PSCSPLIT[c.src] === "claims"), U = info.filter((c) => PSCSPLIT[c.src] === "clinical");
      if (!C.length || !U.length) return null;
      return { C: C, U: U, valType: $("psc_valtype").value, boot: parseInt($("psc_boot").value) || 0 };
    }
    ["psc_on", "psc_valtype", "psc_boot"].forEach((id) => $(id).addEventListener("change", renderPscSplit));
    $("psc_reseed").addEventListener("click", () => { pscReseed(true); renderPscSplit(); });
    $("psc_allc").addEventListener("click", () => { COVS.forEach((c) => { PSCSPLIT[c] = "claims"; }); renderPscSplit(); });
    $("psc_allu").addEventListener("click", () => { COVS.forEach((c) => { PSCSPLIT[c] = "clinical"; }); renderPscSplit(); });

    // Say up front how each ticked covariate will enter the model, and name any
    // that cannot be used. A variable must never leave the model in silence.
    function renderCovNote() {
      const el = $("covnote"); if (!el) return;
      const spec = SPEC[getDesign()];
      if (!spec || !spec.covariates || !COVS.length || !DATA.rows.length) { el.textContent = ""; return; }
      const plan = covPlan(MASTER || DATA.rows);
      const nNum = plan.info.filter((c) => c.kind === "numeric").length;
      const nBin = plan.info.filter((c) => c.kind === "binary").length;
      const fac = plan.info.filter((c) => c.kind === "factor");
      const bits = [];
      if (nNum) bits.push(nNum + " continuous");
      if (nBin) bits.push(nBin + " binary (0/1)");
      if (fac.length) bits.push(fac.length + " categorical → dummy-coded factor" + (fac.length > 1 ? "s" : "") + " (" +
        fac.map((c) => c.src + ", " + c.levels + " levels" + (c.collapsed ? " → " + c.effective + " after folding " + c.rare.length + " rare into “other”" : "")).join("; ") + ")");
      let html = plan.info.length ? "In the propensity model: " + bits.join(" · ") + "." : "";
      const thin = fac.filter((c) => c.thinEvents && c.thinEvents.length);
      if (thin.length) html += (html ? " " : "") + '<span class="text-amber-700">Fewer than ' + COV_MIN_EVENTS_PER_LEVEL + " events behind " +
        thin.map((c) => c.thinEvents.length + " level(s) of " + esc(c.src)).join(" and ") + " — those coefficients will be unstable.</span>";
      if (plan.dropped.length) html += (html ? " " : "") + '<span class="text-rose-700 font-semibold">Left out: ' + plan.dropped.map((d) => esc(d.src) + " (" + esc(d.why) + ")").join("; ") + ".</span>";
      el.innerHTML = html;
      el.className = "mt-1.5 text-[11px] " + (plan.dropped.length ? "text-rose-700" : (thin.length ? "text-amber-700" : "text-slate-500"));
    }
    const availCovCols = () => { const spec = SPEC[getDesign()]; const used = new Set(spec.roles.map((r) => MAP[r.k]).filter(Boolean)); return DATA.columns.filter((c) => !used.has(c)); };
    const COV_KW = /age|sex|gender|comorbid|cci|charlson|elix|diab|hyperten|renal|ckd|egfr|copd|asthma|cancer|malig|smok|alcohol|bmi|weight|obes|hba1c|ldl|hdl|chol|creatinin|statin|insulin|metformin|nsaid|ppi|anticoag|antiplatel|steroid|comed|med_|drug|dx_|hx_|prior|baseline|income|ses|deprivation|urban|region|frailty|score|sever|stage|grade|class/i;
    const COV_EXCL = /(^|_)id$|date|event|outcome|death|died|treat|expos|arm|time|fu_|followup|persontime|disc|switch/i;
    $("cov_auto").addEventListener("click", () => { COVS = availCovCols().filter((c) => COV_KW.test(c) && !COV_EXCL.test(c)); renderCovs(SPEC[getDesign()]); validateMap(); });
    $("cov_all").addEventListener("click", () => { COVS = availCovCols().slice(); renderCovs(SPEC[getDesign()]); validateMap(); });
    $("cov_none").addEventListener("click", () => { COVS = []; renderCovs(SPEC[getDesign()]); validateMap(); });
    $("cov_collapse").addEventListener("change", () => { renderCovNote(); validateMap(); });

    // AI causal triage — metadata-only (column names + the clinical question).
    const WORKER_URL = "https://target-checker.danielhttsai.workers.dev";
    const ROLE_CLS = (r) => ({ confounder: "bg-emerald-100 text-emerald-800", mediator: "bg-amber-100 text-amber-800", collider: "bg-rose-100 text-rose-800", instrument: "bg-violet-100 text-violet-800", structural: "bg-slate-100 text-slate-600", unclear: "bg-slate-100 text-slate-500" }[r] || "bg-slate-100 text-slate-600");
    const setCovAiMsg = (t, bad) => { const el = $("cov_ai_msg"); if (el) { el.textContent = t || ""; el.className = "text-[11px] " + (bad ? "text-rose-600" : "text-emerald-700"); } };
    $("cov_ai").addEventListener("click", async () => {
      const q = readQ();
      if (!q.exp || !q.out) { setCovAiMsg("Enter the exposure and outcome in step 1 first.", true); return; }
      const cols = availCovCols().map((c) => { const p = DATA.profile.find((x) => x.name === c); return { name: c, type: p ? p.type : "" }; });
      if (!cols.length) { setCovAiMsg("No candidate columns to classify yet — map the roles first.", true); return; }
      const btn = $("cov_ai"); btn.disabled = true;
      setCovAiMsg("Asking the AI to classify each column for your exposure→outcome (only column names are sent, never patient data)…");
      try {
        const res = await fetch(WORKER_URL, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ mode: "confounders", question: { population: q.pop, exposure: q.exp, comparator: q.comp, outcome: q.out }, columns: cols }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.items) { setCovAiMsg(data.error || "The AI could not classify the columns.", true); return; }
        COVROLE = {};
        data.items.forEach((it) => { if (it && it.name) COVROLE[it.name] = { role: it.role, adjust: !!it.adjust, reason: it.reason || "" }; });
        COVS = cols.map((c) => c.name).filter((n) => COVROLE[n] && COVROLE[n].adjust);
        renderCovs(SPEC[getDesign()]); validateMap();
        const warn = data.items.filter((i) => i.role === "mediator" || i.role === "collider" || i.role === "instrument").length;
        setCovAiMsg("Ticked " + COVS.length + " confounder(s); flagged " + warn + " mediator/collider/instrument to NOT adjust. Hover a badge for the reason — review and edit; the final clinical call is yours.");
      } catch (e) { setCovAiMsg("Couldn't reach the AI: " + (e && e.message ? e.message : e), true); }
      finally { btn.disabled = false; }
    });
    function validateMap() {
      const spec = SPEC[getDesign()]; if (!spec) return false;
      const missing = spec.roles.filter((r) => r.req && !MAP[r.k]).map((r) => r.label);
      const needCov = spec.covariates && COVS.length === 0;
      const noUsable = spec.covariates && COVS.length > 0 && DATA.rows.length > 0 && covPlan(MASTER || DATA.rows).info.length === 0;
      const needCut = getDesign() === "its" && !$("its_cut").value.trim();
      // Only blocks when the cycle length is actually in play; otherwise a stray
      // character in a box the analysis never reads would stop the run.
      const badCyc = getDesign() === "its" && $("its_season").value !== "none" && !itsCycle().ok ? itsCycle() : null;
      const bt = missing.length ? [] : binTrouble();
      const nt = missing.length ? [] : numTrouble();
      // Two roles resolving to one column is a mis-map the page used to answer
      // with a green tick: mapping the exposure column to the case indicator too
      // made every hazard window exposed and every control window not, and the
      // case-crossover printed an odds ratio of 2,615,842,843.
      const dupRole = [];
      if (!missing.length) {
        const byCol = {};
        spec.roles.forEach((r) => { if (MAP[r.k]) { (byCol[MAP[r.k]] = byCol[MAP[r.k]] || []).push(r.label); } });
        Object.keys(byCol).forEach((c) => { if (byCol[c].length > 1) dupRole.push({ col: c, roles: byCol[c] }); });
      }
      const ok = missing.length === 0 && !needCov && !needCut && !badCyc && !noUsable && !bt.length && !nt.length && !dupRole.length;
      const m = $("mapmsg");
      if (dupRole.length) {
        m.innerHTML = dupRole.map((d) => "<strong>" + esc(d.col) + "</strong> is mapped to more than one role (" + esc(d.roles.join(", ")) + ").").join(" ") +
          " Each role has to be a different column: a variable compared against itself carries no information, and the model fitted on it will either refuse or return an enormous number that means nothing.";
        m.className = "mt-3 text-xs text-rose-700";
      }
      // Each column carries its OWN remedy. A first draft appended only nt[0].fix
      // to the end of the whole list, so with two bad columns the reader saw the
      // event-count advice ("map the count here") attached to the sentence about
      // their person-time column, and the person-time remedy never appeared at all.
      else if (nt.length) {
        m.innerHTML = nt.map((b) => "<strong>" + esc(b.col) + "</strong> " +
          (b.cov ? "is ticked as a baseline covariate, but " : "is mapped to “" + esc(b.label) + "”, but ") + esc(b.why) +
          " (for example: " + esc(b.eg.join(", ")) + "). " + esc(b.fix)).join(" ");
        m.className = "mt-3 text-xs text-rose-700";
      }
      else if (bt.length) {
        m.innerHTML = bt.map((b) => "<strong>" + esc(b.col) + "</strong> is mapped to “" + esc(b.label) + "”, but holds " +
          esc(b.bad.join(", ")) + " — value(s) this tool cannot read as yes or no.").join(" ") +
          " A 0/1 role must be unambiguous: if the column has exactly two levels, say which one means yes under <strong>Coded flags</strong> in the structure panel above; if it has three or more (1 = yes, 2 = no, 9 = unknown, say), recode it before uploading. It is not treated as “yes” just because it is not zero.";
        m.className = "mt-3 text-xs text-rose-700";
      }
      else if (missing.length) { m.textContent = "Map the required roles (*): " + missing.join(", "); m.className = "mt-3 text-xs text-amber-700"; }
      else if (needCut) { m.textContent = "Give the interruption point — the first period affected by the intervention."; m.className = "mt-3 text-xs text-amber-700"; }
      else if (badCyc) {
        m.innerHTML = "Seasonality is switched on, but the cycle length “<strong>" + esc(badCyc.raw) + "</strong>” " + esc(badCyc.why) +
          ". It is not assumed: a cycle the tool guessed wrong is fitted as a seasonal term that is really nothing at all, and the estimates move without anything saying why. Give a whole number of periods (12 for monthly data, 4 for quarterly), or set Seasonality to None.";
        m.className = "mt-3 text-xs text-rose-700";
      }
      else if (needCov) { m.textContent = "Tick at least one baseline covariate for the propensity score."; m.className = "mt-3 text-xs text-amber-700"; }
      else if (noUsable) { m.textContent = "None of the ticked covariates can be used — see the note under the list."; m.className = "mt-3 text-xs text-rose-700"; }
      else { m.textContent = "Mapping complete ✓ — build the master file below."; m.className = "mt-3 text-xs text-emerald-700"; }
      $("cleancard").classList.toggle("hidden", !ok);
      return ok;
    }

    const NUM_ROLES = ["TIME", "INTERVAL", "EVENTS", "DISC", "YCOUNT", "DENOM"];
    const BIN_ROLES = ["EVENT", "TREAT", "EXPOSED", "CASE", "SERIES"];
    const toBin = (v) => {
      if (v == null || v === "") return null;
      const l = String(v).trim().toLowerCase();
      const ym = yesMap();                                   // this dataset's own vocabulary wins
      if (l in ym) return ym[l];
      if (YES_TOKENS.indexOf(l) >= 0) return 1;
      if (NO_TOKENS.indexOf(l) >= 0) return 0;
      // "Any positive number means yes" is how an outcome coded 1=yes, 2=no,
      // 9=unknown — an ordinary registry coding — became 400 events out of 400.
      // Three or more levels never reach the "Coded flags" vocabulary (it is built
      // from two-level columns only), so nothing on screen mentioned the column,
      // and chk01 in R then saw a variable whose only value was 1 and passed it.
      // A number that is not already 0 or 1 is unreadable as a flag: return null,
      // leave the original value in place, and let the guard refuse it by name.
      const n = Number(l); return (n === 0 || n === 1) ? n : null;
    };
    // Which mapped 0/1 roles hold values that cannot be read as a flag. Reported on
    // screen before the run, so the refusal is not a raw R error at the end of it.
    function binTrouble() {
      const spec = SPEC[getDesign()]; if (!spec || !DATA.rows.length) return [];
      const out = [];
      spec.roles.filter((r) => BIN_ROLES.indexOf(r.k) >= 0 && MAP[r.k]).forEach((r) => {
        const col = MAP[r.k], bad = [];
        for (let i = 0; i < DATA.rows.length && bad.length < 6; i++) {
          const v = DATA.rows[i][col];
          if (isBlank(v)) continue;
          if (toBin(v) == null) { const s = String(v).trim(); if (bad.indexOf(s) < 0) bad.push(s); }
        }
        if (bad.length) out.push({ label: r.label, col: col, bad: bad });
      });
      return out;
    }

    // The 0/1 roles have had a pre-run guard since the fourth run (binTrouble).
    // The numeric roles had none: person-time and event counts reached R
    // unchecked, and R's own chknum only refuses a column with NO numeric values
    // at all — so person-time holding zeros or negatives was numeric, finite, and
    // accepted. R re-checks these conditions and stops, but a stop lands in the
    // black debug pre at the end of a run; a guard the user can see beats that.
    // A rule may need the row, not just the cell: whether a zero is a defect depends on
    // what else that row says. `pair` names another role whose value is passed as the
    // second argument (NaN when that role is unmapped, in which case a rule must fall
    // back to what it can decide alone).
    //
    // INTERVAL used to be `!(n > 0)`, which refused every zero-length interval. The R
    // this guard exists to pre-empt does not: `badrow` treats a negative interval, and an
    // event inside a zero-length one, as defects — but a zero-length interval carrying NO
    // events is counted into `ndrop0`, dropped, and reported as "they carry no
    // information either way". So one such row in eighty-one blocked a file R would have
    // analysed, which is the false-refusal half of this tool's own doctrine.
    const NUM_RULES = {
      INTERVAL: { pair: "EVENTS",
        why: "holds value(s) that are not a usable length of time",
        // Kept explicit about the harmless case, or the next reader sees the predicate
        // permit n === 0 and "fixes" the false refusal straight back in.
        fix: "Person-time cannot be negative, and no event can fall in an interval of zero length. Each interval enters the conditional likelihood as the person-time its events could have arisen in, so a negative length has no meaning there and an event in zero time is arithmetically impossible; a start and stop date subtracted the wrong way round, or identical, is the usual cause. Fix the column, or drop those rows deliberately. A zero-length interval with no events is fine — it carries no information either way and is dropped for you.",
        bad: (n, p) => n < 0 || (n <= 0 && p > 0) },
      EVENTS: { why: "holds value(s) that are not a whole number of events", fix: "This role wants a COUNT of events in the interval. If you have a rate, map the count here and the person-time to the interval role.", bad: (n) => !(n >= 0) || Math.abs(n - Math.round(n)) > 1e-8 },
      // ACNU's follow-up time is the same quantity as SCCS's interval and had no guard on
      // either side: `chknum` refuses only a column with NO numeric value at all, so a
      // negative follow-up reached Surv() unexamined. It does not error there — it simply
      // places those subjects at the front of every risk set, re-ordering the comparison.
      TIME: { pair: "EVENT",
        why: "holds value(s) that are not a usable follow-up time",
        fix: "Follow-up time cannot be negative, and an outcome cannot occur in zero days of follow-up. A negative value is usually two dates subtracted the wrong way round. If these are genuinely same-day events, code the follow-up as a fraction of a day (0.5) rather than 0, so the row carries the person-time it actually contributed. Rows with zero follow-up and no event are harmless here, and are left alone.",
        bad: (n, p) => n < 0 || (n <= 0 && p > 0) },
      DISC: { why: "holds value(s) that are not a usable time to discontinuation", fix: "This role is a time measured from the same start as the follow-up time, so it cannot be negative. It is used as pmin(follow-up, this) to censor the per-protocol analysis; a negative value censors everyone at once.", bad: (n) => n < 0 },
    };
    function numTrouble() {
      const spec = SPEC[getDesign()]; if (!spec || !DATA.rows.length) return [];
      // A blank is only trouble if it will still be there at run time. With "Drop
      // rows missing a required mapped variable" ticked it will not be, and
      // flagging it would block a file the tool is about to clean for itself;
      // unticked, R refuses it — so the screen has to refuse it first, or the
      // user gets a green tick and then a hard stop at the end of the run.
      const keepBlanks = !$("c_dropmiss") || !$("c_dropmiss").checked;
      const out = [];
      const src = MASTER || DATA.rows;
      // Per-ROLE range rules. Only some roles have one, and that is deliberate: YCOUNT is
      // "Event count, rate, or level", and a negative or fractional value there selects
      // the linear branch rather than being an error, so a range rule would refuse the
      // design's own documented input. DENOM has none either — R drops a non-positive
      // denominator per PERIOD, after aggregation, so a rule on raw rows would refuse a
      // file whose zero-denominator patient rows aggregate to a positive period total.
      spec.roles.filter((r) => NUM_RULES[r.k] && MAP[r.k]).forEach((r) => {
        const col = MAP[r.k], rule = NUM_RULES[r.k], eg = [];
        const pcol = rule.pair && MAP[rule.pair] ? MAP[rule.pair] : "";
        for (let i = 0; i < src.length && eg.length < 4; i++) {
          const v = src[i][col];
          if (isBlank(v)) { if (keepBlanks && eg.indexOf("(blank)") < 0) eg.push("(blank)"); continue; }
          const n = typeof v === "number" ? v : Number(String(v).trim().replace(/,/g, ""));
          // The paired value goes through toBin as well as Number, because the roles that
          // pair here are the 0/1 ones and "Y" is a perfectly ordinary way to write 1.
          let p = NaN;
          if (pcol) { const pv = src[i][pcol]; if (!isBlank(pv)) { const b = toBin(pv); p = b == null ? Number(String(pv).trim().replace(/,/g, "")) : b; } }
          if (!isFinite(n) || rule.bad(n, p)) { const s = String(v).trim(); if (eg.indexOf(s) < 0) eg.push(s); }
        }
        if (eg.length) out.push({ label: r.label, col: col, why: rule.why, fix: rule.fix, eg: eg });
      });
      // The comma is NOT a per-role rule. It is a property of the column, and it applies
      // to every value this tool will hand to Number(): all six numeric roles and every
      // ticked covariate, which go through the identical strip in buildMaster and in
      // classifyCov. Running it inside the NUM_RULES loop above meant it fired only for
      // the two roles that happened to have a range rule — both SCCS — so a German ITS or
      // ACNU export was coerced silently while the evidence to refuse it was already
      // sitting in RAWTXT, computed for every column at ingest.
      //
      // Read from the text captured at ingest, never from DATA.rows. Which container
      // loses the comma is not the point (a CSV is coerced to 305 while a text-celled
      // XLSX keeps "30,5"); the point is that RAWTXT covers both, and stays empty for a
      // well-formed numeric XLSX with a de-DE display format, so a correct file is not
      // falsely refused.
      const commaCols = {};
      const noteCol = (col, label) => { if (!col) return; (commaCols[col] = commaCols[col] || []).push(label); };
      spec.roles.forEach((r) => { if (NUM_ROLES.indexOf(r.k) >= 0) noteCol(MAP[r.k], r.label); });
      // Marked so the message can say "is ticked as a baseline covariate" rather than
      // "is mapped to a baseline covariate": a covariate is not a role and reads wrong.
      if (spec.covariates) COVS.forEach((c) => { if (!commaCols[c]) commaCols[c] = { cov: true }; });
      Object.keys(commaCols).forEach((col) => {
        const ct = RAWTXT[col]; if (!ct) return;
        const isCov = !Array.isArray(commaCols[col]);
        const label = isCov ? "" : commaCols[col].join(" / ");
        if (ct.dec.length) out.push({ label: label, col: col, eg: ct.dec, cov: isCov,
          why: "holds value(s) that use a comma as a decimal point",
          fix: "The comma is removed rather than read, so 60,5 becomes 605 and 1.234,56 becomes 1.23456 — the first ten times too large, the second a thousand times too small, and both still numbers, so nothing further down refuses them. Where every value is scaled by the same amount some estimates survive it and some do not; where the number of decimal places varies from row to row, which is the ordinary case, the scaling varies with it and moves the estimate itself. Re-export the file with a decimal point." });
        if (ct.odd.length) out.push({ label: label, col: col, eg: ct.odd, cov: isCov,
          why: "holds value(s) containing a comma that is neither a decimal point nor a thousands separator this tool recognises",
          fix: "This tool reads 1,234 and 12,345,678 and 1,23,456 as grouped whole numbers and 60,5 as a decimal comma. A value outside both conventions is not guessed at, because every guess available here changes the number by a factor of ten or more. Re-export the column as plain digits with a decimal point and no grouping." });
      });
      return out;
    }

    function buildMaster() {
      const spec = SPEC[getDesign()]; if (!spec || !validateMap()) return;
      const roleCol = {}; spec.roles.forEach((r) => { if (MAP[r.k]) roleCol[r.k] = MAP[r.k]; });
      let rows = DATA.rows.map((r) => Object.assign({}, r));
      if ($("c_trim").checked) rows.forEach((r) => DATA.columns.forEach((c) => { if (typeof r[c] === "string") r[c] = r[c].trim(); }));
      if ($("c_dates").checked) {
        const dcols = (STRUCT.dateCols || []).map((d) => d.col).filter((c) => DATA.columns.indexOf(c) >= 0);
        rows.forEach((r) => dcols.forEach((c) => { r[c] = toISO(r[c], STRUCT.dayFirst); }));
      }
      if ($("c_std").checked) rows.forEach((r) => {
        BIN_ROLES.forEach((rk) => { if (roleCol[rk]) { const b = toBin(r[roleCol[rk]]); if (b != null) r[roleCol[rk]] = b; } });
      });
      const numCols = NUM_ROLES.map((k) => roleCol[k]).filter(Boolean).concat(spec.covariates ? COVS : []);
      // The blank guard here used to test the ORIGINAL value while the number was
      // computed from a value already replaced by "". Number("") is 0, and
      // String(null) is "null", which is not "" — so the guard waved it through and
      // every missing cell in a numeric role became a hard zero. On the cohort demo
      // that gave 35 patients an age of exactly 0; a missing follow-up time would
      // become 0 days and a missing denominator 0. Nothing downstream could see it:
      // complete.cases in R has nothing left to drop, so the "Drop rows missing a
      // required mapped variable" box silently did nothing and the run reported the
      // full cohort. A blank must stay blank and be dropped, or be refused by name.
      rows.forEach((r) => numCols.forEach((c) => {
        if (r[c] == null) return;
        const s = String(r[c]).trim();
        if (s === "") return;
        const n = Number(s.replace(/,/g, ""));
        if (!isNaN(n)) r[c] = n;
      }));
      const before = rows.length;
      // A row is only ever a "duplicate" where each person is meant to appear once —
      // the ACNU cohort. In a self-controlled series a row IS a unit of person-time and
      // in a case-crossover it is a window, so two identical rows are two real records
      // that add; dropping one halves a denominator. An interrupted time series
      // aggregates rows into periods, so an identical row there is another event in the
      // same period. None of the three carries a unique key, so the tool cannot tell an
      // accidental repeat from a legitimate one and must not guess. renderDupUI already
      // applies exactly this rule to duplicate IDs — it was never applied to the more
      // destructive control beside it, which is checked by default.
      let keptDup = 0;
      if (dedupeAllowed()) { const seen = new Set(); rows = rows.filter((r) => { const k = DATA.columns.map((c) => String(r[c] == null ? "" : r[c])).join("|"); if (seen.has(k)) return false; seen.add(k); return true; }); }
      // Duplicate patients/cases — ACNU (one-row-per-person cohort) only.
      const dupId = $("dup_id").value, dupStrat = $("dup_strategy").value;
      if (spec.onePerPerson && dupId && dupStrat !== "all") {
        const dcol = $("dup_date").value, groups = new Map();
        rows.forEach((r, i) => { const k = String(r[dupId] == null ? "" : r[dupId]).trim(); if (k === "") return; if (!groups.has(k)) groups.set(k, []); groups.get(k).push(i); });
        const drop = new Set();
        groups.forEach((idxs) => {
          if (idxs.length < 2) return;
          let keep;
          if (dupStrat === "last") keep = idxs[idxs.length - 1];
          else if (dupStrat === "earliest" || dupStrat === "latest") {
            const wd = idxs.map((i) => ({ i, t: dcol ? Date.parse(String(rows[i][dcol])) : NaN }));
            wd.sort((a, b) => (isNaN(a.t) ? Infinity : a.t) - (isNaN(b.t) ? Infinity : b.t));
            keep = dupStrat === "earliest" ? wd[0].i : wd[wd.length - 1].i;
          } else keep = idxs[0];
          idxs.forEach((i) => { if (i !== keep) drop.add(i); });
        });
        rows = rows.filter((r, i) => !drop.has(i));
      }
      if ($("c_dropmiss").checked) { const req = spec.roles.filter((r) => r.req).map((r) => roleCol[r.k]).filter(Boolean).concat(spec.covariates ? COVS : []); rows = rows.filter((r) => req.every((c) => r[c] != null && String(r[c]).trim() !== "")); }
      // Counted only once every filter has run, so this describes the master file that
      // was actually built rather than an intermediate one that no longer exists.
      if (!dedupeAllowed()) { const seen = new Set(); rows.forEach((r) => { const k = DATA.columns.map((c) => String(r[c] == null ? "" : r[c])).join("|"); if (seen.has(k)) keptDup++; else seen.add(k); }); }
      MASTER = rows;
      $("cleaninfo").textContent = "Master file: " + rows.length + " rows (from " + before + "; " + (before - rows.length) + " removed)." +
        (keptDup ? " " + keptDup + " row(s) are identical to an earlier row and were KEPT — here that is " + rowUnit() + ", not a duplicate." : "");
      // Restore the neutral class: invalidateMaster may have turned this amber.
      $("cleaninfo").className = "text-xs text-slate-600";
      $("anacard").classList.remove("hidden"); $("expcard").classList.remove("hidden");
    }

    // The master file is a SNAPSHOT: buildMaster bakes the mapping, the cleaning
    // ticks and — through toBin — the "which value means yes" vocabulary into
    // MASTER, and runanalysis rebuilds only when MASTER is null. Nothing used to
    // invalidate it, and the coding vocabulary lives in a different card from the
    // Build button, so the most consequential switch on the page could be changed
    // with no effect at all: flipping which value of drug_taken means yes, after
    // building, kept shipping the OLD encoding and the case-crossover reported
    // 2.55 where the answer the user had just asked for was 0.39 — a protective
    // drug reported as harmful, across the null, with nothing on screen different
    // between the two states. Anything that can change what buildMaster would
    // produce must come through here.
    // Everything on screen that was computed from a master file. Hiding the CARD that
    // contains them is not enough: buildMaster un-hides the card, and its children keep
    // whatever class they had, so the previous run's estimates and Table 1 come back with
    // it — under a line naming the new file and its row count. Declared as a function so
    // it can be called from setData, which runs before this point in source order.
    function hideResults() {
      ["anaresults", "table1", "routput", "itschart", "dlfitted", "pscresults", "psdiag", "expcard"]
        .forEach((id) => { const e = $(id); if (e) e.classList.add("hidden"); });
      const st = $("anastatus"); if (st) st.textContent = "";
    }
    function invalidateMaster() {
      if (MASTER === null && LAST === null) return;
      MASTER = null; LAST = null;
      const ci = $("cleaninfo");
      if (ci) { ci.textContent = "Out of date — a setting changed since this was built. Press “Build master file” again (Run analysis rebuilds it too), so the analysis uses what is on screen now."; ci.className = "text-xs text-amber-700 font-semibold"; }
      // The results on screen were computed from the master file just discarded.
      // The exports go with them: every download button falls back to rebuilding
      // from a null MASTER, which would have shipped an R script describing rows
      // that are no longer being dropped alongside an empty data file.
      hideResults();
    }

    // What kind of variable is this, really? A covariate that is text must not be
    // coerced to a number — that is how a variable vanishes from a model without
    // anyone noticing. Anything that cannot be used is named, never dropped quietly.
    // What actually breaks a categorical covariate is sparsity, not the number of
    // categories: a level with a handful of rows behind it, or none of the events,
    // is what makes a propensity model fail to converge or produce a wild
    // coefficient. So judge on rows-per-level and events-per-level, offer the
    // remedy (fold rare levels into "other"), and only refuse when even that
    // cannot save it. A 26-site hospital variable is legitimate; a 600-level free
    // text field is not, and the difference is not a round number of categories.
    const COV_MIN_PER_LEVEL = 10;        // rows behind a level, below which it is "rare"
    const COV_MIN_EVENTS_PER_LEVEL = 5;  // events behind a level, below which it is fragile
    const covOpts = () => ({ collapse: !$("cov_collapse") || $("cov_collapse").checked, minPer: COV_MIN_PER_LEVEL });
    function classifyCov(src, rows, o) {
      o = o || covOpts();
      const nonNull = rows.map((r) => r[src]).filter((v) => !isBlank(v));
      if (!nonNull.length) return { kind: "unusable", why: "every value is missing" };
      const asNum = (v) => (v instanceof Date ? NaN : Number(String(v).replace(/,/g, "")));
      const allNum = nonNull.every((v) => typeof v === "number" || (typeof v === "string" && v.trim() !== "" && !isNaN(asNum(v))));
      if (allNum) {
        const set = new Set(nonNull.map(asNum));
        if (set.size < 2) return { kind: "unusable", why: "constant — it carries no information" };
        if (set.size === 2 && [...set].every((x) => x === 0 || x === 1)) return { kind: "binary", yes: "1" };
        return { kind: "numeric" };
      }
      const counts = {};
      nonNull.forEach((v) => { const k = String(v).trim(); counts[k] = (counts[k] || 0) + 1; });
      const levels = Object.keys(counts);
      if (levels.length < 2) return { kind: "unusable", why: "constant — it carries no information" };
      if (levels.length === nonNull.length) return { kind: "unusable", why: "every row has a different value — this is an identifier or free text, not a category" };
      if (levels.length === 2) {
        const ym = yesMap(), a = levels[0].toLowerCase(), b = levels[1].toLowerCase();
        if (a in ym && b in ym && ym[a] !== ym[b]) return { kind: "binary", yes: ym[a] === 1 ? levels[0] : levels[1] };
      }
      const rare = levels.filter((l) => counts[l] < o.minPer);
      const effective = o.collapse ? (levels.length - rare.length + (rare.length ? 1 : 0)) : levels.length;
      const room = Math.floor(nonNull.length / o.minPer);
      if (effective > room) {
        return { kind: "unusable", why: levels.length + " categories across " + nonNull.length + " rows leaves fewer than " + o.minPer +
          " rows per category" + (o.collapse && rare.length ? " even after folding the rare ones together" : "") +
          " — group them into broader categories first" + (o.collapse ? "" : ", or tick “fold rare categories”") };
      }
      return { kind: "factor", levels: levels.length, counts: counts, rare: rare, effective: effective, collapsed: o.collapse && rare.length > 0 };
    }
    function covPlan(rows, o) {
      o = o || covOpts();
      const info = [], dropped = [];
      const evCol = MAP.EVENT && DATA.columns.indexOf(MAP.EVENT) >= 0 ? MAP.EVENT : "";
      let i = 0;
      COVS.forEach((src) => {
        const cls = classifyCov(src, rows, o);
        if (cls.kind === "unusable") { dropped.push({ src: src, why: cls.why }); return; }
        i++;
        const rec = { col: "COV" + i, src: src, kind: cls.kind, yes: cls.yes, levels: cls.levels,
          rare: cls.rare || [], collapsed: !!cls.collapsed, effective: cls.effective,
          label: cls.kind === "binary" && cls.yes !== "1" ? src + " = " + cls.yes : src };
        // Too few events behind a level is a warning, not a refusal — it is a rule
        // of thumb, and the investigator may have good reason to keep the split.
        if (cls.kind === "factor" && evCol) {
          const evByLvl = {};
          rows.forEach((r) => {
            if (isBlank(r[src])) return;
            let l = String(r[src]).trim();
            if (rec.collapsed && rec.rare.indexOf(l) >= 0) l = "other";
            const b = toBin(r[evCol]);
            evByLvl[l] = (evByLvl[l] || 0) + (b === 1 ? 1 : 0);
          });
          const thin = Object.keys(evByLvl).filter((l) => evByLvl[l] < COV_MIN_EVENTS_PER_LEVEL);
          if (thin.length) rec.thinEvents = thin;
        }
        info.push(rec);
      });
      return { info: info, dropped: dropped };
    }
    function analysisCSV() {
      const spec = SPEC[getDesign()]; const outCols = [], colFor = {}, tx = {};
      spec.roles.forEach((r) => { if (MAP[r.k]) { outCols.push(r.k); colFor[r.k] = MAP[r.k]; } });
      const plan = spec.covariates ? covPlan(MASTER || DATA.rows) : { info: [], dropped: [] };
      plan.info.forEach((c) => {
        outCols.push(c.col); colFor[c.col] = c.src;
        if (c.kind === "binary") tx[c.col] = (v) => (isBlank(v) ? null : toBin(v));   // ship 0/1, not "有"
        else if (c.collapsed) { const rare = new Set(c.rare); tx[c.col] = (v) => (isBlank(v) ? null : (rare.has(String(v).trim()) ? "other" : String(v).trim())); }
      });
      const rows = (MASTER || []).map((r) => { const o = {}; outCols.forEach((cn) => { const v = r[colFor[cn]]; o[cn] = tx[cn] ? tx[cn](v) : v; }); return o; });
      return { csv: toCSV(outCols, rows), covNames: plan.info.map((c) => c.col), covInfo: plan.info, covDropped: plan.dropped };
    }
    function acnuOpts() {
      const methods = [];
      if ($("m_match").checked) methods.push("matching");
      if ($("m_iptw").checked) methods.push("iptw");
      if ($("m_smrw").checked) methods.push("smrw");
      if ($("m_overlap").checked) methods.push("overlap");
      if ($("m_fine").checked) methods.push("finestrat");
      const estimands = [];
      if ($("est_itt").checked) estimands.push("ITT");
      if ($("est_pp").checked) estimands.push("PP");
      return { methods: methods, estimands: estimands.length ? estimands : ["ITT"], ratio: parseInt($("m_ratio").value) || 2, nstrata: parseInt($("m_nstrata").value) || 10, trim: $("m_trim").value, wts: $("m_wts").value, trunc: $("m_trunc").value };
    }
    // A number input accepts "1e3": it is a valid HTML floating-point number, above
    // the min and on the step, so nothing on screen marks it invalid — and
    // parseInt("1e3") is 1. With a cycle of 1 the harmonic terms become sin(2*pi*t)
    // and cos(2*pi*t), which for whole t are floating-point noise and a constant:
    // R drops the constant and fits the noise, giving a seasonal coefficient of
    // 4e12, a near-singular design that makes the HAC sandwich throw, and an
    // effect estimate that moves. Nothing said the cycle was 1. So read it the way
    // the day counts in the protocol builders are read: a number, or a refusal.
    function itsCycle() {
      const raw = $("its_cycle").value.trim();
      if (raw === "") return { ok: false, raw: raw, n: 12, why: "was left blank" };
      const n = Number(raw);
      if (!isFinite(n)) return { ok: false, raw: raw, n: 12, why: "could not be read as a number of periods" };
      if (n !== Math.round(n)) return { ok: false, raw: raw, n: 12, why: "is not a whole number of periods" };
      if (n < 2) return { ok: false, raw: raw, n: 12, why: "must be at least 2 — a cycle of " + n + " is not a cycle" };
      return { ok: true, raw: raw, n: n };
    }
    function itsOpts() {
      return { cut: $("its_cut").value.trim(), unit: $("its_unit").value, comb: $("its_comb").value, model: $("its_model").value, season: $("its_season").value, cycle: itsCycle().n, ac: $("its_ac").value, order: $("its_order").value, denomcomb: $("its_denomcomb").value };
    }
    function buildScript() {
      const spec = SPEC[getDesign()]; const { covNames, covInfo, covDropped } = analysisCSV();
      if (getDesign() === "acnu") {
        const ready = pscReady();
        const o = acnuOpts();
        // Snapshot what was actually fitted. The handoff must describe the run,
        // not whatever the controls happen to say when the download is clicked.
        PSCRUN = ready ? { C: ready.C.map((c) => c.src), U: ready.U.map((c) => c.src), boot: ready.boot, valType: ready.valType, estimands: o.estimands, methods: o.methods } : null;
        const psc = ready ? { C: ready.C.map((c) => ({ col: c.col, src: c.src })), U: ready.U.map((c) => ({ col: c.col, src: c.src })), boot: ready.boot, valType: ready.valType } : null;
        return spec.rscript(covInfo, Object.assign(o, { dropped: covDropped, psc: psc }));
      }
      if (getDesign() === "its") return spec.rscript(covNames, itsOpts());
      return spec.rscript(covNames);
    }
    ["its_cut", "its_unit", "its_comb", "its_model", "its_season", "its_cycle", "its_ac", "its_order", "its_denomcomb"].forEach((id) => $(id).addEventListener("input", () => { if (getDesign() === "its") validateMap(); }));

    $("applyclean").addEventListener("click", buildMaster);
    document.querySelectorAll('[name="design"]').forEach((r) => r.addEventListener("change", () => { MAP = {}; COVS = []; COVROLE = {}; MASTER = null; LAST = null; $("anacard").classList.add("hidden"); hideResults(); renderMap(); }));

    // The core ITS figure: observed points, the fitted pre/post segments, and the
    // pre-trend extrapolated forward as the counterfactual.
    const SERIES_COLOR = ["#0e7490", "#b45309", "#4338ca"];
    function fittedRows(rows) {
      const head = rows[0].map((h) => String(h).toLowerCase());
      const ix = (n) => head.indexOf(n);
      const iS = ix("series"), iP = ix("period"), iT = ix("t"), iO = ix("observed"), iD = ix("denominator"), iF = ix("fitted"), iC = ix("counterfactual");
      return rows.slice(1).map((r) => ({ s: r[iS], p: r[iP], t: Number(r[iT]), o: Number(r[iO]), d: r[iD] === "" || r[iD] == null ? null : Number(r[iD]), f: Number(r[iF]), c: Number(r[iC]) }))
        .filter((r) => isFinite(r.t) && isFinite(r.o));
    }
    function renderITSChart(rows, meta) {
      const data = fittedRows(rows);
      if (data.length < 2) return;
      const hasD = data.every((r) => r.d != null && isFinite(r.d) && r.d > 0);
      const v = (r, k) => (hasD ? (r[k] / r.d) * 1000 : r[k]);
      const t0 = parseInt(meta.t0) || 0;
      const W = 760, H = 320, ml = 56, mr = 14, mt = 14, mb = 40;
      const ts = data.map((r) => r.t), all = [];
      data.forEach((r) => { all.push(v(r, "o"), v(r, "f"), v(r, "c")); });
      const finite = all.filter((x) => isFinite(x));
      const tmin = Math.min(...ts), tmax = Math.max(...ts);
      let ymin = Math.min(0, Math.min(...finite)), ymax = Math.max(...finite);
      if (!(ymax > ymin)) ymax = ymin + 1;
      const pad = (ymax - ymin) * 0.08; ymax += pad;
      const X = (t) => ml + ((t - tmin) / Math.max(1, tmax - tmin)) * (W - ml - mr);
      const Y = (y) => H - mb - ((y - ymin) / (ymax - ymin)) * (H - mt - mb);
      const seriesNames = [];
      data.forEach((r) => { if (seriesNames.indexOf(r.s) < 0) seriesNames.push(r.s); });
      let g = "";
      // axes + gridlines
      for (let i = 0; i <= 4; i++) {
        const y = ymin + ((ymax - ymin) * i) / 4;
        g += '<line x1="' + ml + '" y1="' + Y(y).toFixed(1) + '" x2="' + (W - mr) + '" y2="' + Y(y).toFixed(1) + '" stroke="#e2e8f0" stroke-width="1"/>';
        g += '<text x="' + (ml - 6) + '" y="' + (Y(y) + 3.5).toFixed(1) + '" font-size="10" fill="#64748b" text-anchor="end">' + (Math.abs(y) >= 100 ? y.toFixed(0) : y.toFixed(2)) + "</text>";
      }
      g += '<line x1="' + ml + '" y1="' + (H - mb) + '" x2="' + (W - mr) + '" y2="' + (H - mb) + '" stroke="#94a3b8" stroke-width="1"/>';
      // interruption
      if (t0 > tmin) {
        const xc = X(t0 - 0.5);
        g += '<line x1="' + xc.toFixed(1) + '" y1="' + mt + '" x2="' + xc.toFixed(1) + '" y2="' + (H - mb) + '" stroke="#dc2626" stroke-width="1.5" stroke-dasharray="5 3"/>';
        g += '<text x="' + (xc + 4).toFixed(1) + '" y="' + (mt + 11) + '" font-size="10" fill="#dc2626" font-weight="600">interruption' + (meta.cutlabel ? " · " + esc(meta.cutlabel) : "") + "</text>";
      }
      seriesNames.forEach((sn, si) => {
        const col = SERIES_COLOR[si % SERIES_COLOR.length];
        const rs = data.filter((r) => r.s === sn).sort((a, b) => a.t - b.t);
        const path = (arr, key) => arr.map((r, i) => (i ? "L" : "M") + X(r.t).toFixed(1) + " " + Y(v(r, key)).toFixed(1)).join(" ");
        const pre = rs.filter((r) => r.t < t0), post = rs.filter((r) => r.t >= t0);
        if (pre.length > 1) g += '<path d="' + path(pre, "f") + '" fill="none" stroke="' + col + '" stroke-width="2"/>';
        if (post.length > 1) g += '<path d="' + path(post, "f") + '" fill="none" stroke="' + col + '" stroke-width="2"/>';
        if (post.length > 1) g += '<path d="' + path(post, "c") + '" fill="none" stroke="' + col + '" stroke-width="1.6" stroke-dasharray="6 4" opacity="0.75"/>';
        rs.forEach((r) => { g += '<circle cx="' + X(r.t).toFixed(1) + '" cy="' + Y(v(r, "o")).toFixed(1) + '" r="2.6" fill="' + col + '" opacity="0.55"/>'; });
        g += '<text x="' + (ml + 4 + si * 190) + '" y="' + (H - 8) + '" font-size="10" fill="' + col + '" font-weight="600">' + esc(sn) + "</text>";
      });
      // x ticks: about six evenly spaced periods, always including the first, the
      // last, and the interruption — a long series with only two labels is unreadable.
      const lab = (t) => { const r = data.find((x) => x.t === t); return r ? r.p : String(t); };
      const span = tmax - tmin;
      const want = Math.min(6, span + 1);
      const ticks = [];
      for (let i = 0; i < want; i++) ticks.push(tmin + Math.round((span * i) / Math.max(1, want - 1)));
      if (t0 > tmin && t0 <= tmax) ticks.push(t0);
      const uniq = Array.from(new Set(ticks)).sort((a, b) => a - b);
      // drop labels that would collide (~64px of room per label)
      const kept = [];
      uniq.forEach((t) => { if (!kept.length || X(t) - X(kept[kept.length - 1]) >= 64 || t === tmax) kept.push(t); });
      if (kept.length > 1 && X(kept[kept.length - 1]) - X(kept[kept.length - 2]) < 64) kept.splice(kept.length - 2, 1);
      kept.forEach((t) => {
        const anchor = t === tmin ? "start" : (t === tmax ? "end" : "middle");
        g += '<line x1="' + X(t).toFixed(1) + '" y1="' + (H - mb) + '" x2="' + X(t).toFixed(1) + '" y2="' + (H - mb + 4) + '" stroke="#94a3b8" stroke-width="1"/>';
        g += '<text x="' + X(t).toFixed(1) + '" y="' + (H - mb + 15) + '" font-size="10" fill="' + (t === t0 ? "#dc2626" : "#64748b") + '" text-anchor="' + anchor + '">' + esc(lab(t)) + "</text>";
      });
      const ylab = hasD ? "rate per 1,000 denominator units" : "outcome per period";
      $("itschart").classList.remove("hidden");
      $("itschart").innerHTML =
        '<div class="text-xs uppercase tracking-widest text-brand-700 font-semibold mb-1">Observed series, fitted segments, and the counterfactual</div>' +
        '<p class="text-[11px] text-slate-500 mb-2">Points are the observed ' + ylab + "; the solid line is the fitted segmented model; the dashed line extrapolates the pre-intervention trend forward as the counterfactual.</p>" +
        '<svg viewBox="0 0 ' + W + " " + H + '" width="100%" style="max-width:' + W + 'px" role="img" aria-label="Interrupted time series chart">' + g + "</svg>";
    }

    // ── Positivity: the picture, then the numbers, then what to do ───────────
    // Every diagnostic here gets one plain sentence saying what it means and what
    // to do when it fails. A beginner should be able to act on it; a reviewer
    // should find the number they were going to ask for.
    function renderPsDiag(dg, hist, bal, psw) {
      const el = $("psdiag"); if (!el || !dg) return;
      const num = (k) => { const v = parseFloat(dg[k]); return isFinite(v) ? v : null; };
      const nT = num("nT"), nC = num("nC"), outT = num("outT"), outC = num("outC"), ntrim = num("ntrim");
      // One diagnostic per weighting scheme the user actually asked for, straight
      // from the R run. This panel used to report the IPTW weights whatever was
      // fitted, so an SMR-only run was told "IPTW withheld … the other estimators
      // are unaffected" about numbers belonging to an estimator that never ran.
      const schemes = (psw || []).filter((s) => s && s.z && s.z.length === 4);
      const dU = (dg.dU || "").split(",").map(Number), dS = (dg.dS || "").split(",").map(Number), dF = (dg.dF || "").split(",").map(Number);
      const unstable = dg.unstable === "1";
      const withheld = schemes.filter((s) => s.bad && s.gated);
      const hasIptw = schemes.some((s) => s.gated && /^IPTW/.test(s.label));
      let g = "";
      if (hist) {
        const W = 720, H = 190, ml = 40, mr = 10, mt = 12, mb = 34;
        const t = hist.t, c = hist.c, mx = Math.max(1, Math.max(...t, ...c));
        const bw = (W - ml - mr) / 20;
        const half = (H - mt - mb) / 2, mid = mt + half;
        for (let i = 0; i < 20; i++) {
          const x = ml + i * bw;
          g += '<rect x="' + (x + 1).toFixed(1) + '" y="' + (mid - (t[i] / mx) * half).toFixed(1) + '" width="' + (bw - 2).toFixed(1) + '" height="' + ((t[i] / mx) * half).toFixed(1) + '" fill="#0e7490" opacity="0.85"/>';
          g += '<rect x="' + (x + 1).toFixed(1) + '" y="' + mid.toFixed(1) + '" width="' + (bw - 2).toFixed(1) + '" height="' + ((c[i] / mx) * half).toFixed(1) + '" fill="#b45309" opacity="0.85"/>';
        }
        g += '<line x1="' + ml + '" y1="' + mid + '" x2="' + (W - mr) + '" y2="' + mid + '" stroke="#94a3b8" stroke-width="1"/>';
        [num("csLo"), num("csHi")].forEach((v) => { if (v == null) return; const x = ml + v * (W - ml - mr); g += '<line x1="' + x.toFixed(1) + '" y1="' + mt + '" x2="' + x.toFixed(1) + '" y2="' + (H - mb) + '" stroke="#dc2626" stroke-width="1.5" stroke-dasharray="5 3"/>'; });
        g += '<text x="' + (ml + 2) + '" y="' + (mt + 10) + '" font-size="10" fill="#0e7490" font-weight="600">exposure</text>';
        g += '<text x="' + (ml + 2) + '" y="' + (H - mb - 3) + '" font-size="10" fill="#b45309" font-weight="600">comparator</text>';
        [0, 0.25, 0.5, 0.75, 1].forEach((p) => { const x = ml + p * (W - ml - mr); g += '<text x="' + x.toFixed(1) + '" y="' + (H - mb + 14) + '" font-size="10" fill="#64748b" text-anchor="middle">' + p + "</text>"; });
        g += '<text x="' + (W / 2) + '" y="' + (H - 4) + '" font-size="10" fill="#64748b" text-anchor="middle">propensity score — the red lines mark where both arms have members</text>';
        g = '<svg viewBox="0 0 ' + W + " " + H + '" width="100%" style="max-width:' + W + 'px" role="img" aria-label="Propensity score distribution by arm">' + g + "</svg>";
      }
      const row = (ok, label, value, meaning) =>
        '<tr class="border-b border-slate-100 align-top"><td class="py-1.5 pr-3 whitespace-nowrap">' +
        '<span class="inline-block w-2 h-2 rounded-full ' + (ok === true ? "bg-emerald-500" : ok === false ? "bg-rose-500" : "bg-amber-400") + '"></span> ' + esc(label) + "</td>" +
        '<td class="py-1.5 pr-3 font-semibold text-slate-900 whitespace-nowrap">' + esc(value) + "</td>" +
        '<td class="py-1.5 text-[11px] text-slate-600">' + meaning + "</td></tr>";
      const rows = [];
      // One block per scheme, each judged on its own numbers.
      schemes.forEach((s) => {
        const ess = s.z[0], essPct = s.z[1], maxw = s.z[2], top1 = s.z[3];
        const soft = !s.gated;                                  // overlap: reported, never used to withhold
        rows.push('<tr class="border-t-2 border-slate-200"><td colspan="3" class="pt-2 pb-1 text-[11px] uppercase tracking-widest font-semibold ' +
          (s.bad && s.gated ? "text-rose-700" : "text-slate-500") + '">' + esc(s.label) + " weights" +
          (s.bad && s.gated ? " · estimate withheld" : "") + "</td></tr>");
        rows.push(row(essPct >= 50 ? true : (essPct >= 10 ? null : (soft ? null : false)),
          "Effective sample size", (isFinite(ess) ? ess.toFixed(0) : "—") + " of " + (nT + nC) + " (" + essPct.toFixed(0) + "%)",
          "Weighting spends precision. This is how many patients this weighted analysis is really worth. " +
          (essPct >= 50 ? "Comfortable."
            : essPct >= 10 ? "A substantial loss — the confidence interval is wider than the row count suggests."
            : soft ? "Overlap weights are bounded, so this is not weight collapse: it means <strong>few patients sit in the region where both treatments are genuinely plausible</strong>. The estimate is valid, but it is about that small group — say so when you report it."
            : "<strong>The weighted analysis is worth a small fraction of the cohort.</strong>")));
        rows.push(row(top1 <= 10 ? true : (top1 <= 25 ? null : (soft ? null : false)),
          "Weight concentration", "top 1% of patients hold " + top1.toFixed(1) + "% of the weight",
          "If a few patients hold most of the weight, the estimate is about them rather than about the cohort. " +
          (top1 > 25 && !soft ? "<strong>This is the failure mode that produces a confident hazard ratio from almost no data.</strong>" : "")));
        rows.push(row(maxw <= 20 ? true : (soft ? true : null), "Largest single weight", maxw.toFixed(1) + "×",
          soft ? "Overlap weights cannot exceed 1 by construction, which is why this scheme has no weight-explosion failure mode."
            : "One patient counted this many times. A weight above ~20 usually means a propensity score near 0 or 1 — someone who, by the model, should never have received the treatment they got."));
      });
      // The balance column belongs to whichever weights actually produced it. When
      // no weighted estimator was fitted there is no "after" column to judge, and
      // saying "weighting did its job" about nothing is worse than saying nothing.
      const balW = bal && bal.wlab ? bal.wlab : "";
      const mx2 = bal ? parseFloat(bal.mx2) : NaN;
      if (bal && isFinite(mx2) && balW) {
        const nbad = parseInt(bal.nbad);
        const balHeld = withheld.some((s) => s.label.toLowerCase().indexOf(balW.toLowerCase()) === 0);
        rows.push(row(mx2 <= 0.1 ? true : (mx2 <= 0.25 ? null : false),
          "Balance after " + balW, "largest |SMD| " + mx2.toFixed(3) + (nbad ? " · " + nbad + " covariate(s) > 0.1" : ""),
          "Standardised differences below 0.10 are the usual bar for saying the arms are comparable on a covariate. Before weighting the largest was " + (isFinite(parseFloat(bal.mx1)) ? parseFloat(bal.mx1).toFixed(3) : "—") +
          ". " + (mx2 > 0.1 ? "<strong>Weighting has not balanced everything</strong> — add the unbalanced covariates to the model, or use matching." : "Weighting did its job.") +
          (balHeld ? " <strong>Note that this is balance under weights whose estimate was withheld above</strong> — balanced covariates do not rescue weights a few patients dominate." : "")));
      } else if (bal && !balW) {
        rows.push(row(null, "Balance after weighting", "not computed",
          "No weighted estimator was selected, so there is no weighted balance column — the standardised differences in Table 1 are before adjustment. Balance after matching or after fine stratification is a separate table this tool does not build."));
      }
      // ── Section 1: overlap, on its own terms and BEFORE the weights ──
      // Stabilising and truncating fix arithmetic. They cannot invent a comparator
      // for a patient who has none, and a healthy weight profile must never be
      // allowed to read as an answer to that. So this verdict stands alone and is
      // never softened by what the weight table says.
      const outN = outT + outC, outPct = outN / Math.max(1, nT + nC) * 100;
      const okOverlap = outN === 0, mildOverlap = outPct < 5;
      const ovTone = okOverlap ? "border-emerald-300 bg-emerald-50 text-emerald-900" : (mildOverlap ? "border-amber-300 bg-amber-50 text-amber-900" : "border-rose-300 bg-rose-50 text-rose-900");
      let h = '<div class="flex flex-wrap items-baseline justify-between gap-2"><div class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Positivity &amp; overlap — can these arms be compared at all?</div>' +
        (withheld.length ? '<span class="text-[11px] font-bold text-rose-700">' + esc(withheld.map((s) => s.label).join(" · ")) + " withheld</span>" : "") + "</div>";
      h += '<p class="mt-1 text-[11px] text-slate-600">Two separate questions, in order. First: is there anyone to compare with? Second: are the weights that answer it stable? The first cannot be fixed by fixing the second.</p>';
      h += '<div class="mt-2 rounded-lg border px-3 py-2 text-xs ' + ovTone + '"><strong>1 · Common support</strong> — ' +
        (okOverlap
          ? "every patient has a counterpart in the other arm across the whole propensity range. Positivity is satisfied here."
          : "<strong>" + outN + " of " + (nT + nC) + " patients (" + outPct.toFixed(1) + "%) — " + outT + " exposed and " + outC + " comparator — lie outside the propensity range the other arm occupies.</strong> For them there is nobody to compare with, so the model is extrapolating rather than contrasting. " +
            "<span class='block mt-1'>Stabilising or truncating the weights will <em>not</em> repair this: they make the arithmetic behave, and a tidy weight profile below is not evidence that this is resolved. " +
            (ntrim
              ? "This is what is left <em>after</em> the restriction you applied — the boundary of the retained region, recounted on the patients actually analysed. Narrowing the eligibility criteria is the remaining route."
              : "The honest routes are to restrict to common support, or to narrow the eligibility criteria so the question is one the data can answer.") + "</span>") + "</div>";
      if (ntrim) h += '<p class="mt-1 text-[11px] text-amber-700">' + ntrim + " row(s) were removed before estimating (" + esc(dg.trim) + "). The estimates refer to the remaining patients.</p>";
      h += g ? '<div class="mt-2">' + g + "</div>" : "";
      // ── Section 2: weights ──
      h += '<div class="mt-3 text-xs font-semibold text-slate-800">2 · Weight stability <span class="font-normal text-slate-500">— ' +
        (schemes.length
          ? "one verdict per weighting scheme you selected" + (hasIptw ? "; the inverse-probability weights are " + (dg.wtmode === "stab" ? "stabilised" : "unstabilised") + (num("ntrunc") ? ", truncated at the " + esc(dg.trunc) : "") : "")
          : "no weighted estimator was selected, so there is nothing here to judge") + "</span></div>";
      if (!schemes.length) h += '<p class="mt-1 text-[11px] text-slate-500">Matching and fine stratification do not weight, so the weight diagnostics do not apply to them. Their own diagnostic is how many patients survived the matching or the stratification — reported beside each estimate above.</p>';
      // One refusal box per withheld scheme, each quoting its own numbers. The old
      // single box always said "IPTW" and always closed by certifying that "the
      // other estimators are unaffected" — which was exactly wrong when a second
      // weighted estimator was failing the same test.
      withheld.forEach((s) => {
        const essPct = s.z[1], top1 = s.z[3];
        const isIptw = /^IPTW/.test(s.label);
        const others = schemes.filter((x) => x !== s && !(x.bad && x.gated)).map((x) => x.label);
        h += '<div class="mt-1 rounded-lg border border-rose-300 bg-rose-50 px-3 py-2 text-xs text-rose-900"><strong>The ' + esc(s.label) + ' estimate was not reported.</strong> ' +
          (essPct < 10 ? "The effective sample size fell to " + essPct.toFixed(0) + "% of the cohort. " : "") + (top1 > 25 ? "The heaviest 1% of patients hold " + top1.toFixed(0) + "% of the weight. " : "") +
          "A weighted hazard ratio here would be an artefact of a few patients rather than an effect. " +
          (isIptw
            ? (dg.rescuable !== "1"
              ? "Truncation has already been applied and did not rescue it, which points at the overlap problem above rather than at the arithmetic — restrict to common support, or narrow the eligibility criteria."
              : (okOverlap
                ? "The arms do overlap, so this is an arithmetic problem: <strong>truncate at the 1st/99th percentile</strong> first, and restrict to common support only if that is not enough. Both controls are in step 3."
                : "<strong>Restrict to common support first</strong> — the overlap problem above is the likelier cause, and truncating would tidy these numbers without fixing it. Both controls are in step 3."))
            : "The truncation control in step 3 caps the inverse-probability weights only, so it will not move this scheme. " +
              (okOverlap
                ? "The arms do overlap, so the propensity model itself is producing the extreme weights — a sparser model, or restricting to common support, is the route out."
                : "<strong>Restrict to common support</strong> — the overlap problem above is the cause.")) +
          (others.length ? " " + esc(others.join(" and ")) + " passed the same test and " + (others.length > 1 ? "are" : "is") + " still shown." : "") + "</div>";
      });
      // What stabilisation actually bought, side by side. This comparison is about
      // the inverse-probability weights specifically, so it is shown only with them.
      if (hasIptw && dU.length === 4 && dS.length === 4) {
        const cell = (v, d) => '<td class="py-1 pr-3 text-right tabular-nums">' + (isFinite(v) ? v.toFixed(d) : "—") + "</td>";
        h += '<div class="mt-1 overflow-x-auto"><table class="w-full text-[11px] border-collapse"><thead><tr class="text-slate-500 border-b border-slate-200">' +
          '<th class="py-1 pr-3 text-left font-semibold">Inverse-probability weights</th><th class="py-1 pr-3 text-right font-semibold">Effective n</th><th class="py-1 pr-3 text-right font-semibold">% of cohort</th><th class="py-1 pr-3 text-right font-semibold">Largest weight</th><th class="py-1 pr-3 text-right font-semibold">Top 1% share</th></tr></thead><tbody>' +
          '<tr class="border-b border-slate-100"><td class="py-1 pr-3">Unstabilised</td>' + cell(dU[0], 0) + cell(dU[1], 1) + cell(dU[2], 1) + cell(dU[3], 1) + "</tr>" +
          '<tr class="border-b border-slate-100"><td class="py-1 pr-3">Stabilised</td>' + cell(dS[0], 0) + cell(dS[1], 1) + cell(dS[2], 1) + cell(dS[3], 1) + "</tr>" +
          (num("ntrunc") ? '<tr class="border-b border-slate-100 font-semibold"><td class="py-1 pr-3">Used (truncated ' + esc(dg.trunc) + ", " + num("ntrunc") + " capped)</td>" + cell(dF[0], 0) + cell(dF[1], 1) + cell(dF[2], 1) + cell(dF[3], 1) + "</tr>" : "") +
          "</tbody></table></div>";
        h += '<p class="mt-1 text-[11px] text-slate-500">Stabilising took the effective sample from ' + (isFinite(dU[1]) ? dU[1].toFixed(0) : "—") + "% to " + (isFinite(dS[1]) ? dS[1].toFixed(0) : "—") +
          "% of the cohort and the largest weight from " + (isFinite(dU[2]) ? dU[2].toFixed(0) : "—") + "× to " + (isFinite(dS[2]) ? dS[2].toFixed(0) : "—") + "×. It changes the estimand not at all — only the arithmetic.</p>";
      }
      h += '<div class="mt-1 overflow-x-auto"><table class="w-full text-xs border-collapse"><tbody>' + rows.join("") + "</tbody></table></div>";
      el.classList.remove("hidden");
      el.innerHTML = h;
    }

    // ── PS-calibration result: the formula, the verdict, and the handoff ──────
    // The release rule matches the ACNU protocol page exactly (S >= 90 releases,
    // 50-90 and below withhold), because the two pages have to agree about when
    // this correction may be used at all.
    const pscVerdict = (S) => (S == null || !isFinite(S)) ? "untested" : (S >= 90 ? "s-high" : (S >= 50 ? "s-mid" : "s-low"));
    const PSC_VERDICT_TEXT = {
      "s-high": ["Surrogacy supported", "emerald", "S ≥ 90%: almost all of the outcome information carried by the two scores is carried by the gold-standard score, which is what surrogacy asserts. The correction is released below, for use as a pre-specified sensitivity analysis — never as the primary result."],
      "s-mid": ["Partial surrogacy — correction withheld", "amber", "S between 50% and 90%. This is the region where calibration starts to hurt: published scenarios at this level lose much of the bias reduction, and it can move the estimate the wrong way. The correction factor is not released."],
      "s-low": ["Surrogacy absent — correction withheld", "rose", "S below 50%: the error-prone score carries most of the outcome information, the opposite of what the method requires. In Lunt's scenarios at this level calibration roughly doubled the error. The correction factor is not released."],
      "untested": ["Surrogacy could not be measured — correction withheld", "slate", "S needs outcomes and both scores to carry information. Without it there is no evidence the correction is safe to apply, so it is not released."],
    };
    function renderPsc(m) {
      const el = $("pscresults"); if (!el || !m) return;
      const num = (k) => { const v = parseFloat(m[k]); return isFinite(v) ? v : null; };
      const S = num("S"), v = pscVerdict(S), vt = PSC_VERDICT_TEXT[v];
      const released = v === "s-high";
      const f = (x, d) => (x == null ? "—" : x.toFixed(d == null ? 4 : d));
      const ci = (lo, hi, d) => (lo == null || hi == null) ? "" : " (95% CI " + f(lo, d) + " to " + f(hi, d) + ")";
      const tone = { emerald: "border-emerald-300 bg-emerald-50 text-emerald-900", amber: "border-amber-300 bg-amber-50 text-amber-900", rose: "border-rose-300 bg-rose-50 text-rose-900", slate: "border-slate-300 bg-slate-100 text-slate-700" }[vt[1]];
      const hr = (b) => { if (b == null) return "—"; const x = Math.exp(b); return (x >= 0.001 && x < 1000) ? x.toFixed(3) : x.toPrecision(3); };
      let h = '<div class="text-xs uppercase tracking-widest text-violet-800 font-semibold mb-2">Propensity-score calibration formula</div>';
      h += '<div class="rounded-lg bg-white border border-violet-200 px-3 py-2 font-mono text-sm text-slate-900">PS_gs = ' + f(num("a0")) + " + " + f(num("a1")) + " × PS_ep + " + f(num("a2")) + " × T</div>";
      h += '<p class="mt-1 text-[11px] text-slate-600">α₁ = ' + f(num("a1")) + " (SE " + f(num("a1se")) + ")" + ci(num("a1lo"), num("a1hi")) + " · α₂ = " + f(num("a2")) + " (SE " + f(num("a2se")) + ")" + ci(num("a2lo"), num("a2hi")) +
        " · R² = " + f(num("r2"), 3) + " · n = " + (m.n || "—") + " · " + (m.nC || "—") + " claims / " + (m.nU || "—") + " clinical-only covariates · both scores on the probability scale.</p>" +
        (num("a1lo") != null ? '<p class="text-[11px] text-slate-500">Use the bootstrap interval, not the standard error beside it: the SE from the calibration regression treats PS_ep as a fixed, known quantity when it was itself estimated, and its residual spread is structural rather than sampling noise. The bootstrap refits both scores in every replicate.</p>' : "");
      h += '<div class="mt-2 rounded-lg border px-3 py-2 text-xs ' + tone + '"><strong>' + esc(vt[0]) + "</strong> — S = " + (S == null ? "not computable" : S.toFixed(1) + "%") +
        " (PS_ep coefficient " + f(num("scoef")) + ", p = " + (num("sp") == null ? "—" : num("sp").toPrecision(3)) + ")<br><span class='opacity-90'>" + esc(vt[2]) + "</span></div>";
      if (released) {
        h += '<div class="mt-2 rounded-lg bg-white border border-violet-200 px-3 py-2 text-sm"><span class="text-slate-600 text-xs uppercase tracking-widest font-semibold">Correction a claims-only study applies</span><br>' +
          '<span class="font-mono">β_T(calibrated) = β_T(naive) − ' + f(num("ratio")) + " × β_PS(naive)</span>" +
          (num("rlo") != null ? '<span class="block text-[11px] text-slate-500">correction factor α₂/α₁ bootstrap 95% CI ' + f(num("rlo")) + " to " + f(num("rhi")) + ", " + (m.B || 0) + " replicates" + (Number(m.bfail) ? ", " + m.bfail + " failed" : "") + "</span>" : '<span class="block text-[11px] text-slate-500">no bootstrap interval — set replicates above</span>') + "</div>";
      } else {
        h += '<div class="mt-2 rounded-lg bg-white border border-slate-200 px-3 py-2 text-xs text-slate-600"><strong>The correction factor is withheld.</strong> α₂/α₁ was computed, but printing it here would invite exactly the use this page has just advised against. Fix surrogacy — a richer claims-available set, or a different validation population — or present this as a bias analysis rather than a point correction.</div>';
      }
      if (num("bT") != null) {
        // The same three numbers either way, but framed so a withheld correction
        // is not quietly re-served as "the calibrated HR".
        h += '<p class="mt-2 text-[11px] ' + (released ? "text-slate-600" : "text-rose-700") + '"><strong>Does the correction help on this data?</strong> ' +
          "Fitting the claims-only analogue here (treatment + PS_ep only) gives HR " + hr(num("bT")) +
          ", against a gold-standard fit (treatment + PS_gs) of HR " + hr(num("bG")) + ". " +
          (released
            ? "Applying the correction gives HR " + hr(num("bcal")) + "."
            : "Applying the correction anyway would give HR " + hr(num("bcal")) + " — further from the gold standard than doing nothing. That is what the withheld verdict is protecting you from.") +
          " A self-check on the validation data, not the study estimate.</p>";
      }
      h += '<p class="mt-2 text-[11px] text-slate-500">Still missing, and not obtainable here: <strong>β̂_T, its standard error, and β̂_PS</strong>. Those come from the claims-only study — a different dataset — and are typed into the protocol builder.</p>';
      h += '<div class="mt-2"><button id="dlpsc" type="button" class="bg-violet-700 text-white hover:bg-violet-800 font-semibold px-3 py-1.5 rounded text-xs">⬇ Calibration handoff (JSON)</button></div>';
      el.classList.remove("hidden");
      el.innerHTML = h;
      $("dlpsc").addEventListener("click", () => {
        const j = pscHandoff(m);
        dl(new Blob([JSON.stringify(j, null, 2)], { type: "application/json" }), DATA.name + "-psc-handoff.json");
      });
    }
    function pscHandoff(m) {
      const num = (k) => { const v = parseFloat(m[k]); return isFinite(v) ? v : null; };
      const S = num("S"), v = pscVerdict(S), ready = PSCRUN || pscReady();
      const valType = ready ? ready.valType : null;
      return {
        kind: "rwe-studio/psc-handoff", version: 1, generated: new Date().toISOString(),
        // valType appears in two places on purpose: the importer accepts either,
        // and a consumer reading only `dataset` should not miss it.
        dataset: { label: DATA.name, n: num("n"), events: num("ev"), valType: valType },
        claimsVars: (ready && ready.C) ? ready.C.map((c) => (typeof c === "string" ? c : c.src)) : [],
        clinicalVars: (ready && ready.U) ? ready.U.map((c) => (typeof c === "string" ? c : c.src)) : [],
        psScale: "ps",
        validationType: valType,
        calibration: { a0: num("a0"), a1: num("a1"), a1se: num("a1se"), a2: num("a2"), a2se: num("a2se"), r2: num("r2") },
        correctionFactor: { value: num("ratio"), lo: num("rlo"), hi: num("rhi"), bootstrapB: Number(m.B) || 0, bootstrapFailures: Number(m.bfail) || 0 },
        surrogacy: { S: S, coef: num("scoef"), p: num("sp"), verdict: v, testable: true },
        released: v === "s-high",
        naive: { bT: null, bTse: null, bPS: null },
        // Estimand and method travel with the coefficients: alpha2 is only
        // transportable to a study estimating the same thing the same way.
        provenance: {
          tool: "RWE Studio", engine: "WebR", design: "acnu", outcomeModel: "coxph",
          estimand: (ready && ready.estimands) ? ready.estimands.join("+") : null,
          psMethods: (ready && ready.methods) ? ready.methods : null,
          note: "beta_T, its SE and beta_PS belong to the claims-only study and are not computable from the validation data.",
        },
      };
    }

    $("runanalysis").addEventListener("click", async () => {
      if (!MASTER) buildMaster();
      if (!MASTER) return;
      const { csv } = analysisCSV(); const script = buildScript();
      const setS = (m) => { $("anastatus").textContent = m; };
      $("runanalysis").disabled = true; $("anaresults").classList.add("hidden"); $("table1").classList.add("hidden"); $("itschart").classList.add("hidden"); $("dlfitted").classList.add("hidden"); $("pscresults").classList.add("hidden"); $("psdiag").classList.add("hidden");
      try {
        const out = await window.RWEngine.run(script, csv, setS);
        setS("Done ✓");
        const ests = [], t1 = [], notes = [], fitted = [], psw = []; let meta = {}, psc = null, psdiag = null, psbal = null, pshist = null;
        out.split("\n").forEach((l) => {
          if (l.indexOf("RESULT_ESTIMATE|") === 0) { const p = l.split("|"); ests.push({ label: p[1], value: p.slice(2).join("|") }); }
          else if (l.indexOf("TABLE1|") === 0) { t1.push(l.split("|").slice(1)); }
          else if (l.indexOf("RESULT_NOTE|") === 0) { notes.push(l.split("|").slice(1).join("|")); }
          else if (l.indexOf("FITTED|") === 0) { fitted.push(l.split("|").slice(1)); }
          else if (l.indexOf("ITSMETA|") === 0) { l.split("|").slice(1).forEach((kv) => { const i = kv.indexOf("="); if (i > 0) meta[kv.slice(0, i)] = kv.slice(i + 1); }); }
          else if (l.indexOf("PSC|") === 0) { psc = {}; l.split("|").slice(1).forEach((kv) => { const i = kv.indexOf("="); if (i > 0) psc[kv.slice(0, i)] = kv.slice(i + 1); }); }
          else if (l.indexOf("PSDIAG|") === 0) { psdiag = {}; l.split("|").slice(1).forEach((kv) => { const i = kv.indexOf("="); if (i > 0) psdiag[kv.slice(0, i)] = kv.slice(i + 1); }); }
          else if (l.indexOf("PSBAL|") === 0) { psbal = {}; l.split("|").slice(1).forEach((kv) => { const i = kv.indexOf("="); if (i > 0) psbal[kv.slice(0, i)] = kv.slice(i + 1); }); }
          else if (l.indexOf("PSHIST|") === 0) { const p = l.split("|"); pshist = { t: p[1].split(",").map(Number), c: p[2].split(",").map(Number) }; }
          // PSW|<scheme label>|ess,pct,maxw,top1|<failed its own rule>|<failing withholds>
          else if (l.indexOf("PSW|") === 0) { const p = l.split("|"); psw.push({ label: p[1], z: (p[2] || "").split(",").map(Number), bad: p[3] === "1", gated: p[4] === "1" }); }
        });
        const display = out.replace(/^(RESULT_ESTIMATE|RESULT_NOTE|TABLE1|FITTED|ITSMETA|PSC|PSCSKIP|PSDIAG|PSBAL|PSHIST|PSW)\|.*$/gm, "").replace(/\n{3,}/g, "\n\n").trim();
        if (ests.length || notes.length) {
          $("anaresults").classList.remove("hidden");
          const noteHtml = notes.length ? '<div class="mt-3 space-y-1">' + notes.map((n) => '<p class="text-[11px] text-slate-600">' + esc(n) + "</p>").join("") + "</div>" : "";
          const tblHtml = ests.length ? '<div class="overflow-x-auto"><table class="w-full text-sm border-collapse"><thead><tr class="text-left text-slate-500 border-b border-slate-200"><th class="py-1.5 pr-4 font-semibold">Method / estimand</th><th class="py-1.5 font-semibold">Estimate (95% CI)</th></tr></thead><tbody>' + ests.map((e) => '<tr class="border-b border-slate-100"><td class="py-1.5 pr-4 text-slate-700">' + esc(e.label) + '</td><td class="py-1.5 font-bold text-slate-900">' + esc(e.value) + "</td></tr>").join("") + "</tbody></table></div>" : "";
          $("anaresults").innerHTML = '<div class="text-xs uppercase tracking-widest text-brand-700 font-semibold mb-2">Effect estimates</div>' + tblHtml + noteHtml;
        }
        if (fitted.length > 1) { renderITSChart(fitted, meta); $("dlfitted").classList.remove("hidden"); }
        if (psdiag) { try { renderPsDiag(psdiag, pshist, psbal, psw); } catch (e) { console.error(e); } }
        if (psc) { try { renderPsc(psc); } catch (e) { console.error(e); } }
        if (t1.length) {
          $("table1").classList.remove("hidden");
          const head = t1[0], body = t1.slice(1);
          $("table1").innerHTML = '<div class="text-xs uppercase tracking-widest text-brand-700 font-semibold mb-2">Patient characteristics (Table 1)</div><table class="w-full text-xs border-collapse"><thead><tr class="text-left text-slate-500 border-b border-slate-200">' + head.map((h) => '<th class="py-1.5 pr-4 font-semibold">' + esc(h) + "</th>").join("") + "</tr></thead><tbody>" + body.map((rr) => '<tr class="border-b border-slate-100">' + rr.map((c, i) => '<td class="py-1.5 pr-4 ' + (i === 0 ? "text-slate-700" : "text-slate-600") + '">' + esc(c) + "</td>").join("") + "</tr>").join("") + "</tbody></table>";
        }
        $("routput").classList.remove("hidden"); $("routput").textContent = display || "(no output)";
        LAST = { out: display, script: script, ests: ests, t1: t1, notes: notes, fitted: fitted, meta: meta };
      // LAST was assigned only on success and never cleared on failure, so after a
      // run that errored the screen correctly hid its results while the download
      // buttons stayed live and still emitted the PREVIOUS run's estimates.
      } catch (e) { LAST = null; setS("Error"); $("routput").classList.remove("hidden"); $("routput").textContent = "Error: " + (e && e.message ? e.message : e); }
      finally { $("runanalysis").disabled = false; }
    });

    const readQ = () => { const g = (n) => { const e = document.querySelector('[name="' + n + '"]'); return e ? e.value : ""; }; return { pop: g("q_pop"), exp: g("q_exp"), comp: g("q_comp"), out: g("q_out"), design: getDesign() }; };
    function buildReport(q) {
      const today = new Date().toISOString().slice(0, 10);
      const label = (SPEC[q.design] || {}).label || q.design || "(design)";
      const ests = (LAST && LAST.ests) || [], t1 = (LAST && LAST.t1) || [], notes = (LAST && LAST.notes) || [], fit = (LAST && LAST.fitted) || [];
      const resTbl = ests.length ? ("| Method / estimand | Estimate (95% CI) |\n|---|---|\n" + ests.map((e) => "| " + e.label + " | " + e.value + " |").join("\n")) : "(run the analysis first)";
      const t1Tbl = t1.length ? (t1.map((r, i) => "| " + r.join(" | ") + " |" + (i === 0 ? "\n|" + r.map(() => "---").join("|") + "|" : "")).join("\n")) : "";
      const fitTbl = fit.length > 1 ? (fit.map((r, i) => "| " + r.join(" | ") + " |" + (i === 0 ? "\n|" + r.map(() => "---").join("|") + "|" : "")).join("\n")) : "";
      return "# RWE Studio analysis report\n\n_Generated " + today + " · analysis run locally in the browser via WebR (real R)_\n\n" +
        "## Question\n- Population: " + (q.pop || "(specify)") + "\n- Exposure: " + (q.exp || "(specify)") + "\n- Comparator: " + (q.comp || "—") + "\n- Outcome: " + (q.out || "(specify)") + "\n- Design: " + label + "\n\n" +
        "## Effect estimates\n\n" + resTbl + "\n\n" +
        (notes.length ? "### How the model was fitted\n\n" + notes.map((n) => "- " + n).join("\n") + "\n\n" : "") +
        (t1.length ? "## Patient characteristics (Table 1)\n\n" + t1Tbl + "\n\n" : "") +
        (fitTbl ? "## Fitted series — observed vs counterfactual\n\n" + fitTbl + "\n\n" : "") +
        "## R output\n\n```\n" + (LAST ? LAST.out : "(run the analysis first)") + "\n```\n\n" +
        "## Reproducible R script\n\n```r\n" + (LAST ? LAST.script : buildScript()) + "\n```\n";
    }
    async function buildReportDocx(q) {
      const D = window.docx; if (!D) return null;
      const today = new Date().toISOString().slice(0, 10);
      const label = (SPEC[q.design] || {}).label || q.design || "(design)";
      const FONT = "Times New Roman";
      const text = (t, o = {}) => new D.TextRun({ text: String(t == null ? "" : t), font: FONT, size: 22, ...o });
      const p = (ch, o = {}) => new D.Paragraph({ children: Array.isArray(ch) ? ch : [ch], spacing: { before: 60, after: 60, ...(o.spacing || {}) }, ...o });
      const h1 = (t) => new D.Paragraph({ children: [text(t, { bold: true, size: 28 })], spacing: { before: 200, after: 80 }, heading: D.HeadingLevel.HEADING_1 });
      const mono = (l) => new D.Paragraph({ children: [new D.TextRun({ text: l, font: "Consolas", size: 16 })], spacing: { before: 0, after: 0 } });
      const brd = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" }; const cbr = { top: brd, bottom: brd, left: brd, right: brd };
      const tbl = (rows, hdr) => new D.Table({ width: { size: 9026, type: D.WidthType.DXA }, rows: rows.map((cells, ri) => new D.TableRow({ children: cells.map((c) => new D.TableCell({ borders: cbr, margins: { top: 60, bottom: 60, left: 100, right: 100 }, shading: (hdr && ri === 0) ? { fill: "F5F5F5", type: D.ShadingType.CLEAR } : undefined, children: [p([text(c, { bold: hdr && ri === 0 })])] })) })) });
      let logo = null; try { const rr = await fetch("/images/networks/phdc.png"); if (rr.ok) logo = new Uint8Array(await rr.arrayBuffer()); } catch (e) {}
      const ch = [];
      if (logo) ch.push(new D.Paragraph({ spacing: { after: 120 }, children: [new D.ImageRun({ data: logo, transformation: { width: 210, height: 51 } })] }));
      ch.push(p([text("RWE Studio analysis report", { bold: true, size: 32 })], { spacing: { after: 40 } }));
      ch.push(p([text("Generated " + today + " · analysis run locally in the browser via WebR (real R).", { italics: true, color: "777777", size: 18 })], { spacing: { after: 160 } }));
      ch.push(h1("Question"));
      ch.push(tbl([["Population", q.pop || "(specify)"], ["Exposure", q.exp || "(specify)"], ["Comparator", q.comp || "—"], ["Outcome", q.out || "(specify)"], ["Design", label]], false));
      const ests = (LAST && LAST.ests) || [], t1 = (LAST && LAST.t1) || [], notes = (LAST && LAST.notes) || [], fit = (LAST && LAST.fitted) || [];
      ch.push(h1("Effect estimates"));
      if (ests.length) ch.push(tbl([["Method / estimand", "Estimate (95% CI)"]].concat(ests.map((e) => [e.label, e.value])), true)); else ch.push(p([text("(run the analysis first)")]));
      notes.forEach((n) => ch.push(p([text(n, { size: 18, color: "555555" })])));
      if (t1.length) { ch.push(h1("Patient characteristics (Table 1)")); ch.push(tbl(t1, true)); }
      if (fit.length > 1) { ch.push(h1("Fitted series — observed vs counterfactual")); ch.push(tbl(fit, true)); }
      ch.push(h1("R output"));
      (LAST ? LAST.out : "(run the analysis first)").split("\n").forEach((l) => ch.push(mono(l)));
      ch.push(h1("Reproducible R script"));
      (LAST ? LAST.script : buildScript()).split("\n").forEach((l) => ch.push(mono(l)));
      const doc = new D.Document({ creator: "RWE Studio", title: "RWE Studio report", styles: { default: { document: { run: { font: FONT, size: 22 } } }, paragraphStyles: [{ id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 28, bold: true, font: FONT }, paragraph: { spacing: { before: 200, after: 80 }, outlineLevel: 0 } }] }, sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children: ch }] });
      return await D.Packer.toBlob(doc);
    }
    $("dlmaster2").addEventListener("click", () => { if (!MASTER) buildMaster(); if (MASTER) dl(new Blob(["﻿" + toCSV(DATA.columns, MASTER)], { type: "text/csv;charset=utf-8" }), DATA.name + "-master.csv"); });
    $("dlscript").addEventListener("click", () => { const s = LAST ? LAST.script : buildScript(); dl(new Blob(["# Analysis script generated by RWE Studio — reads the master file as data.csv\n# Reproduces the on-screen result in desktop R.\n\n" + s + "\n"], { type: "text/plain;charset=utf-8" }), DATA.name + "-analysis.R"); });
    $("dlfitted").addEventListener("click", () => {
      const f = LAST && LAST.fitted; if (!f || f.length < 2) return;
      dl(new Blob(["﻿" + f.map((r) => r.map(csvCell).join(",")).join("\n")], { type: "text/csv;charset=utf-8" }), DATA.name + "-fitted-series.csv");
    });
    $("dlreport").addEventListener("click", () => { dl(new Blob([buildReport(readQ())], { type: "text/markdown;charset=utf-8" }), DATA.name + "-report.md"); });
    $("dlreportword").addEventListener("click", async () => { const b = await buildReportDocx(readQ()); if (b) dl(b, DATA.name + "-report.docx"); });
  </script>
</BaseLayout>
