  <script src="https://unpkg.com/docx@8.5.0/build/index.umd.js" is:inline></script>
  <WebrEngine />

  <script is:inline>
    const $ = (id) => document.getElementById(id);
    const fileInput = $("file"), drop = $("drop");
    const setMsg = (t, bad) => { const el = $("msg"); el.textContent = t || ""; el.className = "mt-2 text-xs " + (bad ? "text-rose-600" : "text-slate-500"); };

    let DATA = { rows: [], columns: [], profile: [], name: "dataset" };
    // Everything discovered about the file's shape. Nothing here is assumed: each
    // field is inferred from the data (or the codebook) and can be overridden in
    // the "What this dataset looks like" panel.
    let WB = null;          // the parsed workbook, kept so the sheet can be re-picked
    let SHEETS = [];        // every sheet in the workbook, with a score and any flags
    let SPLITINFO = null;   // result of repairing a delimited dump, if that was asked for
    // Per column, the ORIGINAL text of cells whose comma this tool would silently
    // resolve. SheetJS coerces "14,0" to the number 140 while parsing, so by the time
    // DATA.rows exists the comma is gone and nothing downstream can see it. The text
    // survives on the cell as .w, which sheet_to_json exposes with raw:false; this is
    // the only place it can be captured. Empty for demo data and anything not read
    // from a workbook, which is correct — those never had a comma.
    let RAWTXT = {};
    let CODEBOOK = {};      // normalised column name → definition text
    let CBWB = null, CBNAME = "";
    let CBINFO = null;      // { name, matched, sheet }
    let STRUCT = { sheet: "", headerRow: 0, split: false, unit: "", unitConf: "low", idCol: "", idConf: "low", repeats: 0, repeatKind: "none", dateCols: [], dayFirst: false, vocabs: [], yes: {} };

    const loadScript = (src) => new Promise((res, rej) => {
      if (document.querySelector('script[src="' + src + '"]')) return res();
      const s = document.createElement("script"); s.src = src; s.onload = () => res(); s.onerror = () => rej(new Error("load " + src)); document.head.appendChild(s);
    });
    const XLSX_URL = "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js";
    async function readWorkbook(file) {
      await loadScript(XLSX_URL);
      return window.XLSX.read(await file.arrayBuffer(), { type: "array", cellDates: true });
    }
    const sheetAOA = (ws) => window.XLSX.utils.sheet_to_json(ws, { header: 1, blankrows: false, defval: null, raw: true });
    // The same sheet as displayed text rather than coerced values, so a decimal comma
    // can be seen before it is thrown away.
    const sheetAOAText = (ws) => window.XLSX.utils.sheet_to_json(ws, { header: 1, blankrows: false, defval: null, raw: false });
    // Grouping separators this tool reads correctly today and must keep reading: Western
    // 1,234 / 12,345,678 and Indian 1,23,456. Anything else carrying a comma is either a
    // decimal comma or unreadable, and both are refused rather than guessed at.
    const COMMA_GROUPED = (s) => /^[+-]?\d{1,3}(,\d{3})+(\.\d+)?$/.test(s) || /^[+-]?\d{1,2}(,\d{2})+(,\d{3})(\.\d+)?$/.test(s);
    const COMMA_DECIMAL = (s) => /^[+-]?\d+,\d+$/.test(s) || /^[+-]?\d{1,3}(\.\d{3})+,\d+$/.test(s);
    // A comma in a number means one of two incompatible things, and a single cell often
    // cannot say which: "1,234" is 1234 in Chicago and 1.234 in Berlin. The COLUMN can
    // say. Deciding per cell — which is what this did — is why "0,125" and "10,125" were
    // both read as grouped whole numbers and skipped entirely, a factor of a thousand,
    // in the one shape a European rate column always takes.
    //
    // So: gather the cells that can only be read one way, let them decide the column,
    // and classify the ambiguous cells against that decision.
    //
    // Only a decimal point: a comma group that is not exactly three digits ("60,5",
    // "1,2345"), a first group with a leading zero ("0,125" — no thousands grouping ever
    // starts with one), or the dot-grouped European form ("1.234,56").
    const DEC_ONLY = (s) => /^[+-]?\d+,\d{1,2}$/.test(s) || /^[+-]?\d+,\d{4,}$/.test(s) ||
                            /^[+-]?0\d*,\d+$/.test(s) || /^[+-]?\d{1,3}(\.\d{3})+,\d+$/.test(s);
    // Only a grouping separator: more than one comma group ("12,345,678", "1,23,456"), or
    // a comma group followed by a decimal POINT ("1,234.56") — one number cannot carry
    // both conventions at once.
    const GRP_ONLY = (s) => /^[+-]?\d{1,3}(,\d{3}){2,}(\.\d+)?$/.test(s) ||
                            /^[+-]?\d{1,2}(,\d{2})+(,\d{3})(\.\d+)?$/.test(s) ||
                            /^[+-]?\d{1,3}(,\d{3})+\.\d+$/.test(s);
    function commaExamples(cols, rows) {
      const out = {};
      cols.forEach((c) => {
        // Pass 1: what does this column prove about itself?
        let anyDec = false, anyGrp = false;
        for (let i = 0; i < rows.length; i++) {
          const v = rows[i][c]; if (v == null) continue;
          const s = String(v).trim(); if (s.indexOf(",") < 0) continue;
          if (DEC_ONLY(s)) anyDec = true; else if (GRP_ONLY(s)) anyGrp = true;
          if (anyDec && anyGrp) break;
        }
        // A column that proves BOTH conventions is not a column this tool can read at
        // all, and guessing either way changes some of its values by a factor of a
        // thousand. That is the "odd" bucket, which refuses rather than guessing.
        const contradictory = anyDec && anyGrp;
        // With no unambiguous cell either way, every comma here is a genuine coin flip.
        // Keep reading it as grouping, which is what this tool has always done and what
        // its message text promises — changing that would refuse ordinary US data.
        const dec = [], odd = [];
        for (let i = 0; i < rows.length && dec.length < 4 && odd.length < 4; i++) {
          const v = rows[i][c]; if (v == null) continue;
          const s = String(v).trim();
          if (s.indexOf(",") < 0) continue;
          let b = null;
          if (!COMMA_GROUPED(s) && !COMMA_DECIMAL(s)) b = odd;          // neither convention
          else if (contradictory) b = odd;
          else if (DEC_ONLY(s)) b = dec;
          else if (GRP_ONLY(s)) b = null;                                // grouped, read as before
          else if (anyDec) b = dec;                                      // ambiguous, in a decimal column
          else b = null;                                                 // ambiguous, read as grouping
          if (b && b.indexOf(s) < 0 && b.length < 4) b.push(s);
        }
        if (dec.length || odd.length) out[c] = { dec: dec, odd: odd };
      });
      return out;
    }

    // Which sheet holds the data? A workbook often carries notes, a pivot, or a
    // mangled export alongside the real table — picking sheet 1 blindly is how a
    // tool silently analyses the wrong thing.
    function scoreSheet(name, aoa) {
      const rows = aoa.length;
      const cols = aoa.reduce((m, r) => Math.max(m, r ? r.length : 0), 0);
      let cells = 0, filled = 0, tabby = 0, strs = 0;
      aoa.slice(0, 200).forEach((r) => (r || []).forEach((c) => { cells++; if (!isBlank(c)) { filled++; if (typeof c === "string") { strs++; if (c.indexOf("\t") >= 0) tabby++; } } }));
      const fill = cells ? filled / cells : 0;
      const notes = [];
      let score = cols * Math.log(1 + rows) * (0.4 + 0.6 * fill);
      const delim = strs > 0 && tabby / strs > 0.5;
      if (delim) notes.push("looks like a delimited text dump pasted into one column — the columns were never split");
      if (cols <= 1) { score *= 0.05; notes.push("only one column"); }
      else if (cols <= 2 && delim) score *= 0.05;
      if (rows <= 2) { score *= 0.2; notes.push("almost no rows"); }
      return { name: name, rows: rows, cols: cols, fill: fill, score: score, delim: delim, notes: notes };
    }
    // Repair for the case above: rebuild a table by splitting each row on the delimiter.
    function splitDelimited(aoa) {
      const lines = aoa.map((r) => (r || []).map((c) => (c == null ? "" : String(c))).join(""));
      const sep = lines.filter((l) => l.indexOf("\t") >= 0).length > lines.length / 2 ? "\t" : ",";
      const out = lines.map((l) => l.split(sep).map((s) => s.replace(/^"|"$/g, "")));
      const counts = {}; out.forEach((r) => { counts[r.length] = (counts[r.length] || 0) + 1; });
      const modal = Number(Object.entries(counts).sort((a, b) => b[1] - a[1])[0][0]);
      const ragged = out.filter((r) => r.length !== modal).length;
      return { aoa: out, modal: modal, ragged: ragged };
    }
    // The header is not always row 1 (title rows, blank spacers, merged banners).
    function detectHeaderRow(aoa) {
      let best = 0, bestScore = -1;
      for (let r = 0; r < Math.min(10, aoa.length - 1); r++) {
        const cells = (aoa[r] || []).filter((c) => !isBlank(c));
        if (cells.length < 2) continue;
        const width = (aoa[r] || []).length || 1;
        const strs = cells.filter((c) => typeof c === "string").length;
        const distinct = new Set(cells.map((c) => String(c).trim().toLowerCase())).size;
        const nextFilled = ((aoa[r + 1] || []).filter((c) => !isBlank(c)) || []).length;
        const sc = (cells.length / width) + (strs / cells.length) + (distinct === cells.length ? 0.6 : 0) + (nextFilled >= cells.length * 0.6 ? 0.6 : 0) - r * 0.05;
        if (sc > bestScore) { bestScore = sc; best = r; }
      }
      return best;
    }
    function tableFromAOA(aoa, headerRow) {
      const raw = aoa[headerRow] || [];
      const width = aoa.reduce((m, r) => Math.max(m, r ? r.length : 0), 0);
      const seen = {}, columns = [];
      for (let i = 0; i < width; i++) {
        let h = raw[i] == null ? "" : String(raw[i]).trim();
        if (!h) h = "column_" + (i + 1);
        if (seen[h]) { seen[h]++; h = h + "_" + seen[h]; } else seen[h] = 1;
        columns.push(h);
      }
      const body = aoa.slice(headerRow + 1).filter((r) => (r || []).some((c) => !isBlank(c)));
      const rows = body.map((r) => { const o = {}; columns.forEach((c, i) => { o[c] = r && r[i] !== undefined ? r[i] : null; }); return o; });
      // drop trailing columns that are entirely empty and unnamed
      const keep = columns.filter((c, i) => !(/^column_\d+$/.test(c) && rows.every((r) => isBlank(r[c]))));
      return { columns: keep, rows: rows };
    }

    const isBlank = (v) => v === null || v === undefined || (typeof v === "string" && v.trim() === "");
    // Dates arrive as Excel serials (already Date objects), ISO strings, ISO
    // datetimes ("2014-10-28 00:00:00"), slash forms ("2014/10/28"), and
    // day-or-month-first forms that only a human can disambiguate.
    const RE_YMD = /^\d{4}[-/.]\d{1,2}([-/.]\d{1,2})?([ T]\d{1,2}:\d{2}(:\d{2})?)?$/;
    const RE_DMY = /^\d{1,2}[-/.]\d{1,2}[-/.]\d{4}([ T]\d{1,2}:\d{2}(:\d{2})?)?$/;
    const isLikelyDate = (v) => v instanceof Date || (typeof v === "string" && (RE_YMD.test(v.trim()) || RE_DMY.test(v.trim())));
    // Rewrite any recognised date to YYYY-MM-DD. Where the value itself settles
    // day-vs-month (a part above 12) that wins; otherwise the user's answer does.
    function toISO(v, dayFirst) {
      if (v instanceof Date) return isNaN(v.getTime()) ? v : v.toISOString().slice(0, 10);
      const s = String(v == null ? "" : v).trim(); if (!s) return v;
      let m = s.match(/^(\d{4})[-/.](\d{1,2})(?:[-/.](\d{1,2}))?/);
      if (m) return m[1] + "-" + String(+m[2]).padStart(2, "0") + "-" + String(+(m[3] || 1)).padStart(2, "0");
      m = s.match(/^(\d{1,2})[-/.](\d{1,2})[-/.](\d{4})/);
      if (m) {
        const a = +m[1], b = +m[2];
        let d, mo;
        if (a > 12) { d = a; mo = b; } else if (b > 12) { d = b; mo = a; } else if (dayFirst) { d = a; mo = b; } else { d = b; mo = a; }
        return m[3] + "-" + String(mo).padStart(2, "0") + "-" + String(d).padStart(2, "0");
      }
      return v;
    }
    function dateStyle(vals) {
      const s = vals.filter((v) => typeof v === "string").map((v) => v.trim());
      if (!s.length) return { label: "spreadsheet date values", ambiguous: false };
      const dmy = s.filter((v) => RE_DMY.test(v));
      const hasTime = s.some((v) => /[ T]\d{1,2}:\d{2}/.test(v));
      if (dmy.length > s.length / 2) {
        let first = 0, second = 0;
        dmy.forEach((v) => { const p = v.split(/[-/.]/); if (+p[0] > 12) first++; if (+p[1] > 12) second++; });
        if (first) return { label: "day-first (DD/MM/YYYY)", ambiguous: false, dayFirst: true };
        if (second) return { label: "month-first (MM/DD/YYYY)", ambiguous: false, dayFirst: false };
        return { label: "DD/MM or MM/DD — ambiguous", ambiguous: true };
      }
      return { label: "year-first (YYYY-MM-DD" + (hasTime ? ", with a time part" : "") + ")", ambiguous: false };
    }
    const asStr = (v) => (v instanceof Date ? v.toISOString().slice(0, 10) : String(v));
    const topCats = (arr, k) => {
      const m = {}; arr.forEach((v) => { m[v] = (m[v] || 0) + 1; });
      return Object.entries(m).sort((a, b) => b[1] - a[1]).slice(0, k).map(([v, c]) => v + " (" + c + ")").join(", ");
    };

    function profileColumn(name, rows) {
      const vals = rows.map((r) => r[name]);
      const n = vals.length;
      const nonNull = vals.filter((v) => !isBlank(v));
      const missing = n - nonNull.length;
      const strs = nonNull.map(asStr);
      const distinct = new Set(nonNull.map((v) => (v instanceof Date ? v.getTime() : v))).size;
      const numeric = nonNull.filter((v) => typeof v === "number" || (typeof v === "string" && v.trim() !== "" && !isNaN(Number(v.replace(/,/g, "")))));
      const dates = nonNull.filter(isLikelyDate);
      let type;
      if (nonNull.length === 0) type = "empty";
      else if (numeric.length === nonNull.length) type = distinct <= 2 ? "binary" : (distinct === nonNull.length && nonNull.length > 10 ? "id" : "number");
      else if (dates.length === nonNull.length) type = "date";
      // Two distinct text values is a binary variable, whatever the tokens are.
      // Calling Y/N or 有/無 "categorical" hid them from every role that needs a
      // 0/1 indicator, since a role only accepts columns of a declared type.
      else if (distinct === 2) type = "binary";
      else if (distinct === nonNull.length && nonNull.length > 5) type = "id";
      else if (distinct <= Math.max(20, nonNull.length * 0.1)) type = "categorical";
      else type = "text";

      const flags = [];
      if (missing > 0) flags.push({ level: missing / n > 0.2 ? "warn" : "info", msg: Math.round((100 * missing) / n) + "% missing" });
      if (numeric.length > 0 && numeric.length < nonNull.length && type !== "categorical" && type !== "text" && type !== "date")
        flags.push({ level: "warn", msg: "mixed numeric / non-numeric" });
      if (dates.length > 0 && dates.length < nonNull.length && type === "date") flags.push({ level: "warn", msg: "some values don't parse as dates" });
      if (strs.some((v) => v !== v.trim())) flags.push({ level: "warn", msg: "stray whitespace" });
      const lc = new Set(strs.map((v) => v.toLowerCase().trim()));
      if ((type === "categorical" || type === "binary") && lc.size < distinct) flags.push({ level: "warn", msg: "inconsistent capitalisation / spacing" });
      if (distinct === 1) flags.push({ level: "info", msg: "constant" });
      if (type === "number") {
        const nums = numeric.map((v) => Number(String(v).replace(/,/g, "")));
        if (nums.some((x) => x < 0)) flags.push({ level: "info", msg: "has negatives" });
      }

      let range = "";
      // A two-level TEXT column is typed "binary" just above — Y/N, M/F, 有/無 are binary
      // variables whatever the tokens are — and then has no numeric values at all.
      // Math.min() of an empty list is Infinity and Math.max() is -Infinity, so this
      // printed "min Infinity · max -Infinity" beside a green "✓ clean", and #dldict
      // wrote that string into the data dictionary the user shares. Show a text-coded
      // binary what it actually has: its levels.
      const rnums = (type === "number" || type === "binary") ? numeric.map((v) => Number(String(v).replace(/,/g, ""))) : [];
      if (rnums.length) {
        range = "min " + Math.min(...rnums) + " · max " + Math.max(...rnums);
      } else if (type === "date") {
        const ds = nonNull.map((v) => (v instanceof Date ? v : new Date(v))).map((d) => d.getTime()).filter((t) => !isNaN(t));
        if (ds.length) range = new Date(Math.min(...ds)).toISOString().slice(0, 10) + " → " + new Date(Math.max(...ds)).toISOString().slice(0, 10);
      } else if (type !== "empty") {
        range = topCats(strs, 3);
      }
      const levels = distinct <= 6 ? Array.from(new Set(strs.map((v) => v.trim()))).sort() : [];
      return { name, type, missing, missingPct: n ? (100 * missing) / n : 0, distinct, flags, range, levels, def: CODEBOOK[normName(name)] || "" };
    }

    // ── Codebook / data dictionary ──────────────────────────────────────────
    // NFC first: a codebook written on macOS stores "Créatinine" decomposed, a
    // Windows export stores it composed. They render identically and compare
    // unequal, so without this the codebook silently matches nothing.
    const normName = (s) => String(s == null ? "" : s).normalize("NFC").trim().toLowerCase().replace(/\s+/g, " ").replace(/^["']|["']$/g, "");
    // Find, in any sheet, the column whose values look like this dataset's column
    // names; everything else on that row is the definition.
    function parseCodebook(wb, dataCols) {
      const want = new Set((dataCols || []).map(normName));
      let best = null;
      wb.SheetNames.forEach((sn) => {
        const aoa = sheetAOA(wb.Sheets[sn]);
        const width = aoa.reduce((m, r) => Math.max(m, r ? r.length : 0), 0);
        for (let c = 0; c < width; c++) {
          const vals = aoa.map((r) => (r && r[c] != null ? String(r[c]) : "")).filter((v) => v.trim() !== "");
          if (vals.length < 2) continue;
          const hits = want.size ? vals.filter((v) => want.has(normName(v))).length : 0;
          const uniq = new Set(vals.map(normName)).size;
          const sc = want.size ? hits : uniq;      // no data yet? fall back to the most name-like column
          if (!best || sc > best.sc) best = { sc: sc, sheet: sn, col: c, aoa: aoa, width: width, hits: hits, total: vals.length };
        }
      });
      if (!best) return null;
      const pairs = {};
      best.aoa.forEach((r) => {
        if (!r) return;
        const term = r[best.col] == null ? "" : String(r[best.col]).trim();
        if (!term) return;
        const rest = [];
        for (let c = 0; c < best.width; c++) { if (c === best.col) continue; const v = r[c]; if (!isBlank(v)) rest.push(String(v).trim()); }
        if (rest.length) pairs[normName(term)] = rest.join(" · ").replace(/\s*\n\s*/g, " / ");
      });
      const have = new Set((dataCols || []).map(normName));
      const unmatched = Object.keys(pairs).filter((k) => !have.has(k)).length;
      return { pairs: pairs, matched: best.hits, total: best.total, sheet: best.sheet, unmatched: unmatched };
    }

    // ── Structure inference ─────────────────────────────────────────────────
    // Deterministic guesses at the things a tool normally just assumes: which
    // column is the person, whether a row is a person or a visit, how dates are
    // written, and what a coded flag means. Each guess carries a confidence and
    // is overridable.
    const YES_TOKENS = ["1", "y", "yes", "true", "t", "有", "是", "有病史", "陽性", "positive", "present", "case", "event", "exposed"];
    const NO_TOKENS = ["0", "n", "no", "false", "f", "無", "否", "陰性", "negative", "absent", "control", "none", "unexposed"];
    const SEX_SETS = [["m", "f"], ["male", "female"], ["男", "女"], ["男性", "女性"]];
    const ID_RE = /(^|[_\s])id$|^id[_\s]|patient|subject|person|pid|chart|mrn|病歷|病例|身分|身份|編號|序號|案號|患者|受診者|환자|번호|fallnummer|patientennummer|dossier|matricule|numero|número|nummer/i;
    const UNIT_LABEL = { patient: "one row per patient", visit: "one row per visit / episode", period: "one row per period (an aggregated series)", interval: "one row per patient-interval", other: "something else", unknown: "not sure" };
    const CONF_CLS = { high: "bg-emerald-100 text-emerald-800", medium: "bg-amber-100 text-amber-800", low: "bg-slate-200 text-slate-600" };
    const confBadge = (c) => '<span class="ml-1 rounded px-1.5 py-0.5 text-[10px] font-semibold ' + (CONF_CLS[c] || CONF_CLS.low) + '">' + c + " confidence</span>";

    function inferStructure() {
      const n = DATA.rows.length, prof = DATA.profile;
      let idCol = "", idScore = 0;
      prof.forEach((p) => {
        let sc = 0;
        if (ID_RE.test(p.name)) sc += 3;
        if (p.def && (ID_RE.test(p.def) || /識別|唯一|unique/i.test(p.def))) sc += 2;
        if (p.type === "id") sc += 2;
        if (p.type === "date") sc -= 5;
        const ratio = n ? p.distinct / n : 0;
        if (ratio > 0.9) sc += 1; else if (ratio < 0.05) sc -= 2;
        if (sc > idScore) { idScore = sc; idCol = p.name; }
      });
      if (idScore < 3) idCol = "";
      let repeats = 0, identical = 0, distinctIds = 0;
      if (idCol) {
        const groups = new Map();
        DATA.rows.forEach((r, i) => { const k = String(r[idCol] == null ? "" : r[idCol]).trim(); if (!k) return; if (!groups.has(k)) groups.set(k, []); groups.get(k).push(i); });
        distinctIds = groups.size;
        const rowKey = (i) => DATA.columns.map((c) => asStr(DATA.rows[i][c] == null ? "" : DATA.rows[i][c])).join("|");
        groups.forEach((idxs) => { if (idxs.length > 1) { repeats++; const k0 = rowKey(idxs[0]); if (idxs.every((i) => rowKey(i) === k0)) identical++; } });
      }
      const uniqRatio = idCol && n ? distinctIds / n : 1;
      const dateCols = prof.filter((p) => p.type === "date").map((p) => p.name);
      let unit = "unknown", unitConf = "low";
      // "One row per period" is only asserted with evidence for it — a date column
      // that is unique per row. Without an ID column and without that, the honest
      // answer is "not sure", not a confident guess about a per-patient extract.
      if (!idCol) {
        const seriesLike = dateCols.some((c) => { const p = prof.find((x) => x.name === c); return p && n > 0 && p.distinct === n - p.missing; });
        unit = seriesLike ? "period" : "unknown";
        unitConf = seriesLike ? "medium" : "low";
      }
      else if (uniqRatio > 0.995) { unit = "patient"; unitConf = uniqRatio === 1 ? "high" : "medium"; }
      else if (repeats && identical === repeats) { unit = "patient"; unitConf = "medium"; }
      else if (dateCols.length >= 2 && uniqRatio > 0.5) { unit = "interval"; unitConf = "medium"; }
      else { unit = "visit"; unitConf = uniqRatio < 0.6 ? "high" : "medium"; }
      const repeatKind = !repeats ? "none" : (identical === repeats ? "dup" : (identical ? "mixed" : "measures"));

      const byKey = {};
      prof.forEach((p) => {
        if (!p.levels || p.levels.length !== 2) return;
        const key = p.levels.map((v) => v.toLowerCase()).sort().join(" / ");
        if (!byKey[key]) byKey[key] = { key: key, values: p.levels.slice(), columns: [] };
        byKey[key].columns.push(p.name);
      });
      const vocabs = Object.keys(byKey).map((k) => {
        const v = byKey[k], lo = v.values.map((x) => x.toLowerCase());
        const yi = lo.findIndex((x) => YES_TOKENS.indexOf(x) >= 0), ni = lo.findIndex((x) => NO_TOKENS.indexOf(x) >= 0);
        let yes = "", kind = "flag", conf = "low";
        if (SEX_SETS.some((s) => (s[0] === lo[0] && s[1] === lo[1]) || (s[0] === lo[1] && s[1] === lo[0]))) { kind = "sex"; conf = "high"; }
        else if (yi >= 0 && ni >= 0 && yi !== ni) { yes = v.values[yi]; conf = "high"; }
        else if (lo.indexOf("1") >= 0 && lo.indexOf("2") >= 0) { yes = v.values[lo.indexOf("1")]; conf = "low"; }
        return { key: k, values: v.values, columns: v.columns, yes: yes, kind: kind, conf: conf };
      });
      const dates = dateCols.map((c) => { const st = dateStyle(DATA.rows.map((r) => r[c])); return { col: c, label: st.label, ambiguous: !!st.ambiguous, dayFirst: !!st.dayFirst }; });

      const prev = STRUCT;
      STRUCT = {
        sheet: prev.sheet, headerRow: prev.headerRow, split: prev.split,
        unit: unit, unitConf: unitConf, idCol: idCol, idConf: idScore >= 5 ? "high" : (idScore >= 3 ? "medium" : "low"),
        repeats: repeats, repeatKind: repeatKind, uniqRatio: uniqRatio, distinctIds: distinctIds,
        dateCols: dates, dayFirst: prev.dayFirst || dates.some((d) => d.dayFirst), vocabs: vocabs, yes: {},
      };
      vocabs.forEach((v) => { STRUCT.yes[v.key] = (prev.yes && prev.yes[v.key] != null) ? prev.yes[v.key] : (v.kind === "sex" ? "" : v.yes); });
      YMCACHE = null;
      return STRUCT;
    }

    // toBin consults the vocabulary the user confirmed, so 有/無 or Y/N or 1/2
    // are coerced the way this dataset means them — not the way English data does.
    let YMCACHE = null;
    function yesMap() {
      if (YMCACHE) return YMCACHE;
      const m = {};
      (STRUCT.vocabs || []).forEach((v) => {
        const y = STRUCT.yes[v.key];
        if (!y) return;
        v.values.forEach((val) => { m[String(val).trim().toLowerCase()] = String(val) === String(y) ? 1 : 0; });
      });
      YMCACHE = m;
      return m;
    }

    function renderStructure() {
      const box = $("structbody"); if (!box) return;
      const s = STRUCT, cols = DATA.columns;
      const sel = (id, opts, cur) => '<select data-s="' + id + '" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">' + opts.map((o) => '<option value="' + esc(o[0]) + '"' + (String(cur) === String(o[0]) ? " selected" : "") + ">" + esc(o[1]) + "</option>").join("") + "</select>";
      const parts = [];

      if (SHEETS.length) {
        const other = SHEETS.filter((x) => x.name !== s.sheet);
        parts.push('<div class="rounded-xl border border-slate-200 bg-slate-50 p-3">' +
          '<div class="grid gap-3 sm:grid-cols-3">' +
          '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Sheet</span>' + sel("sheet", SHEETS.map((x) => [x.name, x.name + " · " + x.rows + "×" + x.cols + (x.notes.length ? " ⚠" : "")]), s.sheet) + "</label>" +
          '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Header row</span><input data-s="headerRow" type="number" min="1" step="1" value="' + (s.headerRow + 1) + '" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /><span class="text-[11px] text-slate-500">Row holding the column names.</span></label>' +
          '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Delimited dump</span><label class="mt-2 flex items-center gap-2 text-sm"><input data-s="split" type="checkbox"' + (s.split ? " checked" : "") + ' /> Split this sheet on tabs / commas</label></label>' +
          "</div>" +
          (other.length ? '<p class="mt-2 text-[11px] text-slate-500">Other sheets: ' + other.map((x) => "<strong>" + esc(x.name) + "</strong> (" + x.rows + "×" + x.cols + (x.notes.length ? " — " + esc(x.notes.join("; ")) : "") + ")").join("; ") + "</p>" : "") +
          "</div>");
      }

      const idOpts = [["", "— none / not a person-level file —"]].concat(cols.map((c) => [c, c]));
      parts.push('<div class="grid gap-3 sm:grid-cols-3">' +
        '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">A row is</span>' + confBadge(s.unitConf) + sel("unit", [["patient", UNIT_LABEL.patient], ["visit", UNIT_LABEL.visit], ["period", UNIT_LABEL.period], ["interval", UNIT_LABEL.interval], ["other", UNIT_LABEL.other], ["unknown", UNIT_LABEL.unknown]], s.unit) + "</label>" +
        '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Patient / subject ID</span>' + confBadge(s.idConf) + sel("idCol", idOpts, s.idCol) + "</label>" +
        '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Repeated IDs mean</span>' + sel("repeatKind", [["none", s.repeats ? "— pick one —" : "no ID repeats ✓"], ["measures", "real repeat measures (keep them all)"], ["dup", "duplicates to resolve"], ["mixed", "a mix — needs review"]], s.repeatKind) + "</label>" +
        "</div>" +
        '<p class="text-[11px] text-slate-500">' + (s.idCol
          ? esc(s.distinctIds + " distinct ID(s) across " + DATA.rows.length + " rows" + (s.repeats ? "; " + s.repeats + " ID(s) repeat, of which " + (s.repeatKind === "dup" ? "all" : s.repeatKind === "measures" ? "none" : "some") + " are exact copies of another row." : " — every ID is unique."))
          : "No column looks like a person identifier — that is normal for an already-aggregated series.") + "</p>");

      if (s.dateCols.length) {
        const amb = s.dateCols.some((d) => d.ambiguous);
        parts.push('<div><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Date columns</span>' +
          '<div class="mt-1 grid gap-1 sm:grid-cols-2 text-xs text-slate-700">' + s.dateCols.map((d) => "<div><strong>" + esc(d.col) + "</strong> — " + esc(d.label) + "</div>").join("") + "</div>" +
          (amb ? '<label class="mt-1.5 flex items-center gap-2 text-xs text-amber-800"><input data-s="dayFirst" type="checkbox"' + (s.dayFirst ? " checked" : "") + ' /> These are day-first (DD/MM/YYYY), not month-first — no value in the file settles it.</label>' : "") +
          "</div>");
      }

      const flags = s.vocabs.filter((v) => v.kind !== "sex");
      if (flags.length) {
        parts.push('<div><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Coded flags — which value means “yes / event present”?</span>' +
          '<div class="mt-1 grid gap-2 sm:grid-cols-2">' + flags.map((v) =>
            '<label class="block text-xs"><span class="text-slate-600">' + esc(v.key) + " · " + v.columns.length + " column(s)" + confBadge(v.conf) + "</span>" +
            sel("yes:" + v.key, [["", "— not a yes/no flag —"]].concat(v.values.map((x) => [x, x + " means yes"])), s.yes[v.key] || "") +
            '<span class="block text-[11px] text-slate-400 truncate" title="' + esc(v.columns.join(", ")) + '">' + esc(v.columns.slice(0, 4).join(", ")) + (v.columns.length > 4 ? " …" : "") + "</span></label>").join("") + "</div></div>");
      }

      parts.push('<p class="text-[11px] text-slate-500">' + (CBINFO
        ? "Codebook <strong>" + esc(CBINFO.name) + "</strong>: " + CBINFO.matched + " of " + cols.length + " column(s) matched, " + Object.keys(CODEBOOK).length + " definition(s) loaded. Definitions appear under each column below and steer the role suggestions."
        : "No codebook loaded. If you have a data dictionary, adding it above lets the tool label columns and propose roles in your own vocabulary.") + "</p>");

      box.innerHTML = parts.join("");
      box.querySelectorAll("[data-s]").forEach((el) => el.addEventListener("change", () => onStructChange(el)));
      const c = { high: "text-emerald-700", medium: "text-amber-700", low: "text-slate-500" }[s.unitConf] || "text-slate-500";
      $("structsum").innerHTML = "— " + DATA.rows.length + " rows · <span class='" + c + "'>" + esc(UNIT_LABEL[s.unit] || s.unit) + "</span>" + (s.idCol ? " · ID <strong>" + esc(s.idCol) + "</strong>" : "") + (s.dateCols.length ? " · " + s.dateCols.length + " date column(s)" : "");
    }

    function onStructChange(el) {
      const k = el.getAttribute("data-s");
      if (k === "sheet" || k === "split" || k === "headerRow") {
        if (k === "sheet") { STRUCT.sheet = el.value; STRUCT.split = false; STRUCT.headerRow = -1; }
        if (k === "split") STRUCT.split = el.checked;
        if (k === "headerRow") STRUCT.headerRow = Math.max(0, (parseInt(el.value) || 1) - 1);
        rebuildFromSheet(k !== "headerRow");
        return;
      }
      YMCACHE = null;
      if (k.indexOf("yes:") === 0) STRUCT.yes[k.slice(4)] = el.value;
      else if (k === "dayFirst") STRUCT.dayFirst = el.checked;
      else STRUCT[k] = el.value;
      // "which value means yes" and the day-first answer both feed buildMaster
      // through toBin/toISO, so a master built before this change describes a
      // different dataset from the one on screen.
      invalidateMaster();
      if (k === "idCol") { try { renderDupUI(); } catch (e) {} }
      try { renderMap(); } catch (e) {}
      renderStructure();
    }

    function dupRowCount(rows, columns) {
      const seen = new Set(); let dups = 0;
      for (const r of rows) { const k = columns.map((c) => asStr(r[c] == null ? "" : r[c])).join(""); if (seen.has(k)) dups++; else seen.add(k); }
      return dups;
    }

    const TYPE_BADGE = { number: "bg-sky-100 text-sky-800", binary: "bg-indigo-100 text-indigo-800", date: "bg-violet-100 text-violet-800", categorical: "bg-emerald-100 text-emerald-800", id: "bg-amber-100 text-amber-800", text: "bg-slate-100 text-slate-700", empty: "bg-rose-100 text-rose-700" };
    const esc = (x) => String(x == null ? "" : x).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    function render() {
      const { rows, columns, profile } = DATA;
      $("results").classList.remove("hidden");
      inferStructure();
      renderStructure();
      const dups = dupRowCount(rows, columns);
      const flagged = profile.filter((p) => p.flags.some((f) => f.level === "warn")).length;
      $("summary").innerHTML = "<strong>" + rows.length + "</strong> rows · <strong>" + columns.length + "</strong> columns · " +
        (dups ? "<span class='text-amber-700 font-semibold'>" + dups + " duplicate row(s)</span>" : "no duplicate rows") +
        " · " + (flagged ? "<span class='text-amber-700 font-semibold'>" + flagged + " column(s) need attention</span>" : "no dirtiness flagged");

      const issues = [];
      if (dups) issues.push({ level: "warn", msg: dups + " fully-duplicated row(s) — likely to be de-duplicated during cleaning." });
      if (!columns.length) issues.push({ level: "error", msg: "No columns detected — is there a header row?" });
      if (SPLITINFO && SPLITINFO.ragged) issues.push({ level: "warn", msg: "Splitting this sheet produced " + SPLITINFO.ragged + " row(s) with a field count other than " + SPLITINFO.modal + " — a delimited dump inside a spreadsheet cell is usually truncated, so some values will be wrong. Prefer the properly-tabulated sheet if the workbook has one." });
      const badSheet = SHEETS.find((x) => x.name === STRUCT.sheet && x.notes.length);
      if (badSheet && !STRUCT.split) issues.push({ level: "warn", msg: "The sheet in use (“" + badSheet.name + "”) " + badSheet.notes.join("; ") + "." });
      $("issues").innerHTML = issues.map((i) => "<div class='flex items-start gap-2 rounded-lg border px-3 py-2 text-xs " + (i.level === "error" ? "border-rose-200 bg-rose-50 text-rose-800" : "border-amber-200 bg-amber-50 text-amber-800") + "'><span class='font-bold'>" + (i.level === "error" ? "✕" : "!") + "</span><span>" + esc(i.msg) + "</span></div>").join("");

      $("proftable").innerHTML = profile.map((p) => {
        const badges = p.flags.map((f) => "<span class='inline-block rounded px-1.5 py-0.5 text-[10px] font-semibold " + (f.level === "warn" ? "bg-amber-100 text-amber-800" : "bg-slate-100 text-slate-600") + "'>" + esc(f.msg) + "</span>").join(" ") || "<span class='text-emerald-600'>✓ clean</span>";
        return "<tr class='border-b border-slate-100 align-top'>" +
          "<td class='py-2 pr-3 font-semibold text-slate-800'>" + esc(p.name) + (p.def ? "<div class='font-normal text-[10px] text-slate-500 max-w-[220px]'>" + esc(p.def) + "</div>" : "") + "</td>" +
          "<td class='py-2 pr-3'><span class='inline-block rounded px-1.5 py-0.5 text-[10px] font-semibold " + (TYPE_BADGE[p.type] || TYPE_BADGE.text) + "'>" + p.type + "</span></td>" +
          "<td class='py-2 pr-3 " + (p.missingPct > 20 ? "text-amber-700 font-semibold" : "text-slate-600") + "'>" + Math.round(p.missingPct) + "%</td>" +
          "<td class='py-2 pr-3 text-slate-600'>" + p.distinct + "</td>" +
          "<td class='py-2 pr-3 text-slate-600'>" + esc(p.range) + "</td>" +
          "<td class='py-2 pr-3'>" + badges + "</td>" +
        "</tr>";
      }).join("");
      try { renderMap(); } catch (e) {}
    }

    function applyCodebook() {
      if (!CBWB || !DATA.columns.length) return;
      const r = parseCodebook(CBWB, DATA.columns);
      if (!r) { CBINFO = null; return; }
      CODEBOOK = r.pairs; CBINFO = { name: CBNAME, matched: r.matched, sheet: r.sheet, unmatched: r.unmatched };
      DATA.profile.forEach((p) => { p.def = CODEBOOK[normName(p.name)] || ""; });
      $("cbinfo").textContent = "· " + CBNAME + " — " + r.matched + " of " + DATA.columns.length + " columns matched" + (r.unmatched ? ", " + r.unmatched + " codebook term(s) matched nothing" : "");
    }
    function setData(columns, rows, name) {
      DATA = { rows: rows, columns: columns, profile: columns.map((c) => profileColumn(c, rows)), name: name || DATA.name || "dataset" };
      applyCodebook();
      MAP = {}; COVS = []; COVROLE = {}; MASTER = null; LAST = null; RAWTXT = {};
      $("anacard").classList.add("hidden"); hideResults();
      $("fileinfo").textContent = DATA.name + " · " + rows.length + " rows × " + columns.length + " cols" + (STRUCT.sheet ? " · sheet “" + STRUCT.sheet + "”" : "");
      render();
    }
    function rebuildFromSheet(redetectHeader) {
      if (!WB) return;
      const ws = WB.Sheets[STRUCT.sheet]; if (!ws) return;
      let aoa = sheetAOA(ws);
      SPLITINFO = null;
      if (STRUCT.split) { SPLITINFO = splitDelimited(aoa); aoa = SPLITINFO.aoa; }
      if (redetectHeader || STRUCT.headerRow < 0 || STRUCT.headerRow >= aoa.length) STRUCT.headerRow = detectHeaderRow(aoa);
      const t = tableFromAOA(aoa, STRUCT.headerRow);
      setData(t.columns, t.rows, DATA.name);
      // After setData, because setData clears it. Same sheet, same split, same header
      // row — only the coercion differs — so the columns line up by name.
      try {
        let ta = sheetAOAText(ws);
        if (STRUCT.split) ta = splitDelimited(ta).aoa;
        const tt = tableFromAOA(ta, STRUCT.headerRow);
        RAWTXT = commaExamples(tt.columns, tt.rows);
      } catch (e) { RAWTXT = {}; }
    }

    async function ingest(file) {
      setMsg("Parsing " + file.name + "…");
      $("demonote").classList.add("hidden");
      try {
        WB = await readWorkbook(file);
        SHEETS = WB.SheetNames.map((n) => scoreSheet(n, sheetAOA(WB.Sheets[n])));
        const best = SHEETS.slice().sort((a, b) => b.score - a.score)[0];
        if (!best) { setMsg("That workbook has no sheets.", true); return; }
        STRUCT = Object.assign({}, STRUCT, { sheet: best.name, headerRow: -1, split: false, yes: {} });
        DATA.name = file.name.replace(/\.[^.]+$/, "") || "dataset";
        rebuildFromSheet(true);
        if (!DATA.rows.length || !DATA.columns.length) { setMsg("Couldn't read any rows/columns from “" + best.name + "”. Try another sheet or header row in the panel below.", true); return; }
        const notes = [];
        if (SHEETS.length > 1) notes.push("Chose sheet “" + best.name + "” of " + SHEETS.length + " — the widest, fullest table.");
        SHEETS.filter((x) => x.name !== best.name && x.notes.length).forEach((x) => notes.push("Left “" + x.name + "” alone: " + x.notes.join("; ") + "."));
        if (STRUCT.headerRow > 0) notes.push("Treated row " + (STRUCT.headerRow + 1) + " as the header.");
        setMsg(notes.join(" "));
      } catch (e) { setMsg("Error reading file: " + (e && e.message ? e.message : e), true); }
    }

    fileInput.addEventListener("change", (e) => { const f = e.target.files && e.target.files[0]; if (f) ingest(f); });
    $("cbfile").addEventListener("change", async (e) => {
      const f = e.target.files && e.target.files[0]; if (!f) return;
      $("cbinfo").textContent = "· reading " + f.name + "…";
      try {
        CBWB = await readWorkbook(f); CBNAME = f.name;
        if (DATA.columns.length) { applyCodebook(); render(); }
        else $("cbinfo").textContent = "· " + f.name + " — will be matched to the columns when the data loads";
      } catch (err) { $("cbinfo").textContent = "· could not read " + f.name; }
    });
    drop.addEventListener("dragover", (e) => { e.preventDefault(); drop.classList.add("border-brand-400", "bg-brand-50/40"); });
    drop.addEventListener("dragleave", () => drop.classList.remove("border-brand-400", "bg-brand-50/40"));
    drop.addEventListener("drop", (e) => { e.preventDefault(); drop.classList.remove("border-brand-400", "bg-brand-50/40"); const f = e.dataTransfer.files && e.dataTransfer.files[0]; if (f) ingest(f); });

    // ── Demo dataset ────────────────────────────────────────────────────────
    // Fabricated patients, generated from a model written down below, with a
    // treatment effect chosen in advance. The point is that it is CONFOUNDED: a
    // text covariate (severity) drives both who gets the new drug and who has the
    // event, so a crude analysis is wrong in a specific, checkable direction. A
    // demo that is balanced by construction cannot show what this tool is for,
    // and would hide a whole class of regression — a covariate silently dropped
    // from the model makes crude and adjusted agree, which looks like a result.
    const DEMO = {
      // Seed chosen so this particular 600-patient draw realises the model's true
      // effect closely (a finite sample need not, and saying "HR 0.70" about a
      // draw that came out at 0.62 would be a small lie in a teaching example).
      seed: 20192051,
      months: 24, perMonth: 25,          // 600 rows, 2018-01 … 2019-12
      sev: ["mild", "moderate", "severe"],
      sevMix: [0.40, 0.35, 0.25],
      pNew: [0.20, 0.50, 0.80],          // confounding by indication: sicker → new drug
      sevLHR: [0, 0.70, 1.40],           // severity also raises the hazard
      smokeLHR: 0.40,
      stepLHR: 0.35,                     // a step change in the hazard from 2019-01
      trueHR: 0.70,                      // ← what the tool should recover
      baseRate: 0.0008,
      sites: 26,
    };
    const DEMO_STORY =
      "<strong>Fabricated data — not real patients.</strong> " + (DEMO.months * DEMO.perMonth) + " rows, " +
      DEMO.months + " monthly index periods of " + DEMO.perMonth + ", one fixed seed, generated from this model:" +
      "<ul class='mt-1 ml-4 list-disc space-y-0.5'>" +
      "<li><code>severity</code> (mild / moderate / severe) raises the chance of getting the new drug to " +
      DEMO.pNew.map((p) => Math.round(p * 100) + "%").join(" / ") + " <em>and</em> multiplies the event hazard by " +
      DEMO.sevLHR.map((b) => "×" + Math.exp(b).toFixed(1)).join(" / ") + " — so it confounds.</li>" +
      "<li>smoking (×" + Math.exp(DEMO.smokeLHR).toFixed(1) + ") and a step change from 2019-01 (×" + Math.exp(DEMO.stepLHR).toFixed(1) + ") also raise the hazard.</li>" +
      "<li><code>sex</code> and <code>clinic_site</code> affect nothing — they are there to be messy.</li>" +
      "<li>The <strong>true treatment effect is HR " + DEMO.trueHR.toFixed(2) + "</strong> — the new drug helps.</li></ul>" +
      "<p class='mt-1'>Because the sicker patients were the ones given it, a <strong>crude</strong> comparison hides the benefit " +
      "entirely — it comes out at no effect. Tick <em>Quick pick</em> for the covariates and you should see roughly:</p>" +
      "<table class='mt-1 w-full max-w-md text-[11px]'><tbody>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>Crude HR</td><td class='font-semibold'>≈ 1.04 (0.82–1.32)</td></tr>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>IPTW (ATE)</td><td class='font-semibold'>≈ 0.70 (0.53–0.92)</td></tr>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>2:1 PS matching</td><td class='font-semibold'>≈ 0.77 (0.56–1.07)</td></tr>" +
      "</tbody></table>" +
      "<p class='mt-1 text-slate-500'>Quick pick ticks <code>age</code>, which is missing for 35 of the 600 by construction, so the " +
      "run analyses <strong>565</strong> — a complete-case analysis, reported in step 4. Crude and adjusted are both computed on " +
      "those 565, because a crude estimate from a different population is not a comparison.</p>" +
      "<p class='mt-1'><strong>If crude and adjusted come out the same, the tool is broken</strong> — a covariate that silently drops " +
      "out of the model produces exactly that, and it reads like a reassuring null. That is what this demo is for.</p>" +
      "<p class='mt-1 text-slate-500'>The adjusted figures will not land on 0.70 exactly and should not: 600 patients carry sampling " +
      "error, and a marginal hazard ratio is not the same quantity as the conditional one. Fitting the correctly-specified model " +
      "(severity, smoking and the calendar step — the three things actually in the hazard) to these 565 gives HR 0.648 " +
      "(0.498–0.841), so both estimates above are where they should be.</p>" +
      "<p class='mt-1'>The same file also runs as an <strong>interrupted time series</strong>: map <code>index_date</code> and " +
      "<code>outcome</code>, aggregate by month, interruption <strong>2019-01</strong>. Expect a level change of " +
      "<strong>≈ 1.35 (0.82–2.21)</strong>. Note that is <em>not</em> the ×" + Math.exp(DEMO.stepLHR).toFixed(1) + " that was put into the hazard, and " +
      "should not be: <code>outcome</code> is a 365-day risk rather than a rate, so the step is compressed, and with only 12 " +
      "periods either side the interval crosses 1. The ITS here is a working example, not a second estimate of the same quantity.</p>" +
      "<p class='mt-1 text-slate-500'>That interval is wide on purpose. Twenty-four periods is too few for either standard error " +
      "this tool can offer to be worth 95% confidence, so <strong>Auto</strong> reports the wider of the two and says as much " +
      "underneath the estimates. An earlier version reported 0.98–1.85 here — the Newey–West interval, which on this series is " +
      "narrower than the model-based one it was meant to be a correction to.</p>";

    // Shared helpers for every demo generator.
    const lcg = (s0) => { let s = s0; return () => (s = (s * 1103515245 + 12345) % 2147483648) / 2147483648; };
    const rpois = (lam, rand) => { if (lam <= 0) return 0; const L = Math.exp(-lam); let k = 0, p = 1; do { k++; p *= rand(); } while (p > L); return k - 1; };
    const dayStr = (base, d) => new Date(Date.parse(base) + d * 86400000).toISOString().slice(0, 10);

    // ── Self-controlled case series ─────────────────────────────────────────
    // Long format, one row per person-interval. Only people who had an event
    // appear — that is what "case series" means. Each person's own unexposed time
    // is the comparison for their own exposed time, so anything fixed about the
    // person (frailty, genetics, chronic disease) cannot confound the estimate.
    const SCCS = {
      seed: 20201883, people: 1000, obsDays: 365, trueIRR: 3.0, start: "2019-01-01",
      mix: [0.45, 0.35, 0.20],
      tiers: [
        { n: "low", rate: 0.00018, pExp: 0.25, riskDays: 30 },
        { n: "medium", rate: 0.0010, pExp: 0.60, riskDays: 60 },
        { n: "high", rate: 0.0050, pExp: 0.92, riskDays: 120 },
      ],
    };
    function buildSccs() {
      const rand = lcg(SCCS.seed);
      const pick = (ws) => { let u = rand(), a = 0; for (let i = 0; i < ws.length; i++) { a += ws[i]; if (u < a) return i; } return ws.length - 1; };
      const rows = [];
      for (let i = 1; i <= SCCS.people; i++) {
        const t = SCCS.tiers[pick(SCCS.mix)];
        const exposed = rand() < t.pExp, rd = t.riskDays;
        const s0 = exposed ? Math.floor(20 + rand() * (SCCS.obsDays - rd - 40)) : -1;
        const segs = exposed
          ? [{ on: 0, a: 0, d: s0 }, { on: 1, a: s0, d: rd }, { on: 0, a: s0 + rd, d: SCCS.obsDays - s0 - rd }]
          : [{ on: 0, a: 0, d: SCCS.obsDays }];
        const withEv = segs.filter((s) => s.d > 0).map((s) => Object.assign({}, s, { ev: rpois(t.rate * (s.on ? SCCS.trueIRR : 1) * s.d, rand) }));
        if (!withEv.reduce((a, s) => a + s.ev, 0)) continue;      // cases only
        withEv.forEach((s) => rows.push({
          case_id: "C" + String(10000 + i),
          interval_start: dayStr(SCCS.start, s.a),
          interval_end: dayStr(SCCS.start, s.a + s.d),
          on_drug: s.on,
          n_events: s.ev,
          days_at_risk: s.d,
          frailty_tier: t.n,
        }));
      }
      return { cols: ["case_id", "interval_start", "interval_end", "on_drug", "n_events", "days_at_risk", "frailty_tier"], rows: rows, name: "demo-sccs" };
    }

    // ── Case-crossover ──────────────────────────────────────────────────────
    // Long format, one row per window. Each case supplies one hazard window (just
    // before the event) and three earlier control windows. Exposure prevalence
    // differs a lot between people; the matched analysis never compares across them.
    const CCO = {
      seed: 20200414, cases: 500, controls: 3, trueOR: 2.5, hazardDays: 7, gapDays: 30, start: "2019-06-01",
      tiers: [0.10, 0.25, 0.45], tierNames: ["occasional", "regular", "frequent"], mix: [0.40, 0.35, 0.25],
    };
    function buildCco() {
      const rand = lcg(CCO.seed);
      const pick = (ws) => { let u = rand(), a = 0; for (let i = 0; i < ws.length; i++) { a += ws[i]; if (u < a) return i; } return ws.length - 1; };
      const rows = [];
      for (let i = 1; i <= CCO.cases; i++) {
        const ti = pick(CCO.mix), p = CCO.tiers[ti];
        const q = (CCO.trueOR * p) / (1 - p + CCO.trueOR * p);   // makes the conditional OR exactly trueOR
        const evDay = 120 + Math.floor(rand() * 200);
        const mk = (label, hz, off, ex) => ({
          case_id: "X" + String(2000 + i), window: label, is_hazard_window: hz,
          window_start: dayStr(CCO.start, evDay - off - CCO.hazardDays), window_end: dayStr(CCO.start, evDay - off),
          drug_taken: ex ? "Y" : "N", usage_tier: CCO.tierNames[ti],
        });
        rows.push(mk("hazard", 1, 0, rand() < q));
        for (let k = 1; k <= CCO.controls; k++) rows.push(mk("control " + k, 0, k * CCO.gapDays, rand() < p));
      }
      return { cols: ["case_id", "window", "is_hazard_window", "window_start", "window_end", "drug_taken", "usage_tier"], rows: rows, name: "demo-case-crossover" };
    }

    function buildCohort() {
      let seed = DEMO.seed;                              // fixed seed → the demo is reproducible
      const rand = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
      const pick = (ws) => { let u = rand(), a = 0; for (let i = 0; i < ws.length; i++) { a += ws[i]; if (u < a) return i; } return ws.length - 1; };
      const sexes = ["M", "F", "m", "female ", "F"];     // deliberately inconsistent, for the profiler
      const rows = [];
      let i = 0;
      for (let m = 0; m < DEMO.months; m++) {
        const yr = 2018 + Math.floor(m / 12), mo = (m % 12) + 1, post = m >= 12 ? 1 : 0;
        for (let k = 0; k < DEMO.perMonth; k++) {
          i++;
          const sv = pick(DEMO.sevMix);
          const nd = rand() < DEMO.pNew[sv] ? 1 : 0;
          // Smoking depends on severity, never on treatment. If it depended on
          // treatment it would be a mediator, and "the true effect is HR 0.70"
          // would stop being true of the thing the tool estimates.
          const smoker = rand() < 0.18 + 0.10 * sv ? "Y" : "N";
          const age = Math.round((56 + 5 * sv + (rand() + rand() + rand() - 1.5) * 9) * 10) / 10;
          const lhr = DEMO.sevLHR[sv] + DEMO.smokeLHR * (smoker === "Y") + DEMO.stepLHR * post + Math.log(DEMO.trueHR) * nd;
          const t = -Math.log(rand() || 1e-9) / (DEMO.baseRate * Math.exp(lhr));
          const ev = t <= 365 ? 1 : 0, fu = Math.round(Math.min(t, 365) * 10) / 10;
          const idx = yr + "-" + String(mo).padStart(2, "0") + "-15";
          rows.push({
            patient_id: "D" + String(10000 + i),
            index_date: idx,
            age: i % 17 === 0 ? null : age,              // a little missingness
            sex: sexes[i % sexes.length],
            severity: DEMO.sev[sv],
            smoker: smoker,
            new_drug: nd,
            clinic_site: "site-" + String(1 + Math.floor(rand() * DEMO.sites)).padStart(2, "0"),
            followup_days: fu,
            outcome: ev,
            event_date: ev ? new Date(Date.parse(idx) + fu * 86400000).toISOString().slice(0, 10) : null,
            disc_days: i % 3 === 0 ? Math.round(fu * 0.55 * 10) / 10 : null,
          });
        }
      }
      return { cols: ["patient_id", "index_date", "age", "sex", "severity", "smoker", "new_drug", "clinic_site", "followup_days", "outcome", "event_date", "disc_days"], rows: rows, name: "demo-cohort" };
    }

    const SCCS_STORY =
      "<strong>Fabricated data — not real patients.</strong> Long format: one row per person-interval, " +
      "and only people who actually had an event, which is what a <em>case series</em> means. One fixed seed, from this model:" +
      "<ul class='mt-1 ml-4 list-disc space-y-0.5'>" +
      "<li>Each person is observed for " + SCCS.obsDays + " days and has a <code>frailty_tier</code> setting their baseline event rate — the frequent-event tier is about <strong>28×</strong> the rare one.</li>" +
      "<li>The frailer a person is, the more likely they are to be given the drug (" + SCCS.tiers.map((t) => Math.round(t.pExp * 100) + "%").join(" / ") + ") and the longer they stay on it (" + SCCS.tiers.map((t) => t.riskDays + "d").join(" / ") + "). So drug time is heavily concentrated in the people who were going to have events anyway.</li>" +
      "<li>While on the drug, the event rate is multiplied by the <strong>true IRR of " + SCCS.trueIRR.toFixed(1) + "</strong>. Nothing else changes.</li></ul>" +
      "<p class='mt-1'>Map <code>case_id</code>, <code>on_drug</code>, <code>n_events</code> and <code>days_at_risk</code>. You should see:</p>" +
      "<table class='mt-1 w-full max-w-lg text-[11px]'><tbody>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>Self-controlled IRR (each person vs themselves)</td><td class='font-semibold'>≈ 2.99 (2.57–3.49)</td></tr>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>Pooled across people (shown as a contrast)</td><td class='font-semibold'>≈ 3.46 (3.01–3.97) — biased</td></tr>" +
      "</tbody></table>" +
      "<p class='mt-1'>The pooled row is what you get by forgetting whose interval is whose. It is too high because drug time " +
      "belongs disproportionately to frail people. <code>frailty_tier</code> is in the file, but the self-controlled estimate " +
      "<strong>never needs it</strong> — each person is their own control, so anything fixed about them cancels. That is the whole point of the design.</p>";

    const CCO_STORY =
      "<strong>Fabricated data — not real patients.</strong> Long format: " + (CCO.controls + 1) + " rows per case — one " +
      CCO.hazardDays + "-day <em>hazard</em> window ending at the event, and " + CCO.controls + " earlier " + CCO.hazardDays +
      "-day <em>control</em> windows " + CCO.gapDays + " days apart. One fixed seed, from this model:" +
      "<ul class='mt-1 ml-4 list-disc space-y-0.5'>" +
      "<li>Each case has a personal <code>usage_tier</code> — background chance of having taken the drug in any given window of " +
      CCO.tiers.map((p) => Math.round(p * 100) + "%").join(" / ") + ". People differ enormously.</li>" +
      "<li>In the hazard window the odds of exposure are multiplied by the <strong>true odds ratio of " + CCO.trueOR.toFixed(1) + "</strong>, applied to that person's own background odds.</li></ul>" +
      "<p class='mt-1'>Map <code>case_id</code>, <code>is_hazard_window</code> and <code>drug_taken</code> — note the last is coded <strong>Y/N</strong>, so the structure panel has to work out which value means yes. You should see:</p>" +
      "<table class='mt-1 w-full max-w-lg text-[11px]'><tbody>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>Matched OR (each case vs their own earlier windows)</td><td class='font-semibold'>≈ 2.55 (2.03–3.21)</td></tr>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>Unmatched (shown as a contrast)</td><td class='font-semibold'>≈ 2.33 (1.88–2.88)</td></tr>" +
      "</tbody></table>" +
      "<p class='mt-1'>Throwing away the pairing pulls the odds ratio towards 1 — an odds ratio is not collapsible, so the " +
      "population-average number is not the within-person one, and it is the within-person one the design is built to estimate. " +
      "<code>usage_tier</code> cannot confound the matched estimate no matter how strong it is, because it never varies within a case. " +
      "One caveat this demo does <em>not</em> contain: if drug use had been trending over calendar time, control windows taken " +
      "earlier would understate exposure and the matched OR would be biased upward. Exposure here is flat over time.</p>";

    // ── A cohort that should not be analysed ────────────────────────────────
    // Treatment is almost decided by one covariate, so the two arms barely meet.
    // The true effect is exactly nothing. Every diagnostic added for positivity
    // fires here, which is the only way anyone will find them.
    const OVL = { seed: 20200731, n: 800, slope: 9, outLHR: 1.0, trueHR: 1.0, base: 0.0018 };
    function buildOverlap() {
      const rand = lcg(OVL.seed);
      const nrm = () => (rand() + rand() + rand() + rand() - 2) * 0.87;
      const rows = [];
      for (let i = 1; i <= OVL.n; i++) {
        const x = nrm();
        const T = rand() < 1 / (1 + Math.exp(-OVL.slope * x)) ? 1 : 0;
        const t = -Math.log(rand() || 1e-9) / (OVL.base * Math.exp(OVL.outLHR * x + Math.log(OVL.trueHR) * T));
        rows.push({
          patient_id: "O" + String(30000 + i), frailty_index: Math.round(x * 1000) / 1000,
          new_drug: T, followup_days: Math.round(Math.min(t, 365) * 10) / 10, outcome: t <= 365 ? 1 : 0,
        });
      }
      return { cols: ["patient_id", "frailty_index", "new_drug", "followup_days", "outcome"], rows: rows, name: "demo-no-overlap" };
    }
    const OVL_STORY =
      "<strong>Fabricated data — not real patients, and deliberately not analysable.</strong> " + OVL.n + " rows, one fixed seed:" +
      "<ul class='mt-1 ml-4 list-disc space-y-0.5'>" +
      "<li>A single <code>frailty_index</code> almost decides who gets the drug — the log-odds move by " + OVL.slope + " per unit — so the frailest are nearly all treated and the fittest nearly all untreated.</li>" +
      "<li>The same index strongly raises the hazard. The <strong>true treatment effect is exactly HR 1.00</strong>: the drug does nothing.</li></ul>" +
      "<p class='mt-1'>Run it as an active-comparator cohort with <code>frailty_index</code> as the only covariate. A crude comparison says the drug is harmful (HR ≈ 1.7) because it is given to frail people. That much a propensity score can fix. What it cannot fix is that <strong>for a large share of these patients there is nobody in the other arm to compare with at all</strong> — and the tool will say so, refuse the IPTW estimate, and offer the routes out.</p>" +
      "<p class='mt-1 text-slate-500'>This demo exists because a diagnostic nobody ever sees fire is a diagnostic nobody trusts. Try it with stabilised weights, then with truncation, then with common-support restriction, and watch which numbers move and which do not.</p>";

    const DEMOS = {
      cohort: { build: buildCohort, story: () => DEMO_STORY },
      overlap: { build: buildOverlap, story: () => OVL_STORY },
      sccs: { build: buildSccs, story: () => SCCS_STORY },
      cco: { build: buildCco, story: () => CCO_STORY },
    };
    document.querySelectorAll("[data-demo]").forEach((b) => b.addEventListener("click", () => {
      const d = DEMOS[b.getAttribute("data-demo")]; if (!d) return;
      const { cols, rows, name } = d.build();
      WB = null; SHEETS = []; SPLITINFO = null; CBWB = null; CODEBOOK = {}; CBINFO = null;
      STRUCT = Object.assign({}, STRUCT, { sheet: "", headerRow: 0, split: false, yes: {} });
      setData(cols, rows, name);
      setMsg("");
      $("demonote").classList.remove("hidden");
      $("demonote").innerHTML = d.story();
    }));

    // ── Exports ──
    const dl = (blob, nm) => { const u = URL.createObjectURL(blob); const a = document.createElement("a"); a.href = u; a.download = nm; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(u), 1000); };
    const csvCell = (v) => { const s = v == null ? "" : (v instanceof Date ? v.toISOString().slice(0, 10) : String(v)); return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
    const toCSV = (cols, rows) => [cols.map(csvCell).join(","), ...rows.map((r) => cols.map((c) => csvCell(r[c])).join(","))].join("\n");

    $("dlmaster").addEventListener("click", () => {
      if (!DATA.rows.length) return;
      dl(new Blob(["﻿" + toCSV(DATA.columns, DATA.rows)], { type: "text/csv;charset=utf-8" }), DATA.name + "-master.csv");
    });
    $("dldict").addEventListener("click", () => {
      if (!DATA.profile.length) return;
      const cols = ["column", "codebook_definition", "inferred_type", "missing_pct", "distinct", "range_or_top", "flags"];
      const rows = DATA.profile.map((p) => ({ column: p.name, codebook_definition: p.def || "", inferred_type: p.type, missing_pct: Math.round(p.missingPct), distinct: p.distinct, range_or_top: p.range, flags: p.flags.map((f) => f.msg).join("; ") }));
      dl(new Blob(["﻿" + toCSV(cols, rows)], { type: "text/csv;charset=utf-8" }), DATA.name + "-dictionary.csv");
    });

    // ── Step 1: clinical question + design (persisted) ──
    const Q_KEY = "daniel.rwe-studio";
    const qNames = ["q_pop", "q_exp", "q_comp", "q_out"];
    const saveQ = () => {
      const s = {};
      qNames.forEach((n) => { const e = document.querySelector('[name="' + n + '"]'); if (e) s[n] = e.value; });
      const d = document.querySelector('[name="design"]:checked'); s.design = d ? d.value : "";
      try { localStorage.setItem(Q_KEY, JSON.stringify(s)); } catch (e) {}
    };
    (() => {
      try {
        const s = JSON.parse(localStorage.getItem(Q_KEY) || "null"); if (!s) return;
        qNames.forEach((n) => { const e = document.querySelector('[name="' + n + '"]'); if (e && s[n] != null) e.value = s[n]; });
        if (s.design) { const r = document.querySelector('[name="design"][value="' + s.design + '"]'); if (r) r.checked = true; }
      } catch (e) {}
    })();
    document.querySelectorAll('[name="q_pop"],[name="q_exp"],[name="q_comp"],[name="q_out"],[name="design"]').forEach((e) => e.addEventListener("input", saveQ));

    // ── Clear & start over ──────────────────────────────────────────────────
    // The page saves the question and design on every keystroke and says so
    // nowhere obvious, so a restored value is indistinguishable from a shipped
    // default — and there was no way back to a blank form without dev tools.
    // Only keys this page owns are removed; another page's storage is never
    // touched, for the same reason it is never written.
    const ownKeys = () => {
      const out = [];
      try { for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k === Q_KEY || (k && k.indexOf(Q_KEY + ".") === 0)) out.push(k); } } catch (e) {}
      return out;
    };
    $("clearall").addEventListener("click", () => {
      const keys = ownKeys();
      const bits = [];
      if (keys.length) bits.push("the saved question and design");
      if (DATA.rows.length) bits.push("the loaded dataset (" + DATA.rows.length + " rows) and its column mapping");
      if (LAST) bits.push("the analysis results");
      if (!bits.length) bits.push("this form");
      if (!confirm("Clear " + bits.join(", ") + "?\n\nNothing here was ever uploaded, so this only affects this browser.")) return;
      keys.forEach((k) => { try { localStorage.removeItem(k); } catch (e) {} });
      qNames.forEach((n) => { const e = document.querySelector('[name="' + n + '"]'); if (e) e.value = ""; });
      document.querySelectorAll('[name="design"]').forEach((r) => { r.checked = false; });
      ["s_policy", "s_twodrugs", "s_transient", "s_acute"].forEach((n) => { const e = document.querySelector('[name="' + n + '"]'); if (e) e.checked = false; });
      $("suggestmsg").textContent = "";
      // Unload the dataset and everything derived from it, so no later step is
      // left pointing at data that is gone.
      DATA = { rows: [], columns: [], profile: [], name: "dataset" };
      WB = null; SHEETS = []; SPLITINFO = null; CBWB = null; CBNAME = ""; CODEBOOK = {}; CBINFO = null;
      STRUCT = { sheet: "", headerRow: 0, split: false, unit: "", unitConf: "low", idCol: "", idConf: "low", repeats: 0, repeatKind: "none", dateCols: [], dayFirst: false, vocabs: [], yes: {} };
      YMCACHE = null; MAP = {}; COVS = []; COVROLE = {}; PSCSPLIT = {}; PSCRUN = null; MASTER = null; LAST = null;
      ["file", "cbfile"].forEach((id) => { const e = $(id); if (e) e.value = ""; });
      ["results", "mapcard", "cleancard", "anacard", "expcard", "demonote", "anaresults", "table1", "itschart", "routput", "dlfitted", "pscresults"].forEach((id) => { const e = $(id); if (e) e.classList.add("hidden"); });
      ["fileinfo", "cbinfo", "cleaninfo", "anastatus", "mapmsg", "covnote"].forEach((id) => { const e = $(id); if (e) e.textContent = ""; });
      setMsg("Cleared. The four boxes above show their grey examples again — those are hints, not values.");
      try { window.scrollTo({ top: 0, behavior: "smooth" }); } catch (e) { window.scrollTo(0, 0); }
    });

    const DESIGN_LABEL = { acnu: "Active-comparator new-user cohort", sccs: "Self-controlled case series", cco: "Case-crossover", its: "Interrupted time series" };
    $("suggest").addEventListener("click", () => {
      const ck = (n) => { const e = document.querySelector('[name="' + n + '"]'); return !!(e && e.checked); };
      let v, why;
      if (ck("s_policy")) { v = "its"; why = "a population-level intervention with a clear start date is evaluated by interrupted time series — the pre-intervention trend, projected forward, is the counterfactual."; }
      else if (ck("s_twodrugs")) { v = "acnu"; why = "you're comparing two active treatments — an active-comparator new-user cohort minimises confounding by indication."; }
      else if (ck("s_transient") && ck("s_acute")) { v = "sccs"; why = "a transient exposure with an acute outcome suits a self-controlled design (each case is its own control); a case-crossover is a good alternative."; }
      // A transient exposure is the case-crossover's defining premise, not a
      // nicety: it contrasts a hazard window against that person's OWN earlier
      // control windows, so a case on the drug throughout is concordant and
      // contributes nothing. Routing on the outcome alone recommended a
      // case-crossover to a user who had just declined to tick "exposure is
      // transient", and the sentence named only the outcome — so the condition
      // that made the recommendation false was the box left unticked. The branch
      // above already covers transient+acute and names the case-crossover as the
      // alternative there; this one says what is missing instead of guessing.
      else if (ck("s_acute")) { v = "acnu"; why = "an acute outcome does suit a self-controlled design, but both of them — case-crossover and SCCS — need a transient exposure, because each case has to have on-drug and off-drug time of their own to compare. You have not said the exposure is transient, so this falls back to an active-comparator new-user cohort. If the drug is started and stopped, tick “Exposure is transient” for a sharper suggestion."; }
      else { v = "acnu"; why = "defaulting to an active-comparator new-user cohort — tick more boxes for a sharper suggestion."; }
      const r = document.querySelector('[name="design"][value="' + v + '"]'); if (r) { r.checked = true; r.dispatchEvent(new Event("change", { bubbles: true })); saveQ(); }
      $("suggestmsg").textContent = "Recommended: " + DESIGN_LABEL[v] + " — " + why;
    });

    // ── Steps 3–6: map → clean → analyse (R) → export ──
    // Shared R guards. A role that must be 0/1 has to actually be 0/1, and a role
    // that must be numeric has to hold numbers. as.numeric() on text yields NA,
    // and every design here would then carry on and print a number computed from
    // a variable that silently left the model. Refuse instead, and say what to fix.
    // Every machine-readable line R writes back is pipe-delimited and split on "|"
    // in the browser, so a pipe inside a column name or a factor level shifts every
    // later cell one place: `Sex (M|F)` puts "F), n (%)" in the comparator column
    // and leaves the balance column showing the BEFORE-weighting SMD — the one
    // number that column exists to report. A newline is worse: the row breaks in
    // two and the covariate loses all its values. Neither can be escaped at the
    // split, so both are removed on the way in. Same species as the amendments-log
    // row a pipe used to shift, fixed in ProtocolCommon.
    const PIPE_SAFE = (s) => String(s == null ? "" : s).replace(/[|\r\n]+/g, " ");
    // For the handful of strings whose pipe IS the stream prefix ("RESULT_NOTE|…").
    // Those interpolate the user's text themselves, through PIPE_SAFE.
    const qraw = (s) => "'" + String(s == null ? "" : s).replace(/\\/g, "\\\\").replace(/'/g, "\\'") + "'";
    // R-side twin, for strings that come from the data rather than from the form.
    const R_SQ = "sq<-function(s) gsub('[|\\r\\n]+',' ',s)\n";
    const R_CHK01 = "chk01<-function(v,nm){ x<-suppressWarnings(as.numeric(v)); u<-unique(x[!is.na(x)]); if(length(u)==0 || !all(u %in% c(0,1))) stop(sprintf('The column mapped to %s is not coded 0/1 (values seen: %s). Say which value means yes under \"Coded flags\" in the structure panel, or map a different column.', nm, paste(head(unique(as.character(v)),6),collapse=', '))); x }\n";
    const R_CHKNUM = "chknum<-function(v,nm){ x<-suppressWarnings(as.numeric(v)); if(all(is.na(x))) stop(sprintf('The column mapped to %s holds no numeric values (values seen: %s).', nm, paste(head(unique(as.character(v)),6),collapse=', '))); x }\n";
    const SPEC = {
      acnu: {
        label: "Active-comparator new-user cohort",
        hint: "One row per new user. Map treatment (1=exposure, 0=comparator), follow-up time, and the outcome event; tick baseline covariates for the propensity score.",
        covariates: true,
        onePerPerson: true,
        roles: [
          { k: "TREAT", label: "Treatment (1=exposure, 0=comparator)", types: ["binary", "number"], req: true },
          { k: "TIME", label: "Follow-up time (days)", types: ["number"], req: true },
          { k: "EVENT", label: "Outcome event (0/1)", types: ["binary", "number"], req: true },
          { k: "DISC", label: "Time to discontinuation / switch (days, for PP)", types: ["number"], req: false },
        ],
        rscript: (covInfo, opts) => {
          opts = opts || {};
          covInfo = covInfo || [];
          const q = (s) => "'" + PIPE_SAFE(s).replace(/\\/g, "\\\\").replace(/'/g, "\\'") + "'";
          const M = opts.methods || [], E = (opts.estimands && opts.estimands.length) ? opts.estimands : ["ITT"], ratio = opts.ratio || 2, ns = opts.nstrata || 10;
          const dropped = opts.dropped || [];
          let r = "d<-read.csv('/data.csv', stringsAsFactors=FALSE); library(survival)\n";
          // A covariate has to enter the model as what it is. as.numeric() on a text
          // column yields all-NA, which drops it from the propensity model silently —
          // the only symptom being crude and adjusted estimates that agree exactly.
          r += R_CHK01 + R_CHKNUM + R_SQ;
          r += "d$TREAT<-chk01(d$TREAT,'Treatment'); d$EVENT<-chk01(d$EVENT,'Outcome event'); d$TIME<-chknum(d$TIME,'Follow-up time')\n";
          r += "covs<-c(" + covInfo.map((c) => q(c.col)).join(",") + "); covsrc<-c(" + covInfo.map((c) => q(c.label)).join(",") + "); covkind<-c(" + covInfo.map((c) => q(c.kind)).join(",") + ")\n";
          r += "if(length(covs)==0) stop('None of the ticked covariates can be used in a propensity model — see the note under the covariate list.')\n";
          r += "need<-c('TREAT','TIME','EVENT',covs)\n";
          r += "for(cc in need) d[[cc]][trimws(as.character(d[[cc]]))=='']<-NA\n";
          r += "okr<-complete.cases(d[,need,drop=FALSE]); if(sum(!okr)>0) cat('RESULT_NOTE|Dropped ',sum(!okr),' row(s) with a missing treatment, follow-up time, outcome, or covariate value.\\n',sep='')\n";
          r += "d<-d[okr,,drop=FALSE]\n";
          r += "for(i in seq_along(covs)){ if(covkind[i]=='factor') d[[covs[i]]]<-factor(trimws(as.character(d[[covs[i]]]))) else d[[covs[i]]]<-suppressWarnings(as.numeric(d[[covs[i]]])) }\n";
          r += "psm<-suppressWarnings(glm(as.formula(paste('TREAT ~', paste(covs, collapse=' + '))), data=d, family=binomial))\n";
          r += "alias<-names(coef(psm))[is.na(coef(psm))]; if(length(alias)) cat('RESULT_NOTE|',length(alias),' propensity-model term(s) were collinear with the rest and dropped: ',paste(alias,collapse=', '),'.\\n',sep='')\n";
          r += "ps<-as.numeric(predict(psm, type='response'))\n";
          r += "ps<-pmin(pmax(ps,1e-6),1-1e-6); d$lp<-qlogis(ps); tr<-d$TREAT==1; n<-nrow(d)\n";
          // ── Positivity ────────────────────────────────────────────────────
          // A propensity model always returns a number. It returns one just as
          // readily when an arm has no comparable members at all, and the weighted
          // hazard ratio that follows looks exactly like a real one. So the common
          // support is measured, and the weights it produces are inspected, before
          // anything is reported.
          r += "trimmode<-'" + (opts.trim || "none") + "'\n";
          r += "psT<-ps[tr]; psC<-ps[!tr]; csLo<-max(min(psT),min(psC)); csHi<-min(max(psT),max(psC))\n";
          r += "outT<-sum(psT<csLo | psT>csHi); outC<-sum(psC<csLo | psC>csHi)\n";
          r += "keep<-rep(TRUE,n); trimlab<-'none'\n";
          r += "if(trimmode=='cs'){ keep<-ps>=csLo & ps<=csHi; trimlab<-'restricted to the region of common support' }\n";
          r += "if(trimmode=='pct'){ lo1<-as.numeric(quantile(ps,0.01)); hi1<-as.numeric(quantile(ps,0.99)); keep<-ps>=lo1 & ps<=hi1; trimlab<-'trimmed to the 1st-99th percentile of the propensity score' }\n";
          r += "ntrim<-sum(!keep)\n";
          r += "if(ntrim>0){ cat('RESULT_NOTE|Cohort ',trimlab,': ',ntrim,' of ',n,' row(s) removed before every estimate below, so all rows are comparable. This changes the population the effect refers to.\\n',sep='')\n";
          r += "  d<-d[keep,,drop=FALSE]; ps<-ps[keep]; tr<-tr[keep]; n<-nrow(d); d$lp<-qlogis(ps); psT<-ps[tr]; psC<-ps[!tr]\n";
          // outT/outC were counted on the cohort BEFORE the restriction, and nT/nC
          // are reported after it. Printed together they said "245 of 555 patients
          // lie outside the range" about the 245 that had just been removed — and
          // then advised the restriction the user had already applied. Recount on
          // the cohort that is actually being analysed.
          r += "  csLo<-max(min(psT),min(psC)); csHi<-min(max(psT),max(psC))\n";
          r += "  outT<-sum(psT<csLo | psT>csHi); outC<-sum(psC<csLo | psC>csHi) }\n";
          // ── Weights ───────────────────────────────────────────────────────
          // Stabilised by default: the numerator is the marginal probability of the
          // treatment actually received rather than 1. Same estimand, far tamer
          // weight distribution. Truncation is the fallback, and only on request.
          // NOTE: neither of these touches positivity. They make an unstable number
          // stable; they cannot manufacture a comparator who does not exist, which
          // is why the common-support check above is reported on its own terms and
          // is never satisfied by a healthy weight profile.
          r += "wtmode<-'" + (opts.wts || "stab") + "'; truncmode<-'" + (opts.trunc || "none") + "'\n";
          r += "pT<-mean(tr)\n";
          r += "wU<-ifelse(tr,1/ps,1/(1-ps))\n";
          r += "wS<-ifelse(tr,pT/ps,(1-pT)/(1-ps))\n";
          r += "w0<-if(wtmode=='unstab') wU else wS\n";
          r += "qq<-if(truncmode=='p1') 0.01 else if(truncmode=='p5') 0.05 else NA_real_\n";
          r += "wI<-w0; ntrunc<-0; trunclab<-'none'\n";
          r += "if(!is.na(qq)){ tlo<-as.numeric(quantile(w0,qq)); thi<-as.numeric(quantile(w0,1-qq)); ntrunc<-sum(w0<tlo | w0>thi); wI<-pmin(pmax(w0,tlo),thi); trunclab<-sprintf('%.0f/%.0f percentile',100*qq,100*(1-qq)) }\n";
          r += "wdiag<-function(w){ e<-sum(w)^2/sum(w^2); k<-max(1,ceiling(0.01*length(w))); c(e, 100*e/length(w), max(w), 100*sum(sort(w,decreasing=TRUE)[1:k])/sum(w)) }\n";
          r += "dU<-wdiag(wU); dS<-wdiag(wS); dF<-wdiag(wI)\n";
          r += "essPct<-dF[2]; maxw<-dF[3]; top1<-dF[4]\n";
          // Refusal is now the last resort, not the first: stabilisation and
          // truncation are both on the table before anything is withheld.
          r += "unstable<-(essPct<10) || (top1>25)\n";
          r += "rescuable<-unstable && truncmode=='none'\n";
          // Every weighting estimator has to be judged on ITS OWN weights. wdiag()
          // used to be applied to the IPTW weights alone, so an SMR-weighted hazard
          // ratio resting on a SMALLER effective sample than the IPTW estimate the
          // tool had just refused was printed with no comment at all — and the panel
          // told the reader "the other estimators are unaffected".
          // Overlap weights are bounded in [0,1] by construction, so a small
          // effective sample there means the equipoise population is small, not that
          // a handful of patients carry the answer. Those diagnostics are reported
          // and explained; they are never used to withhold.
          r += "wSMR<-ifelse(tr,1,ps/(1-ps)); wOVL<-ifelse(tr,1-ps,ps)\n";
          r += "wgate<-function(z) (z[2]<10) || (z[4]>25)\n";
          r += "zSMR<-wdiag(wSMR); smrbad<-wgate(zSMR); zOVL<-wdiag(wOVL)\n";
          // Non-overlap has to reach the estimates table too. Someone reading only
          // the hazard ratios must not be able to miss that a large share of the
          // cohort has no counterpart — the weights can look perfect regardless.
          r += "outPct<-100*(outT+outC)/n\n";
          r += "if(ntrim==0 && (outT+outC)>0) cat(sprintf('RESULT_NOTE|%d of %d patient(s) (%.1f%%) have no counterpart in the other arm at their propensity score. Every weighted estimate above extrapolates for them rather than comparing them with anyone. Stabilising or truncating the weights does not change this - restricting to common support does.\\n', outT+outC, n, outPct))\n";
          r += "if(ntrunc>0 && outPct>5) cat('RESULT_NOTE|Truncation was applied while a substantial part of the cohort has no overlap. Truncation tidies the arithmetic; it does not create the missing comparators, so the weight diagnostics will look far healthier than the comparison actually is. Restrict to common support before trusting a truncated estimate here.\\n')\n";
          r += "bi<-function(v) tabulate(pmin(20,pmax(1,ceiling(v*20))),nbins=20)\n";
          r += "cat('PSHIST|',paste(bi(psT),collapse=','),'|',paste(bi(psC),collapse=','),'\\n',sep='')\n";
          r += "fmw<-function(v) paste(sprintf('%.1f',v),collapse=',')\n";
          r += "cat('PSDIAG|nT=',sum(tr),'|nC=',sum(!tr),'|csLo=',sprintf('%.4f',csLo),'|csHi=',sprintf('%.4f',csHi),'|outT=',outT,'|outC=',outC,'|dU=',fmw(dU),'|dS=',fmw(dS),'|dF=',fmw(dF),'|wtmode=',wtmode,'|trunc=',trunclab,'|ntrunc=',ntrunc,'|minps=',sprintf('%.4f',min(ps)),'|maxps=',sprintf('%.4f',max(ps)),'|ntrim=',ntrim,'|trim=',trimlab,'|unstable=',if(unstable) 1 else 0,'|rescuable=',if(rescuable) 1 else 0,'\\n',sep='')\n";
          // One line per weighting scheme the user actually asked for. Field 4 is
          // whether the scheme failed its own stability rule; field 5 is whether
          // failing it withholds the estimate (true for the inverse-probability
          // family, false for overlap weights — see above).
          if (M.indexOf("iptw") >= 0) r += "cat('PSW|IPTW (ATE)|',fmw(dF),'|',if(unstable) 1 else 0,'|1\\n',sep='')\n";
          if (M.indexOf("smrw") >= 0) r += "cat('PSW|SMR weighting (ATT)|',fmw(zSMR),'|',if(smrbad) 1 else 0,'|1\\n',sep='')\n";
          if (M.indexOf("overlap") >= 0) r += "cat('PSW|Overlap weighting (ATO)|',fmw(zOVL),'|',if(wgate(zOVL)) 1 else 0,'|0\\n',sep='')\n";
          r += "cat(sprintf('N = %d; exposure = %d; comparator = %d; events = %d\\n\\n', n, sum(tr), sum(!tr), sum(d$EVENT==1,na.rm=TRUE)))\n";
          r += "cat('RESULT_NOTE|Propensity model: ',sum(covkind=='numeric'),' continuous, ',sum(covkind=='binary'),' binary 0/1, ',sum(covkind=='factor'),' categorical entered as dummy-coded factors',if(any(covkind=='factor')) paste0(' (',paste(covsrc[covkind=='factor'],collapse=', '),')') else '','.\\n',sep='')\n";
          if (dropped.length) r += "cat(" + qraw("RESULT_NOTE|" + dropped.length + " ticked covariate(s) were left out of the model: " + dropped.map((x) => PIPE_SAFE(x.src) + " — " + x.why).join("; ") + ".") + ",'\\n',sep='')\n";
          const folded = covInfo.filter((c) => c.collapsed);
          if (folded.length) r += "cat(" + qraw("RESULT_NOTE|Rare categories were folded into 'other' before modelling: " + folded.map((c) => PIPE_SAFE(c.src) + " (" + c.rare.length + " of " + c.levels + " levels, each with fewer than " + COV_MIN_PER_LEVEL + " rows)").join("; ") + ".") + ",'\\n',sep='')\n";
          r += "wsmd<-function(x,g,w){ ok<-!is.na(x); a<-g&ok; b<-(!g)&ok; if(sum(a)<1||sum(b)<1) return(NA_real_); m1<-weighted.mean(x[a],w[a]); m0<-weighted.mean(x[b],w[b]); v1<-sum(w[a]*(x[a]-m1)^2)/sum(w[a]); v0<-sum(w[b]*(x[b]-m0)^2)/sum(w[b]); (m1-m0)/sqrt((v1+v0)/2) }\n";
          // Yang & Dalton (2012) multinomial standardised difference: a categorical
          // variable needs the Mahalanobis form, not the continuous one.
          r += "smdcat<-function(f,g,w){ lv<-levels(f); k<-length(lv); if(k<2) return(NA_real_); pr<-function(idx){ ww<-w[idx]; s<-sum(ww); vapply(lv,function(l) sum(ww[f[idx]==l])/s, 0) }; p1<-pr(g); p0<-pr(!g); if(k==2) return((p1[2]-p0[2])/sqrt((p1[2]*(1-p1[2])+p0[2]*(1-p0[2]))/2)); i<-2:k; mk<-function(p){ pv<-as.numeric(p[i]); m<-diag(pv*(1-pv), nrow=length(pv)); for(a in seq_along(pv)) for(b in seq_along(pv)) if(a!=b) m[a,b]<- -pv[a]*pv[b]; m }; S<-(mk(p1)+mk(p0))/2; dv<-as.numeric(p1[i]-p0[i]); tryCatch(as.numeric(sqrt(t(dv)%*%solve(S)%*%dv)), error=function(e) NA_real_) }\n";
          // Balance BEFORE and AFTER weighting. The before column alone tells a
          // reviewer nothing about whether the model fixed anything.
          // The "after" column has to be weighted by a scheme that was actually
          // fitted. It was hardcoded to the IPTW weights, so unticking IPTW left a
          // column headed "SMD after IPTW" in a run where no IPTW estimate existed.
          // With no weighting estimator selected at all there is nothing honest to
          // put here — balance after matching or stratification is a different
          // table this tool does not build — so the column is left empty and said so.
          // Prefer the weights behind an estimate that was actually reported, so the
          // balance column is not describing a scheme the panel just withheld.
          const balSch = M.indexOf("iptw") >= 0 || M.indexOf("smrw") >= 0 || M.indexOf("overlap") >= 0;
          r += "wBAL<-NULL; ballab<-''\n";
          const pick = (cond, v, lab) => (cond ? "if(is.null(wBAL) && " + v[1] + "){ wBAL<-" + v[0] + "; ballab<-" + q(lab) + " }\n" : "");
          r += pick(M.indexOf("iptw") >= 0, ["wI", "!unstable"], "IPTW");
          r += pick(M.indexOf("smrw") >= 0, ["wSMR", "!smrbad"], "SMR weighting");
          r += pick(M.indexOf("overlap") >= 0, ["wOVL", "TRUE"], "overlap weighting");
          r += pick(M.indexOf("iptw") >= 0, ["wI", "TRUE"], "IPTW");
          r += pick(M.indexOf("smrw") >= 0, ["wSMR", "TRUE"], "SMR weighting");
          r += "smd1<-rep(NA_real_,length(covs)); smd2<-rep(NA_real_,length(covs))\n";
          r += "f3<-function(x) if(!is.finite(x)) '-' else sprintf('%.3f',x)\n";
          r += "cat('TABLE1|Characteristic|Comparator (n=',sum(!tr),')|Exposure (n=',sum(tr),')|SMD|',if(is.null(wBAL)) 'SMD after weighting (none fitted)' else paste0('SMD after ',ballab),'\\n',sep='')\n";
          r += "for(i in seq_along(covs)){ cc<-covs[i]; lab<-covsrc[i]\n" +
               "  if(covkind[i]=='factor'){ f<-d[[cc]]; lv<-levels(f)\n" +
               "    s1<-smdcat(f,tr,rep(1,n)); s2<-if(is.null(wBAL)) NA_real_ else smdcat(f,tr,wBAL); smd1[i]<-s1; smd2[i]<-s2\n" +
               "    cat(sprintf('TABLE1|%s, n (%%)|||%s|%s\\n', lab, f3(s1), f3(s2)))\n" +
               "    for(l in lv){ a<-sum(f[!tr]==l); b<-sum(f[tr]==l); cat(sprintf('TABLE1|  %s|%d (%.1f%%)|%d (%.1f%%)||\\n', sq(l), a, 100*a/sum(!tr), b, 100*b/sum(tr))) }\n" +
               "  } else { x<-d[[cc]]\n" +
               "    s1<-wsmd(x,tr,rep(1,n)); s2<-if(is.null(wBAL)) NA_real_ else wsmd(x,tr,wBAL); smd1[i]<-s1; smd2[i]<-s2\n" +
               "    if(covkind[i]=='binary'){ a<-sum(x[!tr]==1,na.rm=TRUE); b<-sum(x[tr]==1,na.rm=TRUE); cat(sprintf('TABLE1|%s, n (%%)|%d (%.1f%%)|%d (%.1f%%)|%s|%s\\n', lab, a, 100*a/sum(!tr), b, 100*b/sum(tr), f3(s1), f3(s2)))\n" +
               "    } else cat(sprintf('TABLE1|%s, mean (SD)|%.2f (%.2f)|%.2f (%.2f)|%s|%s\\n', lab, mean(x[!tr],na.rm=TRUE), sd(x[!tr],na.rm=TRUE), mean(x[tr],na.rm=TRUE), sd(x[tr],na.rm=TRUE), f3(s1), f3(s2))) } }\ncat('\\n')\n";
          r += "mxof<-function(v) if(all(!is.finite(v))) NA_real_ else max(abs(v[is.finite(v)]))\n";
          r += "mx1<-mxof(smd1); mx2<-mxof(smd2)\n";
          r += "cat('PSBAL|mx1=',f3(mx1),'|mx2=',f3(mx2),'|nbad=',sum(abs(smd2)>0.1,na.rm=TRUE),'|ncov=',length(covs),'|wlab=',ballab,'\\n',sep='')\n";
          if (!balSch) r += "cat('RESULT_NOTE|No weighted estimator was selected, so there is no weighted balance column: the standardised differences shown are before any adjustment. Balance after matching or after fine stratification is a separate table this tool does not build - check it in your own analysis before reporting the matched estimate.\\n')\n";
          r += "ET<-list(); EE<-list(); ET[['ITT']]<-d$TIME; EE[['ITT']]<-d$EVENT\n";
          if (E.indexOf("PP") >= 0) r += "if('DISC' %in% names(d)){ disc<-ifelse(is.na(d$DISC), Inf, as.numeric(d$DISC)); ET[['PP']]<-pmin(d$TIME, disc); EE[['PP']]<-d$EVENT*(d$TIME<=disc) }\n";
          r += "fitw<-function(t,e,w,idx,label,quiet=FALSE){ dd<-data.frame(t=t[idx],e=e[idx],TREAT=d$TREAT[idx],w=w[idx]); fit<-tryCatch(coxph(Surv(t,e)~TREAT,data=dd,weights=w,robust=TRUE),error=function(x)NULL); if(is.null(fit)){ if(!quiet) cat(sprintf('RESULT_ESTIMATE|%s|not estimable\\n',label)); return(NA_real_)}; s<-summary(fit); if(!quiet) cat(sprintf('RESULT_ESTIMATE|%s|%.2f (95%% CI %.2f-%.2f)\\n', label, s$conf.int[1,'exp(coef)'], s$conf.int[1,'lower .95'], s$conf.int[1,'upper .95'])); invisible(as.numeric(s$conf.int[1,'exp(coef)'])) }\n";
          if (M.indexOf("matching") >= 0) r += "matchidx<-function(){ ci<-which(!tr); ti<-which(tr); used<-logical(n); cal<-0.2*sd(d$lp); out<-integer(0); ord<-ti[order(d$lp[ti])]; for(i in ord){ cand<-ci[!used[ci]]; if(!length(cand))next; dd<-abs(d$lp[cand]-d$lp[i]); o<-order(dd); k<-0; for(j in o){ if(dd[j]<=cal){ out<-c(out,i,cand[j]); used[cand[j]]<-TRUE; k<-k+1; if(k>=" + ratio + ")break } } }; unique(out) }\n";
          r += "for(est in names(ET)){ t<-ET[[est]]; e<-EE[[est]]; all<-1:n\n";
          r += "  fitw(t,e,rep(1,n),all, paste0('Crude - ',est,' HR'))\n";
          // An IPTW estimate built on collapsed weights is not a weak estimate, it
          // is an arbitrary one: a handful of subjects carry the answer. Refuse it
          // and say which diagnostic failed, rather than print a confident number.
          if (M.indexOf("iptw") >= 0) r += "  if(unstable){ cat(sprintf('RESULT_ESTIMATE|IPTW (ATE) - %s HR|withheld - weights unstable\\n',est)) } else { hrT<-fitw(t,e,wI,all, paste0('IPTW (ATE)',if(wtmode=='stab') ', stabilised' else ', unstabilised', if(ntrunc>0) paste0(', truncated at the ',trunclab) else '',' - ',est,' HR'))\n" +
            "    if(ntrunc>0){ hr0<-fitw(t,e,w0,all,'',TRUE); if(is.finite(hr0) && is.finite(hrT)) cat(sprintf('RESULT_NOTE|Truncation moved the %s IPTW hazard ratio from %.3f (untruncated) to %.3f, by capping %d weight(s) at the %s. Truncation buys precision by accepting a little bias - the capped patients are no longer counted at their full weight - so report the untruncated estimate alongside it.\\n', est, hr0, hrT, ntrunc, trunclab)) } }\n";
          // SMR weights are 1 for the treated and the treatment odds for everyone
          // else: unbounded above, and just as capable of collapsing onto a handful
          // of comparators as the IPTW weights. Same rule, same refusal.
          if (M.indexOf("smrw") >= 0) r += "  if(smrbad){ cat(sprintf('RESULT_ESTIMATE|SMR weighting (ATT) - %s HR|withheld - weights unstable\\n',est)) } else fitw(t,e,wSMR,all, paste0('SMR weighting (ATT) - ',est,' HR'))\n";
          if (M.indexOf("overlap") >= 0) r += "  fitw(t,e,wOVL,all, paste0('Overlap weighting (ATO) - ',est,' HR'))\n";
          // A stratum containing only one arm contributes nothing to a stratified
          // Cox model, so its patients are dropped. That was happening in silence:
          // on the tool's own no-overlap demo, 20% of the cohort at 10 strata and
          // 42% at 50 strata vanished from an estimate printed as if it described
          // everyone. The count now travels with the estimate, as it already does
          // for matching.
          if (M.indexOf("finestrat") >= 0) r += "  { br<-unique(quantile(ps,probs=seq(0,1,length.out=" + (ns + 1) + "))); if(length(br)>=3){ q<-cut(ps,breaks=br,include.lowest=TRUE,labels=FALSE); keep<-ave(as.integer(tr),q,FUN=function(z)length(unique(z)))==2; ok<-which(keep); dd<-data.frame(t=t[ok],e=e[ok],TREAT=d$TREAT[ok],st=q[ok]); fit<-tryCatch(coxph(Surv(t,e)~TREAT+strata(st),data=dd),error=function(x)NULL); if(!is.null(fit)){s<-summary(fit); cat(sprintf('RESULT_ESTIMATE|Fine stratification (" + ns + " strata, %d of %d patients) - %s HR|%.2f (95%% CI %.2f-%.2f)\\n',length(ok),n,est,s$conf.int[1,'exp(coef)'],s$conf.int[1,'lower .95'],s$conf.int[1,'upper .95']))\n" +
            "    if(length(ok)<n) cat(sprintf('RESULT_NOTE|Fine stratification discarded %d of %d patient(s) (%.1f%%) who fell in a propensity stratum holding only one arm - there is nobody to compare them with inside their own stratum. The stratified estimate refers to the remaining %d, not to the cohort you uploaded.\\n', n-length(ok), n, 100*(n-length(ok))/n, length(ok)))} } }\n";
          // "(%d matched)" counted ROWS in the matched cohort, which cannot show
          // that half the exposed found no comparator and were dropped. Greedy
          // matching without replacement takes the easiest-to-match exposed first,
          // so the ones it discards are systematically the highest-propensity,
          // sickest exposed — and the estimate is an ATT among whoever is left, a
          // population nobody chose. Report exposed retained, and say when the
          // requested ratio was arithmetically impossible before matching began.
          if (M.indexOf("matching") >= 0) r += "  { mi<-matchidx(); nex<-sum(tr); nmex<-sum(d$TREAT[mi]==1); if(length(mi)>2){ dd<-data.frame(t=t[mi],e=e[mi],TREAT=d$TREAT[mi]); fit<-tryCatch(coxph(Surv(t,e)~TREAT,data=dd),error=function(x)NULL); if(!is.null(fit)){s<-summary(fit); cat(sprintf('RESULT_ESTIMATE|" + ratio + ":1 PS matching (%d of %d exposed matched) - %s HR, ATT among the matched exposed|%.2f (95%% CI %.2f-%.2f)\\n',nmex,nex,est,s$conf.int[1,'exp(coef)'],s$conf.int[1,'lower .95'],s$conf.int[1,'upper .95']))\n" +
            "    if(nmex<nex) cat(sprintf('RESULT_NOTE|Matching kept %d of %d exposed patient(s): %d found no comparator within the caliper and were dropped. Greedy matching without replacement takes the easiest-to-match exposed first, so the ones left out are systematically those with the highest propensity scores - the estimate is an average treatment effect among the exposed who could be matched, not among the exposed you uploaded.\\n', nmex, nex, nex-nmex))\n" +
            "    if(" + ratio + "*nex > sum(!tr)) cat(sprintf('RESULT_NOTE|A " + ratio + ":1 ratio needs %d comparators for %d exposed and only %d exist, so at least %d exposed could never be matched whatever the caliper allowed. Lower the ratio.\\n', " + ratio + "*nex, nex, sum(!tr), nex-sum(!tr)%/%" + ratio + "))} } }\n";
          r += "}\n";
          // ── Propensity-score calibration (Stürmer 2005; surrogacy per Lunt 2012) ──
          // Everything the ACNU protocol page currently asks to be typed in by hand.
          const P = opts.psc;
          if (P && P.C.length && P.U.length) {
            const qc = (a) => a.map((c) => q(c.col)).join(",");
            r += "cvC<-c(" + qc(P.C) + "); cvU<-c(" + qc(P.U) + ")\n";
            r += "fmlEP<-as.formula(paste('TREAT ~',paste(cvC,collapse=' + '))); fmlGS<-as.formula(paste('TREAT ~',paste(c(cvC,cvU),collapse=' + ')))\n";
            // Probability scale in both models — the convention the protocol page
            // states. alpha1 and alpha2 are not scale-free, so mixing PS in one
            // model with logit(PS) in the other silently invalidates the correction.
            r += "fep<-suppressWarnings(glm(fmlEP,family=binomial,data=d)); fgs<-suppressWarnings(glm(fmlGS,family=binomial,data=d))\n";
            r += "d$psep<-as.numeric(predict(fep,type='response')); d$psgs<-as.numeric(predict(fgs,type='response'))\n";
            r += "cal<-lm(psgs ~ psep + TREAT, data=d); scal<-summary(cal); cc<-coef(scal)\n";
            r += "a0<-cc[1,1]; a1<-cc[2,1]; a2<-cc[3,1]; a1se<-cc[2,2]; a2se<-cc[3,2]; r2<-scal$r.squared\n";
            // Surrogacy: Y independent of PS_ep given (T, PS_gs). S is the share of
            // the outcome information carried by BOTH scores that the gold-standard
            // score carries alone, as a ratio of likelihood-ratio statistics against
            // a treatment-only model (Lunt 2012, Table 2 footnote g). Nested models,
            // so S is always in [0,100].
            r += "sv<-Surv(d$TIME,d$EVENT)\n";
            r += "m0<-coxph(sv~TREAT,data=d); m1<-coxph(sv~TREAT+psgs,data=d); m2<-coxph(sv~TREAT+psgs+psep,data=d)\n";
            r += "l0<-as.numeric(logLik(m0)); l1<-as.numeric(logLik(m1)); l2<-as.numeric(logLik(m2))\n";
            r += "LR1<-2*(l1-l0); LR2<-2*(l2-l0)\n";
            r += "Sv<-if(is.finite(LR2) && LR2>1e-8) max(0,min(100,100*LR1/LR2)) else NA_real_\n";
            r += "cm<-summary(m2)$coefficients; scoef<-cm['psep','coef']; sp<-cm['psep',ncol(cm)]\n";
            // A demonstration ON THIS DATA of whether the correction helps: fit the
            // claims-only analogue, correct it, and compare with the gold standard.
            r += "mn<-coxph(sv~TREAT+psep,data=d); bT<-coef(mn)['TREAT']; bPS<-coef(mn)['psep']\n";
            r += "mg<-coxph(sv~TREAT+psgs,data=d); bG<-coef(mg)['TREAT']\n";
            r += "bcal<-if(is.finite(a1) && abs(a1)>1e-8) bT-(a2/a1)*bPS else NA_real_\n";
            r += "BB<-" + (P.boot || 0) + "; A1<-numeric(0); A2<-numeric(0); RT<-numeric(0); bfail<-0\n";
            if (P.boot > 0) {
              r += "set.seed(1); nn<-nrow(d)\n";
              r += "for(bi in 1:BB){ ii<-sample.int(nn,nn,replace=TRUE); db<-d[ii,,drop=FALSE]\n";
              r += "  rr<-tryCatch({ e1<-suppressWarnings(glm(fmlEP,family=binomial,data=db)); g1<-suppressWarnings(glm(fmlGS,family=binomial,data=db))\n";
              r += "    db$psep<-as.numeric(predict(e1,type='response')); db$psgs<-as.numeric(predict(g1,type='response'))\n";
              r += "    co<-coef(lm(psgs ~ psep + TREAT, data=db)); c(co[2],co[3]) }, error=function(x) NULL)\n";
              r += "  if(is.null(rr) || any(!is.finite(rr)) || abs(rr[1])<1e-8){ bfail<-bfail+1; next }\n";
              r += "  A1<-c(A1,rr[1]); A2<-c(A2,rr[2]); RT<-c(RT,rr[2]/rr[1]) }\n";
            }
            r += "qn<-function(v,p) if(length(v)>=20) as.numeric(quantile(v,p,names=FALSE)) else NA_real_\n";
            r += "fm<-function(x) if(length(x)==0 || !is.finite(x)) 'NA' else sprintf('%.6g',x)\n";
            r += "cat(paste0('PSC|ev=',sum(d$EVENT==1,na.rm=TRUE),'|a0=',fm(a0),'|a1=',fm(a1),'|a1se=',fm(a1se),'|a2=',fm(a2),'|a2se=',fm(a2se),'|r2=',fm(r2),'|n=',nrow(d),'|nC=',length(cvC),'|nU=',length(cvU),'|S=',fm(Sv),'|scoef=',fm(scoef),'|sp=',fm(sp),'|ratio=',fm(a2/a1),'|B=',length(A1),'|bfail=',bfail,'|a1lo=',fm(qn(A1,0.025)),'|a1hi=',fm(qn(A1,0.975)),'|a2lo=',fm(qn(A2,0.025)),'|a2hi=',fm(qn(A2,0.975)),'|rlo=',fm(qn(RT,0.025)),'|rhi=',fm(qn(RT,0.975)),'|bT=',fm(bT),'|bPS=',fm(bPS),'|bcal=',fm(bcal),'|bG=',fm(bG)),'\\n')\n";
            r += "cat('\\n--- Propensity-score calibration ---\\n')\n";
            r += "cat(sprintf('PS_gs = %.4f + %.4f x PS_ep + %.4f x T   (R2 %.3f, n %d)\\n', a0, a1, a2, r2, nrow(d)))\n";
            r += "cat(sprintf('Surrogacy: S = %.1f%%; PS_ep coefficient %.4f (p = %.4g)\\n', Sv, scoef, sp))\n";
          } else if (P) {
            r += "cat('PSCSKIP|" + (P.why || "not computed") + "\\n')\n";
          }
          return r;
        },
      },
      sccs: {
        label: "Self-controlled case series",
        hint: "Long format — one row per person-interval. Map the case ID, an exposed indicator (0/1), the event count in the interval, and the interval length (person-time).",
        covariates: false,
        roles: [
          { k: "ID", label: "Case ID", types: ["id", "number", "text"], req: true },
          { k: "EXPOSED", label: "Exposed indicator (0/1)", types: ["binary", "number"], req: true },
          { k: "EVENTS", label: "Event count in interval", types: ["number"], req: true },
          { k: "INTERVAL", label: "Interval length (person-time)", types: ["number"], req: true },
        ],
        rscript: () =>
          // colClasses on ID: read.csv type-guesses an all-numeric case ID to
          // numeric, which drops leading zeros and, past 2^53, low-order digits.
          // Distinct people then merge into one stratum, and the self-controlled
          // estimate slides monotonically towards the confounded pooled estimate
          // printed on the line below it — measured at 363 strata 2.991, 182:
          // 3.300, 91: 3.355, 1: 3.461, against a pooled row of 3.46. At full
          // collapse the design's own contrast row IS the headline. An ID is a
          // label, never a quantity.
          "d<-read.csv('/data.csv', colClasses=c(ID='character'), stringsAsFactors=FALSE)\n" + R_CHK01 + R_CHKNUM +
          "d$EXPOSED<-chk01(d$EXPOSED,'Exposed indicator'); d$EVENTS<-chknum(d$EVENTS,'Event count'); d$INTERVAL<-chknum(d$INTERVAL,'Interval length')\n" +
          // chknum only refuses a column with NO numeric values, so person-time that is
          // numeric but impossible went through. The stratum skip inside the fit tests
          // each case's TOTAL weight, so a few negative rows outweighed by positive ones
          // never trigger it: five negative intervals in 907 rows returned 2.831
          // (2.39-3.35) against a truth of 3.0 - fully formed, plausible, flagged by
          // nothing. Those rows are caught below. They set their CASES aside rather than
          // stopping: WebrEngine has no catch, so a stop() here would discard the whole
          // run including the Table 1 counts that are the evidence for the refusal, and
          // one impossible row in 908 should not cost the other 907.
          "# Counts print as integers when they are integers. %.4g turns 12345 into 1.234e+04 and\n" +
          "# makes 99999 and 100000 the same number, which is no way to report a count.\n" +
          "fmn<-function(z) if(!is.finite(z)) 'NA' else if(abs(z-round(z))<1e-9) sprintf('%.0f',z) else sprintf('%.2f',z)\n" +
          // A rate ratio is not a quantity two fixed decimals can carry. %.2f prints a
          // strongly protective effect and BOTH its limits as 0.00 - a point estimate of
          // exactly zero with a zero-width interval, in the cell the reader copies - and at
          // ordinary magnitudes it still rounds a lower limit of 0.00568 to 0.01, an error of
          // 76% in a published limit. Above 0.1 nothing changes; below it, three significant
          // figures.
          "fmr<-function(z) if(!is.finite(z)) 'NA' else if(z>=0.1) sprintf('%.2f',z) else sprintf('%.3g',z)\n" +
          "# Nothing is printed until the fit has been checked. But a defect in a handful of rows\n" +
          "# sets those CASES aside and says so - it does not refuse the other nine hundred. Only\n" +
          "# a condition that destroys the estimand for everybody refuses outright.\n" +
          "stopq<-character(0); warnq<-character(0)\n" +
          "nneg_t<-sum(d$INTERVAL<0, na.rm=TRUE); nneg_y<-sum(d$EVENTS<0, na.rm=TRUE)\n" +
          "nfrac<-sum(abs(d$EVENTS-round(d$EVENTS))>1e-8, na.rm=TRUE)\n" +
          "nevt0<-sum(d$EVENTS>0 & d$INTERVAL<=0, na.rm=TRUE)\n" +
          "badrow<-(!is.na(d$INTERVAL) & !is.finite(d$INTERVAL)) | (!is.na(d$EVENTS) & !is.finite(d$EVENTS)) |\n" +
        "        (!is.na(d$INTERVAL) & d$INTERVAL<0) | (!is.na(d$EVENTS) & d$EVENTS<0) |\n" +
          "        (!is.na(d$EVENTS) & !is.na(d$INTERVAL) & d$EVENTS>0 & d$INTERVAL<=0) |\n" +
          "        (!is.na(d$EVENTS) & abs(d$EVENTS-round(d$EVENTS))>1e-8)\n" +
          "badids<-unique(d$ID[badrow]); nall<-length(unique(d$ID))\n" +
          "why<-character(0)\n" +
          "if(nneg_t>0) why<-c(why, sprintf('%d row(s) have a negative interval length (smallest %s) - person-time cannot be negative, so check the direction of the date subtraction that produced it', nneg_t, fmn(min(d$INTERVAL,na.rm=TRUE))))\n" +
          "if(nneg_y>0) why<-c(why, sprintf('%d row(s) have a negative event count (smallest %s)', nneg_y, fmn(min(d$EVENTS,na.rm=TRUE))))\n" +
          "if(nfrac>0) why<-c(why, sprintf('%d row(s) have a fractional event count - a self-controlled series conditions on each person s total number of events, so the counts must be whole numbers - if you mapped a rate (events divided by person-time), map the count instead and put the person-time in the interval role', nfrac))\n" +
          "if(nevt0>0) why<-c(why, sprintf('%d row(s) record an event in an interval of zero or negative person-time, which is arithmetically impossible (equal start and stop dates are the usual cause)', nevt0))\n" +
          "if(length(badids)>0){\n" +
          "  msg<-sprintf('%d of %d case(s) were set aside before fitting and contribute nothing below: %s. The whole case is excluded rather than the single row, because removing one interval would change that person s total event count, which is what the conditional likelihood conditions on.', length(badids), nall, paste(why, collapse='; '))\n" +
          "  if(length(badids)>=nall) stopq<-c(stopq, msg) else warnq<-c(warnq, msg)\n" +
          "}\n" +
          "ndropna<-sum(is.na(d$EXPOSED) | is.na(d$EVENTS) | is.na(d$INTERVAL))\n" +
          "ndrop0<-sum(!is.na(d$INTERVAL) & d$INTERVAL<=0 & !is.na(d$EVENTS) & d$EVENTS==0)\n" +
          "okrow<-!badrow & !(d$ID %in% badids) & !is.na(d$EXPOSED) & !is.na(d$EVENTS) & !is.na(d$INTERVAL) & d$INTERVAL>0\n" +
          "a<-d[okrow,,drop=FALSE]\n" +
          "if(nrow(a)==0 && length(stopq)==0) stopq<-c(stopq,'No row has a usable exposure indicator, event count and positive interval length.')\n" +
          "ninf<-0; ncase<-0\n" +
          "# The predicate the conditional likelihood actually uses, computed once and used for\n" +
          "# every count reported below. A case contributes only if it has an event AND both\n" +
          "# exposed and unexposed PERSON-TIME - not merely both labels.\n" +
          "if(nrow(a)>0){\n" +
          "  ev  <-tapply(a$EVENTS, a$ID, sum)\n" +
          "  texp<-tapply(a$INTERVAL*(a$EXPOSED==1), a$ID, sum)\n" +
          "  tune<-tapply(a$INTERVAL*(a$EXPOSED==0), a$ID, sum)\n" +
          "  infm<-ev>0 & texp>0 & tune>0\n" +
          "  ninf<-sum(infm, na.rm=TRUE); epc<-as.numeric(ev); ncase<-sum(epc>0)\n" +
          "  if(ninf==0) stopq<-c(stopq,'No case contributes both exposed and unexposed person-time with at least one event. A self-controlled case series estimates the rate ratio by comparing each person with themselves, so with no within-person contrast there is nothing to estimate - the number of cases does not help.')\n" +
          "  # The MLE exists only if the sufficient statistic is strictly inside its range.\n" +
          "  # sum(y*x) = 0 means no event ever fell in exposed time; = sum(n) means every event\n" +
          "  # did. Either way the likelihood is monotone and there is no finite estimate - which\n" +
          "  # is what used to print as 4.8e14.\n" +
          "  if(ninf>0){\n" +
          "    ii<-a$ID %in% names(infm)[which(infm)]\n" +
          "    Sobs<-sum(a$EVENTS[ii]*a$EXPOSED[ii]); Stot<-sum(a$EVENTS[ii])\n" +
          "    if(Sobs<=0) stopq<-c(stopq, sprintf('Among the %d case(s) that carry the estimate, not one event fell in exposed time. The likelihood is monotone and has no maximum: the data say the rate ratio is below anything you could quote, which is not the same as an estimate of zero. Report the counts and an upper bound instead.', ninf))\n" +
          "    else if(Sobs>=Stot) stopq<-c(stopq, sprintf('Among the %d case(s) that carry the estimate, every one of the %d event(s) fell in exposed time. The likelihood is monotone and has no maximum: the data say the rate ratio is above anything you could quote, which is not the same as the very large number a solver will stop at. Report the counts and a lower bound instead.', ninf, Stot))\n" +
          "  }\n" +
          "}\n" +
          "EST<-'Self-controlled incidence-rate ratio (within person)'\n" +
          "if(length(stopq)>0){\n" +
          "  cat(sprintf('RESULT_ESTIMATE|%s|not estimable\\n', EST))\n" +
          "  for(s in stopq) cat('RESULT_NOTE|Not estimable: ',s,'\\n',sep='')\n" +
          "} else {\n" +
          "# The exact SCCS conditional likelihood: condition on each case's total event count, so\n" +
          "# the events fall across that case's intervals with probability proportional to\n" +
          "# tau*exp(b*x). Newton-Raphson on the single parameter, so no per-case nuisance\n" +
          "# parameter is ever estimated. It reports whether it converged; the caller refuses\n" +
          "# rather than printing a start value or a non-converged iterate.\n" +
          "sccsfit<-function(y,x,tau,id){ b<-0; I<-0; conv<-FALSE\n" +
          "  gs<-split(seq_along(y), id)\n" +
          "  for(it in 1:200){ w<-tau*exp(b*x); U<-0; I<-0\n" +
          "    for(k in gs){ ni<-sum(y[k]); if(ni==0) next; sw<-sum(w[k]); if(!is.finite(sw)||sw<=0) next\n" +
          "      m1<-sum(w[k]*x[k])/sw; m2<-sum(w[k]*x[k]*x[k])/sw\n" +
          "      U<-U+sum(y[k]*x[k])-ni*m1; I<-I+ni*(m2-m1*m1) }\n" +
          "    if(!is.finite(I) || I<=1e-12) break\n" +
          "    st<-U/I; if(!is.finite(st)) break; b<-b+max(-2,min(2,st)); if(abs(st)<1e-10){ conv<-TRUE; break } }\n" +
          "  list(b=b, se=if(is.finite(I) && I>0) sqrt(1/I) else NA_real_, info=I, conv=conv) }\n" +
          // The same conditional log-likelihood the fit above maximises, up to the constant
          // sum(y*log(tau)) that does not depend on b - which is all a likelihood-ratio
          // interval needs. rowsum() rather than split() so the interval costs about what
          // the fit costs: 1.1s against 0.8s over 300,000 rows in native R.
          "sccsll<-function(y,x,tau,id){ ng<-as.vector(rowsum(y,id)); Sx<-sum(y*x)\n" +
          "  function(b){ w<-tau*exp(b*x); sg<-as.vector(rowsum(w,id))\n" +
          "    if(any(!is.finite(sg)) || any(sg<=0)) return(-Inf)\n" +
          "    v<-Sx*b - sum(ng*log(sg)); if(is.finite(v)) v else -Inf } }\n" +
          // Bracket outward in units of the Wald standard error, so the search is scale-free:
          // person-time in years, days or seconds gives the identical interval (checked).
          "profl<-function(bh,se,ll){ l0<-ll(bh); cut<-qchisq(0.95,1)/2\n" +
          "  h<-if(is.finite(se) && se>0) se else 1\n" +
          "  f<-function(z){ v<-ll(z); if(!is.finite(v)) return(NA_real_); l0-v-cut }\n" +
          "  mult<-c(1.5,2,2.5,3,4,5,7,10,15,25,40,70,120,200,400,800,1600,3200)\n" +
          "  lim<-function(dir){ prev<-bh\n" +
          "    for(m in mult){ z<-bh+dir*h*m; v<-f(z); if(!is.finite(v)) return(NA_real_)\n" +
          "      if(v>0) return(tryCatch(uniroot(f,sort(c(prev,z)),tol=1e-10)$root,error=function(e) NA_real_))\n" +
          "      prev<-z }\n" +
          "    NA_real_ }\n" +
          "  c(lim(-1), lim(1)) }\n" +
          "cf<-sccsfit(a$EVENTS, a$EXPOSED, a$INTERVAL, a$ID)\n" +
          "b<-cf$b; se<-cf$se; irr<-exp(b)\n" +
          "if(!cf$conv || !is.finite(se) || !is.finite(irr)){\n" +
          "  cat(sprintf('RESULT_ESTIMATE|%s|not estimable\\n', EST))\n" +
          "  cat('RESULT_NOTE|Not estimable: the conditional likelihood did not converge to a finite estimate on this data.\\n')\n" +
          "} else {\n" +
          // The interval quoted is the profile-likelihood one. The Wald limits are still
          // computed, because they are the fallback if the root search fails and because the
          // two disagreeing is itself worth telling the reader about.
          "wlo<-b-1.96*se; whi<-b+1.96*se\n" +
          "llf<-sccsll(a$EVENTS,a$EXPOSED,a$INTERVAL,a$ID)\n" +
          "pl<-profl(b,se,llf)\n" +
          "pok<-is.finite(pl[1]) && is.finite(pl[2]) && pl[1]<=b && pl[2]>=b\n" +
          "clo<-if(pok) pl[1] else wlo; chi<-if(pok) pl[2] else whi\n" +
          // The pooled contrast row is FITTED here, before anything is printed, so the note
          // below can say how many of the rows in the table are profile intervals instead of
          // asserting it of a row that may not be there. Its cat() still comes after the
          // headline's, which is what fixes the order of the table.
          "p0<-tryCatch(glm(EVENTS ~ EXPOSED, family=poisson, offset=log(INTERVAL), data=a), error=function(e) NULL)\n" +
          "pgot<-FALSE; ppok<-FALSE\n" +
          "if(!is.null(p0)){ bp<-as.numeric(coef(p0)['EXPOSED']); sp<-as.numeric(sqrt(diag(vcov(p0)))['EXPOSED'])\n" +
          // The contrast row gets a profile-likelihood interval too, and it is the SAME
          // function: profiling the intercept out of a log-link Poisson with an offset leaves
          // Sx*b - N*log(sum(tau*exp(b*x))), which is sccsll() over a single stratum. Checked
          // against re-fitting the glm with the coefficient held fixed in the offset: identical
          // to eight decimals on the demo and on a sparse file. If this row kept a Wald
          // interval it would sit directly under a likelihood-ratio one and could contradict
          // it about whether 1 is excluded - which is corroboration the reader has not got.
          "  if(is.finite(bp) && is.finite(sp)){ pgot<-TRUE\n" +
          "    pp<-profl(bp,sp,sccsll(a$EVENTS,a$EXPOSED,a$INTERVAL,rep(1L,nrow(a))))\n" +
          "    ppok<-is.finite(pp[1]) && is.finite(pp[2]) && pp[1]<=bp && pp[2]>=bp } }\n" +
          "cat(sprintf('Exact conditional SCCS incidence-rate ratio (exposed vs unexposed): %.3f (95%% %s CI %.3f to %.3f)\\n', irr, if(pok) 'profile-likelihood' else 'Wald', exp(clo), exp(chi)))\n" +
          "cat(sprintf('Cases (strata): %d; interval-rows: %d; events: %d\\n', length(unique(a$ID)), nrow(a), sum(a$EVENTS)))\n" +
          "cat(sprintf('RESULT_ESTIMATE|%s|%s (95%% CI %s-%s)\\n', EST, fmr(irr), fmr(exp(clo)), fmr(exp(chi))))\n" +
          // Naming the interval is not optional: a rate ratio and its limits are not
          // reproducible without it, and this is the only channel that travels into the
          // Markdown and the .docx alongside the number.
          "if(pok){\n" +
          // Says how many rows it is speaking for, because the pooled row is not always
          // there. Read cold off the rendered panel, "The interval above" was singular
          // above a two-row table in which both intervals had moved.
          "  lead<-if(pgot && ppok) 'Both intervals in the table above are profile-likelihood (likelihood-ratio) intervals, not exp(estimate +/- 1.96 x standard error)' else 'The interval on the self-controlled row above is a profile-likelihood (likelihood-ratio) interval, not exp(estimate +/- 1.96 x standard error)'\n" +
          "  cat('RESULT_NOTE|',lead,'. A self-controlled series conditions each case on their own event count, so when few events fall in the risk window the conditional log-likelihood is markedly asymmetric, and a symmetric Wald interval is too narrow on exactly the side that decides whether the interval clears 1. A worked example you can check: ten cases with one event each, two of those events falling in a 14-day risk window against 351 days of control time, give a rate ratio of 6.27 whose Wald interval is 1.33 to 29.52 and excludes 1, and whose likelihood-ratio interval is 0.95 to 25.02 and does not. The gap between the two narrows as cases accumulate and as the risk window lengthens, but it does not close, which is why this tool says so on any run where they disagree.\\n',sep='')\n" +
          "  wexc<-(wlo>0 || whi<0); pexc<-(pl[1]>0 || pl[2]<0)\n" +
          "  if(wexc && !pexc) cat(sprintf('RESULT_NOTE|The two kinds of interval disagree on this data, which is why the distinction is not academic here. On the self-controlled row a Wald interval would have been %.2f to %.2f and would have excluded 1; the likelihood-ratio interval shown includes it. This rate ratio is compatible with no effect - do not report it as a signal.\\n', exp(wlo), exp(whi)))\n" +
          "  if(pexc && !wexc) cat(sprintf('RESULT_NOTE|The two kinds of interval disagree on this data. On the self-controlled row a Wald interval would have been %.2f to %.2f and would have included 1; the likelihood-ratio interval shown excludes it. The likelihood-ratio limits are the ones to report, but a finding this close to the boundary rests on the shape of the likelihood rather than on weight of evidence.\\n', exp(wlo), exp(whi)))\n" +
          "  if(pgot && !ppok) cat('RESULT_NOTE|The profile-likelihood limits could not be located for the pooled contrast row, so that row alone carries a Wald interval. It is a contrast and not the result, so this does not affect the self-controlled estimate above it.\\n')\n" +
          "} else cat('RESULT_NOTE|The profile-likelihood limits could not be located on this data, so the interval on the self-controlled row above is the Wald approximation exp(estimate +/- 1.96 x standard error) instead. That approximation is unreliable when few events fall in the risk window - which is the situation most likely to have caused the root search to fail - so treat the width of this interval as indicative only.\\n')\n" +
          "# Fitting a dummy per case is the other route to the same number. Where they disagree\n" +
          "# something is wrong - but only a converged fit can be compared, and the message no\n" +
          "# longer offers \"a numerical problem\" as its only hypothesis.\n" +
          "# The dummy-per-case fit is a dense n x (npeople+1) design matrix, so it costs\n" +
          "# O(rows x people^2): measured in native R at 0.73s for 250 cases, 4.9s for 500,\n" +
          "# 40.7s for 1000 and 336s for 2000, against 0.1s for the estimator it is checking.\n" +
          "# WebR is slower still and has no timeout, and this sits BEFORE Table 1 - so at the\n" +
          "# size a real vaccine-safety series reaches, it would hang the tab and take the\n" +
          "# counts down with it. Above the threshold the check is done by maximising the same\n" +
          "# conditional likelihood with a different optimiser, which is O(rows) and catches\n" +
          "# the failure this is actually guarding against: the hand-rolled Newton iteration\n" +
          "# stopping somewhere that is not the maximum.\n" +
          "npeep<-length(unique(a$ID))\n" +
          "fe<-if(npeep<=300) tryCatch(glm(EVENTS ~ EXPOSED + factor(ID), family=poisson, offset=log(INTERVAL), data=a), error=function(e) NULL) else NULL\n" +
          "bchk<-NA_real_; how<-''\n" +
          "if(!is.null(fe)){ bchk<-as.numeric(coef(fe)['EXPOSED']); how<-'a fixed-effect Poisson fit' } else {\n" +
          "  bchk<-tryCatch(optimize(function(z) -llf(z), c(b-5,b+5), tol=1e-9)$minimum, error=function(e) NA_real_); how<-'an independent search for the maximum of the same conditional likelihood' }\n" +
          "if(is.finite(bchk) && abs(bchk-b)>0.01) cat(sprintf('RESULT_NOTE|The exact conditional fit (IRR %.3f) and %s (IRR %.3f) disagree by more than 1%%. They are the same estimator, so the difference is numerical rather than substantive - treat both as unreliable here and check the interval lengths and event counts of the largest contributing cases.\\n', irr, how, exp(bchk)))\n" +
          "if(pgot) cat(sprintf('RESULT_ESTIMATE|Pooled across people, NOT self-controlled (contrast only)|%s (95%% CI %s-%s)\\n', fmr(exp(bp)), fmr(exp(if(ppok) pp[1] else bp-1.96*sp)), fmr(exp(if(ppok) pp[2] else bp+1.96*sp))))\n" +
          "if(ncase>0) cat(sprintf('RESULT_NOTE|%d of %d case(s) have an event and both exposed and unexposed person-time, and so carry the estimate; the rest contribute nothing to it. This is the same test the likelihood applies, so it is the number of cases the result actually rests on.\\n', ninf, ncase))\n" +
          "if(ncase>0 && median(epc[epc>0])<2) cat('RESULT_NOTE|Half the cases contribute a single event. The conditional likelihood handles that correctly - it is the design working as intended, not a defect - but the estimate rests on how each case s one event fell relative to their own exposed window, so precision comes from the number of cases rather than the number of events.\\n')\n" +
          // Guarded on the row existing. It was unconditional, so a run where the pooled
          // glm did not fit told the reader to prefer one of two rows when only one was on
          // the screen. Cheap to fix now that the fit happens before anything is printed.
          "if(pgot) cat('RESULT_NOTE|The pooled row ignores which person each interval belongs to. It is shown only as a contrast: it is confounded by anything that differs between people, which is exactly what the self-controlled design removes. Report the self-controlled row.\\n')\n" +
          "}}\n" +
          "# Table 1 and the data-quality notes print whether or not an estimate was made - when\n" +
          "# the tool refuses, these counts are the evidence the reader needs to see why.\n" +
          "if(nrow(a)>0){\n" +
          "cat('TABLE1|Characteristic|Value\\n')\n" +
          "cat(sprintf('TABLE1|People analysed|%d\\n', length(epc)))\n" +
          "if(length(badids)>0) cat(sprintf('TABLE1|People set aside for impossible values|%d\\n', length(badids)))\n" +
          "cat(sprintf('TABLE1|Cases (people with >=1 event)|%d\\n', ncase))\n" +
          "if(sum(epc==0)>0) cat(sprintf('TABLE1|People with no event (contribute nothing)|%d\\n', sum(epc==0)))\n" +
          // These two rows used to be taken over every person in the file, while the note
          // below asserted that every count describing the analysis was taken over the
          // cases. On a cohort extract that is not a small discrepancy: with 88 event-free
          // people carrying most of the exposed time, Table 1 read 62.5% of person-time
          // exposed against 21.2% of events, whose crude ratio is 0.16 - which is exactly
          // the pooled row the tool tells the reader NOT to report, and a factor of 19 from
          // the headline. A case series describes its cases.
          "ac<-a[a$ID %in% names(ev)[ev>0],,drop=FALSE]\n" +
          "cat(sprintf('TABLE1|Person-interval rows (cases)|%d\\n', nrow(ac)))\n" +
          "cat(sprintf('TABLE1|Events, total|%d\\n', sum(a$EVENTS)))\n" +
          "if(ncase>0) cat(sprintf('TABLE1|Events per case, median (range)|%s (%s-%s)\\n', fmn(median(epc[epc>0])), fmn(min(epc[epc>0])), fmn(max(epc[epc>0]))))\n" +
          "cat(sprintf('TABLE1|Cases with an event and both exposed and unexposed person-time|%d (%s%% of cases)\\n', ninf, if(ncase>0) sprintf('%.1f',100*ninf/ncase) else '0.0'))\n" +
          "cat(sprintf('TABLE1|Person-time exposed (cases)|%s (%.1f%%)\\n', fmn(sum(ac$INTERVAL[ac$EXPOSED==1])), if(sum(ac$INTERVAL)>0) 100*sum(ac$INTERVAL[ac$EXPOSED==1])/sum(ac$INTERVAL) else 0))\n" +
          "cat(sprintf('TABLE1|Events during exposed time (cases)|%d (%.1f%%)\\n', sum(ac$EVENTS[ac$EXPOSED==1]), if(sum(ac$EVENTS)>0) 100*sum(ac$EVENTS[ac$EXPOSED==1])/sum(ac$EVENTS) else 0))\n" +
          "if(sum(epc==0)>0) cat(sprintf('RESULT_NOTE|%d of the %d people analysed had no event at all. A case series contains only cases: these people contribute nothing to the estimate, and every count above that describes the analysis is taken over the %d who did have one. If you meant to upload a case series, this file is a cohort extract.\\n', sum(epc==0), length(epc), ncase))\n" +
          "if(ndropna>0) cat(sprintf('RESULT_NOTE|%d row(s) were dropped because the exposure indicator, event count or interval length was missing. Dropping an interval removes that person-time from its case while leaving the case in the analysis, so check that the missingness is not concentrated in one exposure state.\\n', ndropna))\n" +
          "if(ndrop0>0) cat(sprintf('RESULT_NOTE|%d row(s) with zero person-time and no event were dropped; they carry no information either way.\\n', ndrop0))\n" +
          "# An event inside an interval far shorter than the rest implies an enormous rate and\n" +
          "# dominates the fit. It is not refused - person-time in years makes 0.001 legitimate -\n" +
          "# but it is never left silent, because the fixed-effect cross-check cannot see it: that\n" +
          "# model is handed the same offset and agrees with the corrupted answer.\n" +
          "tiny<-a$INTERVAL[a$EVENTS>0]; thr<-max(a$INTERVAL)/1e4\n" +
          "if(length(tiny)>0 && min(tiny)<thr) cat(sprintf('RESULT_NOTE|%d interval(s) carrying an event are shorter than %s, a ten-thousandth of the longest interval in this file (%s). A rate is events divided by person-time, so a row like that implies a very large rate and will dominate the estimate while adding almost nothing to the confidence interval. Check the units of the interval column, and that its start and stop dates are not the same day.\\n', sum(tiny<thr), fmn(thr), fmn(max(a$INTERVAL))))\n" +
          "}\n" +
          "for(s in warnq) cat('RESULT_NOTE|',s,'\\n',sep='')\n" +
          "cat('RESULT_NOTE|What this tool does not fit: no age or calendar-time term, and it offers no way to add one. A self-controlled series assumes each person s underlying rate is constant across their observation period apart from the exposure, so where the baseline rate moves with age - as it does for most paediatric and most elderly outcomes - that movement is not adjusted for here and is absorbed into the estimate. The design also assumes the event does not change the chance of later exposure and does not end observation; neither is checkable from the four columns this tool reads.\\n')",
      },
      cco: {
        label: "Case-crossover",
        hint: "Long format — one row per window. Map the case ID (stratum), a case indicator (1=hazard window, 0=control window), and an exposed indicator (0/1).",
        covariates: false,
        roles: [
          { k: "ID", label: "Case ID (stratum)", types: ["id", "number", "text"], req: true },
          { k: "CASE", label: "Case indicator (1=hazard, 0=control)", types: ["binary", "number"], req: true },
          { k: "EXPOSED", label: "Exposed (0/1)", types: ["binary", "number"], req: true },
        ],
        rscript: () =>
          // colClasses on ID for the same reason as the SCCS path: a numeric read
          // of an all-digit case ID merges distinct people into one stratum, which
          // is precisely what a matched design exists to prevent.
          "d<-read.csv('/data.csv', colClasses=c(ID='character'), stringsAsFactors=FALSE); library(survival)\n" + R_CHK01 +
          "d$CASE<-chk01(d$CASE,'Case indicator'); d$EXPOSED<-chk01(d$EXPOSED,'Exposed indicator')\n" +
          "fmn<-function(z) if(!is.finite(z)) 'NA' else if(abs(z-round(z))<1e-9) sprintf('%.0f',z) else sprintf('%.2f',z)\n" +
