          L.push("cat('\\n--- Segmented regression coefficients ---\\n'); print(summary(fit)$coefficients)");
          L.push("cat(sprintf('\\nPeriods: %d (%s to %s); interruption at %s (period %d).\\n',np,ukey[1],ukey[np],ukey[t0],t0))");
          L.push("cat(sprintf('Model: %s. Standard errors: %s. Durbin-Watson: %s.\\n',famlab,selab,dwt))");
