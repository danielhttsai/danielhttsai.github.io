          L.push("SS<-if(HASS) d$SEAS else rep(NA,nrow(d))");
          L.push("ok<-!is.na(key) & key!='' & !is.na(Y); if(sum(!ok)>0) cat(sprintf('Dropped %d row(s) with a missing time or outcome value.\\n',sum(!ok)))");
