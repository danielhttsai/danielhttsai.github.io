---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WebrEngine from "../../components/WebrEngine.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// The four in-scope designs the analysis can run (Phase 5).
const DESIGNS = [
  { v: "acnu", t: "Active-comparator new-user cohort", d: "Compare two treatments' effect on an outcome as users start therapy." },
  { v: "sccs", t: "Self-controlled case series", d: "Transient exposure + acute outcome; each case is its own control." },
  { v: "cco", t: "Case-crossover", d: "Acute, abrupt-onset event; compare exposure in a hazard window vs control windows." },
  { v: "its", t: "Interrupted time series", d: "A policy or intervention with a clear start date; segmented regression on a rate over time." },
];
---

<BaseLayout
  title="RWE Studio — Daniel Tsai"
  description="Upload a small, messy hospital dataset and, entirely in your browser, profile and clean it into a tidy master file, then run the analysis for a chosen study design in real R (via WebR). No data leaves your device."
>
  <header class="relative bg-gradient-to-br from-brand-50 via-white to-brand-100/40 border-b border-slate-200 overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
      <p class="uppercase tracking-widest text-xs text-brand-600 font-semibold mb-2">RWE Tools · experimental</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">RWE Studio</h1>
      <p class="mt-3 text-base text-slate-600 max-w-3xl">
        Feed in a small, messy hospital dataset → <strong>profile &amp; flag dirtiness</strong> → clean it into a tidy
        <strong>master file</strong> → pick a study design and map your columns → <strong>run the analysis in real R</strong>
        (via WebR, in your browser) → get the estimate, Table 1, and a reproducible R script.
      </p>
      <a class="mt-4 inline-block text-sm text-brand-700 hover:underline font-semibold" href={`${base}/tools`}>← All RWE tools</a>
    </div>
  </header>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- Privacy -->
    <div class="flex items-start gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
      <span class="font-bold">🔒</span>
      <span>All processing happens <strong>in your browser</strong>. Your dataset is never uploaded or sent to any server — parsing, profiling, cleaning, and (soon) the R analysis all run locally on your device.</span>
    </div>

    <!-- Step tracker -->
    <div class="flex items-start justify-between gap-3 flex-wrap">
      <ol class="flex flex-wrap gap-x-4 gap-y-1 text-xs font-semibold text-slate-400">
        <li class="text-brand-700">1 · Question &amp; design</li>
        <li>2 · Upload &amp; profile</li>
        <li>3 · Map columns</li>
        <li>4 · Clean → master file</li>
        <li>5 · Analyse (R)</li>
        <li>6 · Export</li>
      </ol>
      <button type="button" id="clearall" class="text-xs font-semibold text-rose-700 border border-rose-300 hover:bg-rose-50 px-3 py-1.5 rounded transition">
        ⟲ Clear &amp; start over
      </button>
    </div>

    <!-- Step 1: clinical question & design -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between gap-3 flex-wrap">
        <h2 class="text-lg font-bold text-slate-900">1 · Clinical question &amp; study design</h2>
        <p class="text-[10px] text-slate-500">Your question and chosen design are auto-saved to this browser · your dataset never is</p>
      </div>
      <p class="mt-1 text-sm text-slate-600">Decide this <strong>first</strong> — the design determines which columns you'll map and what cleaning actually matters.</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Population</span>
          <input name="q_pop" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" placeholder="e.g. Adults with type 2 diabetes" /></label>
        <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Outcome</span>
          <input name="q_out" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" placeholder="e.g. Hospitalisation for heart failure" /></label>
        <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Exposure / intervention</span>
          <input name="q_exp" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" placeholder="e.g. SGLT2 inhibitor" /></label>
        <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Comparator (if any)</span>
          <input name="q_comp" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" placeholder="e.g. DPP-4 inhibitor" /></label>
      </div>

      <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-3">
        <p class="text-xs font-semibold text-slate-700">Not sure which design? Tick what applies, then get a recommendation:</p>
        <div class="mt-2 grid gap-1 sm:grid-cols-2 text-xs text-slate-700">
          <label class="flex items-start gap-2"><input type="checkbox" name="s_policy" class="mt-0.5" /> <span>A policy / intervention with a clear start date, measured on a population rate over time</span></label>
          <label class="flex items-start gap-2"><input type="checkbox" name="s_twodrugs" class="mt-0.5" /> <span>Comparing two active treatments from the same indication</span></label>
          <label class="flex items-start gap-2"><input type="checkbox" name="s_transient" class="mt-0.5" /> <span>Exposure is transient / intermittent (short course)</span></label>
          <label class="flex items-start gap-2"><input type="checkbox" name="s_acute" class="mt-0.5" /> <span>Outcome is acute / abrupt-onset</span></label>
        </div>
        <button id="suggest" type="button" class="mt-2 text-xs font-semibold text-brand-700 hover:underline">→ Recommend a design</button>
        <p id="suggestmsg" class="mt-1 text-xs text-brand-800"></p>
      </div>

      <div class="mt-4">
        <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Study design</span>
        <div class="mt-1.5 grid gap-2 sm:grid-cols-2">
          {DESIGNS.map((d) => (
            <label class="flex items-start gap-2 rounded-xl border border-slate-200 p-3 cursor-pointer hover:border-brand-400 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50/60">
              <input type="radio" name="design" value={d.v} class="mt-0.5" />
              <span><span class="text-sm font-semibold text-slate-800">{d.t}</span><br /><span class="text-xs text-slate-600">{d.d}</span></span>
            </label>
          ))}
        </div>
      </div>
    </div>

    <!-- Upload -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">2 · Upload a dataset</h2>
      <p class="mt-1 text-sm text-slate-600">CSV or Excel (.xlsx), in any layout and any language. The tool works out the sheet, the header row, and what a row represents, then asks you to confirm — nothing about the shape is assumed.</p>
      <label id="drop" class="mt-4 flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center cursor-pointer hover:border-brand-400 hover:bg-brand-50/40 transition">
        <span class="text-3xl">📄</span>
        <span class="text-sm font-semibold text-slate-700">Drop a CSV / XLSX here, or click to choose</span>
        <span id="fileinfo" class="text-xs text-slate-500"></span>
        <input id="file" type="file" accept=".csv,.xlsx,.xls,.tsv" class="hidden" />
      </label>
      <p id="msg" class="mt-2 text-xs"></p>
      <label id="cbdrop" class="mt-3 flex flex-wrap items-center gap-2 rounded-xl border border-dashed border-slate-300 bg-white px-4 py-3 text-xs cursor-pointer hover:border-brand-400 hover:bg-brand-50/30 transition">
        <span class="text-base">📘</span>
        <span class="font-semibold text-slate-700">Codebook / data dictionary (optional)</span>
        <span class="text-slate-500">— a sheet listing each column and what it means. Used to label columns and to propose roles.</span>
        <span id="cbinfo" class="text-slate-500"></span>
        <input id="cbfile" type="file" accept=".csv,.xlsx,.xls,.tsv" class="hidden" />
      </label>
      <div class="mt-3 text-xs text-slate-500">
        No data handy? Load a demo — every one is fabricated, generated from a model printed on screen, and carries a
        <strong>known true effect</strong> so you can check the tool recovers it:
        <span class="mt-1 block">
          <button id="demo" data-demo="cohort" type="button" class="text-brand-700 font-semibold hover:underline">cohort (ACNU · ITS)</button>
          <span class="mx-1 text-slate-300">·</span>
          <button data-demo="sccs" type="button" class="text-brand-700 font-semibold hover:underline">self-controlled case series</button>
          <span class="mx-1 text-slate-300">·</span>
          <button data-demo="cco" type="button" class="text-brand-700 font-semibold hover:underline">case-crossover</button>
          <span class="mx-1 text-slate-300">·</span>
          <button data-demo="overlap" type="button" class="text-rose-700 font-semibold hover:underline">a cohort that should not be analysed</button>
        </span>
      </div>
      <div id="demonote" class="hidden mt-3 rounded-xl border border-brand-200 bg-brand-50/60 p-3 text-xs text-slate-700"></div>
    </div>

    <!-- Summary + profile -->
    <div id="results" class="hidden space-y-6">
      <details id="structcard" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" open>
        <summary class="cursor-pointer list-none">
          <span class="text-lg font-bold text-slate-900">What this dataset looks like</span>
          <span id="structsum" class="ml-2 text-sm text-slate-500"></span>
          <span class="ml-2 text-xs text-brand-700 font-semibold">(click to collapse)</span>
        </summary>
        <p class="mt-1 text-sm text-slate-600">Everything below is <strong>inferred, then yours to override</strong>. Skip it entirely if the guesses look right — the defaults are what the profiler and the role suggester will use.</p>
        <div id="structbody" class="mt-4 space-y-4"></div>
      </details>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-bold text-slate-900">Data profile &amp; dictionary</h2>
          <div class="flex flex-wrap gap-2">
            <button id="dlmaster" type="button" class="bg-brand-700 text-white hover:bg-brand-800 font-semibold px-4 py-2 rounded-lg text-sm">⬇ Master file (CSV)</button>
            <button id="dldict" type="button" class="bg-white border border-brand-700 text-brand-700 hover:bg-brand-50 font-semibold px-4 py-2 rounded-lg text-sm">⬇ Data dictionary (CSV)</button>
          </div>
        </div>
        <p id="summary" class="mt-2 text-sm text-slate-600"></p>
        <div id="issues" class="mt-3 space-y-1.5"></div>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-xs border-collapse">
            <thead>
              <tr class="text-left text-slate-500 border-b border-slate-200">
                <th class="py-2 pr-3 font-semibold">Column</th>
                <th class="py-2 pr-3 font-semibold">Inferred type</th>
                <th class="py-2 pr-3 font-semibold">Missing</th>
                <th class="py-2 pr-3 font-semibold">Distinct</th>
                <th class="py-2 pr-3 font-semibold">Range / top values</th>
                <th class="py-2 pr-3 font-semibold">Flags</th>
              </tr>
            </thead>
            <tbody id="proftable"></tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- Step 3: map columns to the design's roles -->
    <div id="mapcard" class="hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">3 · Map columns → <span id="designname" class="text-brand-700"></span> roles</h2>
      <p id="maphint" class="mt-1 text-sm text-slate-600"></p>
      <div id="maproles" class="mt-4 grid gap-3 sm:grid-cols-2"></div>
      <div id="covwrap" class="hidden mt-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Baseline covariates (for the propensity score)</span>
          <span class="flex flex-wrap gap-3 text-[11px]">
            <button type="button" id="cov_ai" class="text-brand-700 font-semibold hover:underline">🧠 AI: classify (causal)</button>
            <button type="button" id="cov_auto" class="text-slate-500 hover:underline">Quick pick (offline)</button>
            <button type="button" id="cov_all" class="text-slate-500 hover:underline">Select all</button>
            <button type="button" id="cov_none" class="text-slate-500 hover:underline">Clear</button>
            <label class="flex items-center gap-1 text-slate-500"><input type="checkbox" id="cov_collapse" checked /> Fold rare categories (&lt;10 rows) into “other”</label>
          </span>
        </div>
        <p class="text-[11px] text-slate-500"><strong>AI classify</strong> judges each column's causal role for <em>your specific exposure→outcome</em> — ticking genuine <strong>confounders</strong> and warning against adjusting for <strong>mediators / colliders / instruments</strong>. Only the <strong>column names + your question</strong> are sent to the AI — never any patient data. Always review and edit; you have the final clinical say.</p>
        <p id="cov_ai_msg" class="text-[11px]"></p>
        <div id="covlist" class="mt-1.5 grid gap-1 sm:grid-cols-3 text-xs text-slate-700"></div>
        <p id="covnote" class="mt-1.5 text-[11px]"></p>

        <div id="acnuopts" class="hidden mt-4 space-y-3 rounded-xl border border-slate-200 bg-slate-50 p-3">
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Estimand</span>
            <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-700">
              <label class="flex items-center gap-1.5"><input type="checkbox" id="est_itt" checked/> Intention-to-treat (ITT)</label>
              <label class="flex items-center gap-1.5"><input type="checkbox" id="est_pp"/> Per-protocol (PP) — needs a discontinuation-time column mapped</label>
            </div>
          </div>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Propensity-score methods (run together)</span>
            <div class="mt-1 grid gap-1 sm:grid-cols-2 text-xs text-slate-700">
              <label class="flex items-center gap-1.5"><input type="checkbox" id="m_match" checked/> PS matching, ratio
                <select id="m_ratio" class="rounded border border-slate-300 px-1 py-0.5 text-[11px]"><option>1</option><option selected>2</option><option>3</option><option>4</option></select>:1</label>
              <label class="flex items-center gap-1.5"><input type="checkbox" id="m_iptw" checked/> IPTW (ATE)</label>
              <label class="flex items-center gap-1.5"><input type="checkbox" id="m_smrw"/> SMR weighting (ATT)</label>
              <label class="flex items-center gap-1.5"><input type="checkbox" id="m_overlap"/> Overlap weighting</label>
              <label class="flex items-center gap-1.5"><input type="checkbox" id="m_fine"/> Fine stratification,
                <select id="m_nstrata" class="rounded border border-slate-300 px-1 py-0.5 text-[11px]"><option>5</option><option selected>10</option><option>20</option><option>50</option></select> strata</label>
            </div>
            <p class="text-[11px] text-slate-400">Crude is always shown alongside.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Weights</span>
              <select id="m_wts" class="mt-1 w-full rounded border border-slate-300 p-1.5 text-xs">
                <option value="stab" selected>Stabilised (recommended)</option>
                <option value="unstab">Unstabilised</option>
              </select>
              <span class="text-[11px] text-slate-500">Numerator is the marginal chance of the treatment received, not 1. Same estimand; how much it actually buys depends on the data and is reported with the results.</span></label>
            <label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Truncate extreme weights</span>
              <select id="m_trunc" class="mt-1 w-full rounded border border-slate-300 p-1.5 text-xs">
                <option value="none" selected>None</option>
                <option value="p1">Cap at the 1st / 99th percentile</option>
                <option value="p5">Cap at the 5th / 95th percentile</option>
              </select>
              <span class="text-[11px] text-slate-500">The fallback when stabilising is not enough. Trades a little bias for precision; the shift is reported.</span></label>
          </div>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Positivity — restrict the cohort before estimating</span>
            <select id="m_trim" class="mt-1 w-full sm:w-2/3 rounded border border-slate-300 p-1.5 text-xs">
              <option value="none" selected>No restriction — report the overlap and refuse an unstable estimate</option>
              <option value="cs">Restrict to the region of common support</option>
              <option value="pct">Trim to the 1st–99th percentile of the propensity score</option>
            </select>
            <p class="text-[11px] text-slate-500">Restricting changes which patients the effect refers to, so it is never applied on your behalf. Whatever is chosen is reported with the results.</p>
          </div>

          <div class="border-t border-slate-200 pt-3">
            <label class="flex items-start gap-2 text-xs text-slate-700">
              <input type="checkbox" id="psc_on" checked class="mt-0.5" />
              <span><strong>Also fit a propensity-score calibration formula</strong> (Stürmer 2005) — for a later claims-only study that
              cannot see your clinical variables. Splits the covariates into what a claims database records and what only a hospital
              record holds, fits a propensity score from each, and derives the correction a claims-only study can apply.</span>
            </label>
            <div id="pscbody" class="mt-2 space-y-2">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Which covariates would a claims database actually have?</span>
                <span class="flex flex-wrap gap-3 text-[11px]">
                  <button type="button" id="psc_reseed" class="text-slate-500 hover:underline">Re-seed from names</button>
                  <button type="button" id="psc_allc" class="text-slate-500 hover:underline">All claims</button>
                  <button type="button" id="psc_allu" class="text-slate-500 hover:underline">All clinical-only</button>
                </span>
              </div>
              <p class="text-[11px] text-slate-500">A coded <em>diagnosis</em> of a condition is in claims even though the measurement behind it is not — obesity is claims, BMI is not. Anything the seeding cannot place is left <strong>unset</strong> and must be decided before the formula is computed.</p>
              <div id="psclist" class="grid gap-1 sm:grid-cols-2 text-xs"></div>
              <div class="grid gap-3 sm:grid-cols-3">
                <label class="block text-xs"><span class="text-slate-600">Validation sample is</span>
                  <select id="psc_valtype" class="mt-1 w-full rounded border border-slate-300 p-1.5">
                    <option value="internal" selected>Internal — a subset of the main study</option>
                    <option value="external">External — a separate dataset</option>
                  </select></label>
                <label class="block text-xs"><span class="text-slate-600">Bootstrap replicates</span>
                  <select id="psc_boot" class="mt-1 w-full rounded border border-slate-300 p-1.5">
                    <option value="0">None (no interval)</option>
                    <option value="200" selected>200</option><option value="500">500</option>
                  </select></label>
                <label class="block text-xs"><span class="text-slate-600">Propensity-score scale</span>
                  <input value="Probability (both models)" readonly class="mt-1 w-full rounded border border-slate-200 bg-slate-100 p-1.5 text-slate-500" /></label>
              </div>
              <p id="pscmsg" class="text-[11px]"></p>
            </div>
          </div>
        </div>
      </div>

      <div id="itsopts" class="hidden mt-4 space-y-3 rounded-xl border border-slate-200 bg-slate-50 p-3">
        <div class="grid gap-3 sm:grid-cols-3">
          <label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Interruption point *</span>
            <input id="its_cut" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" placeholder="e.g. 2019-04-01, 2019-04, or 13" />
            <span class="text-[11px] text-slate-500">The <strong>first period affected</strong> by the intervention — a date, a period label from your time column, or a 1-based period number.</span></label>
          <label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Aggregate rows into periods by</span>
            <select id="its_unit" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
              <option value="none">Use the time column as-is (already one row per period)</option>
              <option value="day">Day</option><option value="week">Week (Mon-start)</option>
              <option value="month" selected>Month</option><option value="quarter">Quarter</option><option value="year">Year</option>
            </select>
            <span class="text-[11px] text-slate-500">Per-patient rows with a date column are collapsed into a series.</span></label>
          <label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Combine the outcome by</span>
            <select id="its_comb" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
              <option value="sum" selected>Sum (event counts)</option><option value="mean">Mean (a rate or level)</option>
            </select></label>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Period order</span>
            <select id="its_order" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
              <option value="auto" selected>Work it out from the labels — stop if it can't</option>
              <option value="file">The order the periods first appear in the file</option>
              <option value="alpha">Alphabetical (only if you know that is chronological)</option>
            </select>
            <span class="text-[11px] text-slate-500">Periods analysed in the wrong order can <strong>reverse</strong> the estimated effect, so this is never guessed.</span></label>
          <label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Combine the denominator by</span>
            <select id="its_denomcomb" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
              <option value="auto" selected>Auto — first value if it repeats within a period, else sum</option>
              <option value="first">First value in the period (a population figure)</option>
              <option value="sum">Sum (person-time carried per row)</option>
              <option value="mean">Mean</option>
            </select>
            <span class="text-[11px] text-slate-500">Summing a population repeated on every patient row multiplies it by the row count.</span></label>
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
          <label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Regression model</span>
            <select id="its_model" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
              <option value="auto" selected>Auto — Poisson for counts, linear otherwise</option>
              <option value="poisson">Segmented Poisson (log link)</option>
              <option value="linear">Segmented linear (OLS)</option>
            </select>
            <span class="text-[11px] text-slate-500">Poisson switches to negative-binomial (or quasi-Poisson) if overdispersed.</span></label>
          <label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Seasonality</span>
            <select id="its_season" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
              <option value="none" selected>None</option>
              <option value="dummies">Calendar-period dummies</option>
              <option value="harmonic">Harmonic (Fourier) terms</option>
            </select></label>
          <label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Cycle length (periods)</span>
            <input id="its_cycle" type="number" min="2" step="1" value="12" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
            <span class="text-[11px] text-slate-500">12 for monthly data, 4 for quarterly.</span></label>
        </div>
        <label class="block text-xs sm:w-2/3"><span class="uppercase tracking-widest text-brand-700 font-semibold">Autocorrelation</span>
          <select id="its_ac" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
            <option value="auto" selected>Auto — Newey–West (HAC) SE only if Durbin–Watson flags serial correlation</option>
            <option value="newey">Always use Newey–West (HAC) standard errors</option>
            <option value="none">Model-based SE — report Durbin–Watson only</option>
          </select>
          <span class="text-[11px] text-slate-500">Whichever is used is stated with the results and in the exported report.</span></label>
      </div>

      <p id="mapmsg" class="mt-3 text-xs"></p>
    </div>

    <!-- Step 4: clean -> master file -->
    <div id="cleancard" class="hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">4 · Clean → master file</h2>
      <p class="mt-1 text-sm text-slate-600">Apply the fixes you want; each is logged and re-emitted into the exported R script. The mapped variables are coerced to the types the analysis needs.</p>
      <div class="mt-3 grid gap-1.5 sm:grid-cols-2 text-sm text-slate-700">
        <label class="flex items-center gap-2"><input type="checkbox" id="c_trim" checked /> Trim leading/trailing whitespace</label>
        <label class="flex items-center gap-2"><input type="checkbox" id="c_std" checked /> Standardise coded flags (0/1, Y/N, 有/無…) to 0/1 for the mapped roles</label>
        <label class="flex items-center gap-2"><input type="checkbox" id="c_dates" checked /> Normalise date columns to YYYY-MM-DD (using the day-first answer above)</label>
        <label class="flex items-center gap-2"><input type="checkbox" id="c_dedupe" checked /> Drop exact duplicate rows</label>
        <label class="flex items-center gap-2"><input type="checkbox" id="c_dropmiss" checked /> Drop rows missing a required mapped variable</label>
      </div>

      <div id="dupwrap" class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Duplicate patients / cases</span>
          <span id="dupcount" class="text-[11px] font-semibold"></span>
        </div>
        <p class="text-[11px] text-slate-500">In a new-user cohort (ACNU) each person should appear once, so a repeated ID is usually a data error to resolve. (SCCS and case-crossover repeat IDs by design, and an interrupted time series aggregates rows into periods — so this control is shown for ACNU only.)</p>
        <div class="mt-2 grid gap-2 sm:grid-cols-3 text-xs">
          <label class="block"><span class="text-slate-600">Patient / case ID column</span>
            <select id="dup_id" class="mt-1 w-full rounded border border-slate-300 p-1.5"></select></label>
          <label class="block"><span class="text-slate-600">When an ID repeats</span>
            <select id="dup_strategy" class="mt-1 w-full rounded border border-slate-300 p-1.5">
              <option value="all">Keep all rows (flag only)</option>
              <option value="first">Keep the first record</option>
              <option value="last">Keep the last record</option>
              <option value="earliest">Keep the earliest by date →</option>
              <option value="latest">Keep the latest by date →</option>
            </select></label>
          <label class="block"><span class="text-slate-600">Date column (for earliest / latest)</span>
            <select id="dup_date" class="mt-1 w-full rounded border border-slate-300 p-1.5"></select></label>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button id="applyclean" type="button" class="bg-brand-700 text-white hover:bg-brand-800 font-semibold px-4 py-2 rounded-lg text-sm">Build master file</button>
        <span id="cleaninfo" class="text-xs text-slate-600"></span>
      </div>
    </div>

    <!-- Step 5: analyse in R -->
    <div id="anacard" class="hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">5 · Analyse in R (WebR)</h2>
      <p class="mt-1 text-sm text-slate-600">Runs the design's model on your master file in real R, in your browser. First run downloads the R runtime (~a few seconds).</p>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button id="runanalysis" type="button" class="bg-brand-700 text-white hover:bg-brand-800 font-semibold px-5 py-2.5 rounded-lg text-sm">▶ Run analysis in R</button>
        <span id="anastatus" class="text-xs text-slate-600"></span>
      </div>
      <div id="anaresults" class="mt-4 hidden rounded-xl border border-brand-200 bg-brand-50/60 p-4"></div>
      <div id="itschart" class="mt-4 hidden rounded-xl border border-slate-200 bg-white p-4 overflow-x-auto"></div>
      <div id="psdiag" class="mt-4 hidden rounded-xl border border-slate-200 bg-white p-4"></div>
      <div id="pscresults" class="mt-4 hidden rounded-xl border border-violet-200 bg-violet-50/50 p-4"></div>
      <div id="table1" class="mt-4 hidden rounded-xl border border-slate-200 bg-white p-4 overflow-x-auto"></div>
      <pre id="routput" class="mt-3 hidden rounded-lg bg-slate-900 text-slate-100 p-4 text-xs leading-relaxed whitespace-pre-wrap overflow-auto max-h-[360px]"></pre>
    </div>

    <!-- Step 6: export -->
    <div id="expcard" class="hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">6 · Export</h2>
      <p class="mt-1 text-sm text-slate-600">The R script is exactly what ran — it reproduces the on-screen result in desktop R.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button id="dlmaster2" type="button" class="bg-white border border-brand-700 text-brand-700 hover:bg-brand-50 font-semibold px-4 py-2 rounded-lg text-sm">⬇ Master file (CSV)</button>
        <button id="dlscript" type="button" class="bg-white border border-brand-700 text-brand-700 hover:bg-brand-50 font-semibold px-4 py-2 rounded-lg text-sm">⬇ R script (.R)</button>
        <button id="dlfitted" type="button" class="hidden bg-white border border-brand-700 text-brand-700 hover:bg-brand-50 font-semibold px-4 py-2 rounded-lg text-sm">⬇ Fitted series (CSV)</button>
        <button id="dlreportword" type="button" class="bg-brand-700 text-white hover:bg-brand-800 font-semibold px-4 py-2 rounded-lg text-sm">⬇ Report (Word)</button>
        <button id="dlreport" type="button" class="bg-white border border-brand-700 text-brand-700 hover:bg-brand-50 font-semibold px-4 py-2 rounded-lg text-sm">⬇ Report (Markdown)</button>
      </div>
    </div>
  </section>

  <script src="https://unpkg.com/docx@8.5.0/build/index.umd.js" is:inline></script>
  <WebrEngine />

  <script is:inline>
    const $ = (id) => document.getElementById(id);
    const fileInput = $("file"), drop = $("drop");
    const setMsg = (t, bad) => { const el = $("msg"); el.textContent = t || ""; el.className = "mt-2 text-xs " + (bad ? "text-rose-600" : "text-slate-500"); };

    let DATA = { rows: [], columns: [], profile: [], name: "dataset" };
    // Everything discovered about the file's shape. Nothing here is assumed: each
    // field is inferred from the data (or the codebook) and can be overridden in
    // the "What this dataset looks like" panel.
    let WB = null;          // the parsed workbook, kept so the sheet can be re-picked
    let SHEETS = [];        // every sheet in the workbook, with a score and any flags
    let SPLITINFO = null;   // result of repairing a delimited dump, if that was asked for
    let CODEBOOK = {};      // normalised column name → definition text
    let CBWB = null, CBNAME = "";
    let CBINFO = null;      // { name, matched, sheet }
    let STRUCT = { sheet: "", headerRow: 0, split: false, unit: "", unitConf: "low", idCol: "", idConf: "low", repeats: 0, repeatKind: "none", dateCols: [], dayFirst: false, vocabs: [], yes: {} };

    const loadScript = (src) => new Promise((res, rej) => {
      if (document.querySelector('script[src="' + src + '"]')) return res();
      const s = document.createElement("script"); s.src = src; s.onload = () => res(); s.onerror = () => rej(new Error("load " + src)); document.head.appendChild(s);
    });
    const XLSX_URL = "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js";
    async function readWorkbook(file) {
      await loadScript(XLSX_URL);
      return window.XLSX.read(await file.arrayBuffer(), { type: "array", cellDates: true });
    }
    const sheetAOA = (ws) => window.XLSX.utils.sheet_to_json(ws, { header: 1, blankrows: false, defval: null, raw: true });

    // Which sheet holds the data? A workbook often carries notes, a pivot, or a
    // mangled export alongside the real table — picking sheet 1 blindly is how a
    // tool silently analyses the wrong thing.
    function scoreSheet(name, aoa) {
      const rows = aoa.length;
      const cols = aoa.reduce((m, r) => Math.max(m, r ? r.length : 0), 0);
      let cells = 0, filled = 0, tabby = 0, strs = 0;
      aoa.slice(0, 200).forEach((r) => (r || []).forEach((c) => { cells++; if (!isBlank(c)) { filled++; if (typeof c === "string") { strs++; if (c.indexOf("\t") >= 0) tabby++; } } }));
      const fill = cells ? filled / cells : 0;
      const notes = [];
      let score = cols * Math.log(1 + rows) * (0.4 + 0.6 * fill);
      const delim = strs > 0 && tabby / strs > 0.5;
      if (delim) notes.push("looks like a delimited text dump pasted into one column — the columns were never split");
      if (cols <= 1) { score *= 0.05; notes.push("only one column"); }
      else if (cols <= 2 && delim) score *= 0.05;
      if (rows <= 2) { score *= 0.2; notes.push("almost no rows"); }
      return { name: name, rows: rows, cols: cols, fill: fill, score: score, delim: delim, notes: notes };
    }
    // Repair for the case above: rebuild a table by splitting each row on the delimiter.
    function splitDelimited(aoa) {
      const lines = aoa.map((r) => (r || []).map((c) => (c == null ? "" : String(c))).join(""));
      const sep = lines.filter((l) => l.indexOf("\t") >= 0).length > lines.length / 2 ? "\t" : ",";
      const out = lines.map((l) => l.split(sep).map((s) => s.replace(/^"|"$/g, "")));
      const counts = {}; out.forEach((r) => { counts[r.length] = (counts[r.length] || 0) + 1; });
      const modal = Number(Object.entries(counts).sort((a, b) => b[1] - a[1])[0][0]);
      const ragged = out.filter((r) => r.length !== modal).length;
      return { aoa: out, modal: modal, ragged: ragged };
    }
    // The header is not always row 1 (title rows, blank spacers, merged banners).
    function detectHeaderRow(aoa) {
      let best = 0, bestScore = -1;
      for (let r = 0; r < Math.min(10, aoa.length - 1); r++) {
        const cells = (aoa[r] || []).filter((c) => !isBlank(c));
        if (cells.length < 2) continue;
        const width = (aoa[r] || []).length || 1;
        const strs = cells.filter((c) => typeof c === "string").length;
        const distinct = new Set(cells.map((c) => String(c).trim().toLowerCase())).size;
        const nextFilled = ((aoa[r + 1] || []).filter((c) => !isBlank(c)) || []).length;
        const sc = (cells.length / width) + (strs / cells.length) + (distinct === cells.length ? 0.6 : 0) + (nextFilled >= cells.length * 0.6 ? 0.6 : 0) - r * 0.05;
        if (sc > bestScore) { bestScore = sc; best = r; }
      }
      return best;
    }
    function tableFromAOA(aoa, headerRow) {
      const raw = aoa[headerRow] || [];
      const width = aoa.reduce((m, r) => Math.max(m, r ? r.length : 0), 0);
      const seen = {}, columns = [];
      for (let i = 0; i < width; i++) {
        let h = raw[i] == null ? "" : String(raw[i]).trim();
        if (!h) h = "column_" + (i + 1);
        if (seen[h]) { seen[h]++; h = h + "_" + seen[h]; } else seen[h] = 1;
        columns.push(h);
      }
      const body = aoa.slice(headerRow + 1).filter((r) => (r || []).some((c) => !isBlank(c)));
      const rows = body.map((r) => { const o = {}; columns.forEach((c, i) => { o[c] = r && r[i] !== undefined ? r[i] : null; }); return o; });
      // drop trailing columns that are entirely empty and unnamed
      const keep = columns.filter((c, i) => !(/^column_\d+$/.test(c) && rows.every((r) => isBlank(r[c]))));
      return { columns: keep, rows: rows };
    }

    const isBlank = (v) => v === null || v === undefined || (typeof v === "string" && v.trim() === "");
    // Dates arrive as Excel serials (already Date objects), ISO strings, ISO
    // datetimes ("2014-10-28 00:00:00"), slash forms ("2014/10/28"), and
    // day-or-month-first forms that only a human can disambiguate.
    const RE_YMD = /^\d{4}[-/.]\d{1,2}([-/.]\d{1,2})?([ T]\d{1,2}:\d{2}(:\d{2})?)?$/;
    const RE_DMY = /^\d{1,2}[-/.]\d{1,2}[-/.]\d{4}([ T]\d{1,2}:\d{2}(:\d{2})?)?$/;
    const isLikelyDate = (v) => v instanceof Date || (typeof v === "string" && (RE_YMD.test(v.trim()) || RE_DMY.test(v.trim())));
    // Rewrite any recognised date to YYYY-MM-DD. Where the value itself settles
    // day-vs-month (a part above 12) that wins; otherwise the user's answer does.
    function toISO(v, dayFirst) {
      if (v instanceof Date) return isNaN(v.getTime()) ? v : v.toISOString().slice(0, 10);
      const s = String(v == null ? "" : v).trim(); if (!s) return v;
      let m = s.match(/^(\d{4})[-/.](\d{1,2})(?:[-/.](\d{1,2}))?/);
      if (m) return m[1] + "-" + String(+m[2]).padStart(2, "0") + "-" + String(+(m[3] || 1)).padStart(2, "0");
      m = s.match(/^(\d{1,2})[-/.](\d{1,2})[-/.](\d{4})/);
      if (m) {
        const a = +m[1], b = +m[2];
        let d, mo;
        if (a > 12) { d = a; mo = b; } else if (b > 12) { d = b; mo = a; } else if (dayFirst) { d = a; mo = b; } else { d = b; mo = a; }
        return m[3] + "-" + String(mo).padStart(2, "0") + "-" + String(d).padStart(2, "0");
      }
      return v;
    }
    function dateStyle(vals) {
      const s = vals.filter((v) => typeof v === "string").map((v) => v.trim());
      if (!s.length) return { label: "spreadsheet date values", ambiguous: false };
      const dmy = s.filter((v) => RE_DMY.test(v));
      const hasTime = s.some((v) => /[ T]\d{1,2}:\d{2}/.test(v));
      if (dmy.length > s.length / 2) {
        let first = 0, second = 0;
        dmy.forEach((v) => { const p = v.split(/[-/.]/); if (+p[0] > 12) first++; if (+p[1] > 12) second++; });
        if (first) return { label: "day-first (DD/MM/YYYY)", ambiguous: false, dayFirst: true };
        if (second) return { label: "month-first (MM/DD/YYYY)", ambiguous: false, dayFirst: false };
        return { label: "DD/MM or MM/DD — ambiguous", ambiguous: true };
      }
      return { label: "year-first (YYYY-MM-DD" + (hasTime ? ", with a time part" : "") + ")", ambiguous: false };
    }
    const asStr = (v) => (v instanceof Date ? v.toISOString().slice(0, 10) : String(v));
    const topCats = (arr, k) => {
      const m = {}; arr.forEach((v) => { m[v] = (m[v] || 0) + 1; });
      return Object.entries(m).sort((a, b) => b[1] - a[1]).slice(0, k).map(([v, c]) => v + " (" + c + ")").join(", ");
    };

    function profileColumn(name, rows) {
      const vals = rows.map((r) => r[name]);
      const n = vals.length;
      const nonNull = vals.filter((v) => !isBlank(v));
      const missing = n - nonNull.length;
      const strs = nonNull.map(asStr);
      const distinct = new Set(nonNull.map((v) => (v instanceof Date ? v.getTime() : v))).size;
      const numeric = nonNull.filter((v) => typeof v === "number" || (typeof v === "string" && v.trim() !== "" && !isNaN(Number(v.replace(/,/g, "")))));
      const dates = nonNull.filter(isLikelyDate);
      let type;
      if (nonNull.length === 0) type = "empty";
      else if (numeric.length === nonNull.length) type = distinct <= 2 ? "binary" : (distinct === nonNull.length && nonNull.length > 10 ? "id" : "number");
      else if (dates.length === nonNull.length) type = "date";
      // Two distinct text values is a binary variable, whatever the tokens are.
      // Calling Y/N or 有/無 "categorical" hid them from every role that needs a
      // 0/1 indicator, since a role only accepts columns of a declared type.
      else if (distinct === 2) type = "binary";
      else if (distinct === nonNull.length && nonNull.length > 5) type = "id";
      else if (distinct <= Math.max(20, nonNull.length * 0.1)) type = "categorical";
      else type = "text";

      const flags = [];
      if (missing > 0) flags.push({ level: missing / n > 0.2 ? "warn" : "info", msg: Math.round((100 * missing) / n) + "% missing" });
      if (numeric.length > 0 && numeric.length < nonNull.length && type !== "categorical" && type !== "text" && type !== "date")
        flags.push({ level: "warn", msg: "mixed numeric / non-numeric" });
      if (dates.length > 0 && dates.length < nonNull.length && type === "date") flags.push({ level: "warn", msg: "some values don't parse as dates" });
      if (strs.some((v) => v !== v.trim())) flags.push({ level: "warn", msg: "stray whitespace" });
      const lc = new Set(strs.map((v) => v.toLowerCase().trim()));
      if ((type === "categorical" || type === "binary") && lc.size < distinct) flags.push({ level: "warn", msg: "inconsistent capitalisation / spacing" });
      if (distinct === 1) flags.push({ level: "info", msg: "constant" });
      if (type === "number") {
        const nums = numeric.map((v) => Number(String(v).replace(/,/g, "")));
        if (nums.some((x) => x < 0)) flags.push({ level: "info", msg: "has negatives" });
      }

      let range = "";
      if (type === "number" || type === "binary") {
        const nums = numeric.map((v) => Number(String(v).replace(/,/g, "")));
        range = "min " + Math.min(...nums) + " · max " + Math.max(...nums);
      } else if (type === "date") {
        const ds = nonNull.map((v) => (v instanceof Date ? v : new Date(v))).map((d) => d.getTime()).filter((t) => !isNaN(t));
        if (ds.length) range = new Date(Math.min(...ds)).toISOString().slice(0, 10) + " → " + new Date(Math.max(...ds)).toISOString().slice(0, 10);
      } else if (type !== "empty") {
        range = topCats(strs, 3);
      }
      const levels = distinct <= 6 ? Array.from(new Set(strs.map((v) => v.trim()))).sort() : [];
      return { name, type, missing, missingPct: n ? (100 * missing) / n : 0, distinct, flags, range, levels, def: CODEBOOK[normName(name)] || "" };
    }

    // ── Codebook / data dictionary ──────────────────────────────────────────
    // NFC first: a codebook written on macOS stores "Créatinine" decomposed, a
    // Windows export stores it composed. They render identically and compare
    // unequal, so without this the codebook silently matches nothing.
    const normName = (s) => String(s == null ? "" : s).normalize("NFC").trim().toLowerCase().replace(/\s+/g, " ").replace(/^["']|["']$/g, "");
    // Find, in any sheet, the column whose values look like this dataset's column
    // names; everything else on that row is the definition.
    function parseCodebook(wb, dataCols) {
      const want = new Set((dataCols || []).map(normName));
      let best = null;
      wb.SheetNames.forEach((sn) => {
        const aoa = sheetAOA(wb.Sheets[sn]);
        const width = aoa.reduce((m, r) => Math.max(m, r ? r.length : 0), 0);
        for (let c = 0; c < width; c++) {
          const vals = aoa.map((r) => (r && r[c] != null ? String(r[c]) : "")).filter((v) => v.trim() !== "");
          if (vals.length < 2) continue;
          const hits = want.size ? vals.filter((v) => want.has(normName(v))).length : 0;
          const uniq = new Set(vals.map(normName)).size;
          const sc = want.size ? hits : uniq;      // no data yet? fall back to the most name-like column
          if (!best || sc > best.sc) best = { sc: sc, sheet: sn, col: c, aoa: aoa, width: width, hits: hits, total: vals.length };
        }
      });
      if (!best) return null;
      const pairs = {};
      best.aoa.forEach((r) => {
        if (!r) return;
        const term = r[best.col] == null ? "" : String(r[best.col]).trim();
        if (!term) return;
        const rest = [];
        for (let c = 0; c < best.width; c++) { if (c === best.col) continue; const v = r[c]; if (!isBlank(v)) rest.push(String(v).trim()); }
        if (rest.length) pairs[normName(term)] = rest.join(" · ").replace(/\s*\n\s*/g, " / ");
      });
      const have = new Set((dataCols || []).map(normName));
      const unmatched = Object.keys(pairs).filter((k) => !have.has(k)).length;
      return { pairs: pairs, matched: best.hits, total: best.total, sheet: best.sheet, unmatched: unmatched };
    }

    // ── Structure inference ─────────────────────────────────────────────────
    // Deterministic guesses at the things a tool normally just assumes: which
    // column is the person, whether a row is a person or a visit, how dates are
    // written, and what a coded flag means. Each guess carries a confidence and
    // is overridable.
    const YES_TOKENS = ["1", "y", "yes", "true", "t", "有", "是", "有病史", "陽性", "positive", "present", "case", "event", "exposed"];
    const NO_TOKENS = ["0", "n", "no", "false", "f", "無", "否", "陰性", "negative", "absent", "control", "none", "unexposed"];
    const SEX_SETS = [["m", "f"], ["male", "female"], ["男", "女"], ["男性", "女性"]];
    const ID_RE = /(^|[_\s])id$|^id[_\s]|patient|subject|person|pid|chart|mrn|病歷|病例|身分|身份|編號|序號|案號|患者|受診者|환자|번호|fallnummer|patientennummer|dossier|matricule|numero|número|nummer/i;
    const UNIT_LABEL = { patient: "one row per patient", visit: "one row per visit / episode", period: "one row per period (an aggregated series)", interval: "one row per patient-interval", other: "something else", unknown: "not sure" };
    const CONF_CLS = { high: "bg-emerald-100 text-emerald-800", medium: "bg-amber-100 text-amber-800", low: "bg-slate-200 text-slate-600" };
    const confBadge = (c) => '<span class="ml-1 rounded px-1.5 py-0.5 text-[10px] font-semibold ' + (CONF_CLS[c] || CONF_CLS.low) + '">' + c + " confidence</span>";

    function inferStructure() {
      const n = DATA.rows.length, prof = DATA.profile;
      let idCol = "", idScore = 0;
      prof.forEach((p) => {
        let sc = 0;
        if (ID_RE.test(p.name)) sc += 3;
        if (p.def && (ID_RE.test(p.def) || /識別|唯一|unique/i.test(p.def))) sc += 2;
        if (p.type === "id") sc += 2;
        if (p.type === "date") sc -= 5;
        const ratio = n ? p.distinct / n : 0;
        if (ratio > 0.9) sc += 1; else if (ratio < 0.05) sc -= 2;
        if (sc > idScore) { idScore = sc; idCol = p.name; }
      });
      if (idScore < 3) idCol = "";
      let repeats = 0, identical = 0, distinctIds = 0;
      if (idCol) {
        const groups = new Map();
        DATA.rows.forEach((r, i) => { const k = String(r[idCol] == null ? "" : r[idCol]).trim(); if (!k) return; if (!groups.has(k)) groups.set(k, []); groups.get(k).push(i); });
        distinctIds = groups.size;
        const rowKey = (i) => DATA.columns.map((c) => asStr(DATA.rows[i][c] == null ? "" : DATA.rows[i][c])).join("|");
        groups.forEach((idxs) => { if (idxs.length > 1) { repeats++; const k0 = rowKey(idxs[0]); if (idxs.every((i) => rowKey(i) === k0)) identical++; } });
      }
      const uniqRatio = idCol && n ? distinctIds / n : 1;
      const dateCols = prof.filter((p) => p.type === "date").map((p) => p.name);
      let unit = "unknown", unitConf = "low";
      // "One row per period" is only asserted with evidence for it — a date column
      // that is unique per row. Without an ID column and without that, the honest
      // answer is "not sure", not a confident guess about a per-patient extract.
      if (!idCol) {
        const seriesLike = dateCols.some((c) => { const p = prof.find((x) => x.name === c); return p && n > 0 && p.distinct === n - p.missing; });
        unit = seriesLike ? "period" : "unknown";
        unitConf = seriesLike ? "medium" : "low";
      }
      else if (uniqRatio > 0.995) { unit = "patient"; unitConf = uniqRatio === 1 ? "high" : "medium"; }
      else if (repeats && identical === repeats) { unit = "patient"; unitConf = "medium"; }
      else if (dateCols.length >= 2 && uniqRatio > 0.5) { unit = "interval"; unitConf = "medium"; }
      else { unit = "visit"; unitConf = uniqRatio < 0.6 ? "high" : "medium"; }
      const repeatKind = !repeats ? "none" : (identical === repeats ? "dup" : (identical ? "mixed" : "measures"));

      const byKey = {};
      prof.forEach((p) => {
        if (!p.levels || p.levels.length !== 2) return;
        const key = p.levels.map((v) => v.toLowerCase()).sort().join(" / ");
        if (!byKey[key]) byKey[key] = { key: key, values: p.levels.slice(), columns: [] };
        byKey[key].columns.push(p.name);
      });
      const vocabs = Object.keys(byKey).map((k) => {
        const v = byKey[k], lo = v.values.map((x) => x.toLowerCase());
        const yi = lo.findIndex((x) => YES_TOKENS.indexOf(x) >= 0), ni = lo.findIndex((x) => NO_TOKENS.indexOf(x) >= 0);
        let yes = "", kind = "flag", conf = "low";
        if (SEX_SETS.some((s) => (s[0] === lo[0] && s[1] === lo[1]) || (s[0] === lo[1] && s[1] === lo[0]))) { kind = "sex"; conf = "high"; }
        else if (yi >= 0 && ni >= 0 && yi !== ni) { yes = v.values[yi]; conf = "high"; }
        else if (lo.indexOf("1") >= 0 && lo.indexOf("2") >= 0) { yes = v.values[lo.indexOf("1")]; conf = "low"; }
        return { key: k, values: v.values, columns: v.columns, yes: yes, kind: kind, conf: conf };
      });
      const dates = dateCols.map((c) => { const st = dateStyle(DATA.rows.map((r) => r[c])); return { col: c, label: st.label, ambiguous: !!st.ambiguous, dayFirst: !!st.dayFirst }; });

      const prev = STRUCT;
      STRUCT = {
        sheet: prev.sheet, headerRow: prev.headerRow, split: prev.split,
        unit: unit, unitConf: unitConf, idCol: idCol, idConf: idScore >= 5 ? "high" : (idScore >= 3 ? "medium" : "low"),
        repeats: repeats, repeatKind: repeatKind, uniqRatio: uniqRatio, distinctIds: distinctIds,
        dateCols: dates, dayFirst: prev.dayFirst || dates.some((d) => d.dayFirst), vocabs: vocabs, yes: {},
      };
      vocabs.forEach((v) => { STRUCT.yes[v.key] = (prev.yes && prev.yes[v.key] != null) ? prev.yes[v.key] : (v.kind === "sex" ? "" : v.yes); });
      YMCACHE = null;
      return STRUCT;
    }

    // toBin consults the vocabulary the user confirmed, so 有/無 or Y/N or 1/2
    // are coerced the way this dataset means them — not the way English data does.
    let YMCACHE = null;
    function yesMap() {
      if (YMCACHE) return YMCACHE;
      const m = {};
      (STRUCT.vocabs || []).forEach((v) => {
        const y = STRUCT.yes[v.key];
        if (!y) return;
        v.values.forEach((val) => { m[String(val).trim().toLowerCase()] = String(val) === String(y) ? 1 : 0; });
      });
      YMCACHE = m;
      return m;
    }

    function renderStructure() {
      const box = $("structbody"); if (!box) return;
      const s = STRUCT, cols = DATA.columns;
      const sel = (id, opts, cur) => '<select data-s="' + id + '" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">' + opts.map((o) => '<option value="' + esc(o[0]) + '"' + (String(cur) === String(o[0]) ? " selected" : "") + ">" + esc(o[1]) + "</option>").join("") + "</select>";
      const parts = [];

      if (SHEETS.length) {
        const other = SHEETS.filter((x) => x.name !== s.sheet);
        parts.push('<div class="rounded-xl border border-slate-200 bg-slate-50 p-3">' +
          '<div class="grid gap-3 sm:grid-cols-3">' +
          '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Sheet</span>' + sel("sheet", SHEETS.map((x) => [x.name, x.name + " · " + x.rows + "×" + x.cols + (x.notes.length ? " ⚠" : "")]), s.sheet) + "</label>" +
          '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Header row</span><input data-s="headerRow" type="number" min="1" step="1" value="' + (s.headerRow + 1) + '" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /><span class="text-[11px] text-slate-500">Row holding the column names.</span></label>' +
          '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Delimited dump</span><label class="mt-2 flex items-center gap-2 text-sm"><input data-s="split" type="checkbox"' + (s.split ? " checked" : "") + ' /> Split this sheet on tabs / commas</label></label>' +
          "</div>" +
          (other.length ? '<p class="mt-2 text-[11px] text-slate-500">Other sheets: ' + other.map((x) => "<strong>" + esc(x.name) + "</strong> (" + x.rows + "×" + x.cols + (x.notes.length ? " — " + esc(x.notes.join("; ")) : "") + ")").join("; ") + "</p>" : "") +
          "</div>");
      }

      const idOpts = [["", "— none / not a person-level file —"]].concat(cols.map((c) => [c, c]));
      parts.push('<div class="grid gap-3 sm:grid-cols-3">' +
        '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">A row is</span>' + confBadge(s.unitConf) + sel("unit", [["patient", UNIT_LABEL.patient], ["visit", UNIT_LABEL.visit], ["period", UNIT_LABEL.period], ["interval", UNIT_LABEL.interval], ["other", UNIT_LABEL.other], ["unknown", UNIT_LABEL.unknown]], s.unit) + "</label>" +
        '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Patient / subject ID</span>' + confBadge(s.idConf) + sel("idCol", idOpts, s.idCol) + "</label>" +
        '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">Repeated IDs mean</span>' + sel("repeatKind", [["none", s.repeats ? "— pick one —" : "no ID repeats ✓"], ["measures", "real repeat measures (keep them all)"], ["dup", "duplicates to resolve"], ["mixed", "a mix — needs review"]], s.repeatKind) + "</label>" +
        "</div>" +
        '<p class="text-[11px] text-slate-500">' + (s.idCol
          ? esc(s.distinctIds + " distinct ID(s) across " + DATA.rows.length + " rows" + (s.repeats ? "; " + s.repeats + " ID(s) repeat, of which " + (s.repeatKind === "dup" ? "all" : s.repeatKind === "measures" ? "none" : "some") + " are exact copies of another row." : " — every ID is unique."))
          : "No column looks like a person identifier — that is normal for an already-aggregated series.") + "</p>");

      if (s.dateCols.length) {
        const amb = s.dateCols.some((d) => d.ambiguous);
        parts.push('<div><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Date columns</span>' +
          '<div class="mt-1 grid gap-1 sm:grid-cols-2 text-xs text-slate-700">' + s.dateCols.map((d) => "<div><strong>" + esc(d.col) + "</strong> — " + esc(d.label) + "</div>").join("") + "</div>" +
          (amb ? '<label class="mt-1.5 flex items-center gap-2 text-xs text-amber-800"><input data-s="dayFirst" type="checkbox"' + (s.dayFirst ? " checked" : "") + ' /> These are day-first (DD/MM/YYYY), not month-first — no value in the file settles it.</label>' : "") +
          "</div>");
      }

      const flags = s.vocabs.filter((v) => v.kind !== "sex");
      if (flags.length) {
        parts.push('<div><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Coded flags — which value means “yes / event present”?</span>' +
          '<div class="mt-1 grid gap-2 sm:grid-cols-2">' + flags.map((v) =>
            '<label class="block text-xs"><span class="text-slate-600">' + esc(v.key) + " · " + v.columns.length + " column(s)" + confBadge(v.conf) + "</span>" +
            sel("yes:" + v.key, [["", "— not a yes/no flag —"]].concat(v.values.map((x) => [x, x + " means yes"])), s.yes[v.key] || "") +
            '<span class="block text-[11px] text-slate-400 truncate" title="' + esc(v.columns.join(", ")) + '">' + esc(v.columns.slice(0, 4).join(", ")) + (v.columns.length > 4 ? " …" : "") + "</span></label>").join("") + "</div></div>");
      }

      parts.push('<p class="text-[11px] text-slate-500">' + (CBINFO
        ? "Codebook <strong>" + esc(CBINFO.name) + "</strong>: " + CBINFO.matched + " of " + cols.length + " column(s) matched, " + Object.keys(CODEBOOK).length + " definition(s) loaded. Definitions appear under each column below and steer the role suggestions."
        : "No codebook loaded. If you have a data dictionary, adding it above lets the tool label columns and propose roles in your own vocabulary.") + "</p>");

      box.innerHTML = parts.join("");
      box.querySelectorAll("[data-s]").forEach((el) => el.addEventListener("change", () => onStructChange(el)));
      const c = { high: "text-emerald-700", medium: "text-amber-700", low: "text-slate-500" }[s.unitConf] || "text-slate-500";
      $("structsum").innerHTML = "— " + DATA.rows.length + " rows · <span class='" + c + "'>" + esc(UNIT_LABEL[s.unit] || s.unit) + "</span>" + (s.idCol ? " · ID <strong>" + esc(s.idCol) + "</strong>" : "") + (s.dateCols.length ? " · " + s.dateCols.length + " date column(s)" : "");
    }

    function onStructChange(el) {
      const k = el.getAttribute("data-s");
      if (k === "sheet" || k === "split" || k === "headerRow") {
        if (k === "sheet") { STRUCT.sheet = el.value; STRUCT.split = false; STRUCT.headerRow = -1; }
        if (k === "split") STRUCT.split = el.checked;
        if (k === "headerRow") STRUCT.headerRow = Math.max(0, (parseInt(el.value) || 1) - 1);
        rebuildFromSheet(k !== "headerRow");
        return;
      }
      YMCACHE = null;
      if (k.indexOf("yes:") === 0) STRUCT.yes[k.slice(4)] = el.value;
      else if (k === "dayFirst") STRUCT.dayFirst = el.checked;
      else STRUCT[k] = el.value;
      if (k === "idCol") { try { renderDupUI(); } catch (e) {} }
      try { renderMap(); } catch (e) {}
      renderStructure();
    }

    function dupRowCount(rows, columns) {
      const seen = new Set(); let dups = 0;
      for (const r of rows) { const k = columns.map((c) => asStr(r[c] == null ? "" : r[c])).join(""); if (seen.has(k)) dups++; else seen.add(k); }
      return dups;
    }

    const TYPE_BADGE = { number: "bg-sky-100 text-sky-800", binary: "bg-indigo-100 text-indigo-800", date: "bg-violet-100 text-violet-800", categorical: "bg-emerald-100 text-emerald-800", id: "bg-amber-100 text-amber-800", text: "bg-slate-100 text-slate-700", empty: "bg-rose-100 text-rose-700" };
    const esc = (x) => String(x == null ? "" : x).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    function render() {
      const { rows, columns, profile } = DATA;
      $("results").classList.remove("hidden");
      inferStructure();
      renderStructure();
      const dups = dupRowCount(rows, columns);
      const flagged = profile.filter((p) => p.flags.some((f) => f.level === "warn")).length;
      $("summary").innerHTML = "<strong>" + rows.length + "</strong> rows · <strong>" + columns.length + "</strong> columns · " +
        (dups ? "<span class='text-amber-700 font-semibold'>" + dups + " duplicate row(s)</span>" : "no duplicate rows") +
        " · " + (flagged ? "<span class='text-amber-700 font-semibold'>" + flagged + " column(s) need attention</span>" : "no dirtiness flagged");

      const issues = [];
      if (dups) issues.push({ level: "warn", msg: dups + " fully-duplicated row(s) — likely to be de-duplicated during cleaning." });
      if (!columns.length) issues.push({ level: "error", msg: "No columns detected — is there a header row?" });
      if (SPLITINFO && SPLITINFO.ragged) issues.push({ level: "warn", msg: "Splitting this sheet produced " + SPLITINFO.ragged + " row(s) with a field count other than " + SPLITINFO.modal + " — a delimited dump inside a spreadsheet cell is usually truncated, so some values will be wrong. Prefer the properly-tabulated sheet if the workbook has one." });
      const badSheet = SHEETS.find((x) => x.name === STRUCT.sheet && x.notes.length);
      if (badSheet && !STRUCT.split) issues.push({ level: "warn", msg: "The sheet in use (“" + badSheet.name + "”) " + badSheet.notes.join("; ") + "." });
      $("issues").innerHTML = issues.map((i) => "<div class='flex items-start gap-2 rounded-lg border px-3 py-2 text-xs " + (i.level === "error" ? "border-rose-200 bg-rose-50 text-rose-800" : "border-amber-200 bg-amber-50 text-amber-800") + "'><span class='font-bold'>" + (i.level === "error" ? "✕" : "!") + "</span><span>" + esc(i.msg) + "</span></div>").join("");

      $("proftable").innerHTML = profile.map((p) => {
        const badges = p.flags.map((f) => "<span class='inline-block rounded px-1.5 py-0.5 text-[10px] font-semibold " + (f.level === "warn" ? "bg-amber-100 text-amber-800" : "bg-slate-100 text-slate-600") + "'>" + esc(f.msg) + "</span>").join(" ") || "<span class='text-emerald-600'>✓ clean</span>";
        return "<tr class='border-b border-slate-100 align-top'>" +
          "<td class='py-2 pr-3 font-semibold text-slate-800'>" + esc(p.name) + (p.def ? "<div class='font-normal text-[10px] text-slate-500 max-w-[220px]'>" + esc(p.def) + "</div>" : "") + "</td>" +
          "<td class='py-2 pr-3'><span class='inline-block rounded px-1.5 py-0.5 text-[10px] font-semibold " + (TYPE_BADGE[p.type] || TYPE_BADGE.text) + "'>" + p.type + "</span></td>" +
          "<td class='py-2 pr-3 " + (p.missingPct > 20 ? "text-amber-700 font-semibold" : "text-slate-600") + "'>" + Math.round(p.missingPct) + "%</td>" +
          "<td class='py-2 pr-3 text-slate-600'>" + p.distinct + "</td>" +
          "<td class='py-2 pr-3 text-slate-600'>" + esc(p.range) + "</td>" +
          "<td class='py-2 pr-3'>" + badges + "</td>" +
        "</tr>";
      }).join("");
      try { renderMap(); } catch (e) {}
    }

    function applyCodebook() {
      if (!CBWB || !DATA.columns.length) return;
      const r = parseCodebook(CBWB, DATA.columns);
      if (!r) { CBINFO = null; return; }
      CODEBOOK = r.pairs; CBINFO = { name: CBNAME, matched: r.matched, sheet: r.sheet, unmatched: r.unmatched };
      DATA.profile.forEach((p) => { p.def = CODEBOOK[normName(p.name)] || ""; });
      $("cbinfo").textContent = "· " + CBNAME + " — " + r.matched + " of " + DATA.columns.length + " columns matched" + (r.unmatched ? ", " + r.unmatched + " codebook term(s) matched nothing" : "");
    }
    function setData(columns, rows, name) {
      DATA = { rows: rows, columns: columns, profile: columns.map((c) => profileColumn(c, rows)), name: name || DATA.name || "dataset" };
      applyCodebook();
      MAP = {}; COVS = []; COVROLE = {}; MASTER = null; LAST = null;
      $("anacard").classList.add("hidden"); $("expcard").classList.add("hidden");
      $("fileinfo").textContent = DATA.name + " · " + rows.length + " rows × " + columns.length + " cols" + (STRUCT.sheet ? " · sheet “" + STRUCT.sheet + "”" : "");
      render();
    }
    function rebuildFromSheet(redetectHeader) {
      if (!WB) return;
      const ws = WB.Sheets[STRUCT.sheet]; if (!ws) return;
      let aoa = sheetAOA(ws);
      SPLITINFO = null;
      if (STRUCT.split) { SPLITINFO = splitDelimited(aoa); aoa = SPLITINFO.aoa; }
      if (redetectHeader || STRUCT.headerRow < 0 || STRUCT.headerRow >= aoa.length) STRUCT.headerRow = detectHeaderRow(aoa);
      const t = tableFromAOA(aoa, STRUCT.headerRow);
      setData(t.columns, t.rows, DATA.name);
    }

    async function ingest(file) {
      setMsg("Parsing " + file.name + "…");
      $("demonote").classList.add("hidden");
      try {
        WB = await readWorkbook(file);
        SHEETS = WB.SheetNames.map((n) => scoreSheet(n, sheetAOA(WB.Sheets[n])));
        const best = SHEETS.slice().sort((a, b) => b.score - a.score)[0];
        if (!best) { setMsg("That workbook has no sheets.", true); return; }
        STRUCT = Object.assign({}, STRUCT, { sheet: best.name, headerRow: -1, split: false, yes: {} });
        DATA.name = file.name.replace(/\.[^.]+$/, "") || "dataset";
        rebuildFromSheet(true);
        if (!DATA.rows.length || !DATA.columns.length) { setMsg("Couldn't read any rows/columns from “" + best.name + "”. Try another sheet or header row in the panel below.", true); return; }
        const notes = [];
        if (SHEETS.length > 1) notes.push("Chose sheet “" + best.name + "” of " + SHEETS.length + " — the widest, fullest table.");
        SHEETS.filter((x) => x.name !== best.name && x.notes.length).forEach((x) => notes.push("Left “" + x.name + "” alone: " + x.notes.join("; ") + "."));
        if (STRUCT.headerRow > 0) notes.push("Treated row " + (STRUCT.headerRow + 1) + " as the header.");
        setMsg(notes.join(" "));
      } catch (e) { setMsg("Error reading file: " + (e && e.message ? e.message : e), true); }
    }

    fileInput.addEventListener("change", (e) => { const f = e.target.files && e.target.files[0]; if (f) ingest(f); });
    $("cbfile").addEventListener("change", async (e) => {
      const f = e.target.files && e.target.files[0]; if (!f) return;
      $("cbinfo").textContent = "· reading " + f.name + "…";
      try {
        CBWB = await readWorkbook(f); CBNAME = f.name;
        if (DATA.columns.length) { applyCodebook(); render(); }
        else $("cbinfo").textContent = "· " + f.name + " — will be matched to the columns when the data loads";
      } catch (err) { $("cbinfo").textContent = "· could not read " + f.name; }
    });
    drop.addEventListener("dragover", (e) => { e.preventDefault(); drop.classList.add("border-brand-400", "bg-brand-50/40"); });
    drop.addEventListener("dragleave", () => drop.classList.remove("border-brand-400", "bg-brand-50/40"));
    drop.addEventListener("drop", (e) => { e.preventDefault(); drop.classList.remove("border-brand-400", "bg-brand-50/40"); const f = e.dataTransfer.files && e.dataTransfer.files[0]; if (f) ingest(f); });

    // ── Demo dataset ────────────────────────────────────────────────────────
    // Fabricated patients, generated from a model written down below, with a
    // treatment effect chosen in advance. The point is that it is CONFOUNDED: a
    // text covariate (severity) drives both who gets the new drug and who has the
    // event, so a crude analysis is wrong in a specific, checkable direction. A
    // demo that is balanced by construction cannot show what this tool is for,
    // and would hide a whole class of regression — a covariate silently dropped
    // from the model makes crude and adjusted agree, which looks like a result.
    const DEMO = {
      // Seed chosen so this particular 600-patient draw realises the model's true
      // effect closely (a finite sample need not, and saying "HR 0.70" about a
      // draw that came out at 0.62 would be a small lie in a teaching example).
      seed: 20192051,
      months: 24, perMonth: 25,          // 600 rows, 2018-01 … 2019-12
      sev: ["mild", "moderate", "severe"],
      sevMix: [0.40, 0.35, 0.25],
      pNew: [0.20, 0.50, 0.80],          // confounding by indication: sicker → new drug
      sevLHR: [0, 0.70, 1.40],           // severity also raises the hazard
      smokeLHR: 0.40,
      stepLHR: 0.35,                     // a step change in the hazard from 2019-01
      trueHR: 0.70,                      // ← what the tool should recover
      baseRate: 0.0008,
      sites: 26,
    };
    const DEMO_STORY =
      "<strong>Fabricated data — not real patients.</strong> " + (DEMO.months * DEMO.perMonth) + " rows, " +
      DEMO.months + " monthly index periods of " + DEMO.perMonth + ", one fixed seed, generated from this model:" +
      "<ul class='mt-1 ml-4 list-disc space-y-0.5'>" +
      "<li><code>severity</code> (mild / moderate / severe) raises the chance of getting the new drug to " +
      DEMO.pNew.map((p) => Math.round(p * 100) + "%").join(" / ") + " <em>and</em> multiplies the event hazard by " +
      DEMO.sevLHR.map((b) => "×" + Math.exp(b).toFixed(1)).join(" / ") + " — so it confounds.</li>" +
      "<li>smoking (×" + Math.exp(DEMO.smokeLHR).toFixed(1) + ") and a step change from 2019-01 (×" + Math.exp(DEMO.stepLHR).toFixed(1) + ") also raise the hazard.</li>" +
      "<li><code>sex</code> and <code>clinic_site</code> affect nothing — they are there to be messy.</li>" +
      "<li>The <strong>true treatment effect is HR " + DEMO.trueHR.toFixed(2) + "</strong> — the new drug helps.</li></ul>" +
      "<p class='mt-1'>Because the sicker patients were the ones given it, a <strong>crude</strong> comparison makes it look " +
      "<em>harmful</em>. Tick <em>Quick pick</em> for the covariates and you should see roughly:</p>" +
      "<table class='mt-1 w-full max-w-md text-[11px]'><tbody>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>Crude HR</td><td class='font-semibold'>≈ 1.14 (0.91–1.43)</td></tr>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>IPTW (ATE)</td><td class='font-semibold'>≈ 0.74 (0.57–0.96)</td></tr>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>2:1 PS matching</td><td class='font-semibold'>≈ 0.71 (0.51–0.99)</td></tr>" +
      "</tbody></table>" +
      "<p class='mt-1'><strong>If crude and adjusted come out the same, the tool is broken</strong> — a covariate that silently drops " +
      "out of the model produces exactly that, and it reads like a reassuring null. That is what this demo is for.</p>" +
      "<p class='mt-1 text-slate-500'>The adjusted figures will not land on 0.70 exactly and should not: 600 patients carry sampling " +
      "error, and a marginal hazard ratio is not the same quantity as the conditional one. Fitting the correctly-specified model to " +
      "this particular draw gives HR 0.686 (0.533–0.883), so both estimates above are where they should be.</p>" +
      "<p class='mt-1'>The same file also runs as an <strong>interrupted time series</strong>: map <code>index_date</code> and " +
      "<code>outcome</code>, aggregate by month, interruption <strong>2019-01</strong>. Expect a level change of " +
      "<strong>≈ 1.35 (0.98–1.85)</strong>. Note that is <em>not</em> the ×" + Math.exp(DEMO.stepLHR).toFixed(1) + " that was put into the hazard, and " +
      "should not be: <code>outcome</code> is a 365-day risk rather than a rate, so the step is compressed, and with only 12 " +
      "periods either side the interval crosses 1. The ITS here is a working example, not a second estimate of the same quantity.</p>";

    // Shared helpers for every demo generator.
    const lcg = (s0) => { let s = s0; return () => (s = (s * 1103515245 + 12345) % 2147483648) / 2147483648; };
    const rpois = (lam, rand) => { if (lam <= 0) return 0; const L = Math.exp(-lam); let k = 0, p = 1; do { k++; p *= rand(); } while (p > L); return k - 1; };
    const dayStr = (base, d) => new Date(Date.parse(base) + d * 86400000).toISOString().slice(0, 10);

    // ── Self-controlled case series ─────────────────────────────────────────
    // Long format, one row per person-interval. Only people who had an event
    // appear — that is what "case series" means. Each person's own unexposed time
    // is the comparison for their own exposed time, so anything fixed about the
    // person (frailty, genetics, chronic disease) cannot confound the estimate.
    const SCCS = {
      seed: 20201883, people: 1000, obsDays: 365, trueIRR: 3.0, start: "2019-01-01",
      mix: [0.45, 0.35, 0.20],
      tiers: [
        { n: "low", rate: 0.00018, pExp: 0.25, riskDays: 30 },
        { n: "medium", rate: 0.0010, pExp: 0.60, riskDays: 60 },
        { n: "high", rate: 0.0050, pExp: 0.92, riskDays: 120 },
      ],
    };
    function buildSccs() {
      const rand = lcg(SCCS.seed);
      const pick = (ws) => { let u = rand(), a = 0; for (let i = 0; i < ws.length; i++) { a += ws[i]; if (u < a) return i; } return ws.length - 1; };
      const rows = [];
      for (let i = 1; i <= SCCS.people; i++) {
        const t = SCCS.tiers[pick(SCCS.mix)];
        const exposed = rand() < t.pExp, rd = t.riskDays;
        const s0 = exposed ? Math.floor(20 + rand() * (SCCS.obsDays - rd - 40)) : -1;
        const segs = exposed
          ? [{ on: 0, a: 0, d: s0 }, { on: 1, a: s0, d: rd }, { on: 0, a: s0 + rd, d: SCCS.obsDays - s0 - rd }]
          : [{ on: 0, a: 0, d: SCCS.obsDays }];
        const withEv = segs.filter((s) => s.d > 0).map((s) => Object.assign({}, s, { ev: rpois(t.rate * (s.on ? SCCS.trueIRR : 1) * s.d, rand) }));
        if (!withEv.reduce((a, s) => a + s.ev, 0)) continue;      // cases only
        withEv.forEach((s) => rows.push({
          case_id: "C" + String(10000 + i),
          interval_start: dayStr(SCCS.start, s.a),
          interval_end: dayStr(SCCS.start, s.a + s.d),
          on_drug: s.on,
          n_events: s.ev,
          days_at_risk: s.d,
          frailty_tier: t.n,
        }));
      }
      return { cols: ["case_id", "interval_start", "interval_end", "on_drug", "n_events", "days_at_risk", "frailty_tier"], rows: rows, name: "demo-sccs" };
    }

    // ── Case-crossover ──────────────────────────────────────────────────────
    // Long format, one row per window. Each case supplies one hazard window (just
    // before the event) and three earlier control windows. Exposure prevalence
    // differs a lot between people; the matched analysis never compares across them.
    const CCO = {
      seed: 20200414, cases: 500, controls: 3, trueOR: 2.5, hazardDays: 7, gapDays: 30, start: "2019-06-01",
      tiers: [0.10, 0.25, 0.45], tierNames: ["occasional", "regular", "frequent"], mix: [0.40, 0.35, 0.25],
    };
    function buildCco() {
      const rand = lcg(CCO.seed);
      const pick = (ws) => { let u = rand(), a = 0; for (let i = 0; i < ws.length; i++) { a += ws[i]; if (u < a) return i; } return ws.length - 1; };
      const rows = [];
      for (let i = 1; i <= CCO.cases; i++) {
        const ti = pick(CCO.mix), p = CCO.tiers[ti];
        const q = (CCO.trueOR * p) / (1 - p + CCO.trueOR * p);   // makes the conditional OR exactly trueOR
        const evDay = 120 + Math.floor(rand() * 200);
        const mk = (label, hz, off, ex) => ({
          case_id: "X" + String(2000 + i), window: label, is_hazard_window: hz,
          window_start: dayStr(CCO.start, evDay - off - CCO.hazardDays), window_end: dayStr(CCO.start, evDay - off),
          drug_taken: ex ? "Y" : "N", usage_tier: CCO.tierNames[ti],
        });
        rows.push(mk("hazard", 1, 0, rand() < q));
        for (let k = 1; k <= CCO.controls; k++) rows.push(mk("control " + k, 0, k * CCO.gapDays, rand() < p));
      }
      return { cols: ["case_id", "window", "is_hazard_window", "window_start", "window_end", "drug_taken", "usage_tier"], rows: rows, name: "demo-case-crossover" };
    }

    function buildCohort() {
      let seed = DEMO.seed;                              // fixed seed → the demo is reproducible
      const rand = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
      const pick = (ws) => { let u = rand(), a = 0; for (let i = 0; i < ws.length; i++) { a += ws[i]; if (u < a) return i; } return ws.length - 1; };
      const sexes = ["M", "F", "m", "female ", "F"];     // deliberately inconsistent, for the profiler
      const rows = [];
      let i = 0;
      for (let m = 0; m < DEMO.months; m++) {
        const yr = 2018 + Math.floor(m / 12), mo = (m % 12) + 1, post = m >= 12 ? 1 : 0;
        for (let k = 0; k < DEMO.perMonth; k++) {
          i++;
          const sv = pick(DEMO.sevMix);
          const nd = rand() < DEMO.pNew[sv] ? 1 : 0;
          // Smoking depends on severity, never on treatment. If it depended on
          // treatment it would be a mediator, and "the true effect is HR 0.70"
          // would stop being true of the thing the tool estimates.
          const smoker = rand() < 0.18 + 0.10 * sv ? "Y" : "N";
          const age = Math.round((56 + 5 * sv + (rand() + rand() + rand() - 1.5) * 9) * 10) / 10;
          const lhr = DEMO.sevLHR[sv] + DEMO.smokeLHR * (smoker === "Y") + DEMO.stepLHR * post + Math.log(DEMO.trueHR) * nd;
          const t = -Math.log(rand() || 1e-9) / (DEMO.baseRate * Math.exp(lhr));
          const ev = t <= 365 ? 1 : 0, fu = Math.round(Math.min(t, 365) * 10) / 10;
          const idx = yr + "-" + String(mo).padStart(2, "0") + "-15";
          rows.push({
            patient_id: "D" + String(10000 + i),
            index_date: idx,
            age: i % 17 === 0 ? null : age,              // a little missingness
            sex: sexes[i % sexes.length],
            severity: DEMO.sev[sv],
            smoker: smoker,
            new_drug: nd,
            clinic_site: "site-" + String(1 + Math.floor(rand() * DEMO.sites)).padStart(2, "0"),
            followup_days: fu,
            outcome: ev,
            event_date: ev ? new Date(Date.parse(idx) + fu * 86400000).toISOString().slice(0, 10) : null,
            disc_days: i % 3 === 0 ? Math.round(fu * 0.55 * 10) / 10 : null,
          });
        }
      }
      return { cols: ["patient_id", "index_date", "age", "sex", "severity", "smoker", "new_drug", "clinic_site", "followup_days", "outcome", "event_date", "disc_days"], rows: rows, name: "demo-cohort" };
    }

    const SCCS_STORY =
      "<strong>Fabricated data — not real patients.</strong> Long format: one row per person-interval, " +
      "and only people who actually had an event, which is what a <em>case series</em> means. One fixed seed, from this model:" +
      "<ul class='mt-1 ml-4 list-disc space-y-0.5'>" +
      "<li>Each person is observed for " + SCCS.obsDays + " days and has a <code>frailty_tier</code> setting their baseline event rate — the frequent-event tier is about <strong>28×</strong> the rare one.</li>" +
      "<li>The frailer a person is, the more likely they are to be given the drug (" + SCCS.tiers.map((t) => Math.round(t.pExp * 100) + "%").join(" / ") + ") and the longer they stay on it (" + SCCS.tiers.map((t) => t.riskDays + "d").join(" / ") + "). So drug time is heavily concentrated in the people who were going to have events anyway.</li>" +
      "<li>While on the drug, the event rate is multiplied by the <strong>true IRR of " + SCCS.trueIRR.toFixed(1) + "</strong>. Nothing else changes.</li></ul>" +
      "<p class='mt-1'>Map <code>case_id</code>, <code>on_drug</code>, <code>n_events</code> and <code>days_at_risk</code>. You should see:</p>" +
      "<table class='mt-1 w-full max-w-lg text-[11px]'><tbody>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>Self-controlled IRR (each person vs themselves)</td><td class='font-semibold'>≈ 2.99 (2.57–3.49)</td></tr>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>Pooled across people (shown as a contrast)</td><td class='font-semibold'>≈ 3.46 (3.01–3.97) — biased</td></tr>" +
      "</tbody></table>" +
      "<p class='mt-1'>The pooled row is what you get by forgetting whose interval is whose. It is too high because drug time " +
      "belongs disproportionately to frail people. <code>frailty_tier</code> is in the file, but the self-controlled estimate " +
      "<strong>never needs it</strong> — each person is their own control, so anything fixed about them cancels. That is the whole point of the design.</p>";

    const CCO_STORY =
      "<strong>Fabricated data — not real patients.</strong> Long format: " + (CCO.controls + 1) + " rows per case — one " +
      CCO.hazardDays + "-day <em>hazard</em> window ending at the event, and " + CCO.controls + " earlier " + CCO.hazardDays +
      "-day <em>control</em> windows " + CCO.gapDays + " days apart. One fixed seed, from this model:" +
      "<ul class='mt-1 ml-4 list-disc space-y-0.5'>" +
      "<li>Each case has a personal <code>usage_tier</code> — background chance of having taken the drug in any given window of " +
      CCO.tiers.map((p) => Math.round(p * 100) + "%").join(" / ") + ". People differ enormously.</li>" +
      "<li>In the hazard window the odds of exposure are multiplied by the <strong>true odds ratio of " + CCO.trueOR.toFixed(1) + "</strong>, applied to that person's own background odds.</li></ul>" +
      "<p class='mt-1'>Map <code>case_id</code>, <code>is_hazard_window</code> and <code>drug_taken</code> — note the last is coded <strong>Y/N</strong>, so the structure panel has to work out which value means yes. You should see:</p>" +
      "<table class='mt-1 w-full max-w-lg text-[11px]'><tbody>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>Matched OR (each case vs their own earlier windows)</td><td class='font-semibold'>≈ 2.55 (2.03–3.21)</td></tr>" +
      "<tr><td class='py-0.5 pr-3 text-slate-600'>Unmatched (shown as a contrast)</td><td class='font-semibold'>≈ 2.33 (1.88–2.88)</td></tr>" +
      "</tbody></table>" +
      "<p class='mt-1'>Throwing away the pairing pulls the odds ratio towards 1 — an odds ratio is not collapsible, so the " +
      "population-average number is not the within-person one, and it is the within-person one the design is built to estimate. " +
      "<code>usage_tier</code> cannot confound the matched estimate no matter how strong it is, because it never varies within a case. " +
      "One caveat this demo does <em>not</em> contain: if drug use had been trending over calendar time, control windows taken " +
      "earlier would understate exposure and the matched OR would be biased upward. Exposure here is flat over time.</p>";

    // ── A cohort that should not be analysed ────────────────────────────────
    // Treatment is almost decided by one covariate, so the two arms barely meet.
    // The true effect is exactly nothing. Every diagnostic added for positivity
    // fires here, which is the only way anyone will find them.
    const OVL = { seed: 20200731, n: 800, slope: 9, outLHR: 1.0, trueHR: 1.0, base: 0.0018 };
    function buildOverlap() {
      const rand = lcg(OVL.seed);
      const nrm = () => (rand() + rand() + rand() + rand() - 2) * 0.87;
      const rows = [];
      for (let i = 1; i <= OVL.n; i++) {
        const x = nrm();
        const T = rand() < 1 / (1 + Math.exp(-OVL.slope * x)) ? 1 : 0;
        const t = -Math.log(rand() || 1e-9) / (OVL.base * Math.exp(OVL.outLHR * x + Math.log(OVL.trueHR) * T));
        rows.push({
          patient_id: "O" + String(30000 + i), frailty_index: Math.round(x * 1000) / 1000,
          new_drug: T, followup_days: Math.round(Math.min(t, 365) * 10) / 10, outcome: t <= 365 ? 1 : 0,
        });
      }
      return { cols: ["patient_id", "frailty_index", "new_drug", "followup_days", "outcome"], rows: rows, name: "demo-no-overlap" };
    }
    const OVL_STORY =
      "<strong>Fabricated data — not real patients, and deliberately not analysable.</strong> " + OVL.n + " rows, one fixed seed:" +
      "<ul class='mt-1 ml-4 list-disc space-y-0.5'>" +
      "<li>A single <code>frailty_index</code> almost decides who gets the drug — the log-odds move by " + OVL.slope + " per unit — so the frailest are nearly all treated and the fittest nearly all untreated.</li>" +
      "<li>The same index strongly raises the hazard. The <strong>true treatment effect is exactly HR 1.00</strong>: the drug does nothing.</li></ul>" +
      "<p class='mt-1'>Run it as an active-comparator cohort with <code>frailty_index</code> as the only covariate. A crude comparison says the drug is harmful (HR ≈ 1.7) because it is given to frail people. That much a propensity score can fix. What it cannot fix is that <strong>for a large share of these patients there is nobody in the other arm to compare with at all</strong> — and the tool will say so, refuse the IPTW estimate, and offer the routes out.</p>" +
      "<p class='mt-1 text-slate-500'>This demo exists because a diagnostic nobody ever sees fire is a diagnostic nobody trusts. Try it with stabilised weights, then with truncation, then with common-support restriction, and watch which numbers move and which do not.</p>";

    const DEMOS = {
      cohort: { build: buildCohort, story: () => DEMO_STORY },
      overlap: { build: buildOverlap, story: () => OVL_STORY },
      sccs: { build: buildSccs, story: () => SCCS_STORY },
      cco: { build: buildCco, story: () => CCO_STORY },
    };
    document.querySelectorAll("[data-demo]").forEach((b) => b.addEventListener("click", () => {
      const d = DEMOS[b.getAttribute("data-demo")]; if (!d) return;
      const { cols, rows, name } = d.build();
      WB = null; SHEETS = []; SPLITINFO = null; CBWB = null; CODEBOOK = {}; CBINFO = null;
      STRUCT = Object.assign({}, STRUCT, { sheet: "", headerRow: 0, split: false, yes: {} });
      setData(cols, rows, name);
      setMsg("");
      $("demonote").classList.remove("hidden");
      $("demonote").innerHTML = d.story();
    }));

    // ── Exports ──
    const dl = (blob, nm) => { const u = URL.createObjectURL(blob); const a = document.createElement("a"); a.href = u; a.download = nm; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(u), 1000); };
    const csvCell = (v) => { const s = v == null ? "" : (v instanceof Date ? v.toISOString().slice(0, 10) : String(v)); return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
    const toCSV = (cols, rows) => [cols.map(csvCell).join(","), ...rows.map((r) => cols.map((c) => csvCell(r[c])).join(","))].join("\n");

    $("dlmaster").addEventListener("click", () => {
      if (!DATA.rows.length) return;
      dl(new Blob(["﻿" + toCSV(DATA.columns, DATA.rows)], { type: "text/csv;charset=utf-8" }), DATA.name + "-master.csv");
    });
    $("dldict").addEventListener("click", () => {
      if (!DATA.profile.length) return;
      const cols = ["column", "codebook_definition", "inferred_type", "missing_pct", "distinct", "range_or_top", "flags"];
      const rows = DATA.profile.map((p) => ({ column: p.name, codebook_definition: p.def || "", inferred_type: p.type, missing_pct: Math.round(p.missingPct), distinct: p.distinct, range_or_top: p.range, flags: p.flags.map((f) => f.msg).join("; ") }));
      dl(new Blob(["﻿" + toCSV(cols, rows)], { type: "text/csv;charset=utf-8" }), DATA.name + "-dictionary.csv");
    });

    // ── Step 1: clinical question + design (persisted) ──
    const Q_KEY = "daniel.rwe-studio";
    const qNames = ["q_pop", "q_exp", "q_comp", "q_out"];
    const saveQ = () => {
      const s = {};
      qNames.forEach((n) => { const e = document.querySelector('[name="' + n + '"]'); if (e) s[n] = e.value; });
      const d = document.querySelector('[name="design"]:checked'); s.design = d ? d.value : "";
      try { localStorage.setItem(Q_KEY, JSON.stringify(s)); } catch (e) {}
    };
    (() => {
      try {
        const s = JSON.parse(localStorage.getItem(Q_KEY) || "null"); if (!s) return;
        qNames.forEach((n) => { const e = document.querySelector('[name="' + n + '"]'); if (e && s[n] != null) e.value = s[n]; });
        if (s.design) { const r = document.querySelector('[name="design"][value="' + s.design + '"]'); if (r) r.checked = true; }
      } catch (e) {}
    })();
    document.querySelectorAll('[name="q_pop"],[name="q_exp"],[name="q_comp"],[name="q_out"],[name="design"]').forEach((e) => e.addEventListener("input", saveQ));

    // ── Clear & start over ──────────────────────────────────────────────────
    // The page saves the question and design on every keystroke and says so
    // nowhere obvious, so a restored value is indistinguishable from a shipped
    // default — and there was no way back to a blank form without dev tools.
    // Only keys this page owns are removed; another page's storage is never
    // touched, for the same reason it is never written.
    const ownKeys = () => {
      const out = [];
      try { for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k === Q_KEY || (k && k.indexOf(Q_KEY + ".") === 0)) out.push(k); } } catch (e) {}
      return out;
    };
    $("clearall").addEventListener("click", () => {
      const keys = ownKeys();
      const bits = [];
      if (keys.length) bits.push("the saved question and design");
      if (DATA.rows.length) bits.push("the loaded dataset (" + DATA.rows.length + " rows) and its column mapping");
      if (LAST) bits.push("the analysis results");
      if (!bits.length) bits.push("this form");
      if (!confirm("Clear " + bits.join(", ") + "?\n\nNothing here was ever uploaded, so this only affects this browser.")) return;
      keys.forEach((k) => { try { localStorage.removeItem(k); } catch (e) {} });
      qNames.forEach((n) => { const e = document.querySelector('[name="' + n + '"]'); if (e) e.value = ""; });
      document.querySelectorAll('[name="design"]').forEach((r) => { r.checked = false; });
      ["s_policy", "s_twodrugs", "s_transient", "s_acute"].forEach((n) => { const e = document.querySelector('[name="' + n + '"]'); if (e) e.checked = false; });
      $("suggestmsg").textContent = "";
      // Unload the dataset and everything derived from it, so no later step is
      // left pointing at data that is gone.
      DATA = { rows: [], columns: [], profile: [], name: "dataset" };
      WB = null; SHEETS = []; SPLITINFO = null; CBWB = null; CBNAME = ""; CODEBOOK = {}; CBINFO = null;
      STRUCT = { sheet: "", headerRow: 0, split: false, unit: "", unitConf: "low", idCol: "", idConf: "low", repeats: 0, repeatKind: "none", dateCols: [], dayFirst: false, vocabs: [], yes: {} };
      YMCACHE = null; MAP = {}; COVS = []; COVROLE = {}; PSCSPLIT = {}; PSCRUN = null; MASTER = null; LAST = null;
      ["file", "cbfile"].forEach((id) => { const e = $(id); if (e) e.value = ""; });
      ["results", "mapcard", "cleancard", "anacard", "expcard", "demonote", "anaresults", "table1", "itschart", "routput", "dlfitted", "pscresults"].forEach((id) => { const e = $(id); if (e) e.classList.add("hidden"); });
      ["fileinfo", "cbinfo", "cleaninfo", "anastatus", "mapmsg", "covnote"].forEach((id) => { const e = $(id); if (e) e.textContent = ""; });
      setMsg("Cleared. The four boxes above show their grey examples again — those are hints, not values.");
      try { window.scrollTo({ top: 0, behavior: "smooth" }); } catch (e) { window.scrollTo(0, 0); }
    });

    const DESIGN_LABEL = { acnu: "Active-comparator new-user cohort", sccs: "Self-controlled case series", cco: "Case-crossover", its: "Interrupted time series" };
    $("suggest").addEventListener("click", () => {
      const ck = (n) => { const e = document.querySelector('[name="' + n + '"]'); return !!(e && e.checked); };
      let v, why;
      if (ck("s_policy")) { v = "its"; why = "a population-level intervention with a clear start date is evaluated by interrupted time series — the pre-intervention trend, projected forward, is the counterfactual."; }
      else if (ck("s_twodrugs")) { v = "acnu"; why = "you're comparing two active treatments — an active-comparator new-user cohort minimises confounding by indication."; }
      else if (ck("s_transient") && ck("s_acute")) { v = "sccs"; why = "a transient exposure with an acute outcome suits a self-controlled design (each case is its own control); a case-crossover is a good alternative."; }
      else if (ck("s_acute")) { v = "cco"; why = "for an acute, abrupt-onset event, a case-crossover contrasts exposure just before the event with earlier control windows."; }
      else { v = "acnu"; why = "defaulting to an active-comparator new-user cohort — tick more boxes for a sharper suggestion."; }
      const r = document.querySelector('[name="design"][value="' + v + '"]'); if (r) { r.checked = true; saveQ(); }
      $("suggestmsg").textContent = "Recommended: " + DESIGN_LABEL[v] + " — " + why;
    });

    // ── Steps 3–6: map → clean → analyse (R) → export ──
    // Shared R guards. A role that must be 0/1 has to actually be 0/1, and a role
    // that must be numeric has to hold numbers. as.numeric() on text yields NA,
    // and every design here would then carry on and print a number computed from
    // a variable that silently left the model. Refuse instead, and say what to fix.
    const R_CHK01 = "chk01<-function(v,nm){ x<-suppressWarnings(as.numeric(v)); u<-unique(x[!is.na(x)]); if(length(u)==0 || !all(u %in% c(0,1))) stop(sprintf('The column mapped to %s is not coded 0/1 (values seen: %s). Say which value means yes under \"Coded flags\" in the structure panel, or map a different column.', nm, paste(head(unique(as.character(v)),6),collapse=', '))); x }\n";
    const R_CHKNUM = "chknum<-function(v,nm){ x<-suppressWarnings(as.numeric(v)); if(all(is.na(x))) stop(sprintf('The column mapped to %s holds no numeric values (values seen: %s).', nm, paste(head(unique(as.character(v)),6),collapse=', '))); x }\n";
    const SPEC = {
      acnu: {
        label: "Active-comparator new-user cohort",
        hint: "One row per new user. Map treatment (1=exposure, 0=comparator), follow-up time, and the outcome event; tick baseline covariates for the propensity score.",
        covariates: true,
        onePerPerson: true,
        roles: [
          { k: "TREAT", label: "Treatment (1=exposure, 0=comparator)", types: ["binary", "number"], req: true },
          { k: "TIME", label: "Follow-up time (days)", types: ["number"], req: true },
          { k: "EVENT", label: "Outcome event (0/1)", types: ["binary", "number"], req: true },
          { k: "DISC", label: "Time to discontinuation / switch (days, for PP)", types: ["number"], req: false },
        ],
        rscript: (covInfo, opts) => {
          opts = opts || {};
          covInfo = covInfo || [];
          const q = (s) => "'" + String(s == null ? "" : s).replace(/\\/g, "\\\\").replace(/'/g, "\\'") + "'";
          const M = opts.methods || [], E = (opts.estimands && opts.estimands.length) ? opts.estimands : ["ITT"], ratio = opts.ratio || 2, ns = opts.nstrata || 10;
          const dropped = opts.dropped || [];
          let r = "d<-read.csv('/data.csv', stringsAsFactors=FALSE); library(survival)\n";
          // A covariate has to enter the model as what it is. as.numeric() on a text
          // column yields all-NA, which drops it from the propensity model silently —
          // the only symptom being crude and adjusted estimates that agree exactly.
          r += R_CHK01 + R_CHKNUM;
          r += "d$TREAT<-chk01(d$TREAT,'Treatment'); d$EVENT<-chk01(d$EVENT,'Outcome event'); d$TIME<-chknum(d$TIME,'Follow-up time')\n";
          r += "covs<-c(" + covInfo.map((c) => q(c.col)).join(",") + "); covsrc<-c(" + covInfo.map((c) => q(c.label)).join(",") + "); covkind<-c(" + covInfo.map((c) => q(c.kind)).join(",") + ")\n";
          r += "if(length(covs)==0) stop('None of the ticked covariates can be used in a propensity model — see the note under the covariate list.')\n";
          r += "need<-c('TREAT','TIME','EVENT',covs)\n";
          r += "for(cc in need) d[[cc]][trimws(as.character(d[[cc]]))=='']<-NA\n";
          r += "okr<-complete.cases(d[,need,drop=FALSE]); if(sum(!okr)>0) cat('RESULT_NOTE|Dropped ',sum(!okr),' row(s) with a missing treatment, follow-up time, outcome, or covariate value.\\n',sep='')\n";
          r += "d<-d[okr,,drop=FALSE]\n";
          r += "for(i in seq_along(covs)){ if(covkind[i]=='factor') d[[covs[i]]]<-factor(trimws(as.character(d[[covs[i]]]))) else d[[covs[i]]]<-suppressWarnings(as.numeric(d[[covs[i]]])) }\n";
          r += "psm<-suppressWarnings(glm(as.formula(paste('TREAT ~', paste(covs, collapse=' + '))), data=d, family=binomial))\n";
          r += "alias<-names(coef(psm))[is.na(coef(psm))]; if(length(alias)) cat('RESULT_NOTE|',length(alias),' propensity-model term(s) were collinear with the rest and dropped: ',paste(alias,collapse=', '),'.\\n',sep='')\n";
          r += "ps<-as.numeric(predict(psm, type='response'))\n";
          r += "ps<-pmin(pmax(ps,1e-6),1-1e-6); d$lp<-qlogis(ps); tr<-d$TREAT==1; n<-nrow(d)\n";
          // ── Positivity ────────────────────────────────────────────────────
          // A propensity model always returns a number. It returns one just as
          // readily when an arm has no comparable members at all, and the weighted
          // hazard ratio that follows looks exactly like a real one. So the common
          // support is measured, and the weights it produces are inspected, before
          // anything is reported.
          r += "trimmode<-'" + (opts.trim || "none") + "'\n";
          r += "psT<-ps[tr]; psC<-ps[!tr]; csLo<-max(min(psT),min(psC)); csHi<-min(max(psT),max(psC))\n";
          r += "outT<-sum(psT<csLo | psT>csHi); outC<-sum(psC<csLo | psC>csHi)\n";
          r += "keep<-rep(TRUE,n); trimlab<-'none'\n";
          r += "if(trimmode=='cs'){ keep<-ps>=csLo & ps<=csHi; trimlab<-'restricted to the region of common support' }\n";
          r += "if(trimmode=='pct'){ lo1<-as.numeric(quantile(ps,0.01)); hi1<-as.numeric(quantile(ps,0.99)); keep<-ps>=lo1 & ps<=hi1; trimlab<-'trimmed to the 1st-99th percentile of the propensity score' }\n";
          r += "ntrim<-sum(!keep)\n";
          r += "if(ntrim>0){ cat('RESULT_NOTE|Cohort ',trimlab,': ',ntrim,' of ',n,' row(s) removed before every estimate below, so all rows are comparable. This changes the population the effect refers to.\\n',sep='')\n";
          r += "  d<-d[keep,,drop=FALSE]; ps<-ps[keep]; tr<-tr[keep]; n<-nrow(d); d$lp<-qlogis(ps); psT<-ps[tr]; psC<-ps[!tr] }\n";
          // ── Weights ───────────────────────────────────────────────────────
          // Stabilised by default: the numerator is the marginal probability of the
          // treatment actually received rather than 1. Same estimand, far tamer
          // weight distribution. Truncation is the fallback, and only on request.
          // NOTE: neither of these touches positivity. They make an unstable number
          // stable; they cannot manufacture a comparator who does not exist, which
          // is why the common-support check above is reported on its own terms and
          // is never satisfied by a healthy weight profile.
          r += "wtmode<-'" + (opts.wts || "stab") + "'; truncmode<-'" + (opts.trunc || "none") + "'\n";
          r += "pT<-mean(tr)\n";
          r += "wU<-ifelse(tr,1/ps,1/(1-ps))\n";
          r += "wS<-ifelse(tr,pT/ps,(1-pT)/(1-ps))\n";
          r += "w0<-if(wtmode=='unstab') wU else wS\n";
          r += "qq<-if(truncmode=='p1') 0.01 else if(truncmode=='p5') 0.05 else NA_real_\n";
          r += "wI<-w0; ntrunc<-0; trunclab<-'none'\n";
          r += "if(!is.na(qq)){ tlo<-as.numeric(quantile(w0,qq)); thi<-as.numeric(quantile(w0,1-qq)); ntrunc<-sum(w0<tlo | w0>thi); wI<-pmin(pmax(w0,tlo),thi); trunclab<-sprintf('%.0f/%.0f percentile',100*qq,100*(1-qq)) }\n";
          r += "wdiag<-function(w){ e<-sum(w)^2/sum(w^2); k<-max(1,ceiling(0.01*length(w))); c(e, 100*e/length(w), max(w), 100*sum(sort(w,decreasing=TRUE)[1:k])/sum(w)) }\n";
          r += "dU<-wdiag(wU); dS<-wdiag(wS); dF<-wdiag(wI)\n";
          r += "essPct<-dF[2]; maxw<-dF[3]; top1<-dF[4]\n";
          // Refusal is now the last resort, not the first: stabilisation and
          // truncation are both on the table before anything is withheld.
          r += "unstable<-(essPct<10) || (top1>25)\n";
          r += "rescuable<-unstable && truncmode=='none'\n";
          // Every weighting estimator has to be judged on ITS OWN weights. wdiag()
          // used to be applied to the IPTW weights alone, so an SMR-weighted hazard
          // ratio resting on a SMALLER effective sample than the IPTW estimate the
          // tool had just refused was printed with no comment at all — and the panel
          // told the reader "the other estimators are unaffected".
          // Overlap weights are bounded in [0,1] by construction, so a small
          // effective sample there means the equipoise population is small, not that
          // a handful of patients carry the answer. Those diagnostics are reported
          // and explained; they are never used to withhold.
          r += "wSMR<-ifelse(tr,1,ps/(1-ps)); wOVL<-ifelse(tr,1-ps,ps)\n";
          r += "wgate<-function(z) (z[2]<10) || (z[4]>25)\n";
          r += "zSMR<-wdiag(wSMR); smrbad<-wgate(zSMR); zOVL<-wdiag(wOVL)\n";
          // Non-overlap has to reach the estimates table too. Someone reading only
          // the hazard ratios must not be able to miss that a large share of the
          // cohort has no counterpart — the weights can look perfect regardless.
          r += "outPct<-100*(outT+outC)/n\n";
          r += "if(ntrim==0 && (outT+outC)>0) cat(sprintf('RESULT_NOTE|%d of %d patient(s) (%.1f%%) have no counterpart in the other arm at their propensity score. Every weighted estimate above extrapolates for them rather than comparing them with anyone. Stabilising or truncating the weights does not change this - restricting to common support does.\\n', outT+outC, n, outPct))\n";
          r += "if(ntrunc>0 && outPct>5) cat('RESULT_NOTE|Truncation was applied while a substantial part of the cohort has no overlap. Truncation tidies the arithmetic; it does not create the missing comparators, so the weight diagnostics will look far healthier than the comparison actually is. Restrict to common support before trusting a truncated estimate here.\\n')\n";
          r += "bi<-function(v) tabulate(pmin(20,pmax(1,ceiling(v*20))),nbins=20)\n";
          r += "cat('PSHIST|',paste(bi(psT),collapse=','),'|',paste(bi(psC),collapse=','),'\\n',sep='')\n";
          r += "fmw<-function(v) paste(sprintf('%.1f',v),collapse=',')\n";
          r += "cat('PSDIAG|nT=',sum(tr),'|nC=',sum(!tr),'|csLo=',sprintf('%.4f',csLo),'|csHi=',sprintf('%.4f',csHi),'|outT=',outT,'|outC=',outC,'|dU=',fmw(dU),'|dS=',fmw(dS),'|dF=',fmw(dF),'|wtmode=',wtmode,'|trunc=',trunclab,'|ntrunc=',ntrunc,'|minps=',sprintf('%.4f',min(ps)),'|maxps=',sprintf('%.4f',max(ps)),'|ntrim=',ntrim,'|trim=',trimlab,'|unstable=',if(unstable) 1 else 0,'|rescuable=',if(rescuable) 1 else 0,'\\n',sep='')\n";
          // One line per weighting scheme the user actually asked for. Field 4 is
          // whether the scheme failed its own stability rule; field 5 is whether
          // failing it withholds the estimate (true for the inverse-probability
          // family, false for overlap weights — see above).
          if (M.indexOf("iptw") >= 0) r += "cat('PSW|IPTW (ATE)|',fmw(dF),'|',if(unstable) 1 else 0,'|1\\n',sep='')\n";
          if (M.indexOf("smrw") >= 0) r += "cat('PSW|SMR weighting (ATT)|',fmw(zSMR),'|',if(smrbad) 1 else 0,'|1\\n',sep='')\n";
          if (M.indexOf("overlap") >= 0) r += "cat('PSW|Overlap weighting (ATO)|',fmw(zOVL),'|',if(wgate(zOVL)) 1 else 0,'|0\\n',sep='')\n";
          r += "cat(sprintf('N = %d; exposure = %d; comparator = %d; events = %d\\n\\n', n, sum(tr), sum(!tr), sum(d$EVENT==1,na.rm=TRUE)))\n";
          r += "cat('RESULT_NOTE|Propensity model: ',sum(covkind=='numeric'),' continuous, ',sum(covkind=='binary'),' binary 0/1, ',sum(covkind=='factor'),' categorical entered as dummy-coded factors',if(any(covkind=='factor')) paste0(' (',paste(covsrc[covkind=='factor'],collapse=', '),')') else '','.\\n',sep='')\n";
          if (dropped.length) r += "cat(" + q("RESULT_NOTE|" + dropped.length + " ticked covariate(s) were left out of the model: " + dropped.map((x) => x.src + " — " + x.why).join("; ") + ".") + ",'\\n',sep='')\n";
          const folded = covInfo.filter((c) => c.collapsed);
          if (folded.length) r += "cat(" + q("RESULT_NOTE|Rare categories were folded into 'other' before modelling: " + folded.map((c) => c.src + " (" + c.rare.length + " of " + c.levels + " levels, each with fewer than " + COV_MIN_PER_LEVEL + " rows)").join("; ") + ".") + ",'\\n',sep='')\n";
          r += "wsmd<-function(x,g,w){ ok<-!is.na(x); a<-g&ok; b<-(!g)&ok; if(sum(a)<1||sum(b)<1) return(NA_real_); m1<-weighted.mean(x[a],w[a]); m0<-weighted.mean(x[b],w[b]); v1<-sum(w[a]*(x[a]-m1)^2)/sum(w[a]); v0<-sum(w[b]*(x[b]-m0)^2)/sum(w[b]); (m1-m0)/sqrt((v1+v0)/2) }\n";
          // Yang & Dalton (2012) multinomial standardised difference: a categorical
          // variable needs the Mahalanobis form, not the continuous one.
          r += "smdcat<-function(f,g,w){ lv<-levels(f); k<-length(lv); if(k<2) return(NA_real_); pr<-function(idx){ ww<-w[idx]; s<-sum(ww); vapply(lv,function(l) sum(ww[f[idx]==l])/s, 0) }; p1<-pr(g); p0<-pr(!g); if(k==2) return((p1[2]-p0[2])/sqrt((p1[2]*(1-p1[2])+p0[2]*(1-p0[2]))/2)); i<-2:k; mk<-function(p){ pv<-as.numeric(p[i]); m<-diag(pv*(1-pv), nrow=length(pv)); for(a in seq_along(pv)) for(b in seq_along(pv)) if(a!=b) m[a,b]<- -pv[a]*pv[b]; m }; S<-(mk(p1)+mk(p0))/2; dv<-as.numeric(p1[i]-p0[i]); tryCatch(as.numeric(sqrt(t(dv)%*%solve(S)%*%dv)), error=function(e) NA_real_) }\n";
          // Balance BEFORE and AFTER weighting. The before column alone tells a
          // reviewer nothing about whether the model fixed anything.
          // The "after" column has to be weighted by a scheme that was actually
          // fitted. It was hardcoded to the IPTW weights, so unticking IPTW left a
          // column headed "SMD after IPTW" in a run where no IPTW estimate existed.
          // With no weighting estimator selected at all there is nothing honest to
          // put here — balance after matching or stratification is a different
          // table this tool does not build — so the column is left empty and said so.
          // Prefer the weights behind an estimate that was actually reported, so the
          // balance column is not describing a scheme the panel just withheld.
          const balSch = M.indexOf("iptw") >= 0 || M.indexOf("smrw") >= 0 || M.indexOf("overlap") >= 0;
          r += "wBAL<-NULL; ballab<-''\n";
          const pick = (cond, v, lab) => (cond ? "if(is.null(wBAL) && " + v[1] + "){ wBAL<-" + v[0] + "; ballab<-" + q(lab) + " }\n" : "");
          r += pick(M.indexOf("iptw") >= 0, ["wI", "!unstable"], "IPTW");
          r += pick(M.indexOf("smrw") >= 0, ["wSMR", "!smrbad"], "SMR weighting");
          r += pick(M.indexOf("overlap") >= 0, ["wOVL", "TRUE"], "overlap weighting");
          r += pick(M.indexOf("iptw") >= 0, ["wI", "TRUE"], "IPTW");
          r += pick(M.indexOf("smrw") >= 0, ["wSMR", "TRUE"], "SMR weighting");
          r += "smd1<-rep(NA_real_,length(covs)); smd2<-rep(NA_real_,length(covs))\n";
          r += "f3<-function(x) if(!is.finite(x)) '-' else sprintf('%.3f',x)\n";
          r += "cat('TABLE1|Characteristic|Comparator (n=',sum(!tr),')|Exposure (n=',sum(tr),')|SMD|',if(is.null(wBAL)) 'SMD after weighting (none fitted)' else paste0('SMD after ',ballab),'\\n',sep='')\n";
          r += "for(i in seq_along(covs)){ cc<-covs[i]; lab<-covsrc[i]\n" +
               "  if(covkind[i]=='factor'){ f<-d[[cc]]; lv<-levels(f)\n" +
               "    s1<-smdcat(f,tr,rep(1,n)); s2<-if(is.null(wBAL)) NA_real_ else smdcat(f,tr,wBAL); smd1[i]<-s1; smd2[i]<-s2\n" +
               "    cat(sprintf('TABLE1|%s, n (%%)|||%s|%s\\n', lab, f3(s1), f3(s2)))\n" +
               "    for(l in lv){ a<-sum(f[!tr]==l); b<-sum(f[tr]==l); cat(sprintf('TABLE1|  %s|%d (%.1f%%)|%d (%.1f%%)||\\n', l, a, 100*a/sum(!tr), b, 100*b/sum(tr))) }\n" +
               "  } else { x<-d[[cc]]\n" +
               "    s1<-wsmd(x,tr,rep(1,n)); s2<-if(is.null(wBAL)) NA_real_ else wsmd(x,tr,wBAL); smd1[i]<-s1; smd2[i]<-s2\n" +
               "    if(covkind[i]=='binary'){ a<-sum(x[!tr]==1,na.rm=TRUE); b<-sum(x[tr]==1,na.rm=TRUE); cat(sprintf('TABLE1|%s, n (%%)|%d (%.1f%%)|%d (%.1f%%)|%s|%s\\n', lab, a, 100*a/sum(!tr), b, 100*b/sum(tr), f3(s1), f3(s2)))\n" +
               "    } else cat(sprintf('TABLE1|%s, mean (SD)|%.2f (%.2f)|%.2f (%.2f)|%s|%s\\n', lab, mean(x[!tr],na.rm=TRUE), sd(x[!tr],na.rm=TRUE), mean(x[tr],na.rm=TRUE), sd(x[tr],na.rm=TRUE), f3(s1), f3(s2))) } }\ncat('\\n')\n";
          r += "mxof<-function(v) if(all(!is.finite(v))) NA_real_ else max(abs(v[is.finite(v)]))\n";
          r += "mx1<-mxof(smd1); mx2<-mxof(smd2)\n";
          r += "cat('PSBAL|mx1=',f3(mx1),'|mx2=',f3(mx2),'|nbad=',sum(abs(smd2)>0.1,na.rm=TRUE),'|ncov=',length(covs),'|wlab=',ballab,'\\n',sep='')\n";
          if (!balSch) r += "cat('RESULT_NOTE|No weighted estimator was selected, so there is no weighted balance column: the standardised differences shown are before any adjustment. Balance after matching or after fine stratification is a separate table this tool does not build - check it in your own analysis before reporting the matched estimate.\\n')\n";
          r += "ET<-list(); EE<-list(); ET[['ITT']]<-d$TIME; EE[['ITT']]<-d$EVENT\n";
          if (E.indexOf("PP") >= 0) r += "if('DISC' %in% names(d)){ disc<-ifelse(is.na(d$DISC), Inf, as.numeric(d$DISC)); ET[['PP']]<-pmin(d$TIME, disc); EE[['PP']]<-d$EVENT*(d$TIME<=disc) }\n";
          r += "fitw<-function(t,e,w,idx,label,quiet=FALSE){ dd<-data.frame(t=t[idx],e=e[idx],TREAT=d$TREAT[idx],w=w[idx]); fit<-tryCatch(coxph(Surv(t,e)~TREAT,data=dd,weights=w,robust=TRUE),error=function(x)NULL); if(is.null(fit)){ if(!quiet) cat(sprintf('RESULT_ESTIMATE|%s|not estimable\\n',label)); return(NA_real_)}; s<-summary(fit); if(!quiet) cat(sprintf('RESULT_ESTIMATE|%s|%.2f (95%% CI %.2f-%.2f)\\n', label, s$conf.int[1,'exp(coef)'], s$conf.int[1,'lower .95'], s$conf.int[1,'upper .95'])); invisible(as.numeric(s$conf.int[1,'exp(coef)'])) }\n";
          if (M.indexOf("matching") >= 0) r += "matchidx<-function(){ ci<-which(!tr); ti<-which(tr); used<-logical(n); cal<-0.2*sd(d$lp); out<-integer(0); ord<-ti[order(d$lp[ti])]; for(i in ord){ cand<-ci[!used[ci]]; if(!length(cand))next; dd<-abs(d$lp[cand]-d$lp[i]); o<-order(dd); k<-0; for(j in o){ if(dd[j]<=cal){ out<-c(out,i,cand[j]); used[cand[j]]<-TRUE; k<-k+1; if(k>=" + ratio + ")break } } }; unique(out) }\n";
          r += "for(est in names(ET)){ t<-ET[[est]]; e<-EE[[est]]; all<-1:n\n";
          r += "  fitw(t,e,rep(1,n),all, paste0('Crude - ',est,' HR'))\n";
          // An IPTW estimate built on collapsed weights is not a weak estimate, it
          // is an arbitrary one: a handful of subjects carry the answer. Refuse it
          // and say which diagnostic failed, rather than print a confident number.
          if (M.indexOf("iptw") >= 0) r += "  if(unstable){ cat(sprintf('RESULT_ESTIMATE|IPTW (ATE) - %s HR|withheld - weights unstable\\n',est)) } else { hrT<-fitw(t,e,wI,all, paste0('IPTW (ATE)',if(wtmode=='stab') ', stabilised' else ', unstabilised', if(ntrunc>0) paste0(', truncated at the ',trunclab) else '',' - ',est,' HR'))\n" +
            "    if(ntrunc>0){ hr0<-fitw(t,e,w0,all,'',TRUE); if(is.finite(hr0) && is.finite(hrT)) cat(sprintf('RESULT_NOTE|Truncation moved the %s IPTW hazard ratio from %.3f (untruncated) to %.3f, by capping %d weight(s) at the %s. Truncation buys precision by accepting a little bias - the capped patients are no longer counted at their full weight - so report the untruncated estimate alongside it.\\n', est, hr0, hrT, ntrunc, trunclab)) } }\n";
          // SMR weights are 1 for the treated and the treatment odds for everyone
          // else: unbounded above, and just as capable of collapsing onto a handful
          // of comparators as the IPTW weights. Same rule, same refusal.
          if (M.indexOf("smrw") >= 0) r += "  if(smrbad){ cat(sprintf('RESULT_ESTIMATE|SMR weighting (ATT) - %s HR|withheld - weights unstable\\n',est)) } else fitw(t,e,wSMR,all, paste0('SMR weighting (ATT) - ',est,' HR'))\n";
          if (M.indexOf("overlap") >= 0) r += "  fitw(t,e,wOVL,all, paste0('Overlap weighting (ATO) - ',est,' HR'))\n";
          // A stratum containing only one arm contributes nothing to a stratified
          // Cox model, so its patients are dropped. That was happening in silence:
          // on the tool's own no-overlap demo, 20% of the cohort at 10 strata and
          // 42% at 50 strata vanished from an estimate printed as if it described
          // everyone. The count now travels with the estimate, as it already does
          // for matching.
          if (M.indexOf("finestrat") >= 0) r += "  { br<-unique(quantile(ps,probs=seq(0,1,length.out=" + (ns + 1) + "))); if(length(br)>=3){ q<-cut(ps,breaks=br,include.lowest=TRUE,labels=FALSE); keep<-ave(as.integer(tr),q,FUN=function(z)length(unique(z)))==2; ok<-which(keep); dd<-data.frame(t=t[ok],e=e[ok],TREAT=d$TREAT[ok],st=q[ok]); fit<-tryCatch(coxph(Surv(t,e)~TREAT+strata(st),data=dd),error=function(x)NULL); if(!is.null(fit)){s<-summary(fit); cat(sprintf('RESULT_ESTIMATE|Fine stratification (" + ns + " strata, %d of %d patients) - %s HR|%.2f (95%% CI %.2f-%.2f)\\n',length(ok),n,est,s$conf.int[1,'exp(coef)'],s$conf.int[1,'lower .95'],s$conf.int[1,'upper .95']))\n" +
            "    if(length(ok)<n) cat(sprintf('RESULT_NOTE|Fine stratification discarded %d of %d patient(s) (%.1f%%) who fell in a propensity stratum holding only one arm - there is nobody to compare them with inside their own stratum. The stratified estimate refers to the remaining %d, not to the cohort you uploaded.\\n', n-length(ok), n, 100*(n-length(ok))/n, length(ok)))} } }\n";
          if (M.indexOf("matching") >= 0) r += "  { mi<-matchidx(); if(length(mi)>2){ dd<-data.frame(t=t[mi],e=e[mi],TREAT=d$TREAT[mi]); fit<-tryCatch(coxph(Surv(t,e)~TREAT,data=dd),error=function(x)NULL); if(!is.null(fit)){s<-summary(fit); cat(sprintf('RESULT_ESTIMATE|" + ratio + ":1 PS matching (%d matched) - %s HR|%.2f (95%% CI %.2f-%.2f)\\n',length(mi),est,s$conf.int[1,'exp(coef)'],s$conf.int[1,'lower .95'],s$conf.int[1,'upper .95']))} } }\n";
          r += "}\n";
          // ── Propensity-score calibration (Stürmer 2005; surrogacy per Lunt 2012) ──
          // Everything the ACNU protocol page currently asks to be typed in by hand.
          const P = opts.psc;
          if (P && P.C.length && P.U.length) {
            const qc = (a) => a.map((c) => q(c.col)).join(",");
            r += "cvC<-c(" + qc(P.C) + "); cvU<-c(" + qc(P.U) + ")\n";
            r += "fmlEP<-as.formula(paste('TREAT ~',paste(cvC,collapse=' + '))); fmlGS<-as.formula(paste('TREAT ~',paste(c(cvC,cvU),collapse=' + ')))\n";
            // Probability scale in both models — the convention the protocol page
            // states. alpha1 and alpha2 are not scale-free, so mixing PS in one
            // model with logit(PS) in the other silently invalidates the correction.
            r += "fep<-suppressWarnings(glm(fmlEP,family=binomial,data=d)); fgs<-suppressWarnings(glm(fmlGS,family=binomial,data=d))\n";
            r += "d$psep<-as.numeric(predict(fep,type='response')); d$psgs<-as.numeric(predict(fgs,type='response'))\n";
            r += "cal<-lm(psgs ~ psep + TREAT, data=d); scal<-summary(cal); cc<-coef(scal)\n";
            r += "a0<-cc[1,1]; a1<-cc[2,1]; a2<-cc[3,1]; a1se<-cc[2,2]; a2se<-cc[3,2]; r2<-scal$r.squared\n";
            // Surrogacy: Y independent of PS_ep given (T, PS_gs). S is the share of
            // the outcome information carried by BOTH scores that the gold-standard
            // score carries alone, as a ratio of likelihood-ratio statistics against
            // a treatment-only model (Lunt 2012, Table 2 footnote g). Nested models,
            // so S is always in [0,100].
            r += "sv<-Surv(d$TIME,d$EVENT)\n";
            r += "m0<-coxph(sv~TREAT,data=d); m1<-coxph(sv~TREAT+psgs,data=d); m2<-coxph(sv~TREAT+psgs+psep,data=d)\n";
            r += "l0<-as.numeric(logLik(m0)); l1<-as.numeric(logLik(m1)); l2<-as.numeric(logLik(m2))\n";
            r += "LR1<-2*(l1-l0); LR2<-2*(l2-l0)\n";
            r += "Sv<-if(is.finite(LR2) && LR2>1e-8) max(0,min(100,100*LR1/LR2)) else NA_real_\n";
            r += "cm<-summary(m2)$coefficients; scoef<-cm['psep','coef']; sp<-cm['psep',ncol(cm)]\n";
            // A demonstration ON THIS DATA of whether the correction helps: fit the
            // claims-only analogue, correct it, and compare with the gold standard.
            r += "mn<-coxph(sv~TREAT+psep,data=d); bT<-coef(mn)['TREAT']; bPS<-coef(mn)['psep']\n";
            r += "mg<-coxph(sv~TREAT+psgs,data=d); bG<-coef(mg)['TREAT']\n";
            r += "bcal<-if(is.finite(a1) && abs(a1)>1e-8) bT-(a2/a1)*bPS else NA_real_\n";
            r += "BB<-" + (P.boot || 0) + "; A1<-numeric(0); A2<-numeric(0); RT<-numeric(0); bfail<-0\n";
            if (P.boot > 0) {
              r += "set.seed(1); nn<-nrow(d)\n";
              r += "for(bi in 1:BB){ ii<-sample.int(nn,nn,replace=TRUE); db<-d[ii,,drop=FALSE]\n";
              r += "  rr<-tryCatch({ e1<-suppressWarnings(glm(fmlEP,family=binomial,data=db)); g1<-suppressWarnings(glm(fmlGS,family=binomial,data=db))\n";
              r += "    db$psep<-as.numeric(predict(e1,type='response')); db$psgs<-as.numeric(predict(g1,type='response'))\n";
              r += "    co<-coef(lm(psgs ~ psep + TREAT, data=db)); c(co[2],co[3]) }, error=function(x) NULL)\n";
              r += "  if(is.null(rr) || any(!is.finite(rr)) || abs(rr[1])<1e-8){ bfail<-bfail+1; next }\n";
              r += "  A1<-c(A1,rr[1]); A2<-c(A2,rr[2]); RT<-c(RT,rr[2]/rr[1]) }\n";
            }
            r += "qn<-function(v,p) if(length(v)>=20) as.numeric(quantile(v,p,names=FALSE)) else NA_real_\n";
            r += "fm<-function(x) if(length(x)==0 || !is.finite(x)) 'NA' else sprintf('%.6g',x)\n";
            r += "cat(paste0('PSC|ev=',sum(d$EVENT==1,na.rm=TRUE),'|a0=',fm(a0),'|a1=',fm(a1),'|a1se=',fm(a1se),'|a2=',fm(a2),'|a2se=',fm(a2se),'|r2=',fm(r2),'|n=',nrow(d),'|nC=',length(cvC),'|nU=',length(cvU),'|S=',fm(Sv),'|scoef=',fm(scoef),'|sp=',fm(sp),'|ratio=',fm(a2/a1),'|B=',length(A1),'|bfail=',bfail,'|a1lo=',fm(qn(A1,0.025)),'|a1hi=',fm(qn(A1,0.975)),'|a2lo=',fm(qn(A2,0.025)),'|a2hi=',fm(qn(A2,0.975)),'|rlo=',fm(qn(RT,0.025)),'|rhi=',fm(qn(RT,0.975)),'|bT=',fm(bT),'|bPS=',fm(bPS),'|bcal=',fm(bcal),'|bG=',fm(bG)),'\\n')\n";
            r += "cat('\\n--- Propensity-score calibration ---\\n')\n";
            r += "cat(sprintf('PS_gs = %.4f + %.4f x PS_ep + %.4f x T   (R2 %.3f, n %d)\\n', a0, a1, a2, r2, nrow(d)))\n";
            r += "cat(sprintf('Surrogacy: S = %.1f%%; PS_ep coefficient %.4f (p = %.4g)\\n', Sv, scoef, sp))\n";
          } else if (P) {
            r += "cat('PSCSKIP|" + (P.why || "not computed") + "\\n')\n";
          }
          return r;
        },
      },
      sccs: {
        label: "Self-controlled case series",
        hint: "Long format — one row per person-interval. Map the case ID, an exposed indicator (0/1), the event count in the interval, and the interval length (person-time).",
        covariates: false,
        roles: [
          { k: "ID", label: "Case ID", types: ["id", "number", "text"], req: true },
          { k: "EXPOSED", label: "Exposed indicator (0/1)", types: ["binary", "number"], req: true },
          { k: "EVENTS", label: "Event count in interval", types: ["number"], req: true },
          { k: "INTERVAL", label: "Interval length (person-time)", types: ["number"], req: true },
        ],
        rscript: () =>
          "d<-read.csv('/data.csv', stringsAsFactors=FALSE)\n" + R_CHK01 + R_CHKNUM +
          "d$EXPOSED<-chk01(d$EXPOSED,'Exposed indicator'); d$EVENTS<-chknum(d$EVENTS,'Event count'); d$INTERVAL<-chknum(d$INTERVAL,'Interval length')\n" +
          // The exact SCCS conditional likelihood: condition on each case's total
          // event count, so the events fall across that case's intervals with
          // probability proportional to tau*exp(b*x). Newton-Raphson on the single
          // parameter, so no per-case nuisance parameter is ever estimated.
          "sccsfit<-function(y,x,tau,id){ b<-0; I<-0\n" +
          "  gs<-split(seq_along(y), id)\n" +
          "  for(it in 1:200){ w<-tau*exp(b*x); U<-0; I<-0\n" +
          "    for(k in gs){ ni<-sum(y[k]); if(ni==0) next; sw<-sum(w[k]); if(!is.finite(sw)||sw<=0) next\n" +
          "      m1<-sum(w[k]*x[k])/sw; m2<-sum(w[k]*x[k]*x[k])/sw\n" +
          "      U<-U+sum(y[k]*x[k])-ni*m1; I<-I+ni*(m2-m1*m1) }\n" +
          "    if(!is.finite(I) || I<=1e-12) break\n" +
          "    st<-U/I; if(!is.finite(st)) break; b<-b+max(-2,min(2,st)); if(abs(st)<1e-10) break }\n" +
          "  list(b=b, se=if(is.finite(I) && I>0) sqrt(1/I) else NA_real_, info=I) }\n" +
          "cf<-sccsfit(d$EVENTS, d$EXPOSED, d$INTERVAL, d$ID)\n" +
          "b<-cf$b; se<-cf$se; irr<-exp(b)\n" +
          "cat(sprintf('Exact conditional SCCS incidence-rate ratio (exposed vs unexposed): %.3f (95%% CI %.3f to %.3f)\\n', irr, exp(b-1.96*se), exp(b+1.96*se)))\n" +
          "cat(sprintf('Cases (strata): %d; interval-rows: %d; events: %d\\n', length(unique(d$ID)), nrow(d), sum(d$EVENTS)))\n" +
          "cat(sprintf('RESULT_ESTIMATE|Self-controlled incidence-rate ratio (within person)|%.2f (95%% CI %.2f-%.2f)\\n', irr, exp(b-1.96*se), exp(b+1.96*se)))\n" +
          // Fitting a dummy per case is the other route to the same number. Where
          // they disagree, something is wrong, so the disagreement is checked
          // rather than assumed away.
          "fe<-tryCatch(glm(EVENTS ~ EXPOSED + factor(ID), family=poisson, offset=log(INTERVAL), data=d), error=function(e) NULL)\n" +
          "if(!is.null(fe)){ bfe<-coef(fe)['EXPOSED']; if(is.finite(bfe) && abs(bfe-b)>0.01) cat(sprintf('RESULT_NOTE|The exact conditional fit (IRR %.3f) and a fixed-effect Poisson fit (IRR %.3f) disagree by more than 1%%. They are algebraically the same estimator, so this points at a numerical problem - check for cases with enormous interval lengths or zero person-time.\\n', irr, exp(bfe))) }\n" +
          // Events per case is what governs how much any case contributes.
          "epc<-as.numeric(tapply(d$EVENTS,d$ID,sum)); both<-tapply(d$EXPOSED,d$ID,function(z)length(unique(z))>1)\n" +
          "cat('TABLE1|Characteristic|Value\\n')\n" +
          "cat(sprintf('TABLE1|Cases (people with >=1 event)|%d\\n', length(epc)))\n" +
          "cat(sprintf('TABLE1|Person-interval rows|%d\\n', nrow(d)))\n" +
          "cat(sprintf('TABLE1|Events, total|%d\\n', sum(d$EVENTS)))\n" +
          "cat(sprintf('TABLE1|Events per case, median (range)|%.0f (%.0f-%.0f)\\n', median(epc), min(epc), max(epc)))\n" +
          "cat(sprintf('TABLE1|Cases with exposed and unexposed time|%d (%.1f%%)\\n', sum(both), 100*mean(both)))\n" +
          "cat(sprintf('TABLE1|Person-time exposed|%.0f (%.1f%%)\\n', sum(d$INTERVAL[d$EXPOSED==1]), 100*sum(d$INTERVAL[d$EXPOSED==1])/sum(d$INTERVAL)))\n" +
          "cat(sprintf('TABLE1|Events during exposed time|%d (%.1f%%)\\n', sum(d$EVENTS[d$EXPOSED==1]), 100*sum(d$EVENTS[d$EXPOSED==1])/sum(d$EVENTS)))\n" +
          "if(median(epc)<2) cat('RESULT_NOTE|Half the cases contribute a single event. The conditional likelihood handles that correctly - it is the design working as intended, not a defect - but the estimate rests on how each case s one event fell relative to their own exposed window, so precision comes from the number of cases rather than the number of events.\\n')\n" +
          // The same data analysed as if the person did not matter. Showing it next
          // to the self-controlled estimate is what makes the design's value visible.
          "p0<-glm(EVENTS ~ EXPOSED, family=poisson, offset=log(INTERVAL), data=d)\n" +
          "bp<-coef(p0)['EXPOSED']; sp<-sqrt(diag(vcov(p0)))['EXPOSED']\n" +
          "cat(sprintf('RESULT_ESTIMATE|Pooled across people, NOT self-controlled (contrast only)|%.2f (95%% CI %.2f-%.2f)\\n', exp(bp), exp(bp-1.96*sp), exp(bp+1.96*sp)))\n" +
          "nb<-sum(tapply(d$EXPOSED, d$ID, function(z) length(unique(z))>1))\n" +
          "cat(sprintf('RESULT_NOTE|%d of %d case(s) contribute exposed and unexposed time and so carry the estimate; the rest are informative only about their own baseline.\\n', nb, length(unique(d$ID))))\n" +
          "cat('RESULT_NOTE|The pooled row ignores which person each interval belongs to. It is shown only as a contrast: it is confounded by anything that differs between people, which is exactly what the self-controlled design removes. Report the self-controlled row.\\n')",
      },
      cco: {
        label: "Case-crossover",
        hint: "Long format — one row per window. Map the case ID (stratum), a case indicator (1=hazard window, 0=control window), and an exposed indicator (0/1).",
        covariates: false,
        roles: [
          { k: "ID", label: "Case ID (stratum)", types: ["id", "number", "text"], req: true },
          { k: "CASE", label: "Case indicator (1=hazard, 0=control)", types: ["binary", "number"], req: true },
          { k: "EXPOSED", label: "Exposed (0/1)", types: ["binary", "number"], req: true },
        ],
        rscript: () =>
          "d<-read.csv('/data.csv', stringsAsFactors=FALSE); library(survival)\n" + R_CHK01 +
          "d$CASE<-chk01(d$CASE,'Case indicator'); d$EXPOSED<-chk01(d$EXPOSED,'Exposed indicator')\n" +
          "fit<-clogit(CASE ~ EXPOSED + strata(ID), data=d); s<-summary(fit)\n" +
          "or<-s$conf.int['EXPOSED','exp(coef)']; lci<-s$conf.int['EXPOSED','lower .95']; uci<-s$conf.int['EXPOSED','upper .95']\n" +
          "cat(sprintf('Conditional logistic odds ratio (case vs control windows): %.3f (95%% CI %.3f to %.3f)\\n', or, lci, uci))\n" +
          "cat(sprintf('Strata (cases): %d; rows: %d\\n', length(unique(d$ID)), nrow(d)))\n" +
          "cat(sprintf('RESULT_ESTIMATE|Matched odds ratio (each case vs its own control windows)|%.2f (95%% CI %.2f-%.2f)\\n', or, lci, uci))\n" +
          // The same windows analysed as one pool, so the value of the matching shows.
          "u<-glm(CASE ~ EXPOSED, family=binomial, data=d); bu<-coef(u)['EXPOSED']; su<-sqrt(diag(vcov(u)))['EXPOSED']\n" +
          "cat(sprintf('RESULT_ESTIMATE|Unmatched, pairing discarded (contrast only)|%.2f (95%% CI %.2f-%.2f)\\n', exp(bu), exp(bu-1.96*su), exp(bu+1.96*su)))\n" +
          "nw<-as.numeric(tapply(rep(1,nrow(d)), d$ID, sum)); hz<-d$EXPOSED[d$CASE==1]; ct<-d$EXPOSED[d$CASE==0]\n" +
          "cat('TABLE1|Characteristic|Value\\n')\n" +
          "cat(sprintf('TABLE1|Cases|%d\\n', length(unique(d$ID))))\n" +
          "cat(sprintf('TABLE1|Windows, total|%d\\n', nrow(d)))\n" +
          "cat(sprintf('TABLE1|Windows per case, median (range)|%.0f (%.0f-%.0f)\\n', median(nw), min(nw), max(nw)))\n" +
          "cat(sprintf('TABLE1|Exposed in the hazard window|%d of %d (%.1f%%)\\n', sum(hz==1), length(hz), 100*mean(hz==1)))\n" +
          "cat(sprintf('TABLE1|Exposed in control windows|%d of %d (%.1f%%)\\n', sum(ct==1), length(ct), 100*mean(ct==1)))\n" +
          "disc<-sum(tapply(seq_len(nrow(d)), d$ID, function(i) length(unique(d$EXPOSED[i]))>1))\n" +
          "cat(sprintf('TABLE1|Cases discordant on exposure (carry the estimate)|%d (%.1f%%)\\n', disc, 100*disc/length(unique(d$ID))))\n" +
          "cat(sprintf('RESULT_NOTE|%d of %d case(s) are discordant on exposure and so carry the estimate; concordant cases contribute nothing to a matched analysis.\\n', disc, length(unique(d$ID))))\n" +
          "cat('RESULT_NOTE|The unmatched row throws the pairing away and is shown only as a contrast. It differs from the matched row both because an odds ratio is not collapsible and because it reintroduces between-person differences. Report the matched row.\\n')",
      },
      its: {
        label: "Interrupted time series",
        hint: "A series over time. Map the time column and the event count (or rate/level) per period; a denominator becomes a log offset. Per-patient rows are aggregated into periods for you — set the interruption point below.",
        covariates: false,
        roles: [
          { k: "TIDX", label: "Time index / period (date or period label)", types: ["date", "number", "categorical", "text", "id"], req: true },
          { k: "YCOUNT", label: "Event count, rate, or level", types: ["number", "binary"], req: true },
          { k: "DENOM", label: "Population denominator / offset", types: ["number"], req: false },
          { k: "SEAS", label: "Season / cycle position (e.g. calendar month)", types: ["number", "categorical", "binary"], req: false },
          { k: "SERIES", label: "Control-series indicator (1=intervention, 0=control)", types: ["binary", "number"], req: false },
        ],
        // Segmented regression, written to run on base R only (stats::glm / lm).
        // Newey–West HAC standard errors and the Durbin–Watson statistic are
        // computed by hand so no package beyond base R is required; MASS is used
        // for the negative binomial only if it happens to be available.
        rscript: (cov, o) => {
          o = o || {};
          const q = (s) => "'" + String(s == null ? "" : s).replace(/\\/g, "\\\\").replace(/'/g, "\\'") + "'";
          const L = [];
          L.push("d<-read.csv('/data.csv', stringsAsFactors=FALSE)");
          L.push(R_CHK01.trim());
          L.push(R_CHKNUM.trim());
          L.push("CUT<-" + q(o.cut) + "; UNIT<-" + q(o.unit || "month") + "; COMBF<-" + q(o.comb || "sum") + "; MODEL<-" + q(o.model || "auto") + "; SEASON<-" + q(o.season || "none") + "; CYC<-" + (o.cycle || 12) + "; AC<-" + q(o.ac || "auto") + "; ORDER<-" + q(o.order || "auto") + "; DCOMB<-" + q(o.denomcomb || "auto"));
          L.push("");
          L.push("# --- parse the time column (ISO dates, slashes, datetimes, YYYY-MM) ---");
          // Period labels arrive in more shapes than ISO. Every shape this fails to
          // parse falls through to a fallback that must NOT quietly sort text.
          L.push("MONNM<-c(jan=1,feb=2,mar=3,apr=4,may=5,jun=6,jul=7,aug=8,sep=9,oct=10,nov=11,dec=12)");
          L.push("pdate<-function(x){");
          L.push("  x<-trimws(as.character(x)); x[x=='' | x=='NA' | x=='NaN']<-NA; y<-x");
          L.push("  cj<-!is.na(y) & grepl('^[0-9]{4}\\u5e74',y)");                       // 2019年3月15日
          L.push("  if(any(cj)){ z<-gsub('\\u5e74','-',y[cj]); z<-gsub('\\u6708','-',z); z<-gsub('\\u65e5','',z); z<-sub('-+$','',z); y[cj]<-z }");
          L.push("  y<-gsub('[./]','-',y); y<-sub('[ T].*$','',y)");
          L.push("  q<-!is.na(y) & grepl('^[0-9]{4}-?[Qq][1-4]$',y)");                   // 2019Q1 / 2019-Q3
          L.push("  if(any(q)) y[q]<-sprintf('%s-%02d-01', substr(y[q],1,4), (as.integer(sub('^.*[Qq]','',y[q]))-1)*3+1)");
          L.push("  mn<-!is.na(y) & grepl('^[A-Za-z]{3,9}-[0-9]{2,4}$',y)");             // Mar-19 / March-2019
          L.push("  if(any(mn)) y[mn]<-vapply(strsplit(y[mn],'-'), function(p){ m<-MONNM[substr(tolower(p[1]),1,3)]; yy<-suppressWarnings(as.integer(p[2])); if(is.na(m)||is.na(yy)) return(NA_character_); if(yy<100) yy<-2000+yy; sprintf('%04d-%02d-01',yy,m) }, '')");
          L.push("  nm<-!is.na(y) & grepl('^[0-9]{4}-[A-Za-z]{3,9}$',y)");               // 2019-Mar
          L.push("  if(any(nm)) y[nm]<-vapply(strsplit(y[nm],'-'), function(p){ m<-MONNM[substr(tolower(p[2]),1,3)]; if(is.na(m)) return(NA_character_); sprintf('%s-%02d-01',p[1],m) }, '')");
          L.push("  c8<-!is.na(y) & grepl('^[0-9]{8}$',y)");                             // 20190315
          L.push("  if(any(c8)) y[c8]<-paste0(substr(y[c8],1,4),'-',substr(y[c8],5,6),'-',substr(y[c8],7,8))");
          L.push("  my<-!is.na(y) & grepl('^[0-9]{1,2}-[0-9]{4}$',y)");                  // 3-2019 (month-year)
          L.push("  if(any(my)) y[my]<-vapply(strsplit(y[my],'-'), function(p) sprintf('%s-%02d-01',p[2],as.integer(p[1])), '')");
          L.push("  ym<-!is.na(y) & grepl('^[0-9]{4}-[0-9]{1,2}$',y); y[ym]<-paste0(y[ym],'-01')");
          L.push("  suppressWarnings(as.Date(y, format='%Y-%m-%d')) }");
          L.push("floorp<-function(dt,u){ if(u=='day') return(dt); if(u=='week') return(dt-(as.integer(format(dt,'%u'))-1)); if(u=='month') return(as.Date(paste0(format(dt,'%Y-%m'),'-01'))); if(u=='quarter'){ m<-as.integer(format(dt,'%m')); return(as.Date(sprintf('%s-%02d-01',format(dt,'%Y'),(m-1)%/%3*3+1))) }; if(u=='year') return(as.Date(paste0(format(dt,'%Y'),'-01-01'))); dt }");
          L.push("tid<-d$TIDX; dts<-pdate(tid); nz<-sum(!is.na(tid) & trimws(as.character(tid))!='')");
          L.push("isdate<-nz>0 && sum(!is.na(dts))>=0.8*nz");
          L.push("if(UNIT!='none' && !isdate){ cat('The time column does not parse as dates, so its literal values are used as the periods.\\n'); UNIT<-'none' }");
          L.push("key<-if(UNIT!='none') format(floorp(dts,UNIT),'%Y-%m-%d') else trimws(as.character(tid))");
          L.push("");
          L.push("Y<-chknum(d$YCOUNT,'Event count / rate / level')");
          L.push("HASN<-'DENOM' %in% names(d); HASG<-'SERIES' %in% names(d); HASS<-'SEAS' %in% names(d)");
          L.push("N<-if(HASN) chknum(d$DENOM,'Population denominator') else rep(NA_real_,nrow(d))");
          // A text control-series indicator used to become NA and then 0, quietly
          // collapsing both series into one. Refuse rather than merge them.
          L.push("G<-if(HASG) chk01(d$SERIES,'the control-series indicator (1=intervention, 0=control)') else rep(0,nrow(d))");
          L.push("SS<-if(HASS) d$SEAS else rep(NA,nrow(d))");
          L.push("ok<-!is.na(key) & key!='' & !is.na(Y); if(sum(!ok)>0) cat(sprintf('Dropped %d row(s) with a missing time or outcome value.\\n',sum(!ok)))");
          L.push("key<-key[ok]; Y<-Y[ok]; N<-N[ok]; G<-G[ok]; SS<-SS[ok]");
          L.push("if(length(Y)<6) stop('Fewer than 6 usable rows — an interrupted time series needs a series, not a handful of points.')");
          L.push("");
          L.push("# --- collapse rows into one row per period (and per series) ---");
          L.push("cmb<-if(COMBF=='mean') function(z) mean(z,na.rm=TRUE) else function(z) sum(z,na.rm=TRUE)");
          L.push("kk<-data.frame(g=G,key=key,stringsAsFactors=FALSE); a<-kk[!duplicated(kk),,drop=FALSE]; rownames(a)<-NULL");
          L.push("gid<-match(paste0(G,'\\r',key), paste0(a$g,'\\r',a$key))");
          L.push("a$nrows<-vapply(seq_len(nrow(a)),function(i) sum(gid==i),0)");
          L.push("a$Y<-vapply(seq_len(nrow(a)),function(i) cmb(Y[gid==i]),0)");
          // The denominator must NOT inherit the outcome's rule. A population figure
          // repeated on every patient row gets multiplied by the row count if summed,
          // so log(rows per period) leaks into the offset and bends both the step and
          // the trend. Default to "first" when it is constant within a period.
          L.push("dmode<-DCOMB");
          L.push("if(HASN){ dconst<-all(vapply(seq_len(nrow(a)), function(i){ z<-N[gid==i]; z<-z[!is.na(z)]; length(z)<2 || all(abs(z-z[1])<1e-9) }, TRUE))");
          L.push("  if(dmode=='auto') dmode<-if(dconst) 'first' else 'sum'");
          L.push("  dfun<-if(dmode=='first') function(z){ z<-z[!is.na(z)]; if(length(z)) z[1] else NA_real_ } else if(dmode=='mean') function(z) mean(z,na.rm=TRUE) else function(z) sum(z,na.rm=TRUE)");
          L.push("  a$N<-vapply(seq_len(nrow(a)),function(i) as.numeric(dfun(N[gid==i])),0) }");
          L.push("if(HASS) a$seas<-vapply(seq_len(nrow(a)),function(i){ z<-SS[gid==i]; as.character(z[1]) },'')");
          L.push("if(max(a$nrows)>1) cat(sprintf('Aggregated %d row(s) into %d period-row(s) by %s (%s).\\n', length(Y), nrow(a), UNIT, COMBF))");
          L.push("");
          // Getting the order of the periods wrong does not blur the answer, it
          // reverses it: alphabetical "Apr-18, Apr-19, Aug-18 ..." turns a rise into
          // a fall. So the order must be ESTABLISHED, never assumed. If nothing here
          // establishes it, the run stops and asks, rather than sorting text.
          L.push("ukey<-unique(a$key); kd<-pdate(ukey); kn<-suppressWarnings(as.numeric(ukey)); ordmode<-''");
          // Kept on one line: in R a top-level `else` beginning a new line is a parse error.
          L.push("if(ORDER=='file'){ ord<-seq_along(ukey); ordmode<-'the order the periods first appear in the file (you confirmed it is chronological)' } else if(ORDER=='alpha'){ ord<-order(ukey); ordmode<-'alphabetical order of the labels (you confirmed that is chronological)' } else if(all(!is.na(kd))){ ord<-order(kd); ordmode<-'dates parsed from the period labels' } else if(all(!is.na(kn))){ ord<-order(kn); ordmode<-'the numeric value of each label' } else { stub<-gsub('[0-9]+','#',ukey); num<-suppressWarnings(as.numeric(gsub('[^0-9]','',ukey))); if(length(unique(stub))==1 && !any(is.na(num)) && !any(duplicated(num))){ ord<-order(num); ordmode<-'the number inside each label' } }");
          L.push("if(ordmode==''){ stop(paste0('Cannot work out the chronological order of the period labels: they do not parse as dates, they are not numbers, and they do not share a single numbered pattern. Sorting them as text would give ', paste(head(sort(ukey),5),collapse=' -> '), ' ... which is very unlikely to be chronological, and analysing periods in the wrong order can reverse the direction of the estimate. Set \"Period order\" to \"the order they appear in the file\" if the file is already sorted, or map a numeric period index instead.')) }");
          L.push("ukey<-ukey[ord]; a$t<-match(a$key,ukey); a<-a[order(a$g,a$t),,drop=FALSE]; rownames(a)<-NULL; np<-length(ukey)");
          L.push("");
          L.push("# --- place the interruption: exact period label, then date, then index ---");
          L.push("cut<-trimws(CUT); t0<-NA");
          L.push("if(cut!=''){ m<-match(cut,ukey); if(!is.na(m)) t0<-m");
          L.push("  if(is.na(t0)){ cd<-pdate(cut); if(!is.na(cd) && all(!is.na(kd))){ w<-which(kd[ord]>=cd); if(length(w)) t0<-min(w) } }");
          L.push("  if(is.na(t0)){ ci<-suppressWarnings(as.integer(cut)); if(!is.na(ci) && ci>=2 && ci<=np) t0<-ci } }");
          L.push("if(is.na(t0)) stop(paste0(\"Could not place the interruption '\",cut,\"' in this series. The \",np,\" periods run from \",ukey[1],\" to \",ukey[np],\". Give a date inside that range, one of those exact period labels, or a period number between 2 and \",np,\".\"))");
          // Wagner (2002) convention: time-since-intervention is 0 at the first
          // affected period, so the "level change" coefficient IS the immediate step
          // and the slope change accrues from the period after. Both conventions are
          // in use, which is why the note below says which one this is.
          L.push("a$level<-as.integer(a$t>=t0); a$tsince<-pmax(0,a$t-t0)");
          L.push("");
          L.push("# --- seasonality ---");
          L.push("seasok<-FALSE");
          L.push("if(SEASON!='none'){ if(!('seas' %in% names(a))){ kd2<-pdate(a$key); if(all(!is.na(kd2))) a$seas<-if(CYC==4) as.character((as.integer(format(kd2,'%m'))-1)%/%3+1) else as.character(as.integer(format(kd2,'%m'))) else a$seas<-as.character(((a$t-1)%%CYC)+1) }");
          L.push("  seasok<-TRUE; if(SEASON=='dummies' && length(unique(a$seas))>max(2,nrow(a)-6)){ cat('Too few periods per season to fit calendar dummies — seasonality dropped.\\n'); seasok<-FALSE } }");
          L.push("");
          L.push("rhs<-if(HASG) 'g + t + level + tsince + g:t + g:level + g:tsince' else 't + level + tsince'");
          L.push("if(seasok && SEASON=='dummies') rhs<-paste(rhs,'+ factor(seas)')");
          L.push("if(seasok && SEASON=='harmonic') rhs<-paste0(rhs,' + sin(2*pi*t/',CYC,') + cos(2*pi*t/',CYC,')')");
          L.push("if(HASN){ bad<-is.na(a$N)|a$N<=0; if(any(bad)){ cat(sprintf('Dropped %d period(s) with a missing or non-positive denominator.\\n',sum(bad))); a<-a[!bad,,drop=FALSE] } }");
          // Counted after the drop above, so the summary describes what was fitted
          // rather than what was collected.
          L.push("gref<-if(HASG) max(a$g) else 0; tt<-sort(unique(a$t[a$g==gref]))");
          L.push("npre<-sum(tt<t0); npost<-sum(tt>=t0); nfit<-length(tt)");
          L.push("if(npre<2 || npost<2) stop(sprintf('After aggregation there are only %d period(s) before and %d from the interruption onward. Segmented regression needs at least 2 of each, and really wants 8.', npre, npost))");
          L.push("counts<-all(abs(a$Y-round(a$Y))<1e-8) && all(a$Y>=0)");
          L.push("fam<-if(MODEL=='linear') 'linear' else if(MODEL=='poisson') 'poisson' else if(counts) 'poisson' else 'linear'");
          L.push("if(fam=='poisson' && !counts) cat('The outcome is not whole counts; a Poisson/quasi-Poisson fit is still reported as requested.\\n')");
          L.push("# A log offset only makes sense on a log link. For a linear fit the denominator");
          L.push("# is applied by modelling the rate itself rather than the count.");
          L.push("useoff<-FALSE; ratemode<-FALSE");
          L.push("if(HASN){ if(fam=='poisson'){ a$logN<-log(a$N); useoff<-TRUE } else { a$Y<-a$Y/a$N; ratemode<-TRUE; cat('Linear model with a denominator: the outcome is modelled as a rate (value divided by the denominator), not with a log offset.\\n') } }");
          L.push("f<-as.formula(paste('Y ~',rhs, if(useoff) '+ offset(logN)' else ''))");
          L.push("if(fam=='poisson'){");
          L.push("  fit<-suppressWarnings(glm(f,family=poisson,data=a))");
          L.push("  disp<-sum(residuals(fit,type='pearson')^2)/df.residual(fit)");
          L.push("  famlab<-sprintf('Poisson (dispersion %.2f)',disp)");
          L.push("  if(is.finite(disp) && disp>1.5){ nb<-NULL");
          L.push("    if(requireNamespace('MASS',quietly=TRUE)) nb<-tryCatch(MASS::glm.nb(f,data=a),error=function(e) NULL)");
          L.push("    if(!is.null(nb)){ fit<-nb; famlab<-sprintf('negative binomial (Poisson dispersion was %.2f)',disp) }");
          L.push("    else { fit<-suppressWarnings(glm(f,family=quasipoisson,data=a)); famlab<-sprintf('quasi-Poisson (dispersion %.2f)',disp) } }");
          L.push("  expo<-TRUE");
          L.push("} else { fit<-lm(f,data=a); famlab<-'linear (ordinary least squares)'; expo<-FALSE }");
          L.push("");
          L.push("# --- Durbin-Watson on the residuals, within each series ---");
          L.push("e<-residuals(fit,type=if(inherits(fit,'glm')) 'pearson' else 'response')");
          L.push("num<-0; den<-0");
          L.push("for(gg in unique(a$g)){ ee<-e[a$g==gg]; if(length(ee)>2){ num<-num+sum(diff(ee)^2); den<-den+sum(ee^2) } }");
          L.push("dw<-if(den>0) num/den else NA_real_; r1<-if(is.na(dw)) NA_real_ else 1-dw/2");
          L.push("");
          L.push("# --- Newey-West HAC sandwich, base R only. Terms R could not estimate");
          L.push("# (collinear with the rest of the model) are dropped everywhere, or the");
          L.push("# bread matrix is singular and every variance comes back NA. ---");
          L.push("cf<-coef(fit); alias<-names(cf)[is.na(cf)]; gdn<-names(cf)[!is.na(cf)]");
          L.push("mmk<-function(fit) model.matrix(fit)[,gdn,drop=FALSE]");
          L.push("brd<-function(fit){ X<-mmk(fit); w<-fit$weights; if(is.null(w)||length(w)!=nrow(X)) w<-rep(1,nrow(X)); solve(crossprod(X*sqrt(w))) }");
          L.push("ef<-function(fit){ X<-mmk(fit); if(inherits(fit,'glm')){ mu<-fitted(fit); dm<-fit$family$mu.eta(fit$linear.predictors); V<-fit$family$variance(mu); r<-dm*(fit$y-mu)/V } else r<-residuals(fit); X*r }");
          // Lag is measured in PERIODS, not in rows. A missing month, or a period
          // dropped for a bad denominator, leaves neighbouring rows several periods
          // apart; treating them as lag 1 mis-weights the correction.
          L.push("hacv<-function(fit,Lg,gv,tv){ U<-ef(fit); n<-nrow(U); M<-crossprod(U); if(Lg>0) for(l in 1:Lg){ w<-1-l/(Lg+1); same<-as.numeric(gv[(l+1):n]==gv[1:(n-l)] & (tv[(l+1):n]-tv[1:(n-l)])==l); Gm<-crossprod(U[(l+1):n,,drop=FALSE]*same, U[1:(n-l),,drop=FALSE]); M<-M+w*(Gm+t(Gm)) }; B<-brd(fit); B%*%M%*%B }");
          L.push("Lg<-max(1,floor(4*(nrow(a)/100)^(2/9)))");
          L.push("Vm<-vcov(fit)[gdn,gdn,drop=FALSE]; Vh<-tryCatch(hacv(fit,Lg,a$g,a$t),error=function(e) NULL)");
          // Durbin-Watson on GLM Pearson residuals has no standard null distribution,
          // and over 24-36 periods it has little power anyway, so it is far too weak
          // to decide whether the correction is applied. HAC is consistent either
          // way and costs nothing here, so "auto" now means "use it", and DW is
          // reported for information rather than used as a gate.
          L.push("useh<-(AC=='newey') || (AC=='auto' && nrow(a)>=12)");
          L.push("if(useh && is.null(Vh)) useh<-FALSE");
          // A (near-)perfect fit makes every score contribution zero, so the sandwich
          // meat vanishes and the intervals come out zero-width. Never report that.
          L.push("hacdeg<-FALSE");
          L.push("if(useh){ dg<-diag(Vh); dm<-diag(Vm); if(any(!is.finite(dg)) || any(dg<=0) || any(dg < 1e-6*dm)){ useh<-FALSE; hacdeg<-TRUE } }");
          L.push("V<-if(useh) Vh else Vm; dimnames(V)<-dimnames(Vm)");
          L.push("selab<-if(useh) sprintf('Newey-West HAC standard errors (Bartlett kernel, lag %d)',Lg) else 'model-based standard errors'");
          L.push("");
          L.push("nmv<-gdn; se<-sqrt(diag(V)); names(se)<-nmv");
          L.push("# rates can be tiny, so fall back to significant digits rather than printing +0.000");
          L.push("fmt<-function(x) if(!is.finite(x)) 'NA' else if(abs(x)>=0.01 || x==0) sprintf('%+.3f',x) else sprintf('%+.3g',x)");
          L.push("rep1<-function(lab,nm){ if(!(nm %in% nmv) || is.na(cf[[nm]])) return(invisible()); b<-as.numeric(cf[[nm]]); s<-as.numeric(se[[nm]]); lo<-b-1.96*s; hi<-b+1.96*s");
          L.push("  if(expo) cat(sprintf('RESULT_ESTIMATE|%s|%.3f (95%% CI %.3f-%.3f)\\n',lab,exp(b),exp(lo),exp(hi)))");
          L.push("  else cat(sprintf('RESULT_ESTIMATE|%s|%s (95%% CI %s to %s)\\n',lab,fmt(b),fmt(lo),fmt(hi))) }");
          L.push("sc<-if(expo) ' (rate ratio)' else ' (absolute change)'");
          L.push("rep1(paste0('Pre-intervention slope, per period',sc),'t')");
          L.push("if(HASG){ rep1(paste0('Level change, control series',sc),'level'); rep1(paste0('Slope change per period, control series',sc),'tsince')");
          L.push("  rep1(paste0('Difference in level change, intervention vs control',sc),'g:level'); rep1(paste0('Difference in slope change per period, intervention vs control',sc),'g:tsince')");
          L.push("} else { rep1(paste0('Level change, immediate step',sc),'level'); rep1(paste0('Slope change, per period',sc),'tsince') }");
          L.push("");
          L.push("# --- observed vs counterfactual at the end of follow-up ---");
          L.push("gmax<-max(a$g); tn<-max(a$t[a$g==gmax]); tsn<-max(0,tn-t0)");
          L.push("L0<-setNames(rep(0,length(nmv)),nmv)");
          L.push("zn<-if(HASG) c('g:level','g:tsince') else c('level','tsince')");
          L.push("if(zn[1] %in% nmv) L0[zn[1]]<-1; if(zn[2] %in% nmv) L0[zn[2]]<-tsn");
          L.push("cfv<-cf[nmv]; cfv[is.na(cfv)]<-0");
          L.push("ct<-sum(L0*cfv); vct<-as.numeric(t(L0)%*%V%*%L0); sct<-if(is.finite(vct) && vct>0) sqrt(vct) else NA_real_");
          L.push("endlab<-ukey[tn]");
          L.push("if(!is.na(sct)){ if(expo) cat(sprintf('RESULT_ESTIMATE|Observed vs counterfactual at %s (end of follow-up)|%.3f (95%% CI %.3f-%.3f)\\n',endlab,exp(ct),exp(ct-1.96*sct),exp(ct+1.96*sct)))");
          L.push("  else cat(sprintf('RESULT_ESTIMATE|Observed minus counterfactual at %s (end of follow-up)|%s (95%% CI %s to %s)\\n',endlab,fmt(ct),fmt(ct-1.96*sct),fmt(ct+1.96*sct))) }");
          L.push("");
          L.push("# --- fitted and counterfactual series ---");
          L.push("X<-model.matrix(fit); Xc<-X");
          L.push("zc<-if(HASG) grepl('^g:(level|tsince)$',colnames(X)) else colnames(X) %in% c('level','tsince')");
          L.push("Xc[,zc]<-0");
          L.push("off<-fit$offset; if(is.null(off)) off<-rep(0,nrow(X))");
          L.push("bb<-cfv[colnames(X)]; bb[is.na(bb)]<-0");
          L.push("inv<-if(inherits(fit,'glm')) fit$family$linkinv else function(z) z");
          L.push("fv<-inv(as.numeric(X%*%bb)+off); cv<-inv(as.numeric(Xc%*%bb)+off)");
          L.push("cat('FITTED|series|period|t|observed|denominator|fitted|counterfactual\\n')");
          L.push("for(i in seq_len(nrow(a))) cat(sprintf('FITTED|%s|%s|%d|%.6g|%s|%.6g|%.6g\\n', if(HASG) (if(a$g[i]>0) 'intervention' else 'control') else 'series', a$key[i], a$t[i], a$Y[i], if(useoff) sprintf('%.6g',a$N[i]) else '', fv[i], cv[i]))");
          L.push("cat(sprintf('ITSMETA|t0=%d|cutlabel=%s|np=%d|pre=%d|post=%d|controlled=%s\\n',t0,ukey[t0],np,npre,npost,if(HASG) 'yes' else 'no'))");
          L.push("");
          // A series should describe itself before it is modelled.
          L.push("pre<-a$g==gref & a$t<t0; pst<-a$g==gref & a$t>=t0");
          L.push("rt<-function(m) if(useoff) sum(a$Y[m])/sum(a$N[m]) else mean(a$Y[m])");
          L.push("cat('TABLE1|Characteristic|Before|From ',ukey[t0],'\\n',sep='')");
          L.push("cat(sprintf('TABLE1|Periods|%d|%d\\n', npre, npost))");
          L.push("cat(sprintf('TABLE1|Total outcome|%.6g|%.6g\\n', sum(a$Y[pre]), sum(a$Y[pst])))");
          L.push("cat(sprintf('TABLE1|%s|%.6g|%.6g\\n', if(useoff) 'Rate per period (outcome/denominator)' else 'Mean per period', rt(pre), rt(pst)))");
          L.push("if(useoff) cat(sprintf('TABLE1|Denominator per period, mean|%.6g|%.6g\\n', mean(a$N[pre]), mean(a$N[pst])))");
          L.push("if(HASG) cat(sprintf('TABLE1|Control-series periods|%d|%d\\n', sum(a$g!=gref & a$t<t0), sum(a$g!=gref & a$t>=t0)))");
          L.push("dwt<-if(is.na(dw)) 'not computable' else sprintf('%.2f (lag-1 residual autocorrelation %+.2f)',dw,r1)");
          L.push("cat(sprintf('RESULT_NOTE|Segmented %s regression over %d period(s) fitted: %d before and %d from %s onward%s. Inference uses %s. Durbin-Watson %s (descriptive only - on GLM Pearson residuals it has no standard null distribution).\\n', famlab, nfit, npre, npost, ukey[t0], if(useoff) ', with log(denominator) as an offset' else '', selab, dwt))");
          L.push("cat(sprintf('RESULT_NOTE|Periods were ordered by %s. Level change is the immediate step at %s; slope change accrues from the period after it (Wagner 2002 convention, time-since-intervention = 0 at the first affected period).\\n', ordmode, ukey[t0]))");
          L.push("if(HASN) cat(sprintf('RESULT_NOTE|The denominator was combined within each period by taking the %s of the rows in that period%s.\\n', dmode, if(DCOMB=='auto' && dmode=='first') ' (chosen automatically because it is constant within every period)' else ''))");
          // A count model with no offset silently assumes a constant population.
          L.push("if(hacdeg) cat('RESULT_NOTE|The Newey-West correction was skipped: the model fits the series so closely that the sandwich estimator degenerates to zero variance, which would print impossibly narrow intervals. Model-based standard errors are reported instead.\\n')");
          L.push("if(expo && !useoff) cat('RESULT_NOTE|No denominator was mapped, so this models the count per period and assumes the population at risk is the same in every period. If your outcome is already a rate, map its denominator or choose the linear model - otherwise a changing population will be read as a trend.\\n')");
          L.push("if(length(alias)>0) cat(sprintf('RESULT_NOTE|%d model term(s) could not be estimated because they are collinear with the rest of the model (%s), and were dropped. Over only a couple of complete cycles, calendar dummies and a linear time trend are not separately identifiable — shorten the seasonal terms, switch to harmonic terms, or lengthen the series.\\n', length(alias), paste(alias,collapse=', ')))");
          L.push("if(ratemode) cat('RESULT_NOTE|A denominator was mapped with a linear model, so the outcome is the rate (value divided by the denominator); the level and slope changes are on that rate scale.\\n')");
          L.push("if(npre<8) cat(sprintf('RESULT_NOTE|Only %d pre-intervention period(s) — the baseline trend, and therefore the counterfactual, is poorly estimated. Aim for at least 8 (ideally 12).\\n',npre))");
          L.push("if(npost<8) cat(sprintf('RESULT_NOTE|Only %d post-intervention period(s) — a slope change is hard to detect. Aim for at least 8 (ideally 12).\\n',npost))");
          L.push("if(!is.na(dw) && (dw<1.5||dw>2.5) && !useh) cat('RESULT_NOTE|Durbin-Watson indicates residual autocorrelation but model-based standard errors were requested, so the confidence intervals are likely too narrow.\\n')");
          // Say where the HAC correction stops, next to the numbers it produced.
          L.push("if(HASG && useh) cat('RESULT_NOTE|With a control series the HAC correction is applied within each series: lag products that cross the two series are excluded, so serial correlation is handled but any contemporaneous correlation between the intervention and control series at the same time point is assumed to be zero. If the two series move together period by period, these standard errors are too narrow.\\n')");
          L.push("");
          L.push("cat('\\n--- Segmented regression coefficients ---\\n'); print(summary(fit)$coefficients)");
          L.push("cat(sprintf('\\nPeriods: %d (%s to %s); interruption at %s (period %d).\\n',np,ukey[1],ukey[np],ukey[t0],t0))");
          L.push("cat(sprintf('Model: %s. Standard errors: %s. Durbin-Watson: %s.\\n',famlab,selab,dwt))");
          return L.join("\n");
        },
      },
    };

    const KW = {
      TREAT: /treat|exposure|exposed|arm|drug|group/i, TIME: /time|fu|follow|days|duration|survtime/i,
      EVENT: /event|outcome|death|died|dead|case|status/i, DISC: /disc|discont|switch|stop|cessation|deviat/i,
      ID: /(^|_)id$|patient|subject|caseid|pid/i, EXPOSED: /expos|treat|drug/i, EVENTS: /event|count|nevent/i,
      INTERVAL: /interval|persontime|offset|length|days|time/i, CASE: /case|hazard|window|status/i,
      TIDX: /date|time|period|month|quarter|week|year|index|日期|時間|月|年|季|期/i,
      YCOUNT: /count|events|cases|rate|incid|outcome|n_|_n$|num|次數|人次|件數|率/i,
      DENOM: /denom|popul|offset|persontime|person_time|at_?risk|exposed_pop|py$|人口|母數|分母/i,
      SEAS: /season|month|quarter|cycle|月份|季節/i,
      SERIES: /control|series|region|site|area|arm|group|對照|組別/i,
    };
    const getDesign = () => { const r = document.querySelector('[name="design"]:checked'); return r ? r.value : ""; };
    let MAP = {}, COVS = [], MASTER = null, LAST = null, COVROLE = {};
    let PSCSPLIT = {};   // source column → "claims" | "clinical" | "" (undecided, and blocking)
    let PSCRUN = null;   // snapshot of what the last run actually fitted

    // Role suggestions lean on three sources, in this order: the column name, the
    // codebook definition (which carries the meaning when the name is opaque or in
    // another language), and what the structure panel established about the file.
    const ROLE_BOOST = {
      ID: (p) => (p.name === STRUCT.idCol ? 4 : 0),
      TIDX: (p) => (p.type === "date" ? 2 : 0),
      DENOM: (p) => (/pop|risk|denom|母數|人口|人數/i.test(p.name) ? 1 : 0),
      SERIES: (p) => (p.type === "binary" ? 1 : 0),
    };
    function suggestCol(role) {
      const kw = KW[role.k];
      let best = "", score = 0;
      for (const p of DATA.profile) {
        // A name match is not enough on its own. "clinic_site" matches the
        // control-series keywords, but a 26-level text column cannot be a 0/1
        // indicator, and offering it only sends the user to an error message.
        if (!role.types.includes(p.type)) continue;
        let sc = 1;
        if (kw && kw.test(p.name)) sc += 3;
        if (kw && p.def && kw.test(p.def)) sc += 2;
        const b = ROLE_BOOST[role.k]; if (b) sc += b(p);
        if (sc > score) { score = sc; best = p.name; }
      }
      return score >= 4 ? best : "";
    }
    function renderMap() {
      const spec = SPEC[getDesign()];
      if (!spec || !DATA.columns.length) { $("mapcard").classList.add("hidden"); return; }
      $("mapcard").classList.remove("hidden");
      $("designname").textContent = spec.label;
      $("maphint").textContent = spec.hint;
      const opts = (sel) => '<option value="">— choose —</option>' + DATA.columns.map((c) => '<option value="' + esc(c) + '"' + (sel === c ? " selected" : "") + ">" + esc(c) + "</option>").join("");
      $("maproles").innerHTML = spec.roles.map((r) => {
        if (!(r.k in MAP)) MAP[r.k] = suggestCol(r);
        return '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">' + esc(r.label) + (r.req ? " *" : " (optional)") + '</span><select data-role="' + r.k + '" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">' + opts(MAP[r.k]) + "</select></label>";
      }).join("");
      $("maproles").querySelectorAll("select[data-role]").forEach((sel) => sel.addEventListener("change", () => { MAP[sel.getAttribute("data-role")] = sel.value; renderCovs(spec); validateMap(); }));
      $("itsopts").classList.toggle("hidden", getDesign() !== "its");
      renderCovs(spec);
      try { renderDupUI(); } catch (e) {}
      validateMap();
    }
    function detectIdCol() {
      const spec = SPEC[getDesign()];
      if (spec && spec.roles.some((r) => r.k === "ID") && MAP.ID) return MAP.ID;
      if (STRUCT.idCol && DATA.columns.indexOf(STRUCT.idCol) >= 0) return STRUCT.idCol;
      const byType = DATA.profile.find((p) => p.type === "id");
      if (byType) return byType.name;
      const byName = DATA.columns.find((c) => /(^|_)id$|patient|subject|pid|caseid/i.test(c));
      return byName || "";
    }
    function renderDupUI() {
      const spec = SPEC[getDesign()];
      // Duplicate-ID resolution only makes sense where each person is meant to
      // appear ONCE — i.e. the ACNU new-user cohort. SCCS / case-crossover repeat
      // IDs by design and ITS collapses rows into periods, so hide it for those.
      const onePer = spec && spec.onePerPerson;
      $("dupwrap").classList.toggle("hidden", !onePer);
      if (!onePer || !DATA.columns.length) return;
      const idSel = $("dup_id"), dateSel = $("dup_date");
      const cur = idSel.value || detectIdCol();
      idSel.innerHTML = '<option value="">— none —</option>' + DATA.columns.map((c) => '<option value="' + esc(c) + '"' + (c === cur ? " selected" : "") + ">" + esc(c) + "</option>").join("");
      const dcur = dateSel.value;
      const dateCols = DATA.profile.filter((p) => p.type === "date").map((p) => p.name);
      dateSel.innerHTML = '<option value="">— none —</option>' + dateCols.map((c) => '<option value="' + esc(c) + '"' + (c === dcur ? " selected" : "") + ">" + esc(c) + "</option>").join("");
      // Default to what the structure panel concluded: repeats that are exact
      // copies are duplicates to drop; repeats that differ are real records.
      if (!$("dup_strategy").dataset.touched) $("dup_strategy").value = STRUCT.repeatKind === "measures" || STRUCT.repeatKind === "mixed" ? "all" : "first";
      updateDupCount();
    }
    function updateDupCount() {
      const idc = $("dup_id").value;
      if (!idc) { $("dupcount").textContent = "no ID column selected"; $("dupcount").className = "text-[11px] font-semibold text-slate-400"; return; }
      const counts = {};
      (DATA.rows || []).forEach((r) => { const k = String(r[idc] == null ? "" : r[idc]).trim(); if (k !== "") counts[k] = (counts[k] || 0) + 1; });
      const dup = Object.values(counts).filter((c) => c > 1);
      const extra = dup.reduce((a, c) => a + (c - 1), 0);
      $("dupcount").textContent = dup.length ? (dup.length + " ID(s) repeat · " + extra + " extra row(s)") : "no repeated IDs ✓";
      $("dupcount").className = "text-[11px] font-semibold " + (dup.length ? "text-amber-700" : "text-emerald-600");
    }
    $("dup_id").addEventListener("change", updateDupCount);
    $("dup_strategy").addEventListener("change", () => { $("dup_strategy").dataset.touched = "1"; });
    function renderCovs(spec) {
      if (!spec.covariates) { $("covwrap").classList.add("hidden"); return; }
      $("covwrap").classList.remove("hidden");
      const used = new Set(spec.roles.map((r) => MAP[r.k]).filter(Boolean));
      $("covlist").innerHTML = DATA.columns.filter((c) => !used.has(c)).map((c) => {
        const rc = COVROLE[c];
        const badge = rc ? ' <span class="rounded px-1 py-0.5 text-[9px] font-semibold ' + ROLE_CLS(rc.role) + '">' + esc(rc.role) + "</span>" : "";
        return '<label class="flex items-start gap-1.5" title="' + (rc ? esc(rc.reason) : "") + '"><input type="checkbox" data-cov="' + esc(c) + '"' + (COVS.includes(c) ? " checked" : "") + ' class="mt-0.5"/> <span>' + esc(c) + badge + "</span></label>";
      }).join("");
      $("covlist").querySelectorAll("input[data-cov]").forEach((cb) => cb.addEventListener("change", () => { const c = cb.getAttribute("data-cov"); if (cb.checked) { if (!COVS.includes(c)) COVS.push(c); } else COVS = COVS.filter((x) => x !== c); renderCovNote(); validateMap(); }));
      $("acnuopts").classList.toggle("hidden", getDesign() !== "acnu");
      renderCovNote();
      try { renderPscSplit(); } catch (e) { console.error(e); }
    }
    // ── Propensity-score calibration: which covariates does a claims database see? ──
    // NFC first, for the same reason the codebook matcher needs it: a name written
    // on one platform and a rule written on another compare unequal while rendering
    // identically. Skipping this is why an earlier classifier silently mislabelled
    // every Korean and accented-Latin column.
    const PSC_NORM = (s) => String(s == null ? "" : s).normalize("NFC").toLowerCase().replace(/[_\-.]+/g, " ").replace(/\s+/g, " ").trim();
    // Tested FIRST: a coded diagnosis, procedure, dispensing or visit is in claims
    // even when the measurement behind it is not. Obesity is claims; BMI is not.
    const PSC_CODED = /diagnos|\bdx\b|icd\b|procedure|\bcode[ds]?\b|claim|\bvisit|admission|hospitali[sz]|dispens|prescri|refill|\brx\b|count|次數|就醫|住院|處方|診斷|手術/;
    const PSC_CLINICAL = /hba1c|glycated|a1c|egfr|creatinin|albumin|bilirubin|\balt\b|\bast\b|ldl|hdl|cholesterol|triglycerid|glucose|blood pressure|systolic|diastolic|\bbp\b|bmi|body mass|height|weight|waist|pulse|heart rate|temperature|oxygen|spo2|ejection fraction|\blvef\b|fev1|\bfvc\b|spiromet|visual acuity|intraocular|\biop\b|ecog|karnofsky|performance status|\bstage\b|\bgrade\b|severit|ki67|pd-?l1|biomarker|\blab\b|laborator|panss|ham-?d|madrs|mmse|apgar|gestational|birth weight|smok|pack.?year|frailty|symptom|functional status|family history|genetic|genotype|polygenic|dialysis vintage|kt.?v\b|\burr\b|troponin|sodium|potassium|haemoglobin|hemoglobin|收縮壓|舒張壓|血壓|血圧|혈압|身高|身長|체중|體重|体重|眼壓|眼圧|視力|抽菸|吸菸|喫煙|흡연|飲酒|檳榔|血糖|糖化|檢驗|クレアチニン|크레아티닌|ヘモグロビン|重症度/;
    const PSC_CLAIMS = /\bage\b|年齡|年龄|\bsex\b|gender|性別|region|urban|rural|area|\bsite\b|clinic|hospital|centre|center|provider|facility|insur|income|\bses\b|deprivation|year|calendar|index date|\bhistory\b|\bhx\b|prior |comorbid|charlson|elixhauser|\bcci\b|drug|medication|therapy|保險|地區|病史|藥/;
    function pscSeed(name, def) {
      const n = PSC_NORM(name), d = PSC_NORM(def || "");
      if (PSC_CODED.test(n) || PSC_CODED.test(d)) return "claims";
      if (PSC_CLINICAL.test(n) || PSC_CLINICAL.test(d)) return "clinical";
      if (PSC_CLAIMS.test(n) || PSC_CLAIMS.test(d)) return "claims";
      return "";                                   // undecided, and blocking
    }
    function pscReseed(force) {
      covPlan(MASTER || DATA.rows).info.forEach((c) => {
        if (force || !PSCSPLIT[c.src]) {
          const p = DATA.profile.find((x) => x.name === c.src);
          PSCSPLIT[c.src] = pscSeed(c.src, p ? p.def : "");
        }
      });
    }
    const PSC_CLS = { claims: "bg-emerald-100 text-emerald-800 border-emerald-300", clinical: "bg-violet-100 text-violet-800 border-violet-300", "": "bg-white text-slate-500 border-slate-200" };
    function renderPscSplit() {
      const body = $("pscbody"); if (!body) return;
      const on = getDesign() === "acnu" && $("psc_on").checked;
      body.classList.toggle("hidden", !$("psc_on").checked);
      if (!on || !COVS.length) { $("psclist").innerHTML = ""; $("pscmsg").textContent = ""; return; }
      pscReseed(false);
      const info = covPlan(MASTER || DATA.rows).info;
      $("psclist").innerHTML = info.map((c) => {
        const cur = PSCSPLIT[c.src] || "";
        const btn = (v, label) => '<button type="button" data-pscset="' + v + '" data-pscvar="' + esc(c.src) + '" class="text-[10px] font-semibold px-2 py-0.5 rounded border transition ' + (cur === v ? PSC_CLS[v] : "bg-white text-slate-400 border-slate-200 hover:border-slate-400") + '">' + label + "</button>";
        return '<div class="flex items-center gap-2 bg-white border border-slate-200 rounded px-2 py-1">' +
          '<span class="flex-1 min-w-0 truncate" title="' + esc(c.src) + '">' + esc(c.src) + (cur ? "" : ' <span class="text-rose-600 font-bold">?</span>') + "</span>" +
          '<span class="flex gap-1 shrink-0">' + btn("claims", "Claims") + btn("clinical", "Clinical-only") + "</span></div>";
      }).join("");
      $("psclist").querySelectorAll("[data-pscset]").forEach((b) => b.addEventListener("click", () => {
        const v = b.getAttribute("data-pscset"), k = b.getAttribute("data-pscvar");
        PSCSPLIT[k] = PSCSPLIT[k] === v ? "" : v;
        renderPscSplit();
      }));
      const nC = info.filter((c) => PSCSPLIT[c.src] === "claims").length;
      const nU = info.filter((c) => PSCSPLIT[c.src] === "clinical").length;
      const un = info.filter((c) => !PSCSPLIT[c.src]).map((c) => c.src);
      const m = $("pscmsg");
      if (un.length) { m.innerHTML = '<span class="text-rose-700 font-semibold">Undecided: ' + un.map(esc).join(", ") + ".</span> The formula is not computed until every covariate is placed — a variable guessed into the wrong side silently breaks the correction."; m.className = "text-[11px] text-rose-700"; }
      else if (!nU) { m.textContent = "No clinical-only covariates, so the two propensity scores would be identical and there is nothing to calibrate against. Mark at least one covariate a claims database could not see."; m.className = "text-[11px] text-amber-700"; }
      else if (!nC) { m.textContent = "No claims-available covariates, so there is no error-prone score to calibrate."; m.className = "text-[11px] text-amber-700"; }
      else { m.textContent = nC + " claims-available (error-prone score) · " + nU + " clinical-only (added for the gold-standard score). β̂ for the treatment and the score come from the claims-only study and cannot be computed here."; m.className = "text-[11px] text-slate-500"; }
    }
    function pscReady() {
      if (getDesign() !== "acnu" || !$("psc_on").checked) return null;
      const info = covPlan(MASTER || DATA.rows).info;
      if (!info.length || info.some((c) => !PSCSPLIT[c.src])) return null;
      const C = info.filter((c) => PSCSPLIT[c.src] === "claims"), U = info.filter((c) => PSCSPLIT[c.src] === "clinical");
      if (!C.length || !U.length) return null;
      return { C: C, U: U, valType: $("psc_valtype").value, boot: parseInt($("psc_boot").value) || 0 };
    }
    ["psc_on", "psc_valtype", "psc_boot"].forEach((id) => $(id).addEventListener("change", renderPscSplit));
    $("psc_reseed").addEventListener("click", () => { pscReseed(true); renderPscSplit(); });
    $("psc_allc").addEventListener("click", () => { COVS.forEach((c) => { PSCSPLIT[c] = "claims"; }); renderPscSplit(); });
    $("psc_allu").addEventListener("click", () => { COVS.forEach((c) => { PSCSPLIT[c] = "clinical"; }); renderPscSplit(); });

    // Say up front how each ticked covariate will enter the model, and name any
    // that cannot be used. A variable must never leave the model in silence.
    function renderCovNote() {
      const el = $("covnote"); if (!el) return;
      const spec = SPEC[getDesign()];
      if (!spec || !spec.covariates || !COVS.length || !DATA.rows.length) { el.textContent = ""; return; }
      const plan = covPlan(MASTER || DATA.rows);
      const nNum = plan.info.filter((c) => c.kind === "numeric").length;
      const nBin = plan.info.filter((c) => c.kind === "binary").length;
      const fac = plan.info.filter((c) => c.kind === "factor");
      const bits = [];
      if (nNum) bits.push(nNum + " continuous");
      if (nBin) bits.push(nBin + " binary (0/1)");
      if (fac.length) bits.push(fac.length + " categorical → dummy-coded factor" + (fac.length > 1 ? "s" : "") + " (" +
        fac.map((c) => c.src + ", " + c.levels + " levels" + (c.collapsed ? " → " + c.effective + " after folding " + c.rare.length + " rare into “other”" : "")).join("; ") + ")");
      let html = plan.info.length ? "In the propensity model: " + bits.join(" · ") + "." : "";
      const thin = fac.filter((c) => c.thinEvents && c.thinEvents.length);
      if (thin.length) html += (html ? " " : "") + '<span class="text-amber-700">Fewer than ' + COV_MIN_EVENTS_PER_LEVEL + " events behind " +
        thin.map((c) => c.thinEvents.length + " level(s) of " + esc(c.src)).join(" and ") + " — those coefficients will be unstable.</span>";
      if (plan.dropped.length) html += (html ? " " : "") + '<span class="text-rose-700 font-semibold">Left out: ' + plan.dropped.map((d) => esc(d.src) + " (" + esc(d.why) + ")").join("; ") + ".</span>";
      el.innerHTML = html;
      el.className = "mt-1.5 text-[11px] " + (plan.dropped.length ? "text-rose-700" : (thin.length ? "text-amber-700" : "text-slate-500"));
    }
    const availCovCols = () => { const spec = SPEC[getDesign()]; const used = new Set(spec.roles.map((r) => MAP[r.k]).filter(Boolean)); return DATA.columns.filter((c) => !used.has(c)); };
    const COV_KW = /age|sex|gender|comorbid|cci|charlson|elix|diab|hyperten|renal|ckd|egfr|copd|asthma|cancer|malig|smok|alcohol|bmi|weight|obes|hba1c|ldl|hdl|chol|creatinin|statin|insulin|metformin|nsaid|ppi|anticoag|antiplatel|steroid|comed|med_|drug|dx_|hx_|prior|baseline|income|ses|deprivation|urban|region|frailty|score|sever|stage|grade|class/i;
    const COV_EXCL = /(^|_)id$|date|event|outcome|death|died|treat|expos|arm|time|fu_|followup|persontime|disc|switch/i;
    $("cov_auto").addEventListener("click", () => { COVS = availCovCols().filter((c) => COV_KW.test(c) && !COV_EXCL.test(c)); renderCovs(SPEC[getDesign()]); validateMap(); });
    $("cov_all").addEventListener("click", () => { COVS = availCovCols().slice(); renderCovs(SPEC[getDesign()]); validateMap(); });
    $("cov_none").addEventListener("click", () => { COVS = []; renderCovs(SPEC[getDesign()]); validateMap(); });
    $("cov_collapse").addEventListener("change", () => { renderCovNote(); validateMap(); });

    // AI causal triage — metadata-only (column names + the clinical question).
    const WORKER_URL = "https://target-checker.danielhttsai.workers.dev";
    const ROLE_CLS = (r) => ({ confounder: "bg-emerald-100 text-emerald-800", mediator: "bg-amber-100 text-amber-800", collider: "bg-rose-100 text-rose-800", instrument: "bg-violet-100 text-violet-800", structural: "bg-slate-100 text-slate-600", unclear: "bg-slate-100 text-slate-500" }[r] || "bg-slate-100 text-slate-600");
    const setCovAiMsg = (t, bad) => { const el = $("cov_ai_msg"); if (el) { el.textContent = t || ""; el.className = "text-[11px] " + (bad ? "text-rose-600" : "text-emerald-700"); } };
    $("cov_ai").addEventListener("click", async () => {
      const q = readQ();
      if (!q.exp || !q.out) { setCovAiMsg("Enter the exposure and outcome in step 1 first.", true); return; }
      const cols = availCovCols().map((c) => { const p = DATA.profile.find((x) => x.name === c); return { name: c, type: p ? p.type : "" }; });
      if (!cols.length) { setCovAiMsg("No candidate columns to classify yet — map the roles first.", true); return; }
      const btn = $("cov_ai"); btn.disabled = true;
      setCovAiMsg("Asking the AI to classify each column for your exposure→outcome (only column names are sent, never patient data)…");
      try {
        const res = await fetch(WORKER_URL, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ mode: "confounders", question: { population: q.pop, exposure: q.exp, comparator: q.comp, outcome: q.out }, columns: cols }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.items) { setCovAiMsg(data.error || "The AI could not classify the columns.", true); return; }
        COVROLE = {};
        data.items.forEach((it) => { if (it && it.name) COVROLE[it.name] = { role: it.role, adjust: !!it.adjust, reason: it.reason || "" }; });
        COVS = cols.map((c) => c.name).filter((n) => COVROLE[n] && COVROLE[n].adjust);
        renderCovs(SPEC[getDesign()]); validateMap();
        const warn = data.items.filter((i) => i.role === "mediator" || i.role === "collider" || i.role === "instrument").length;
        setCovAiMsg("Ticked " + COVS.length + " confounder(s); flagged " + warn + " mediator/collider/instrument to NOT adjust. Hover a badge for the reason — review and edit; the final clinical call is yours.");
      } catch (e) { setCovAiMsg("Couldn't reach the AI: " + (e && e.message ? e.message : e), true); }
      finally { btn.disabled = false; }
    });
    function validateMap() {
      const spec = SPEC[getDesign()]; if (!spec) return false;
      const missing = spec.roles.filter((r) => r.req && !MAP[r.k]).map((r) => r.label);
      const needCov = spec.covariates && COVS.length === 0;
      const noUsable = spec.covariates && COVS.length > 0 && DATA.rows.length > 0 && covPlan(MASTER || DATA.rows).info.length === 0;
      const needCut = getDesign() === "its" && !$("its_cut").value.trim();
      const bt = missing.length ? [] : binTrouble();
      const ok = missing.length === 0 && !needCov && !needCut && !noUsable && !bt.length;
      const m = $("mapmsg");
      if (bt.length) {
        m.innerHTML = bt.map((b) => "<strong>" + esc(b.col) + "</strong> is mapped to “" + esc(b.label) + "”, but holds " +
          esc(b.bad.join(", ")) + " — value(s) this tool cannot read as yes or no.").join(" ") +
          " A 0/1 role must be unambiguous: if the column has exactly two levels, say which one means yes under <strong>Coded flags</strong> in the structure panel above; if it has three or more (1 = yes, 2 = no, 9 = unknown, say), recode it before uploading. It is not treated as “yes” just because it is not zero.";
        m.className = "mt-3 text-xs text-rose-700";
      }
      else if (missing.length) { m.textContent = "Map the required roles (*): " + missing.join(", "); m.className = "mt-3 text-xs text-amber-700"; }
      else if (needCut) { m.textContent = "Give the interruption point — the first period affected by the intervention."; m.className = "mt-3 text-xs text-amber-700"; }
      else if (needCov) { m.textContent = "Tick at least one baseline covariate for the propensity score."; m.className = "mt-3 text-xs text-amber-700"; }
      else if (noUsable) { m.textContent = "None of the ticked covariates can be used — see the note under the list."; m.className = "mt-3 text-xs text-rose-700"; }
      else { m.textContent = "Mapping complete ✓ — build the master file below."; m.className = "mt-3 text-xs text-emerald-700"; }
      $("cleancard").classList.toggle("hidden", !ok);
      return ok;
    }

    const NUM_ROLES = ["TIME", "INTERVAL", "EVENTS", "DISC", "YCOUNT", "DENOM"];
    const BIN_ROLES = ["EVENT", "TREAT", "EXPOSED", "CASE", "SERIES"];
    const toBin = (v) => {
      if (v == null || v === "") return null;
      const l = String(v).trim().toLowerCase();
      const ym = yesMap();                                   // this dataset's own vocabulary wins
      if (l in ym) return ym[l];
      if (YES_TOKENS.indexOf(l) >= 0) return 1;
      if (NO_TOKENS.indexOf(l) >= 0) return 0;
      // "Any positive number means yes" is how an outcome coded 1=yes, 2=no,
      // 9=unknown — an ordinary registry coding — became 400 events out of 400.
      // Three or more levels never reach the "Coded flags" vocabulary (it is built
      // from two-level columns only), so nothing on screen mentioned the column,
      // and chk01 in R then saw a variable whose only value was 1 and passed it.
      // A number that is not already 0 or 1 is unreadable as a flag: return null,
      // leave the original value in place, and let the guard refuse it by name.
      const n = Number(l); return (n === 0 || n === 1) ? n : null;
    };
    // Which mapped 0/1 roles hold values that cannot be read as a flag. Reported on
    // screen before the run, so the refusal is not a raw R error at the end of it.
    function binTrouble() {
      const spec = SPEC[getDesign()]; if (!spec || !DATA.rows.length) return [];
      const out = [];
      spec.roles.filter((r) => BIN_ROLES.indexOf(r.k) >= 0 && MAP[r.k]).forEach((r) => {
        const col = MAP[r.k], bad = [];
        for (let i = 0; i < DATA.rows.length && bad.length < 6; i++) {
          const v = DATA.rows[i][col];
          if (isBlank(v)) continue;
          if (toBin(v) == null) { const s = String(v).trim(); if (bad.indexOf(s) < 0) bad.push(s); }
        }
        if (bad.length) out.push({ label: r.label, col: col, bad: bad });
      });
      return out;
    }

    function buildMaster() {
      const spec = SPEC[getDesign()]; if (!spec || !validateMap()) return;
      const roleCol = {}; spec.roles.forEach((r) => { if (MAP[r.k]) roleCol[r.k] = MAP[r.k]; });
      let rows = DATA.rows.map((r) => Object.assign({}, r));
      if ($("c_trim").checked) rows.forEach((r) => DATA.columns.forEach((c) => { if (typeof r[c] === "string") r[c] = r[c].trim(); }));
      if ($("c_dates").checked) {
        const dcols = (STRUCT.dateCols || []).map((d) => d.col).filter((c) => DATA.columns.indexOf(c) >= 0);
        rows.forEach((r) => dcols.forEach((c) => { r[c] = toISO(r[c], STRUCT.dayFirst); }));
      }
      if ($("c_std").checked) rows.forEach((r) => {
        BIN_ROLES.forEach((rk) => { if (roleCol[rk]) { const b = toBin(r[roleCol[rk]]); if (b != null) r[roleCol[rk]] = b; } });
      });
      const numCols = NUM_ROLES.map((k) => roleCol[k]).filter(Boolean).concat(spec.covariates ? COVS : []);
      rows.forEach((r) => numCols.forEach((c) => { const n = Number(String(r[c] == null ? "" : r[c]).replace(/,/g, "")); if (!isNaN(n) && String(r[c]).trim() !== "") r[c] = n; }));
      const before = rows.length;
      if ($("c_dedupe").checked) { const seen = new Set(); rows = rows.filter((r) => { const k = DATA.columns.map((c) => String(r[c] == null ? "" : r[c])).join("|"); if (seen.has(k)) return false; seen.add(k); return true; }); }
      // Duplicate patients/cases — ACNU (one-row-per-person cohort) only.
      const dupId = $("dup_id").value, dupStrat = $("dup_strategy").value;
      if (spec.onePerPerson && dupId && dupStrat !== "all") {
        const dcol = $("dup_date").value, groups = new Map();
        rows.forEach((r, i) => { const k = String(r[dupId] == null ? "" : r[dupId]).trim(); if (k === "") return; if (!groups.has(k)) groups.set(k, []); groups.get(k).push(i); });
        const drop = new Set();
        groups.forEach((idxs) => {
          if (idxs.length < 2) return;
          let keep;
          if (dupStrat === "last") keep = idxs[idxs.length - 1];
          else if (dupStrat === "earliest" || dupStrat === "latest") {
            const wd = idxs.map((i) => ({ i, t: dcol ? Date.parse(String(rows[i][dcol])) : NaN }));
            wd.sort((a, b) => (isNaN(a.t) ? Infinity : a.t) - (isNaN(b.t) ? Infinity : b.t));
            keep = dupStrat === "earliest" ? wd[0].i : wd[wd.length - 1].i;
          } else keep = idxs[0];
          idxs.forEach((i) => { if (i !== keep) drop.add(i); });
        });
        rows = rows.filter((r, i) => !drop.has(i));
      }
      if ($("c_dropmiss").checked) { const req = spec.roles.filter((r) => r.req).map((r) => roleCol[r.k]).filter(Boolean).concat(spec.covariates ? COVS : []); rows = rows.filter((r) => req.every((c) => r[c] != null && String(r[c]).trim() !== "")); }
      MASTER = rows;
      $("cleaninfo").textContent = "Master file: " + rows.length + " rows (from " + before + "; " + (before - rows.length) + " removed).";
      $("anacard").classList.remove("hidden"); $("expcard").classList.remove("hidden");
    }

    // What kind of variable is this, really? A covariate that is text must not be
    // coerced to a number — that is how a variable vanishes from a model without
    // anyone noticing. Anything that cannot be used is named, never dropped quietly.
