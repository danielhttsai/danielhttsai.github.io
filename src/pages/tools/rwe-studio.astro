          L.push("if(length(alias)>0) cat(sprintf('RESULT_NOTE|%d model term(s) could not be estimated because they are collinear with the rest of the model (%s), and were dropped. Over only a couple of complete cycles, calendar dummies and a linear time trend are not separately identifiable — shorten the seasonal terms, switch to harmonic terms, or lengthen the series.\\n', length(alias), paste(alias,collapse=', ')))");
          L.push("if(ratemode) cat('RESULT_NOTE|A denominator was mapped with a linear model, so the outcome is the rate (value divided by the denominator); the level and slope changes are on that rate scale.\\n')");
          L.push("if(npre<8) cat(sprintf('RESULT_NOTE|Only %d pre-intervention period(s) — the baseline trend, and therefore the counterfactual, is poorly estimated. Aim for at least 8 (ideally 12).\\n',npre))");
          L.push("if(npost<8) cat(sprintf('RESULT_NOTE|Only %d post-intervention period(s) — a slope change is hard to detect. Aim for at least 8 (ideally 12).\\n',npost))");
          L.push("if(!is.na(dw) && (dw<1.5||dw>2.5) && !useh) cat('RESULT_NOTE|Durbin-Watson indicates residual autocorrelation but model-based standard errors were requested, so the confidence intervals are likely too narrow.\\n')");
