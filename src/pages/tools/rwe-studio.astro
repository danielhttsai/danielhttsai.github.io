          "# are still proper 1:M matched sets and still estimate the case-crossover odds ratio.\n" +
          "# Only a condition that leaves nothing to compare refuses outright.\n" +
          "stopq<-character(0); warnq<-character(0)\n" +
          "ndropna<-sum(is.na(d$CASE) | is.na(d$EXPOSED))\n" +
          "a0<-d[!is.na(d$CASE) & !is.na(d$EXPOSED),,drop=FALSE]\n" +
          "ncase<-0; ninf<-0; ndisc<-0\n" +
          "if(nrow(a0)==0) stopq<-c(stopq,'No row has both a usable case indicator and a usable exposure indicator.')\n" +
          "if(nrow(a0)>0){\n" +
          "  hpc0<-tapply(a0$CASE, a0$ID, sum); nwin0<-tapply(rep(1,nrow(a0)), a0$ID, sum)\n" +
          "  ncase<-length(hpc0); nh0<-sum(hpc0==0); nh2<-sum(hpc0>1)\n" +
          "  # The design IS one hazard window per case. A case with none contributes nothing to a\n" +
          "  # conditional likelihood anyway; a case with several is a different estimand. Both are\n" +
          "  # excluded by name rather than allowed to stand in the result.\n" +
