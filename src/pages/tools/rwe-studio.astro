          L.push("ct<-sum(L0*cfv); vct<-as.numeric(t(L0)%*%V%*%L0); sct<-if(is.finite(vct) && vct>0) sqrt(vct) else NA_real_");
          L.push("endlab<-ukey[tn]");
          L.push("if(!is.na(sct)){ if(expo) cat(sprintf('RESULT_ESTIMATE|Observed vs counterfactual at %s (end of follow-up)|%.3f (95%% CI %.3f-%.3f)\\n',endlab,exp(ct),exp(ct-1.96*sct),exp(ct+1.96*sct)))");
          L.push("  else cat(sprintf('RESULT_ESTIMATE|Observed minus counterfactual at %s (end of follow-up)|%s (95%% CI %s to %s)\\n',endlab,fmt(ct),fmt(ct-1.96*sct),fmt(ct+1.96*sct))) }");
          L.push("");
          L.push("# --- fitted and counterfactual series ---");
          L.push("X<-model.matrix(fit); Xc<-X");
          L.push("zc<-if(HASG) grepl('^g:(level|tsince)$',colnames(X)) else colnames(X) %in% c('level','tsince')");
          L.push("Xc[,zc]<-0");
          L.push("off<-fit$offset; if(is.null(off)) off<-rep(0,nrow(X))");
          L.push("bb<-cfv[colnames(X)]; bb[is.na(bb)]<-0");
          L.push("inv<-if(inherits(fit,'glm')) fit$family$linkinv else function(z) z");
          L.push("fv<-inv(as.numeric(X%*%bb)+off); cv<-inv(as.numeric(Xc%*%bb)+off)");
          L.push("cat('FITTED|series|period|t|observed|denominator|fitted|counterfactual\\n')");
          L.push("for(i in seq_len(nrow(a))) cat(sprintf('FITTED|%s|%s|%d|%.6g|%s|%.6g|%.6g\\n', if(HASG) (if(a$g[i]>0) 'intervention' else 'control') else 'series', a$key[i], a$t[i], a$Y[i], if(useoff) sprintf('%.6g',a$N[i]) else '', fv[i], cv[i]))");
          L.push("cat(sprintf('ITSMETA|t0=%d|cutlabel=%s|np=%d|pre=%d|post=%d|controlled=%s\\n',t0,ukey[t0],np,npre,npost,if(HASG) 'yes' else 'no'))");
          L.push("");
          L.push("dwt<-if(is.na(dw)) 'not computable' else sprintf('%.2f (lag-1 residual autocorrelation %+.2f)',dw,r1)");
