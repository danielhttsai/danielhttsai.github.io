          "  if(nh2>0) warnq<-c(warnq, sprintf('%d of %d case(s) have more than one hazard window (up to %s) and were excluded. A case-crossover compares one hazard window per case with that case s own control windows; with several the fit is still a conditional logistic regression but it is no longer the case-crossover odds ratio. Duplicated event rows from a join are the usual cause, and this tool no longer removes them for you.', nh2, ncase, fmn(max(hpc0))))\n" +
          "  if(all(nwin0<2)) stopq<-c(stopq,'Every case has a single window, so there is nothing to compare it with. This tool needs long format - one row per window, so one hazard row plus a control row for each control window. A file with one row per case and a separate column for each window is wide format and has to be reshaped first.')\n" +
          "  keep<-names(hpc0)[hpc0==1 & nwin0>=2]\n" +
          "  a<-a0[a0$ID %in% keep,,drop=FALSE]\n" +
          "  # A stratum enters the conditional likelihood only if the exposure varies within it.\n" +
          "  vary<-if(nrow(a)>0) tapply(a$EXPOSED, a$ID, function(z) length(unique(z))>1) else logical(0)\n" +
          "  ninf<-sum(vary, na.rm=TRUE)\n" +
          "  ndisc<-sum(tapply(a0$EXPOSED, a0$ID, function(z) length(unique(z))>1), na.rm=TRUE)\n" +
          "  if(ninf==0 && length(stopq)==0) stopq<-c(stopq, sprintf('No case is both a proper matched set - exactly one hazard window and at least one control window - and discordant on exposure. %d of %d case(s) are discordant on exposure, but a matched analysis conditions on the case, so a concordant case contributes nothing and a case that is not a matched set cannot contribute at all.', ndisc, ncase))\n" +
          "  if(ninf>0){\n" +
          "    hz1<-vapply(names(vary)[which(vary)], function(k) a$EXPOSED[a$ID==k & a$CASE==1][1], numeric(1))\n" +
          "    S<-sum(hz1==1, na.rm=TRUE)\n" +
          "    if(S<=0) stopq<-c(stopq, sprintf('In every one of the %d discordant case(s) the hazard window was unexposed and only control windows were exposed. The conditional likelihood is monotone and has no maximum: the odds ratio is below anything you could quote, not an estimate near zero.', ninf))\n" +
          "    else if(S>=ninf) stopq<-c(stopq, sprintf('In every one of the %d discordant case(s) the hazard window was the exposed one. The conditional likelihood is monotone and has no maximum: the odds ratio is above anything you could quote, not the very large number a solver will stop at.', ninf))\n" +
          "  }\n" +
          "} else a<-a0\n" +
          "EST<-'Matched odds ratio (each case vs its own control windows)'\n" +
          "if(length(stopq)>0){\n" +
          "  cat(sprintf('RESULT_ESTIMATE|%s|not estimable\\n', EST))\n" +
          "  for(s in stopq) cat('RESULT_NOTE|Not estimable: ',s,'\\n',sep='')\n" +
          "} else {\n" +
          "fit<-tryCatch(clogit(CASE ~ EXPOSED + strata(ID), data=a), error=function(e) NULL)\n" +
          "s<-if(is.null(fit)) NULL else tryCatch(summary(fit), error=function(e) NULL)\n" +
          "or<-if(is.null(s)) NA else s$conf.int['EXPOSED','exp(coef)']\n" +
