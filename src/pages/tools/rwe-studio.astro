        },
      },
    };

    const KW = {
      TREAT: /treat|exposure|exposed|arm|drug|group/i, TIME: /time|fu|follow|days|duration|survtime/i,
      EVENT: /event|outcome|death|died|dead|case|status/i, DISC: /disc|discont|switch|stop|cessation|deviat/i,
      ID: /(^|_)id$|patient|subject|caseid|pid/i, EXPOSED: /expos|treat|drug/i, EVENTS: /event|count|nevent/i,
      INTERVAL: /interval|persontime|offset|length|days|time/i, CASE: /case|hazard|window|status/i,
      TIDX: /date|time|period|month|quarter|week|year|index|日期|時間|月|年|季|期/i,
      YCOUNT: /count|events|cases|rate|incid|outcome|n_|_n$|num|次數|人次|件數|率/i,
      DENOM: /denom|popul|offset|persontime|person_time|at_?risk|exposed_pop|py$|人口|母數|分母/i,
      SEAS: /season|month|quarter|cycle|月份|季節/i,
      SERIES: /control|series|region|site|area|arm|group|對照|組別/i,
    };
    const getDesign = () => { const r = document.querySelector('[name="design"]:checked'); return r ? r.value : ""; };
    let MAP = {}, COVS = [], MASTER = null, LAST = null, COVROLE = {};

    function suggestCol(role) {
      const kw = KW[role.k];
      let best = "", score = 0;
      for (const p of DATA.profile) { let sc = 0; if (kw && kw.test(p.name)) sc += 3; if (role.types.includes(p.type)) sc += 1; if (sc > score) { score = sc; best = p.name; } }
      return score >= 3 ? best : "";
    }
    function renderMap() {
      const spec = SPEC[getDesign()];
      if (!spec || !DATA.columns.length) { $("mapcard").classList.add("hidden"); return; }
      $("mapcard").classList.remove("hidden");
      $("designname").textContent = spec.label;
      $("maphint").textContent = spec.hint;
      const opts = (sel) => '<option value="">— choose —</option>' + DATA.columns.map((c) => '<option value="' + esc(c) + '"' + (sel === c ? " selected" : "") + ">" + esc(c) + "</option>").join("");
      $("maproles").innerHTML = spec.roles.map((r) => {
        if (!(r.k in MAP)) MAP[r.k] = suggestCol(r);
        return '<label class="block text-xs"><span class="uppercase tracking-widest text-brand-700 font-semibold">' + esc(r.label) + (r.req ? " *" : " (optional)") + '</span><select data-role="' + r.k + '" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">' + opts(MAP[r.k]) + "</select></label>";
      }).join("");
      $("maproles").querySelectorAll("select[data-role]").forEach((sel) => sel.addEventListener("change", () => { MAP[sel.getAttribute("data-role")] = sel.value; renderCovs(spec); validateMap(); }));
      $("itsopts").classList.toggle("hidden", getDesign() !== "its");
      renderCovs(spec);
      try { renderDupUI(); } catch (e) {}
      validateMap();
    }
    function detectIdCol() {
      const spec = SPEC[getDesign()];
      if (spec && spec.roles.some((r) => r.k === "ID") && MAP.ID) return MAP.ID;
      const byType = DATA.profile.find((p) => p.type === "id");
      if (byType) return byType.name;
      const byName = DATA.columns.find((c) => /(^|_)id$|patient|subject|pid|caseid/i.test(c));
      return byName || "";
    }
    function renderDupUI() {
      const spec = SPEC[getDesign()];
      // Duplicate-ID resolution only makes sense where each person is meant to
      // appear ONCE — i.e. the ACNU new-user cohort. SCCS / case-crossover repeat
      // IDs by design and ITS collapses rows into periods, so hide it for those.
      const onePer = spec && spec.onePerPerson;
      $("dupwrap").classList.toggle("hidden", !onePer);
      if (!onePer || !DATA.columns.length) return;
      const idSel = $("dup_id"), dateSel = $("dup_date");
      const cur = idSel.value || detectIdCol();
      idSel.innerHTML = '<option value="">— none —</option>' + DATA.columns.map((c) => '<option value="' + esc(c) + '"' + (c === cur ? " selected" : "") + ">" + esc(c) + "</option>").join("");
      const dcur = dateSel.value;
      const dateCols = DATA.profile.filter((p) => p.type === "date").map((p) => p.name);
      dateSel.innerHTML = '<option value="">— none —</option>' + dateCols.map((c) => '<option value="' + esc(c) + '"' + (c === dcur ? " selected" : "") + ">" + esc(c) + "</option>").join("");
      if (!$("dup_strategy").dataset.touched) $("dup_strategy").value = "first";
      updateDupCount();
    }
    function updateDupCount() {
      const idc = $("dup_id").value;
      if (!idc) { $("dupcount").textContent = "no ID column selected"; $("dupcount").className = "text-[11px] font-semibold text-slate-400"; return; }
      const counts = {};
      (DATA.rows || []).forEach((r) => { const k = String(r[idc] == null ? "" : r[idc]).trim(); if (k !== "") counts[k] = (counts[k] || 0) + 1; });
      const dup = Object.values(counts).filter((c) => c > 1);
      const extra = dup.reduce((a, c) => a + (c - 1), 0);
      $("dupcount").textContent = dup.length ? (dup.length + " ID(s) repeat · " + extra + " extra row(s)") : "no repeated IDs ✓";
      $("dupcount").className = "text-[11px] font-semibold " + (dup.length ? "text-amber-700" : "text-emerald-600");
    }
    $("dup_id").addEventListener("change", updateDupCount);
    $("dup_strategy").addEventListener("change", () => { $("dup_strategy").dataset.touched = "1"; });
    function renderCovs(spec) {
      if (!spec.covariates) { $("covwrap").classList.add("hidden"); return; }
      $("covwrap").classList.remove("hidden");
      const used = new Set(spec.roles.map((r) => MAP[r.k]).filter(Boolean));
      $("covlist").innerHTML = DATA.columns.filter((c) => !used.has(c)).map((c) => {
        const rc = COVROLE[c];
        const badge = rc ? ' <span class="rounded px-1 py-0.5 text-[9px] font-semibold ' + ROLE_CLS(rc.role) + '">' + esc(rc.role) + "</span>" : "";
        return '<label class="flex items-start gap-1.5" title="' + (rc ? esc(rc.reason) : "") + '"><input type="checkbox" data-cov="' + esc(c) + '"' + (COVS.includes(c) ? " checked" : "") + ' class="mt-0.5"/> <span>' + esc(c) + badge + "</span></label>";
      }).join("");
      $("covlist").querySelectorAll("input[data-cov]").forEach((cb) => cb.addEventListener("change", () => { const c = cb.getAttribute("data-cov"); if (cb.checked) { if (!COVS.includes(c)) COVS.push(c); } else COVS = COVS.filter((x) => x !== c); validateMap(); }));
      $("acnuopts").classList.toggle("hidden", getDesign() !== "acnu");
    }
    const availCovCols = () => { const spec = SPEC[getDesign()]; const used = new Set(spec.roles.map((r) => MAP[r.k]).filter(Boolean)); return DATA.columns.filter((c) => !used.has(c)); };
    const COV_KW = /age|sex|gender|comorbid|cci|charlson|elix|diab|hyperten|renal|ckd|egfr|copd|asthma|cancer|malig|smok|alcohol|bmi|weight|obes|hba1c|ldl|hdl|chol|creatinin|statin|insulin|metformin|nsaid|ppi|anticoag|antiplatel|steroid|comed|med_|drug|dx_|hx_|prior|baseline|income|ses|deprivation|urban|region|frailty|score/i;
    const COV_EXCL = /(^|_)id$|date|event|outcome|death|died|treat|expos|arm|time|fu_|followup|persontime|disc|switch/i;
    $("cov_auto").addEventListener("click", () => { COVS = availCovCols().filter((c) => COV_KW.test(c) && !COV_EXCL.test(c)); renderCovs(SPEC[getDesign()]); validateMap(); });
    $("cov_all").addEventListener("click", () => { COVS = availCovCols().slice(); renderCovs(SPEC[getDesign()]); validateMap(); });
    $("cov_none").addEventListener("click", () => { COVS = []; renderCovs(SPEC[getDesign()]); validateMap(); });

    // AI causal triage — metadata-only (column names + the clinical question).
    const WORKER_URL = "https://target-checker.danielhttsai.workers.dev";
    const ROLE_CLS = (r) => ({ confounder: "bg-emerald-100 text-emerald-800", mediator: "bg-amber-100 text-amber-800", collider: "bg-rose-100 text-rose-800", instrument: "bg-violet-100 text-violet-800", structural: "bg-slate-100 text-slate-600", unclear: "bg-slate-100 text-slate-500" }[r] || "bg-slate-100 text-slate-600");
    const setCovAiMsg = (t, bad) => { const el = $("cov_ai_msg"); if (el) { el.textContent = t || ""; el.className = "text-[11px] " + (bad ? "text-rose-600" : "text-emerald-700"); } };
    $("cov_ai").addEventListener("click", async () => {
      const q = readQ();
      if (!q.exp || !q.out) { setCovAiMsg("Enter the exposure and outcome in step 1 first.", true); return; }
      const cols = availCovCols().map((c) => { const p = DATA.profile.find((x) => x.name === c); return { name: c, type: p ? p.type : "" }; });
      if (!cols.length) { setCovAiMsg("No candidate columns to classify yet — map the roles first.", true); return; }
      const btn = $("cov_ai"); btn.disabled = true;
      setCovAiMsg("Asking the AI to classify each column for your exposure→outcome (only column names are sent, never patient data)…");
      try {
        const res = await fetch(WORKER_URL, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ mode: "confounders", question: { population: q.pop, exposure: q.exp, comparator: q.comp, outcome: q.out }, columns: cols }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.items) { setCovAiMsg(data.error || "The AI could not classify the columns.", true); return; }
        COVROLE = {};
        data.items.forEach((it) => { if (it && it.name) COVROLE[it.name] = { role: it.role, adjust: !!it.adjust, reason: it.reason || "" }; });
        COVS = cols.map((c) => c.name).filter((n) => COVROLE[n] && COVROLE[n].adjust);
        renderCovs(SPEC[getDesign()]); validateMap();
        const warn = data.items.filter((i) => i.role === "mediator" || i.role === "collider" || i.role === "instrument").length;
        setCovAiMsg("Ticked " + COVS.length + " confounder(s); flagged " + warn + " mediator/collider/instrument to NOT adjust. Hover a badge for the reason — review and edit; the final clinical call is yours.");
      } catch (e) { setCovAiMsg("Couldn't reach the AI: " + (e && e.message ? e.message : e), true); }
      finally { btn.disabled = false; }
    });
    function validateMap() {
      const spec = SPEC[getDesign()]; if (!spec) return false;
      const missing = spec.roles.filter((r) => r.req && !MAP[r.k]).map((r) => r.label);
      const needCov = spec.covariates && COVS.length === 0;
      const needCut = getDesign() === "its" && !$("its_cut").value.trim();
      const ok = missing.length === 0 && !needCov && !needCut;
      const m = $("mapmsg");
      if (missing.length) { m.textContent = "Map the required roles (*): " + missing.join(", "); m.className = "mt-3 text-xs text-amber-700"; }
      else if (needCut) { m.textContent = "Give the interruption point — the first period affected by the intervention."; m.className = "mt-3 text-xs text-amber-700"; }
      else if (needCov) { m.textContent = "Tick at least one baseline covariate for the propensity score."; m.className = "mt-3 text-xs text-amber-700"; }
      else { m.textContent = "Mapping complete ✓ — build the master file below."; m.className = "mt-3 text-xs text-emerald-700"; }
      $("cleancard").classList.toggle("hidden", !ok);
      return ok;
    }

    const NUM_ROLES = ["TIME", "INTERVAL", "EVENTS", "DISC", "YCOUNT", "DENOM"];
    const BIN_ROLES = ["EVENT", "TREAT", "EXPOSED", "CASE", "SERIES"];
    const toBin = (v) => { if (v == null || v === "") return null; const l = String(v).trim().toLowerCase(); if (["1", "yes", "y", "true", "t", "case", "event", "exposed", "positive"].includes(l)) return 1; if (["0", "no", "n", "false", "f", "control", "none", "unexposed", "negative"].includes(l)) return 0; const n = Number(l); return isNaN(n) ? null : (n > 0 ? 1 : 0); };

    function buildMaster() {
      const spec = SPEC[getDesign()]; if (!spec || !validateMap()) return;
      const roleCol = {}; spec.roles.forEach((r) => { if (MAP[r.k]) roleCol[r.k] = MAP[r.k]; });
      let rows = DATA.rows.map((r) => Object.assign({}, r));
      if ($("c_trim").checked) rows.forEach((r) => DATA.columns.forEach((c) => { if (typeof r[c] === "string") r[c] = r[c].trim(); }));
      if ($("c_std").checked) rows.forEach((r) => {
        BIN_ROLES.forEach((rk) => { if (roleCol[rk]) { const b = toBin(r[roleCol[rk]]); if (b != null) r[roleCol[rk]] = b; } });
      });
      const numCols = NUM_ROLES.map((k) => roleCol[k]).filter(Boolean).concat(spec.covariates ? COVS : []);
      rows.forEach((r) => numCols.forEach((c) => { const n = Number(String(r[c] == null ? "" : r[c]).replace(/,/g, "")); if (!isNaN(n) && String(r[c]).trim() !== "") r[c] = n; }));
      const before = rows.length;
      if ($("c_dedupe").checked) { const seen = new Set(); rows = rows.filter((r) => { const k = DATA.columns.map((c) => String(r[c] == null ? "" : r[c])).join("|"); if (seen.has(k)) return false; seen.add(k); return true; }); }
      // Duplicate patients/cases — ACNU (one-row-per-person cohort) only.
      const dupId = $("dup_id").value, dupStrat = $("dup_strategy").value;
      if (spec.onePerPerson && dupId && dupStrat !== "all") {
        const dcol = $("dup_date").value, groups = new Map();
        rows.forEach((r, i) => { const k = String(r[dupId] == null ? "" : r[dupId]).trim(); if (k === "") return; if (!groups.has(k)) groups.set(k, []); groups.get(k).push(i); });
        const drop = new Set();
        groups.forEach((idxs) => {
          if (idxs.length < 2) return;
          let keep;
          if (dupStrat === "last") keep = idxs[idxs.length - 1];
          else if (dupStrat === "earliest" || dupStrat === "latest") {
            const wd = idxs.map((i) => ({ i, t: dcol ? Date.parse(String(rows[i][dcol])) : NaN }));
            wd.sort((a, b) => (isNaN(a.t) ? Infinity : a.t) - (isNaN(b.t) ? Infinity : b.t));
            keep = dupStrat === "earliest" ? wd[0].i : wd[wd.length - 1].i;
          } else keep = idxs[0];
          idxs.forEach((i) => { if (i !== keep) drop.add(i); });
        });
        rows = rows.filter((r, i) => !drop.has(i));
      }
      if ($("c_dropmiss").checked) { const req = spec.roles.filter((r) => r.req).map((r) => roleCol[r.k]).filter(Boolean).concat(spec.covariates ? COVS : []); rows = rows.filter((r) => req.every((c) => r[c] != null && String(r[c]).trim() !== "")); }
      MASTER = rows;
      $("cleaninfo").textContent = "Master file: " + rows.length + " rows (from " + before + "; " + (before - rows.length) + " removed).";
      $("anacard").classList.remove("hidden"); $("expcard").classList.remove("hidden");
    }

    function analysisCSV() {
      const spec = SPEC[getDesign()]; const outCols = [], colFor = {}, covNames = [];
      spec.roles.forEach((r) => { if (MAP[r.k]) { outCols.push(r.k); colFor[r.k] = MAP[r.k]; } });
      if (spec.covariates) COVS.forEach((src, i) => { const cn = "COV" + (i + 1); outCols.push(cn); colFor[cn] = src; covNames.push(cn); });
      const rows = (MASTER || []).map((r) => { const o = {}; outCols.forEach((cn) => { o[cn] = r[colFor[cn]]; }); return o; });
      return { csv: toCSV(outCols, rows), covNames };
    }
    function acnuOpts() {
      const methods = [];
      if ($("m_match").checked) methods.push("matching");
      if ($("m_iptw").checked) methods.push("iptw");
      if ($("m_smrw").checked) methods.push("smrw");
      if ($("m_overlap").checked) methods.push("overlap");
      if ($("m_fine").checked) methods.push("finestrat");
      const estimands = [];
      if ($("est_itt").checked) estimands.push("ITT");
      if ($("est_pp").checked) estimands.push("PP");
      return { methods: methods, estimands: estimands.length ? estimands : ["ITT"], ratio: parseInt($("m_ratio").value) || 2, nstrata: parseInt($("m_nstrata").value) || 10 };
    }
    function itsOpts() {
      return { cut: $("its_cut").value.trim(), unit: $("its_unit").value, comb: $("its_comb").value, model: $("its_model").value, season: $("its_season").value, cycle: parseInt($("its_cycle").value) || 12, ac: $("its_ac").value };
    }
    function buildScript() {
      const spec = SPEC[getDesign()]; const { covNames } = analysisCSV();
      if (getDesign() === "acnu") return spec.rscript(covNames, acnuOpts());
      if (getDesign() === "its") return spec.rscript(covNames, itsOpts());
      return spec.rscript(covNames);
    }
    ["its_cut", "its_unit", "its_comb", "its_model", "its_season", "its_cycle", "its_ac"].forEach((id) => $(id).addEventListener("input", () => { if (getDesign() === "its") validateMap(); }));

    $("applyclean").addEventListener("click", buildMaster);
    document.querySelectorAll('[name="design"]').forEach((r) => r.addEventListener("change", () => { MAP = {}; COVS = []; COVROLE = {}; MASTER = null; LAST = null; $("anacard").classList.add("hidden"); $("expcard").classList.add("hidden"); $("itschart").classList.add("hidden"); $("dlfitted").classList.add("hidden"); renderMap(); }));

    // The core ITS figure: observed points, the fitted pre/post segments, and the
    // pre-trend extrapolated forward as the counterfactual.
    const SERIES_COLOR = ["#0e7490", "#b45309", "#4338ca"];
    function fittedRows(rows) {
      const head = rows[0].map((h) => String(h).toLowerCase());
      const ix = (n) => head.indexOf(n);
      const iS = ix("series"), iP = ix("period"), iT = ix("t"), iO = ix("observed"), iD = ix("denominator"), iF = ix("fitted"), iC = ix("counterfactual");
      return rows.slice(1).map((r) => ({ s: r[iS], p: r[iP], t: Number(r[iT]), o: Number(r[iO]), d: r[iD] === "" || r[iD] == null ? null : Number(r[iD]), f: Number(r[iF]), c: Number(r[iC]) }))
        .filter((r) => isFinite(r.t) && isFinite(r.o));
    }
    function renderITSChart(rows, meta) {
      const data = fittedRows(rows);
      if (data.length < 2) return;
      const hasD = data.every((r) => r.d != null && isFinite(r.d) && r.d > 0);
      const v = (r, k) => (hasD ? (r[k] / r.d) * 1000 : r[k]);
      const t0 = parseInt(meta.t0) || 0;
      const W = 760, H = 320, ml = 56, mr = 14, mt = 14, mb = 40;
      const ts = data.map((r) => r.t), all = [];
      data.forEach((r) => { all.push(v(r, "o"), v(r, "f"), v(r, "c")); });
      const finite = all.filter((x) => isFinite(x));
      const tmin = Math.min(...ts), tmax = Math.max(...ts);
      let ymin = Math.min(0, Math.min(...finite)), ymax = Math.max(...finite);
      if (!(ymax > ymin)) ymax = ymin + 1;
      const pad = (ymax - ymin) * 0.08; ymax += pad;
      const X = (t) => ml + ((t - tmin) / Math.max(1, tmax - tmin)) * (W - ml - mr);
      const Y = (y) => H - mb - ((y - ymin) / (ymax - ymin)) * (H - mt - mb);
      const seriesNames = [];
      data.forEach((r) => { if (seriesNames.indexOf(r.s) < 0) seriesNames.push(r.s); });
      let g = "";
      // axes + gridlines
      for (let i = 0; i <= 4; i++) {
        const y = ymin + ((ymax - ymin) * i) / 4;
        g += '<line x1="' + ml + '" y1="' + Y(y).toFixed(1) + '" x2="' + (W - mr) + '" y2="' + Y(y).toFixed(1) + '" stroke="#e2e8f0" stroke-width="1"/>';
        g += '<text x="' + (ml - 6) + '" y="' + (Y(y) + 3.5).toFixed(1) + '" font-size="10" fill="#64748b" text-anchor="end">' + (Math.abs(y) >= 100 ? y.toFixed(0) : y.toFixed(2)) + "</text>";
      }
      g += '<line x1="' + ml + '" y1="' + (H - mb) + '" x2="' + (W - mr) + '" y2="' + (H - mb) + '" stroke="#94a3b8" stroke-width="1"/>';
      // interruption
      if (t0 > tmin) {
        const xc = X(t0 - 0.5);
        g += '<line x1="' + xc.toFixed(1) + '" y1="' + mt + '" x2="' + xc.toFixed(1) + '" y2="' + (H - mb) + '" stroke="#dc2626" stroke-width="1.5" stroke-dasharray="5 3"/>';
        g += '<text x="' + (xc + 4).toFixed(1) + '" y="' + (mt + 11) + '" font-size="10" fill="#dc2626" font-weight="600">interruption' + (meta.cutlabel ? " · " + esc(meta.cutlabel) : "") + "</text>";
      }
      seriesNames.forEach((sn, si) => {
        const col = SERIES_COLOR[si % SERIES_COLOR.length];
        const rs = data.filter((r) => r.s === sn).sort((a, b) => a.t - b.t);
        const path = (arr, key) => arr.map((r, i) => (i ? "L" : "M") + X(r.t).toFixed(1) + " " + Y(v(r, key)).toFixed(1)).join(" ");
        const pre = rs.filter((r) => r.t < t0), post = rs.filter((r) => r.t >= t0);
        if (pre.length > 1) g += '<path d="' + path(pre, "f") + '" fill="none" stroke="' + col + '" stroke-width="2"/>';
        if (post.length > 1) g += '<path d="' + path(post, "f") + '" fill="none" stroke="' + col + '" stroke-width="2"/>';
        if (post.length > 1) g += '<path d="' + path(post, "c") + '" fill="none" stroke="' + col + '" stroke-width="1.6" stroke-dasharray="6 4" opacity="0.75"/>';
        rs.forEach((r) => { g += '<circle cx="' + X(r.t).toFixed(1) + '" cy="' + Y(v(r, "o")).toFixed(1) + '" r="2.6" fill="' + col + '" opacity="0.55"/>'; });
        g += '<text x="' + (ml + 4 + si * 190) + '" y="' + (H - 8) + '" font-size="10" fill="' + col + '" font-weight="600">' + esc(sn) + "</text>";
      });
      // x labels: first, interruption, last
      const lab = (t) => { const r = data.find((x) => x.t === t); return r ? r.p : String(t); };
      [[tmin, "start"], [tmax, "end"]].forEach(([t]) => {
        g += '<text x="' + X(t).toFixed(1) + '" y="' + (H - mb + 14) + '" font-size="10" fill="#64748b" text-anchor="' + (t === tmin ? "start" : "end") + '">' + esc(lab(t)) + "</text>";
      });
      const ylab = hasD ? "rate per 1,000 denominator units" : "outcome per period";
      $("itschart").classList.remove("hidden");
      $("itschart").innerHTML =
        '<div class="text-xs uppercase tracking-widest text-brand-700 font-semibold mb-1">Observed series, fitted segments, and the counterfactual</div>' +
        '<p class="text-[11px] text-slate-500 mb-2">Points are the observed ' + ylab + "; the solid line is the fitted segmented model; the dashed line extrapolates the pre-intervention trend forward as the counterfactual.</p>" +
        '<svg viewBox="0 0 ' + W + " " + H + '" width="100%" style="max-width:' + W + 'px" role="img" aria-label="Interrupted time series chart">' + g + "</svg>";
    }

    $("runanalysis").addEventListener("click", async () => {
      if (!MASTER) buildMaster();
      if (!MASTER) return;
      const { csv } = analysisCSV(); const script = buildScript();
      const setS = (m) => { $("anastatus").textContent = m; };
      $("runanalysis").disabled = true; $("anaresults").classList.add("hidden"); $("table1").classList.add("hidden"); $("itschart").classList.add("hidden"); $("dlfitted").classList.add("hidden");
      try {
        const out = await window.RWEngine.run(script, csv, setS);
        setS("Done ✓");
        const ests = [], t1 = [], notes = [], fitted = []; let meta = {};
        out.split("\n").forEach((l) => {
          if (l.indexOf("RESULT_ESTIMATE|") === 0) { const p = l.split("|"); ests.push({ label: p[1], value: p.slice(2).join("|") }); }
          else if (l.indexOf("TABLE1|") === 0) { t1.push(l.split("|").slice(1)); }
          else if (l.indexOf("RESULT_NOTE|") === 0) { notes.push(l.split("|").slice(1).join("|")); }
          else if (l.indexOf("FITTED|") === 0) { fitted.push(l.split("|").slice(1)); }
          else if (l.indexOf("ITSMETA|") === 0) { l.split("|").slice(1).forEach((kv) => { const i = kv.indexOf("="); if (i > 0) meta[kv.slice(0, i)] = kv.slice(i + 1); }); }
        });
        const display = out.replace(/^(RESULT_ESTIMATE|RESULT_NOTE|TABLE1|FITTED|ITSMETA)\|.*$/gm, "").replace(/\n{3,}/g, "\n\n").trim();
        if (ests.length || notes.length) {
          $("anaresults").classList.remove("hidden");
          const noteHtml = notes.length ? '<div class="mt-3 space-y-1">' + notes.map((n) => '<p class="text-[11px] text-slate-600">' + esc(n) + "</p>").join("") + "</div>" : "";
          const tblHtml = ests.length ? '<div class="overflow-x-auto"><table class="w-full text-sm border-collapse"><thead><tr class="text-left text-slate-500 border-b border-slate-200"><th class="py-1.5 pr-4 font-semibold">Method / estimand</th><th class="py-1.5 font-semibold">Estimate (95% CI)</th></tr></thead><tbody>' + ests.map((e) => '<tr class="border-b border-slate-100"><td class="py-1.5 pr-4 text-slate-700">' + esc(e.label) + '</td><td class="py-1.5 font-bold text-slate-900">' + esc(e.value) + "</td></tr>").join("") + "</tbody></table></div>" : "";
          $("anaresults").innerHTML = '<div class="text-xs uppercase tracking-widest text-brand-700 font-semibold mb-2">Effect estimates</div>' + tblHtml + noteHtml;
        }
        if (fitted.length > 1) { renderITSChart(fitted, meta); $("dlfitted").classList.remove("hidden"); }
        if (t1.length) {
          $("table1").classList.remove("hidden");
          const head = t1[0], body = t1.slice(1);
          $("table1").innerHTML = '<div class="text-xs uppercase tracking-widest text-brand-700 font-semibold mb-2">Patient characteristics (Table 1)</div><table class="w-full text-xs border-collapse"><thead><tr class="text-left text-slate-500 border-b border-slate-200">' + head.map((h) => '<th class="py-1.5 pr-4 font-semibold">' + esc(h) + "</th>").join("") + "</tr></thead><tbody>" + body.map((rr) => '<tr class="border-b border-slate-100">' + rr.map((c, i) => '<td class="py-1.5 pr-4 ' + (i === 0 ? "text-slate-700" : "text-slate-600") + '">' + esc(c) + "</td>").join("") + "</tr>").join("") + "</tbody></table>";
        }
        $("routput").classList.remove("hidden"); $("routput").textContent = display || "(no output)";
        LAST = { out: display, script: script, ests: ests, t1: t1, notes: notes, fitted: fitted, meta: meta };
      } catch (e) { setS("Error"); $("routput").classList.remove("hidden"); $("routput").textContent = "Error: " + (e && e.message ? e.message : e); }
      finally { $("runanalysis").disabled = false; }
    });

    const readQ = () => { const g = (n) => { const e = document.querySelector('[name="' + n + '"]'); return e ? e.value : ""; }; return { pop: g("q_pop"), exp: g("q_exp"), comp: g("q_comp"), out: g("q_out"), design: getDesign() }; };
    function buildReport(q) {
      const today = new Date().toISOString().slice(0, 10);
      const label = (SPEC[q.design] || {}).label || q.design || "(design)";
      const ests = (LAST && LAST.ests) || [], t1 = (LAST && LAST.t1) || [], notes = (LAST && LAST.notes) || [], fit = (LAST && LAST.fitted) || [];
      const resTbl = ests.length ? ("| Method / estimand | Estimate (95% CI) |\n|---|---|\n" + ests.map((e) => "| " + e.label + " | " + e.value + " |").join("\n")) : "(run the analysis first)";
      const t1Tbl = t1.length ? (t1.map((r, i) => "| " + r.join(" | ") + " |" + (i === 0 ? "\n|" + r.map(() => "---").join("|") + "|" : "")).join("\n")) : "";
      const fitTbl = fit.length > 1 ? (fit.map((r, i) => "| " + r.join(" | ") + " |" + (i === 0 ? "\n|" + r.map(() => "---").join("|") + "|" : "")).join("\n")) : "";
      return "# RWE Studio analysis report\n\n_Generated " + today + " · analysis run locally in the browser via WebR (real R)_\n\n" +
        "## Question\n- Population: " + (q.pop || "(specify)") + "\n- Exposure: " + (q.exp || "(specify)") + "\n- Comparator: " + (q.comp || "—") + "\n- Outcome: " + (q.out || "(specify)") + "\n- Design: " + label + "\n\n" +
        "## Effect estimates\n\n" + resTbl + "\n\n" +
        (notes.length ? "### How the model was fitted\n\n" + notes.map((n) => "- " + n).join("\n") + "\n\n" : "") +
        (t1.length ? "## Patient characteristics (Table 1)\n\n" + t1Tbl + "\n\n" : "") +
        (fitTbl ? "## Fitted series — observed vs counterfactual\n\n" + fitTbl + "\n\n" : "") +
        "## R output\n\n```\n" + (LAST ? LAST.out : "(run the analysis first)") + "\n```\n\n" +
        "## Reproducible R script\n\n```r\n" + (LAST ? LAST.script : buildScript()) + "\n```\n";
    }
    async function buildReportDocx(q) {
      const D = window.docx; if (!D) return null;
      const today = new Date().toISOString().slice(0, 10);
      const label = (SPEC[q.design] || {}).label || q.design || "(design)";
      const FONT = "Times New Roman";
      const text = (t, o = {}) => new D.TextRun({ text: String(t == null ? "" : t), font: FONT, size: 22, ...o });
      const p = (ch, o = {}) => new D.Paragraph({ children: Array.isArray(ch) ? ch : [ch], spacing: { before: 60, after: 60, ...(o.spacing || {}) }, ...o });
      const h1 = (t) => new D.Paragraph({ children: [text(t, { bold: true, size: 28 })], spacing: { before: 200, after: 80 }, heading: D.HeadingLevel.HEADING_1 });
      const mono = (l) => new D.Paragraph({ children: [new D.TextRun({ text: l, font: "Consolas", size: 16 })], spacing: { before: 0, after: 0 } });
      const brd = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" }; const cbr = { top: brd, bottom: brd, left: brd, right: brd };
      const tbl = (rows, hdr) => new D.Table({ width: { size: 9026, type: D.WidthType.DXA }, rows: rows.map((cells, ri) => new D.TableRow({ children: cells.map((c) => new D.TableCell({ borders: cbr, margins: { top: 60, bottom: 60, left: 100, right: 100 }, shading: (hdr && ri === 0) ? { fill: "F5F5F5", type: D.ShadingType.CLEAR } : undefined, children: [p([text(c, { bold: hdr && ri === 0 })])] })) })) });
      let logo = null; try { const rr = await fetch("/images/networks/phdc.png"); if (rr.ok) logo = new Uint8Array(await rr.arrayBuffer()); } catch (e) {}
      const ch = [];
      if (logo) ch.push(new D.Paragraph({ spacing: { after: 120 }, children: [new D.ImageRun({ data: logo, transformation: { width: 210, height: 51 } })] }));
      ch.push(p([text("RWE Studio analysis report", { bold: true, size: 32 })], { spacing: { after: 40 } }));
      ch.push(p([text("Generated " + today + " · analysis run locally in the browser via WebR (real R).", { italics: true, color: "777777", size: 18 })], { spacing: { after: 160 } }));
      ch.push(h1("Question"));
      ch.push(tbl([["Population", q.pop || "(specify)"], ["Exposure", q.exp || "(specify)"], ["Comparator", q.comp || "—"], ["Outcome", q.out || "(specify)"], ["Design", label]], false));
      const ests = (LAST && LAST.ests) || [], t1 = (LAST && LAST.t1) || [], notes = (LAST && LAST.notes) || [], fit = (LAST && LAST.fitted) || [];
      ch.push(h1("Effect estimates"));
      if (ests.length) ch.push(tbl([["Method / estimand", "Estimate (95% CI)"]].concat(ests.map((e) => [e.label, e.value])), true)); else ch.push(p([text("(run the analysis first)")]));
      notes.forEach((n) => ch.push(p([text(n, { size: 18, color: "555555" })])));
      if (t1.length) { ch.push(h1("Patient characteristics (Table 1)")); ch.push(tbl(t1, true)); }
      if (fit.length > 1) { ch.push(h1("Fitted series — observed vs counterfactual")); ch.push(tbl(fit, true)); }
      ch.push(h1("R output"));
      (LAST ? LAST.out : "(run the analysis first)").split("\n").forEach((l) => ch.push(mono(l)));
      ch.push(h1("Reproducible R script"));
      (LAST ? LAST.script : buildScript()).split("\n").forEach((l) => ch.push(mono(l)));
      const doc = new D.Document({ creator: "RWE Studio", title: "RWE Studio report", styles: { default: { document: { run: { font: FONT, size: 22 } } }, paragraphStyles: [{ id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 28, bold: true, font: FONT }, paragraph: { spacing: { before: 200, after: 80 }, outlineLevel: 0 } }] }, sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children: ch }] });
      return await D.Packer.toBlob(doc);
    }
    $("dlmaster2").addEventListener("click", () => { if (!MASTER) buildMaster(); if (MASTER) dl(new Blob(["﻿" + toCSV(DATA.columns, MASTER)], { type: "text/csv;charset=utf-8" }), DATA.name + "-master.csv"); });
    $("dlscript").addEventListener("click", () => { const s = LAST ? LAST.script : buildScript(); dl(new Blob(["# Analysis script generated by RWE Studio — reads the master file as data.csv\n# Reproduces the on-screen result in desktop R.\n\n" + s + "\n"], { type: "text/plain;charset=utf-8" }), DATA.name + "-analysis.R"); });
    $("dlfitted").addEventListener("click", () => {
      const f = LAST && LAST.fitted; if (!f || f.length < 2) return;
      dl(new Blob(["﻿" + f.map((r) => r.map(csvCell).join(",")).join("\n")], { type: "text/csv;charset=utf-8" }), DATA.name + "-fitted-series.csv");
    });
    $("dlreport").addEventListener("click", () => { dl(new Blob([buildReport(readQ())], { type: "text/markdown;charset=utf-8" }), DATA.name + "-report.md"); });
    $("dlreportword").addEventListener("click", async () => { const b = await buildReportDocx(readQ()); if (b) dl(b, DATA.name + "-report.docx"); });
  </script>
</BaseLayout>
