          L.push("floorp<-function(dt,u){ if(u=='day') return(dt); if(u=='week') return(dt-(as.integer(format(dt,'%u'))-1)); if(u=='month') return(as.Date(paste0(format(dt,'%Y-%m'),'-01'))); if(u=='quarter'){ m<-as.integer(format(dt,'%m')); return(as.Date(sprintf('%s-%02d-01',format(dt,'%Y'),(m-1)%/%3*3+1))) }; if(u=='year') return(as.Date(paste0(format(dt,'%Y'),'-01-01'))); dt }");
          L.push("tid<-d$TIDX; dts<-pdate(tid); nz<-sum(!is.na(tid) & trimws(as.character(tid))!='')");
          L.push("isdate<-nz>0 && sum(!is.na(dts))>=0.8*nz");
          L.push("if(UNIT!='none' && !isdate){ cat('The time column does not parse as dates, so its literal values are used as the periods.\\n'); UNIT<-'none' }");
          L.push("key<-if(UNIT!='none') format(floorp(dts,UNIT),'%Y-%m-%d') else trimws(as.character(tid))");
          L.push("");
          L.push("Y<-suppressWarnings(as.numeric(d$YCOUNT))");
