          L.push("");
          L.push("# --- observed vs counterfactual at the end of follow-up ---");
          L.push("gmax<-max(a$g); tn<-max(a$t[a$g==gmax]); tsn<-max(0,tn-t0+1)");
          L.push("L0<-setNames(rep(0,length(nmv)),nmv)");
          L.push("zn<-if(HASG) c('g:level','g:tsince') else c('level','tsince')");
