---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhenotypeLibrary from "../../components/PhenotypeLibrary.astro";
import SitesPicker from "../../components/SitesPicker.astro";
import DesignDiagram from "../../components/DesignDiagram.astro";
import ProtocolCommon from "../../components/ProtocolCommon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const SUBGROUPS = [
  "Age group (e.g. ≥65 vs <65)",
  "Sex (male vs female)",
  "Region / hospital level",
  "Baseline outcome risk (high vs low)",
  "Calendar sub-period",
  "Comorbidity burden",
];
const SENSITIVITY = [
  "Number of CPE strata (e.g. 3 vs 5 vs 10 quantiles)",
  "Alternative covariate set in the stage-1 exposure model that defines CPE",
  "Alternative exposure-prevalence definition",
  "Restrict to periods with a strong prevalence trend",
  "Negative-control outcome (should show no trend-in-trend signal)",
  "Exclude the early-adoption period",
  "Alternative calendar-period length",
];
---

<BaseLayout
  title="Trend-in-Trend (TIT) protocol — Daniel Tsai"
  description="A free, in-browser protocol builder for the trend-in-trend design (Ji et al, Epidemiology 2017), which compares outcome trends across strata of the cumulative probability of exposure. One-click Word / Markdown export."
>
  <header class="relative bg-gradient-to-br from-brand-50 via-white to-brand-100/40 border-b border-slate-200 overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
      <p class="uppercase tracking-widest text-xs text-brand-600 font-semibold mb-2">Protocol Generator · TIT</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">Trend-in-Trend protocol</h1>
      <p class="mt-3 text-base text-slate-600 max-w-3xl">
        <strong>In plain terms.</strong> A drug's use rises steeply in some kinds of patient and barely at all in others.
        If the drug really causes the outcome, the outcome should rise fastest exactly where the drug's use rose
        fastest. Trend-in-trend reads the effect off that co-movement rather than off a comparison of treated with
        untreated people — so a confounder that sits still over time cannot produce it.
      </p>
      <details class="mt-3 max-w-3xl text-sm text-slate-600">
        <summary class="cursor-pointer font-semibold text-brand-700">How that is done precisely (Ji et al, <em>Epidemiology</em> 2017)</summary>
        <p class="mt-2">
          Stage 1 fits a logistic model of <strong>exposure</strong> on covariates that affect exposure but are not
          affected by it, and takes each person's predicted probability of being exposed at any point in the study
          period — the <strong>cumulative probability of exposure (CPE)</strong>. Covariates are treated as
          time-invariant, so each person sits in one CPE stratum for the whole study. The population is then cut into
          quantiles of CPE (quintiles in the original paper), which sorts people by <em>how steeply their exposure
          prevalence trends</em>. Stage 2 tabulates, for every CPE stratum and calendar period, a 2 × 2 table of
          exposed / unexposed × case / non-case, and maximises the trend-in-trend likelihood over those tables. The
          estimate is <strong>exp(β₁), an odds ratio</strong>.
        </p>
        <p class="mt-2">
          <strong>When it fails.</strong> The design is unbiased <em>unless</em> there are unmeasured factors affecting
          the outcome whose prevalence trends over calendar time in a way that is correlated with the exposure trend
          across CPE strata. A confounder that is stable over time therefore cannot bias it; a co-intervention or a
          secular change that arrives alongside uptake can. It also needs a genuinely strong time trend in exposure —
          without one there is nothing to read the effect off, and the likelihood may not be identified.
        </p>
      </details>
      <a class="mt-4 inline-block text-sm text-brand-700 hover:underline font-semibold" href={`${base}/tools/protocol-generator`}>← All designs</a>
    </div>
  </header>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid gap-8 lg:grid-cols-[1fr,1fr] items-start">
      <form id="form" class="space-y-6">
        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">1 · Identity</legend>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Study title</span>
            <input name="title" placeholder="e.g. Statins and diabetes incidence: a trend-in-trend analysis" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Data source(s)</span>
            <input name="data" placeholder="e.g. Taiwan NHIRD (2005–2018)" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <SitesPicker target="data" />
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">2 · Question</legend>
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Population</span>
              <button type="button" data-open-library data-category="indications" data-target-name="population" class="text-[11px] text-brand-700 font-semibold hover:underline">📚 Library</button>
            </div>
            <input name="population" placeholder="e.g. Adults ≥ 40 without diabetes at baseline" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Exposure (rising/falling in use)</span>
                <button type="button" data-open-library data-category="exposures" data-target-name="exposure" class="text-[11px] text-brand-700 font-semibold hover:underline">📚</button>
              </div>
              <input name="exposure" placeholder="e.g. Statins" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
            </div>
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Outcome</span>
                <button type="button" data-open-library data-category="outcomes" data-target-name="outcome" class="text-[11px] text-brand-700 font-semibold hover:underline">📚</button>
              </div>
              <input name="outcome" placeholder="e.g. Incident type 2 diabetes" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
            </div>
          </div>
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">3 · Calendar trend &amp; CPE strata</legend>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Period length</span>
              <select name="period" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
                <option>yearly</option><option>quarterly</option><option>every 6 months</option><option>monthly</option>
              </select></label>
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">First period</span>
              <input name="first" placeholder="e.g. 2005" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Last period</span>
              <input name="last" placeholder="e.g. 2018" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Number of calendar periods</span>
              <input type="number" name="nperiods" value="10" min="3" step="1" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Number of CPE strata (quantiles)</span>
              <input type="number" name="nstrata" value="5" min="2" max="10" step="1" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
              <span class="text-[11px] text-slate-500">Ji et al used quintiles (5).</span></label>
          </div>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Exposure-prevalence definition (per period)</span>
            <input name="prevdef" placeholder="e.g. Proportion of the population dispensed the exposure in the period" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Stage-1 model: covariates that predict exposure</span>
            <input name="cpecov" placeholder="e.g. Age, sex, comorbidity index, prior healthcare use, region — measured before the study period" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
            <span class="text-[11px] text-slate-500">CPE is each person's predicted probability of exposure from this model. Use variables that <strong>affect</strong> exposure and are not <strong>affected by</strong> it (no post-exposure variables, no mediators).</span></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">CPE strata definition</span>
            <input name="cpedef" placeholder="e.g. Quintiles of the stage-1 predicted probability of exposure; each person keeps one stratum for the whole study" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">4 · Estimator &amp; assumptions</legend>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Estimator</span>
            <select name="estimator" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
              <option value="ml">Trend-in-trend maximum likelihood on the stratum × period tables (Ji et al 2017)</option>
            </select>
            <span class="text-[11px] text-slate-500">This is the estimator the design defines; the reference implementation is the <code>TrendInTrend</code> R package (<code>OR()</code>), with bootstrap confidence intervals.</span></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Effect measure to report</span>
            <select name="effect" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
              <option value="OR">Odds ratio — exp(β₁), what the likelihood estimates</option>
              <option value="RR">Odds ratio, additionally interpreted as a risk ratio (rare outcome only)</option>
            </select>
            <span class="text-[11px] text-slate-500">The trend-in-trend likelihood returns an odds ratio. It approximates a risk ratio only when the outcome is rare; say so explicitly if you report it that way.</span></label>
          <p class="text-[11px] text-slate-500">
            <strong>Assumptions, stated as the paper states them.</strong> (1) There is a strong time trend in exposure —
            without one there is nothing to identify. (2) The estimate is unbiased unless unmeasured factors affecting
            the outcome have prevalence trends over calendar time that are correlated with the exposure trends across
            CPE strata; a time-stable confounder therefore cannot bias it. (3) Covariates in the stage-1 exposure model
            are treated as time-invariant, so each person stays in one CPE stratum throughout.
          </p>
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">5 · Subgroups &amp; sensitivity</legend>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Subgroup analyses (tick to perform)</span>
            <div class="mt-1.5 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1">
              {SUBGROUPS.map((sg, i) => (
                <label class="flex items-start gap-2 text-xs text-slate-700">
                  <input type="checkbox" name="subgroupsPick" value={sg} checked={i < 2} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{sg}</span>
                </label>
              ))}
            </div>
            <textarea name="subgroupsCustom" rows="2" class="mt-2 w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="Custom subgroups (one per line)"></textarea>
          </div>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Sensitivity analyses (tick to perform)</span>
            <div class="mt-1.5 grid grid-cols-1 gap-y-1">
              {SENSITIVITY.map((sn, i) => (
                <label class="flex items-start gap-2 text-xs text-slate-700">
                  <input type="checkbox" name="sensitivityPick" value={sn} checked={i < 4} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{sn}</span>
                </label>
              ))}
            </div>
            <textarea name="sensitivityCustom" rows="2" class="mt-2 w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="Custom sensitivity analyses (one per line)"></textarea>
          </div>
        </fieldset>

        <div class="flex flex-wrap gap-3">
          <button type="button" data-action="download-docx" class="bg-brand-700 text-white hover:bg-brand-800 font-semibold px-5 py-2.5 rounded-lg text-sm">⬇ Word (.docx)</button>
          <button type="button" data-action="download-md" class="bg-white border border-brand-700 text-brand-700 hover:bg-brand-50 font-semibold px-5 py-2.5 rounded-lg text-sm">⬇ Markdown</button>
          <button type="button" data-action="copy" class="text-brand-700 hover:underline font-semibold text-sm">Copy</button>
          <button type="button" data-action="reset" class="ml-auto text-slate-500 hover:text-rose-600 hover:underline text-sm font-semibold">Clear all</button>
          <span class="basis-full text-[11px] text-slate-400">Auto-saved to this browser.</span>
          <p data-action-msg class="basis-full text-xs"></p>
        </div>
      </form>

      <div class="lg:sticky lg:top-20 self-start">
        <p class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-2">Live protocol preview</p>
        <pre id="preview" class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-xs leading-relaxed whitespace-pre-wrap overflow-auto max-h-[70vh]"></pre>
      </div>
    </div>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-base font-bold text-slate-900">Consistency checks <span class="text-xs font-normal text-slate-400">· TIT 防呆</span></h2>
      <div id="checks" class="mt-3 space-y-1.5"></div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">Study design diagram</h2>
      <p id="dcap" class="mt-1 text-xs text-slate-500"></p>
      <div class="mt-4 overflow-x-auto"><div id="diagram"></div></div>
      <div id="dlegend" class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-slate-600"></div>
    </div>

    <PhenotypeLibrary />
    <DesignDiagram />
    <ProtocolCommon />
  </section>

  <script src="https://unpkg.com/docx@8.5.0/build/index.umd.js" is:inline></script>
  <script is:inline>
    const STORAGE_KEY = "daniel.tit-builder";
    const form = document.getElementById("form");
    const preview = document.getElementById("preview");
    const V = (n) => (form.elements[n]?.value || "").trim();
    const MV = (n) => [...form.querySelectorAll('[name="' + n + '"]:checked')].map((c) => c.value);
    const mergeList = (pick, custom) => [...(pick || []), ...String(custom || "").split(/\r?\n/).map((x) => x.trim()).filter(Boolean)];
    const or = (s, d) => (s && s.length ? s : d);
    const esc = (x) => String(x == null ? "" : x).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    // A draft saved before the unsupported estimator was removed still carries
    // estimator:"logistic". Assigning that to a <select> that no longer offers it
    // leaves the select showing nothing, and readForm()'s `|| "ml"` fallback then
    // prints a protocol asserting the maximum-likelihood estimator — a different
    // analysis from the one the user's draft named, swapped in silently. Capture
    // the stale value on restore (before the first render overwrites the saved
    // state) and say so on screen instead.
    let staleEstimator = "";
    const KNOWN_ESTIMATORS = [...form.querySelectorAll('[name="estimator"] option')].map((o) => o.value);
    const noteStale = (obj) => {
      if (obj && typeof obj === "object" && obj.estimator && KNOWN_ESTIMATORS.indexOf(String(obj.estimator)) < 0) {
        staleEstimator = String(obj.estimator);
      }
    };

    const readForm = () => ({
      title: V("title"), data: V("data"), population: V("population"), exposure: V("exposure"), outcome: V("outcome"),
      period: V("period") || "yearly", first: V("first"), last: V("last"),
      nperiods: V("nperiods") || "10", nstrata: V("nstrata") || "5", prevdef: V("prevdef"), cpedef: V("cpedef"), cpecov: V("cpecov"),
      estimator: V("estimator") || "ml", effect: V("effect") || "OR",
      subgroupsPick: MV("subgroupsPick"), subgroupsCustom: V("subgroupsCustom"), sensitivityPick: MV("sensitivityPick"), sensitivityCustom: V("sensitivityCustom"),
    });

    // The design defines one estimator: the two-stage procedure of Ji et al 2017.
    // An earlier version of this page also offered a "logistic-regression
    // approximation (outcome on CPE-stratum × time)". No such estimator appears in
    // the paper or in the TrendInTrend package, so it was removed rather than left
    // asserting a method that cannot be cited.
    const estimatorText = () =>
      "the two-stage trend-in-trend estimator (Ji et al, Epidemiology 2017): stage 1 fits a logistic model of exposure on covariates that affect exposure but are not affected by it, and each person's predicted probability of exposure over the study period (the cumulative probability of exposure, CPE) assigns them to a CPE stratum; stage 2 tabulates, for every CPE stratum and calendar period, the counts of exposed/unexposed by case/non-case, and maximises the trend-in-trend likelihood over those tables";
    const effectText = (e) => e === "RR"
      ? "odds ratio, exp(β₁), additionally interpreted as a risk ratio (an approximation that holds only for a rare outcome)"
      : "odds ratio, exp(β₁)";
    const effectShort = (e) => e === "RR" ? "odds ratio (reported also as a risk ratio)" : "odds ratio";

    const pcOf = (s) => ({
      design: "trend-in-trend design (Ji et al, Epidemiology 2017)",
      tte: false,
      population: or(s.population, "(population)"),
      exposure: or(s.exposure, "(exposure)"),
      comparator: "",
      outcome: or(s.outcome, "(outcome)"),
      data: s.data,
      analysis: estimatorText() + ", reporting the " + effectText(s.effect) + " with 95% confidence intervals (bootstrap)",
      groupBy: "cumulative-probability-of-exposure (CPE) stratum",
      limitations: "Trend-in-trend requires a strong time trend in exposure, and is unbiased only if no unmeasured factor affecting the outcome has a prevalence trend over calendar time that is correlated with the exposure trend across CPE strata — so a time-stable confounder cannot bias it, but a co-intervention or secular change arriving alongside uptake can. Stage-1 covariates are treated as time-invariant, so each person keeps one CPE stratum throughout.",
      plannedOutputs: ["Exposure-prevalence trend by calendar period, and by CPE stratum (evidence that the strata really do differ in exposure trend).", "Outcome trend by CPE stratum (the trend-in-trend figure).", "The stratum × period 2 × 2 tables that enter the likelihood.", "Effect estimate with 95% CI."],
    });

    // What is still blank. A protocol that reads as finished while its defining
    // elements are placeholders is worse than one that says so, so the gap list
    // travels into the preview, the Markdown and the Word file alike.
    const missing = (s) => [
      [!s.population, "the population"],
      [!s.exposure, "the exposure whose use trends over calendar time"],
      [!s.outcome, "the outcome"],
      [!s.data, "the data source"],
      [!s.cpecov, "the stage-1 covariates that define CPE — without them the strata are undefined"],
      [!s.prevdef, "how exposure prevalence is measured in each period"],
    ].filter((x) => x[0]).map((x) => x[1]);
    const missingMd = (s) => {
      const m = missing(s);
      return m.length ? "> **This draft is incomplete.** Still to be specified: " + m.join("; ") + ".\n\n" : "";
    };

    const buildMarkdown = (s) => {
      const today = new Date().toISOString().slice(0, 10);
      const P = or(s.population, "(population)"), E = or(s.exposure, "(exposure)"), O = or(s.outcome, "(outcome)");
      return `# ${or(s.title, "(Untitled trend-in-trend study)")}

_Study protocol · trend-in-trend design · drafted ${today}_

${missingMd(s)}${window.PC.abstractMd(pcOf(s))}
## 1. Background and rationale
This study uses the **trend-in-trend (TIT)** design (Ji et al, *Epidemiology* 2017) to estimate the effect of **${E}** on **${O}** in **${P}**.

*In plain terms:* the use of ${E} rises steeply in some kinds of patient and barely at all in others. If ${E} really causes ${O}, then ${O} should rise fastest exactly where the use of ${E} rose fastest. The design reads the effect off that co-movement rather than off a comparison of treated with untreated people.

*Precisely:* the population is stratified by the **cumulative probability of exposure (CPE)** — each person's predicted probability of being exposed at some point in the study period, from a model fitted to covariates that affect exposure but are not affected by it. Because exposure trends differ across those strata, the outcome trends across strata identify the effect. The design is **unbiased unless there are unmeasured factors affecting ${O} whose prevalence trends over calendar time in a way correlated with the exposure trend across CPE strata** — so a confounder that is stable over time cannot bias it, which is its advantage over a conventional cohort. The conditions under which trend-in-trend is biased are a subset of those under which a cohort study is biased.

## 2. Question
Among **${P}**, does **${E}** affect the incidence of **${O}**, as identified by the co-movement of exposure trends and outcome trends across CPE strata?

## 3. Study design
A **trend-in-trend** analysis using observational data from **${or(s.data, "(data source)")}**, over **${or(s.first, "(first)")}–${or(s.last, "(last)")}** in **${or(s.period, "yearly")}** periods (**${s.nperiods}** periods), with **${s.nstrata}** CPE strata.

## 4. Exposure-prevalence trend
${or(s.prevdef, "For each calendar period, exposure prevalence is the proportion of the population dispensed the exposure.")} A **strong time trend in exposure is a requirement of the design, not a convenience**: without one there is nothing for the likelihood to identify the effect from. The observed prevalence trend is reported before any effect estimate is interpreted, overall and within each CPE stratum.

## 5. CPE strata (stage 1)
A logistic model of **exposure** is fitted on: ${or(s.cpecov, "_(specify the covariates — variables that affect exposure and are not affected by it; no mediators, no post-exposure variables)_")}. Each person's predicted probability of exposure over the study period is their **cumulative probability of exposure (CPE)**. ${or(s.cpedef, "The population is then divided into " + s.nstrata + " quantiles of CPE.")} Covariates are treated as time-invariant, so each person remains in the same CPE stratum for every calendar period.

## 6. Outcome model and estimator (stage 2)
For every CPE stratum and calendar period, a 2 × 2 table of exposed / unexposed by case / non-case is tabulated, and the effect is estimated by ${estimatorText()}. The reference implementation is the \`TrendInTrend\` R package (\`OR()\`), which returns the maximum-likelihood β and a bootstrap confidence interval, and flags non-identification.

## 7. Estimand and effect measure
The estimand is the causal effect of ${E} on ${O}, reported as the **${effectText(s.effect)}** with a 95% bootstrap confidence interval.${s.effect === "RR" ? " The risk-ratio reading is stated as an approximation and the outcome frequency that justifies it is reported alongside it." : ""}

## 8. Statistical analysis
1. Compute exposure prevalence per calendar period and report the trend; confirm it is strong enough to identify an effect.
2. Fit the stage-1 exposure model and assign each person to one of ${s.nstrata} CPE strata by quantiles of the predicted probability.
3. Report the exposure-prevalence trend **within each CPE stratum**, to demonstrate the strata really do differ in exposure trend.
4. Tabulate the stratum × period 2 × 2 counts and maximise the trend-in-trend likelihood; report exp(β₁) with a 95% bootstrap CI, and report explicitly if the model is not identified.
5. Plot the exposure-prevalence trend and the CPE-stratum-specific outcome trends.

## 9. Subgroup analyses
${(mergeList(s.subgroupsPick, s.subgroupsCustom).length ? mergeList(s.subgroupsPick, s.subgroupsCustom) : ["(none pre-specified)"]).map((l) => "- " + l).join("\n")}

## 10. Sensitivity analyses
${(mergeList(s.sensitivityPick, s.sensitivityCustom).length ? mergeList(s.sensitivityPick, s.sensitivityCustom) : ["(none pre-specified)"]).map((l) => "- " + l).join("\n")}

${window.PC.tailMd(pcOf(s))}

## References
- Ji X, Small DS, Leonard CE, Hennessy S. The Trend-in-trend Research Design for Causal Inference. Epidemiology 2017;28(4):529-536. doi:10.1097/EDE.0000000000000579 (PMID 27775954)
- Ertefaie A, Small DS, Ji X, Leonard C, Hennessy S. Statistical Power for Trend-in-trend Design. Epidemiology 2018;29(3):e21-e23. doi:10.1097/EDE.0000000000000803 (PMID 29337845)
- Dasgupta N, Schwarz J, Hennessy S, Ertefaie A, Dart RC. Causal inference for evaluating prescription opioid abuse using trend-in-trend design. Pharmacoepidemiol Drug Saf 2019;28(5):716-725. doi:10.1002/pds.4736 (PMID 30714239)
- Ji X, Ertefaie A. TrendInTrend: Odds Ratio Estimation and Power Calculation for the Trend in Trend Model. R package, CRAN. doi:10.32614/CRAN.package.TrendInTrend
`;
    };

    const computeChecks = (s) => {
      const checks = [];
      const np = parseInt(s.nperiods) || 0, ns = parseInt(s.nstrata) || 0;
      const miss = missing(s);
      if (staleEstimator) checks.push({ level: "error", msg: "Your saved draft selected the estimator “" + staleEstimator + "”, and this page no longer offers it. It described a logistic-regression approximation that appears neither in Ji et al (2017) nor in the TrendInTrend package, so it was removed rather than left asserting a method that cannot be cited. The Estimator field has been set to the trend-in-trend maximum-likelihood estimator and the protocol below describes THAT — a different analysis from the one your draft named. Check it reads as you intend before exporting." });
      if (miss.length) checks.push({ level: "error", msg: "This protocol is not yet complete. Still to be specified: " + miss.join("; ") + ". The draft below is printed with placeholders so you can see its shape — it is not a finished protocol." });
      if (!s.cpecov || !s.cpecov.trim()) checks.push({ level: "error", msg: "CPE is a predicted probability, not an observed percentage: it comes from a stage-1 logistic model of EXPOSURE on covariates. Until you name those covariates the strata are undefined. Use variables that affect exposure and are not affected by it — no mediators, no post-exposure variables." });
      if (np < 5) checks.push({ level: "warn", msg: "Only " + np + " calendar periods — the exposure trend is estimated across periods; too few weakens power. Aim for ≥ 5–10." });
      if (ns < 3) checks.push({ level: "warn", msg: "Only " + ns + " CPE strata — trend-in-trend contrasts outcome trends across CPE strata; use ≥ 3. Ji et al used quintiles (5)." });
      if (ns > 5) checks.push({ level: "info", msg: ns + " CPE strata spreads the same cases over more stratum × period cells. Sparse cells destabilise the likelihood; report the cell counts, and compare against 5 strata as a sensitivity analysis." });
      checks.push({ level: "info", msg: "Requirement, not a nicety: exposure prevalence must trend strongly over calendar time. Report the observed prevalence trend — overall and WITHIN each CPE stratum — before interpreting any effect estimate. If the strata do not differ in exposure trend, there is nothing to identify the effect from." });
      checks.push({ level: "info", msg: "The design is unbiased UNLESS an unmeasured factor affecting the outcome has a prevalence trend over calendar time correlated with the exposure trend across CPE strata. A time-stable confounder cannot bias it; a co-intervention or secular change arriving with uptake can. Pre-specify a negative-control outcome to probe this." });
      if (s.effect === "RR") checks.push({ level: "warn", msg: "The trend-in-trend likelihood estimates an ODDS ratio, exp(β₁). Reporting it as a risk ratio is a rare-outcome approximation — state the outcome frequency that justifies it, or report the odds ratio." });
      checks.push({ level: "info", msg: "The reference implementation (TrendInTrend::OR in R) returns a `not_identified` flag. If it fires, report that the model was not identified rather than the number it printed." });
      return checks;
    };

    // ── Custom TIT diagram: exposure-prevalence trend + CPE-stratum outcome trends ──
    function renderScheme(s) {
      const np = Math.max(3, Math.min(24, parseInt(s.nperiods) || 10));
      const ns = Math.max(2, Math.min(6, parseInt(s.nstrata) || 5));
      const W = 860, H = 300, plotL = 60, plotR = W - 20, plotT = 30, plotB = H - 44;
      const xF = (i) => plotL + (i / (np - 1)) * (plotR - plotL);
      const yF = (v) => plotB - v * (plotB - plotT);            // v in 0..1
      let svg = '<svg viewBox="0 0 ' + W + ' ' + H + '" class="w-full h-auto" style="min-width:640px" xmlns="http://www.w3.org/2000/svg">';
      svg += '<line x1="' + plotL + '" y1="' + plotT + '" x2="' + plotL + '" y2="' + plotB + '" stroke="#cbd5e1"/>';
      svg += '<line x1="' + plotL + '" y1="' + plotB + '" x2="' + plotR + '" y2="' + plotB + '" stroke="#cbd5e1"/>';
      svg += '<text x="' + plotL + '" y="' + (plotT - 12) + '" font-size="10" fill="#94a3b8">Prevalence / outcome rate</text>';
      svg += '<text x="' + plotR + '" y="' + (plotB + 30) + '" text-anchor="end" font-size="10" fill="#94a3b8">Calendar period (' + esc(s.period || "yearly") + ') →</text>';
      // exposure prevalence: rising S-curve
      let prev = "";
      for (let i = 0; i < np; i++) { const t = i / (np - 1); const v = 0.12 + 0.72 / (1 + Math.exp(-8 * (t - 0.5))); prev += (i ? " L" : "M") + xF(i) + " " + yF(v); }
      svg += '<path d="' + prev + '" fill="none" stroke="#6366f1" stroke-width="3"/>';
      svg += '<text x="' + xF(np - 1) + '" y="' + (yF(0.86) - 6) + '" text-anchor="end" font-size="9.5" fill="#6366f1" font-weight="600">exposure prevalence</text>';
      // outcome trends per CPE stratum: higher stratum tracks prevalence more steeply (if causal)
      for (let k = 0; k < ns; k++) {
        const slope = 0.05 + 0.30 * (k / (ns - 1));            // higher CPE → steeper outcome trend
        const col = k === ns - 1 ? "#dc2626" : (k === 0 ? "#94a3b8" : "#f59e0b");
        let path = "";
        for (let i = 0; i < np; i++) { const t = i / (np - 1); const base = 0.20 + 0.02 * k; const v = base + slope * (0.12 + 0.72 / (1 + Math.exp(-8 * (t - 0.5)))); path += (i ? " L" : "M") + xF(i) + " " + yF(v); }
        svg += '<path d="' + path + '" fill="none" stroke="' + col + '" stroke-width="' + (k === ns - 1 || k === 0 ? 2.25 : 1.5) + '" stroke-opacity="0.9"/>';
      }
      // draggable right-end handle → number of periods
      svg += '<circle cx="' + xF(np - 1) + '" cy="' + plotB + '" r="5" fill="#fff" stroke="#6366f1" stroke-width="2" class="tit-handle" data-field="nperiods" style="cursor:ew-resize;touch-action:none"/>';
      const diag = document.getElementById("diagram");
      diag.innerHTML = svg + "</svg>";
      document.getElementById("dlegend").innerHTML =
        '<span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-0.5" style="background:#6366f1"></span>Exposure prevalence trend</span>' +
        '<span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-0.5" style="background:#dc2626"></span>Outcome trend, high-CPE stratum (steep rise in exposure)</span>' +
        '<span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-0.5" style="background:#94a3b8"></span>Outcome trend, low-CPE stratum (flat exposure)</span>';
      document.getElementById("dcap").textContent =
        "As exposure prevalence rises across " + s.nperiods + " " + s.period + " period(s), the outcome trend is compared across " + s.nstrata + " strata of the cumulative probability of exposure. A steeper outcome trend where exposure rose faster is what identifies a causal effect. Drag the ○ handle to change the number of periods. Schematic only — the shapes are illustrative, not your data" +
        (parseInt(s.nperiods) > 24 ? ", and the drawing shows the first 24 periods" : "") +
        (parseInt(s.nstrata) > 6 ? ", and only 6 of the strata are drawn" : "") + ".";

      // drag (frozen px/period)
      const svgXof = (clientX) => { const el = diag.querySelector("svg"); if (!el || !el.getScreenCTM) return null; const pt = el.createSVGPoint(); pt.x = clientX; pt.y = 0; const ctm = el.getScreenCTM(); if (!ctm) return null; return pt.matrixTransform(ctm.inverse()).x; };
      const pxPer = (plotR - plotL) / Math.max(1, np - 1);
      diag.querySelectorAll(".tit-handle").forEach((h) => {
        h.addEventListener("pointerdown", (ev) => {
          ev.preventDefault(); ev.stopPropagation();
          if (window.__diagDrag) window.__diagDrag.cleanup();
          const startVal = Math.max(3, parseInt(form.elements.nperiods.value) || 10);
          const pid = ev.pointerId, x0 = svgXof(ev.clientX);
          try { diag.setPointerCapture(pid); } catch (e) {}
          let pending = null, raf = 0;
          const apply = () => { raf = 0; if (pending == null) return; form.elements.nperiods.value = pending; render(); };
          const move = (e) => { if (e.pointerId !== pid) return; const x = svgXof(e.clientX); if (x == null || x0 == null) return; pending = Math.max(3, Math.min(24, startVal + Math.round((x - x0) / pxPer))); if (!raf) raf = requestAnimationFrame(apply); };
          const end = (e) => { if (e && e.pointerId != null && e.pointerId !== pid) return; document.removeEventListener("pointermove", move); document.removeEventListener("pointerup", end); document.removeEventListener("pointercancel", end); if (raf) { cancelAnimationFrame(raf); raf = 0; } apply(); try { diag.releasePointerCapture(pid); } catch (e2) {} window.__diagDrag = null; };
          window.__diagDrag = { cleanup: end };
          document.addEventListener("pointermove", move); document.addEventListener("pointerup", end); document.addEventListener("pointercancel", end);
        });
      });
    }

    const render = () => {
      const s = readForm();
      preview.textContent = buildMarkdown(s);
      // A throw in here used to abort the rest of render(): the checks panel
      // froze on the previous design while the protocol text moved on (so the
      // two disagreed on screen, with the stale one showing a red error), and
      // the autosave below never ran even though the page promises
      // "Auto-saved to this browser". The diagram is the least important thing
      // here; it must not be able to take the checks and the draft down with it.
      try { renderScheme(s); }
      catch (err) {
        console.error("[TIT] study-design diagram failed to render", err);
        const el = document.getElementById("diagram");
        if (el) el.innerHTML = '<p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">The design diagram could not be drawn. It is blank because of an error, not because there is nothing to show &mdash; details are in the browser console. The protocol text and the consistency checks are unaffected.</p>';
      }
      // Never swallow a render failure silently: a blank checks panel that looks
      // like "no issues" is exactly the failure mode this page is meant to avoid.
      try { window.renderChecks(document.getElementById("checks"), computeChecks(s)); }
      catch (err) {
        console.error("[TIT] consistency checks failed to render", err);
        const el = document.getElementById("checks");
        if (el) el.innerHTML = '<div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">The consistency checks could not be rendered, so this panel is showing nothing rather than showing "no issues". Details are in the browser console.</div>';
      }
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch (err) { console.warn("[TIT] could not save draft", err); }
    };

    (() => {
      try {
        // A ?seed= link wins over the saved draft; PC.restore falls back to
        // localStorage on its own and tells the user which one it used.
        const seeded = (window.PC && PC.restore)
          ? PC.restore(form, STORAGE_KEY, (s) => { noteStale(s); PC.applySeed(form, s); }) === "seed"
          : false;
        const saved = seeded ? null : JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");
        if (saved) {
          noteStale(saved);
          for (const k in saved) {
            const els = form.elements[k]; if (!els) continue;
            const val = saved[k];
            if (Array.isArray(val)) form.querySelectorAll('[name="' + k + '"]').forEach((n) => { n.checked = val.includes(n.value); });
            else if (els.type === "checkbox") els.checked = !!val;
            else els.value = val;
          }
        }
