            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Inclusion criteria (one per line)</span>
              <textarea name="inclusionCriteria" rows="2" placeholder="Continuous enrolment ≥365 d before observation start&#10;Age ≥18 at observation start" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Exclusion criteria (one per line)</span>
              <textarea name="exclusionCriteria" rows="2" placeholder="Pregnant at observation start (where measurable)&#10;Cancer diagnosis at observation start (for non-cancer cohorts)" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Index date / observation-start rule</span>
              <input type="text" name="indexDateRule" value="Later of (a) study calendar start, (b) database enrolment + 365 d washout, (c) eligibility age threshold" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Study calendar period</span>
              <input type="text" name="studyCalendar" placeholder="e.g., 2010-01-01 to 2023-12-31" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">5 · Numerator phenotypes</summary>
          <div class="px-5 pb-5 space-y-3">
            <p class="text-xs text-slate-500">What you are counting in the numerator. Pick from each library as relevant; drug exposures for utilisation metrics, outcomes for incidence / prevalence, mortality causes for cause-specific mortality. Free-text fields below for codes not in the libraries.</p>
            <div class="grid sm:grid-cols-3 gap-2">
              <button type="button" data-open-library data-category="exposures" data-target-name="exposureName" data-target-codes="exposureCodes" class="text-[10px] uppercase tracking-widest font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 px-2 py-1 rounded transition">📚 Pick exposure</button>
              <button type="button" data-open-library data-category="outcomes" data-target-name="outcomeName" data-target-codes="outcomeCodes" data-target-def="outcomeDef" class="text-[10px] uppercase tracking-widest font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 px-2 py-1 rounded transition">📚 Pick outcome</button>
              <button type="button" data-open-library data-category="mortalityCauses" data-target-name="mortCauseName" data-target-codes="mortCauseCodes" class="text-[10px] uppercase tracking-widest font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 px-2 py-1 rounded transition">📚 Pick cause of death</button>
            </div>
            <div class="grid sm:grid-cols-2 gap-3 pt-2">
              <label class="flex flex-col gap-1">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Drug exposure; name</span>
                <input type="text" name="exposureName" placeholder="Anticonvulsants" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
              </label>
              <label class="flex flex-col gap-1">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Drug exposure; code set</span>
                <input type="text" name="exposureCodes" placeholder="ATC N03A*" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
              </label>
              <label class="flex flex-col gap-1">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Outcome; name</span>
                <input type="text" name="outcomeName" placeholder="Incident dementia" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
              </label>
              <label class="flex flex-col gap-1">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Outcome; code set</span>
                <input type="text" name="outcomeCodes" placeholder="ICD-10 F00.*–F03, G30.*" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
              </label>
              <label class="flex flex-col gap-1 sm:col-span-2">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Outcome; operational definition</span>
                <textarea name="outcomeDef" rows="2" placeholder="First record (inpatient or outpatient) of qualifying ICD-10 code during the observation period." class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
              </label>
              <label class="flex flex-col gap-1">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Cause of death; name</span>
                <input type="text" name="mortCauseName" placeholder="Cardiovascular death" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
              </label>
              <label class="flex flex-col gap-1">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Cause of death; code set</span>
                <input type="text" name="mortCauseCodes" placeholder="ICD-10 I00–I99 underlying cause" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
              </label>
            </div>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">6 · Output metrics; what to report</summary>
          <div class="px-5 pb-5 space-y-4">
            <p class="text-xs text-slate-500">Tick every metric to report. Each ticked metric gets its own section in the protocol output (Markdown + Word), with operational definition, formula, and unit. Mix-and-match freely; most descriptive multi-database papers report 3-6 metrics.</p>
            {(["Occurrence", "Mortality", "Utilisation", "Adjustment", "Trends"] as const).map((group) => (
              <div>
                <p class="text-[11px] uppercase tracking-widest text-slate-600 font-bold">{group}</p>
                <div class="mt-1 grid sm:grid-cols-2 gap-1.5">
                  {OUTPUT_METRICS.filter((m) => m.group === group).map((m, i) => (
                    <label class="flex items-start gap-2 text-xs border border-slate-200 rounded px-3 py-2 hover:bg-slate-50 cursor-pointer">
                      <input type="checkbox" name="metricsPick" value={m.id}
                        checked={["incidence","ddd","initiation"].includes(m.id)}
                        class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                      <span class="flex-1">
                        <span class="font-semibold text-slate-800">{m.label}</span>
                        <span class="block text-[10px] text-slate-500 mt-0.5">{m.hint}</span>
                        <span class="block text-[10px] text-slate-400 font-mono">{m.unit}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">7 · Stratification</summary>
          <div class="px-5 pb-5 space-y-3">
            <p class="text-xs text-slate-500">Report each ticked metric stratified by these variables (in addition to overall).</p>
            <div class="grid sm:grid-cols-2 gap-1.5">
              {STRATIFICATION.map((s, i) => (
                <label class="flex items-start gap-2 text-xs border border-slate-200 rounded px-3 py-2 hover:bg-slate-50 cursor-pointer">
                  <input type="checkbox" name="strataPick" value={s} checked={[0,3,4,5].includes(i)} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{s}</span>
                </label>
              ))}
            </div>
            <label class="flex flex-col gap-1">
              <span class="text-[11px] uppercase tracking-widest text-slate-500 font-semibold">Custom strata (one per line)</span>
              <textarea name="strataCustom" rows="2" class="w-full border border-slate-300 rounded px-3 py-2 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">8 · Age-standardisation
            <span class="ml-2 text-[10px] font-normal text-slate-500 normal-case tracking-normal">(active when "Age-standardised rates" is ticked above)</span>
          </summary>
          <div class="px-5 pb-5 grid sm:grid-cols-2 gap-3">
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Reference population</span>
              <select name="ageStdRef" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="who2000" selected>WHO World Standard 2000</option>
                <option value="esp2013">European Standard Population 2013</option>
                <option value="segi1960">Segi 1960</option>
                <option value="internal">Internal-pooled (sum across the selected sites)</option>
              </select>
              <span class="text-[11px] text-slate-500">WHO 2000 is the most common for cross-country comparisons; ESP 2013 is preferred in European contexts.</span>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Method</span>
              <select name="ageStdMethod" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="direct" selected>Direct (apply site age-specific rates to reference structure)</option>
                <option value="indirect">Indirect (Standardised Mortality / Incidence Ratio; SMR / SIR)</option>
                <option value="both">Both direct and indirect</option>
              </select>
            </label>
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Age bands for standardisation</span>
              <input type="text" name="ageStdBands" value="5-year bands from 0–4 through 85+" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">9 · Joinpoint / trend analysis
            <span class="ml-2 text-[10px] font-normal text-slate-500 normal-case tracking-normal">(active when "Joinpoint trend" is ticked)</span>
          </summary>
          <div class="px-5 pb-5 grid sm:grid-cols-2 gap-3">
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Trend year range</span>
              <input type="text" name="trendYears" placeholder="2010–2023" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Max joinpoints</span>
              <select name="trendMaxJp" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="2">2 (3 segments)</option>
                <option value="3" selected>3 (4 segments)</option>
                <option value="4">4 (5 segments)</option>
              </select>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Joinpoint fitting and selection</span>
              <select name="trendMethod" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="grid" selected>Grid search over candidate joinpoints, number chosen by the software's default rule</option>
                <option value="permutation">Permutation test for the number of joinpoints (Kim 2000)</option>
              </select>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Report</span>
              <select name="trendReport" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="apc-aapc" selected>Annual percent change (APC) per segment + average APC (AAPC)</option>
                <option value="apc">APC per segment only</option>
                <option value="aapc">AAPC only</option>
              </select>
            </label>
            <p class="sm:col-span-2 text-[11px] text-slate-500 leading-relaxed bg-amber-50 border border-amber-200 rounded p-2">
              <strong>These are two stages, not two alternatives.</strong> A grid search <em>locates</em> candidate joinpoints; a separate rule then decides <em>how many</em> there are, and the two are used together — Kim HJ et al (Stat Med 2000) do exactly that. This control previously offered "Grid search" labelled as the NCI Joinpoint Regression Program's default, which it has never been: that program's default rule for choosing the number of joinpoints was the permutation test through v4.9 and is a weighted BIC from v5.0. Whichever you pick, <strong>name the software and version in the protocol</strong> — "the software default" is not a fixed specification.
            </p>
            <p class="sm:col-span-2 text-[11px] text-slate-500 leading-relaxed bg-slate-50 border border-slate-200 rounded p-2">
              <strong>Trend-in-trend</strong> (Ji X, Small DS, Leonard CE, Hennessy S. <em>Epidemiology</em> 2017;28(4):529-536) is not a descriptive metric — it is a causal design. It stratifies the population by each person's <em>predicted probability of exposure</em> (the cumulative probability of exposure, CPE) from a stage-1 logistic model, then compares outcome trends across those strata. If you tick it in Section 6 the protocol carries a methods stub only; use the
              <a class="underline font-semibold" href={`${base}/tools/trend-in-trend/`}>dedicated trend-in-trend builder</a> if it is your central analytic question.
            </p>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">10 · Statistical analysis</summary>
          <div class="px-5 pb-5 grid sm:grid-cols-2 gap-3">
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Rate / proportion confidence intervals</span>
              <select name="ciMethod" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="poisson-exact" selected>Exact Poisson (rates) / Wilson score (proportions)</option>
                <option value="normal">Normal approximation (large counts only)</option>
                <option value="bootstrap">Non-parametric bootstrap</option>
              </select>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Cross-site comparison</span>
              <select name="metaMethod" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="descriptive" selected>Descriptive only; side-by-side tables, ranked figures</option>
                <option value="re">Random-effects pooled estimate (DerSimonian-Laird)</option>
                <option value="re-reml">Random-effects (REML)</option>
              </select>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Site contribution</span>
              <select name="contribution" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="aggregate" selected>Site-level aggregate (counts + person-time) only</option>
                <option value="anonymised">De-identified record-level subset</option>
                <option value="full">Centralised pooled individual data (DUA permits)</option>
              </select>
            </label>
            <label class="flex flex-col gap-1 sm:col-span-2">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Suppression / small-cell rule</span>
              <input type="text" name="suppression" value="Suppress cells with <5 events; report counts as '<5' in published tables" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">11 · Sensitivity analyses</summary>
          <div class="px-5 pb-5 space-y-3">
            <div class="grid sm:grid-cols-2 gap-1.5">
              {SENSITIVITY.map((s, i) => (
                <label class="flex items-start gap-2 text-xs border border-slate-200 rounded px-3 py-2 hover:bg-slate-50 cursor-pointer">
                  <input type="checkbox" name="sensitivityPick" value={s} checked={i < 4} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{s}</span>
                </label>
              ))}
            </div>
            <label class="flex flex-col gap-1">
              <span class="text-[11px] uppercase tracking-widest text-slate-500 font-semibold">Custom sensitivity analyses (one per line)</span>
              <textarea name="sensitivityCustom" rows="2" class="w-full border border-slate-300 rounded px-3 py-2 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
            </label>
          </div>
        </details>

        <details open class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">12 · Execution &amp; timeline</summary>
          <div class="px-5 pb-5 space-y-3">
            <div class="grid sm:grid-cols-2 gap-3">
              <label class="flex flex-col gap-1">
                <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Architecture</span>
                <select name="arch" class="border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                  <option value="federated" selected>Federated (each site runs locally, shares aggregate)</option>
                  <option value="cdm">Common Data Model</option>
                  <option value="centralised">Centralised (DUA permits)</option>
                </select>
              </label>
            </div>
            <div>
              <p class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Timeline preset</p>
              <div class="mt-2 flex gap-2 flex-wrap">
                <button type="button" data-timeline-preset="12-month" class="text-xs border border-brand-300 text-brand-700 hover:bg-brand-50 font-semibold px-3 py-1.5 rounded transition">Use 12-month plan</button>
                <button type="button" data-timeline-preset="18-month" class="text-xs border border-brand-300 text-brand-700 hover:bg-brand-50 font-semibold px-3 py-1.5 rounded transition">Use 18-month plan</button>
              </div>
              <label class="flex flex-col gap-1 mt-3">
                <span class="text-[11px] uppercase tracking-widest text-slate-500 font-semibold">Milestones (one per line)</span>
                <textarea name="timeline" rows="6" class="w-full border border-slate-300 rounded px-3 py-2 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
              </label>
            </div>
          </div>
        </details>

        <details class="border border-slate-200 rounded-2xl bg-white shadow-sm">
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-slate-900 hover:bg-slate-50 rounded-2xl">13 · Ethics, dissemination, references (optional)</summary>
          <div class="px-5 pb-5 space-y-3">
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Ethics</span>
              <textarea name="ethics" rows="2" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">Each participating site obtains local IRB / ethics approval before data extraction. Under a federated design only aggregate site-level estimates are shared with the coordinating centre.</textarea>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Dissemination</span>
              <textarea name="dissemination" rows="2" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">Primary manuscript to a peer-reviewed pharmacoepidemiology / public-health journal; presentation at ICPE / ISPE Asian conference.</textarea>
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Key references (one per line)</span>
              <textarea name="references" rows="8" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">Lai ECC, Stang P, Yang YHK, Kubota K, Wong ICK, Setoguchi S. International multi-database pharmacoepidemiology: potentials and pitfalls. Curr Epidemiol Rep 2015;2(4):229-238. doi:10.1007/s40471-015-0059-z
Lai EC, Man KK, Chaiyakunapruk N, et al. Brief report: databases in the Asia-Pacific region: the potential for a distributed network approach. Epidemiology 2015;26(6):815-820. doi:10.1097/EDE.0000000000000325 (PMID 26133022)
Kim HJ, Fay MP, Feuer EJ, Midthune DN. Permutation tests for joinpoint regression with applications to cancer rates. Stat Med 2000;19(3):335-351. doi:10.1002/(SICI)1097-0258(20000215)19:3&lt;335::AID-SIM336&gt;3.0.CO;2-Z
Ji X, Small DS, Leonard CE, Hennessy S. The Trend-in-trend research design for causal inference. Epidemiology 2017;28(4):529-536. doi:10.1097/EDE.0000000000000579
Wagner AK, Soumerai SB, Zhang F, Ross-Degnan D. Segmented regression analysis of interrupted time-series studies in medication use research. J Clin Pharm Ther 2002;27(4):299-309. doi:10.1046/j.1365-2710.2002.00430.x
WHO. Age-standardisation of rates: a new WHO standard. GPE Discussion Paper 31, 2001 (Ahmad OB et al).
Lee H, Baek YH, Kim JH, Liao TC, Lau WCY, Man KKC, et al. Trends of polypharmacy among older people in Asia, Australia and the United Kingdom: a multinational population-based study. Age Ageing 2023;52(2):afad014. doi:10.1093/ageing/afad014 (PMID 36821644)
Hsieh CY, Su CC, Shao SC, Sung SF, Lin SJ, Kao Yang YH, Lai EC. Taiwan's NHIRD: past and future. Clin Epidemiol 2019;11:349-58.
Shao SC, Chan YY, Kao Yang YH, Lin SJ, Hung MJ, Chien RN, Lai CC, Lai EC. The Chang Gung Research Database. Pharmacoepidemiol Drug Saf 2019;28(5):593-600.</textarea>
            </label>
          </div>
        </details>

        <div class="flex flex-wrap gap-3 pt-2 items-center">
          <button type="button" data-action="download-docx" class="bg-white border border-brand-700 text-brand-700 hover:bg-brand-50 font-semibold px-5 py-2.5 rounded-lg transition text-sm">⬇ Download Word (.docx)</button>
          <button type="button" data-action="download-md" class="text-brand-700 hover:underline font-semibold text-sm">⬇ Markdown</button>
          <button type="button" data-action="download-strobe" class="text-brand-700 hover:underline font-semibold text-sm" title="Generate the STROBE reporting checklist (von Elm 2007; strobe-statement.org) as a Word document, pre-filled from your protocol fields.">⬇ STROBE checklist</button>
          <button type="button" data-action="copy" class="text-brand-700 hover:underline font-semibold text-sm">📋 Copy</button>
          <button type="button" data-action="reset" class="ml-auto text-slate-500 hover:text-rose-600 hover:underline text-sm font-semibold">Clear all</button>
          <p data-action-msg class="basis-full text-xs"></p>
        </div>
      </form>

      <aside class="lg:sticky lg:top-20">
        <div class="border border-slate-200 rounded-2xl bg-slate-50 shadow-sm overflow-hidden">
          <header class="flex items-center justify-between px-4 py-2 bg-white border-b border-slate-200">
            <p class="text-xs uppercase tracking-widest text-brand-700 font-bold">Live preview</p>
            <p class="text-[10px] text-slate-500">Auto-saved to this browser</p>
          </header>
          <pre data-preview class="text-xs leading-relaxed text-slate-800 p-4 overflow-auto max-h-[calc(100vh-12rem)] whitespace-pre-wrap font-mono"></pre>
        </div>
      </aside>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-base font-bold text-slate-900">Consistency checks <span class="text-xs font-normal text-slate-400">· descriptive 防呆</span></h2>
      <p class="mt-1 text-xs text-slate-500">A descriptive study fails quietly: the numerator and the denominator get counted over different people, and the rate that comes out looks perfectly reasonable. These checks look for that.</p>
      <div id="checks" class="mt-3 space-y-1.5"></div>
    </div>

    <!-- Study design diagram -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">Study design diagram</h2>
      <p class="mt-1 text-xs text-slate-500">Descriptive designs aggregate over the calendar study period; this per-person schematic shows the baseline look-back and the person-time / measurement window relative to cohort entry.</p>
      <div class="mt-4 overflow-x-auto"><div id="diagram"></div></div>
      <div id="dlegend" class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-slate-600"></div>
    </div>
    <DesignDiagram />
    <ProtocolCommon />

    <!-- Phenotype library modal -->
    <div data-library-modal class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-start justify-center p-4 sm:p-8 overflow-y-auto">
      <div class="bg-white border border-slate-200 rounded-2xl shadow-2xl w-full max-w-3xl my-8">
        <header class="flex items-center justify-between gap-3 px-5 py-4 border-b border-slate-100">
          <div>
            <p class="text-xs uppercase tracking-widest text-brand-700 font-bold">Validated phenotype library</p>
            <h3 class="text-lg font-bold text-slate-900 mt-0.5" data-library-title>Pick a phenotype</h3>
          </div>
          <button type="button" data-library-close class="text-slate-400 hover:text-slate-700 text-2xl leading-none">×</button>
        </header>
        <div class="px-5 py-3 border-b border-slate-100">
          <input type="text" data-library-search placeholder="Filter…" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
        </div>
        <div data-library-list class="px-2 py-2 max-h-[60vh] overflow-y-auto"></div>
      </div>
    </div>
  </section>

  <script src="https://unpkg.com/docx@8.5.0/build/index.umd.js" is:inline></script>

  <script is:inline define:vars={{ BASE: base, SITES_DETAIL_MAP, FEATURES, PHENOTYPES, OUTPUT_METRICS, TIMELINE_PRESETS, STROBE_ITEMS }}>
    (() => {
      const setState = (name) => {
        document.querySelectorAll("[data-state]").forEach((el) => {
          el.classList.toggle("hidden", el.dataset.state !== name);
        });
      };

      const STORAGE_KEY = "aspen.protocol-builder.desc";
      const STORAGE_CITATIONS_KEY = "aspen.protocol-builder.desc.citations";
      const form = document.querySelector("[data-builder]");
      const preview = document.querySelector("[data-preview]");
      // Set by buildDocx when the figure could not be made, so the download
      // handler can tell the user which of the two documents they got.
      let lastFigNote = "";
      const actionMsg = document.querySelector("[data-action-msg]");
      const setMsg = (msg, isError = false) => {
        if (!actionMsg) return;
        actionMsg.textContent = msg;
        actionMsg.classList.toggle("text-rose-700", isError);
        actionMsg.classList.toggle("text-brand-700", !isError);
      };

      let pickedCitations = {};
      try { pickedCitations = JSON.parse(localStorage.getItem(STORAGE_CITATIONS_KEY) || "{}") || {}; } catch {}
      const savePickedCitations = () => { try { localStorage.setItem(STORAGE_CITATIONS_KEY, JSON.stringify(pickedCitations)); } catch {} };

      const formatSiteFull = (id) => {
        const d = SITES_DETAIL_MAP[id];
        if (!d) return id;
        const feats = (d.features || []).map((f) => (FEATURES.find((x) => x.id === f) || {}).short || f).join(" ");
        return d.country + " · " + d.short + (feats ? " [" + feats + "]" : "");
      };

      // ── Feasibility detection ───────────────────────────────
      // Permissive regex: scan user-typed text for cues that imply a site
      // feature beyond Rx + Dx. We also check ticked metrics directly
      // (mortAll / mortCause / etc. force the mortality feature).
      // Each alternative carries its own word boundaries, deliberately, and most
      // of them are STEMS with no trailing boundary: "carcinom" has to match
      // "carcinoma", "pregnan" has to match "pregnancy". The earlier version
      // wrapped each whole alternation in \b( … )\b, which made the trailing
      // boundary mandatory and so killed every stem in the file — "carcinoma",
      // "pregnancy", "pregnant", "gestational", "radiology", "echocardiogram",
      // "genomics", "tumours", "deaths" and "leukaemia" all matched nothing,
      // and the panel stayed hidden, which reads on screen as "no gaps".
      // (`labs` was the one group written without the trailing \b, and it is
      // the one group that behaved as intended; the rest now match it.)
      // Short ambiguous tokens — smr, sir, mri, inr, tsh, lab — keep boundaries
      // on both sides on purpose, or they match inside longer words.
      const FEATURE_TRIGGERS = {
        labs:      /\bhba1c|\begfr|\bcreatinine|\bbmi\b|\bblood\s*pressure|\bsystolic|\bdiastolic|\bldl\b|\bhdl\b|\bcholesterol|\bglucose|\balbumin|\bh[ae]?emoglobin|\binr\b|\btsh\b|\blipid|\bbiochemi|\blabora?tor[yi]|\blabs?\b/i,
        mortality: /\bmortality|\ball-?cause\s+death|\bcv\s+death|\bcardiovascular\s+death|\bcause[\s-]of[\s-]death|\bdied\b|\bfatal|\bdeath|\bsurvival|\bsmr\b|\bsir\b/i,
        cancer:    /\bcancer|\bcarcinom|\bmalignan|\bneoplas|\btumou?r|\bsarcoma|\bleuk[ae]?[ae]mia|\blymphom|\bmyeloma|\boncolog|\bsir\b/i,
        pregnancy: /\bpregnan|\bbirth|\bneonat|\bgestation|\btrimester|\bmaternal|\bfo?etal|\binfant|\bmother/i,
        // "angio" on its own matched nothing while the trailing \b was in force,
        // and matches "angiotensin" — an entire drug class — without it, so the
        // imaging cue is the narrower "angiograph".
        imaging:   /\bimaging|\bmri\b|\bct\s*scan|\bx-?ray|\bultrasound|\bechocardio|\bangiograph|\bradiolog/i,
        genomics:  /\bgenomic|\bsnp\b|\bgwas\b|\bbiobank|\bgenotyp|\bexome|\bgene\b|\bgenetic/i,
      };
      const FEATURE_TEXT_FIELDS = [
        "populationName","populationDef","populationCodes",
        "inclusionCriteria","exclusionCriteria",
        "exposureName","exposureCodes",
        "outcomeName","outcomeCodes","outcomeDef",
        "mortCauseName","mortCauseCodes",
        "picoP","picoMeasure",
        "strataCustom","sensitivityCustom",
      ];
      const FEATURE_MULTI_FIELDS = ["strataPick","sensitivityPick","metricsPick"];

      const computeRequiredFeatures = (state) => {
        let blob = "";
        for (const f of FEATURE_TEXT_FIELDS) blob += " " + (state[f] || "");
        for (const f of FEATURE_MULTI_FIELDS) blob += " " + ((state[f] || []).join(" "));
        const req = new Set(["rx","dx"]);    // descriptive analyses usually start from Rx + Dx
        // Mortality is forced if any mortality metric ticked, regardless of free text.
        if ((state.metricsPick || []).includes("mortAll"))  req.add("mortality");
        if ((state.metricsPick || []).includes("mortCause")) req.add("mortality");
        for (const [feat, rx] of Object.entries(FEATURE_TRIGGERS)) {
          if (rx.test(blob)) req.add(feat);
        }
        return req;
      };

      // The gap analysis, separated from its rendering so it can travel. It used
      // to exist only inside renderFeasibility, i.e. only in an amber box in a
      // browser tab: a protocol could name three databases with no mortality
      // linkage under "Numerator: all-cause deaths in cohort (mortality-linked
      // records)" and the exported document — the artefact a site actually
      // receives and executes — carried no trace of the objection, while the
      // STROBE checklist claimed the gap had been reported.
      const featureGaps = (state) => {
        const required = computeRequiredFeatures(state);
        const selected = state.sites || [];
        const gaps = [];
        if (selected.length === 0) return gaps;
        for (const featId of required) {
          if (featId === "rx" || featId === "dx") continue;
          const featLabel = (FEATURES.find((f) => f.id === featId) || {}).label || featId;
          const missing = [];
          const have    = [];
          for (const sid of selected) {
            const d = SITES_DETAIL_MAP[sid];
            if (!d) continue;
            (d.features.includes(featId) ? have : missing).push(d.short);
          }
          if (missing.length > 0) gaps.push({ id: featId, feature: featLabel, missing, have });
        }
        return gaps;
      };
      const gapLine = (g) => g.feature + " — not available at: " + g.missing.join(", ") +
        (g.have.length ? ". Available at: " + g.have.join(", ") + "." : ". Available at none of the selected sites.");

      const renderFeasibility = (state) => {
        const panel  = document.querySelector("[data-feasibility]");
        const list   = document.querySelector("[data-feasibility-list]");
        if (!panel || !list) return;
        const gaps = featureGaps(state);
        if (gaps.length === 0) { panel.classList.add("hidden"); return; }
        list.innerHTML = gaps.map((g) =>
          `<li><strong>${g.feature}</strong>; implied by your study text / chosen metrics. Missing at: <strong>${g.missing.join(", ")}</strong>` +
          (g.have.length > 0 ? `. Available at: ${g.have.join(", ")}.` : `.`) + `</li>`
        ).join("");
        panel.classList.remove("hidden");
      };

      // ── Form state read / write ─────────────────────
      const readForm = () => {
        const data = new FormData(form);
        const out = {};
        const multi = new Set(["sites", "metricsPick", "strataPick", "sensitivityPick"]);
        for (const k of multi) out[k] = [];
        for (const [k, v] of data.entries()) {
          if (multi.has(k)) out[k].push(String(v));
          else out[k] = String(v);
        }
        return out;
      };
      const writeForm = (state) => {
        const multi = new Set(["sites", "metricsPick", "strataPick", "sensitivityPick"]);
        staleSelects = [];
        for (const el of form.querySelectorAll("input, textarea, select")) {
          const name = el.name;
          if (!name) continue;
          if (el.type === "checkbox" && multi.has(name)) el.checked = (state[name] || []).includes(el.value);
          else if (state[name] !== undefined) {
            // A <select> whose stored value is no longer one of its options
            // used to be assigned anyway: el.value = x is a no-op that leaves
            // selectedIndex = -1, so the control showed an empty box and
            // FormData omitted it, and the exports supplied a definite choice
            // of their own. Keep the option the markup declares, and say what
            // was dropped rather than absorbing it silently.
            if (el.tagName === "SELECT" && ![...el.options].some((o) => o.value === state[name])) {
              staleSelects.push({
                name,
                value: String(state[name]),
                label: (el.closest("label")?.querySelector("span")?.textContent || name).trim(),
                kept: el.value,
              });
              continue;
            }
            el.value = state[name];
          }
        }
      };
      const mergeList = (picks, customText) => {
        const lines = (customText || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        return [...(picks || []), ...lines];
      };
      const bullets = (arr) => arr.length === 0 ? "_(none specified)_" : arr.map((l) => "- " + l).join("\n");
      const numbered = (arr) => arr.length === 0 ? "_(none)_" : arr.map((l, i) => (i + 1) + ". " + l).join("\n");
      const orFb = (s, fb) => (s && s.trim()) ? s : fb;
      // Every cell of every Markdown table below interpolates user text, and a
      // pipe in that text opens a new column. "Dementia | any cause" in the
      // outcome name emitted a three-cell row against a two-column header, so
      // the rendered table showed "Dementia" against the label and dropped
      // "any cause"; an ICD list written "F00-F03 | G30" did the same to the
      // code set, and the metric tables embed those same strings again. Pipes
      // are escaped on the way into a cell — same rule the amendments log and
      // RWE Studio's Table 1 already follow.
      const td = (v) => String(v ?? "").replace(/\|/g, "\\|").replace(/\r?\n/g, " ");
      // A <select> restored from a stale draft or a ?seed= link with a value
      // that is no longer one of its options is left at selectedIndex = -1: it
      // shows nothing, contributes nothing to FormData, and every `|| "…"`
      // fallback in the exports then supplied a specific, definite choice the
      // user never made — a protocol asserting "Exact Poisson / Wilson" beside a
      // blank dropdown. Name it as unset instead, and say what the dead value was.
      const UNSET = (what) => "NOT SET — " + what + " has no value. Choose one before this protocol is circulated.";
      // The same rule for free-text boxes. Every one of these used to export a
      // plausible, unmarked specification for a field the user had left empty:
      // an untouched Section 9 exported "Time-series of 2010-2023" — a specific
      // fourteen-year series — while the checks panel simultaneously said the
      // trend year range was not given, and a cleared suppression box exported
      // "Suppress cells with <5 events" under a panel saying no suppression rule
      // was set. A governance reviewer then approves a rule the protocol has not
      // got. Blank exports as blank, and says which field it was.
      const NOTSET = (what) => "(not specified — " + what + ")";
      // Which selects a restored draft left with nothing selected, so the checks
      // panel can say so by name. `writeForm` assigns el.value with no
      // membership check; an unmatched value leaves selectedIndex = -1, the
      // control shows an empty box that reads as merely unremarkable, and
      // FormData omits it entirely — so the dead value is not recoverable from
      // the state object and has to be captured at the moment of restore.
      let staleSelects = [];
      // ONE map per <select>, consumed by the preview, the Markdown, the Word
      // protocol and the STROBE checklist. They were four pairs of copy-pasted
      // lookups with drifting wording, which is the defect this repo keeps
      // paying for; `auditSelectMaps` below asserts at load that each map's keys
      // are exactly the option values the form offers, so a new option cannot be
      // added to the markup and silently fall through to a fallback.
      const SELECT_TXT = {
        metaMethod: {
          descriptive: "Descriptive only; side-by-side tables and ranked figures; no pooled estimate.",
          re: "Random-effects (DerSimonian–Laird) pooled estimates across sites; report I² and τ². Forest plot.",
          "re-reml": "Random-effects (REML) pooled estimates across sites; report I² and τ². Forest plot.",
        },
        arch: {
          federated: "Federated; each site executes the common analytic package locally and shares aggregate counts + person-time only.",
          cdm: "Common Data Model; each site transforms data into an agreed CDM, runs the shared package.",
          centralised: "Centralised; site-level individual data pooled under DUA.",
        },
        ciMethod: {
          "poisson-exact": "Exact Poisson (rates) and Wilson score (proportions); preferred for sparse cells.",
          "normal": "Normal approximation (only valid for cells with ≥10 events).",
          "bootstrap": "Non-parametric bootstrap (1000 resamples).",
        },
        contribution: {
          aggregate: "Site-level aggregate (counts + person-time) only.",
          anonymised: "De-identified record-level subset.",
          full: "Centralised pooled individual data (DUA permits).",
        },
        ageStdRef: {
          who2000: "WHO World Standard 2000",
          esp2013: "European Standard Population 2013",
          segi1960: "Segi 1960",
          internal: "Internal-pooled (sum across the selected sites)",
        },
        ageStdMethod: {
          direct: "Direct: Σ (age-stratum rate × reference proportion); reported with 95% CI by the Dobson method.",
          indirect: "Indirect: standardised mortality / incidence ratio (SMR / SIR) = observed events ÷ events expected from the reference age-specific rates. This is a ratio, not a rate: it is not expressed per 1000 and it is not comparable between populations with different age structures.",
          both: "Direct AND indirect, reported side by side: the direct age-standardised rate (per 1000, with a Dobson 95% CI) and the SMR / SIR (a ratio, observed ÷ expected).",
        },
        trendMaxJp: { "2": "2", "3": "3", "4": "4" },
        trendMethod: {
          grid: "a grid search over candidate joinpoint locations, with the number of joinpoints chosen by the analysis software's default rule — name the software and its version, because that rule is not fixed (the NCI Joinpoint program used a permutation test through v4.9 and a weighted BIC from v5.0)",
          permutation: "a grid search over candidate joinpoint locations, with the number of joinpoints chosen by a permutation test (Kim HJ et al, Stat Med 2000;19(3):335-51)",
        },
        trendReport: { "apc-aapc": "APC per segment + AAPC over the full window", apc: "APC per segment", aapc: "AAPC only" },
      };
      const SELECT_WHAT = {
        metaMethod: "the cross-site comparison method",
        arch: "the execution architecture",
        ciMethod: "the confidence-interval method",
        contribution: "the site contribution model",
        ageStdRef: "the standardisation reference population",
        ageStdMethod: "the standardisation method",
        trendMaxJp: "the maximum number of joinpoints",
        trendMethod: "the segment-fit method",
        trendReport: "the trend reporting choice",
      };
      const pickTxt = (name, val) => SELECT_TXT[name][val] || UNSET(SELECT_WHAT[name]);
      // Short form, for a value that sits inside a sentence rather than in its
      // own table cell.
      const pickInline = (name, val) => SELECT_TXT[name][val] || "(NOT SET: " + SELECT_WHAT[name] + ")";
      // Loud in the console rather than silent: if the markup and the map ever
      // disagree, the export names an analysis different from the one chosen.
      const auditSelectMaps = () => {
        for (const name of Object.keys(SELECT_TXT)) {
          const el = form.querySelector(`select[name="${name}"]`);
          if (!el) { console.error("[DA] no <select> named " + name + " for its text map"); continue; }
          const opts = [...el.options].map((o) => o.value).sort();
          const keys = Object.keys(SELECT_TXT[name]).sort();
          if (opts.join("|") !== keys.join("|"))
            console.error("[DA] " + name + ": the <select> offers [" + opts.join(", ") + "] but the text map has [" + keys.join(", ") + "]");
        }
      };
      const metricLabel = (id) => ((OUTPUT_METRICS.find((m) => m.id === id) || {}).label || id);
      // The one sentence a reviewer reads first. It used to be a constant —
      // "age-standardised rates / proportions with 95% CIs … and pooled across
      // sites" — printed whatever the form said, so the default protocol's
      // abstract claimed age-standardisation that was not ticked and pooling
      // three sections above "Cross-site comparison: Descriptive only … no
      // pooled estimate". It is read from the form now, and where an option is
      // unset it says so rather than naming a plausible one.
      const CI_ABSTRACT = {
        "poisson-exact": "exact Poisson (rates) and Wilson score (proportions) 95% confidence intervals",
        "normal": "normal-approximation 95% confidence intervals",
        "bootstrap": "non-parametric bootstrap 95% confidence intervals",
      };
      const POOL_ABSTRACT = {
        "descriptive": "compared side by side across sites, with no pooled estimate",
        "re": "pooled across sites by random-effects (DerSimonian–Laird) meta-analysis",
        "re-reml": "pooled across sites by random-effects (REML) meta-analysis",
      };
      const analysisSentence = (s) => {
        const ticked = s.metricsPick || [];
        const strata = mergeList(s.strataPick, s.strataCustom);
        // Do not prefix "age-standardised" here: it is one of the metrics, and
        // when it is ticked its own label already appears in the list.
        const what = ticked.length
          ? ticked.map(metricLabel).join(", ")
          : "(no output metric is selected, so this protocol does not yet say what it reports)";
        const byStrata = strata.length ? ", reported overall and by " + strata.join(", ") : ", reported overall (no strata are selected)";
        const ci = CI_ABSTRACT[s.ciMethod] || "confidence intervals whose method has not been set";
        const pool = POOL_ABSTRACT[s.metaMethod] || "cross-site comparison whose method has not been set";
        return what + byStrata + ", with " + ci + ", and " + pool;
      };
      const pcOf = (s) => ({
        design: "multi-national descriptive study",
        tte: false,
        descriptive: true,
        population: orFb(s.picoP, "(population)"),
        exposure: "",
        comparator: "",
        outcome: orFb(s.picoMeasure, "(measure)"),
        data: (s.sites && s.sites.length ? s.sites.length + " data source(s)" : "multi-national data sources"),
        analysis: analysisSentence(s),
        groupBy: "stratum",
        skip: ["ethics"],
        limitations: "They are sensitive to case-ascertainment and denominator definitions, and to differences in coding and capture practice between the contributing databases.",
        // The shared tail already supplies the flow diagram and the Table 1 row;
        // repeating them here printed each of them twice in the planned-outputs
        // list of every export.
        plannedOutputs: ["Rate / trend figures by stratum and site."],
      });
      // What is still blank. A protocol that reads as finished while it does not
      // say who is counted or what is measured is worse than one that says so, so
      // the gap list travels into the preview, the Markdown and the Word file.
      const missing = (s) => [
        [!orFb(s.picoP, ""), "the population"],
        [!orFb(s.picoMeasure, ""), "what is being measured"],
        [!orFb(s.populationDef, ""), "the operational definition of the denominator population"],
        [!(s.sites || []).length && !orFb(s.sitesOther, ""), "at least one data source / site"],
        [!(s.metricsPick || []).length, "at least one output metric (Section 6) — without one the protocol does not say what it reports"],
        [!orFb(s.studyCalendar, ""), "the study calendar period"],
      ].filter((x) => x[0]).map((x) => x[1]);

      // The states in which the exported document asserts a design the form does
      // not support. These are NOT ordinary blanks — `missing()` covers those,
      // and a blank exports as a visible placeholder that needs no refusal. Each
      // of these instead makes the metric sections below print a numerator, a
      // denominator and a formula for a metric whose defining input was never
      // given, and they read as settled decisions.
      //
      // Until this existed the refusals lived only in the consistency-check
      // panel: a protocol could show two red ✕ on screen and still download a
      // Word file specifying age-standardisation for a study with no age bands,
      // under the message "Downloaded …". One computation, four surfaces — the
      // panel, the Markdown, the Word protocol and the STROBE checklist. Same
      // pattern as clone-censor-weight's blockers() and case-control's
      // conflicts(); do not re-introduce a second copy of any of these rules.
      const blockers = (s) => {
        const out = [];
        const ticked = s.metricsPick || [];
        const has = (id) => ticked.includes(id);
        const txt = (k) => String(s[k] || "").trim();
        const label = (id) => ((OUTPUT_METRICS.find((m) => m.id === id) || {}).label || id);

        const needsOutcome = ["incidence", "periodPrev", "pointPrev"].filter(has);
        if (needsOutcome.length && !txt("outcomeName") && !txt("outcomeCodes"))
          out.push(needsOutcome.map(label).join(" and ") + (needsOutcome.length > 1 ? " count" : " counts") +
            " outcome events in the numerator, but no outcome name or code set is defined (Section 5). The protocol currently specifies a denominator and no numerator, and the metric section below still prints one — “Incident (outcome) events” — as though it had been chosen.");

        const util = ["ddd", "initiation", "persistence", "switching", "concomitant"].filter(has);
        if (util.length && !txt("exposureName") && !txt("exposureCodes"))
          out.push("A drug-utilisation metric is ticked (" + util.map(label).join(", ") +
            ") but no drug exposure or ATC code set is defined (Section 5). DDD, initiation, persistence, switching and concomitant use all take the drug as their numerator, so the metric sections below describe counting a drug that has not been named.");

        if (has("mortCause") && !txt("mortCauseCodes"))
          out.push("Cause-specific mortality is ticked but no cause-of-death code set is defined (Section 5). Without it the numerator is “some deaths” and the rate is uninterpretable; the metric section still prints a cause-specific mortality formula.");

        // Indirect standardisation is not "standardising to" a population. It
        // applies a REFERENCE SCHEDULE OF AGE-SPECIFIC RATES to the study
        // population's own age structure to obtain expected events, and the
        // three published standards on this menu are age-STRUCTURE weight
        // vectors — WHO 2000, ESP 2013 and Segi 1960 carry proportions, not
        // rates. So the indirect and both branches used to print "Standardised
        // to: WHO World Standard 2000" beside an observed/expected formula that
        // cannot be computed from the object named. The internal-pooled option
        // is different: pooling the selected sites does yield age-specific
        // rates, so it is the one choice on this menu that indirect can use.
        if (has("ageStandardised") && (s.ageStdMethod === "indirect" || s.ageStdMethod === "both") &&
            ["who2000", "esp2013", "segi1960"].includes(s.ageStdRef))
          out.push("Indirect standardisation (SMR / SIR) is selected together with " + (SELECT_TXT.ageStdRef[s.ageStdRef] || s.ageStdRef) +
            " as the reference. Those standards are age-STRUCTURE weights — a set of proportions — and the direct method is what uses them. Indirect standardisation needs a reference schedule of age-specific RATES, applied to your own age structure, to get the expected number of events; none of the three published standards contains rates, so the expected count cannot be computed from the reference this protocol names. State the source of the reference rates instead (for example the national rates of a named country over the same calendar years), or use the internal-pooled option, which does yield age-specific rates.");

        // A metric whose required linkage is carried by NONE of the selected
        // sites cannot be computed anywhere, which is a different statement from
        // the amber feasibility panel's "some sites are missing this".
        for (const g of featureGaps(s)) {
          if (g.have.length === 0 && (g.id === "mortality" ? (has("mortAll") || has("mortCause")) : false))
            out.push("A mortality metric is ticked, but none of the selected data sources carries mortality linkage (" + g.missing.join(", ") + "). The numerator is “deaths in the cohort (mortality-linked records)” and there are no such records at any site, so the rate cannot be computed anywhere in this study as specified.");
        }

        const strataAll = mergeList(s.strataPick, s.strataCustom);
        if (has("ageStandardised") && !strataAll.some((x) => /age/i.test(x)))
          out.push("Age-standardised rates are ticked but no age stratum is selected in Section 7. Standardisation is arithmetic on age-specific rates — direct applies them to a reference age structure, indirect applies the reference rates to your age structure — so with no age bands there is nothing to standardise, either way. The protocol nonetheless prints the standardisation formula and names a reference population.");

        // Both of these describe themselves as operating on "the relevant metric
        // above" / "the primary metric (above)". Ticked on their own there is no
        // metric above, and nothing said so.
        const base = ["incidence", "periodPrev", "pointPrev", "mortAll", "mortCause", "ddd", "initiation"].filter(has);
        if (!base.length) {
          if (has("ageStandardised"))
            out.push("Age-standardised rates are ticked but no occurrence, mortality or utilisation metric is ticked with them. Standardisation is an adjustment applied to a rate that some other metric produces — with none selected there is nothing to standardise, and the section below refers to “the relevant metric above”, which does not exist.");
          if (has("joinpoint"))
            out.push("Joinpoint / segmented trend is ticked but no occurrence, mortality or utilisation metric is ticked with it. A joinpoint model is fitted to a series of rates that some other metric produces; the section below refers to “the primary metric (above)”, which does not exist.");
        }

        if (has("joinpoint")) {
          const yrs = (txt("trendYears").match(/\d{4}/g) || []).map(Number);
          const jp = parseInt(s.trendMaxJp, 10) || 3;
          if (yrs.length >= 2) {
            const npts = Math.max(...yrs) - Math.min(...yrs) + 1;
            if (npts < (jp + 1) * 2)
              out.push("Joinpoint: " + npts + " annual data point(s) with up to " + jp + " joinpoint(s) means " + (jp + 1) +
                " segments over " + npts + " points. A segment fitted to one or two points is not a trend — the model will still return an annual percent change, and the protocol still prescribes one. Reduce the maximum joinpoints or lengthen the series.");
          }
        }
        return out;
      };
      // Rendered the same way wherever the refusals travel.
      const blockerMd = (s) => {
        const b = blockers(s);
        return b.length
          ? "> **This draft specifies a metric it cannot compute.**\n>\n" + b.map((x) => "> - " + x).join("\n>\n") + "\n\n"
          : "";
      };

      // Which auto-appended validation citations still belong to this protocol.
      // `pickedCitations` is keyed by phenotype name and was never pruned, so
      // picking MI and then stroke left the reference list citing an MI
      // validation study for a stroke-only protocol — and because it has its own
      // localStorage key, citations accumulated across unrelated protocols
      // drafted in the same browser. A citation now travels only while the
      // phenotype it validates is still the value of one of the four name
      // fields; editing the field by hand drops it too, which is right, because
      // it is then no longer the library's validated definition.
      const PHENO_NAME_FIELDS = ["populationName", "exposureName", "outcomeName", "mortCauseName"];
      const activeCitations = (s) => {
        const named = new Set(PHENO_NAME_FIELDS.map((f) => String(s[f] || "").trim()).filter(Boolean));
        return Object.entries(pickedCitations)
          .filter(([pheno]) => named.has(pheno))
          .map(([, cite]) => String(cite || "").trim())
          .filter(Boolean);
      };

      const sitesLine = (ids, otherText) => {
        const parts = (ids || []).map((c) => "- " + formatSiteFull(c));
        const others = (otherText || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        if (parts.length === 0 && others.length === 0) return "_(no sites selected)_";
        let out = parts.join("\n");
        if (others.length > 0) out += (out ? "\n\n**Other sites:**\n" : "**Other sites:**\n") + others.map((o) => "- " + o).join("\n");
        return out;
      };

      // ── Per-metric section content (Markdown) ──
      // Each metric returns an object { name, formula, notes } that
      // gets rendered into a labelled block. The actual section
      // numbering happens in buildMarkdown.
      const metricBlock = (id, s) => {
        const m = OUTPUT_METRICS.find((x) => x.id === id);
        if (!m) return null;
        const strata = mergeList(s.strataPick, s.strataCustom);
        const strataLine = strata.length > 0 ? strata.join(" · ") : "Overall only";
        switch (id) {
          case "incidence": return {
            name: m.label, unit: m.unit,
            numerator: "Incident " + orFb(s.outcomeName, "outcome") + " events (first record meeting code set)",
            denominator: "Person-time at risk = sum of follow-up time from index date to first event / death / disenrolment / study end",
            formula: "IR = (events / person-time) × 1000",
            stratifyBy: strataLine,
          };
          case "periodPrev": return {
            name: m.label, unit: m.unit,
            numerator: "Cohort members with ≥1 qualifying " + orFb(s.outcomeName, "outcome") + " record during the window",
            denominator: "Cohort members alive and enrolled at any point during the window",
            formula: "Period prevalence = numerator / denominator (× 100 for %)",
            stratifyBy: strataLine,
          };
          case "pointPrev": return {
            name: m.label, unit: m.unit,
            numerator: "Cohort members with active " + orFb(s.outcomeName, "outcome") + " condition on the prevalence date (mid-year typical)",
            denominator: "Cohort members alive and enrolled on the prevalence date",
            formula: "Point prevalence = numerator / denominator (× 100 for %)",
            stratifyBy: strataLine,
          };
          case "mortAll": return {
            name: m.label, unit: m.unit,
            numerator: "All-cause deaths in cohort (mortality-linked records)",
            denominator: "Person-time at risk (entry to death / censoring)",
            formula: "All-cause mortality rate = (deaths / person-time) × 1000",
            stratifyBy: strataLine,
          };
          case "mortCause": return {
            name: m.label, unit: m.unit,
            numerator: orFb(s.mortCauseName, "Cause-specific") + " deaths in cohort (codes: " + orFb(s.mortCauseCodes, "see mortality library") + ")",
            denominator: "Person-time at risk",
            formula: "Cause-specific mortality rate = (cause-specific deaths / person-time) × 1000",
            stratifyBy: strataLine,
          };
          case "ddd": return {
            name: m.label, unit: m.unit,
            numerator: "Sum of DDDs dispensed for " + orFb(s.exposureName, "exposure class") + " (codes: " + orFb(s.exposureCodes, "ATC") + ") using WHO ATC/DDD index assignments",
            denominator: "Mid-period source-population estimate × number of days in the window",
            formula: "DDD/1000/day = (DDDs × 1000) / (population × days)",
            stratifyBy: strataLine,
          };
          case "initiation": return {
            name: m.label, unit: m.unit,
            numerator: "New users of " + orFb(s.exposureName, "exposure class") + " (no dispensing in prior 365-d washout)",
            denominator: "Eligible cohort person-time among those not already on the class",
            formula: "Initiation rate = (new users / at-risk person-time) × 1000",
            stratifyBy: strataLine,
          };
          case "persistence": return {
            name: m.label, unit: m.unit,
            numerator: "Time from first dispensing to first gap > grace period (typically 30 d) without re-dispensing",
            denominator: "All new users at index",
            formula: "Median time-to-discontinuation (Kaplan-Meier); % still on therapy at 6 / 12 months",
            stratifyBy: strataLine,
          };
          case "switching": return {
            name: m.label, unit: m.unit,
            numerator: "Transitions between drug classes within the same indication during follow-up",
            denominator: "All cohort members starting on first-line therapy",
            formula: "First-line → second-line → … flow proportions; visualised as a Sankey diagram",
            stratifyBy: strataLine,
          };
          case "concomitant": return {
            name: m.label, unit: m.unit,
            numerator: "Cohort members with overlapping days-of-supply across ≥2 specified drug classes",
            denominator: "Cohort members with ≥1 dispensing in any specified class",
            formula: "Concomitant-use proportion = numerator / denominator (× 100 for %)",
            stratifyBy: strataLine,
          };
          case "ageStandardised": return {
            name: m.label,
            // The unit follows the method. An SMR / SIR is observed ÷ expected —
            // a dimensionless ratio — and the metric list's "per 1000
            // (standardised)" is only true of the direct form. The indirect
            // branch used to print "observed / expected events × 1000" under
            // that same unit, which named a rate for a quantity that is not one.
            unit: ({ indirect: "ratio (observed ÷ expected); dimensionless, conventionally reported as a percentage of expected",
                     both: "per 1000 (direct) and a dimensionless ratio (indirect)" })[s.ageStdMethod] || m.unit,
            numerator: "(See age-stratum-specific rates from the relevant metric above)",
            denominator: "Standardised to: " + pickTxt("ageStdRef", s.ageStdRef),
            formula: pickTxt("ageStdMethod", s.ageStdMethod),
            stratifyBy: "Age bands: " + orFb(s.ageStdBands, NOTSET("no age bands for standardisation were given in Section 8")),
          };
          case "joinpoint": return {
            name: m.label, unit: m.unit,
            numerator: "Annual rates from the primary metric (above) over the trend window",
            denominator: "Time-series of " + orFb(s.trendYears, NOTSET("no trend year range was given in Section 9, so the length of the series is not stated and could not be checked against the number of joinpoints")),
            formula: "Joinpoint regression, allowing at most " + pickInline("trendMaxJp", s.trendMaxJp) + " joinpoint(s): " + pickInline("trendMethod", s.trendMethod) + ". Report " + pickInline("trendReport", s.trendReport) + ".",
            stratifyBy: strataLine,
          };
          case "trendInTrend": return {
            name: m.label, unit: m.unit,
            numerator: "Outcome trend across calendar periods within each CPE stratum",
            denominator: "Exposure-prevalence trend across calendar periods within each CPE stratum",
            formula: "Trend-in-trend (Ji X, Small DS, Leonard CE, Hennessy S. Epidemiology 2017;28(4):529-536; doi:10.1097/EDE.0000000000000579). Stage 1: a logistic model of exposure on covariates that affect exposure but are not affected by it gives each person's cumulative probability of exposure (CPE); the population is cut into quantiles of CPE (quintiles in the original paper). Stage 2: for each CPE stratum and calendar period, the number at risk, the number exposed and the number of outcomes are tabulated, and a covariates-free likelihood over those counts is maximised, giving exp(β₁), an odds ratio. It works on those marginals — it does not need the individual-level exposure-by-outcome cross-classification, which is what lets it run on aggregate stratum-period data under a federated agreement. **This is a causal design, not a descriptive metric — use the dedicated Trend-in-trend protocol builder if it is the central question.**",
            stratifyBy: strataLine,
          };
          default: return null;
        }
      };

      const buildMarkdown = (s) => {
        const today = new Date().toISOString().slice(0, 10);
        const title = orFb(s.title, "(Untitled multi-national descriptive study)");
        const meta = pickTxt("metaMethod", s.metaMethod);
        const arch = pickTxt("arch", s.arch);
        const ciMethod = pickTxt("ciMethod", s.ciMethod);
        const ticked = (s.metricsPick || []);

        const refsUser = (s.references || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const refs = (() => { const set = new Set(refsUser); for (const c of activeCitations(s)) set.add(c); return Array.from(set); })();
        const milestones = (s.timeline || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const strata = mergeList(s.strataPick, s.strataCustom);
        const inclusion = (s.inclusionCriteria || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const exclusion = (s.exclusionCriteria || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const sensitivity = mergeList(s.sensitivityPick, s.sensitivityCustom);

        // Render each ticked metric as its own ## section, numbered sequentially.
        let metricSection = "";
        let n = 7;
        for (const id of ticked) {
          const block = metricBlock(id, s);
          if (!block) continue;
          metricSection += `\n## ${n}. ${block.name}\n\n` +
            `**Unit.** ${block.unit}\n\n` +
            `| | |\n|---|---|\n` +
            `| **Numerator** | ${td(block.numerator)} |\n` +
            `| **Denominator** | ${td(block.denominator)} |\n` +
            `| **Formula** | ${td(block.formula)} |\n` +
            `| **Stratify by** | ${td(block.stratifyBy)} |\n`;
          n++;
        }
        // n must advance here too, or the next heading repeats "## 7." — the
        // Markdown then has two section 7s and every later number is off by one
        // against the Word version, which does not print this fallback.
        if (!metricSection) { metricSection = "\n## 7. Output metrics\n\n> **No output metric is selected, so this protocol does not yet say what it measures.** Tick at least one metric in Section 6 of the form.\n"; n++; }

        return `# ${title}

**Study ID:** ${orFb(s.shortId, "(short id)")}
**Lead investigator(s):** ${orFb(s.leadInvestigator, "(lead)")}
**Version:** ${orFb(s.version, "v0.1 draft · " + today)}
**Design:** Multi-national descriptive epidemiology

---

${missing(s).length ? "> **This draft is incomplete.** Still to be specified: " + missing(s).join("; ") + ".\n\n" : ""}${blockerMd(s)}${window.PC.abstractMd(pcOf(s))}
## 1. Research question

| | |
|---|---|
| **Population** | ${td(orFb(s.picoP, "_(population)_"))} |
| **What we measure** | ${td(orFb(s.picoMeasure, "_(metric)_"))} |
| **Time window** | ${td(orFb(s.picoWindow, "_(window)_"))} |

## 2. Sites

${sitesLine(s.sites, s.sitesOther)}

${(() => { const g = featureGaps(s); return g.length ? "**Per-site metric feasibility.** The metrics and study text imply data features that some selected sites do not carry:\n\n" + g.map((x) => "- " + gapLine(x)).join("\n") + "\n\nState which sites contribute to which metric.\n\n" : ""; })()}## 3. Population (denominator)

**Name.** ${orFb(s.populationName, "_(population name)_")}

**Operational definition.** ${orFb(s.populationDef, "_(operational definition)_")}

**Code set / criteria.** ${orFb(s.populationCodes, "_(codes)_")}

**Inclusion criteria**

${bullets(inclusion)}

**Exclusion criteria**

${bullets(exclusion)}

**Index date / observation-start rule.** ${orFb(s.indexDateRule, "_(rule)_")}

**Study calendar period.** ${orFb(s.studyCalendar, "_(period)_")}

## 4. Numerator phenotypes

| | Value |
|---|---|
| **Drug exposure; name** | ${td(orFb(s.exposureName, "_(n/a)_"))} |
| **Drug exposure; codes** | ${td(orFb(s.exposureCodes, "_(n/a)_"))} |
| **Outcome; name** | ${td(orFb(s.outcomeName, "_(n/a)_"))} |
| **Outcome; codes** | ${td(orFb(s.outcomeCodes, "_(n/a)_"))} |
| **Outcome; operational definition** | ${td(orFb(s.outcomeDef, "_(n/a)_"))} |
| **Cause of death; name** | ${td(orFb(s.mortCauseName, "_(n/a)_"))} |
| **Cause of death; codes** | ${td(orFb(s.mortCauseCodes, "_(n/a)_"))} |

## 5. Output metrics; selected

${ticked.length > 0 ? ticked.map((id, i) => "- " + ((OUTPUT_METRICS.find((m) => m.id === id) || {}).label || id)).join("\n") : "_(none selected)_"}

## 6. Stratification

${bullets(strata)}
${metricSection}

## ${n}. Statistical analysis

- **CI method:** ${ciMethod}
- **Cross-site comparison:** ${meta}
- **Site contribution model:** ${pickTxt("contribution", s.contribution)}
- **Suppression rule:** ${orFb(s.suppression, NOTSET("no small-cell suppression rule has been set"))}

**Sensitivity analyses**

${bullets(sensitivity)}

## ${n+1}. Execution and timeline

**Architecture.** ${arch}

**Timeline milestones**

${numbered(milestones)}

## ${n+2}. Ethics, data sharing, dissemination

**Ethics.** ${orFb(s.ethics, NOTSET("the ethics section was left empty"))}

**Dissemination.** ${orFb(s.dissemination, NOTSET("the dissemination section was left empty"))}

${window.PC.tailMd(pcOf(s))}

## ${n+3}. Key references

${numbered(refs)}

---

_Drafted with the Protocol Generator — descriptive analysis (${today})._
`;
      };

      // ── Consistency checks ────────────────────────────────────
      // A descriptive study does not crash; it returns a rate. The failure that
      // matters is a numerator and a denominator counted over different people,
      // or a metric whose defining input was never filled in. Everything below
      // is about that, plus the standardisation and trend rules that make a
      // number comparable across countries.
      const computeChecks = (s) => {
        const c = [];
        const ticked = s.metricsPick || [];
        const has = (id) => ticked.includes(id);
        const txt = (k) => String(s[k] || "").trim();
        const strata = mergeList(s.strataPick, s.strataCustom);
        const label = (id) => ((OUTPUT_METRICS.find((m) => m.id === id) || {}).label || id);
        const popBlob = (txt("populationDef") + " " + txt("populationCodes") + " " + txt("inclusionCriteria") + " " + txt("indexDateRule")).toLowerCase();

        if (staleSelects.length) c.push({ level: "warn", msg:
          "A saved draft or a ?seed= link carried " + staleSelects.length + " value(s) this builder no longer offers, and they were NOT applied: " +
          staleSelects.map((x) => "“" + x.label + "” asked for “" + x.value + "”, left at “" + x.kept + "”").join("; ") +
          ". Check each of them before circulating this protocol — the option may have been renamed since the draft was saved." });

        const miss = missing(s);
        if (miss.length) c.push({ level: "error", msg: "This protocol is not yet complete. Still to be specified: " + miss.join("; ") + ". The draft is printed with placeholders so you can see its shape — it is not a finished protocol." });

        // Every refusal comes from blockers(), which the Markdown, the Word
        // protocol and the STROBE checklist also print, so the panel and the
        // documents cannot disagree about what this draft cannot compute.
        blockers(s).forEach((m) => c.push({ level: "error", msg: m }));

        // The gap list, in the panel as well as the amber box, so that what
        // travels into the exports and what the user reads are one thing.
        for (const g of featureGaps(s)) {
          if (g.have.length === 0) continue;   // the blocker above covers those
          c.push({ level: "warn", msg: "Site feasibility — " + gapLine(g) + " Say in the per-site analytic plan which sites contribute to which metric; this gap now travels into the exported protocol." });
        }

        // ── The classic denominator mismatch. ──
        const enrolmentRestricted = /continuous enrol|continuous enrol?ment|washout|≥\s*365|365\s*d|1 year of baseline|enrol/i.test(popBlob);
        if (has("ddd") && enrolmentRestricted)
          c.push({ level: "warn", msg: "DDD/1000 inhabitants/day is defined against the SOURCE POPULATION, but your denominator population is restricted (continuous enrolment / washout). If the numerator counts every dispensing while the denominator counts only the enrolment-qualified cohort, the two are drawn from different people and the rate is neither a population DDD nor a cohort rate. State explicitly which population each side of the fraction uses." });
        // The second field here was `suppression`, a copy-paste: a small-cell
        // rule has nothing to say about where the inhabitant denominator comes
        // from, and any populationDef containing the word "population" silenced
        // the check on its own.
        if (has("ddd") && !/mid-?year|inhabitant|source population|census|resident/i.test(txt("populationDef") + " " + txt("picoP") + " " + txt("populationCodes")))
          c.push({ level: "info", msg: "The DDD denominator is the mid-period source-population estimate × days in the window. Say where that population figure comes from for each database — it is usually not the same object as the analytic cohort." });

        if (has("incidence") && !/washout|prior|history|prevalent|na[iï]ve|first[- ]ever|incident/i.test(popBlob + " " + txt("exclusionCriteria").toLowerCase()))
          c.push({ level: "warn", msg: "Incidence rate is ticked but nothing in the population definition, inclusion or exclusion criteria excludes people who already have the outcome. Without a clean baseline look-back the numerator mixes incident with prevalent cases and the 'incidence rate' is not one." });
        if (has("initiation") && !/washout|365|prior|na[iï]ve|new user/i.test(popBlob))
          c.push({ level: "warn", msg: "Initiation rate counts new users with no dispensing in a prior 365-day washout, but the index-date rule and inclusion criteria do not mention a baseline look-back of at least that length. Prevalent users will be counted as initiators wherever the available history is shorter than the washout." });
        if (has("periodPrev") && has("pointPrev"))
          c.push({ level: "info", msg: "Period and point prevalence have different denominators — everyone enrolled at any time in the window, versus everyone enrolled on one date. Report them as separate rows, never in the same column." });

        // ── Standardisation. (The "no age stratum" refusal is in blockers().) ──
        // The default bands stop at 85+, WHO 2000 runs to 100+ and ESP 2013 to
        // 95+. Two sites collapsing the reference's top bands differently — or
        // one truncating rather than summing — produce "WHO-2000-standardised"
        // rates that are not comparable, which is the failure this whole page
        // exists to prevent, and it bites hardest on dementia, hip fracture and
        // all-cause mortality: the metrics this phenotype library is built for.
        const TERMINAL = { who2000: "100+", esp2013: "95+", segi1960: "85+" };
        if (has("ageStandardised") && TERMINAL[s.ageStdRef] && TERMINAL[s.ageStdRef] !== "85+" &&
            /\b85\s*\+/.test(txt("ageStdBands")))
          c.push({ level: "warn", msg: "Your age bands stop at 85+, but " + (SELECT_TXT.ageStdRef[s.ageStdRef] || s.ageStdRef) + " runs to " + TERMINAL[s.ageStdRef] + ". The reference weights above 85 have to be SUMMED into a single 85+ weight, and the protocol does not say so — a site that truncates them instead of summing produces a standardised rate that is not comparable with the other sites', or with any published rate standardised to the same reference. Either extend the bands to " + TERMINAL[s.ageStdRef] + " or state the collapsing rule explicitly." });
        if (has("ageStandardised") && s.ageStdRef === "internal")
          c.push({ level: "warn", msg: "An internal-pooled reference population makes your standardised rates comparable within this study only. They cannot be placed beside published WHO-2000 or ESP-2013 standardised rates. If cross-study comparison matters, report a WHO/ESP-standardised version too." });
        // Count the sites the user actually chose. Ticking the "Country / site"
        // stratum is not evidence that more than one site exists: it ships
        // ticked, so a fresh page with nothing selected used to be told "You are
        // comparing more than one country or site" about a study with no sites.
        const nSites = (s.sites || []).length + (txt("sitesOther").split(/\r?\n/).map((l) => l.trim()).filter(Boolean).length);
        if (!has("ageStandardised") && nSites > 1)
          c.push({ level: "warn", msg: "You are comparing " + nSites + " data sources without age-standardisation. Populations with different age structures produce different crude rates for the same underlying risk, so a ranked crude-rate figure across countries mostly ranks their age distributions." });

        // ── Trends. ──
        if (has("joinpoint")) {
          const yrs = (txt("trendYears").match(/\d{4}/g) || []).map(Number);
          const jp = parseInt(s.trendMaxJp) || 3;
          if (yrs.length >= 2) {
            const npts = Math.max(...yrs) - Math.min(...yrs) + 1;
            // The too-few-points-per-segment case is a blocker and is pushed above.
            // Adjacent segments SHARE the joinpoint observation, so the total
            // number of point-memberships is npts + jp, not npts. Dividing npts
            // by the number of segments understated the average by 40-80% and
            // printed the understatement as a bare integer.
            if (npts >= (jp + 1) * 2 && npts < (jp + 1) * 3) c.push({ level: "warn", msg: "Joinpoint: " + npts + " points across " + (jp + 1) + " possible segments averages " + ((npts + jp) / (jp + 1)).toFixed(1) + " points per segment (adjacent segments share their joinpoint). APCs from segments that short are very unstable; consider fewer joinpoints. For reference, the NCI Joinpoint program's own guidance is that a series should have at least seven points before a joinpoint is allowed at all, and about four points on average between consecutive joinpoints." });
          } else if (!txt("trendYears")) {
            c.push({ level: "warn", msg: "Joinpoint trend is ticked but no trend year range is given (Section 9), so the number of data points cannot be checked against the maximum number of joinpoints." });
          } else {
            // Non-empty but unreadable. This used to be silent, and silence here
            // is indistinguishable from "your series is long enough": "14 years"
            // and a bare "2023" both skipped the check entirely.
            c.push({ level: "warn", msg: "Joinpoint trend is ticked, but the trend year range reads “" + txt("trendYears") + "”, from which fewer than two four-digit years could be read. The length of the series was therefore NOT checked against the maximum number of joinpoints — this is not a statement that it is long enough. Write the range as calendar years, e.g. 2010–2023." });
          }
        }
        if (has("trendInTrend"))
          c.push({ level: "warn", msg: "Trend-in-trend is a causal design, not a descriptive metric: it estimates an odds ratio by stratifying on each person's predicted probability of exposure. It does not belong in a descriptive protocol's metric list except as a stub — use the dedicated trend-in-trend builder for it." });

        // ── Pooling across countries. ──
        if (s.metaMethod === "re" || s.metaMethod === "re-reml")
          c.push({ level: "warn", msg: "Random-effects pooling of descriptive rates across countries: the pooled number is an average of populations that genuinely differ, so I² will be near 100% and the summary describes no real population. Report it, if at all, alongside the site-specific estimates — never instead of them." });

        // ── Small cells. ──
        if (strata.length >= 4)
          c.push({ level: "info", msg: strata.length + " stratifying variables means the cross-tabulation is deep and many cells will fall under your suppression rule. Say which strata are crossed and which are reported one at a time, or most of the table will be '<5'." });
        if (!txt("suppression"))
          c.push({ level: "warn", msg: "No small-cell suppression rule is set. Multi-database descriptive output is where re-identification risk actually lives; every site's governance will ask for one." });

        if (s.ciMethod === "normal")
          c.push({ level: "warn", msg: "A normal-approximation confidence interval is only reliable with large counts. Descriptive work stratified by age, sex and year produces sparse cells, where it gives a lower limit below zero for a rate that cannot be negative, and for a proportion an interval that runs outside 0-1. Exact Poisson (rates) and Wilson score (proportions) are the safe defaults." });

        return c;
      };

      const renderScheme = (s) => {
        // "Time window" is free text and is usually a calendar range, not a
        // duration. A bare parseInt turned "2010–2023 (annual)" into a 2010-DAY
        // measurement window and drew it as if it were the user's design. Only
        // accept a value that is explicitly written as a duration; otherwise draw
        // a labelled one-year schematic.
        const m = String(s.picoWindow || "").match(/^\s*(\d{1,4})\s*(d|day|days|w|wk|week|weeks|mo|month|months|y|yr|year|years)\s*$/i);
        let meas = 365, labelled = false;
        if (m) {
          const n = parseInt(m[1], 10), u = m[2].toLowerCase();
          const mult = u[0] === "d" ? 1 : u[0] === "w" ? 7 : u.startsWith("m") ? 30 : 365;
          if (n > 0) { meas = Math.min(365 * 20, n * mult); labelled = true; }
        }
        const wins = [
          { label: "Baseline look-back (prevalent-case exclusion)", kind: "lookback", startDay: -365, endDay: 0 },
          { label: labelled ? "Person-time / measurement window" : "Person-time / measurement window (1 y, schematic)", kind: "study", startDay: 0, endDay: meas },
        ];
        window.renderDesignDiagram(document.getElementById("diagram"), document.getElementById("dlegend"), { windows: wins, indexLabel: "Cohort entry / index" });
      };

      const render = () => {
        const state = readForm();
        preview.textContent = buildMarkdown(state);
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch {}
        renderFeasibility(state);
        // Never swallow a render failure silently: a blank checks panel that
        // looks like "no issues" is exactly the failure mode this page is for.
        try { window.renderChecks(document.getElementById("checks"), computeChecks(state)); }
        catch (err) {
          console.error("[DA] consistency checks failed to render", err);
          const el = document.getElementById("checks");
          if (el) el.innerHTML = '<div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">The consistency checks could not be rendered, so this panel is showing nothing rather than showing "no issues". Details are in the browser console.</div>';
        }
        // Never swallow a render failure silently — an empty diagram box that
        // looks intentional is how a broken diagram survived for weeks.
        try { renderScheme(state); }
        catch (err) {
          console.error("[DA] study-design diagram failed to render", err);
          const el = document.getElementById("diagram");
          if (el) el.innerHTML = '<p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">The design diagram could not be drawn. It is blank because of an error, not because there is nothing to show; details are in the browser console.</p>';
        }
      };
      try { window.PC && PC.restore ? PC.restore(form, STORAGE_KEY, writeForm) : (localStorage.getItem(STORAGE_KEY) && writeForm(JSON.parse(localStorage.getItem(STORAGE_KEY)))); }
      catch (err) { console.warn("[DA] could not restore the saved draft", err); }
      auditSelectMaps();
      const timelineTa = form.querySelector('[name="timeline"]');
      if (timelineTa && !timelineTa.value) timelineTa.value = TIMELINE_PRESETS["12-month"];
      render();
      form.addEventListener("input", render);
      form.addEventListener("change", render);

      form.addEventListener("click", (e) => {
        const tl = e.target?.closest?.("[data-timeline-preset]");
        if (tl) {
          const ta = form.querySelector('[name="timeline"]');
          if (ta) { ta.value = TIMELINE_PRESETS[tl.dataset.timelinePreset] || ta.value; render(); }
        }
      });

      const buildFilename = (ext) => {
        const state = readForm();
        const slug = (state.shortId || "aspen-protocol-desc").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60) || "aspen-protocol-desc";
        const today = new Date().toISOString().slice(0, 10);
        return slug + "-" + today + "." + ext;
      };

      document.querySelector("[data-action='download-md']")?.addEventListener("click", () => {
        const blob = new Blob([preview.textContent || ""], { type: "text/markdown;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url; a.download = buildFilename("md");
        document.body.appendChild(a); a.click(); a.remove();
        URL.revokeObjectURL(url);
        setMsg("Downloaded " + a.download);
      });

      document.querySelector("[data-action='copy']")?.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(preview.textContent || ""); setMsg("Copied to clipboard."); }
        catch { setMsg("Couldn't copy; your browser may block clipboard access.", true); }
      });

      const doReset = () => {
        if (!confirm("Clear every field and forget the saved draft?")) return;
        localStorage.removeItem(STORAGE_KEY);
        localStorage.removeItem(STORAGE_CITATIONS_KEY);
        pickedCitations = {};
        // The draft that carried them is gone and every select is back at its
        // authored default, so the "values were not applied" warning no longer
        // describes anything the user can act on.
        staleSelects = [];
        form.querySelectorAll("input, textarea, select").forEach((el) => {
          if (el.type === "checkbox" || el.type === "radio") el.checked = false;
          // Restore the option the markup declares, not index 0. "Max
          // joinpoints" is authored 3 and its first option is 2, so Clear all
          // used to change an exported analysis parameter — "identify up to 3
          // break-points" became "up to 2" — with nothing on screen saying so,
          // and it moved the threshold of the check that guards it.
          else if (el.tagName === "SELECT") {
            const authored = el.querySelector("option[selected]");
            if (authored) el.value = authored.value; else el.selectedIndex = 0;
          }
          // `el.defaultValue` is the value/textarea content the markup ships
          // with, so Clear restores the page rather than stripping it. Emptying
          // these instead deleted nine curated references, the ethics and
          // dissemination paragraphs, the index-date rule, the standardisation
          // age bands and the suppression rule — permanently, because render()
          // saves the empty state to localStorage on the next tick, so a reload
          // did not bring them back. "Clear & start over" left the tool
          // strictly worse than it was for the previous protocol.
          else el.value = el.defaultValue;
        });
        render();
        setMsg("Cleared.");
      };
      document.querySelector("[data-action='reset']")?.addEventListener("click", doReset);
      document.querySelector("[data-action='reset-top']")?.addEventListener("click", doReset);

      document.querySelector("[data-action='download-docx']")?.addEventListener("click", async () => {
        if (typeof docx === "undefined") { setMsg("Word library failed to load.", true); return; }
        setMsg("Building Word document…");
        try {
          const blob = await buildDocx(readForm());
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url; a.download = buildFilename("docx");
          document.body.appendChild(a); a.click(); a.remove();
          URL.revokeObjectURL(url);
          setMsg("Downloaded " + a.download + "." + lastFigNote, !!lastFigNote);
        } catch (e) { console.error(e); setMsg("Couldn't build the Word file: " + String(e) + ". Nothing was downloaded.", true); }
      });

      // ── STROBE checklist (.docx) ──────────────────────────
      document.querySelector("[data-action='download-strobe']")?.addEventListener("click", async () => {
        if (typeof docx === "undefined") { setMsg("Word library failed to load.", true); return; }
        setMsg("Building STROBE checklist…");
        try {
          const s = readForm();
          const blob = await buildStrobeDocx(s);
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          const today = new Date().toISOString().slice(0, 10);
          a.href = url;
          a.download = (s.shortId || "descriptive").replace(/[^a-z0-9]+/gi, "-").toLowerCase() + "-STROBE-checklist-" + today + ".docx";
          document.body.appendChild(a); a.click(); a.remove();
          URL.revokeObjectURL(url);
          setMsg("Downloaded " + a.download);
        } catch (e) { console.error(e); setMsg("Couldn't build the STROBE checklist: " + String(e), true); }
      });

      // Map this descriptive-analysis protocol's fields onto the STROBE items.
      const strobeWhere = (s) => {
        const sitesPlain = (() => {
          const parts = (s.sites || []).map((c) => formatSiteFull(c));
          const others = (s.sitesOther || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
          return [...parts, ...others].join("; ") || "(no sites selected)";
        })();
        const bul = (a) => a.length ? a.map((x) => "• " + x).join("\n") : "(none specified)";
        const sens = mergeList(s.sensitivityPick, s.sensitivityCustom);
        const strata = mergeList(s.strataPick, s.strataCustom);
        const metricLabels = (s.metricsPick || []).map((id) => ((OUTPUT_METRICS.find((m) => m.id === id) || {}).label || id));
        // One map again: this used to carry a fourth key ("fe") the form has
        // never offered, and to fall through to "descriptive cross-site
        // comparison" for anything it did not recognise — including a select
        // left unset by a stale draft.
        const metaTxt = pickTxt("metaMethod", s.metaMethod);
        const map = {
          "1a": "Multi-national descriptive epidemiology study (disease frequency / drug utilisation).",
          "3": "Characterise " + (s.picoMeasure || "(metric)") + " among " + (s.picoP || "(population)") + " across the participating sites. Descriptive; no causal hypothesis.",
          "4": "Descriptive cross-national analysis. Population-level rates / proportions are computed within each site and compared; no exposure-outcome causal contrast.",
          "5": "Participating sites: " + sitesPlain + ". Study calendar period: " + (s.studyCalendar || "(not specified)") +
               ". Reporting window: " + (s.picoWindow || "(not specified)") +
               ". Observation start / index-date rule: " + (s.indexDateRule || "(not specified)") + ".",
          "6": "Source population: " + (s.populationDef || s.picoP || "(population)") + (s.populationCodes ? " (" + s.populationCodes + ")" : "") + ". Eligibility (e.g. continuous enrolment) per the protocol.",
          // The exposure fields were never referenced here, though the whole
          // Utilisation half of this builder depends on them: a DDD-only
          // protocol reported "Numerator(s): exposures / outcomes / mortality
          // causes per the protocol" and named nothing.
          "7": "Output metrics:\n" + bul(metricLabels) +
               "\nDrug exposure: " + (s.exposureName || "(none defined)") + (s.exposureCodes ? " (" + s.exposureCodes + ")" : "") +
               "\nOutcome: " + (s.outcomeName || "(none defined)") + (s.outcomeCodes ? " (" + s.outcomeCodes + ")" : "") + (s.outcomeDef ? ". Operational definition: " + s.outcomeDef : "") +
               "\nCause of death: " + (s.mortCauseName || "(none defined)") + (s.mortCauseCodes ? " (" + s.mortCauseCodes + ")" : "") +
               "\nDenominator population: " + (s.populationDef || s.populationName || "(none defined)") + ".",
          "8": "Routinely-collected health data from the contributing databases (" + sitesPlain + "). Each metric's numerator and denominator ascertained from the protocol code sets and enrolment data.",
          "9": (() => {
            const g = featureGaps(s);
            return (g.length
              ? "Differential data capture across databases is reported in the protocol's per-site metric feasibility list:\n" + bul(g.map(gapLine))
              : "No gap was detected between the data features the chosen metrics require and the features the selected sites carry.")
              + "\nSensitivity analyses:\n" + bul(sens);
          })(),
          "11": "Age handled by standardisation and/or banding where indicated in the metric definitions; rates expressed per person-time / per 1000 as specified.",
          "12": "Per-site computation of each selected metric (incidence / prevalence / utilisation, etc.) with the stated denominators and age-standardisation where indicated; site estimates compared / pooled as follows: " + metaTxt + " . Stratified by:\n" + bul(strata) + "\nSensitivity analyses:\n" + bul(sens),
          // STROBE 10 (study size) and 22 (funding) were both deferred to "[To
          // be completed at the time of reporting]" while the exported protocol
          // devotes a section to each — the checklist told the reader the
          // protocol was silent on items it addresses.
          "10": "No effect size is being tested, so the study is sized for precision rather than power; see \u201cStudy size and feasibility\u201d in the protocol. The available size is fixed by the contributing data sources (" + sitesPlain + ") over the study calendar period, and the expected width of each 95% confidence interval is reported per site and per stratum.",
          "14": "Per-site population characteristics and denominators to be tabulated (Table 1).",
          "17": "Stratified analyses:\n" + bul(strata) + "\nSensitivity analyses:\n" + bul(sens),
          "19": "Descriptive estimates reflect coding and capture practices that differ across databases; cross-site comparisons should account for differential ascertainment; no causal interpretation is intended.",
          "21": "Estimates generalise to the source populations of the contributing databases: " + sitesPlain + ".",
          "22": "See \u201cFunding and conflicts of interest\u201d in the protocol: the funding source(s) and each author's conflicts are declared in the final report.",
        };
        // The checklist describes the study as the form has it, so it must carry
        // the same refusals as the protocol: a reporting checklist that reads
        // confidently while the design underneath it cannot be computed is
        // exactly the artefact a reviewer takes at face value.
        const blk = blockers(s);
        if (blk.length) map["1a"] = "THIS DRAFT SPECIFIES A METRIC IT CANNOT COMPUTE: " + blk.join(" ") + "\n\n" + map["1a"];
        return map;
      };

      const buildStrobeDocx = async (s) => {
        const D = docx;
        const FONT = "Times New Roman";
        const today = new Date().toISOString().slice(0, 10);
        const text = (str, o = {}) => new D.TextRun({ text: String(str ?? ""), font: FONT, size: 22, ...o });
        const p = (ch, o = {}) => new D.Paragraph({ children: Array.isArray(ch) ? ch : [ch], spacing: { before: 50, after: 50 }, ...o });
        const border = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" };
        const cb = { top: border, bottom: border, left: border, right: border };
        const cell = (children, opt = {}) => new D.TableCell({ borders: cb, margins: { top: 60, bottom: 60, left: 120, right: 120 }, ...opt, children });
        const headerCell = (str) => new D.TableCell({ borders: cb, shading: { fill: "21443E", type: D.ShadingType.CLEAR }, margins: { top: 80, bottom: 80, left: 120, right: 120 }, children: [p([text(str, { bold: true, color: "FFFFFF" })])] });
        const where = strobeWhere(s);
        const allIds = STROBE_ITEMS.flatMap((sec) => sec.items.map(([n]) => n));
        const total = allIds.length;
        const filled = allIds.filter((n) => where[n]);
        const rows = [new D.TableRow({ tableHeader: true, children: [headerCell("#"), headerCell("STROBE recommendation"), headerCell("Where addressed in this protocol")] })];
        for (const sec of STROBE_ITEMS) {
          rows.push(new D.TableRow({ children: [new D.TableCell({ borders: cb, columnSpan: 3, shading: { fill: "E8F0EE", type: D.ShadingType.CLEAR }, margins: { top: 60, bottom: 60, left: 120, right: 120 }, children: [p([text(sec.section, { bold: true, color: "21443E" })])] })] }));
          for (const [n, rec] of sec.items) {
            const w = where[n] || "[To be completed at the time of reporting.]";
            rows.push(new D.TableRow({ children: [
              cell([p([text(n, { bold: true })])], { width: { size: 700, type: D.WidthType.DXA }, shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR } }),
              cell([p([text(rec)])], { width: { size: 4163, type: D.WidthType.DXA } }),
              cell(String(w).split("\n").map((l) => p([text(l)])), { width: { size: 4163, type: D.WidthType.DXA } }),
            ] }));
          }
        }
        const table = new D.Table({ width: { size: 9026, type: D.WidthType.DXA }, columnWidths: [700, 4163, 4163], rows });
        const children = [
          new D.Paragraph({ children: [text("STROBE checklist; " + (s.title || "(Untitled multi-national descriptive study)"), { bold: true, size: 32 })], spacing: { after: 120 } }),
          // Computed, not asserted. The sentence used to claim "Methods items
          // are pre-filled; Results / Discussion items are placeholders", and it
          // was false in both directions — a Methods item was deferred while
          // four Results/Discussion items were pre-filled — so the checklist
          // misdescribed its own completeness on its first line.
          p([new D.TextRun({ text: "This document maps the protocol fields to the STROBE statement (von Elm E, et al. PLoS Med 2007;4:e296). " +
            filled.length + " of the " + total + " checklist items are pre-filled from your protocol (" + filled.join(", ") + "); the remaining " + (total - filled.length) +
            " are placeholders to complete at the time of reporting, and are mostly Results and Discussion items that a protocol cannot answer in advance. Full checklist with elaboration: strobe-statement.org.", font: FONT, size: 20, italics: true, color: "555555" })]),
          p([new D.TextRun({ text: "Generated " + today + " from the Protocol Generator descriptive-analysis builder.", font: FONT, size: 18, italics: true, color: "777777" })]),
          table,
        ];
        const doc = new D.Document({ sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }] });
        return await D.Packer.toBlob(doc);
      };

      const buildDocx = async (s) => {
        const D = docx;
        const FONT = "Times New Roman";
        const today = new Date().toISOString().slice(0, 10);
        const text = (str, opts = {}) => new D.TextRun({ text: String(str ?? ""), font: FONT, size: 22, ...opts });
        const p = (children, opts = {}) => new D.Paragraph({ children: Array.isArray(children) ? children : [children], spacing: { before: 60, after: 60, ...(opts.spacing || {}) }, ...opts });
        const h1 = (str) => new D.Paragraph({ children: [text(str, { bold: true, size: 28 })], spacing: { before: 200, after: 80 }, heading: D.HeadingLevel.HEADING_1 });
        const h2 = (str) => new D.Paragraph({ children: [text(str, { bold: true, size: 24 })], spacing: { before: 160, after: 60 }, heading: D.HeadingLevel.HEADING_2 });
        const para = (str) => p([text(str)]);
        const bullet = (str) => new D.Paragraph({ children: [text(str)], bullet: { level: 0 }, spacing: { before: 0, after: 0 } });
        const numItem = (str) => new D.Paragraph({ children: [text(str)], numbering: { reference: "ordered", level: 0 }, spacing: { before: 0, after: 0 } });
        const border = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" };
        const cellBorders = { top: border, bottom: border, left: border, right: border };
        const labelTable = (rows) => new D.Table({
          width: { size: 9026, type: D.WidthType.DXA },
          columnWidths: [3000, 6026],
          rows: rows.map(([l, v]) => new D.TableRow({
            children: [
              new D.TableCell({ borders: cellBorders, width: { size: 3000, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR }, children: [p([text(l, { bold: true })])] }),
              new D.TableCell({ borders: cellBorders, width: { size: 6026, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, children: [p([text(v || "-")])] }),
            ],
          })),
        });

        const refsUser = (s.references || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const refs = (() => { const set = new Set(refsUser); for (const c of activeCitations(s)) set.add(c); return Array.from(set); })();
        const milestones = (s.timeline || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const strata = mergeList(s.strataPick, s.strataCustom);
        const inclusion = (s.inclusionCriteria || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const exclusion = (s.exclusionCriteria || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const sensitivity = mergeList(s.sensitivityPick, s.sensitivityCustom);
        const sitesPart = (s.sites && s.sites.length > 0) ? s.sites.map((c) => formatSiteFull(c)).join("; ") : "";
        const sitesOthersList = (s.sitesOther || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const sitesText = !sitesPart && sitesOthersList.length === 0 ? "(no sites selected)" : [sitesPart, sitesOthersList.length > 0 ? ("Others: " + sitesOthersList.join("; ")) : ""].filter(Boolean).join(" | ");
        const meta = pickTxt("metaMethod", s.metaMethod);
        const arch = pickTxt("arch", s.arch);
        const ciMethod = pickTxt("ciMethod", s.ciMethod);
        const ticked = s.metricsPick || [];

        let __phdcLogo = null; try { const __r = await fetch("/images/networks/phdc.png"); if (__r.ok) __phdcLogo = new Uint8Array(await __r.arrayBuffer()); } catch (e) {}
        const children = [];
        if (__phdcLogo) children.push(new D.Paragraph({ spacing: { after: 120 }, children: [new D.ImageRun({ data: __phdcLogo, transformation: { width: 210, height: 51 } })] }));
        children.push(new D.Paragraph({ children: [text(s.title || "(Untitled multi-national descriptive study)", { bold: true, size: 32 })], spacing: { before: 0, after: 120 } }));
        children.push(labelTable([
          ["Study ID", s.shortId || ""],
          ["Lead investigator(s)", s.leadInvestigator || ""],
          ["Version", s.version || ("v0.1 draft · " + today)],
          ["Design", "Multi-national descriptive epidemiology"],
        ]));
        const miss = missing(s);
        if (miss.length) children.push(p([text("This draft is incomplete. Still to be specified: " + miss.join("; ") + ".", { bold: true, color: "9E3A2C" })], { spacing: { before: 120, after: 120 } }));
        // The refusals, at the top, where a reader of the Word file cannot miss
        // them. Without this the whole error half of the consistency-check panel
        // stayed behind on the screen while the document read as settled.
        const blk = blockers(s);
        if (blk.length) {
          children.push(p([text("This draft specifies a metric it cannot compute.", { bold: true, color: "9E3A2C" })], { spacing: { before: 120, after: 40 } }));
          blk.forEach((b) => children.push(new D.Paragraph({ children: [text(b, { color: "9E3A2C" })], bullet: { level: 0 }, spacing: { before: 0, after: 40 } })));
        }

        window.PC.abstractDocx(D, pcOf(s)).forEach((c) => children.push(c));
        children.push(h1("1. Research question"));
        children.push(labelTable([
          ["Population", s.picoP || ""],
          ["What we measure", s.picoMeasure || ""],
          ["Time window", s.picoWindow || ""],
        ]));

        children.push(h1("2. Sites"));
        children.push(para(sitesText));
        const gaps = featureGaps(s);
        if (gaps.length) {
          children.push(p([text("Per-site metric feasibility. ", { bold: true }), text("The metrics and study text imply data features that some selected sites do not carry. State which sites contribute to which metric.")]));
          gaps.forEach((g) => children.push(bullet(gapLine(g))));
        }

        children.push(h1("3. Population (denominator)"));
        children.push(labelTable([
          ["Name", s.populationName || ""],
          ["Operational definition", s.populationDef || ""],
          ["Code set / criteria", s.populationCodes || ""],
          ["Index date rule", s.indexDateRule || ""],
          ["Study calendar period", s.studyCalendar || ""],
        ]));
        if (inclusion.length) { children.push(h2("Inclusion criteria")); inclusion.forEach((l) => children.push(bullet(l))); }
        if (exclusion.length) { children.push(h2("Exclusion criteria")); exclusion.forEach((l) => children.push(bullet(l))); }

        // HARPER item 7.2 — the study design diagram. The picture alone does not
        // satisfy it: an image-stripping extractor, and a reviewer reading the
        // .docx as text, see nothing. designDiagramDocx emits the picture, a
        // numbered caption and the written window list together, and that text is
        // what carries the item. It never throws; on failure it returns a visible
        // amber note rather than a silently absent figure, so the protocol still
        // exports and the page can say which of the two you got.
        lastFigNote = "";
        const __cap = "Figure 1. Study design diagram — cohort entry (day 0), the baseline look-back that precedes it, and the person-time / measurement window that follows, on a day axis.";
        const fig = await window.designDiagramFigure(document.getElementById("diagram"), { caption: __cap });
        const figParas = window.designDiagramDocx(D, fig, { font: FONT, caption: __cap });
        figParas.forEach((c) => children.push(c));
        if (!figParas.placed) lastFigNote = " Exported WITHOUT the design diagram: " + (fig.reason || figParas.error || "unknown reason") + ". The document says so where the figure should be.";

        children.push(h1("4. Numerator phenotypes"));
        children.push(labelTable([
          ["Drug exposure; name", s.exposureName || ""],
          ["Drug exposure; codes", s.exposureCodes || ""],
          ["Outcome; name", s.outcomeName || ""],
          ["Outcome; codes", s.outcomeCodes || ""],
          ["Outcome; operational definition", s.outcomeDef || ""],
          ["Cause of death; name", s.mortCauseName || ""],
          ["Cause of death; codes", s.mortCauseCodes || ""],
        ]));

        children.push(h1("5. Output metrics; selected"));
        if (ticked.length === 0) children.push(para("(none selected)"));
        else ticked.forEach((id) => {
          const m = OUTPUT_METRICS.find((x) => x.id === id);
          if (m) children.push(bullet(m.label));
        });

        children.push(h1("6. Stratification"));
        if (strata.length === 0) children.push(para("Overall only (no strata)"));
        else strata.forEach((l) => children.push(bullet(l)));

        // One section per ticked metric. The no-metric fallback below must stay
        // in lock-step with buildMarkdown's: it emits a section and advances the
        // counter, and when this file did not, a protocol with nothing ticked
        // numbered Statistical analysis "8." in the Markdown and "7." in the
        // Word file — and every section after it — so "as stated in section 9"
        // meant different sections depending on which export the reader had.
        let n = 7;
        let emitted = 0;
        for (const id of ticked) {
          const block = metricBlock(id, s);
          if (!block) continue;
          children.push(h1(`${n}. ${block.name}`));
          children.push(labelTable([
            ["Unit", block.unit],
            ["Numerator", block.numerator],
            ["Denominator", block.denominator],
            ["Formula", block.formula],
            ["Stratify by", block.stratifyBy],
          ]));
          n++; emitted++;
        }
        if (!emitted) {
          children.push(h1(`${n}. Output metrics`));
          children.push(p([text("No output metric is selected, so this protocol does not yet say what it measures. Tick at least one metric in Section 6 of the form.", { bold: true, color: "9E3A2C" })]));
          n++;
        }

        children.push(h1(`${n}. Statistical analysis`));
        children.push(labelTable([
          ["CI method", ciMethod],
          ["Cross-site comparison", meta],
          ["Site contribution model", pickTxt("contribution", s.contribution)],
          ["Suppression rule", orFb(s.suppression, NOTSET("no small-cell suppression rule has been set"))],
        ]));
        children.push(h2("Sensitivity analyses"));
        if (sensitivity.length === 0) children.push(para("(none specified)"));
        else sensitivity.forEach((l) => children.push(bullet(l)));
        n++;

        children.push(h1(`${n}. Execution and timeline`));
        children.push(labelTable([["Architecture", arch]]));
        children.push(h2("Timeline milestones"));
        if (milestones.length === 0) children.push(para("(none)"));
        else milestones.forEach((l) => children.push(numItem(l)));
        n++;

        children.push(h1(`${n}. Ethics, data sharing, dissemination`));
        children.push(p([text("Ethics. ", { bold: true }), text(orFb(s.ethics, NOTSET("the ethics section was left empty")))]));
        children.push(p([text("Dissemination. ", { bold: true }), text(orFb(s.dissemination, NOTSET("the dissemination section was left empty")))]));
        n++;

        window.PC.tailDocx(D, pcOf(s)).forEach((c) => children.push(c));
        children.push(h1(`${n}. Key references`));
        if (refs.length === 0) children.push(para("(none)"));
        else refs.forEach((l) => children.push(numItem(l)));

        children.push(p([new D.TextRun({ text: "Drafted with the Protocol Generator — descriptive analysis (" + today + ").", font: FONT, size: 18, italics: true, color: "808080" })], { spacing: { before: 400 } }));

        const doc = new D.Document({
          creator: "Protocol Generator — Descriptive Analysis",
          title: s.title || "Descriptive-analysis protocol",
          styles: {
            default: { document: { run: { font: FONT, size: 22 } } },
            paragraphStyles: [
              { id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 28, bold: true, font: FONT }, paragraph: { spacing: { before: 200, after: 80 }, outlineLevel: 0 } },
              { id: "Heading2", name: "Heading 2", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 24, bold: true, font: FONT }, paragraph: { spacing: { before: 160, after: 60 }, outlineLevel: 1 } },
            ],
          },
          numbering: { config: [{ reference: "ordered", levels: [{ level: 0, format: D.LevelFormat.DECIMAL, text: "%1.", alignment: D.AlignmentType.LEFT, style: { paragraph: { indent: { left: 720, hanging: 360 } } } }] }] },
          sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }],
        });
        return await D.Packer.toBlob(doc);
      };

      // ── Phenotype library modal ──
      const modal = document.querySelector("[data-library-modal]");
      const modalTitle = document.querySelector("[data-library-title]");
      const modalList = document.querySelector("[data-library-list]");
      const modalSearch = document.querySelector("[data-library-search]");
      let currentCategory = "populations";
      let currentTargets = {};
      const esc = (str) => String(str ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

      const renderLibrary = (filter = "") => {
        const items = PHENOTYPES[currentCategory] || [];
        const f = filter.trim().toLowerCase();
        const filtered = f ? items.filter((it) => (it.name || "").toLowerCase().includes(f) || (it.codes || "").toLowerCase().includes(f) || (it.definition || "").toLowerCase().includes(f) || (it.validation || "").toLowerCase().includes(f)) : items;
        if (filtered.length === 0) { modalList.innerHTML = '<p class="px-3 py-6 text-sm text-slate-500 italic text-center">No phenotype matches.</p>'; return; }
        modalList.innerHTML = filtered.map((it, idx) => `
          <button type="button" data-phenotype-idx="${idx}" class="block w-full text-left px-4 py-3 rounded-lg border border-transparent hover:border-brand-300 hover:bg-brand-50/40 transition">
            <p class="font-semibold text-slate-900 text-sm">${esc(it.name)}</p>
            ${it.codes ? `<p class="mt-1 text-xs text-slate-700 font-mono leading-relaxed">${esc(it.codes)}</p>` : ""}
            ${it.definition ? `<p class="mt-1 text-xs text-slate-600 leading-relaxed">${esc(it.definition)}</p>` : ""}
          </button>
        `).join("");
        modalList.querySelectorAll("[data-phenotype-idx]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const it = filtered[parseInt(btn.dataset.phenotypeIdx, 10)];
            if (!it) return;
            const fill = (key, val) => { const fieldName = currentTargets[key]; if (!fieldName || val === undefined) return; const el = form.querySelector(`[name="${fieldName}"]`); if (el) el.value = val; };
            fill("name", it.name);
            fill("codes", it.codes);
            fill("def", it.definition);
            if (it.validation) { pickedCitations[it.name] = it.validation; savePickedCitations(); }
            closeLibrary();
            render();
          });
        });
      };
      const openLibrary = (category, targets) => {
        currentCategory = category;
        currentTargets = targets;
        modalTitle.textContent = ({
          populations: "Pick a population (denominator)",
          exposures: "Pick a drug class (exposure)",
          outcomes: "Pick an outcome",
          mortalityCauses: "Pick a cause of death",
        })[category] || "Pick a phenotype";
        modalSearch.value = "";
        renderLibrary("");
        modal.classList.remove("hidden");
        setTimeout(() => modalSearch.focus(), 50);
      };
      const closeLibrary = () => modal.classList.add("hidden");
      document.querySelectorAll("[data-open-library]").forEach((btn) => {
        btn.addEventListener("click", () => openLibrary(btn.dataset.category, { name: btn.dataset.targetName, codes: btn.dataset.targetCodes, def: btn.dataset.targetDef }));
      });
      document.querySelector("[data-library-close]")?.addEventListener("click", closeLibrary);
      modal.addEventListener("click", (e) => { if (e.target === modal) closeLibrary(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeLibrary(); });
      modalSearch.addEventListener("input", () => renderLibrary(modalSearch.value));

      // Exported for testing (and any future reuse): the IIFE otherwise hides these.
      window.__builder = { readForm, buildMarkdown, buildDocx };

      setState("ready");
    })();
  </script>
</BaseLayout>
