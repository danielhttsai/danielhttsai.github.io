            stops.push({ field, msg: label + " is " + r.days + " days. " + o.why });
            return null;
          }
          return r.days;
        };
        const L = num(s.hazardLen, "hazardLen", "Hazard window length", { min: 1, why: "A hazard window of zero days contains no person-time, so the odds ratio has nothing in its numerator." });
        const g = num(s.hazardEnd, "hazardEnd", "Gap before the event", { min: 0, why: "" });
        const off = num(s.controlOffset, "controlOffset", "Offset to the first control window", { min: 1, why: "A control window at offset zero is the event day itself." });
        // Blank here has a stated meaning on the control's own label —
        // "blank = same as the hazard window (matched)" — so it is the one
        // field an empty box may answer for. It still needs a readable hazard
        // window to copy, which is why the fallback is L and not a constant.
        const C = num(s.controlLen, "controlLen", "Control window length", { min: 1, blankMeans: L, why: "A control window of zero days contains no person-time." });
        // Read like the rest, not with `parseInt(x) || 1`. It is the one number
        // here that comes from a <select>, and a select whose value a stale
        // draft blanked contributes nothing to FormData — so the old reading
        // turned a three-referent design into a one-referent design in silence.
        // The old ceiling of 6 was dead: the control offers at most 4.
        const n = num(s.nControls, "nControls", "Number of control windows", { min: 1, why: "A within-person contrast needs at least one referent window." });
        const ok = L !== null && g !== null && off !== null && C !== null && n !== null;
        if (!ok) return { ok: false, stops, L, g, C, off, n, haz: null, ctrls: [], wins: [], issues: [] };
        const haz = { label: "Hazard window", kind: "hazard", first: -(g + L - 1), last: -g, len: L };
        const ctrls = [];
        for (let k = 1; k <= n; k++) ctrls.push({ label: "Control window " + k, kind: "control", first: -(k * off + C - 1), last: -(k * off), len: C });
        // Each issue carries its own level. Deciding it later by matching the
        // prose (`/allowed, but/.test(i) ? "info" : "stop"`) meant rewording a
        // sentence silently promoted a heads-up to a blocker, or demoted one.
        const issues = [];
        if (off <= g + L - 1) issues.push({ lvl: "stop", t: "Control window 1 overlaps the hazard window. The hazard window reaches back to " + dTxt(haz.first) + " but control window 1's most recent day is " + dTxt(-off) + ". Overlapping windows double-count person-time and the conditional logistic model is not valid. Set the offset to at least " + (g + L) + " days." });
        else if (off === g + L) issues.push({ lvl: "warn", t: "Control window 1 ends the day before the hazard window begins: the hazard window is " + spanTxt(haz) + " and control window 1 reaches up to day " + dTxt(-off) + ", with no gap between them. The windows do not overlap, but an exposure whose effect persists into the hazard window — or a dispensing whose days of supply run across the boundary — makes the referent window exposed as well, which biases the odds ratio towards the null. Put a washout between them, or move the referent further back." });
        if (n > 1 && off < C) issues.push({ lvl: "stop", t: "The control windows overlap each other: " + C + "-day windows spaced only " + off + " days apart. Space them at least " + C + " days apart, or shorten the control window." });
        if (C !== L) issues.push({ lvl: "info", t: "Control windows (" + C + " d) are a different length from the hazard window (" + L + " d). This is allowed, but the windows are then no longer matched on duration; state explicitly in the analysis plan how unequal person-time is handled." });
        return { ok: true, stops, L, g, C, off, n, haz, ctrls, wins: [haz].concat(ctrls), issues };
      };
      // What the fixed-offset calculator above actually describes, per variant.
      // The diagram, section 6 and STROBE item 5 draw ONE scheme — evenly
      // spaced referent windows, every one of them before the event — and that
      // is the referent scheme of the standard design only. Choosing
      // "Symmetric bidirectional; controls before AND after event" used to
      // export that sentence directly above a table listing three referent
      // windows at days −66, −126 and −186: two statements of the referent
      // scheme in one document, and only one of them executable. The builder
      // cannot supply what it has no field for, so it says what is missing and
      // where the answer goes.
      const VARIANT_CAVEAT = {
        standard: "",
        "time-stratified": "The days listed above are the fixed-offset scheme of the standard design, not the time-stratified scheme this protocol names as its variant. Time-stratified referent selection partitions the study period into calendar strata and draws referent windows from the same stratum as the event — matched within the stratum, and falling both before and after it — so referents are not at a fixed offset from the event and this builder cannot lay them out on an event-anchored axis. State the stratum definition and the within-stratum matching rule here before circulating this protocol.",
        symmetric: "The days listed above are the pre-event half of the scheme only. Symmetric bidirectional sampling draws referent windows both before and after the event, and this builder has no field for the post-event windows, so it does not place them and has not drawn them. State the post-event referent windows explicitly here before circulating this protocol.",
        cctc: "The same referent scheme is applied twice — once to the current cases and once to the future-case control series — and the two odds ratios are divided (OR_CCTC = OR_case / OR_control). The days listed above describe the referent windows for both series.",
      };
      const variantCaveat = (s) => VARIANT_CAVEAT[s.ccoVariant] || "";
      // What the headline number is, and what it is not. The document reported
      // an odds ratio and said nothing about its scale — while section 8 of
      // every protocol on this site pools site estimates, and this site's other
      // builders produce hazard ratios and self-controlled incidence rate
      // ratios that are not the same quantity.
      // The checks, as the two exported documents and STROBE item 19 print
      // them. Says what it actually means when it is empty: this builder runs a
      // fixed set of pattern checks, and "nothing outstanding" is a statement
      // about those, not an attestation that the protocol is sound.
      // Which picked citations still belong to this draft. A citation travels
      // only while the field it was written into still names the phenotype it
      // validates; one that has lapsed is withheld from the reference list AND
      // named in the checks, because silently dropping a reference the user
      // believes they took from a validated library is its own failure.
      const liveCitations = (s) => {
        const live = [], lapsed = [];
        for (const [field, v] of Object.entries(pickedCitations)) {
          if (!v) continue;
          const rec = typeof v === "string" ? { wrote: null, cite: v } : v;
          if (!rec.cite || !rec.cite.trim()) continue;
          const now = String(s[field] == null ? "" : s[field]).trim();
          if (rec.wrote && now !== String(rec.wrote).trim()) lapsed.push({ field, wrote: rec.wrote, cite: rec.cite.trim(), now });
          else live.push(rec.cite.trim());
        }
        return { live, lapsed };
      };
      const CHK_ICON = { stop: "⛔", warn: "⚠", info: "ℹ" };
      const checksMd = (G, s) => {
        const notes = checksOf(G, s, true);
        if (!notes.length) return "_The builder's automatic checks on the window scheme, the design variant and the sensitivity list found nothing to raise against this draft. They are pattern checks over the fields on the form; they cannot tell you the design is right for your question._";
        return "**Checks the builder raises against this draft**\n\n" + notes.map((n) => "- " + CHK_ICON[n.lvl] + " **" + n.t + ".** " + n.d).join("\n");
      };
      const ESTIMAND_LIMIT = "The estimate is a within-person contrast computed in cases only: the odds of exposure during the hazard window against the odds of exposure during the same person's referent window(s). It carries no information about absolute risk — no risk difference, number needed to harm or excess incidence can be derived from it without an external denominator — and it is not interchangeable with a cohort hazard ratio, because the comparison is between periods within a case rather than between people. Pooling it with estimates from other designs requires that equivalence to be argued in the protocol, not assumed.";

      // One description of the window scheme, built once and consumed by the
      // Markdown protocol, the Word protocol and STROBE item 5. Three copies of
      // this table is how the sections of a document come to name three
      // different studies; this file already carried two.
      const geomRefusal = (G) =>
        "**This draft does not specify a window scheme.** " + G.stops.map((x) => x.msg).join(" ") +
        " Nothing has been assumed in its place — the hazard and referent windows are the estimand of a case-crossover study, so a length the builder could not read is left unstated rather than replaced by a plausible one. Fill the field(s) in and the windows will be stated here as inclusive day indices relative to the event.";
