${window.PC.tailMd(pcOf(s))}

## 12. Key references

${numbered(refs)}

---

_Drafted with the AsPEN case-crossover builder (${today})._
`;
      };

      const renderScheme = (s) => {
        const G = ccoGeom(s);
        // The shared diagram's default bar caption renders a 7-day window sitting
        // 60+ days back as "−2mo → −2mo" (its day formatter rounds to months), i.e.
        // a window of apparently zero length. Pass an explicit note so the caption
        // is the real length, and print the exact inclusive spans underneath.
        const wins = G.wins.map((w, i) => ({
          label: w.label, kind: w.kind, startDay: w.first, endDay: w.last, note: w.len + " d",
          edits: i === 0 ? [{ field: "hazardLen", edge: "start", allowPast: true }, { field: "hazardEnd", edge: "end", allowPast: true }]
               : i === 1 ? [{ field: "controlLen", edge: "start", allowPast: true }, { field: "controlOffset", edge: "end", allowPast: true }]
               : undefined,
        }));
        const onEdit = (field, day) => {
          const el = form.elements[field]; if (!el) return;
          const cur = ccoGeom(readForm());
          let v;
          if (field === "hazardLen") v = (-day) - cur.g + 1;        // start edge sits at -(g+L-1)
          else if (field === "hazardEnd") v = -day;                 // end edge sits at -g
          else if (field === "controlOffset") v = -day;             // control 1's end edge sits at -off
          else if (field === "controlLen") v = (-day) - cur.off + 1; // control 1's start edge sits at -(off+C-1)
          else return;
          v = Math.round(v);
          el.value = String(field === "hazardEnd" ? Math.max(0, v) : Math.max(1, v));
          render();
        };
        const chip = (c, t) => '<span class="inline-flex items-center gap-1.5 mr-4"><span class="inline-block w-2.5 h-2.5 rounded-sm" style="background:' + c + '"></span>' + t + '</span>';
        const scheme = document.getElementById("dscheme");
        // A picture is an assertion about geometry. When a length could not be
        // read there is no geometry to assert, so nothing is drawn — drawing
        // the clamped one-day window is what made the old bug invisible.
        if (!G.ok) {
          const dia = document.getElementById("diagram"); if (dia) dia.innerHTML = '<p class="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-lg p-3 leading-relaxed">No diagram is drawn: the window scheme is not determined by what the form currently says. See the checks above the form.</p>';
          const leg = document.getElementById("dlegend"); if (leg) leg.innerHTML = "";
          if (scheme) scheme.innerHTML = '<p class="text-slate-600">' + esc(G.stops.map((x) => x.msg).join(" ")) + "</p>";
          renderChecks(G, s);
          return;
        }
        window.renderDesignDiagram(document.getElementById("diagram"), document.getElementById("dlegend"), { windows: wins, indexLabel: "Event (day 0)", onEdit: onEdit, snap: 1 });
        if (scheme) scheme.innerHTML =
          '<p class="font-semibold text-slate-800">Windows, as inclusive days relative to the event</p><p class="mt-1 leading-relaxed">' +
          chip("#ef4444", "Hazard: " + spanTxt(G.haz)) +
          G.ctrls.map((c) => chip("#94a3b8", "Control " + c.label.replace(/\D+/g, "") + ": " + spanTxt(c))).join("") + "</p>" +
          (variantCaveat(s) ? '<p class="mt-2 text-slate-600 leading-relaxed"><span class="font-semibold">Referent scheme for the case-crossover variant you chose.</span> ' + esc(variantCaveat(s)) + "</p>" : "");
        renderChecks(G, s);
      };

      // Assumption checks that depend on what the user actually entered,
      // computed ONCE and painted into the panel, both exported protocols and
      // the STROBE checklist. Two of them used to exist only in the panel — and
      // the sharper of those two says, in effect, "do not use this variant for
      // dispensed medicines", so a protocol exported with bidirectional
      // referents selected carried section 7 naming them with no trace of the
      // objection. A check nobody outside the browser can see is not a check.
      // forDoc, because this list goes to two audiences. On screen a blocker
      // must say what to press; in the exported protocol there is nothing to
      // press, and "Choose the option you want, or confirm the one it was left
      // at" printed INSIDE a Word file reads as a defect in the document. Only
      // the stale-select note has a screen-only tail; every other note here is
      // already written to be true in both places. ITS, sequential-trial,
      // trend-in-trend and SCCS make the same split.
      // Flattened and capped. These sentences quote a value that came out of
      // somebody else's ?seed= link, and they are printed into the exported
      // protocol — where a newline ENDS the Markdown blockquote or list item and
      // the next line is free-standing Markdown. Measured: a seed carrying
      // "x\n\n## 99. Sponsor addendum\n\nAll sites must exclude…" put a real H2
      // and a paragraph of the sender's own instructions into the recipient's
      // protocol, straight after the title block, and it persisted across
      // reloads in the saved draft. Someone else's link is enough; nothing has
      // to be tampered with in this browser. The cap is separate and also
      // needed: a 4000-character value arrived verbatim.
      const clipStale = (v, n) => {
        const t = String(v == null ? "" : v).replace(/[\r\n\u2028\u2029]+/g, " ").replace(/\s{2,}/g, " ").trim();
        return t.length > n ? t.slice(0, n - 1) + "…" : t;
      };
      const checksOf = (G, s, forDoc) => {
        const notes = [];
        // Named here because the value is gone by the time an export runs: an
        // unmatched select contributes no FormData entry at all.
        const SELECT_LABEL = { ccoVariant: "the case-crossover variant", nControls: "the number of control windows", metaMethod: "the meta-analysis method", arch: "the architecture" };
        // The empty string gets its own branch: no form ever offered "", so
        // "which this form no longer offers" is not a true sentence about a
        // blank — and a draft or link that left the control blank is the
        // likeliest way this note fires at all.
        for (const st of staleSelects) notes.push({ lvl: "stop", dismiss: st.name, t: "A saved value was not one of the choices offered",
          d: 'This draft was restored with ' + (SELECT_LABEL[st.name] || st.name) + (String(st.want) === ""
              ? ' carrying no value at all — the draft or link it came from left it blank.'
              : ' saved as "' + clipStale(st.want, 80) + '", which this form no longer offers.')
            + ' It has been left at "' + clipStale(st.label, 70) + '", and that is what the exported protocol says — a specification nobody chose.'
            + (forDoc ? '' : ' Choose the option you want, or confirm the one it was left at.') });
        if (s.ccoVariant === "standard" || !s.ccoVariant) notes.push({ lvl: "warn", t: "No correction for exposure-time trend", d: "The standard (Maclure) variant compares a recent hazard window with older control windows, so any within-person drift in the probability of being on the drug is read as an effect. If the exposure is one whose use changes with worsening prognosis, choose a different case-crossover variant — time-stratified, or case-case-time-control — or state in the protocol why a trend is implausible here." });
        if (s.ccoVariant === "symmetric") notes.push({ lvl: "warn", t: "Bidirectional sampling assumes the event does not change later exposure", d: "Control windows drawn from after the event require exposure in that period to be unaffected by having had the event. For dispensed medicines that is usually false — an MI changes what is prescribed the next day. Bidirectional referents are standard for environmental exposures, not for drugs." });
        // The window calculator lays out one scheme: evenly spaced referent
        // windows, all of them before the event. For two of the four variants
        // that is not the referent scheme the variant names, and the form has no
        // field for the one it does name — so say so here and in the export
        // rather than printing a fixed-offset table under the wrong heading.
        if (s.ccoVariant === "time-stratified" || s.ccoVariant === "symmetric") {
          notes.push({ lvl: "warn", t: "The window calculator does not describe this variant's referent scheme", d: variantCaveat(s) + " The protocol says so where the days are listed; it does not present the fixed-offset windows as if they were the scheme you chose." });
        }
        for (const lc of liveCitations(s).lapsed) notes.push({ lvl: "warn", t: "A validation citation no longer matches its field", d: 'A validation study was added to the reference list when "' + lc.wrote + '" was picked from the phenotype library, but that field now reads "' + (lc.now || "(blank)") + '". The citation has been withheld from the exported reference list rather than left to describe an outcome the protocol no longer names. Pick the phenotype again from the library, or cite your own source.' });
        for (const st of G.stops) notes.push({ lvl: "stop", t: "Window scheme not specified", d: st.msg + " Nothing has been assumed in its place: the diagram is not drawn and the protocol says the scheme is unspecified rather than printing one." });
        for (const i of G.issues) notes.push({ lvl: i.lvl, t: "Window scheme", d: i.t });
        // A sensitivity analysis that IS the primary analysis is not a check on
        // anything. Both of these ship ticked, so an untouched page exports them.
        const sensPicks = s.sensitivityPick || [];
        const picked = (frag) => sensPicks.some((x) => x.indexOf(frag) === 0);
        // Deliberately ℹ, not ⚠. This one is ambiguous rather than wrong: with
        // three referent windows in the primary analysis, "multiple control
        // windows" may well mean "also try four", which is a real sensitivity
        // analysis. It ships ticked, so raising it as a warning would put an
        // amber mark on an untouched page — and marks on an untouched page are
        // what teach people to stop reading the panel.
        if (G.ok && G.n > 1 && picked("Multiple control windows")) notes.push({ lvl: "info", t: "Say how many referent windows the sensitivity analysis uses", d: "The primary analysis already uses " + G.n + " control windows, so “Multiple control windows” does not by itself describe anything different from it. Name the number it varies to." });
        if (s.ccoVariant === "time-stratified" && picked("Time-stratified case-crossover")) notes.push({ lvl: "warn", t: "A sensitivity analysis restates the primary analysis", d: "Time-stratified referent selection is already this protocol's design variant, so it cannot also be a sensitivity analysis against itself." });
        else if (picked("Time-stratified case-crossover")) notes.push({ lvl: "warn", t: "A promised sensitivity analysis has no window scheme", d: "The protocol promises a time-stratified sensitivity analysis, but the only window scheme it defines is the fixed-offset one, and this builder has no field for a calendar stratum — so the promised analysis is named and left operationally undefined. State the stratum definition and the within-stratum matching rule, or untick it." });
        if (s.ccoVariant !== "symmetric" && picked("Symmetric bidirectional sampling")) notes.push({ lvl: "warn", t: "Bidirectional referents assume the event does not change later exposure", d: "This is ticked as a sensitivity analysis. Referent windows drawn from after the event require exposure in that period to be unaffected by having had the event; for dispensed medicines that is usually false, and for a fatal outcome there is no post-event time at all. Bidirectional referents are standard for environmental exposures, not for drugs." });
        if (notes.length === 0) return notes;
        // A blocker printed below a heads-up is a blocker people scroll past.
        const rank = { stop: 0, warn: 1, info: 2 };
        notes.sort((a, b) => rank[a.lvl] - rank[b.lvl]);
        return notes;
      };
      const renderChecks = (G, s) => {
        const box = document.querySelector("[data-checks]"); if (!box) return;
        const notes = checksOf(G, s);
        if (notes.length === 0) { box.classList.add("hidden"); box.innerHTML = ""; return; }
        const style = { stop: ["bg-rose-50 border-rose-300", "text-rose-900", "⛔"], warn: ["bg-amber-50 border-amber-300", "text-amber-900", "⚠"], info: ["bg-slate-50 border-slate-300", "text-slate-700", "ℹ"] };
        box.innerHTML = '<p class="text-[10px] uppercase tracking-[0.2em] font-bold text-slate-500">Checks against what you entered</p><div class="mt-2 space-y-2">' +
          notes.map((n) => { const st = style[n.lvl]; return '<div class="rounded-lg border ' + st[0] + ' p-3 text-xs ' + st[1] + '"><p class="font-bold">' + st[2] + " " + esc(n.t) + '</p><p class="mt-1 leading-relaxed">' + esc(n.d) + "</p>" +
            (n.dismiss ? '<button type="button" data-dismiss-stale="' + esc(n.dismiss) + '" class="mt-2 text-[11px] font-semibold underline underline-offset-2 hover:no-underline">Keep what it was left at</button>' : "") + "</div>"; }).join("") + "</div>";
        box.querySelectorAll("[data-dismiss-stale]").forEach((btn) => btn.addEventListener("click", () => {
          staleSelects = staleSelects.filter((x) => x.name !== btn.dataset.dismissStale);
          render();
        }));
        box.classList.remove("hidden");
      };

      const render = () => {
        const state = readForm();
        preview.textContent = buildMarkdown(state);
        // The unanswered questions ride along with the draft; without this the
        // saved draft is the substituted state and the blocker dies on reload.
        const saved = staleSelects.length ? Object.assign({}, state, { [STALE_KEY]: staleSelects }) : state;
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(saved)); } catch (e) { console.warn("draft not saved", e); }
        renderFeasibility(state);
        // Never a bare catch here: a throw in the diagram used to blank it silently.
        try { renderScheme(state); } catch (e) { console.error("renderScheme failed", e); }
      };
      // Never a bare catch here: this is the only path that restores a saved
      // draft or a ?seed= link, and swallowing its failure loses the user's work
      // with no trace on screen or in the console.
      try { window.PC && PC.restore ? PC.restore(form, STORAGE_KEY, writeForm) : (localStorage.getItem(STORAGE_KEY) && writeForm(JSON.parse(localStorage.getItem(STORAGE_KEY)))); }
      catch (e) { console.error("could not restore the saved draft", e); setMsg("Your saved draft could not be restored; the form has been left at its defaults.", true); }
      const timelineTa = form.querySelector('[name="timeline"]');
      if (timelineTa && !timelineTa.value) timelineTa.value = TIMELINE_PRESETS["12-month"];
      // HARPER item 3. Mounted after restore so the editor paints the rows the
      // saved draft (or a ?seed= link) actually carried.
      if (window.PC && PC.mountAmendments) PC.mountAmendments(form);
      render();
      // Cleared per control, not globally: a blocker that survives the user
      // doing exactly what it asked is the thing that teaches people to ignore
      // the panel. Touch the select the message names and the message goes.
      const clearStale = (e) => {
        const el = e.target; if (!el || !el.name) return;
        const before = staleSelects.length;
        staleSelects = staleSelects.filter((x) => x.name !== el.name);
        if (staleSelects.length !== before) render();
      };
      form.addEventListener("input", render);
      form.addEventListener("change", (e) => { clearStale(e); render(); });
      form.addEventListener("click", (e) => {
        const tl = e.target?.closest?.("[data-timeline-preset]");
        if (tl) { const ta = form.querySelector('[name="timeline"]'); if (ta) { ta.value = TIMELINE_PRESETS[tl.dataset.timelinePreset] || ta.value; render(); } }
      });

      let lastFigNote = "";
      const buildFilename = (ext) => {
        const state = readForm();
        const slug = (state.shortId || "aspen-protocol-cco").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60) || "aspen-protocol-cco";
        const today = new Date().toISOString().slice(0, 10);
        return slug + "-" + today + "." + ext;
      };
      document.querySelector("[data-action='download-md']")?.addEventListener("click", () => {
        const blob = new Blob([preview.textContent || ""], { type: "text/markdown;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a"); a.href = url; a.download = buildFilename("md");
        document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
        setMsg("Downloaded " + a.download);
      });
      document.querySelector("[data-action='copy']")?.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(preview.textContent || ""); setMsg("Copied to clipboard."); }
        catch { setMsg("Couldn't copy; your browser may block clipboard access.", true); }
      });
      const doReset = () => {
        if (!confirm("Reset every field to its default and forget the saved draft?")) return;
        localStorage.removeItem(STORAGE_KEY); localStorage.removeItem(STORAGE_CITATIONS_KEY); pickedCitations = {}; staleSelects = [];
        // "Start over" means exactly the page a first-time visitor sees, not an
        // empty one. Emptying stripped defaults the protocol goes on asserting
        // anyway (the exposure rule, the primary model, the reference list) — a
        // blank field that the export silently refills is the same trap as a
        // blank field that silently becomes a default.
        form.querySelectorAll("input, textarea, select").forEach((el) => {
          if (el.type === "checkbox" || el.type === "radio") el.checked = el.defaultChecked;
          else if (el.tagName === "SELECT") { const i = [...el.options].findIndex((o) => o.defaultSelected); el.selectedIndex = i < 0 ? 0 : i; }
          else el.value = el.defaultValue;
        });
        // The timeline preset is applied by script, not by markup, so it has no
        // defaultValue to come back from.
        const tl = form.querySelector('[name="timeline"]');
        if (tl && !tl.value) tl.value = TIMELINE_PRESETS["12-month"];
        if (window.PC && PC.syncAmendments) PC.syncAmendments(form);
        render();
        setMsg("Reset to defaults.");
      };
      document.querySelector("[data-action='reset']")?.addEventListener("click", doReset);
      document.querySelector("[data-action='reset-top']")?.addEventListener("click", doReset);

      document.querySelector("[data-action='download-docx']")?.addEventListener("click", async () => {
        if (typeof docx === "undefined") { setMsg("Word library failed to load.", true); return; }
        setMsg("Building Word document…");
        try {
          const blob = await buildDocx(readForm());
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a"); a.href = url; a.download = buildFilename("docx");
          document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
          setMsg("Downloaded " + a.download + lastFigNote, !!lastFigNote);
        } catch (e) { console.error(e); setMsg("Couldn't build the Word file: " + String(e), true); }
      });

      // ── STROBE checklist (.docx) ──────────────────────────
      document.querySelector("[data-action='download-strobe']")?.addEventListener("click", async () => {
        if (typeof docx === "undefined") { setMsg("Word library failed to load.", true); return; }
        setMsg("Building STROBE checklist…");
        try {
          const s = readForm();
          const blob = await buildStrobeDocx(s);
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          const today = new Date().toISOString().slice(0, 10);
          a.href = url;
          a.download = orFb(s.shortId, "case-crossover").replace(/[^a-z0-9]+/gi, "-").toLowerCase() + "-STROBE-checklist-" + today + ".docx";
          document.body.appendChild(a); a.click(); a.remove();
          URL.revokeObjectURL(url);
          setMsg("Downloaded " + a.download);
        } catch (e) { console.error(e); setMsg("Couldn't build the STROBE checklist: " + String(e), true); }
      });

      // Map this case-crossover protocol's fields onto the STROBE items.
      const strobeWhere = (s) => {
        const sitesPlain = (() => {
          const parts = (s.sites || []).map((c) => formatSiteFull(c));
          const others = (s.sitesOther || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
          return [...parts, ...others].join("; ") || "(no sites selected)";
        })();
        const bul = (a) => a.length ? a.map((x) => "• " + x).join("\n") : "(none specified)";
        const sens = mergeList(s.sensitivityPick, s.sensitivityCustom);
        const subg = mergeList(s.subgroupsPick, s.subgroupsCustom);
        const variant = ({ standard: "Standard (Maclure 1991)", "time-stratified": "Time-stratified (Janes 2005)", symmetric: "Symmetric bidirectional", cctc: "Case-case-time-control (Huang/Yang/Tsai BMJ 2023)" })[s.ccoVariant] || "Standard (Maclure 1991)";
        const isCctc = s.ccoVariant === "cctc";
        const GG = ccoGeom(s);
        const metaTxt = ({ re: "random-effects (DerSimonian-Laird)", "re-reml": "random-effects (REML)", fe: "fixed-effects (inverse-variance)" })[s.metaMethod] || "random-effects";
        return {
          "1a": "Multi-national case-crossover study" + (isCctc ? " (case-case-time-control variant)." : "."),
          "3": "Among cases of " + orFb(s.picoO, "(outcome)") + ", is " + orFb(s.picoI, orFb(s.exposureName, "(exposure)")) + " more likely during the pre-event hazard window than during matched referent windows in the same person?",
          "4": "Case-crossover (" + variant + "). Each case serves as their own control; exposure in a pre-event hazard window is compared with matched referent window(s) in the same individual, removing all time-invariant between-person confounding." + (isCctc ? " A future-case control series corrects for exposure-time trend: OR_CCTC = OR_case / OR_control." : ""),
          "5": "AsPEN sites: " + sitesPlain + ". " + (GG.ok
            ? ("Windows, as inclusive days relative to the event (day 0): hazard " + spanTxt(GG.haz) + "; " + GG.ctrls.map((c, i) => "control " + (i + 1) + " " + spanTxt(c)).join("; ") + ". Cases require continuous data coverage from day " + dTxt(GG.ctrls[GG.ctrls.length - 1].first) + " onwards." + (variantCaveat(s) ? " " + variantCaveat(s) : ""))
            : ("The window scheme is not specified in this draft, and nothing has been assumed in its place. " + GG.stops.map((x) => x.msg).join(" "))),
          "6": "Cases experiencing " + orFb(s.picoO, "the outcome") + " during the study period. Case definition: " + orFb(s.outcomeDef, "(case definition)") + " (" + orFb(s.outcomeCodes, "codes TBD") + ").",
          "7": "Exposure: " + orFb(s.exposureName, orFb(s.picoI, "(exposure)")) + " (" + orFb(s.exposureCodes, "codes TBD") + "). Outcome (case): " + orFb(s.picoO, "(outcome)") + ". Hazard-vs-referent window scheme per the protocol.",
          "8": "Routinely-collected health data from the contributing databases (" + sitesPlain + "). Exposure and outcome ascertained from dispensing / diagnosis records by the protocol code sets.",
          "9": "Self-matched design removes fixed confounders. Exposure-time-trend bias addressed by the referent-window scheme" + (isCctc ? " and the case-case-time-control correction" : "") + "; further sensitivity analyses:\n" + bul(sens),
          "12": "Conditional logistic regression for the odds ratio, matching each case's hazard window to their referent window(s)" + (isCctc ? "; the control (future-case) crossover OR is divided out (CCTC)" : "") + ". Site-specific ORs pooled by " + metaTxt + " meta-analysis (report I², τ²). Subgroups:\n" + bul(subg) + "\nSensitivity analyses:\n" + bul(sens),
          "17": "Pre-specified subgroups:\n" + bul(subg) + "\nSensitivity analyses:\n" + bul(sens),
          "19": "The case-crossover design controls time-invariant confounding but is susceptible to exposure-time-trend bias if exposure prevalence changes over time (mitigated by referent selection / the CCTC variant); it assumes transient exposure and abrupt outcome onset, and that hazard and referent windows are non-overlapping eligible person-time; outcome misclassification is possible. " + ESTIMAND_LIMIT + (() => { const n = checksOf(GG, s, true); return n.length ? " Checks the builder raises against the current draft, stated in full in the protocol's design-assumptions section: " + n.map((x) => CHK_ICON[x.lvl] + " " + x.t).join("; ") + "." : ""; })(),
          "21": "Results generalise to the source populations of the contributing AsPEN databases: " + sitesPlain + ".",
        };
      };

      const buildStrobeDocx = async (s) => {
        const D = docx;
        const FONT = "Times New Roman";
        const today = new Date().toISOString().slice(0, 10);
        const text = (str, o = {}) => new D.TextRun({ text: String(str ?? ""), font: FONT, size: 22, ...o });
        const p = (ch, o = {}) => new D.Paragraph({ children: Array.isArray(ch) ? ch : [ch], spacing: { before: 50, after: 50 }, ...o });
        const border = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" };
        const cb = { top: border, bottom: border, left: border, right: border };
        const cell = (children, opt = {}) => new D.TableCell({ borders: cb, margins: { top: 60, bottom: 60, left: 120, right: 120 }, ...opt, children });
        const headerCell = (str) => new D.TableCell({ borders: cb, shading: { fill: "21443E", type: D.ShadingType.CLEAR }, margins: { top: 80, bottom: 80, left: 120, right: 120 }, children: [p([text(str, { bold: true, color: "FFFFFF" })])] });
        const where = strobeWhere(s);
        const rows = [new D.TableRow({ tableHeader: true, children: [headerCell("#"), headerCell("STROBE recommendation"), headerCell("Where addressed in this protocol")] })];
        for (const sec of STROBE_ITEMS) {
          rows.push(new D.TableRow({ children: [new D.TableCell({ borders: cb, columnSpan: 3, shading: { fill: "E8F0EE", type: D.ShadingType.CLEAR }, margins: { top: 60, bottom: 60, left: 120, right: 120 }, children: [p([text(sec.section, { bold: true, color: "21443E" })])] })] }));
          for (const [n, rec] of sec.items) {
            const w = where[n] || "[To be completed at the time of reporting.]";
            rows.push(new D.TableRow({ children: [
              cell([p([text(n, { bold: true })])], { width: { size: 700, type: D.WidthType.DXA }, shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR } }),
              cell([p([text(rec)])], { width: { size: 4163, type: D.WidthType.DXA } }),
              cell(String(w).split("\n").map((l) => p([text(l)])), { width: { size: 4163, type: D.WidthType.DXA } }),
            ] }));
          }
        }
        const table = new D.Table({ width: { size: 9026, type: D.WidthType.DXA }, columnWidths: [700, 4163, 4163], rows });
        const children = [
          new D.Paragraph({ children: [text("STROBE checklist; " + orFb(s.title, "(Untitled multi-national case-crossover study)"), { bold: true, size: 32 })], spacing: { after: 120 } }),
          // Computed, not asserted. The old sentence claimed "Methods items are
          // pre-filled; Results / Discussion items are placeholders" and was
          // false in both directions: items 17, 19 and 21 are Results and
          // Discussion items and ARE pre-filled, while Methods item 10 (study
          // size) is not. Same defect found and fixed in descriptive-analysis.
          p([new D.TextRun({ text: "This document maps the protocol fields to the STROBE statement (von Elm E, et al. PLoS Med 2007;4:e296). " + (() => { const keys = Object.keys(where); const all = STROBE_ITEMS.flatMap((sec) => sec.items.map(([n]) => n)); return keys.length + " of the " + all.length + " checklist items are pre-filled from your protocol (" + all.filter((n) => keys.includes(n)).join(", ") + "); the rest are placeholders to complete at the time of reporting."; })() + " Full checklist with elaboration: strobe-statement.org.", font: FONT, size: 20, italics: true, color: "555555" })]),
          p([new D.TextRun({ text: "Generated " + today + " from the AsPEN case-crossover protocol builder.", font: FONT, size: 18, italics: true, color: "777777" })]),
          table,
        ];
        const doc = new D.Document({ sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }] });
        return await D.Packer.toBlob(doc);
      };

      const buildDocx = async (s) => {
        const D = docx;
        const FONT = "Times New Roman";
        const today = new Date().toISOString().slice(0, 10);
        const text = (str, opts = {}) => new D.TextRun({ text: String(str ?? ""), font: FONT, size: 22, ...opts });
        const p = (children, opts = {}) => new D.Paragraph({ children: Array.isArray(children) ? children : [children], spacing: { before: 60, after: 60, ...(opts.spacing || {}) }, ...opts });
        const h1 = (str) => new D.Paragraph({ children: [text(str, { bold: true, size: 28 })], spacing: { before: 200, after: 80 }, heading: D.HeadingLevel.HEADING_1 });
        const h2 = (str) => new D.Paragraph({ children: [text(str, { bold: true, size: 24 })], spacing: { before: 160, after: 60 }, heading: D.HeadingLevel.HEADING_2 });
        const para = (str) => p([text(str)]);
        const bullet = (str) => new D.Paragraph({ children: [text(str)], bullet: { level: 0 }, spacing: { before: 0, after: 0 } });
        const numItem = (str) => new D.Paragraph({ children: [text(str)], numbering: { reference: "ordered", level: 0 }, spacing: { before: 0, after: 0 } });
        const border = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" };
        const cellBorders = { top: border, bottom: border, left: border, right: border };
        const labelTable = (rows) => new D.Table({
          width: { size: 9026, type: D.WidthType.DXA },
          columnWidths: [3000, 6026],
          rows: rows.map(([l, v]) => new D.TableRow({
            children: [
              new D.TableCell({ borders: cellBorders, width: { size: 3000, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR }, children: [p([text(l, { bold: true })])] }),
              new D.TableCell({ borders: cellBorders, width: { size: 6026, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, children: [p([text(v || "-")])] }),
            ],
          })),
        });

        const refsUser = (s.references || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const refs = (() => { const set = new Set(refsUser); for (const c of liveCitations(s).live) set.add(c); return Array.from(set); })();
        const milestones  = (s.timeline  || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const subgroups   = mergeList(s.subgroupsPick, s.subgroupsCustom);
        const sensitivity = mergeList(s.sensitivityPick, s.sensitivityCustom);
        const sitesPart = (s.sites && s.sites.length > 0) ? s.sites.map((c) => formatSiteFull(c)).join("; ") : "";
        const sitesOthersList = (s.sitesOther || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        const sitesText = !sitesPart && sitesOthersList.length === 0 ? "(no sites selected)" : [sitesPart, sitesOthersList.length > 0 ? ("Others: " + sitesOthersList.join("; ")) : ""].filter(Boolean).join(" | ");
        const G = ccoGeom(s);
        const variant = ({ standard: "Standard (Maclure 1991)", "time-stratified": "Time-stratified (Janes 2005)", symmetric: "Symmetric bidirectional", cctc: "Case-case-time-control (Huang/Yang/Tsai BMJ 2023; PMID 37758279)" })[s.ccoVariant] || "Standard";
        const meta = ({ re: "Random-effects (DerSimonian-Laird)", "re-reml": "Random-effects (REML)", fe: "Fixed-effects (inverse-variance)" })[s.metaMethod] || "Random-effects";
        const arch = ({ federated: "Federated; each AsPEN site executes locally; aggregate ORs leave.", cdm: "Common Data Model; transforms to OMOP/Sentinel, runs shared package.", centralised: "Centralised; pooled individual data under DUA." })[s.arch] || "Federated";

        let __phdcLogo = null; try { const __r = await fetch("/images/networks/phdc.png"); if (__r.ok) __phdcLogo = new Uint8Array(await __r.arrayBuffer()); } catch (e) {}
        const children = [];
        if (__phdcLogo) children.push(new D.Paragraph({ spacing: { after: 120 }, children: [new D.ImageRun({ data: __phdcLogo, transformation: { width: 210, height: 51 } })] }));
        children.push(new D.Paragraph({ children: [text(orFb(s.title, "(Untitled multi-national case-crossover study)"), { bold: true, size: 32 })], spacing: { before: 0, after: 120 } }));
        children.push(labelTable([
          ["Study ID", orFb(s.shortId, "")],
          ["Lead investigator(s)", orFb(s.leadInvestigator, "")],
          ["Version", orFb(s.version, "v0.1 draft · " + today)],
          ["Design", "Multi-national case-crossover study"],
        ]));

        window.PC.abstractDocx(D, pcOf(s)).forEach((c) => children.push(c));
        children.push(h1("1. Research question"));
        children.push(labelTable([["Population", orFb(s.picoP, "")], ["Exposure", orFb(s.picoI, "")], ["Outcome (case)", orFb(s.picoO, "")]]));

        children.push(h1("2. Sites"));
        children.push(para(sitesText));

        children.push(h1("3. Case definition"));
        children.push(p([text("Operational definition. ", { bold: true }), text(orFb(s.outcomeDef, "-"))]));
        children.push(p([text("Code set. ", { bold: true }), text(orFb(s.outcomeCodes, "-"))]));
        children.push(p([text("Index date. ", { bold: true }), text(orFb(s.indexDateDef, FB.indexDate))]));

        children.push(h1("4. Exposure definition"));
        children.push(labelTable([
          ["Name", orFb(s.exposureName, "")],
          ["Code set", orFb(s.exposureCodes, "")],
          ["Ascertainment rule", orFb(s.exposureRule, FB.exposureRule)],
        ]));

        children.push(h1("5. Hazard (case) window"));
        if (G.ok) children.push(labelTable(hazardRows(G)));
        else children.push(p([text("This draft does not specify a window scheme. ", { bold: true }), text(G.stops.map((x) => x.msg).join(" ") + " Nothing has been assumed in its place — the hazard and referent windows are the estimand of a case-crossover study, so a length the builder could not read is left unstated rather than replaced by a plausible one.")]));

        lastFigNote = "";
        // HARPER item 7.2 — the study design diagram. The page drew one on
        // screen and the Word protocol shipped without it. It belongs here,
        // between the two window sections it illustrates. Two things it needs
        // from this page:
        //  * The written window list. That text, not the picture, is all a
        //    reviewer or an extractor reading the .docx as text can see. The
        //    shared helper builds it with its own day formatter, which rounds
        //    −60 to "−2mo" — so a 7-day referent window came out as
        //    "day −66d to −2mo". The exact inclusive spans this page already
        //    computes are substituted instead.
        //  * Nothing at all when the window scheme could not be read. There is
        //    no geometry to draw, and the helper's stock failure note asks the
        //    user to "paste a screenshot of the on-screen diagram" — right for a
        //    rendering failure, wrong for a principled refusal, and there is no
        //    on-screen diagram to paste.
        if (G.ok) {
          const FIG_CAPTION = "Figure 1. Case-crossover window scheme — the hazard window and the referent window(s) as inclusive day indices relative to the event (day 0).";
          const fig = await window.designDiagramFigure(document.getElementById("diagram"), { caption: FIG_CAPTION });
          if (fig) fig.lines = ["Hazard window: " + spanTxt(G.haz) + (G.g > 0 ? " (the event day and the " + G.g + " day(s) before it are excluded)" : " (the event day is included)")].concat(G.ctrls.map((c, i) => "Control window " + (i + 1) + ": " + spanTxt(c))).concat(variantCaveat(s) ? ["Referent scheme for the variant chosen in this protocol: " + variantCaveat(s)] : []);
          const figParas = window.designDiagramDocx(D, fig, { font: FONT, caption: FIG_CAPTION });
          figParas.forEach((c) => children.push(c));
          if (!figParas.placed) lastFigNote = " Exported WITHOUT the design diagram: " + ((fig && fig.reason) || figParas.error || "unknown reason") + ". The document says so where the figure should be.";
        } else {
          children.push(p([new D.TextRun({ text: "[No study design diagram is included: the window scheme is not determined by what the form says, so there is no geometry to draw. HARPER item 7.2 requires a design diagram — specify the window lengths named in section 5 and re-export.]", font: FONT, size: 18, italics: true, color: "B45309" })]));
        }

        children.push(h1("6. Control (referent) window(s)"));
        if (G.ok) {
          children.push(labelTable(controlRows(G, s)));
          children.push(para(coverageLine(G)));
        } else {
          children.push(para("See section 5."));
        }
        if (variantCaveat(s)) children.push(p([text("Referent scheme for the variant chosen in this protocol. ", { bold: true }), text(variantCaveat(s))]));

        children.push(h1("7. Design variant"));
        children.push(para(variant));

        children.push(h1("8. Design assumptions and checks"));
        ASSUMPTIONS.forEach((a, i) => {
          children.push(p([text((i + 1) + ". " + a.t + ". ", { bold: true }), text(a.plain)]));
          children.push(p([text("Why it matters. ", { italics: true }), text(a.precise)]));
          children.push(p([text("What we do about it. ", { italics: true }), text(a.check + " [" + a.cite + "]")]));
        });
        const chkNotes = checksOf(G, s, true);
        if (chkNotes.length) {
          children.push(h2("Checks the builder raises against this draft"));
          chkNotes.forEach((n) => children.push(bullet(CHK_ICON[n.lvl] + " " + n.t + ". " + n.d)));
        } else {
          children.push(para("The builder's automatic checks on the window scheme, the design variant and the sensitivity list found nothing to raise against this draft. They are pattern checks over the fields on the form; they cannot tell you the design is right for your question."));
        }
        children.push(h2("What the estimate is"));
        children.push(para(ESTIMAND_LIMIT));

        children.push(h1("9. Statistical analysis"));
        children.push(labelTable([
          ["Primary model", orFb(s.primaryModel, FB.primaryModel)],
          ["Effect estimate", orFb(s.effectMeasure, FB.effectMeasure)],
          ["Meta-analysis", meta],
        ]));
        children.push(h2("Subgroup analyses"));
        subgroups.length ? subgroups.forEach((l) => children.push(bullet(l))) : children.push(para("(none specified)"));
        children.push(h2("Sensitivity analyses"));
        sensitivity.length ? sensitivity.forEach((l) => children.push(bullet(l))) : children.push(para("(none specified)"));

        children.push(h1("10. Execution and timeline"));
        children.push(labelTable([["Architecture", arch]]));
        children.push(h2("Timeline milestones"));
        milestones.length ? milestones.forEach((l) => children.push(numItem(l))) : children.push(para("(none)"));

        children.push(h1("11. Ethics, data sharing, dissemination"));
        children.push(p([text("Ethics. ", { bold: true }), text(orFb(s.ethics, FB.ethics))]));
        children.push(p([text("Dissemination. ", { bold: true }), text(orFb(s.dissemination, FB.dissemination))]));

        window.PC.tailDocx(D, pcOf(s)).forEach((c) => children.push(c));
        children.push(h1("12. Key references"));
        refs.length ? refs.forEach((l) => children.push(numItem(l))) : children.push(para("(none)"));

        children.push(p([new D.TextRun({ text: "Drafted with the AsPEN case-crossover builder (" + today + ").", font: FONT, size: 18, italics: true, color: "808080" })], { spacing: { before: 400 } }));

        const doc = new D.Document({
          creator: "AsPEN protocol builder",
          title: orFb(s.title, "AsPEN case-crossover protocol"),
          styles: { default: { document: { run: { font: FONT, size: 22 } } }, paragraphStyles: [
            { id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 28, bold: true, font: FONT }, paragraph: { spacing: { before: 200, after: 80 }, outlineLevel: 0 } },
            { id: "Heading2", name: "Heading 2", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 24, bold: true, font: FONT }, paragraph: { spacing: { before: 160, after: 60 }, outlineLevel: 1 } },
          ] },
          numbering: { config: [{ reference: "ordered", levels: [{ level: 0, format: D.LevelFormat.DECIMAL, text: "%1.", alignment: D.AlignmentType.LEFT, style: { paragraph: { indent: { left: 720, hanging: 360 } } } }] }] },
          sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }],
        });
        return await D.Packer.toBlob(doc);
      };

      // Library modal
      const modal = document.querySelector("[data-library-modal]");
      const modalTitle = document.querySelector("[data-library-title]");
      const modalList = document.querySelector("[data-library-list]");
      const modalSearch = document.querySelector("[data-library-search]");
      let currentCategory = "outcomes";
      let currentTargets = {};

      const renderLibrary = (filter = "") => {
        const items = PHENOTYPES[currentCategory] || [];
        const f = filter.trim().toLowerCase();
        const filtered = f ? items.filter((it) => (it.name || "").toLowerCase().includes(f) || (it.codes || "").toLowerCase().includes(f) || (it.definition || "").toLowerCase().includes(f) || (it.validation || "").toLowerCase().includes(f)) : items;
        if (filtered.length === 0) { modalList.innerHTML = '<p class="px-3 py-6 text-sm text-slate-500 italic text-center">No phenotype matches.</p>'; return; }
        // The validation citation used to be hidden here and appended silently
        // to the exported reference list. Whether a definition has been
        // validated, in which coding system, is the single most important thing
        // about it — so it is shown at the moment of picking, and an entry with
        // no validation study says so rather than saying nothing.
        modalList.innerHTML = filtered.map((it, idx) => `
          <button type="button" data-phenotype-idx="${idx}" class="block w-full text-left px-4 py-3 rounded-lg border border-transparent hover:border-brand-300 hover:bg-brand-50/40 transition">
            <p class="font-semibold text-slate-900 text-sm">${esc(it.name)}</p>
            ${it.codes ? `<p class="mt-1 text-xs text-slate-700 font-mono leading-relaxed">${esc(it.codes)}</p>` : ""}
            ${it.definition ? `<p class="mt-1 text-xs text-slate-600 leading-relaxed">${esc(it.definition)}</p>` : ""}
            ${"validation" in it ? (it.validation
              ? `<p class="mt-1.5 text-[11px] text-emerald-800 leading-relaxed"><span class="font-bold uppercase tracking-widest text-[9px]">Validation study</span> · ${esc(it.validation)}${it.validationNote ? " " + esc(it.validationNote) : ""} <span class="text-slate-500">Added to the protocol's reference list.</span></p>`
              : `<p class="mt-1.5 text-[11px] text-amber-800 leading-relaxed"><span class="font-bold uppercase tracking-widest text-[9px]">No validation study</span> · This library carries no study measuring the accuracy of this definition. Nothing is added to the reference list; cite your own source for its positive predictive value.</p>`) : ""}
            ${it.provenance ? `<p class="mt-1 text-[11px] text-slate-500 leading-relaxed"><span class="font-bold uppercase tracking-widest text-[9px]">Used in</span> · ${esc(it.provenance)}</p>` : ""}
          </button>
        `).join("");
        modalList.querySelectorAll("[data-phenotype-idx]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const it = filtered[parseInt(btn.dataset.phenotypeIdx, 10)];
            if (!it) return;
            const fill = (key, val) => { const fieldName = currentTargets[key]; if (!fieldName || val === undefined) return; const el = form.querySelector(`[name="${fieldName}"]`); if (el) el.value = val; };
            fill("name", it.name); fill("codes", it.codes); fill("def", it.definition);
            if (currentTargets.alsoFill) { const el = form.querySelector(`[name="${currentTargets.alsoFill}"]`); if (el && it.name) el.value = it.name; }
            // Keyed by the FIELD the pick wrote into, not by the phenotype's
            // name. Keyed by name, nothing ever evicted anything: pick MI,
            // change your mind and pick hip fracture, and the exported protocol
            // — Markdown and Word alike — cited an MI validation study as a
            // numbered reference in a hip-fracture study, for an outcome
            // appearing nowhere else in the document. It survived a reload and
            // was cleared only by "Clear all". Browsing five outcomes while
            // deciding exported five validation citations. A second pick into
            // the same field now replaces the first, deterministically.
            // Keyed by the field that carries the phenotype's NAME, and the
            // name written there is stored beside the citation. Keying by the
            // definition textarea was not enough: pick MI, then hand-edit the
            // definition, the code set and the outcome name to hip fracture,
            // and the MI validation study stayed in the reference list for an
            // outcome appearing nowhere else in the document — the exact
            // sentence this fix was written to prevent, reached by editing
            // instead of by a second pick. Picking from the library and then
            // tuning the wording is the normal workflow.
            //
            // The comparison is equality against what the pick wrote, not a
            // substring search: the SCCS builder was caught by substring
            // matching in both directions at once — rewording an outcome
            // deleted its reference silently, and naming a phenotype in an
            // inclusion criterion revived an unrelated validation study.
            const citeKey = currentTargets.name || currentTargets.alsoFill || currentTargets.def || "picked";
            const citeVal = currentTargets.name ? it.name : (currentTargets.alsoFill ? it.name : it.definition);
            if (it.validation) pickedCitations[citeKey] = { wrote: citeVal, cite: it.validation };
            else delete pickedCitations[citeKey];
            savePickedCitations();
            closeLibrary();
            render();
          });
        });
      };
      const openLibrary = (category, targets) => {
        currentCategory = category;
        currentTargets = targets;
        modalTitle.textContent = ({ outcomes: "Pick an outcome (case definition)", exposures: "Pick a drug class (exposure)" })[category] || "Pick a phenotype";
        modalSearch.value = "";
        renderLibrary("");
        modal.classList.remove("hidden");
        setTimeout(() => modalSearch.focus(), 50);
      };
      const closeLibrary = () => modal.classList.add("hidden");
      document.querySelectorAll("[data-open-library]").forEach((btn) => {
        btn.addEventListener("click", () => openLibrary(btn.dataset.category, { name: btn.dataset.targetName, codes: btn.dataset.targetCodes, def: btn.dataset.targetDef, alsoFill: btn.dataset.alsoFill }));
      });
      document.querySelector("[data-library-close]")?.addEventListener("click", closeLibrary);
      modal.addEventListener("click", (e) => { if (e.target === modal) closeLibrary(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeLibrary(); });
      modalSearch.addEventListener("input", () => renderLibrary(modalSearch.value));

      // Exported for testing (and any future reuse): the IIFE otherwise hides these.
      window.__builder = { readForm, buildMarkdown, buildDocx };

      setState("ready");
    })();
  </script>
</BaseLayout>
