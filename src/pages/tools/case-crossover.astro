      </div>
    </div>
  </section>

  <script src="https://unpkg.com/docx@8.5.0/build/index.umd.js" is:inline></script>

  <script is:inline define:vars={{ BASE: base, SITES_DETAIL_MAP, FEATURES, PHENOTYPES, TIMELINE_PRESETS, STROBE_ITEMS, ASSUMPTIONS }}>
    (() => {
      const setState = (name) => { document.querySelectorAll("[data-state]").forEach((el) => el.classList.toggle("hidden", el.dataset.state !== name)); };

      const STORAGE_KEY = "aspen.protocol-builder.cco";
      const STORAGE_CITATIONS_KEY = "aspen.protocol-builder.cco.citations";
      const form = document.querySelector("[data-builder]");
      const preview = document.querySelector("[data-preview]");
      const actionMsg = document.querySelector("[data-action-msg]");
      const setMsg = (msg, isError = false) => { if (!actionMsg) return; actionMsg.textContent = msg; actionMsg.classList.toggle("text-rose-700", isError); actionMsg.classList.toggle("text-brand-700", !isError); };
      let pickedCitations = {};
      try { pickedCitations = JSON.parse(localStorage.getItem(STORAGE_CITATIONS_KEY) || "{}") || {}; } catch {}
      // Entries saved before citations were keyed by field are keyed by the
      // phenotype's name, and nothing would ever evict them — so a browser that
      // has visited this page before would carry them into every future
      // protocol. Anything not keyed by a field this page fills is dropped.
      {
        // Must match the write-side `citeKey` expression exactly, or a
        // legitimate citation is pruned on the next load. Kept adjacent for
        // that reason; this file has been bitten three times by two copies of
        // one lookup drifting apart.
        const validKeys = new Set([...document.querySelectorAll("[data-open-library]")].map((b) => b.dataset.targetName || b.dataset.alsoFill || b.dataset.targetDef).filter(Boolean));
        for (const k of Object.keys(pickedCitations)) if (!validKeys.has(k)) delete pickedCitations[k];
      }
      const savePickedCitations = () => { try { localStorage.setItem(STORAGE_CITATIONS_KEY, JSON.stringify(pickedCitations)); } catch {} };
      // Declared up here, not next to the library modal: renderChecks() runs on
      // first paint, and a const used above its declaration is a dead-zone throw.
      const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
      // Format a site id into "Country · Short [Rx Dx ...]".
      const formatSiteFull = (id) => {
        const d = SITES_DETAIL_MAP[id];
        if (!d) return id;
        const feats = (d.features || []).map((f) => (FEATURES.find((x) => x.id === f) || {}).short || f).join(" ");
        return d.country + " · " + d.short + (feats ? " [" + feats + "]" : "");
      };

      // ── Feasibility detection ───────────────────────────────
      // Permissive regex map: typed text → data features needed.
      // Case-crossover almost always uses Rx (or some pharmacy/exposure source)
      // + Dx (case ascertainment); those two are seeded as universal.
      // Each group was written `\b( … )\b`, which makes the TRAILING boundary
      // mandatory for every alternative — so the stems matched only when the
      // word ended there. "carcinoma", "malignancy", "tumours", "pregnancy",
      // "gestational age", "echocardiogram", "angiography", "radiology",
      // "genomics" and "deaths" all matched nothing at all. `labs` was the one
      // group written without the trailing \b and the one group that worked.
      // Third copy of this defect in this codebase; the replacements below are
      // mirrored from the vetted set in descriptive-analysis.astro rather than
      // re-derived, including its deliberate narrowing of bare "angio" (which
      // matched nothing with the boundary and matches "angiotensin", an entire
      // drug class, without it) to "angiograph".
      const FEATURE_TRIGGERS = {
        labs:      /\bhba1c|\begfr|\bcreatinine|\bbmi\b|\bblood\s*pressure|\bsystolic|\bdiastolic|\bldl\b|\bhdl\b|\bcholesterol|\bglucose|\balbumin|\bh[ae]?emoglobin|\binr\b|\btsh\b|\blipid|\bbiochemi|\blabora?tor[yi]|\blabs?\b/i,
