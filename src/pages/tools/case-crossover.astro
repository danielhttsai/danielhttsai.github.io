          if (!r.ok) {
            stops.push({ field, msg: label + ' reads "' + r.raw + '", which is not a whole number of days.' + (/^-\s*\d/.test(r.raw) ? " A window length or offset is a count of days and cannot be negative; every window on this page is placed before the event by the diagram, not by the sign of the number you type." : "") });
