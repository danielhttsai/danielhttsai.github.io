---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhenotypeLibrary from "../../components/PhenotypeLibrary.astro";
import SitesPicker from "../../components/SitesPicker.astro";
import DesignDiagram from "../../components/DesignDiagram.astro";
import ProtocolCommon from "../../components/ProtocolCommon.astro";
import TargetChecklist from "../../components/TargetChecklist.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Curated lists surfaced as checkboxes (matching the ACNU/SCCS/CCO/DA builders):
// tick to include, plus a free-text "custom" box.
const SUBGROUPS = [
  "Age group (e.g. ≥65 vs <65)",
  "Sex (male vs female)",
  "Comorbidity burden (e.g. CCI ≥2 vs <2)",
  "Prior cardiovascular disease",
  "Baseline disease severity",
  "Prior hospitalisation for the condition",
  "Index / calendar year (before vs after a cut-point)",
  "Baseline risk score (high vs low)",
];
// Common covariate groups / exclusion criteria, offered as quick-add chips.
const COV_TYPES = ["Demographics (age, sex)", "Comorbidities (CCI)", "Comedications", "Disease severity", "Prior healthcare use", "Labs / vitals", "Frailty", "Socioeconomic status"];
const EXCL_TYPES = ["Prior outcome event", "Competing diagnosis", "Prior exposure (washout)", "Contraindication", "Pregnancy", "End-stage disease", "Short enrolment"];

// Events that create informative (artificial) censoring, each weighted by IPCW.
// Weights are fitted separately per arm; each event maps to the assigned strategy.
// `v` is the value written into the protocol (kept stable so saved drafts keep
// matching); `l` is the on-screen label, which may carry a caveat.
// Death is deliberately NOT ticked by default: censoring at death and weighting
// for it targets a hypothetical estimand in which death is removed, which is a
// different question from a competing-risks analysis (Young 2020).
const IPCW_REASONS = [
  { v: "Treatment discontinuation", l: "Treatment discontinuation", on: true },
  { v: "Switch to the comparator / another drug", l: "Switch to the comparator / another drug", on: true },
  { v: "Add-on of another therapy", l: "Add-on of another therapy", on: true },
  { v: "Loss to follow-up / disenrolment", l: "Loss to follow-up / disenrolment", on: false },
  { v: "Death", l: "Death — only if death is treated as censoring rather than as a competing event", on: false },
];
const SENSITIVITY = [
  "On-treatment (per-protocol analogue): censor at discontinuation (>90-day gap) or switch",
  "Shorter / longer grace period",
  "Weight truncation at 1st / 99th percentile",
  "Restrict outcomes to inpatient / emergency records",
  "Negative-control outcome",
  "E-value for unmeasured confounding",
  "Competing-risk (death) handling",
];
---

<BaseLayout
  title="Clone-Censor-Weight (CCW) protocol — Daniel Tsai"
  description="A free, in-browser protocol builder for the clone-censor-weight (grace-period) approach to target-trial emulation, with one-click Word / Markdown export."
>
  <header class="relative bg-gradient-to-br from-brand-50 via-white to-brand-100/40 border-b border-slate-200 overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
      <p class="uppercase tracking-widest text-xs text-brand-600 font-semibold mb-2">Protocol Generator · CCW</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">Clone-Censor-Weight protocol</h1>
      <p class="mt-3 text-base text-slate-600 max-w-3xl">
        Draft a target-trial-emulation protocol for treatment strategies that are only distinguishable
        <em>after</em> time zero — grace periods, sustained use, treat-to-target. Cloning + artificial censoring +
        inverse-probability-of-censoring weights (IPCW) remove the immortal-time and selection bias that a naïve
        analysis introduces. Everything runs in your browser.
      </p>
      <a class="mt-4 inline-block text-sm text-brand-700 hover:underline font-semibold" href={`${base}/tools/protocol-generator`}>← All designs</a>
    </div>
  </header>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid gap-8 lg:grid-cols-[1fr_1fr] items-start">
      <!-- Form -->
      <form id="form" class="protocol-form space-y-6">
        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">1 · Identity</legend>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Study title</span>
            <input name="title" placeholder="e.g. Early vs deferred anticoagulation after ischaemic stroke: a clone-censor-weight emulation" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Data source(s)</span>
            <input name="data" placeholder="e.g. Taiwan NHIRD (2010–2020), linked to the National Death Registry" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <SitesPicker target="data" />
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">2 · Causal question</legend>
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Population</span>
              <button type="button" data-open-library data-category="indications" data-target-name="population" class="text-[11px] text-brand-700 font-semibold hover:underline">📚 Library</button>
            </div>
            <input name="population" placeholder="e.g. Adults ≥ 18 with a first ischaemic stroke and atrial fibrillation" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
          </div>
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Outcome</span>
              <button type="button" data-open-library data-category="outcomes" data-target-name="outcome" class="text-[11px] text-brand-700 font-semibold hover:underline">📚 Library</button>
            </div>
            <input name="outcome" placeholder="e.g. Recurrent stroke or systemic embolism within 90 days" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" />
          </div>
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">3 · Time zero &amp; strategies</legend>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Time zero (must be compatible with every strategy)</span>
            <input name="timezero" placeholder="e.g. Day of stroke admission (all patients eligible for either strategy)" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
          <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-3">
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Strategy A</span>
              <input name="stratA" placeholder="e.g. Initiate anticoagulation within the grace period" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Grace period (days)</span>
              <input type="number" name="grace" value="14" min="0" step="1" class="mt-1 w-28 rounded-lg border border-slate-300 p-2 text-sm" /></label>
          </div>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Strategy B</span>
            <input name="stratB" placeholder="e.g. Do not initiate anticoagulation during the grace period (deferred)" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">4 · Censoring &amp; weights</legend>
          <details class="rounded-lg bg-slate-50 border border-slate-200 px-3 py-2 text-xs text-slate-600">
            <summary class="cursor-pointer font-semibold text-slate-700">In one sentence: everyone is copied into both arms, and each copy is dropped the moment it stops matching its arm.</summary>
            <p class="mt-2 leading-relaxed">Because a patient's data are compatible with <em>both</em> strategies until they act, the same person-time counts in both arms during the grace period — that is what removes immortal-time bias. But the dropping (“artificial censoring”) is not random: the clones that survive in an arm are the ones who happened to behave that way, so they must be up-weighted to stand in for the ones removed. That up-weighting is the IPCW. Two consequences follow, and both matter for the analysis: model-based standard errors are too small (the number of events is artificially inflated), so confidence intervals come from a non-parametric bootstrap that re-runs cloning, censoring and weighting inside every replicate; and the two arms are identical at time zero by construction and separate only as patients act, so the hazard ratio starts at 1 and moves with follow-up time — proportional hazards is violated by design (Maringe 2020, <a class="underline" href="https://doi.org/10.1093/ije/dyaa057" target="_blank" rel="noopener">doi:10.1093/ije/dyaa057</a>).</p>
          </details>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Deviation / censoring rule</span>
            <textarea name="censor" rows="3" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" placeholder="e.g. A clone is artificially censored when its data first become incompatible with the assigned strategy: in the 'initiate' arm, if no anticoagulant is dispensed by the end of the grace period; in the 'deferred' arm, at the first dispensing during the grace period."></textarea></label>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">IPCW covariates (baseline + time-varying)</span>
            <textarea name="ipcw" rows="3" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" placeholder="e.g. Age, sex, CHA₂DS₂-VASc, HAS-BLED, stroke severity (NIHSS proxy), renal function, concomitant antiplatelets, time-varying bleeding events and procedures."></textarea></label>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Censoring events weighted by IPCW</span>
            <div class="mt-1.5 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1">
              {IPCW_REASONS.map((r) => (
                <label class="flex items-start gap-2 text-xs text-slate-700">
                  <input type="checkbox" name="ipcwReasonsPick" value={r.v} checked={r.on} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{r.l}</span>
                </label>
              ))}
            </div>
            <textarea name="ipcwReasonsCustom" rows="1" class="mt-2 w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="Custom censoring events (one per line)"></textarea>
            <p class="mt-1 text-[11px] text-slate-400">Weights are estimated <strong>separately for each arm</strong>, because the two arms need not deviate on the same schedule. Which arm's model is time-fixed and which is time-varying depends on how you have written the strategies, not on which one you typed first: a strategy that can only be broken by missing a deadline has a single deviation time, one that can be broken by an action at any moment has many — and <strong>both</strong> of yours may be of the second kind, since discontinuation, switch and add-on are all continuing requirements.</p>
          </div>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Inclusion look-back (days)</span>
            <input type="number" name="incllookback" value="365" min="0" step="1" class="mt-1 w-32 rounded-lg border border-slate-300 p-2 text-sm" /></label>

          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Exclusion criteria <span class="font-normal text-slate-400 normal-case">(name | look-back days, one per line)</span></span>
            <textarea name="excllist" rows="3" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" placeholder="Prior outcome event | 365&#10;Competing diagnosis | 365">Prior outcome event | 365</textarea>
            <div class="mt-1.5 flex flex-wrap gap-1.5">
              {EXCL_TYPES.map((t) => (
                <button type="button" data-add-row data-target="excllist" data-name={t} class="text-[11px] rounded-full border border-slate-200 px-2 py-0.5 text-slate-600 hover:border-brand-400 hover:text-brand-700">+ {t}</button>
              ))}
            </div>
          </div>

          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Covariate types <span class="font-normal text-slate-400 normal-case">(name | look-back days, one per line)</span></span>
            <textarea name="covlist" rows="3" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" placeholder="Comorbidities (CCI) | 365&#10;Comedications | 180">Comorbidities (CCI) | 365
Comedications | 180</textarea>
            <div class="mt-1.5 flex flex-wrap gap-1.5">
              {COV_TYPES.map((t) => (
                <button type="button" data-add-row data-target="covlist" data-name={t} class="text-[11px] rounded-full border border-slate-200 px-2 py-0.5 text-slate-600 hover:border-brand-400 hover:text-brand-700">+ {t}</button>
              ))}
            </div>
            <p class="mt-1 text-[11px] text-slate-400">Each exclusion / covariate line is drawn as its own labelled window in the diagram — drag its edge to adjust that look-back.</p>
          </div>
        </fieldset>

        <fieldset class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
          <legend class="px-2 text-sm font-bold text-brand-700">5 · Follow-up &amp; analysis</legend>
          <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-3">
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Follow-up window / end of follow-up</span>
              <input name="followup" placeholder="e.g. From time zero to outcome, death, disenrolment, or 90 days (whichever first)" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm" /></label>
            <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Max follow-up (days)</span>
              <input type="number" name="fudays" value="90" min="1" step="1" class="mt-1 w-28 rounded-lg border border-slate-300 p-2 text-sm" /></label>
          </div>
          <label class="block"><span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Effect measure</span>
            <select name="effect" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-sm">
              {/* Plain text only in an option label: an inline tag here (an <em>) makes the
                  HTML parser leave the select, and the four options below it vanished. */}
              <option value="RDRMST">Survival difference at the end of follow-up + RMST difference — the pair Maringe et al. report</option>
              <option value="RD">Survival / risk difference at the end of follow-up (with the risk ratio)</option>
              <option value="RMST">Restricted mean survival time (RMST) difference only</option>
              <option value="HR">Hazard ratio from a weighted pooled logistic / Cox model</option>
              <option value="both">Both absolute (RD/RR) and relative (HR)</option>
            </select>
            <span class="mt-1 block text-[11px] text-slate-500">Prefer an absolute contrast here. In a cloned design the two arms are <em>the same people at time zero</em> and separate only as patients act, so the hazard ratio is 1 at the start of follow-up and time-varying after it — the hazards cannot be proportional; Maringe et al. advise against a simple Cox model for these data and against giving the hazard ratio a causal reading. Their worked example reports the difference in survival at one year and the difference in RMST at one year — the two measures above the line.</span></label>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Subgroup analyses (tick to perform)</span>
            <div class="mt-1.5 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1">
              {SUBGROUPS.map((sg, i) => (
                <label class="flex items-start gap-2 text-xs text-slate-700">
                  <input type="checkbox" name="subgroupsPick" value={sg} checked={i < 4} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{sg}</span>
                </label>
              ))}
            </div>
            <textarea name="subgroupsCustom" rows="2" class="mt-2 w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="Custom subgroups (one per line)"></textarea>
          </div>
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-700 font-semibold">Sensitivity analyses (tick to perform)</span>
            <div class="mt-1.5 grid grid-cols-1 gap-y-1">
              {SENSITIVITY.map((sn, i) => (
                <label class="flex items-start gap-2 text-xs text-slate-700">
                  <input type="checkbox" name="sensitivityPick" value={sn} checked={i < 5} class="mt-0.5 rounded border-slate-400 text-brand-700 focus:ring-brand-500" />
                  <span>{sn}</span>
                </label>
              ))}
            </div>
            <textarea name="sensitivityCustom" rows="2" class="mt-2 w-full rounded-lg border border-slate-300 p-2 text-xs" placeholder="Custom sensitivity analyses (one per line)"></textarea>
          </div>
        </fieldset>

        <div class="flex flex-wrap gap-3">
          <button type="button" data-action="download-docx" class="bg-brand-700 text-white hover:bg-brand-800 font-semibold px-5 py-2.5 rounded-lg text-sm">⬇ Word (.docx)</button>
          <button type="button" data-action="download-md" class="bg-white border border-brand-700 text-brand-700 hover:bg-brand-50 font-semibold px-5 py-2.5 rounded-lg text-sm">⬇ Markdown</button>
          <button type="button" data-action="download-target" class="text-brand-700 hover:underline font-semibold text-sm" title="TARGET checklist (Cashin et al, JAMA 2025) mapped to this protocol.">⬇ TARGET checklist</button>
          <button type="button" data-action="copy" class="text-brand-700 hover:underline font-semibold text-sm">Copy</button>
          <button type="button" data-action="reset" class="ml-auto text-slate-500 hover:text-rose-600 hover:underline text-sm font-semibold">Clear all</button>
          <span class="basis-full text-[11px] text-slate-400">Auto-saved to this browser.</span>
          <p data-action-msg class="basis-full text-xs"></p>
        </div>
      </form>

      <!-- Preview -->
      <div class="lg:sticky lg:top-20 self-start">
        <p class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-2">Live protocol preview</p>
        <pre id="preview" class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-xs leading-relaxed whitespace-pre-wrap overflow-auto max-h-[70vh]"></pre>
      </div>
    </div>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-base font-bold text-slate-900">Consistency checks <span class="text-xs font-normal text-slate-400">· target-trial 防呆</span></h2>
      <div id="checks" class="mt-3 space-y-1.5"></div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">Study design diagram</h2>
      <p class="mt-1 text-xs text-slate-500">Time zero, the grace period, the ascertainment windows before it, and follow-up. The figure is one timeline: it marks where cloning happens, it does not draw the two arms separately. <strong>Drag the ● handles</strong> to adjust the covariate look-back, grace, and follow-up — the fields above update automatically.</p>
      <div class="mt-4 overflow-x-auto"><div id="diagram"></div></div>
      <div id="dlegend" class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-slate-600"></div>
    </div>

    <PhenotypeLibrary />
    <DesignDiagram />
    <TargetChecklist />
    <ProtocolCommon />
  </section>

  <script src="https://unpkg.com/docx@8.5.0/build/index.umd.js" is:inline></script>
  <script is:inline>
    const STORAGE_KEY = "daniel.ccw-builder";
    const form = document.getElementById("form");
    const preview = document.getElementById("preview");
    const V = (n) => (form.elements[n]?.value || "").trim();
    const MV = (n) => [...form.querySelectorAll('[name="' + n + '"]:checked')].map((c) => c.value);
    const mergeList = (pick, custom) => [...(pick || []), ...String(custom || "").split(/\r?\n/).map((x) => x.trim()).filter(Boolean)];
    // ONE reading of a day-count, shared by the protocol text, the diagram and the
    // checks, so they cannot tell three different stories about the same box.
    // They used to: the prose printed the raw string while everything else ran it
    // through parseInt. A `type=number` box hands back whatever survives its own
    // sanitiser, which includes negatives and exponent notation —
    //   "-5"    → prose "-5 days", checks "0", diagram no band at all
    //   "365.7" → prose "365.7 days", diagram drawn at 365
    //   "1e3"   → prose "1e3 days",  diagram drawn at 1  (parseInt("1e3") === 1)
    // Returns null (blank), NaN (unusable), or a non-negative integer.
    const numDays = (v) => {
      const t = String(v == null ? "" : v).trim();
      if (t === "") return null;
      const n = Number(t);
      if (!Number.isFinite(n) || n < 0) return NaN;
      return Math.round(n);
    };
    const dayInt = (v) => { const n = numDays(v); return Number.isFinite(n) ? n : 0; };
    const daysTxt = (v) => {
      const n = numDays(v);
      if (n === null) return "(not specified)";
      if (!Number.isFinite(n)) return "(invalid — enter a whole number of days, 0 or more)";
      return n + " day" + (n === 1 ? "" : "s");
    };
    const blank = (v) => String(v == null ? "" : v).trim() === "";
    const badNum = (v) => !blank(v) && !Number.isFinite(numDays(v));
    const rounded = (v) => { const t = String(v == null ? "" : v).trim(); return t !== "" && Number.isFinite(numDays(v)) && Number(t) !== numDays(v); };
    /* A row is "Name | days". Both halves used to be read carelessly, and the
       three numeric boxes above got hygiene that these rows did not:

       - The day count went through dayInt, which turns anything unreadable into
         0. "Comedications | one year" and "Frailty | -180" both exported as
         "(0 d)" — a look-back that measures nothing, stated as a decision — and
         this happened on every keystroke, not only after a drag.
       - The split was on the FIRST pipe, so a criterion whose name contains one
         ("Chronic kidney disease | stage 3+ | 365") lost half its name AND had
         "stage 3+" read as its day count, i.e. 0.
       - rowsJoin then wrote the parser's guess back over the textarea whenever a
         handle was dragged or a chip clicked, so the user's own words were gone
         and the textarea was the only copy of them.

       The day count is now read by numDays, exactly as the boxes above are, and
       has the same three outcomes it does — absent, unreadable, or a whole
       number of days. The name keeps its pipes because the split is on the LAST
       one. rowsJoin preserves the raw text of every row it did not change. */
    const parseRows = (txt) => String(txt || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean).map((l) => {
      const i = l.lastIndexOf("|");
      return { name: (i < 0 ? l : l.slice(0, i)).trim(), raw: i < 0 ? "" : l.slice(i + 1).trim(), days: i < 0 ? null : numDays(l.slice(i + 1)) };
    }).filter((r) => r.name);
    const rowDays = (r) => (r.days === null ? "no look-back given" : !Number.isFinite(r.days) ? "look-back unreadable: “" + r.raw + "”" : r.days + " d");
    const rowsText = (txt) => parseRows(txt).map((r) => r.name + " (" + rowDays(r) + ")").join("; ") || "none";
    const rowsJoin = (rows) => rows.map((r) => {
      const d = Number.isFinite(r.days) ? String(r.days) : (r.raw || "");
      return d === "" ? r.name : r.name + " | " + d;
    }).join("\n");

    // Numbers are read RAW — no silent fallback. A blank grace/look-back/follow-up
    // box used to be quietly replaced by 14/365/90 in the exported protocol, so a
    // half-finished form produced a document asserting windows nobody chose (and
    // "Clear all", which blanks every box, produced a complete-looking protocol).
    // Blank now travels as "" and is printed as "(not specified)" + flagged.
    const readForm = () => ({
      title: V("title"), data: V("data"), population: V("population"), outcome: V("outcome"),
      timezero: V("timezero"), stratA: V("stratA"), stratB: V("stratB"), grace: V("grace"),
      censor: V("censor"), ipcw: V("ipcw"), ipcwReasonsPick: MV("ipcwReasonsPick"), ipcwReasonsCustom: V("ipcwReasonsCustom"), incllookback: V("incllookback"), excllist: V("excllist"), covlist: V("covlist"), followup: V("followup"), fudays: V("fudays"), effect: V("effect"),
      subgroupsPick: MV("subgroupsPick"), subgroupsCustom: V("subgroupsCustom"), sensitivityPick: MV("sensitivityPick"), sensitivityCustom: V("sensitivityCustom"),
      amendments: V("amendments"),
    });
    // Free text the user typed is followed by more of our prose. Without this the
    // exported Word ran the two together ("…whichever comes first Maximum follow-up…");
    // with a naive "." appended it double-punctuated anyone who typed one.
    // A closing bracket is not sentence-ending punctuation, and treating it as
    // one made the tool's own placeholders run on: "…eligible for, all
    // strategies) Eligibility, strategy assignment, and the start of follow-up
    // are all aligned at time zero." A user's "(whichever first)" did the same.
    // The bracket is only terminal when it closes something already punctuated.
    const stop = (t) => { const s = String(t == null ? "" : t).trim(); return s && !/[.!?:;]\)?$/.test(s) ? s + "." : s; };

    const esc = (x) => String(x == null ? "" : x).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    function renderScheme(s) {
      const grace = dayInt(s.grace);
      // The follow-up bar shows the field's own value. It used to be inflated to
      // grace+1 whenever the grace period ran past follow-up, so the bar read
      // "+101d" while the box said 90 — a diagram that disagreed with the
      // protocol it was illustrating. Now the grace band simply overruns the bar,
      // which is what the (error-level) consistency check is telling you about.
      const fuSet = dayInt(s.fudays) > 0;
      const fu = fuSet ? dayInt(s.fudays) : 90;
      const incl = dayInt(s.incllookback);
      const exRows = parseRows(s.excllist);
      const covRows = parseRows(s.covlist);
      const wins = [];
      if (incl > 0) wins.push({ label: "Inclusion assessment", kind: "inclusion", startDay: -incl, endDay: 0, edit: { field: "incllookback", edge: "start" } });
      // A row whose look-back cannot be read is left OUT of the figure rather
      // than drawn at day 0, which would assert a window nobody chose. The
      // checks panel names every row omitted this way.
      exRows.forEach((r, i) => { if (Number.isFinite(r.days)) wins.push({ label: r.name, kind: "exclusion", startDay: -r.days, endDay: 0, edit: { field: "excllist", edge: "start", idx: i } }); });
      covRows.forEach((r, i) => { if (Number.isFinite(r.days)) wins.push({ label: r.name, kind: "lookback", startDay: -r.days, endDay: 0, edit: { field: "covlist", edge: "start", idx: i } }); });
      wins.push(fuSet
        ? { label: "Follow-up", kind: "followup", startDay: 0, endDay: fu, edit: { field: "fudays", edge: "end" } }
        : { label: "Follow-up", kind: "followup", startDay: 0, endDay: fu, note: "length not set", edit: { field: "fudays", edge: "end" } });
      const bands = grace > 0 ? [{ startDay: 0, endDay: grace, label: "grace " + grace + "d", color: "#f59e0b", edit: { field: "grace", edge: "end" } }] : [];
      const onEdit = (field, day, meta) => {
        if (field === "covlist" || field === "excllist") {
          const rel = form.elements[field];
          const rows = parseRows(rel.value);
          const idx = meta && meta.idx != null ? meta.idx : 0;
          if (rows[idx]) { rows[idx].days = Math.max(5, Math.round(-day)); rel.value = rowsJoin(rows); render(); }
          return;
        }
        let v;
        if (field === "incllookback") v = Math.max(0, -day);
        else if (field === "fudays") v = Math.max(1, day);
        else if (field === "grace") v = Math.max(0, day);
        else v = Math.abs(day);
        const el = form.elements[field]; if (el) el.value = Math.round(v);
        render();
      };
      window.renderDesignDiagram(document.getElementById("diagram"), document.getElementById("dlegend"), { windows: wins, bands: bands, indexLabel: "Time zero — clone into both arms", onEdit: onEdit, snap: 5 });
    }

    const or = (s, d) => (s && s.length ? s : d);
    // The five effect-measure values the <select> actually offers. A stale
    // draft or a ?seed= carrying anything else assigns el.value with no
    // membership check, which leaves selectedIndex = -1; a select with no
    // selection contributes nothing to the form, so s.effect comes back "" and
    // every branch keyed on it silently takes its fallback. Checked against the
    // markup at load, so the two cannot drift apart.
    const EFFECTS = ["RDRMST", "RD", "RMST", "HR", "both"];
    (() => {
      const opts = [...form.elements.effect.options].map((o) => o.value);
      const bad = opts.filter((v) => !EFFECTS.includes(v)).concat(EFFECTS.filter((v) => !opts.includes(v)));
      if (bad.length) console.error("[ccw] effect <select> and EFFECTS disagree:", bad);
    })();
    const effectSet = (s) => EFFECTS.includes(s.effect);
    // The horizon τ that both absolute measures are evaluated at is the study's own
    // maximum follow-up, so name it rather than leaving "at the end of follow-up" vague.
    const horizon = (s) => (blank(s.fudays) ? "the end of follow-up (length not yet specified)" : "the end of follow-up (τ = " + daysTxt(s.fudays) + ")");
    // The RMST horizon, phrased once. The Markdown derived it from horizon();
    // the Word file rebuilt it as "the horizon (" + daysTxt(...) + ")", which
    // double-brackets a blank follow-up into "the horizon ((not specified))".
    const rmstHorizon = (s) => horizon(s).replace(/^the end of follow-up/, "the horizon");

    // NOTE: nothing in here may cite a section NUMBER. One effectText feeds four
    // surfaces that number their sections differently or not at all — Markdown
    // (1-13), Word (1-11), the structured abstract and TARGET item 7f. The HR
    // branch used to say "the caveat in Section 10", which was right in the
    // Markdown, pointed at "Subgroup analyses" in the Word file, and dangled in
    // the other two. Say what the caveat IS, not where it lives.
    const effectText = (s) => {
      const H = horizon(s);
      return ({
        RD: "the difference in survival at " + H + ", reported as strategy A minus strategy B — the risk difference is the same quantity with the opposite sign, since risk = 1 − survival, so state which of the two is being reported — together with the risk ratio, which is a relative rather than an absolute measure; all are obtained by contrasting the weighted survival / cumulative-incidence curves",
        RMST: "the difference in restricted mean survival time (RMST) up to " + H + ", reported as strategy A minus strategy B and obtained as the area between the weighted survival curves",
        RDRMST: "two absolute contrasts of the weighted survival curves, both reported as strategy A minus strategy B — the difference in survival at " + H + " (the risk difference is the same quantity with the opposite sign, since risk = 1 − survival) and the difference in restricted mean survival time (RMST) up to that same horizon. This is the pair reported in the worked example of Maringe et al. (2020)",
        HR: "the hazard ratio from a weighted pooled logistic regression (discrete-time hazards) model with the assigned strategy as the exposure, reported with the explicit caveat that proportional hazards cannot hold in a cloned design, so the hazard ratio is not given a causal reading",
        both: "an absolute contrast — the difference in survival at " + H + ", reported as strategy A minus strategy B, the risk difference being the same quantity with the opposite sign — together with two relative measures, the risk ratio from the weighted curves and the hazard ratio from a weighted pooled logistic model. The absolute contrast is the primary measure",
      })[s.effect] || "(NO EFFECT MEASURE IS SET — the tool will not name one for you. Choose one in section 5 of the builder.)";
    };
    const usesHR = (e) => e === "HR" || e === "both";
    const usesRMST = (e) => e === "RMST" || e === "RDRMST";
    // Death as a censoring event. The three places that react to it each tested
    // /^death/i, which is anchored to the start of the string, so only the
    // shipped checkbox ("Death — only if…") ever matched. Type "All-cause
    // death" or "Death from any cause" in the custom box and the protocol still
    // listed death among the IPCW-weighted censoring events while the Young
    // 2020 note explaining what that does to the estimand, and the warning in
    // the checks panel, both stayed silent.
    const hasDeath = (s) => mergeList(s.ipcwReasonsPick, s.ipcwReasonsCustom).some((x) => /\bdeaths?\b/i.test(x));

    // What section 8 may say about weight truncation. It used to substring-match
    // /truncat/i over the ticked list AND the free-text box together, so untick
    // the truncation box and type "No truncation of the weights is applied" and
    // section 8 asserted that truncation WAS pre-specified in section 13, three
    // paragraphs above section 13 listing the denial. A sentence in the tool's
    // own voice may only be driven by the tool's own controlled vocabulary; when
    // the free text mentions truncation and the box does not, the tool has no
    // way to know which was meant, so it says so instead of picking.
    // The two free-text fields that used to be filled in for the user when left
    // blank, each with different words in each export. Every other unfilled
    // field on this page exports a visible bracket — "(population)", "(define
    // time zero)", "(list the predictors of deviation)" — but the deviation
    // rule, which is the single decision that defines a clone-censor-weight
    // study, exported as finished prose describing a rule nobody had chosen,
    // and the Markdown, the Word file and the TARGET checklist each described a
    // different one. One string each now, and both say plainly they are unset.
    /* The comparison analysis. One unconditional paragraph, printed in three
       documents, making three claims at once that the form cannot support.

       It called itself an intention-to-treat analogue. An ITT effect needs an
       assignment at time zero to have an intention about, and this design
       exists precisely because the strategies are NOT distinguishable at time
       zero — section 1 says so in its own first sentence. Starting follow-up at
       the index date and classifying people by what they went on to do is an
       as-treated analysis, and calling it ITT in the section that defines the
       estimand is a label a reviewer stops reading at.

       It said the gap between the two estimates "indexes the time-lag /
       immortal-time bias removed". The two differ in the estimand, in the
       alignment of time zero, in how confounding is handled, in the analytic
       population and in the treatment of competing events, so their difference
       cannot be attributed to any single one of those.

       And it prescribed Fine-Gray for "the competing risk of death" whatever
       the outcome was — including when the outcome is itself death, where
       death is not a competing event at all. The tool does not elicit that
       choice, so it now asks for it rather than making it. */
    const mentionsDeath = (s) => /\bdeaths?\b|\bmortality\b|\bdied\b|\bfatal\b/i.test(String(s.outcome || ""));
    const COMPARISON_SHORT = "a conventional as-treated analysis started at the index date (which is not an intention-to-treat analogue — see the statistical analysis section)";
    const comparisonText = (s) =>
      "Comparison — conventional as-treated analysis: start follow-up at the index date, classify patients by the treatment they went on to receive, and balance the groups by propensity-score matching (standardised mean difference < 0.1 as the balance criterion). " +
      "This is not an intention-to-treat analogue. An intention-to-treat effect requires an assignment made at time zero, and in this design the strategies cannot be distinguished at time zero — which is the reason for cloning in the first place. " +
      (mentionsDeath(s)
        ? "The outcome named in this protocol mentions death or mortality. If death is the outcome, it is not a competing event and no competing-risk model applies here; if it is not, state how the competing risk of death is handled. "
        : "State how the competing risk of death is handled: a cause-specific Cox model and a Fine-Gray sub-distribution model answer different questions, and the choice must match the estimand (Young 2020). ") +
      "The difference between this estimate and the clone-censor-weight estimate must not be read as the amount of immortal-time bias removed. The two differ in the estimand, in the alignment of time zero, in how confounding is addressed, in the analytic population and in the treatment of competing events, so their difference cannot be attributed to any one of them.";

    const censorText = (s) => or(s.censor, "(NOT YET SPECIFIED — state, for each arm separately, when a clone's data first become incompatible with its assigned strategy. The two arms are not symmetric, so a single rule will not serve for both.)");
    const followupText = (s) => or(s.followup, "(NOT YET SPECIFIED — state when follow-up ends: the outcome, death, disenrolment, the end of the study period, or the maximum follow-up above, whichever comes first.)");

    const truncText = (s) => {
      const ticked = (s.sensitivityPick || []).some((x) => /truncat/i.test(x));
      if (ticked) return "Truncation at the 1st/99th percentiles is examined as a pre-specified sensitivity analysis, listed among the sensitivity analyses below; the primary analysis uses untruncated weights.";
      const written = String(s.sensitivityCustom || "").split(/\r?\n/).some((x) => /truncat/i.test(x));
      if (written) return "A weight-truncation analysis appears among the sensitivity analyses you wrote. State there whether it is applied to the primary analysis or examined only as a sensitivity analysis — this tool will not decide that from the wording.";
      return "Truncation is not applied in the primary analysis; if the weight distribution proves extreme, a truncated-weight analysis will be added as a documented amendment.";
    };

    /* Why the hazard ratio is refused here. The mechanism this page gave was
       wrong in five places: "the two arms contain the same people during the
       grace period, so their hazards are equal by construction". They contain
       the same people at TIME ZERO only. The moment a patient acts, one of
       their two clones is censored and the other continues, so from the first
       deviation onward the arms hold different risk sets under different
       weights — and the page says exactly that, correctly, in its own cloning
       section ("UNTIL a patient acts"). The conclusion was never in doubt; the
       reason given for it was. What is true by construction is that the curves
       START together, so the hazard ratio is pinned at 1 at time zero and can
       only move as uptake accumulates — which is a stronger argument against
       proportional hazards than the false one it replaces. */
    const HR_CAVEAT =
      "Caveat on the hazard ratio. At time zero the two arms are identical by construction, because cloning places every patient in both; they separate only as patients act and clones are censored. " +
      "The hazard ratio is therefore 1 at the start of follow-up and time-varying thereafter: proportional hazards is violated by design, and any single hazard ratio averages a stretch in which the effect is null by construction with later stretches in which it is not, over a risk set whose composition is changing. " +
      "Maringe et al. (2020) advise against analysing cloned data with a simple Cox model, and against reading the hazard ratio causally. " +
      "The hazard ratio is also non-collapsible: it does not average over individuals the way an absolute contrast does, so it is not comparable with a marginal risk difference or risk ratio even when both are computed from the same weighted curves. " +
      "The absolute contrast \u2014 the difference in survival at the end of follow-up, or in restricted mean survival time \u2014 is the interpretable measure here.";

    /* Which arm's censoring model is time-fixed and which is time-varying.
       This was one paragraph, hard-coded twice, asserting two things the form
       cannot support.

       It named the arms — "a clone in the INITIATE arm can only deviate at one
       time … the DEFERRED arm can deviate at any moment" — although both
       strategy boxes are free text. Enter "Continue statin therapy for at least
       12 months" as A and "Discontinue within the grace period" as B and the
       roles swap: the exported protocol then prescribes the time-varying model
       for the wrong arm.

       And the dichotomy itself is false for the configuration this builder
       SHIPS: discontinuation, switch and add-on are ticked by default, and each
       is a continuing requirement, so an "initiate" clone that starts on day 2
       and stops on day 40 deviates on day 40 — long after the grace period. A
       time-fixed model in that arm ignores every one of those events, and the
       weights, and the estimate, are then wrong. This is the one defect on this
       page that changes a number rather than a sentence.

       So state the RULE and let the reader apply it to their own two
       strategies, allow both to land on the same side, and say plainly that the
       tool cannot tell them apart. The Maringe attribution that used to close
       the paragraph is dropped: it could not be checked against the paper from
       here, and it is not needed for the structural claim. */
    const DEVIATION_SCHEDULE =
      "The two arms need not deviate on the same schedule, and the difference decides the form of each arm's censoring model. Apply the test to each strategy separately. " +
      "A strategy that can be violated only by an action's absence at a deadline — \u201Cinitiate within the grace period\u201D, \u201Cdiscontinue within the grace period\u201D — cannot be shown to have been violated until that deadline arrives, so a clone leaves that arm at a single time, the end of the grace period, and a time-fixed model for the probability of reaching the deadline still adhering is sufficient. " +
      "A strategy that can be violated by an action occurring at any moment — \u201Cdo not initiate during the grace period\u201D, \u201Cremain on treatment\u201D, \u201Cstay below the target dose\u201D — is violated at a time that varies, so that arm needs a censoring model fitted over follow-up. A strategy carrying both a deadline and a continuing requirement is of the second kind. " +
      "Both of your strategies may be of the second kind: three of the censoring events this builder offers \u2014 discontinuation, switch and add-on \u2014 are continuing requirements. " +
      "This tool cannot tell which of strategy A and strategy B is which, because both are free text, so state for each strategy which form applies in the deviation rule above. A weight model is fitted separately for each arm in every case.";

    /* The identifying assumptions, in one string for the three documents that
       state them, because they had drifted into three wordings of one claim and
       two of them were wrong in the same two ways.

       Positivity was stated as "the probability of DEVIATING is non-zero". The
       quantity that must be bounded away from zero is the probability of
       remaining uncensored — that is the denominator of the weight, and it is
       what blows up. For two strategies that are exact complements the two
       conditions happen to coincide; the strategy boxes are free text, so they
       need not be complements ("initiate X within 14 d" vs "initiate Y within
       14 d" leaves a patient who takes neither deviating from both), and the
       sentence sits directly under a passage saying the weight models are
       fitted separately PER ARM, where the coincidence does not hold.

       It was also scoped to "within the grace period". Three of the five
       censoring events ship ticked — discontinuation, switch, add-on — and all
       of them happen throughout follow-up, which the same section says when it
       states that the weights are cumulative over follow-up. */
    const ASSUMPTIONS =
      "Identifying assumptions carried by the weights (Maringe 2020): (i) every predictor of deviation from the assigned strategy is measured and included; (ii) the weight models are correctly specified; (iii) positivity — at every time at which a clone can still be artificially censored, and for every covariate history, the probability of continuing to follow the assigned strategy is greater than zero in each arm, so that no covariate pattern makes deviation from either strategy a certainty; and (iv) consistency. " +
      "Positivity is required wherever a strategy imposes a requirement: throughout follow-up where either strategy requires sustained use, not only within the grace period. " +
      "Assumption (i) is not testable. Assumption (iii) fails at either end — a grace period long enough that some covariate pattern is certain to have acted before the deadline destroys positivity for the strategy that requires abstention, while one short enough that some pattern is certain not to have acted destroys it for the strategy that requires the action — so lengthening the grace period trades one arm's positivity against the other's. We inspect the weight distribution for extreme values as a diagnostic.";

    /* The balance diagnostic, likewise in one string. A weighted SMD between
       arms is the check the CCW literature actually reports, but it is
       identically zero at time zero however broken the weights are, because
       cloning puts every patient in both arms — the page says so itself in the
       cloning section. It has to name the time it is evaluated at. */
    const BALANCE =
      "We report the distribution of the weights (mean, range, and extreme percentiles) and the weighted standardised mean differences between arms at the end of the grace period, once artificial censoring has occurred — a between-arm comparison at time zero is uninformative here, because cloning makes the arms identical by construction, so it is zero whatever the weights do. We confirm that the weights remove the imbalance artificial censoring creates before the primary analysis is run.";

    /* ── Refusals that travel ──────────────────────────────────────────────
       The consistency-check panel is on screen only. It was the sole place
       this builder said no, so every refusal it made was lost the moment the
       user clicked a download button: a form whose grace period ran past the
       end of follow-up showed a red ✕ and exported a Word protocol and a
       TARGET checklist that stated both numbers as settled design decisions,
       under a status line reading "Word document downloaded."

       So the document-grade sentences live here, and computeChecks() paints
       the same list in the panel while both exports print it at the top. One
       computation, four surfaces, no drift — the pattern the case-control
       builder's conflicts() already established.

       These are the states where the exported protocol would otherwise assert
       something the form does not support. Ordinary blanks are NOT here: a
       missing population exports as "(population)", which is visibly unfilled
       and needs no refusal. */
    const blockers = (s) => {
      const out = [];
      const g = numDays(s.grace), fu = numDays(s.fudays);
      const gOK = Number.isFinite(g), fuOK = Number.isFinite(fu);

      if (!gOK && !blank(s.grace)) out.push(
        "The grace period reads “" + s.grace + "”, which cannot be read as a whole number of days of 0 or more, so no grace period has been set. The grace period is the only thing that distinguishes the two strategies in this design; the protocol prints “(invalid)” wherever it would have appeared rather than guessing a length.");
      else if (blank(s.grace)) out.push(
        "No grace period is specified. In a clone-censor-weight design the strategies are defined by what happens over the grace period, so until a length is set there is no window in which a patient’s data are compatible with both strategies, and nothing for cloning to buy. The protocol prints “(not specified)” wherever the length would have appeared; no length is assumed.");
      else if (g <= 0) out.push(
        "The grace period is 0 days. The two strategies are then distinguishable at time zero itself, which is the situation this design exists to avoid — an active-comparator new-user cohort is the right design for that, not cloning. Cloning also stops doing any work: exactly one of each patient’s two clones is censored at time zero and the other contributes its whole follow-up, so no patient contributes person-time to both arms and the analysis reduces to comparing the patients who acted at time zero with those who did not.");

      if (!fuOK && !blank(s.fudays)) out.push(
        "Maximum follow-up reads “" + s.fudays + "”, which cannot be read as a whole number of days of 0 or more, so the length of follow-up is not set.");
      else if (blank(s.fudays)) out.push(
        "Maximum follow-up is not specified. The diagram draws a placeholder bar labelled “length not set” and the protocol prints “(not specified)”; nothing is assumed.");
      else if (fu <= 0) out.push(
        "Maximum follow-up is 0 days, so this protocol specifies a study in which no patient is observed for any time at all. No outcome can occur, and every quantity defined at the end of follow-up — the survival difference, the RMST difference, the risk ratio — is identically zero or undefined by construction.");
      else if (gOK && g > 0 && g >= fu) out.push(
        "The grace period (" + g + " d) is at least as long as the maximum follow-up (" + fu + " d). No clone can then be censored for missing the deadline inside the observed follow-up, so the strategy defined by that deadline is never actually enforced: its arm is the whole cohort under no intervention, and the contrast is between the whole cohort and a weighted subset of itself rather than between two strategies. This does not produce a null result — it produces a confident and badly confounded one. Shorten the grace period or lengthen follow-up.");

      if (usesRMST(s.effect) && !(fuOK && fu > 0)) out.push(
        "Restricted mean survival time is the area under the survival curve up to a horizon τ, so it has no value until τ is fixed — and τ must be pre-specified rather than chosen after seeing the curves. Set the maximum follow-up.");

      if (!effectSet(s)) out.push(
        "No effect measure is set. The selected value is " + (blank(s.effect) ? "empty" : "“" + s.effect + "”, which is not one of the five this builder offers") + " — a saved draft or a ?seed= link can leave the dropdown with nothing selected, and it then looks merely unremarkable rather than unset. The protocol will not name a measure, a horizon or a contrast until one is chosen.");

      if (blank(s.censor)) out.push(
        "No deviation / censoring rule is stated. This is the decision that defines a clone-censor-weight study — it says when a clone stops matching its arm — and it is not symmetric between the arms, so it cannot be inferred from the strategies. The protocol marks it unstated rather than supplying a plausible rule of its own.");

      // The outcome must not also be an event the weights censor at. Nothing
      // stopped it: a persistence study could export "Outcome: Treatment
      // discontinuation." three paragraphs below "Events weighted by IPCW:
      // Treatment discontinuation" — every patient censored at the moment the
      // event being counted occurs, so no event is ever observed and the
      // estimate is of nothing at all.
      const norm = (x) => String(x || "").toLowerCase().replace(/\s*—.*$/, "").replace(/[^a-z0-9]+/g, " ").trim();
      const on = norm(s.outcome);
      if (on.length >= 4) {
        const clash = mergeList(s.ipcwReasonsPick, s.ipcwReasonsCustom)
          .filter((r) => { const rn = norm(r); return rn.length >= 4 && (rn.includes(on) || on.includes(rn)); });
        if (clash.length) out.push(
          "The outcome (“" + String(s.outcome).trim() + "”) is also listed as an event that is censored and weighted by IPCW: " + clash.join("; ") + ". A clone censored at the outcome can never be observed to have it, so the event count is zero by construction. Either the outcome or that censoring event is wrong.");
      }

      const A = String(s.stratA || "").trim(), B = String(s.stratB || "").trim();
      if (A && B && A.toLowerCase() === B.toLowerCase()) out.push(
        "Strategy A and strategy B are the same text (“" + A + "”). Cloning a patient into two identical strategies produces two identical clones that deviate together, so every contrast in this protocol is zero by construction.");

      return out;
    };
    const blockerMd = (s) => {
      const b = blockers(s);
      return b.length
        ? "> **This draft cannot be analysed as written.**\n>\n" + b.map((x) => "> - " + x).join("\n>\n") + "\n\n"
        : "";
    };

    // Normalised inputs for the shared HARPER/TARGET common sections (window.PC).
    const pcOf = (s) => ({
      design: "clone-censor-weight target-trial emulation",
      tte: true,
      population: or(s.population, "(population)"),
      exposure: or(s.stratA, "(strategy A)"),
      comparator: or(s.stratB, "(strategy B)"),
      outcome: or(s.outcome, "(outcome)"),
      data: s.data,
      analysis: "a clone-censor-weight per-protocol analysis estimating " + effectText(s) + ", with 95% CIs from a non-parametric bootstrap that re-runs cloning, censoring and weight estimation inside each replicate",
      // Not "treatment strategy" on its own: the shared component renders this
      // as "Table 1 — baseline characteristics by <groupBy>", and cloning puts
      // every patient in BOTH arms, so a by-arm baseline table has two
      // identical columns — the cloning section says so itself. Commissioning
      // it as a shell table without saying that invites an analyst to present
      // a comparison that cannot show anything.
      groupBy: "strategy at time zero — identical across arms by construction, since cloning places every patient in both; the informative version is the weighted comparison after artificial censoring has occurred",
      limitations: "Artificial censoring is informative and adjusted with inverse-probability-of-censoring weights, which assume that every predictor of deviation is measured, that the weight models are correctly specified, and that no covariate pattern makes deviation from either strategy a certainty at any time at which a clone can still be artificially censored — throughout follow-up wherever a strategy requires sustained use, not only within the grace period (Maringe 2020). Cloning removes confounding of the assigned strategy at time zero, but only the observed covariates enter the weight models, so residual confounding of adherence remains possible.",
      // These are shell tables and figures — what the analysis will produce —
      // so they must follow the effect measure actually chosen. This list was
      // unconditional while effectText branches five ways, so a protocol
      // reporting a hazard ratio commissioned a survival difference and an
      // RMST difference in the same document: two sections naming different
      // primary quantities, with nothing in blockers() objecting because the
