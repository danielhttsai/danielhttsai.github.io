      if (zeroRows.length) checks.push({ level: "warn", msg: "These rows have a look-back of 0 days, which means the criterion is assessed only on the index day itself: " + zeroRows.join("; ") + "." });
      if (!s.timezero || !s.timezero.trim()) checks.push({ level: "warn", msg: "Define time zero. It must be a point at which every patient is still eligible for, and compatible with, every strategy — otherwise cloning assigns people to strategies they could never have followed." });
      if (!s.ipcw || !s.ipcw.trim()) checks.push({ level: "warn", msg: "No IPCW covariates listed. Cloning removes confounding of the assigned strategy, but the censoring it introduces is informative; without the weights the CCW estimate is not less biased than the naive one, only differently biased." });
