      if (lb <= 0) checks.push({ level: "warn", msg: "No covariate look-back — baseline confounders and eligibility are assessed only at time zero. The IPCW models need these covariates, so without them the weights cannot adjust the artificial censoring." });
      // "Unreadable" and "zero" are different things and used to be one warning.
      const allRows = [...covRows, ...parseRows(s.excllist)];
      const unreadable = allRows.filter((r) => r.days === null || !Number.isFinite(r.days));
      if (unreadable.length) checks.push({ level: "error", msg: "These rows have no look-back this tool can read, so they are printed as unreadable and left out of the diagram rather than drawn at day 0: " + unreadable.map((r) => "“" + r.name + "”" + (r.raw ? " (“" + r.raw + "”)" : " (nothing after the “|”)")).join("; ") + ". A row is read as “Name | days”, where days is a whole number of 0 or more; the name itself may contain “|”." });
