      };
      try {
        dl(await window.buildTargetChecklistDocx(D, { title: s.title || "CCW study", designName: "clone-censor-weight", item7: item7, map: map }), slugify() + "-TARGET-" + new Date().toISOString().slice(0, 10) + ".docx");
        setMsg("TARGET checklist downloaded.");
      } catch (e) { console.error(e); setMsg("TARGET checklist export failed: " + (e && e.message ? e.message : e), true); }
    });
    document.querySelector("[data-action='copy']").addEventListener("click", async (e) => {
      try { await navigator.clipboard.writeText(preview.textContent || ""); e.target.textContent = "Copied ✓"; setTimeout(() => (e.target.textContent = "Copy"), 1500); }
      catch (err) { console.error(err); setMsg("Could not copy — your browser blocked clipboard access. Select the preview text and copy it manually.", true); }
    });
    document.querySelector("[data-action='reset']").addEventListener("click", () => {
      if (!confirm("Clear every field and forget the saved draft?")) return;
      localStorage.removeItem(STORAGE_KEY);
      // True blank slate — form.reset() only restores HTML defaults (and leaves
      // the pre-filled covariate/exclusion rows and checkboxes). Walk every
      // control and zero it out so "Clear" actually means clear.
      form.querySelectorAll("input, textarea, select").forEach((el) => {
        if (el.type === "checkbox" || el.type === "radio") el.checked = false;
        else if (el.tagName === "SELECT") el.selectedIndex = 0;
        else el.value = "";
      });
      render();
      setMsg("Cleared. Every number is now blank — the protocol says “(not specified)” rather than assuming a default.");
    });

    // Word export — Markdown-ish rendered to a formatted .docx
    // Formatted Word protocol, matching the ACNU/SCCS/CCO/DA builders.
    const buildDocx = async (s) => {
      const D = window.docx;
      const today = new Date().toISOString().slice(0, 10);
      const FONT = "Times New Roman";
      const text = (str, o = {}) => new D.TextRun({ text: String(str ?? ""), font: FONT, size: 22, ...o });
      const p = (ch, o = {}) => new D.Paragraph({ children: Array.isArray(ch) ? ch : [ch], spacing: { before: 60, after: 60, ...(o.spacing || {}) }, ...o });
      const h1 = (str) => new D.Paragraph({ children: [text(str, { bold: true, size: 28 })], spacing: { before: 200, after: 80 }, heading: D.HeadingLevel.HEADING_1 });
      const para = (str) => p([text(str)]);
      const bullet = (str) => new D.Paragraph({ children: [text(str)], bullet: { level: 0 }, spacing: { before: 0, after: 0 } });
      const numItem = (str) => new D.Paragraph({ children: [text(str)], numbering: { reference: "ordered", level: 0 }, spacing: { before: 0, after: 0 } });
      const border = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" };
      const cb = { top: border, bottom: border, left: border, right: border };
      const labelTable = (rows) => new D.Table({
        width: { size: 9026, type: D.WidthType.DXA }, columnWidths: [3000, 6026],
        rows: rows.map(([label, value]) => new D.TableRow({ children: [
          new D.TableCell({ borders: cb, width: { size: 3000, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR }, children: [p([text(label, { bold: true })])] }),
          new D.TableCell({ borders: cb, width: { size: 6026, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, children: [p([text(value || "-")])] }),
        ] })),
      });

      const A = or(s.stratA, "(strategy A)"), B = or(s.stratB, "(strategy B)");
      const subg = mergeList(s.subgroupsPick, s.subgroupsCustom);
      const sens = mergeList(s.sensitivityPick, s.sensitivityCustom);
      const ipcwLines = String(s.ipcw || "").split(/\r?\n/).map((x) => x.trim()).filter(Boolean);

      let __phdcLogo = null; try { const __r = await fetch("/images/networks/phdc.png"); if (__r.ok) __phdcLogo = new Uint8Array(await __r.arrayBuffer()); } catch (e) {}
      const children = [];
      if (__phdcLogo) children.push(new D.Paragraph({ spacing: { after: 120 }, children: [new D.ImageRun({ data: __phdcLogo, transformation: { width: 210, height: 51 } })] }));
      children.push(p([text(or(s.title, "(Untitled clone-censor-weight study)"), { bold: true, size: 32 })], { spacing: { after: 40 } }));
      children.push(p([text("Study protocol · clone-censor-weight target-trial emulation · drafted " + today, { italics: true, color: "777777", size: 18 })], { spacing: { after: 160 } }));
      window.PC.abstractDocx(window.docx, pcOf(s)).forEach((c) => children.push(c));

      children.push(h1("1. Background and rationale"));
      children.push(para("This study emulates a target trial to estimate the per-protocol effect of two treatment strategies distinguished only by what happens over a grace period of " + daysTxt(s.grace) + ". A conventional as-treated analysis would misclassify person-time and introduce immortal-time bias, because treatment received at time t can only be observed in patients who survived to t; the clone-censor-weight (CCW) approach removes these biases (Hernán 2016; Hernán 2018; Maringe 2020)."));

      children.push(h1("2. Causal question (target trial)"));
      children.push(para("Among " + or(s.population, "(population)") + ", what is the effect of " + A + " versus " + B + " on " + or(s.outcome, "(outcome)") + "?"));

      children.push(h1("3. Design summary"));
      children.push(labelTable([
        ["Design", "Clone-censor-weight target-trial emulation"],
        ["Data source(s)", or(s.data, "-")],
        ["Population", or(s.population, "-")],
        ["Strategy A", A],
        ["Strategy B", B],
        ["Grace period", daysTxt(s.grace)],
        ["Time zero", or(s.timezero, "-")],
        ["Outcome", or(s.outcome, "-")],
        ["Inclusion look-back", daysTxt(s.incllookback)],
        ["Maximum follow-up", daysTxt(s.fudays)],
        ["Exclusion criteria", rowsText(s.excllist)],
        ["Covariates", rowsText(s.covlist)],
      ]));

      children.push(h1("4. Cloning"));
      children.push(para("At time zero each eligible patient is cloned once into every strategy arm. Because assignment is made by construction rather than by anything about the patient, baseline covariate distributions are identical across arms and the assigned strategy is unconfounded at time zero."));
      children.push(para("Until a patient acts, their data are compatible with both strategies, so their person-time and any event inside the grace period contribute to BOTH arms; this is what removes immortal-time bias (Maringe 2020). It also means the arms are not independent samples and the number of records exceeds the number of patients — see Sections 8 and 9."));

      children.push(h1("5. Artificial censoring (deviation)"));
      children.push(para(or(s.censor, "A clone is censored when its observed data first become incompatible with its assigned strategy. Administrative censoring applies at disenrolment or end of study.")));
      children.push(para("The two arms deviate on different schedules. A clone in the initiate arm can deviate at only one time — the end of the grace period, when it becomes clear treatment was not started — whereas a clone in the deferred arm can deviate at any moment inside it. Maringe et al. therefore fit a time-varying model in the deferred arm and a time-fixed model in the initiate arm."));

      children.push(h1("6. Inverse-probability-of-censoring weights (IPCW)"));
      children.push(para("Artificial censoring is informative: the clones that remain uncensored in an arm are those whose treatment behaviour matched it, and that behaviour is associated with prognosis. Each clone therefore receives a stabilised inverse-probability-of-censoring weight — the inverse of its estimated probability of remaining uncensored — so that the clones still in the risk set stand in for those removed and the arms stay comparable through the grace period (Maringe 2020). Censoring is modelled using baseline covariates over their look-back windows (" + rowsText(s.covlist) + "); inclusion assessed over " + daysTxt(s.incllookback) + "; exclusions: " + rowsText(s.excllist) + "; plus time-varying predictors:"));
      (ipcwLines.length ? ipcwLines : ["(list the predictors of deviation)"]).forEach((l) => children.push(bullet(l)));
      children.push(para("Separate weight models are fitted for the treatment and control arms (Section 5). Events weighted by IPCW (each mapping to the assigned strategy): " + (mergeList(s.ipcwReasonsPick, s.ipcwReasonsCustom).join("; ") || "(none selected — the artificial censoring created by cloning would then be left unadjusted)") + "."));
      children.push(para("We report the weight distribution (mean, range, extreme percentiles) and the weighted standardised mean differences between arms, and confirm the weights remove the imbalance created by artificial censoring before the primary analysis is run."));
      children.push(para("Identifying assumptions carried by the weights (Maringe 2020): (i) every predictor of deviation is measured and included; (ii) the weight models are correctly specified; (iii) positivity — the probability of deviating is non-zero at every time within the grace period, for every patient; (iv) consistency. Assumption (i) is not testable; assumption (iii) fails silently when the grace period is long enough that some covariate pattern always or never initiates, so extreme weights are inspected as a diagnostic."));

      children.push(h1("7. Follow-up and outcome"));
      children.push(para(stop(or(s.followup, "From time zero to outcome, death, disenrolment, or end of study.")) + " Maximum follow-up per patient: " + daysTxt(s.fudays) + " from time zero. Outcome: " + or(s.outcome, "(outcome)") + "."));

      children.push(h1("8. Estimand and effect measure"));
      children.push(para("Primary estimand: the per-protocol effect — what would have happened had every patient received and adhered to the assigned strategy. A conventional as-started (intention-to-treat-analogue) analysis is reported for comparison. We report " + effectText(s) + ", with 95% CIs from a non-parametric bootstrap."));
      if (usesHR(s.effect)) children.push(para("Caveat on the hazard ratio. During the grace period the two arms contain the same people, so their hazards are equal by construction and proportional hazards is violated by design. Maringe et al. (2020) advise against analysing cloned data with a simple Cox model, and against a causal reading of the hazard ratio, because it averages conditional time-specific effects over a risk set whose composition changes. The absolute contrast — difference in survival at the end of follow-up, or in restricted mean survival time — is the interpretable measure here."));

      children.push(h1("9. Statistical analysis"));
      children.push(para("Primary — clone-censor-weight (per-protocol):"));
      ["Clone the eligible cohort into the strategy arms and apply the censoring rule.", "Fit the arm-specific censoring model(s) and compute the stabilised IPCW.", "Estimate the weighted survival / cumulative-incidence curve in each arm (weighted Kaplan-Meier, or a weighted pooled logistic regression for the discrete-time hazard with the assigned strategy, follow-up time, its quadratic term, and a strategy x time interaction).", "Contrast the curves for the effect measure(s)" + (usesRMST(s.effect) ? ", taking the RMST in each arm as the area under its weighted survival curve from time zero to the horizon (" + daysTxt(s.fudays) + ") and reporting the difference" : "") + ".", "Obtain 95% CIs by non-parametric bootstrap: resample PATIENTS (not clones) with replacement, then repeat steps 1-4 — cloning, censoring, weight estimation and outcome modelling — inside every replicate. Model-based standard errors are not used: cloning inflates the apparent number of events, so they are too small (Maringe 2020)."].forEach((l) => children.push(numItem(l)));
      children.push(para("Comparison — conventional analysis (as-started, ITT-analogue): start follow-up at the index date, balance the arms by propensity-score matching (standardised mean difference < 0.1), and handle the competing risk of death with Fine–Gray sub-distribution and cause-specific Cox models."));
      if (mergeList(s.ipcwReasonsPick, s.ipcwReasonsCustom).some((x) => /^death/i.test(x))) children.push(para("Note on death. Death is listed above as an event censored and weighted by IPCW. Censoring at death and weighting for it estimates a hypothetical effect — the effect that would be seen if death could not occur — which is a different estimand from the total effect in a world where death competes with the outcome. State which of the two is intended, and report the competing-risk analysis alongside it (Young 2020)."));

      children.push(h1("10. Subgroup analyses"));
      (subg.length ? subg : ["(none pre-specified)"]).forEach((l) => children.push(bullet(l)));

      children.push(h1("11. Sensitivity analyses"));
      (sens.length ? sens : ["(none pre-specified)"]).forEach((l) => children.push(bullet(l)));

      window.PC.tailDocx(window.docx, pcOf(s)).forEach((c) => children.push(c));

      children.push(h1("References"));
      REFS.forEach((l) => children.push(bullet(l)));

      children.push(p([new D.TextRun({ text: "Drafted with the Protocol Generator (" + today + ").", font: FONT, size: 18, italics: true, color: "808080" })], { spacing: { before: 400 } }));

      const doc = new D.Document({
        creator: "Protocol Generator — CCW",
        title: "CCW protocol — " + (s.title || "study"),
        styles: { default: { document: { run: { font: FONT, size: 22 } } }, paragraphStyles: [
          { id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 28, bold: true, font: FONT }, paragraph: { spacing: { before: 200, after: 80 }, outlineLevel: 0 } },
        ] },
        numbering: { config: [{ reference: "ordered", levels: [{ level: 0, format: D.LevelFormat.DECIMAL, text: "%1.", alignment: D.AlignmentType.LEFT, style: { paragraph: { indent: { left: 720, hanging: 360 } } } }] }] },
        sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }],
      });
      return await D.Packer.toBlob(doc);
    };

    document.querySelector("[data-action='download-docx']").addEventListener("click", async () => {
      if (!window.docx) { setMsg("The Word engine (docx) did not load — check the network, then reload the page.", true); return; }
      setMsg("Building the Word document…");
      try { dl(await buildDocx(readForm()), fname("docx")); setMsg("Word document downloaded."); }
      catch (e) { console.error(e); setMsg("Word export failed: " + (e && e.message ? e.message : e), true); }
    });
  </script>
</BaseLayout>
