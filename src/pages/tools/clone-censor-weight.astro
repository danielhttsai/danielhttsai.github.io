      const H = horizon(s);
      return ({
        RD: "the difference in survival at " + H + " — equivalently the risk difference — together with the risk ratio, obtained by contrasting the weighted survival / cumulative-incidence curves",
        RMST: "the difference in restricted mean survival time (RMST) up to " + H + ", obtained as the area between the weighted survival curves",
        RDRMST: "two absolute contrasts of the weighted survival curves — the difference in survival at " + H + ", which is equivalently the risk difference, and the difference in restricted mean survival time (RMST) up to that same horizon. This is the pair reported in the worked example of Maringe et al. (2020)",
        HR: "the hazard ratio from a weighted pooled logistic regression (discrete-time hazards) model with the assigned strategy as the exposure, reported with the caveat in Section 10 that proportional hazards cannot hold in a cloned design",
        both: "both absolute effects (the difference in survival at " + H + ", the risk difference and the risk ratio from the weighted curves) and the relative effect (hazard ratio from a weighted pooled logistic model), the absolute contrast being the primary measure",
      })[s.effect] || "the per-protocol effect on the risk of the outcome";
    };
    const usesHR = (e) => e === "HR" || e === "both";
    const usesRMST = (e) => e === "RMST" || e === "RDRMST";

