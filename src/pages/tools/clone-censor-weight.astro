      const para = (str) => p([text(str)]);
      const bullet = (str) => new D.Paragraph({ children: [text(str)], bullet: { level: 0 }, spacing: { before: 0, after: 0 } });
      const numItem = (str) => new D.Paragraph({ children: [text(str)], numbering: { reference: "ordered", level: 0 }, spacing: { before: 0, after: 0 } });
      const border = { style: D.BorderStyle.SINGLE, size: 4, color: "BBBBBB" };
      const cb = { top: border, bottom: border, left: border, right: border };
      const labelTable = (rows) => new D.Table({
        width: { size: 9026, type: D.WidthType.DXA }, columnWidths: [3000, 6026],
        rows: rows.map(([label, value]) => new D.TableRow({ children: [
          new D.TableCell({ borders: cb, width: { size: 3000, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, shading: { fill: "F5F5F5", type: D.ShadingType.CLEAR }, children: [p([text(label, { bold: true })])] }),
          new D.TableCell({ borders: cb, width: { size: 6026, type: D.WidthType.DXA }, margins: { top: 60, bottom: 60, left: 100, right: 100 }, children: [p([text(value || "-")])] }),
        ] })),
      });

      const A = or(s.stratA, "(strategy A)"), B = or(s.stratB, "(strategy B)");
      const subg = mergeList(s.subgroupsPick, s.subgroupsCustom);
      const sens = mergeList(s.sensitivityPick, s.sensitivityCustom);
      const ipcwLines = String(s.ipcw || "").split(/\r?\n/).map((x) => x.trim()).filter(Boolean);

      let __phdcLogo = null; try { const __r = await fetch("/images/networks/phdc.png"); if (__r.ok) __phdcLogo = new Uint8Array(await __r.arrayBuffer()); } catch (e) {}
      const children = [];
      if (__phdcLogo) children.push(new D.Paragraph({ spacing: { after: 120 }, children: [new D.ImageRun({ data: __phdcLogo, transformation: { width: 210, height: 51 } })] }));
      children.push(p([text(or(s.title, "(Untitled clone-censor-weight study)"), { bold: true, size: 32 })], { spacing: { after: 40 } }));
      children.push(p([text("Study protocol · clone-censor-weight target-trial emulation · drafted " + today, { italics: true, color: "777777", size: 18 })], { spacing: { after: 160 } }));
      // The refusals, at the top, where a reader cannot miss them. Without this
      // the whole of the consistency-check panel stayed behind on the screen.
      const blk = blockers(s);
      if (blk.length) {
        children.push(p([text("This draft cannot be analysed as written.", { bold: true, color: "9E3A2C" })], { spacing: { before: 120, after: 40 } }));
        blk.forEach((b) => children.push(new D.Paragraph({ children: [text(b, { color: "9E3A2C" })], bullet: { level: 0 }, spacing: { before: 0, after: 40 } })));
      }
      window.PC.abstractDocx(window.docx, pcOf(s)).forEach((c) => children.push(c));

      children.push(h1("1. Background and rationale"));
      children.push(para("This study emulates a target trial to estimate the per-protocol effect of two treatment strategies distinguished only by what happens over a grace period of " + daysTxt(s.grace) + ". A conventional as-treated analysis would misclassify person-time and introduce immortal-time bias, because treatment received at time t can only be observed in patients who survived to t; the clone-censor-weight (CCW) approach removes these biases (Hernán 2016; Hernán 2018; Maringe 2020)."));

      children.push(h1("2. Causal question (target trial)"));
      children.push(para("Among " + or(s.population, "(population)") + ", what is the effect of " + A + " versus " + B + " on " + or(s.outcome, "(outcome)") + "?"));

      children.push(h1("3. Design summary"));
      children.push(labelTable([
        ["Design", "Clone-censor-weight target-trial emulation"],
        ["Data source(s)", or(s.data, "-")],
        ["Population", or(s.population, "-")],
        ["Strategy A", A],
        ["Strategy B", B],
        ["Grace period", daysTxt(s.grace)],
        ["Time zero", or(s.timezero, "-")],
        ["Outcome", or(s.outcome, "-")],
        ["Inclusion look-back", daysTxt(s.incllookback)],
        ["Maximum follow-up", daysTxt(s.fudays)],
        ["Exclusion criteria", rowsText(s.excllist)],
        ["Covariates", rowsText(s.covlist)],
      ]));

      // HARPER item 7.2 — the study design diagram. This page drew one on
      // screen and shipped a Word protocol without it, which is the one item a
      // CCW protocol can least afford to omit: cloning, the grace period and
      // the two arms' different deviation schedules are far easier to see than
      // to read. designDiagramDocx emits the picture, a numbered caption and
      // the written window list together, and it is that text — not the image —
      // that an extractor or a reviewer reading the .docx as text can see. It
      // never throws; on failure it returns a visible amber note, so the
      // protocol still exports and the page can say which of the two you got.
      lastFigNote = "";
      const fig = await window.designDiagramFigure(document.getElementById("diagram"), { caption: FIG_CAPTION });
      const figParas = window.designDiagramDocx(D, fig, { font: FONT, caption: FIG_CAPTION });
      figParas.forEach((c) => children.push(c));
      if (!figParas.placed) lastFigNote = " Exported WITHOUT the design diagram: " + (fig.reason || figParas.error || "unknown reason") + ". The document says so where the figure should be.";

      children.push(h1("4. Cloning"));
      children.push(para("At time zero each eligible patient is cloned once into every strategy arm. Because assignment is made by construction rather than by anything about the patient, baseline covariate distributions are identical across arms and the assigned strategy is unconfounded at time zero."));
      children.push(para("Until a patient acts, their data are compatible with both strategies, so their person-time and any event inside the grace period contribute to BOTH arms; this is what removes immortal-time bias (Maringe 2020). It also means the arms are not independent samples and the number of records exceeds the number of patients — see Sections 8 and 9."));

      children.push(h1("5. Artificial censoring (deviation)"));
      children.push(para(censorText(s)));
      children.push(para(DEVIATION_SCHEDULE));

      children.push(h1("6. Inverse-probability-of-censoring weights (IPCW)"));
      children.push(para("Artificial censoring is informative: the clones that remain uncensored in an arm are those whose treatment behaviour matched it, and that behaviour is associated with prognosis. Each clone therefore receives a stabilised inverse-probability-of-censoring weight: at each time, the ratio of its estimated probability of remaining uncensored given only the assigned strategy to its estimated probability of remaining uncensored given the strategy AND the measured covariate history, cumulated over follow-up. The clones still in the risk set then stand in for those removed, and the arms stay comparable through the grace period (Maringe 2020). The inverse of the probability of remaining uncensored, on its own, is the UNSTABILISED weight; stabilising replaces its numerator, which holds the mean of the weights near 1 and is what makes the weight distribution reported below a usable diagnostic. Censoring is modelled using baseline covariates over their look-back windows (" + rowsText(s.covlist) + "); inclusion assessed over " + daysTxt(s.incllookback) + "; exclusions: " + rowsText(s.excllist) + "; plus time-varying predictors:"));
      (ipcwLines.length ? ipcwLines : ["(list the predictors of deviation)"]).forEach((l) => children.push(bullet(l)));
      children.push(para("A separate weight model is fitted for each arm (Section 5). Events weighted by IPCW (each mapping to the assigned strategy): " + (mergeList(s.ipcwReasonsPick, s.ipcwReasonsCustom).join("; ") || "(none selected — the artificial censoring created by cloning would then be left unadjusted)") + "."));
      children.push(para(BALANCE + " " + truncText(s)));
      children.push(para(ASSUMPTIONS));

      children.push(h1("7. Follow-up and outcome"));
      children.push(para(stop(followupText(s)) + " Maximum follow-up per patient: " + daysTxt(s.fudays) + " from time zero. Outcome: " + or(s.outcome, "(outcome)") + "."));

      children.push(h1("8. Estimand and effect measure"));
      children.push(para("Primary estimand: the per-protocol effect — what would have happened had every patient received and adhered to the assigned strategy. The effect estimated by " + COMPARISON_SHORT + " is reported for comparison. We report " + effectText(s) + ", with 95% CIs from a non-parametric bootstrap."));
      if (usesHR(s.effect)) children.push(para(HR_CAVEAT));

      children.push(h1("9. Statistical analysis"));
      children.push(para("Primary — clone-censor-weight (per-protocol):"));
      ["Clone the eligible cohort into the strategy arms and apply the censoring rule.", "Fit the arm-specific censoring model(s) and compute the stabilised IPCW.", "Estimate the weighted survival / cumulative-incidence curve in each arm (weighted Kaplan-Meier, or a weighted pooled logistic regression for the discrete-time hazard with the assigned strategy, follow-up time, its quadratic term, and a strategy x time interaction).", "Contrast the curves for the effect measure(s)" + (usesRMST(s.effect) ? ", taking the RMST in each arm as the area under its weighted survival curve from time zero to " + rmstHorizon(s) + " and reporting the difference" : "") + ".", "Obtain 95% CIs by non-parametric bootstrap: resample PATIENTS (not clones) with replacement, then repeat steps 1-4 — cloning, censoring, weight estimation and outcome modelling — inside every replicate. Model-based standard errors are not used: cloning inflates the apparent number of events, so they are too small (Maringe 2020)."].forEach((l) => children.push(numItem(l)));
      children.push(para(comparisonText(s)));
      if (hasDeath(s)) children.push(para("Note on death. Death is listed above as an event censored and weighted by IPCW. Censoring at death and weighting for it estimates a hypothetical effect — the effect that would be seen if death could not occur — which is a different estimand from the total effect in a world where death competes with the outcome. State which of the two is intended, and report the competing-risk analysis alongside it (Young 2020)."));

      children.push(h1("10. Subgroup analyses"));
      (subg.length ? subg : ["(none pre-specified)"]).forEach((l) => children.push(bullet(l)));

      children.push(h1("11. Sensitivity analyses"));
      (sens.length ? sens : ["(none pre-specified)"]).forEach((l) => children.push(bullet(l)));

      window.PC.tailDocx(window.docx, pcOf(s)).forEach((c) => children.push(c));

      children.push(h1("References"));
      REFS.forEach((l) => children.push(bullet(l)));

      children.push(p([new D.TextRun({ text: "Drafted with the Protocol Generator (" + today + ").", font: FONT, size: 18, italics: true, color: "808080" })], { spacing: { before: 400 } }));

      const doc = new D.Document({
        creator: "Protocol Generator — CCW",
        title: "CCW protocol — " + (s.title || "study"),
        styles: { default: { document: { run: { font: FONT, size: 22 } } }, paragraphStyles: [
          { id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true, run: { size: 28, bold: true, font: FONT }, paragraph: { spacing: { before: 200, after: 80 }, outlineLevel: 0 } },
        ] },
        numbering: { config: [{ reference: "ordered", levels: [{ level: 0, format: D.LevelFormat.DECIMAL, text: "%1.", alignment: D.AlignmentType.LEFT, style: { paragraph: { indent: { left: 720, hanging: 360 } } } }] }] },
        sections: [{ properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }],
      });
      return await D.Packer.toBlob(doc);
    };

    document.querySelector("[data-action='download-docx']").addEventListener("click", async () => {
      if (!window.docx) { setMsg("The Word engine (docx) did not load — check the network, then reload the page.", true); return; }
      setMsg("Building the Word document…");
      try {
        const s = readForm(), nb = blockers(s).length;
        dl(await buildDocx(s), fname("docx"));
        setMsg("Word document downloaded." + (nb ? " It carries " + nb + " unresolved design problem(s) from the checks panel." : "") + lastFigNote, !!lastFigNote || nb > 0);
      }
      catch (e) { console.error(e); setMsg("Word export failed: " + (e && e.message ? e.message : e), true); }
    });
  </script>
</BaseLayout>
