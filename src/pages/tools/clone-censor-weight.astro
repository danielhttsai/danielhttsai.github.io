      const grace = dayInt(s.grace), fu = dayInt(s.fudays), covRows = parseRows(s.covlist), lb = covRows.length;
      const reasons = mergeList(s.ipcwReasonsPick, s.ipcwReasonsCustom);
      // Every refusal comes from blockers(), which both exports also print, so
      // the panel and the documents cannot say different things. The panel used
      // to hold the only copy.
      blockers(s).forEach((m) => checks.push({ level: "error", msg: m }));
      // The inclusion look-back is not a blocker — an unreadable value prints
      // "(invalid)" and misleads nobody — but it should still be named.
      if (badNum(s.incllookback)) checks.push({ level: "error", msg: "The inclusion look-back reads “" + s.incllookback + "”, which cannot be read as a whole number of days of 0 or more, so the protocol prints “(invalid)” rather than guessing. A value the text and the diagram would read differently is refused rather than silently rounded." });
