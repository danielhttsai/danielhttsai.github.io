---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { FRAMEWORKS, DEFAULT_FRAMEWORK } from "../../data/frameworks";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// ── AI backend ────────────────────────────────────────────────
// Deployed Cloudflare Worker URL (see workers/target-checker/README.md).
const WORKER_URL = "https://target-checker.danielhttsai.workers.dev";

// PHDc logo, stamped onto the downloadable reports. LOGO_URL is same-origin
// (for the Word export's binary fetch); LOGO_ABS is absolute so the Markdown
// report's image renders wherever the .md is opened.
const LOGO_URL = `${base}/images/networks/phdc.png`;
const LOGO_ABS = new URL(LOGO_URL, Astro.site ?? "https://danielhttsai.github.io/").href;

const fwList = Object.values(FRAMEWORKS);
---

<BaseLayout
  title="Protocol Checker — Daniel Tsai"
  description="Upload an RWE protocol and check it, item by item, against HARPER (the ISPE/ISPOR protocol template) or TARGET — with an auto-drawn study-design scheme and a planned-outputs review. Free, AI-assisted."
>
  <header class="relative bg-gradient-to-br from-brand-50 via-white to-brand-100/40 border-b border-slate-200 overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14">
      <p class="uppercase tracking-widest text-xs text-brand-600 font-semibold mb-2">RWE Tools</p>
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900">Protocol Checker</h1>
      <p class="mt-4 text-lg text-slate-600 max-w-3xl">
        Upload a real-world-evidence protocol and check it, item by item, against
        <strong>HARPER</strong> (the ISPE/ISPOR protocol template) — or <strong>TARGET</strong> for target-trial
        emulations. You also get an auto-drawn study-design scheme and a review of the planned shell tables and figures.
        The flip side of the Protocol Generator: audit a protocol you already have.
      </p>
    </div>
  </header>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a class="text-brand-700 hover:underline font-semibold" href={`${base}/tools`}>← All RWE tools</a>
      <a class="text-brand-700 hover:underline font-semibold" href={`${base}/tools/protocol-generator`}>Protocol Generator →</a>
    </div>

    {WORKER_URL === "" ? (
      <div class="rounded-2xl border border-amber-300 bg-amber-50 p-6">
        <h2 class="text-lg font-bold text-amber-900">AI checker is being set up</h2>
        <p class="mt-2 text-sm text-amber-800 leading-relaxed">
          The checker is almost ready — the AI backend just needs to be connected. Meanwhile, the
          <a href={`${base}/tools/protocol-generator`} class="font-semibold underline">Protocol Generator</a> can draft a
          protocol for you.
        </p>
      </div>
    ) : (
      <>
        <!-- Input -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-bold text-slate-900">Your protocol</h2>
            <fieldset class="flex flex-wrap items-center gap-1.5 text-sm">
              <legend class="sr-only">Framework</legend>
              <span class="text-xs font-semibold text-slate-500 mr-1">Check against:</span>
              {fwList.map((f) => (
                <label class="cursor-pointer">
                  <input type="radio" name="framework" value={f.key} checked={f.key === DEFAULT_FRAMEWORK} class="peer sr-only" />
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600 peer-checked:border-brand-500 peer-checked:bg-brand-50 peer-checked:text-brand-700">
                    {f.name} <span class="hidden sm:inline font-normal text-slate-400 peer-checked:text-brand-600">· {f.tagline}</span>
                  </span>
                </label>
              ))}
            </fieldset>
          </div>
          <p id="fwnote" class="-mt-2 text-xs text-slate-500 leading-relaxed"></p>

          <label id="drop" for="file"
            class="flex flex-col items-center justify-center gap-1.5 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center cursor-pointer hover:border-brand-400 hover:bg-brand-50/40 transition">
            <span class="text-3xl">📄</span>
            <span class="text-sm font-semibold text-slate-700">Upload your protocol</span>
            <span class="text-xs text-slate-500">Word (.docx), PDF, plain text (.txt/.md) or Excel (.xlsx) — click to choose, or drop a file here</span>
            <input id="file" type="file" accept=".docx,.xlsx,.pdf,.txt,.md,.markdown" class="hidden" />
          </label>

          <div id="filechip" class="hidden items-start justify-between gap-3 rounded-xl border border-brand-200 bg-brand-50 px-4 py-3">
            <div class="min-w-0">
              <p id="filename" class="text-sm font-semibold text-slate-800 truncate"></p>
              <p id="filemeta" class="text-xs text-slate-500"></p>
              <ul id="filenotes" class="mt-1.5 space-y-1 text-xs text-amber-800"></ul>
            </div>
            <button id="removefile" class="shrink-0 text-sm font-semibold text-slate-500 hover:text-red-600">Remove ✕</button>
          </div>
          <p id="fileerr" class="text-xs text-red-600 hidden"></p>

          <details id="pastewrap">
            <summary class="text-xs font-semibold text-brand-700 cursor-pointer hover:underline">or paste the text instead</summary>
            <textarea id="text" rows="10"
              class="mt-3 w-full rounded-xl border border-slate-300 p-4 text-sm leading-relaxed focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
              placeholder="Paste your protocol or manuscript text here…"></textarea>
          </details>

          <p id="inputnote" class="hidden text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2 leading-relaxed"></p>

          <div class="flex flex-wrap items-center gap-3 border-t border-slate-100 pt-4">
            <button id="check"
              class="rounded-xl bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-800 disabled:opacity-50 disabled:cursor-not-allowed transition">
              Check protocol
            </button>
            <button id="clear" class="text-sm text-slate-500 hover:text-slate-800">Clear</button>
            <span id="status" class="text-sm text-slate-500"></span>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            ⓘ Checked by a free AI model (Google Gemini). Text is sent to Google for analysis and is not stored by this
            site, but <strong>please don't upload confidential or unpublished-sensitive material</strong>. Results are
            AI-generated guidance to help self-audit a protocol's completeness — not a substitute for the official
            guideline or peer review.
          </p>
        </div>

        <!-- A failure the tool cannot recover from is shown here, in full, instead
             of a score. Never score a document we could not actually assess. -->
        <div id="runerror" class="hidden rounded-2xl border border-red-300 bg-red-50 p-6">
          <h2 class="text-lg font-bold text-red-900">The check could not be completed</h2>
          <p id="runerrormsg" class="mt-2 text-sm text-red-800 leading-relaxed"></p>
          <p class="mt-3 text-xs text-red-700 leading-relaxed">Nothing was scored. A partial or unreadable answer is never turned into a conformance percentage.</p>
        </div>

        <!-- Results -->
        <div id="results" class="hidden space-y-6">
          <!-- A finished report used to survive any change to the input that
               produced it: edit the text, swap the file, or move the framework
               radio and the score, the verdicts and both download buttons stayed
               exactly as they were, with nothing on screen to say so. This bar
               sits at the top of the results card — a few dozen pixels above the
               download buttons, which is where the user actually is — and names
               what changed. The report is NOT hidden: it is a real report of a
               real run, and hiding it reads as data loss. -->
          <div id="stalebar" class="hidden rounded-2xl border border-amber-400 bg-amber-50 p-5">
            <h2 class="text-base font-bold text-amber-900">⚠ This report is out of date</h2>
            <ul id="stalereasons" class="mt-2 space-y-1 text-sm text-amber-900 leading-relaxed"></ul>
            <p class="mt-2 text-xs text-amber-800 leading-relaxed">
              Nothing below has been re-checked, and both download buttons still export <strong>this</strong> report — the file will say so.
              Press <strong>Check protocol</strong> again to score what is in the input now.
            </p>
          </div>

          <!-- TARGET suggestion (shown after a HARPER run on an emulation) -->
          <div id="tte" class="hidden rounded-2xl border border-brand-300 bg-brand-50 p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="text-sm text-slate-700"><strong class="text-brand-800">This looks like a target-trial emulation.</strong> <span id="ttereason"></span></p>
              <button id="alsotarget" class="shrink-0 rounded-xl bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-800">Also check against TARGET →</button>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <h2 id="confhead" class="text-lg font-bold text-slate-900">Conformance</h2>
                <p id="summary" class="mt-1 text-sm text-slate-600 leading-relaxed"></p>
              </div>
              <div class="shrink-0 flex items-center gap-2">
                <button id="downloadword" class="rounded-xl bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-800 disabled:opacity-50 disabled:cursor-wait">⬇ Word (.docx)</button>
                <button id="download" class="rounded-xl border border-brand-300 px-4 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50">⬇ Markdown</button>
              </div>
            </div>
            <!-- A download that fails has to say so HERE. Its only report used to
                 go to #status, which lives in the input card ~1,300px above: the
                 observable behaviour of a blocked CDN was a button that did
                 nothing, for ever. -->
            <p id="dlerr" class="hidden mt-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700 leading-relaxed"></p>
            <div id="bar" class="mt-4 flex h-2.5 w-full overflow-hidden rounded-full bg-slate-100"></div>
            <div id="tally" class="mt-3 flex flex-wrap gap-2 text-xs font-semibold"></div>
            <!-- The AI's own prose summary, kept apart from the tally above it.
                 It is unchecked free text and routinely states a total of its
                 own, which is not the total this page computed. -->
            <p id="aisummary" class="hidden mt-3 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-600 leading-relaxed"></p>
            <!-- These paragraphs are the frame around the number. They are
                 read out of the DOM by both exporters (`frameText()`), so the
                 report cannot carry the score without carrying them. -->
            <p id="howtoread" class="mt-3 text-xs text-slate-500 leading-relaxed">
              <strong class="text-slate-600">How to read this.</strong> <em>Met</em> = the protocol says it, substantively.
              <em>Partial</em> = the topic is raised but a key element (usually an operational definition, code list, or window) is missing.
              <em>Missing</em> = no trace in the text. <em>N/A</em> = the item cannot apply to this kind of document.
              <em>Not assessed</em> = the AI returned no usable verdict, so nothing is claimed either way.
              <em>Not scored</em> = the AI did answer, but the row is a heading for sub-items counted separately, so counting it too would count the same content twice.
              All three of N/A, Not assessed and Not scored are excluded from the score, so the denominator <em>can</em> be smaller than the checklist —
              the sentence beside the score says when it is, and by how much.
            </p>
            <!-- Filled from the framework registry in render(). The score's
                 denominator is this tool's own row count, and the page used to
                 call that count "this checklist's 31 TARGET items" — a false
                 statement about a 21-item published guideline, carried verbatim
                 into both exported reports. -->
            <p id="rowsnote" class="mt-2 text-xs text-slate-500 leading-relaxed"></p>
            <p id="notascore" class="mt-2 text-xs text-slate-500 leading-relaxed">
              <strong class="text-slate-600">Neither HARPER nor TARGET defines a conformance score.</strong> This ratio is this tool's own summary of the
              item-level verdicts below; the guidelines are checklists, not scales, and a percentage is not what either was written to produce.
              The verdicts are the output — the number is a way of sorting them.
            </p>
            <p id="onesample" class="mt-2 text-xs text-slate-500 leading-relaxed">
              <strong class="text-slate-600">This score is one sample, not a measurement.</strong> The same protocol, submitted four times unchanged,
              scored 19, 20, 21 and 22 of the 23 HARPER items in our own testing — the model is not deterministic. Treat a one- or two-item difference as noise,
              read the per-item evidence rather than the total, and re-run if a verdict surprises you.
            </p>
            <!-- Everything the run could NOT do is listed here rather than folded
                 silently into the tally. -->
            <ul id="caveats" class="mt-3 space-y-1.5 text-xs text-amber-800"></ul>
          </div>

          <!-- Study design scheme -->
          <div id="scheme" class="hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-slate-900">Study design scheme</h2>
            <p class="mt-1 text-xs text-slate-500">
              <strong class="text-slate-600">This diagram was drawn by this tool from your text.</strong> It is not evidence that your protocol contains a study-design diagram — that is item 7.2, judged separately below.
              A window the AI <strong>declared</strong> it had assumed is drawn dashed and marked <strong>*</strong>; a window it could not place on a day axis is not drawn and is named under the diagram.
              The AI does not always declare an assumption, so a solid bar is not a guarantee that the duration was stated in your protocol — check every window against it.
            </p>
            <dl id="designgrid" class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-3"></dl>
            <div class="mt-5 overflow-x-auto">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Timeline (days relative to index date)</p>
              <div id="timeline"></div>
              <p id="timelinenote" class="hidden mt-2 text-xs text-amber-800"></p>
              <div id="legend" class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-slate-600"></div>
            </div>
            <div id="criteria" class="mt-6 grid gap-5 sm:grid-cols-3"></div>
          </div>

          <!-- Planned outputs & figures -->
          <div id="deliverables" class="hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-slate-900">Planned outputs &amp; figures</h2>
            <p class="mt-1 text-xs text-slate-500">Does the protocol pre-specify the shell tables and figures a rigorous RWE study mocks up in advance — Table 1, a Love plot, a participant flow diagram, results shells, and so on?</p>
            <div id="delivtally" class="mt-3 flex flex-wrap gap-2 text-xs font-semibold"></div>
            <p id="delivnote" class="mt-3 text-xs text-slate-500 leading-relaxed"><strong class="text-slate-600">What the five labels mean.</strong> <em>Present / Partial / Absent</em> are claims about your document: whether it pre-specifies this output — or the equivalent your design owes, since these seven names are written for a person-level, propensity-score-adjusted, time-to-event cohort. A case-selection flow counts as the flow diagram; a case-series or period-composition description counts as the Table 1; an incidence-rate-ratio profile by risk window counts as the survival curve. <em>N/A</em> is a claim about your design: its estimator cannot produce this output or any equivalent — there is no between-person balance to diagnose in a within-person design, and no survival curve where nobody is followed from a shared time origin. Two rows can never be N/A and are recorded as Absent if the AI says otherwise — the primary results shell and the sensitivity-analysis outputs, because every design has a primary estimate, and assumptions worth probing: identifying assumptions where a contrast is estimated, and measurement assumptions — outcome and denominator misclassification — where none is. Two of the five labels can be this tool’s rather than the AI’s: <em>Not assessed</em>, which is always this tool recording that the AI gave no verdict or gave one it does not recognise, and an <em>Absent</em> on one of those two barred rows where the AI had said N/A, which is this tool overruling it. An ordinary <em>Absent</em> on those rows is the AI’s own verdict like any other. Every label this tool supplied rather than read says so in its own evidence line. Read the evidence line before acting on any of them.</p>
            <ol id="delivlist" class="mt-4 space-y-3"></ol>
          </div>

          <div id="items" class="space-y-6"></div>
          <p id="cite" class="text-xs text-slate-400 leading-relaxed"></p>
        </div>
      </>
    )}
  </section>

  {WORKER_URL !== "" && (
    <script is:inline define:vars={{ WORKER_URL, FRAMEWORKS, DEFAULT_FRAMEWORK, LOGO_URL, LOGO_ABS }}>
      const MAMMOTH = "https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.9.0/mammoth.browser.min.js";
      const PDFJS = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js";
      const PDFJS_WORKER = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
      const SHEETJS = "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js";
      const DOCX = "https://unpkg.com/docx@8.5.0/build/index.umd.js";

      // The worker truncates the document at this many characters before it
      // reaches the model. Mirrored here so the page can warn BEFORE spending a
      // request, and can say exactly how much was left out. Keep in lock-step
      // with MAX_CHARS in workers/target-checker/worker.js.
      const MAX_CHARS = 60000;

      // The planned-outputs list the worker asks the model about, mirrored here
      // ONLY so the page can tell "the model judged this absent" apart from
      // "the model never answered about this". Keep in lock-step with
      // DELIVERABLES in workers/target-checker/worker.js.
      const DELIVERABLE_NAMES = [
        "Participant flow diagram",
        "Baseline characteristics table (Table 1)",
        "Love plot / covariate balance",
        "Primary results table (shell)",
        "Cumulative incidence / Kaplan-Meier curve",
        "Forest plot",
        "Sensitivity-analysis outputs",
      ];

      const $ = (id) => document.getElementById(id);
      const drop = $("drop"), fileEl = $("file"), fileChip = $("filechip"), fileNameEl = $("filename"), fileMetaEl = $("filemeta"), fileNotesEl = $("filenotes"), removeFile = $("removefile"), fileErr = $("fileerr");
      const textEl = $("text"), checkBtn = $("check"), clearBtn = $("clear"), statusEl = $("status"), inputNoteEl = $("inputnote"), fwNoteEl = $("fwnote");
      const resultsEl = $("results"), confHead = $("confhead"), summaryEl = $("summary"), aiSummaryEl = $("aisummary"), tallyEl = $("tally"), barEl = $("bar"), itemsEl = $("items"), caveatsEl = $("caveats"), citeEl = $("cite");
      // The paragraphs that frame what the score is and is not. Read out of
      // the page itself so an export can never carry a different wording than the
      // one on screen — or, as it did, carry none of it.
      const frameText = () => ["howtoread", "rowsnote", "notascore", "onesample"].map((id) => {
        const el = $(id);
        return el ? el.textContent.replace(/\s+/g, " ").trim() : "";
      }).filter(Boolean);
      // Same job as frameText, for the planned-outputs panel: the definition of
      // the four verdicts is authored once, in the markup, and both exports
      // quote it from there rather than keeping a paraphrase of their own.
      const delivNoteText = () => {
        const el = $("delivnote");
        return el ? el.textContent.replace(/\s+/g, " ").trim() : "";
      };
      const runErrEl = $("runerror"), runErrMsg = $("runerrormsg");
      const schemeEl = $("scheme"), designGrid = $("designgrid"), timelineEl = $("timeline"), timelineNote = $("timelinenote"), legendEl = $("legend"), criteriaEl = $("criteria");
      const delivEl = $("deliverables"), delivTallyEl = $("delivtally"), delivListEl = $("delivlist");
      const tteEl = $("tte"), tteReason = $("ttereason"), alsoTargetBtn = $("alsotarget");
      const staleBar = $("stalebar"), staleReasonsEl = $("stalereasons");
      // `loadedNotes` carries everything the extractor could NOT read, so it can
      // be shown next to the score instead of quietly disappearing.
      let loadedText = "", loadedName = "", loadedNotes = [], lastReport = null;
      // Reading a file is asynchronous. If a second file is chosen before the
      // first finishes, the slower read must not write its result — or its error
      // — over the newer one. Seen live: a success message and a failure message
      // from two different files on screen at the same time.
      let fileSeq = 0;
      // Reading a file did not disable "Check protocol". `loadedText` is only
      // assigned once a read SUCCEEDS, so while the second upload was being
      // read the chip named the new file and `getInputText()` still returned
      // the old one: the page said "Checking against HARPER…" for a document it
      // was not sending, and settled into a chip naming one protocol above a
      // report on another. The button is held for the duration of any read.
      // Two different things hold this button, and the first version of this
      // let the second one release the first's grip: `setReadPending` wrote
      // `disabled` unconditionally, so a file chosen DURING a check re-enabled
      // "Check protocol" while the request was still outstanding. Clicking it
      // spent a second request against the free daily quota and the screen
      // settled on whichever answer arrived last — the OLDER run's verdicts.
      // Both owners now vote, and the button is disabled if either says so.
      let readsPending = 0, runInFlight = false;
      function syncCheckBtn() {
        const busy = readsPending > 0 || runInFlight;
        checkBtn.disabled = busy;
        checkBtn.title = runInFlight ? "A check is already running"
          : readsPending > 0 ? "Waiting for the uploaded file to finish being read" : "";
      }
      function setReadPending(delta) { readsPending = Math.max(0, readsPending + delta); syncCheckBtn(); }

      const setStatus = (msg, isErr) => { statusEl.textContent = msg || ""; statusEl.className = "text-sm " + (isErr ? "text-red-600" : "text-slate-500"); };
      const escapeHtml = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
      const getFramework = () => { const r = document.querySelector('input[name="framework"]:checked'); return r ? r.value : DEFAULT_FRAMEWORK; };
      const fwOf = (key) => FRAMEWORKS[key] || FRAMEWORKS[DEFAULT_FRAMEWORK];

      // Load a library once and wait for it to actually finish. The previous
      // version resolved the moment a <script> tag with the same src EXISTED,
      // which is true from the instant it is appended — so a second call while
      // the first download was still in flight resolved early and the caller hit
      // `window.XLSX.read` on an undefined XLSX. Observed live: a workbook that
      // read fine on one attempt failed on another with "Cannot read properties
      // of undefined (reading 'read')".
      //
      // A stalled download also needs its own deadline. `onerror` fires for a
      // refused or 404 request, but a request that simply never answers fires
      // nothing at all, and the only backstop was the 90-second read timeout —
      // during which the page said "Reading yourfile.docx…" and gave no hint it
      // was waiting on a CDN. That is the shape of the reported stall: the first
      // upload loads its reader fine, a second upload of a DIFFERENT format has
      // to fetch a reader that has never loaded, and if that fetch hangs the
      // page looks frozen with nothing to explain it.
      const scriptPromises = new Map();
      const SCRIPT_TIMEOUT = 20000;
      function loadScript(src, alt) {
        if (scriptPromises.has(src)) return scriptPromises.get(src);
        const name = src.split("/").pop();
        // Name the host that actually failed. This message hardcoded
        // cdnjs.cloudflare.com because three of its four callers use it — but the
        // fourth, the Word export, loads from unpkg.com, so a user behind a proxy
        // that blocks unpkg was told to have the wrong domain unblocked.
        let host = "the CDN it is hosted on";
        try { host = new URL(src, location.href).host; } catch (e) {}
        const p = new Promise((res, rej) => {
          const s = document.createElement("script");
          const fail = (why) => {
            // Drop the cached promise so the next attempt can genuinely retry
            // rather than replaying this failure for the rest of the session.
            scriptPromises.delete(src);
            try { s.remove(); } catch (e) {}
            rej(new Error("A component needed for this step (" + name + ") " + why +
              ". It is fetched from " + host + " — check your connection or any blocker, then try again." + (alt || "")));
          };
          const timer = setTimeout(() => fail("took more than " + (SCRIPT_TIMEOUT / 1000) + " seconds to download"), SCRIPT_TIMEOUT);
          s.src = src;
          s.onload = () => { clearTimeout(timer); res(); };
          s.onerror = () => { clearTimeout(timer); fail("could not be downloaded"); };
          document.head.appendChild(s);
        });
        scriptPromises.set(src, p);
        return p;
      }

      // ── File extraction ────────────────────────────────────────────────
      // Every extractor returns { text, notes } — `notes` is everything the
      // reader could not see. It is shown on screen and carried into the report,
      // because an unread table or an unread figure is the difference between
      // "your protocol is missing this" and "we could not check this".

      // A .docx is a ZIP. Entry names sit uncompressed in the archive, so the
      // embedded pictures can be counted by scanning the bytes — no unzip needed.
      // Worth doing because HARPER 7.2 REQUIRES a study-design diagram, and a
      // diagram that exists only as a picture is invisible to a text reader:
      // without this note the tool reports "missing" for a figure that is there.
      function countDocxImages(buf) {
        const bytes = new Uint8Array(buf);
        let s = "";
        for (let i = 0; i < bytes.length; i += 0x8000) s += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
        const names = new Set();
        const re = /word\/media\/[\w.\-]{1,120}\.(?:png|jpe?g|gif|bmp|tiff?|emf|wmf|svg)/gi;
        let m;
        while ((m = re.exec(s))) names.add(m[0].toLowerCase());
        return names.size;
      }

      // Word text. mammoth.extractRawText is used deliberately: convertToHtml
      // would preserve table structure, but it hangs indefinitely on the Word
      // files this site's own protocol builders produce — a silent "Reading…"
      // forever is far worse than losing the table borders. Cell text IS read.
      async function extractDocx(file, step) {
        step("Loading the Word reader…");
        await loadScript(MAMMOTH, " Or paste the text instead.");
        step("Extracting the text…");
        const buf = await file.arrayBuffer();
        let r;
        try {
          r = await window.mammoth.extractRawText({ arrayBuffer: buf });
        } catch (e) {
          // mammoth surfaces JSZip's internals here ("Can't find end of central
          // directory…"), which tells a clinical researcher nothing.
          const m = (e && e.message) || "";
          if (/central directory|zip/i.test(m)) throw new Error("This file is not a readable Word document — a .docx is a zip archive and this one could not be opened. It may be corrupted, or renamed from another format. Re-save it from Word, or paste the text instead.");
          throw new Error("This Word document could not be read" + (m ? " (" + m + ")" : "") + ". Re-save it from Word, or paste the text instead.");
        }
        const notes = [];
        const imgs = countDocxImages(buf);
        if (imgs) notes.push(imgs + (imgs === 1 ? " embedded image was" : " embedded images were") + " found and could NOT be read (this includes any logo). Anything that exists only as a picture — a study-design diagram, a flow chart — is invisible to this check and may be reported as missing.");
        notes.push("Table cells are read, but their row and column structure is not, so an operational-definition table reads as a run of short lines.");
        return { text: r.value || "", notes, detail: "Word document" + (imgs ? " · " + imgs + " image(s) not read" : "") };
      }

      async function extractXlsx(file, step) {
        step("Loading the spreadsheet reader…");
        await loadScript(SHEETJS, " Or paste the text instead.");
        step("Reading the cells…");
        const wb = window.XLSX.read(new Uint8Array(await file.arrayBuffer()), { type: "array" });
        const notes = [];
        const parts = [];
        const empty = [];
        for (const n of wb.SheetNames) {
          const csv = window.XLSX.utils.sheet_to_csv(wb.Sheets[n]);
          if (csv.replace(/[\s,]/g, "")) parts.push(n + "\n" + csv);
          else empty.push(n);
        }
        if (empty.length) notes.push("Sheet(s) with no readable cells were skipped: " + empty.join(", ") + ".");
        notes.push("Only cell text is read. Charts, images, and comments in the workbook are not.");
        return { text: parts.join("\n\n"), notes, detail: parts.length + " of " + wb.SheetNames.length + " sheet(s) read" };
      }

      async function extractPdf(file, step) {
        step("Loading the PDF reader…");
        await loadScript(PDFJS, " Or paste the text instead.");
        step("Opening the PDF…");
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = PDFJS_WORKER;
        let pdf;
        try {
          pdf = await window.pdfjsLib.getDocument({ data: await file.arrayBuffer() }).promise;
        } catch (e) {
          const n = (e && e.name) || "";
          if (/Password/i.test(n) || /password/i.test((e && e.message) || "")) {
            throw new Error("This PDF is password-protected, so its text cannot be read. Remove the protection, or paste the text instead.");
          }
          throw new Error("This file could not be opened as a PDF" + (e && e.message ? " (" + e.message + ")" : "") + ".");
        }
        const notes = [];
        let out = "", emptyPages = 0;
        for (let i = 1; i <= pdf.numPages; i++) {
          const tc = await (await pdf.getPage(i)).getTextContent();
          const page = tc.items.map((t) => t.str).join(" ").trim();
          if (!page) emptyPages++;
          out += page + "\n";
        }
        const perPage = out.trim().length / Math.max(1, pdf.numPages);
        if (emptyPages) notes.push(emptyPages + " of " + pdf.numPages + " page(s) contained no text layer at all — those pages are images to this tool and were not assessed.");
        if (perPage < 200) notes.push("Only about " + Math.round(perPage) + " characters per page were readable across " + pdf.numPages + " page(s). This usually means a scanned document; run OCR or paste the text instead.");
        notes.push("A PDF's figures cannot be read. Anything that exists only as a diagram is invisible to this check.");
        return { text: out, notes, detail: pdf.numPages + " page(s)" };
      }

      // A .txt is the only upload with no parser behind it, so it is the only one
      // that cannot fail. A renamed .docx, a gzip, or a UTF-16 export decodes to
      // thousands of replacement characters, clears the 200-character floor
      // easily (every bad byte becomes a character that counts), and is sent to
      // the model as though it were a protocol — which then scores it. Decode by
      // the byte-order mark where there is one (UTF-16 is what Notepad's
      // "Unicode" option and several Windows statistical packages write), and
      // refuse what still comes back as bytes rather than text.
      const NOTTEXT_RE = /[\uFFFD\u0000-\u0008\u000B\u000C\u000E-\u001F]/g;
      async function extractPlain(file, step) {
        step("Reading the text…");
        const buf = new Uint8Array(await file.arrayBuffer());
        let enc = "utf-8";
        if (buf.length > 1 && buf[0] === 0xFF && buf[1] === 0xFE) enc = "utf-16le";
        else if (buf.length > 1 && buf[0] === 0xFE && buf[1] === 0xFF) enc = "utf-16be";
        let text;
        try { text = new TextDecoder(enc).decode(buf); }
        catch (e) { text = new TextDecoder("utf-8").decode(buf); enc = "utf-8"; }
        const notes = enc === "utf-8" ? [] : ["This file was saved as " + enc.toUpperCase() + " rather than UTF-8, and was decoded accordingly."];
        const bad = (text.match(NOTTEXT_RE) || []).length;
        const pct = Math.round((bad / (text.length || 1)) * 100);
        if (bad / (text.length || 1) > 0.02) {
          throw new Error("“" + file.name + "” does not read as plain text — about " + pct + "% of it is bytes that are not characters, so nothing here can be assessed. " +
            "A file renamed to .txt keeps its original format inside: if this is really a Word document, a PDF or a spreadsheet, upload it under its own extension. " +
            "If it is text, re-save it as UTF-8 (in Word or Notepad: “Save as → Plain Text (UTF-8)”), or paste the text instead.");
        }
        return { text, notes };
      }

      const UNSUPPORTED = {
        ".doc": "This is the old Word format (.doc). Open it in Word and use “Save As → Word Document (.docx)”, then upload that.",
        ".rtf": "Rich Text (.rtf) cannot be read here. Save it as .docx or .txt, or paste the text instead.",
        ".odt": "OpenDocument (.odt) cannot be read here. Save it as .docx or .txt, or paste the text instead.",
        ".pages": "Apple Pages files cannot be read here. Export to Word (.docx) or PDF, or paste the text instead.",
        ".xls": "This is the old Excel format (.xls). Save it as .xlsx, or paste the text instead.",
      };

      async function handleFile(f) {
        if (!f) return;
        const seq = ++fileSeq;
        const stale = () => seq !== fileSeq;
        setReadPending(1);
        // Drop the previous file HERE, not on success. While this read is in
        // flight the tool holds no file: it must not be able to fall back on
        // the one the user has just replaced. Say so immediately: both
        // exporters recompute staleness at click time, so a screen that still
        // believed in the old file would disagree with a download taken during
        // the read, and the input note would go on naming a file already dropped.
        loadedText = ""; loadedName = ""; loadedNotes = [];
        refreshInputNote();
        // Say which STEP is running, not just "Reading…". A stalled CDN fetch
        // for a reader this page has not needed before is indistinguishable
        // from a slow file otherwise, and the user is left watching a word.
        const step = (msg) => { if (!stale()) fileMetaEl.textContent = msg + " (" + f.name + ")"; };
        fileErr.classList.add("hidden");
        // Not while a check is running: this used to erase "Checking against
        // HARPER…" and leave an idle-looking page over an outstanding request.
        if (!runInFlight) setStatus("");
        const name = f.name.toLowerCase();
        drop.classList.add("opacity-50", "pointer-events-none");
        fileMetaEl.textContent = "Reading " + f.name + "…";
        fileNotesEl.innerHTML = "";
        fileNameEl.textContent = "📄 " + f.name;
        fileChip.classList.remove("hidden"); fileChip.classList.add("flex");
        drop.classList.add("hidden");
        try {
          const bad = Object.keys(UNSUPPORTED).find((ext) => name.endsWith(ext));
          if (bad) throw new Error(UNSUPPORTED[bad]);
          let job;
          if (name.endsWith(".docx")) job = extractDocx(f, step);
          else if (name.endsWith(".xlsx")) job = extractXlsx(f, step);
          else if (name.endsWith(".pdf")) job = extractPdf(f, step);
          else if (/\.(txt|md|markdown)$/.test(name)) job = extractPlain(f, step);
          else throw new Error("“" + f.name + "” is not a file type this tool can read. Use Word (.docx), PDF, plain text (.txt/.md) or Excel (.xlsx) — or paste the text instead.");
          // A reader that never returns must not leave "Reading…" on screen for
          // ever. (mammoth's HTML converter does exactly that on some files.)
          const res = await Promise.race([job, new Promise((_, rej) =>
            setTimeout(() => rej(new Error("Reading this file took longer than 90 seconds and was stopped. It may be very large or damaged — try saving it again from Word, or paste the text instead.")), 90000))]);
          if (stale()) return;
          const txt = (res.text || "").trim();
          if (txt.length < 200) {
            throw new Error("Only " + txt.length + " characters of text could be read from this file, which is not enough to assess." +
              (name.endsWith(".pdf") ? " If it is a scanned PDF, run OCR on it or paste the text instead." : " Paste the text instead."));
          }
          loadedText = txt; loadedName = f.name; loadedNotes = res.notes || [];
          fileMetaEl.textContent = txt.length.toLocaleString() + " characters extracted" + (res.detail ? " from " + res.detail : "") + " · ready to check";
          fileNotesEl.innerHTML = loadedNotes.map((n) => '<li class="flex gap-1.5"><span>⚠</span><span>' + escapeHtml(n) + "</span></li>").join("");
        } catch (e) {
          if (stale()) return;
          loadedText = ""; loadedName = ""; loadedNotes = [];
          fileChip.classList.add("hidden"); fileChip.classList.remove("flex");
          drop.classList.remove("hidden");
          fileErr.textContent = (e && e.message) ? e.message : String(e); fileErr.classList.remove("hidden");
        } finally {
          setReadPending(-1);
          // Always clear the input's value, even for a superseded read. If it
          // keeps the old filename, re-picking that same file fires no `change`
          // event at all and the page simply does nothing — which looks exactly
          // like a hang. The newer read already holds its own File object, so
          // resetting the element cannot disturb it.
          fileEl.value = "";
          if (!stale()) {
            drop.classList.remove("opacity-50", "pointer-events-none");
            refreshInputNote();
          }
        }
      }

      fileEl.addEventListener("change", () => handleFile(fileEl.files && fileEl.files[0]));

      // The dashed box looked droppable but was not wired up: dropping a file on
      // it made the browser navigate away and lose the page.
      ["dragenter", "dragover"].forEach((ev) => drop.addEventListener(ev, (e) => {
        e.preventDefault(); drop.classList.add("border-brand-500", "bg-brand-50");
      }));
      ["dragleave", "dragend"].forEach((ev) => drop.addEventListener(ev, () => drop.classList.remove("border-brand-500", "bg-brand-50")));
      drop.addEventListener("drop", (e) => {
        e.preventDefault();
        drop.classList.remove("border-brand-500", "bg-brand-50");
        const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
        if (f) handleFile(f);
      });
      // Anywhere else on the page, a stray drop should do nothing rather than
      // replace the tool with the dropped file.
      window.addEventListener("dragover", (e) => e.preventDefault());
      window.addEventListener("drop", (e) => e.preventDefault());

      // Dropping the loaded file must also CANCEL a read that is still running.
      // Without the ++fileSeq, a read started before the click stays "current"
      // and, when it finishes, writes "…ready to check" and re-arms loadedText
      // into a page the user has just emptied — a file they thought they had
      // removed, silently queued for checking behind a hidden chip.
      function resetFileInput() {
        fileSeq++;
        loadedText = ""; loadedName = ""; loadedNotes = [];
        fileChip.classList.add("hidden"); fileChip.classList.remove("flex");
        fileNotesEl.innerHTML = "";
        fileMetaEl.textContent = "";
        fileNameEl.textContent = "";
        fileEl.value = "";
        drop.classList.remove("hidden");
        drop.classList.remove("opacity-50", "pointer-events-none");
      }

      removeFile.addEventListener("click", () => { resetFileInput(); refreshInputNote(); });

      const getInputText = () => (loadedText ? loadedText : (textEl.value || "").trim());

      // Say plainly which text will be checked, and how much of it. Two silent
      // failures live here: an uploaded file quietly overriding pasted text, and
      // the worker silently cutting a long document off at MAX_CHARS.
      function refreshInputNote() {
        const pasted = (textEl.value || "").trim();
        const msgs = [];
        if (loadedText && pasted) {
          msgs.push("Both a file and pasted text are present. The uploaded file (" + escapeHtml(loadedName) + ") will be checked; the pasted text will be ignored. Remove the file to check the pasted text instead.");
        } else if (!loadedText && pasted) {
          // "Paste the text instead" is a collapsed <details>. Text left in it
          // is invisible once closed, and the note above fires only when a file
          // is ALSO present — so after an upload failed or was removed, the
          // page showed an empty drop zone, a red error, and nothing at all to
          // say that an older protocol was still queued and would be checked.
          msgs.push("There is no file loaded, so the text pasted under “or paste the text instead” (" +
            pasted.length.toLocaleString() + " characters) is what will be checked. Open that section to see it, or use Clear to start again.");
        }
        const text = getInputText();
        if (text.length > MAX_CHARS) {
          msgs.push("This document is " + text.length.toLocaleString() + " characters. Only the first " + MAX_CHARS.toLocaleString() +
            " (" + Math.round(MAX_CHARS / text.length * 100) + "%) can be sent to the AI, so roughly the last " +
            (text.length - MAX_CHARS).toLocaleString() + " characters will not be assessed. Consider checking the protocol in sections.");
        }
        inputNoteEl.innerHTML = msgs.map((m) => "<span>⚠ " + m + "</span>").join("<br>");
        inputNoteEl.classList.toggle("hidden", !msgs.length);
        refreshStaleness();
      }
      textEl.addEventListener("input", refreshInputNote);

      // ── Is the report on screen still a report on what is in the input? ──
      // Nothing used to tie the two together. `lastReport` was set on a run and
      // cleared only by "Clear", so editing the pasted text, swapping the file
      // or moving the framework radio left a finished report — score, verdicts,
      // and two live download buttons — describing a document the user had
      // already replaced. The exported .docx even carried today's date.
      //
      // What the report is a report ON is stamped from the text the request was
      // actually built from, captured in `runCheck` BEFORE the 10-20 second
      // round trip — never re-read at render time. A user who edits the box
      // while the model is thinking would
      // otherwise have the new text stamped onto a report of the old one, and
      // the staleness check would certify the very mismatch it exists to catch.
      //
      // `notes` and `date` are captured here for the same reason. Both used to
      // be read at the far end of the round trip — `loadedNotes` inside
      // `render()`, the date inside the download handlers — and both are global
      // state the user can move in the meantime. Uploading a file while the
      // model is thinking pushed THAT file's caveats ("2 embedded images were
      // found and could NOT be read") into a report on pasted text that had no
      // images; removing a file during the wait deleted the caveats of the
      // document actually being scored, so a report on a .docx with three
      // unreadable figures exported with no "What this check could not do"
      // section at all. A run's caveats belong to that run.
      const sourceLabel = () => (loadedName ? "“" + loadedName + "”" : "the pasted text");
      const stampSource = (fwKey, text) => ({
        text, name: loadedName, label: sourceLabel(), fwKey,
        notes: loadedNotes.slice(),
        date: new Date().toISOString().slice(0, 10),
      });

      // Returns the reasons the report no longer describes the input — empty
      // when it still does. Used by the on-screen bar AND by both exporters, so
      // a file downloaded while stale cannot leave the browser without saying so.
      //
      // Each reason carries two wordings. A downloaded .docx is read somewhere
      // else, by someone who never saw this page, possibly months later: it has
      // no "above" to point at and no "now" to be true in. `screen` talks about
      // the controls; `file` states what had happened by the time the file was
      // written. Same computation, two registers.
      function staleReasons() {
        const s = lastReport && lastReport.source;
        if (!s) return [];
        const out = [];
        const now = getInputText();
        if (now !== s.text) {
          if (!now) out.push(readsPending > 0 ? {
            // Mid-read the tool holds no file on purpose. Saying the input was
            // "removed" would be false — one is being loaded, not taken away.
            screen: "This report was generated from " + s.label + ". A file is being read into the tool now.",
            file: "The input this report was generated from (" + s.label + ") was being replaced when this file was downloaded.",
          } : {
            screen: "This report was generated from " + s.label + "; there is now nothing in the input to check.",
            file: "The input this report was generated from (" + s.label + ") had been removed from the tool before this file was downloaded.",
          });
          // Same label, different text. For pasted text that means it was
          // edited; for a file it means a DIFFERENT document was uploaded under
          // the same name — this tool has no editor for an uploaded file, so
          // saying it had been "edited" describes something that cannot happen.
          else if (sourceLabel() === s.label) out.push(loadedName ? {
            screen: "This report was generated from " + s.label + ", and a different document has since been loaded under that same file name.",
            file: "A different document was loaded under the same file name (" + s.label + ") before this file was downloaded, so the verdicts below are not about the file currently in the tool.",
          } : {
            screen: "This report was generated from " + s.label + ", which has been changed since it ran.",
            file: "The input this report was generated from (" + s.label + ") had been edited in the tool before this file was downloaded.",
          });
          else out.push({
            screen: "This report was generated from " + s.label + "; the input is now " + sourceLabel() + ".",
            file: "This report was generated from " + s.label + ", but a different input (" + sourceLabel() + ") had been loaded into the tool before this file was downloaded.",
          });
        }
        if (getFramework() !== s.fwKey) out.push({
          screen: "This report scores your protocol against " + fwOf(s.fwKey).name + ". The picker above now says " +
            fwOf(getFramework()).name + ", which has not been run on this document.",
          file: "This is a " + fwOf(s.fwKey).name + " report. The framework picker had been moved to " + fwOf(getFramework()).name +
            " before this file was downloaded, and " + fwOf(getFramework()).name + " was never run on this document.",
        });
        return out;
      }

      function refreshStaleness() {
        if (!staleBar) return;
        const reasons = staleReasons();
        staleReasonsEl.innerHTML = reasons.map((r) =>
          '<li class="flex gap-1.5"><span class="shrink-0">•</span><span>' + escapeHtml(r.screen) + "</span></li>").join("");
        staleBar.classList.toggle("hidden", !reasons.length);
      }

      // ── Rendering ──
      const STATUS_META = {
        met:      { label: "Met",          dot: "bg-emerald-500", chip: "bg-emerald-50 text-emerald-700 border-emerald-200", bar: "bg-emerald-500", edge: "border-emerald-300" },
        partial:  { label: "Partial",      dot: "bg-amber-500",   chip: "bg-amber-50 text-amber-700 border-amber-200",       bar: "bg-amber-500",   edge: "border-amber-300" },
        missing:  { label: "Missing",      dot: "bg-red-500",     chip: "bg-red-50 text-red-700 border-red-200",             bar: "bg-red-500",     edge: "border-red-300" },
        na:       { label: "N/A",          dot: "bg-slate-400",   chip: "bg-slate-50 text-slate-600 border-slate-200",       bar: "bg-slate-300",   edge: "border-slate-200" },
        // Distinct from "missing" on purpose. "Missing" is a claim about the
        // protocol; "not assessed" is a claim about this run. Conflating them
        // is how a model that skipped an item turns into a red mark against the
        // author — TARGET item 7 is skipped by the model routinely, because it
        // is the parent of 7a-7h.
        unassessed: { label: "Not assessed", dot: "bg-slate-300", chip: "bg-white text-slate-500 border-slate-300 border-dashed", bar: "bg-slate-200", edge: "border-slate-300" },
        // A THIRD thing, and it must not be folded into either of the two above.
        // "Missing" is a claim about the protocol; "Not assessed" is a claim
        // about the AI ("returned no usable verdict"); this is a claim about
        // this tool — the AI answered, and the answer was deliberately left out
        // of the score because the row is a heading for rows counted separately.
        // Putting it under "Not assessed" would make the legend's definition of
        // that word false, which is the same conflation that once aliased
        // "unclear" to "partial".
        notscored: { label: "Not scored", dot: "bg-slate-400", chip: "bg-slate-50 text-slate-500 border-slate-300 border-dotted", bar: "bg-slate-400", edge: "border-slate-300" },
      };
      // There was a `SCORED` constant here, listing met/partial/missing/**na**.
      // Nothing read it, and it contradicted the only denominator this page
      // actually computes — `assessable`, which is met + partial + missing and
      // deliberately excludes N/A. A dead constant with an authoritative name
      // and the wrong contents is worse than no constant: the next hand to
      // reach for the obviously-named list would have put every N/A row back
      // into the denominator, and both exports would have followed silently.
      // Every bucket, in the order the tally and the bar show them. `total` must
      // stay equal to the checklist's own size, so anything added here must be
      // counted there too.
      const ALL_STATUSES = ["met", "partial", "missing", "na", "unassessed", "notscored"];

      // The model is asked for a fixed vocabulary but is not bound to it. Anything
      // outside the vocabulary must NOT be silently coerced into a verdict.
      // Prototype-less, for the reason DELIV_ALIASES is: as a plain literal,
      // `STATUS_ALIASES["constructor"]` is the inherited `Object`, which is
      // truthy, so `normStatus` returned it, the `!st` guard below never fired,
      // `STATUS_META[v.status]` was undefined and reading `.edge` off it threw
      // — refusing the ENTIRE report, score and all, for one unexpected word in
      // one item. The deliverables twin of this bug only mislabelled a row.
      const STATUS_ALIASES = Object.assign(Object.create(null), {
        met: "met", yes: "met", present: "met", complete: "met", satisfied: "met", addressed: "met",
        partial: "partial", partially: "partial", "partially met": "partial", incomplete: "partial",
        missing: "missing", absent: "missing", no: "missing", "not met": "missing", "not addressed": "missing", "not reported": "missing",
        na: "na", "n/a": "na", "not applicable": "na", notapplicable: "na", inapplicable: "na",
      });
      // "Unclear" is not a verdict on the protocol — it is the model saying it
      // could not tell. It used to be aliased to "partial", which on this page
      // means something specific and accusatory: "the topic is raised but a key
      // element (usually an operational definition, code list, or window) is
      // missing". That is a finding the model never made, and it is the exact
      // conflation STATUS_META.unassessed was written to prevent. These go to
      // "Not assessed", keeping whatever the model did say as the evidence.
      const UNDECIDED = new Set(["unclear", "uncertain", "unsure", "unknown", "cannot tell", "can't tell",
        "cannot determine", "indeterminate", "not assessed", "not assessable", "insufficient information", "ambiguous"]);
      function normStatus(s) {
        const k = String(s == null ? "" : s).trim().toLowerCase();
        if (UNDECIDED.has(k)) return "unassessed";
        return STATUS_ALIASES[k] || null;
      }
      // Ids come back from the model as "7.3.1", "7.3.1.", "Item 7.3.1", "7A"…
      function normId(s) {
        return String(s == null ? "" : s).trim().toLowerCase()
          .replace(/^item\s*/, "").replace(/[\s.)]+$/, "").replace(/\s+/g, "");
      }
      const KIND_COLOR = { washout: "#6366f1", covariate: "#f59e0b", exposure: "#14b8a6", followup: "#10b981", grace: "#8b5cf6", outcome: "#ef4444" };
      const KIND_LABEL = { washout: "Washout / eligibility", covariate: "Covariate look-back", exposure: "Exposure", followup: "Follow-up", grace: "Grace period", outcome: "Outcome window" };

      // Abbreviate only where the conversion is exact. Rounding put "−3mo" (90
      // days) on the diagram for a 100-day covariate look-back and "+1.1y" for
      // 400 days of follow-up, while the exported report printed -100 and 400 —
      // so the picture and the file described different windows, and the picture
      // is the part people read. A window of 400 days is now labelled 400d.
      function fmtDay(d) {
        if (!Number.isFinite(d)) return "?";
        if (d === 0) return "0";
        const a = Math.abs(d), s = d < 0 ? "−" : "+";
        if (a % 365 === 0) return s + a / 365 + "y";
        if (a >= 60 && a % 30 === 0) return s + a / 30 + "mo";
        return s + a + "d";
      }

      // Read a day the way a day must be read: a number, or a string that IS a
      // number — never a coercion. `Number()` turns null, "", false and [] into
      // 0, all finite, so the guard below used to accept a window the model
      // could not place and draw it as a real window sitting on the index date:
      // "Covariate look-back  0 → 0" for a look-back whose start came back null.
      // A look-back the tool cannot read is not a zero-day look-back.
      const DAY_RE = /^[+-]?(?:\d+(?:\.\d+)?|\.\d+)(?:[eE][+-]?\d+)?$/;
      function readDay(v) {
        if (typeof v === "number") return Number.isFinite(v) ? v : null;
        if (typeof v === "string" && DAY_RE.test(v.trim())) return Number(v.trim());
        return null;
      }
      const showRaw = (v) => (v === undefined ? "no value" : typeof v === "string" ? "“" + (v.length > 40 ? v.slice(0, 40) + "…" : v) + "”" : String(v));

      // The model is instructed to guess a duration it cannot find ("choose a
      // reasonable default and set note to 'assumed'"), so `note` is the only
      // thing separating a window read from the protocol from one invented for
      // it. It has to reach the screen, not just the exported file.
      const assumedNote = (w) => {
        const n = String((w && w.note) || "").trim();
        return n && /assum|not stated|unstated|default|guess|inferred|approx/i.test(n) ? n : "";
      };

      // A criteria list the AI returned as prose, or as objects, is not an empty
      // criteria list. The panel and both exporters rendered anything that was
      // not a non-empty array as "— none stated —", so a protocol whose
      // eligibility the AI had extracted in full came back to its author as
      // having none — and array entries that were objects printed as
      // "[object Object]" into the Word file. Read what is there, say what could
      // not be read, and never split prose into criteria we were not given.
      const NAMED_KEYS = ["name", "criterion", "criteria", "label", "text", "description", "item", "value"];
      function readList(v, what) {
        if (Array.isArray(v)) {
          const items = [], bad = [];
          for (const x of v) {
            if (typeof x === "string" || typeof x === "number" || typeof x === "boolean") {
              const s = String(x).trim();
              if (s) items.push(s);
            } else if (x && typeof x === "object") {
              const s = NAMED_KEYS.map((k) => x[k]).find((y) => typeof y === "string" && y.trim());
              if (s) items.push(s.trim()); else bad.push(x);
            }
          }
          return { items, note: bad.length ? bad.length + " entr" + (bad.length === 1 ? "y" : "ies") + " in the " + what + " could not be read as text and " + (bad.length === 1 ? "is" : "are") + " not shown" : "" };
        }
        if (typeof v === "string" && v.trim()) {
          return { items: [v.trim()], note: "the AI returned the " + what + " as one block of prose rather than as separate entries; it is shown as written and has NOT been split, so the count of entries here is not the number of " + what };
        }
        return { items: [], note: "" };
      }

      // A window whose days are not finite numbers produces NaN geometry, which
      // SVG renders as nothing at all — a diagram that silently loses a row is
      // worse than one that says a row was unusable.
      function cleanTimeline(tl) {
        const kept = [], dropped = [];
        // A timeline returned as a sentence is not an absent timeline. Without
        // this the panel says "No analysis windows could be placed on a day axis
        // from this text" — a claim about the protocol — when the AI did answer
        // and the answer was simply not in the shape asked for.
        if (!Array.isArray(tl) && tl != null && String(tl).trim()) {
          return { kept, dropped: [{ name: "the whole timeline", why: "the AI returned it as " + (typeof tl === "string" ? "prose" : "a " + typeof tl) + " rather than as windows with start and end days: " + showRaw(typeof tl === "string" ? tl : JSON.stringify(tl)) }] };
        }
        for (const w of (Array.isArray(tl) ? tl : [])) {
          const a = readDay(w && w.startDay), b = readDay(w && w.endDay);
          if (a !== null && b !== null) { kept.push({ ...w, startDay: a, endDay: b }); continue; }
          const why = [a === null ? "start day " + showRaw(w && w.startDay) : "", b === null ? "end day " + showRaw(w && w.endDay) : ""].filter(Boolean).join(", ");
          dropped.push({ name: (w && (w.label || w.kind)) || "unnamed window", why });
        }
        return { kept, dropped };
      }

      function renderTimeline(clean) {
        if (!Array.isArray(clean) || !clean.length) return "";
        const rows = clean.slice().sort((a, b) => a.startDay - b.startDay);
        let lo = 0, hi = 0;
        for (const w of rows) { lo = Math.min(lo, w.startDay, w.endDay); hi = Math.max(hi, w.startDay, w.endDay); }
        if (lo === hi) hi = lo + 1;
        const pad = (hi - lo) * 0.04 || 1; lo -= pad; hi += pad;
        const W = 820, plotL = 195, plotR = W - 20, plotW = plotR - plotL;
        const rowH = 30, top = 44, H = top + rows.length * rowH + 28;
        const x = (d) => plotL + ((d - lo) / (hi - lo)) * plotW;
        const x0 = x(0);
        let svg = '<svg viewBox="0 0 ' + W + ' ' + H + '" class="w-full h-auto" style="min-width:560px" xmlns="http://www.w3.org/2000/svg">';
        svg += '<line x1="' + x0 + '" y1="26" x2="' + x0 + '" y2="' + (H - 16) + '" stroke="#0f766e" stroke-width="1.5" stroke-dasharray="4 3"/>';
        svg += '<text x="' + x0 + '" y="18" text-anchor="middle" font-size="11" font-weight="700" fill="#0f766e">Index (day 0)</text>';
        svg += '<line x1="' + plotL + '" y1="' + (H - 16) + '" x2="' + plotR + '" y2="' + (H - 16) + '" stroke="#cbd5e1"/>';
        for (const d of [Math.ceil(lo), 0, Math.floor(hi)]) {
          svg += '<text x="' + x(d) + '" y="' + (H - 4) + '" text-anchor="middle" font-size="10" fill="#94a3b8">' + fmtDay(d) + '</text>';
        }
        rows.forEach((w, i) => {
          const y = top + i * rowH;
          const xa = x(Math.min(w.startDay, w.endDay)), xb = x(Math.max(w.startDay, w.endDay));
          const ww = Math.max(3, xb - xa), col = KIND_COLOR[w.kind] || "#64748b";
          // A duration the AI DECLARED it assumed is drawn hollow and dashed, so
          // it cannot be read as one the protocol stated. The converse does not
          // hold — `note` is optional in the worker's schema and the model does
          // not always volunteer it — so the caption says a solid bar is not a
          // guarantee either. Marking what we know beats marking nothing.
          const asm = assumedNote(w);
          svg += '<text x="' + (plotL - 10) + '" y="' + (y + 15) + '" text-anchor="end" font-size="11" fill="#334155">' + escapeHtml(w.label || KIND_LABEL[w.kind] || w.kind) + (asm ? " *" : "") + '</text>';
          svg += asm
            ? '<rect x="' + xa + '" y="' + (y + 3) + '" width="' + ww + '" height="18" rx="4" fill="' + col + '" fill-opacity="0.18" stroke="' + col + '" stroke-width="1.2" stroke-dasharray="4 3"/>'
            : '<rect x="' + xa + '" y="' + (y + 3) + '" width="' + ww + '" height="18" rx="4" fill="' + col + '" fill-opacity="0.88"/>';
          const dur = fmtDay(w.startDay) + " → " + fmtDay(w.endDay);
          if (ww > 78) svg += '<text x="' + (xa + ww / 2) + '" y="' + (y + 16) + '" text-anchor="middle" font-size="9.5" fill="' + (asm ? col : "#fff") + '" font-weight="600">' + escapeHtml(dur) + '</text>';
          else svg += '<text x="' + (xb + 5) + '" y="' + (y + 16) + '" font-size="9.5" fill="#64748b">' + escapeHtml(dur) + '</text>';
        });
        return svg + "</svg>";
      }

      function renderScheme(d, caveats) {
        const fields = [["Design", d && d.designType], ["Population", d && d.population], ["Exposure", d && d.exposure], ["Comparator", d && d.comparator], ["Outcome", d && d.outcome], ["Index date (time zero)", d && d.indexDate]];
        const { kept, dropped } = cleanTimeline(d && d.timeline);
        const anyField = fields.some(([, v]) => v && String(v).trim() && String(v).trim() !== "—");
        const anyList = ["inclusion", "exclusion", "covariates"].some((k) => Array.isArray(d && d[k]) && d[k].length);
        // An empty array is truthy; the old gate let a completely blank scheme
        // render as a panel full of em-dashes, which looks like an answer.
        if (!d || (!anyField && !anyList && !kept.length)) {
          schemeEl.classList.add("hidden");
          if (caveats) caveats.push("No study-design scheme could be reconstructed from this text, so the design diagram and criteria panel are not shown.");
          return null;
        }
        designGrid.innerHTML = fields.map(([k, v]) =>
          '<div><dt class="text-[11px] uppercase tracking-wider font-semibold text-slate-500">' + escapeHtml(k) + '</dt><dd class="text-sm text-slate-800 leading-snug">' + escapeHtml(v || "—") + '</dd></div>').join("");
        timelineEl.innerHTML = kept.length ? renderTimeline(kept)
          : '<p class="text-xs text-slate-500 italic">No analysis windows could be placed on a day axis from this text.</p>';
        const tlNotes = [];
        const assumed = kept.filter(assumedNote);
        if (dropped.length) tlNotes.push("⚠ " + dropped.length + " window(s) were returned without usable start/end days and are not drawn: " +
          dropped.map((x) => escapeHtml(x.name) + (x.why ? " (" + escapeHtml(x.why) + ")" : "")).join("; ") + ".");
        if (assumed.length) tlNotes.push("* " + assumed.length + " window(s) are drawn dashed because their duration is <strong>not stated in the text</strong> — the AI assumed it: " +
          assumed.map((w) => escapeHtml(w.label || KIND_LABEL[w.kind] || w.kind) + " (" + escapeHtml(assumedNote(w)) + ")").join("; ") + ". Check these against your protocol before using the diagram.");
        timelineNote.innerHTML = tlNotes.join("<br>");
        timelineNote.classList.toggle("hidden", !tlNotes.length);
        if (dropped.length && caveats) caveats.push(dropped.length + " timeline window(s) had no usable start/end day and were left out of the design diagram: " +
          dropped.map((x) => x.name + (x.why ? " (" + x.why + ")" : "")).join("; ") + ".");
        // Said in the caveats too, because that is the only channel that reaches
        // the Markdown and Word reports.
        if (assumed.length && caveats) caveats.push(assumed.length + " timeline window(s) are drawn from a duration the AI assumed rather than read from the text (" +
          assumed.map((w) => w.label || KIND_LABEL[w.kind] || w.kind).join(", ") + "). Verify them before treating the diagram as your study design.");
        const kinds = [...new Set(kept.map((w) => w.kind))];
        legendEl.innerHTML = kinds.map((k) =>
          '<span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm" style="background:' + (KIND_COLOR[k] || "#64748b") + '"></span>' + escapeHtml(KIND_LABEL[k] || k) + '</span>').join("") +
          (assumed.length ? '<span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm border border-dashed border-slate-500"></span>dashed = duration assumed by the AI, not stated</span>' : "");

        // Explicit inclusion / exclusion / covariates, colour-keyed to the diagram.
        // Read once here; the screen, the Markdown and the Word file all consume
        // this same result, so they cannot describe three different lists.
        const lists = {
          inclusion: readList(d.inclusion, "inclusion criteria"),
          exclusion: readList(d.exclusion, "exclusion criteria"),
          covariates: readList(d.covariates, "covariates"),
        };
        const col = (title, dot, key) => {
          const L = lists[key];
          const list = L.items.length
            ? '<ul class="mt-2 space-y-1">' + L.items.map((x) => '<li class="text-xs text-slate-700 leading-snug flex gap-1.5"><span class="text-slate-300">•</span><span>' + escapeHtml(x) + '</span></li>').join("") + '</ul>'
            : '<p class="mt-2 text-xs text-slate-400 italic">— none stated —</p>';
          return '<div><p class="text-[11px] uppercase tracking-wider font-bold flex items-center gap-1.5" style="color:' + dot + '"><span class="inline-block w-2.5 h-2.5 rounded-sm" style="background:' + dot + '"></span>' + title + '</p>' + list +
            (L.note ? '<p class="mt-1.5 text-[11px] text-amber-800 leading-snug">⚠ ' + escapeHtml(L.note) + '</p>' : "") + '</div>';
        };
        criteriaEl.innerHTML =
          col("Inclusion", "#6366f1", "inclusion") +
          col("Exclusion", "#ef4444", "exclusion") +
          col("Covariates", "#f59e0b", "covariates");
        for (const k of ["inclusion", "exclusion", "covariates"]) {
          if (lists[k].note && caveats) caveats.push("The " + k + " list: " + lists[k].note + ".");
        }

        schemeEl.classList.remove("hidden");
        // Handed back so the exports describe the SAME scheme the screen drew.
        return { kept, dropped, lists };
      }

      const DELIV_META = {
        present: { label: "Present", dot: "bg-emerald-500", chip: "bg-emerald-50 text-emerald-700 border-emerald-200", border: "border-emerald-300" },
        partial: { label: "Partial", dot: "bg-amber-500",   chip: "bg-amber-50 text-amber-700 border-amber-200",       border: "border-amber-300" },
        absent:  { label: "Absent",  dot: "bg-red-500",     chip: "bg-red-50 text-red-700 border-red-200",             border: "border-red-300" },
        // The same three-way distinction STATUS_META spends two paragraphs
        // defending on the checklist side, which this panel did not have.
        // "Absent" is a claim about the protocol; "N/A" is a claim about the
        // DESIGN (its estimator cannot produce the output at all); "Not
        // assessed" is a claim about this RUN. Folding the middle one into
        // either neighbour is what the worker used to force: it instructed the
        // model to answer "absent" for an inapplicable output, so the row went
        // red AND — because the suggestion line fires on every non-present
        // verdict — the Word file told an SCCS author to add a
        // propensity-score balance plot to a within-person design.
        na:      { label: "N/A",     dot: "bg-slate-400",   chip: "bg-slate-50 text-slate-600 border-slate-200",       border: "border-slate-200" },
        unassessed: { label: "Not assessed", dot: "bg-slate-300", chip: "bg-white text-slate-500 border-slate-300 border-dashed", border: "border-slate-300" },
      };
      // Prototype-less: as a plain literal, `DELIV_ALIASES["constructor"]` is
      // truthy, so a status of "constructor" or "__proto__" set `st` to a
      // function, skipped the unrecognised-verdict branch, and was counted
      // under a key the tally never prints — seven rows above a tally of five,
      // with no caveat. Unreachable while the worker's enum holds, which is
      // exactly the kind of guarantee that stops holding.
      const DELIV_ALIASES = Object.assign(Object.create(null), {
        present: "present", yes: "present", planned: "present", "pre-specified": "present", prespecified: "present",
        partial: "partial", partially: "partial", implied: "partial",
        absent: "absent", missing: "absent", no: "absent", none: "absent",
        // Mirrors STATUS_ALIASES above. The worker's enum only emits "na", but
        // the model reaches for these spellings whenever it answers in prose.
        na: "na", "n/a": "na", "not applicable": "na", notapplicable: "na", inapplicable: "na",
      });
      // The two rows the worker's rubric bars from "na", enforced here as well
      // as asked for there. A prompt-only rule fails SILENTLY and in the
      // dangerous direction: an unenforced "na" on these rows turns a red chip
      // plus a concrete suggestion into a grey chip with the suggestion
      // deleted, so a protocol with no results shell and no sensitivity
      // analyses exports a planned-outputs section containing no findings and
      // no advice. Over-flagging is visible and costs a reader a minute;
      // under-flagging is invisible and costs them the analysis. Every design
      // has a primary estimate and assumptions worth probing, so "na" here is
      // always wrong and is demoted to the verdict the model would otherwise
      // have had to give. Matched on the canonical name, which `canonBy` — and
      // now, where the model paraphrased it, `looseBy` — has already resolved.
      // Keep in lock-step with the same two names in the rubric in
      // workers/target-checker/worker.js.
      //
      // Two things the demotion does NOT do, both measured, so the paragraph
      // above stops being read as a promise of them:
      // 1. It does not restore the suggestion. The rubric tells the model to
      //    return "—" for an "na" row, `suggestionText` trims that to "", and
      //    the demoted row therefore renders Absent with no advice under it —
      //    half of what "no findings and no advice" above asks for. The finding
      //    is restored; the advice is only there when the model ignored the
      //    rubric and wrote one anyway.
      // 2. It cannot fire on a row the matcher did not resolve to one of these
      //    two exact names. That is why the loose key exists.
      const DELIV_NEVER_NA = ["Primary results table (shell)", "Sensitivity-analysis outputs"];
      // One rule, SIX surfaces — the two panels' three each. It was written out
      // three times for the planned outputs (screen, Markdown, Word) and
      // extracted here; the checklist's three copies were left behind, still
      // spelled as a not-equal blacklist, and so never learned about "na". The
      // result was a row reading "10. Reporting of adverse events — N/A" with
      // "Suggestion: State how adverse events will be handled" underneath it,
      // in all three surfaces: advice to satisfy the item the same row says
      // cannot apply. That is not a rare shape. The worker's prompt requires a
      // suggestion for EVERY checklist item and carves out only "met", and only
      // the planned-outputs half of that same prompt teaches the model to
      // return "—" when none is wanted — so a suggestion beside a checklist
      // N/A is the documented happy path, not a slip.
      //
      // The two panels' vocabularies are disjoint apart from the three words
      // they already share, so one set covers both: "present"/"met" are the
      // satisfied verdicts, and N/A, Not assessed and Not scored are the three
      // this file spends two paragraphs elsewhere insisting are claims about
      // the design, the run and the tool rather than about the protocol. None
      // of the five is something the author can act on, and advice under any of
      // them is advice about a finding nobody made.
      const NO_SUGGESTION = new Set(["present", "met", "na", "unassessed", "notscored"]);
      // The trim matters: the rubric tells the model to return "—" when no
      // suggestion is wanted, and a row reading "Suggestion: —" is a
      // content-free advice line exactly where a red row's advice belongs.
      const suggestionText = (r) => {
        const s = String(r && r.suggestion == null ? "" : r.suggestion).trim();
        return (!s || s === "—" || s === "–" || s === "-") ? "" : s;
      };
      const showSuggestion = (r) => !!suggestionText(r) && !NO_SUGGESTION.has(r && r.status);
      // …but suppressing it on an N/A row must not DELETE it, and the first
      // version of this change did. A suggestion under a row the model called
      // not applicable is the reader's best evidence that the N/A is wrong —
      // often the model's own words contradicting its own verdict, as when it
      // marks HARPER item 3 (amendments) N/A on a v1.0 protocol and then writes
      // "Add an amendments table with version, date and rationale". The caveat
      // this run adds tells the reader to audit exactly those rows, and the
      // evidence line on an N/A row is the model's justification FOR the N/A —
      // self-serving by construction. Deleting the one field that can disagree
      // with it, in the same change, would have stripped the audit's best
      // signal. So the text stays and the label changes: this file already
      // keeps the model's words and relabels them in the two other places it
      // disagrees with the model (`unrec` and the DELIV_NEVER_NA demotion), and
      // a refusal that is invisible is not a refusal.
      const showNaNote = (r) => !!suggestionText(r) && !!r && r.status === "na";
      const NA_NOTE_LABEL = "The AI called this row N/A and still wrote:";
      // A verdict with no evidence is a bare accusation, and both panels' notes
      // tell the reader to read the evidence line before acting on a chip. Say
      // that it is missing rather than rendering nothing, so a red row without a
      // stated basis is visibly a red row without a stated basis. This lived
      // inside renderDeliverables, so the planned-outputs panel held the line
      // and the 23-row checklist next to it did not: a "Missing" verdict whose
      // evidence came back "" exported as a red label and a bare instruction,
      // with no statement of what the tool had found. The two adjacent fields
      // should not have two standards, and neither should the two panels.
      const evidenceText = (s) => (String(s == null ? "" : s).trim() ||
        "The AI returned this verdict with no evidence, so nothing on this row is supported beyond the label itself.");
      // Written out three times in the first version of this change — screen,
      // Markdown, Word — and the three had already drifted by the time it was
      // reviewed: the screen said "not one of the 7 standard outputs" and both
      // exports said "not one of the standard outputs", for the same row in the
      // same run. Exactly the drift this change was fixing elsewhere.
      // The twin of delivExtraLabel, and for the same reason: a volunteered row
      // says on the row that it is not one of the seven, while a row the tool
      // GUESSED onto the list said so only in a caveat two cards above — on the
      // far side of the design-scheme panel on screen, and pages earlier in the
      // Word file. A guess disclosed that far from the number it qualifies is
      // the defect this run had just fixed for the tally.
      const delivGuessLabel = (raw) => " (matched to this row by this tool — the AI wrote “" + raw + "”)";
      const delivExtraLabel = " (volunteered by the AI — not one of the " + DELIVERABLE_NAMES.length + " standard outputs)";

      // Names come back re-typeset: "Kaplan–Meier" with an en dash where the
      // worker asked for "Kaplan-Meier", stray spacing, different case. Matching
      // on raw lowercase equality made one such character both erase a verdict
      // the model HAD given ("The AI returned no verdict for this planned
      // output") and, in the same run, announce the same row again at the bottom
      // as something the AI had "volunteered … not on the list it was asked
      // about". reconcile() thirty lines up already normalises ids and already
      // handles duplicates; this is the same job and now uses the same rules.
      // Three reviewers have now cleared this function and the third found the
      // gap the first two could not see. Both earlier passes drove a dash
      // replacing a DASH ("Kaplan–Meier"), which the class below has always
      // folded; neither drove a dash replacing the SLASH, a dropped
      // parenthetical, or a plural — and each of those still cost a verdict.
      // If you test this, test the separator and the shape of the name, not the
      // characters inside one word.
      const normName = (s) => String(s == null ? "" : s).normalize("NFKC").toLowerCase()
        // Invisible by construction: ZWSP/ZWNJ/ZWJ, the word joiner, a BOM
        // pasted mid-string, and the soft hyphen. Two names that differ only by
        // these are the same name to every reader of both.
        .replace(/[\u200B-\u200D\u2060\uFEFF\u00AD]/g, "")
        .replace(/[‐-―−]/g, "-")   // ‐‑‒–—― and − → -
        .replace(/[‘’]/g, "'").replace(/[“”]/g, '"')
        .replace(/^[.:;\s]+|[.:;\s]+$/g, "")
        // Space, hyphen and slash are ONE separator here. The model picks
        // whichever its own typesetting prefers — "Love plot - covariate
        // balance" for "Love plot / covariate balance", "Forest-plot" for
        // "Forest plot", "Sensitivity analysis outputs" for
        // "Sensitivity-analysis outputs" — and every one of those used to cost
        // the row its verdict twice over. Collapsing them collides no pair of
        // the seven; there is a runtime check below that says so out loud if a
        // future name ever changes that.
        .replace(/[\s/\-]+/g, "-").replace(/^-+|-+$/g, "");
      // A second, deliberately LOSSY key, tried only where the strict one found
      // nothing: a trailing parenthetical and a plural on the last word both go.
      // "Primary results table" and "Forest plots" are what a model writes when
      // it paraphrases the list instead of copying it, and under the strict rule
      // each of them did BOTH halves of the damage this matcher exists to
      // prevent — emptied its own row to "The AI returned no verdict for this
      // planned output", and reappeared at the bottom as something the AI had
      // "volunteered … not on the list it was asked about", with a caveat
      // counting the tool's own miss against the model. Worse, "Primary results
      // table" without "(shell)" walks straight past DELIV_NEVER_NA: the row the
      // rule bars from "na" keeps its "na", as a volunteered extra, under a note
      // three paragraphs above saying that row can never be N/A.
      // This key is a GUESS, which the strict key is not, so every row it
      // matches is named in a caveat and an exact match always wins.
      const looseName = (s) => normName(s).replace(/-?\([^()]*\)$/, "").replace(/s$/, "");

      function renderDeliverables(list, caveats) {
        // Reconcile against the list the worker actually asked about, so an entry
        // the model dropped or renamed shows as "not assessed" rather than
        // vanishing from a panel that looks complete.
        const canonBy = new Map(DELIVERABLE_NAMES.map((n) => [normName(n), n]));
        // Built once from the same list, so it cannot drift from it. A loose key
        // shared by two of the seven would be a guess between them, so it is
        // stored as null and matches nothing rather than picking one.
        const looseBy = new Map();
        for (const n of DELIVERABLE_NAMES) {
          const k = looseName(n);
          looseBy.set(k, looseBy.has(k) ? null : n);
        }
        // normName's comment claims the seven names stay distinct once space,
        // hyphen and slash are folded together. Checked, not asserted: a future
        // rename that broke it would silently merge two rows into one, and the
        // panel would look complete while a whole planned output had no row of
        // its own. The loose key needs no such check — it already stores null
        // for a shared key and declines to guess between them.
        const strictKeys = DELIVERABLE_NAMES.map(normName);
        const collided = [...new Set(strictKeys)]
          .map((k) => DELIVERABLE_NAMES.filter((n, i) => strictKeys[i] === k))
          .filter((g) => g.length > 1).map((g) => g.join(" and "));
        // Groups, not "the later member of each pair", and no hardcoded count:
        // a defect report that misdescribes the defect is worse than none, and
        // the first version named only the row that did NOT keep the verdict
        // while saying "two rows" of a three-way collision.
        if (collided.length && caveats) caveats.push("PROTOCOL-CHECKER DEFECT: " + collided.join("; ") +
          " no longer normalise to keys of their own, so each of those groups shares a single verdict and the " +
          "rest of the group has no row. The panel below is wrong until this is fixed — report it rather than reading it.");
        const byName = new Map();
        const extras = [], dupes = [], nameless = [], loose = [], pending = [];
        for (const d of (Array.isArray(list) ? list : [])) {
          // An entry with nothing to identify it used to be skipped by
          // `if (!d || !d.name) continue`, which discarded a verdict, its
          // evidence and its suggestion without a word — while the row it was
          // about went on saying the AI had returned nothing, and the caveat
          // counted it as a check that never answered. `reconcile` a hundred
          // lines below meets the same shape on the checklist side and REPORTS
          // it ("verdict(s) for item id(s) that are not in the checklist … They
          // were ignored"). Two panels, one standard: the entry is still not
          // rendered, because nothing says which output it is about and this
          // file does not guess, but it is reproduced in a caveat so it is
          // visibly ignored rather than invisibly lost. A non-string name is
          // caught here too: `{"name":{…}}` used to reach the panel as a
          // volunteered output titled "[object Object]".
          if (!d || typeof d !== "object" || Array.isArray(d) ||
              typeof d.name !== "string" || !normName(d.name)) { nameless.push(d); continue; }
          const canon = canonBy.get(normName(d.name));
          if (!canon) { pending.push(d); continue; }
          // First verdict wins, the rest are named — never rendered twice with
          // opposite statuses, which is what "Forest plot: Absent / Present"
          // four rows apart looked like.
          if (byName.has(canon)) dupes.push(canon); else byName.set(canon, d);
        }
        // Strict matching finishes for EVERY entry before the lossy key is
        // tried, so an exact name can never be displaced by a paraphrase that
        // happened to come earlier in the array.
        // The collision branch is the one where a guess can destroy data, so it
        // is the one that must not guess. The first version of this loop sent a
        // loose match onto an already-taken row to `dupes` and dropped the
        // entry: "Baseline characteristics table (Table 2)" — a genuine second
        // shell for the weighted sample, which before any of this was rendered
        // and labelled as volunteered — vanished from all three surfaces under
        // a caveat reading "The AI returned more than one verdict for planned
        // output(s) Baseline characteristics table (Table 1); only the first
        // was used." The AI had returned no such thing. An exact name has
        // already claimed that row, so a paraphrase landing on it is at least
        // as likely to be a different output as the same one, and the tool
        // cannot tell which: it keeps the row, says what it nearly did, and
        // leaves the entry visible rather than merging or dropping it.
        const looseTaken = [], looseRaw = new Map();
        for (const d of pending) {
          const canon = looseBy.get(looseName(d.name));
          if (!canon) { extras.push(d); continue; }
          if (byName.has(canon)) { looseTaken.push("“" + d.name + "” (" + canon + ")"); extras.push(d); continue; }
          byName.set(canon, d);
          looseRaw.set(canon, d.name);
          loose.push("“" + d.name + "” → " + canon);
        }
        // Volunteered rows were compared with the seven and never with each
        // other, so the same name twice with opposite verdicts printed twice,
        // four rows apart, under a caveat that listed the name twice and said
        // nothing about a disagreement — the exact shape `dupes` exists to
        // prevent, on the only rows where the tool has no canonical entry to
        // anchor to.
        const seenExtra = new Set(), dupeExtras = [], keptExtras = [];
        for (const d of extras) {
          const k = normName(d.name);
          if (seenExtra.has(k)) { dupeExtras.push(d.name); continue; }
          seenExtra.add(k); keptExtras.push(d);
        }
        if (dupes.length && caveats) caveats.push("The AI returned more than one verdict for planned output(s) " +
          [...new Set(dupes)].join(", ") + "; only the first was used.");
        if (dupeExtras.length && caveats) caveats.push("The AI returned more than one verdict for volunteered planned output(s) " +
          [...new Set(dupeExtras)].join(", ") + "; only the first was used.");
        if (looseTaken.length && caveats) caveats.push("The AI named " + looseTaken.length +
          " planned output(s) that this tool would have matched to a standard row by ignoring a bracketed suffix or a plural, " +
          "except that the row already held a verdict from an exactly-named entry (" + looseTaken.join("; ") +
          " — the row it would have gone to is in brackets). Merging them would have thrown one verdict away on a guess, so " +
          (looseTaken.length === 1 ? "it is shown last as a volunteered output" : "they are shown last as volunteered outputs") + " instead. If " +
          (looseTaken.length === 1 ? "it names" : "they name") + " the same output as the row in brackets, the two verdicts disagree and both are worth reading.");
        if (loose.length && caveats) caveats.push("The AI named " + loose.length + " planned output(s) differently from the list it was asked about, and this tool matched " +
          (loose.length === 1 ? "it" : "them") + " to a standard row by ignoring a bracketed suffix or a plural (" + loose.join("; ") +
          "). That match is this tool's guess, not the AI's statement — read the evidence and confirm the AI was judging the row it has been filed under.");
        // Two sentences, not one. The first version said of every unusable
        // entry that "nothing in them says which planned output they are about"
        // — and then quoted, inside its own parentheses, a bare string reading
        // "Forest plot", which says exactly that. A bare value is a name with
        // no verdict; an object with no name is a verdict with no name. They
        // are opposite failures and one sentence cannot be true of both.
        const unnamedRows = nameless.filter((d) => d && typeof d === "object" && !Array.isArray(d));
        const notEntries = nameless.filter((d) => !(d && typeof d === "object" && !Array.isArray(d)));
        if (unnamedRows.length && caveats) caveats.push("The AI returned " + unnamedRows.length +
          " planned-output verdict(s) carrying no usable name (" +
          unnamedRows.map((d) => {
            const st = String(d.status == null ? "no status" : d.status).trim() || "no status";
            const evd = String(d.evidence == null ? "" : d.evidence).trim();
            const sug = String(d.suggestion == null ? "" : d.suggestion).trim();
            // The suggestion is the one actionable sentence in the entry, and
            // the first version of this caveat promised nothing was dropped
            // while dropping it.
            return "“" + st + "”" + (evd ? ": " + evd : "") + (sug && sug !== "—" && sug !== "–" && sug !== "-" ? " — suggested: " + sug : "");
          }).join("; ") +
          "). Nothing in " + (unnamedRows.length === 1 ? "it says which planned output it is" : "them says which planned outputs they are") +
          " about, so " + (unnamedRows.length === 1 ? "it is" : "they are") + " on no row above — " +
          (unnamedRows.length === 1 ? "it is" : "they are") + " reproduced here rather than dropped.");
        if (notEntries.length && caveats) caveats.push("The AI returned " + notEntries.length +
          " item(s) in the planned-outputs list that are not verdicts at all (" +
          notEntries.map((d) => "“" + String(d) + "”").join("; ") +
          "). " + (notEntries.length === 1 ? "It carries" : "They carry") + " no status and no evidence this tool can read, so " +
          (notEntries.length === 1 ? "it is" : "they are") + " on no row above; " +
          (notEntries.length === 1 ? "it is" : "they are") + " reproduced here rather than dropped.");
        const ev = evidenceText;
        const readStatus = (d) => DELIV_ALIASES[String(d.status == null ? "" : d.status).trim().toLowerCase()];
        // One sentence for a status the aliases do not recognise, used by the
        // canonical rows AND by the volunteered ones. Fixing only the canonical
        // side left an extra reading "Not assessed" — defined eight lines above
        // as "the AI returned nothing usable" — directly above a full evidence
        // sentence the AI had in fact returned.
        const unrec = (d) => "The AI returned an unrecognised verdict (" +
          (d.status == null ? "no status field at all" : "“" + String(d.status) + "”") +
          ") for this planned output, so nothing is claimed about it." +
          (String(d.evidence == null ? "" : d.evidence).trim() ? " It said: " + d.evidence : "");
        const naBarred = [], unrecExtras = [];
        const canonRows = DELIVERABLE_NAMES.map((name) => {
          const d = byName.get(name);
          if (!d) return { name, status: "unassessed", evidence: "The AI returned no verdict for this planned output, so nothing is claimed about it." };
          let st = readStatus(d);
          // Keep what the model said. Discarding it told the researcher the
          // check had failed when it had in fact answered — and `reconcile`
          // twenty lines down already keeps the evidence in the identical
          // case ("The AI could not tell (“…”): …").
          if (!st) return { name, status: "unassessed", evidence: unrec(d) };
          let evidence = ev(d.evidence);
          if (st === "na" && DELIV_NEVER_NA.indexOf(name) !== -1) {
            naBarred.push(name);
            st = "absent";
            // Quote the model, or say plainly that there is nothing to quote —
            // never the value of `evidence` above, which has already been
            // through evidenceText and is this tool's OWN substitute sentence
            // whenever the model sent none. Concatenating that after "it said:"
            // printed, in a Word file a reader takes to a supervisor: "the AI's
            // own words are kept here so you can judge them — it said: The AI
            // returned this verdict with no evidence, so nothing on this row is
            // supported beyond the label itself." Three falsehoods in one line:
            // no words were kept, ours were attributed to the model, and the
            // model was made to narrate its own silence. `unrec` two lines above
            // already reads the raw field for exactly this reason.
            const said = String(d.evidence == null ? "" : d.evidence).trim();
            // "identifying assumptions" is a causal-inference term, and this
            // site generates protocols that estimate no contrast: the
            // descriptive builder prints "No causal contrast is estimated and
            // none should be read into these numbers" and "There is no effect
            // size to detect". Checking one of those here produced a red row
            // whose stated basis their own limitations paragraph refutes. The
            // RULE survives — a descriptive study still has a primary estimate
            // (its rates and proportions with confidence intervals) and still
            // has assumptions worth probing — but the reason had to stop
            // asserting a causal contrast that may not exist.
            evidence = "The AI called this not applicable, which it cannot be: every design has a " +
              "primary estimate, and every design has assumptions worth probing — identifying " +
              "assumptions where a contrast is estimated, and measurement assumptions (outcome and " +
              "denominator misclassification) where none is. " +
              "Recorded as absent instead" +
              (said ? ", and the AI's own words are kept here so you can judge them — it said: " + said
                    : ". The AI gave no evidence for the verdict this tool has overridden, so there is nothing of its own to judge here.");
          }
          return { name, status: st, evidence, suggestion: d.suggestion, guessed: looseRaw.get(name) };
        });
        // Tagged, so every surface can say what they are. Untagged, they were
        // counted in a tally that claims to summarise the seven standard rows
        // and were merged flat into both exports, where a volunteered row reads
        // as part of the checklist this tool says it applies.
        const extraRows = keptExtras.map((d) => {
          const st = readStatus(d);
          if (!st) unrecExtras.push(d.name);
          return { name: d.name, extra: true, status: st || "unassessed",
            evidence: st ? ev(d.evidence) : unrec(d), suggestion: d.suggestion };
        });
        const rows = canonRows.concat(extraRows);

        if (!rows.length) { delivEl.classList.add("hidden"); return; }
        // Over the seven, NOT over `rows`: with extras included this counted
        // volunteered rows against a denominator of seven and printed "2 of the
        // 7 planned-output checks came back without a usable verdict" on a run
        // where all seven had answered — and "8 of the 7" when the model
        // volunteered enough of them.
        const nUn = canonRows.filter((r) => r.status === "unassessed").length;
        if (nUn && caveats) caveats.push(nUn + " of the " + DELIVERABLE_NAMES.length + " planned-output checks came back without a usable verdict and are marked “Not assessed”.");
        // Named, not merely coloured. "na" is the one verdict on this panel that
        // cannot be checked against the document — it is a claim about the
        // reader's design — so the rows carrying it are listed where the reader
        // is already looking for things to distrust. Computed BEFORE the
        // demotion caveat below, which used to send the reader to "the other
        // N/A verdicts in this run" on every run that demoted one — including
        // the commonest shape of all, where the demoted row was the only N/A
        // there was and the other set is empty.
        const naRows = canonRows.filter((r) => r.status === "na").map((r) => r.name);
        if (naBarred.length && caveats) caveats.push("The AI marked " + naBarred.join(" and ") +
          " “not applicable”. " + (naBarred.length === 1 ? "That row cannot be" : "Neither row can be") +
          ": every design has a primary estimate, and assumptions worth probing. " +
          (naBarred.length === 1 ? "It is" : "They are") + " shown as Absent instead — that verdict is this tool's, not the AI's." +
          (naRows.length ? (naBarred.length === 1 ? " Treat it" : " Treat them") + " as a sign the other N/A verdicts in this run are worth checking too." : ""));
        if (naRows.length && caveats) caveats.push("The AI judged " + naRows.length + " planned output(s) not applicable to this design (" +
          naRows.join(", ") + "). That is a claim about your design rather than about your document, and nothing in this tool can check it — read the evidence for each and confirm the estimator really has no equivalent to produce.");
        if (unrecExtras.length && caveats) caveats.push("The AI volunteered planned output(s) with a verdict this tool does not recognise (" +
          unrecExtras.join(", ") + "); they are marked “Not assessed” and its own words are kept beneath each.");
        if (keptExtras.length && caveats) caveats.push("The AI volunteered " + keptExtras.length + " planned output(s) that were not on the list it was asked about (" + keptExtras.map((e) => e.name).join(", ") + "). They are shown last, labelled, and left out of the tally — they are not part of the standard set.");

        const counts = {};
        delivListEl.innerHTML = rows.map((d) => {
          const m = DELIV_META[d.status] || DELIV_META.unassessed;
          if (!d.extra) counts[d.status] = (counts[d.status] || 0) + 1;
          return '<li class="border-l-2 pl-4 ' + m.border + '">' +
            '<div class="flex items-start justify-between gap-3">' +
              '<p class="text-sm font-semibold text-slate-900">' + escapeHtml(d.name) +
                (d.extra ? ' <span class="font-normal text-slate-400">' + escapeHtml(delivExtraLabel.trim()) + '</span>' : '') +
                (d.guessed ? ' <span class="font-normal text-amber-700">' + escapeHtml(delivGuessLabel(d.guessed).trim()) + '</span>' : '') + '</p>' +
              '<span class="shrink-0 inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-xs font-semibold ' + m.chip + '"><span class="inline-block w-1.5 h-1.5 rounded-full ' + m.dot + '"></span>' + m.label + '</span>' +
            '</div>' +
            (d.evidence ? '<p class="mt-1 text-xs text-slate-600 leading-relaxed"><span class="font-semibold text-slate-500">Evidence:</span> ' + escapeHtml(d.evidence) + '</p>' : '') +
            (showSuggestion(d) ? '<p class="mt-1 text-xs text-slate-600 leading-relaxed"><span class="font-semibold text-brand-700">Suggestion:</span> ' + escapeHtml(suggestionText(d)) + '</p>' : '') +
            (showNaNote(d) ? '<p class="mt-1 text-xs text-slate-500 leading-relaxed"><span class="font-semibold text-slate-400">' + NA_NOTE_LABEL + '</span> ' + escapeHtml(suggestionText(d)) + '</p>' : '') +
          '</li>';
        }).join("");
        // Derived from DELIV_META rather than hand-listed, the way ALL_STATUSES
        // is on the framework side: the hand-written copy had to be edited to
        // add "na" and a chip missing from it is a chip that silently never
        // prints, leaving a tally that disagrees with the rows above it.
        // What the chips count, beside the chips. Volunteered rows are correctly
        // left out of them, and the only statement of that fact lived in
        // `#caveats` — two cards above, on the other side of the design-scheme
        // panel. Nine volunteered "Present" rows under a bare "7 Not assessed"
        // is a tally that reads as a contradiction of the list it heads, and a
        // reader scanning the panel has no reason to go looking two cards away
        // for the sentence that reconciles them.
        delivTallyEl.innerHTML = '<span class="self-center font-normal text-slate-400">Over the ' +
          DELIVERABLE_NAMES.length + ' standard outputs' +
          (extraRows.length ? ", not the " + extraRows.length + " volunteered below" : "") + ":</span>" +
          Object.keys(DELIV_META).map((k) => {
          const m = DELIV_META[k];
          return counts[k] ? '<span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 ' + m.chip + '"><span class="inline-block w-2 h-2 rounded-full ' + m.dot + '"></span>' + counts[k] + ' ' + m.label + '</span>' : "";
        }).join("");
        delivEl.classList.remove("hidden");
        return rows;
      }

      // Which rows are headings for other rows. Derived from the ids themselves,
      // so it cannot drift from the checklist: a child extends its parent's id
      // with a letter (7 → 7a) or a further dotted level — never with another
      // digit, or HARPER item 1 would adopt item 10.
      function parentRows(fw) {
        const ids = [];
        for (const sec of fw.checklist) for (const it of sec.items) ids.push(it.id);
        const out = [];
        for (const p of ids) {
          const kids = ids.filter((c) => c !== p && c.indexOf(p) === 0 && /^[a-z.]/i.test(c.slice(p.length)));
          if (kids.length) out.push([p, kids]);
        }
        return out;
      }

      // Match the model's verdicts back onto the checklist. Anything that does
      // not match is reported, never dropped and never guessed at.
      function reconcile(fw, rawItems) {
        const byId = new Map();
        const unmatched = [], badStatus = [], duplicates = [], undecided = [];
        const known = new Map();
        for (const sec of fw.checklist) for (const it of sec.items) known.set(normId(it.id), it.id);
        for (const v of (Array.isArray(rawItems) ? rawItems : [])) {
          const id = known.get(normId(v && v.id));
          if (!id) { unmatched.push(String((v && v.id) != null ? v.id : "(no id)")); continue; }
          if (byId.has(id)) { duplicates.push(id); continue; }
          const st = normStatus(v.status);
          if (!st) { badStatus.push(id + " → “" + String(v.status) + "”"); byId.set(id, { status: "unassessed", evidence: "The AI returned an unrecognised verdict (“" + String(v.status) + "”), so nothing is claimed about this item.", suggestion: "" }); continue; }
          if (st === "unassessed") {
            undecided.push(id);
            byId.set(id, { status: "unassessed", suggestion: "",
              evidence: v.evidence ? "The AI could not tell (“" + String(v.status) + "”): " + v.evidence : "The AI reported that it could not tell whether this item is addressed (“" + String(v.status) + "”)." });
            continue;
          }
          // Held to the same standard as the planned-outputs rows: a verdict the
          // model returned with an empty or whitespace-only `evidence` says so,
          // once, here — the single point every one of the three surfaces reads
          // from — rather than each of them rendering a red label with nothing
          // under it. `evidence` is `required` in the worker's schema, so a
          // blank one is the model filling a field it had nothing for.
          byId.set(id, { status: st, evidence: evidenceText(v.evidence), suggestion: v.suggestion });
        }
        // A heading row is the conjunction of the rows beneath it: TARGET item 7
        // is "Describe how each target-trial component is emulated (elements a-h
        // below)". Scoring it as a PEER of 7a-7h counts the same content nine
        // times — nine of TARGET's 31 rows for one published item — and lets the
        // card render "7 … Missing" directly above eight consecutive "Met"
        // chips. The model usually omits the parent (see the note on
        // STATUS_META.unassessed), which by luck produces the right denominator;
        // when it does answer, the score silently inflates. Do deliberately what
        // that lucky branch does by accident, but only where the sub-rows were
        // actually judged — a parent answered alone is the only verdict there is.
        const doubled = [];
        for (const [pid, kids] of parentRows(fw)) {
          const p = byId.get(pid);
          if (!p || p.status === "unassessed") continue;
          const judged = kids.filter((k) => byId.has(k) && byId.get(k).status !== "unassessed");
          // ALL of them, not merely one. With a partial set the heading is the
          // only verdict covering the sub-items the model skipped, so dropping
          // it would discard information rather than deduplicate it — and the
          // sentence below ("the sub-items carry the verdict") would be false
          // of the seven rows that carry nothing.
          if (judged.length !== kids.length) continue;
          doubled.push(pid);
          const span = kids.length === 1 ? kids[0] : kids[0] + "–" + kids[kids.length - 1];
          byId.set(pid, { status: "notscored", suggestion: "",
            evidence: "This item is the heading for " + span + ", and all " + kids.length +
              " of them were judged separately below. Scoring it as well would count the same content twice, so it is left out of the score and " + span +
              " carry the verdict. The AI's own answer for it was “" + String(p.status) + "”." });
        }

        const omitted = [];
        for (const sec of fw.checklist) for (const it of sec.items) {
          if (!byId.has(it.id)) {
            omitted.push(it.id);
            byId.set(it.id, { status: "unassessed", evidence: "The AI returned no verdict for this item. That is a gap in this check, not a finding about your protocol — read the item and judge it yourself.", suggestion: "" });
          }
        }
        return { byId, unmatched, badStatus, duplicates, omitted, undecided, doubled };
      }

      function showRunError(msg) {
        runErrMsg.textContent = msg;
        runErrEl.classList.remove("hidden");
        resultsEl.classList.add("hidden");
        runErrEl.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      function render(data, requestedFramework, stamp) {
        const caveats = [];
        if (!data || !Array.isArray(data.items) || !data.items.length) {
          showRunError("The AI returned an answer with no item verdicts in it, so there is nothing to score. Please try again — and if it keeps happening, the model is probably struggling with this document's length or formatting.");
          return;
        }
        if (data.framework && requestedFramework && data.framework !== requestedFramework) {
          showRunError("The service answered for the " + (fwOf(data.framework).name) + " checklist but " + (fwOf(requestedFramework).name) + " was requested. Nothing is shown rather than scoring your protocol against the wrong framework.");
          return;
        }
        const fw = fwOf(data.framework || requestedFramework);
        const { byId, unmatched, badStatus, duplicates, omitted, undecided, doubled } = reconcile(fw, data.items);
        const counts = { met: 0, partial: 0, missing: 0, na: 0, unassessed: 0, notscored: 0 };
        // Which rows the model took out of the denominator, so the caveat below
        // can name them. Every other status that leaves the score is already
        // named by id in a caveat — omitted, unrecognised, undecided, doubled.
        // N/A was the one that left it as a bare count.
        const naItems = [];

        itemsEl.innerHTML = "";
        for (const sec of fw.checklist) {
          const block = document.createElement("section");
          block.className = "rounded-2xl border border-slate-200 bg-white p-6 shadow-sm";
          block.innerHTML = '<h3 class="text-sm font-extrabold uppercase tracking-widest text-brand-700 mb-4">' + escapeHtml(sec.section) + '</h3>';
          const ol = document.createElement("ol");
          ol.className = "space-y-4";
          for (const it of sec.items) {
            const v = byId.get(it.id);
            const st = STATUS_META[v.status];
            counts[v.status] += 1;
            if (v.status === "na") naItems.push(it.id);
            const li = document.createElement("li");
            li.className = "border-l-2 pl-4 " + st.edge;
            li.innerHTML =
              '<div class="flex items-start justify-between gap-3">' +
                '<p class="text-sm font-semibold text-slate-900"><span class="text-brand-700">' + escapeHtml(it.id) + '.</span> ' + escapeHtml(it.label) + '</p>' +
                '<span class="shrink-0 inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-xs font-semibold ' + st.chip + '"><span class="inline-block w-1.5 h-1.5 rounded-full ' + st.dot + '"></span>' + st.label + '</span>' +
              '</div>' +
              // The hint says what "met" actually looks like. Shown only where it
              // is useful — on an item the author still has work to do on.
              (it.hint && v.status !== "met" ? '<p class="mt-1 text-xs text-slate-500 leading-relaxed"><span class="font-semibold text-slate-400">What this asks for:</span> ' + escapeHtml(it.hint) + '</p>' : '') +
              (v.evidence ? '<p class="mt-1 text-xs text-slate-600 leading-relaxed"><span class="font-semibold text-slate-500">Evidence:</span> ' + escapeHtml(v.evidence) + '</p>' : '') +
              (showSuggestion(v) ? '<p class="mt-1 text-xs text-slate-600 leading-relaxed"><span class="font-semibold text-brand-700">Suggestion:</span> ' + escapeHtml(suggestionText(v)) + '</p>' : '') +
              (showNaNote(v) ? '<p class="mt-1 text-xs text-slate-500 leading-relaxed"><span class="font-semibold text-slate-400">' + NA_NOTE_LABEL + '</span> ' + escapeHtml(suggestionText(v)) + '</p>' : '');
            ol.appendChild(li);
          }
          block.appendChild(ol);
          itemsEl.appendChild(block);
        }

        // Every bucket, so `total` stays the checklist's own size.
        const total = ALL_STATUSES.reduce((a, k) => a + counts[k], 0);
        const assessable = counts.met + counts.partial + counts.missing;
        confHead.textContent = fw.name + " conformance";
        // The denominator is not the checklist — N/A and Not assessed are taken
        // out of it — so it moves with what the model chose to answer. A run
        // where the model marked everything "na" reads "12 of 12 met" for a
        // protocol another run scored 12 of 23. Name the checklist's own size
        // whenever the denominator is smaller than it, so the shrinkage is on
        // screen next to the ratio it produced.
        // "A and B and C" — a two-part join left over from when only two of
        // these clauses could exist. There are three now.
        const listJoin = (xs) => (xs.length < 3 ? xs.join(" and ") : xs.slice(0, -1).join(", ") + " and " + xs[xs.length - 1]);
        const dropParts = [];
        if (counts.na) dropParts.push(counts.na + (counts.na === 1 ? " was" : " were") + " judged not applicable");
        if (counts.unassessed) dropParts.push(counts.unassessed + (counts.unassessed === 1 ? " was" : " were") + " not assessed");
        if (counts.notscored) dropParts.push(counts.notscored + (counts.notscored === 1 ? " is a heading whose" : " are headings whose") + " sub-items are scored separately");
        // "Of this checklist's 31 TARGET items" asserted that a 21-item published
        // guideline has 31 items. The rows are this tool's, so say so.
        summaryEl.textContent = counts.met + " of " + assessable + " assessable items met." +
          (dropParts.length ? " Of the " + total + " rows this tool scores for " + fw.name + ", " + listJoin(dropParts) +
            " — excluded from that count, so it is out of " + assessable + " and not out of " + total + "." : "");
        $("rowsnote").textContent = fw.rowsNote || "";
        // The model's own words, quoted and attributed, never merged into the
        // sentence above: it is free text, nothing validates it, and it commonly
        // states a total of its own that contradicts the computed one.
        aiSummaryEl.innerHTML = data.summary
          ? '<span class="font-semibold text-slate-500">The AI\'s own summary, quoted unchecked — any count or claim in it is the model\'s, not this tool\'s:</span> “' + escapeHtml(data.summary) + "”"
          : "";
        aiSummaryEl.classList.toggle("hidden", !data.summary);
        barEl.innerHTML = ALL_STATUSES.map((k) =>
          counts[k] ? '<div class="' + STATUS_META[k].bar + '" style="width:' + (counts[k] / (total || 1) * 100).toFixed(2) + '%"></div>' : "").join("");
        tallyEl.innerHTML = ALL_STATUSES.map((k) => counts[k] ? chip(k, counts[k]) : "").join("");
        citeEl.textContent = fw.name + ": " + fw.citation;

        // ── Everything this run could not do, said out loud ──
        if (data.truncated) {
          caveats.push("The document was longer than the " + MAX_CHARS.toLocaleString() + "-character limit and was cut off before analysis. Sections after that point were not read, and items answered only there will read as missing.");
        }
        if (omitted.length) caveats.push("The AI returned no verdict for " + omitted.length + " item(s) (" + omitted.join(", ") + "). They are marked “Not assessed” and excluded from the score — judge them yourself.");
        if (badStatus.length) caveats.push("The AI returned an unrecognised verdict for " + badStatus.length + " item(s) (" + badStatus.join("; ") + "). They are marked “Not assessed”.");
        if (doubled.length) caveats.push("The AI returned a verdict for " +
          (doubled.length === 1 ? "item " + doubled[0] + ", which is a heading for sub-items" : "items " + doubled.join(", ") + ", which are headings for sub-items") +
          " that were all judged separately below. Counting a heading alongside its own sub-items would score the same content twice, so " +
          (doubled.length === 1 ? "it was" : "they were") + " marked “Not scored” and left out of the score; the sub-items carry the verdict.");
        if (undecided.length) caveats.push("The AI answered that it could not tell for " + undecided.length + " item(s) (" + undecided.join(", ") + "). That is a statement about this check, not a finding about your protocol, so those items are marked “Not assessed” and excluded from the score — read the item and judge it yourself.");
        // N/A was the only status that could leave the score without saying
        // which rows left it. The four caveats above all name ids; the sentence
        // beside the score says how many rows went and what the denominator
        // became, but never which ones — so a reader could see "12 of 12
        // assessable items met" with eleven rows silently removed and have no
        // way to check the removals. This is also the ONE verdict here whose
        // basis the tool cannot inspect: "missing" is a claim about the text,
        // and the text is on the reader's screen; "not applicable" is a claim
        // about what kind of document it is. The planned-outputs panel next
        // door already carries this caveat, and there N/A cannot move a number
        // at all — the panel where the verdict is harmless was the one that
        // disclosed it.
        // It says what N/A removed, and NOT what the denominator became. The
        // first version said "it is out of 12 rather than out of 23", which is
        // true only when N/A is the sole reason rows left the score — the state
        // it was tested in. Ordinarily rows also leave as Not assessed (the
        // model skipping items is the commonest shape there is) and, on TARGET,
        // as Not scored, so the sentence credited two N/A verdicts with a
        // collapse from 23 to 1 that twenty omitted rows had done — directly
        // below the bullet that names those twenty. The summary line beside the
        // score already enumerates every reason and is the one place the full
        // arithmetic belongs; a second, simpler account of it is a second
        // answer.
        if (naItems.length) caveats.push("The AI judged " + naItems.length + " checklist item(s) not applicable to this document (" + naItems.join(", ") +
          "), taking " + (naItems.length === 1 ? "it" : "them") + " out of the score's denominator — the sentence beside the score gives what the denominator became, and every reason rows left it. " +
          "“Not applicable” is a claim about what kind of document yours is rather than about what it says, and nothing in this tool can check it. " +
          (assessable
            ? "Read the evidence on each: an item wrongly called not applicable raises the score instead of lowering it."
            : "Nothing is left in the denominator at all, so there is no ratio here to read — go by the verdicts themselves."));
        if (unmatched.length) caveats.push("The AI returned " + unmatched.length + " verdict(s) for item id(s) that are not in the " + fw.name + " checklist (" + unmatched.slice(0, 8).join(", ") + (unmatched.length > 8 ? ", …" : "") + "). They were ignored.");
        if (duplicates.length) caveats.push("The AI returned more than one verdict for item(s) " + [...new Set(duplicates)].join(", ") + "; only the first was used.");
        // From the run record, never the live global: see stampSource.
        for (const n of (stamp ? stamp.notes : loadedNotes)) caveats.push(n);
        if (fw.kind === "reporting guideline") {
          caveats.push(fw.name + " is a reporting guideline for a completed study. If you are checking a protocol, the results and discussion items describe what you will have to report later — a verdict of “met” there means the protocol says it plans to, not that it has been done.");
        }

        const scheme = renderScheme(data.design, caveats);
        const delivRows = renderDeliverables(data.deliverables, caveats);

        caveatsEl.innerHTML = caveats.map((c) => '<li class="flex gap-1.5"><span class="shrink-0">⚠</span><span>' + escapeHtml(c) + "</span></li>").join("");

        // Offer TARGET when a HARPER run detects a target-trial emulation
        const tte = data.targetTrialEmulation;
        if (fw.key === "harper" && tte && tte.likely) {
          tteReason.textContent = tte.reason || "";
          tteEl.classList.remove("hidden");
        } else {
          tteEl.classList.add("hidden");
        }

        // `source` records what this report is a report ON — the exact text, the
        // file it came from, and the framework it was scored against — so the
        // page can tell the reader when the input has moved on, and so both
        // exports can name the document instead of being one of several
        // identically-titled files dated today.
        lastReport = { data, counts, fw, byId, caveats, delivRows, scheme, source: stamp || stampSource(fw.key, getInputText()) };
        refreshStaleness();
        // A failed Word download's red message used to outlive its report: it
        // was hidden only on the next click of the button that raised it, so a
        // brand-new run on a different protocol rendered underneath a stale
        // "the Word file could not be built".
        $("dlerr").classList.add("hidden");
        runErrEl.classList.add("hidden");
        resultsEl.classList.remove("hidden");
        resultsEl.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      function chip(status, n) {
        const st = STATUS_META[status];
        return '<span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 ' + st.chip + '"><span class="inline-block w-2 h-2 rounded-full ' + st.dot + '"></span>' + n + ' ' + st.label + '</span>';
      }

      // ── Network (with retry on transient overload) ──
      async function postCheck(text, framework) {
        let lastErr = null;
        // One retry only — every attempt costs a request against the free daily
        // quota (the worker also retries transient errors server-side).
        for (let attempt = 0; attempt < 2; attempt++) {
          if (attempt > 0) { setStatus("The AI model was busy — retrying…"); await new Promise((s) => setTimeout(s, 1500)); }
          let r;
          try { r = await fetch(WORKER_URL, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ text, framework }) }); }
          catch (e) { lastErr = new Error("Network error — check your connection and try again."); continue; }
          const data = await r.json().catch(() => ({}));
          if (r.ok) return data;
          lastErr = new Error(data.error || ("Request failed (" + r.status + ")."));
          if (r.status === 503 || r.status === 502) continue; // transient — retry
          throw lastErr; // 400 / 429 etc. — don't retry
        }
        throw lastErr;
      }

      async function runCheck(framework) {
        const text = getInputText();
        if (text.length < 200) { setStatus("Please upload a protocol, or paste at least a few paragraphs (200+ characters).", true); return; }
        // Never leave the previous run's score on screen while a new one runs or
        // fails — it reads as the answer to the question just asked.
        resultsEl.classList.add("hidden");
        runErrEl.classList.add("hidden");
        // Captured now, from the text this request is built from.
        const stamp = stampSource(framework, text);
        runInFlight = true; syncCheckBtn();
        setStatus("Checking against " + fwOf(framework).name + " — this can take 10–20 seconds…");
        try { const data = await postCheck(text, framework); setStatus(""); render(data, framework, stamp); }
        catch (e) {
          setStatus("", false);
          showRunError((e && e.message ? e.message : "Something went wrong.") +
            " (Checked against " + fwOf(framework).name + ".)");
        }
        // A file read that started during the request still owns the button.
        finally { runInFlight = false; syncCheckBtn(); }
      }

      // Both reports used to name no document at all: two protocols checked on
      // the same day produced two files called "HARPER-report-2026-08-23.docx"
      // whose contents were also indistinguishable. The source is stamped into
      // the file and into its name.
      const fileSlug = (s) => String(s || "").replace(/\.[^.]+$/, "").replace(/[^\w-]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 40);
      const reportStem = (fw, src, date) => fw.name + "-report-" + (fileSlug(src && src.name) || "pasted-text") + "-" + date;
      // What this report is a report on, in one line at the top of both exports.
      // Two things it must not overstate. A .docx or .pdf was not "checked" —
      // a lossy text extraction of it was, which is what `loadedNotes` spends
      // its life enumerating. And the character count is the length of the
      // document, not of what reached the model: the worker cuts at MAX_CHARS,
      // so a 143,220-character protocol would otherwise open its report with a
      // bold line implying all of it was assessed when 58% never left the page.
      const sourceLine = (src) => {
        if (!src) return "Checked: text pasted into the tool.";
        const what = src.name ? "text extracted from " + src.name : "text pasted into the tool";
        const n = src.text.length;
        return "Checked: " + what + " — " + n.toLocaleString() + " characters" +
          (n > MAX_CHARS ? ", of which only the first " + MAX_CHARS.toLocaleString() +
            " were sent to the AI; the rest was not assessed" : "") + ".";
      };

      // ── The AI's words are this report's CONTENT, never its STRUCTURE ──
      //
      // Markdown is line-oriented and this report is built by concatenation, so
      // every model-supplied string lands somewhere a line break stops being
      // text and starts being layout. The other two surfaces are safe by
      // construction and had hidden the problem: the screen puts each string
      // through `escapeHtml` into a single element, where a newline is
      // whitespace, and the Word export gives each string its own TextRun,
      // where the line ending lands inside a single <w:t> and so cannot become
      // a heading, a row or a colour whatever Word decides to do with it. (What
      // Word DOES do with it — space, or nothing at all — is untested: nobody
      // has opened one of these files in Word. It cannot change the structure,
      // which is the property being relied on here.) The Markdown report was
      // the one surface that read the model's answer as source, and what it did
      // with it, verified by parsing the emitted file with a GFM parser rather
      // than by reading the string:
      //
      //   · A blank line inside `summary` ENDS the blockquote it is quoted in.
      //     The rest became an unattributed paragraph in the report's own voice,
      //     stating a rival total ("21 of the 23 HARPER elements are addressed")
      //     eight paragraphs under the tool's computed 16 of 23 — defeating the
      //     one thing the comment beneath this one exists to guarantee. `summary`
      //     is `required` by the worker's schema and is mentioned NOWHERE in its
      //     prompt: no length, no format, no instruction. Multi-paragraph prose
      //     is what an unconstrained summary field returns.
      //   · A line beginning `- ` inside `evidence` became a sibling of the
      //     HARPER items — verdict-less rows in the checklist — and re-parented
      //     the real row's Suggestion under one of them. The model is told to
      //     "quote or closely paraphrase" the protocol, and protocol text is
      //     full of headings and numbered lists, so this needs no ill intent.
      //   · A line beginning `#` became a report heading, a peer of the tool's
      //     own "What this check could not do". A `---` became a rule and threw
      //     what followed into the body. A closing ``` at column 0 OPENED a
      //     fence: eighteen verdicts, two section headings and the framework
      //     citation swallowed into one code block, in a file that still looked
      //     complete.
      //
      // The fix is one line, and the reason it is a collapse rather than an
      // escaper is that the other two surfaces already collapse. Making the
      // Markdown preserve the model's paragraphing would have been a FOURTH
      // behaviour for one report; making it match is a rule the whole file can
      // state: nothing the AI writes can create a row, a heading, a rule, a
      // table or a code block. What it wrote is still all there, on one line,
      // exactly as the screen and the .docx already show it.
      //
      // Every model-derived string in this function goes through it — including
      // ones that reach it inside a tool-written sentence, because a caveat
      // naming an id or a volunteered output name is carrying model text too.
      // Tool strings (`frameText`, `delivNoteText`, the summary line, headings)
      // are left alone: they are ours, they have no newlines, and quoting them
      // through an escaper would be a claim that we do not trust our own file.
      //
      // Deliberately NOT escaped: `*`, `_`, `` ` ``, `[`. Both reviewers drove
      // them and a GFM parser confirms that inline emphasis in a single-line
      // string cannot break out of its container or forge a verdict — the worst
      // it does is render the model's own emphasis as emphasis, or leak a
      // literal `**`. An escaper that backslashes them would put a stray `\` in
      // front of a legitimate en dash or a variable name in every report.
      //
      // What this DOES cost, and it is a real cost: a model that returns a
      // genuine shell table in `suggestion` — pipes, delimiter row and all,
      // which is exactly what "mock up the table" invites — now prints as one
      // line of pipe soup instead of a rendered table. The characters all
      // survive; the layout does not. That is the price of the guarantee above,
      // and it is the same price the screen and the .docx have always charged.
      //
      // `\s+`, not `\r?\n`. The first version of this matched only LF and
      // CRLF, and CommonMark counts a lone CR as a line ending too — so an
      // `evidence` string carrying CR paragraph marks (which is what this
      // tool's own .docx and PDF extraction produces, handed to a prompt that
      // asks the model to quote the text back) still forged an `<h1>`, still
      // opened a code fence, and still walked the AI's summary out of its
      // blockquote, underneath a comment claiming it could not. Collapsing
      // every whitespace run leaves no line ending of any spelling — CR, LF,
      // CRLF, U+2028 — and takes the trailing-two-space hard break with it.
      //
      // U+FEFF is stripped first because JS's `\s` includes it: a zero-width
      // no-break space collapsed to a visible one, so a quoted Japanese
      // sentence exported with a word gap in a script that has none. It is
      // routine debris from .docx and PDF text extraction, which is exactly the
      // text the model is asked to quote back. U+200C and U+200D are NOT
      // stripped — they are meaningful in Arabic and Indic scripts and in emoji
      // sequences, and they are not `\s`, so they pass through untouched.
      const mdText = (s) => String(s == null ? "" : s).replace(/\uFEFF/g, "").replace(/\s+/g, " ").trim();
      // For the handful of positions where the tool prints an em dash to mean
      // "the AI gave us nothing here". `mdText` stringifies, so `mdText(v) ||
      // "—"` cannot reach the dash for a falsy NON-string: `0` and `false`
      // printed as "0" and "false" in the Markdown while the screen and the
      // Word file both printed "—" for the same run.
      //
      // The truthiness test has to be on the ORIGINAL value, not on its type.
      // A `typeof v === "string"` gate sent every non-string to the dash,
      // including the truthy ones the other two surfaces print — so a
      // `population` returned as `["Adults with T2D", "aged 40 or older"]`
      // exported as "Population: —", the tool asserting it had been given
      // nothing about a field the model had filled, in a file whose companion
      // screen read "Adults with T2D,aged 40 or older". That is a worse lie
      // than the one it replaced, and `readList` two hundred lines up already
      // states the principle: read what is there, say what could not be read.
      // `v ? … : ""` gives exact parity with the `escapeHtml(v || "—")` on
      // screen and the `text(v || "—")` in Word, for every shape.
      const mdField = (v, dash) => (v ? mdText(v) : "") || dash;

      function downloadReport() {
        if (!lastReport) return;
        const { data, counts, fw, byId, caveats, delivRows, scheme, source } = lastReport;
        // The date the check RAN, not the date the button was pressed. A report
        // left on screen overnight and saved the next morning used to be dated
        // the next morning.
        const date = (source && source.date) || new Date().toISOString().slice(0, 10);
        let md = "![Population Health Data Center](" + LOGO_ABS + ")\n\n# " + fw.name + " conformance report\n\n_Population Health Data Center · checked " + date + " · AI-assisted self-check (Google Gemini) · not a substitute for peer review._\n\n";
        md += "**" + mdText(sourceLine(source)) + "**\n\n";
        // A report can be downloaded after the input it describes has been
        // changed. It is still a real report of a real run, so it is not
        // withheld — but it must not leave the browser looking like a report on
        // whatever the user has in the tool now.
        const stale = staleReasons();
        if (stale.length) {
          md += "> ### ⚠ This report was already out of date when it was downloaded\n>\n";
          // A tool sentence, but one carrying a file name off the user's disk.
          for (const r of stale) md += "> - " + mdText(r.file) + "\n";
          md += ">\n> It was **not** re-run. Every verdict below describes the input named above and nothing else.\n\n";
        }
        md += "**Tally:** " + counts.met + " met · " + counts.partial + " partial · " + counts.missing + " missing" +
          (counts.na ? " · " + counts.na + " N/A" : "") +
          (counts.unassessed ? " · " + counts.unassessed + " NOT ASSESSED" : "") +
          (counts.notscored ? " · " + counts.notscored + " NOT SCORED" : "") +
          " (" + counts.met + " of " + (counts.met + counts.partial + counts.missing) + " assessable items met)\n\n";
        md += summaryEl.textContent + "\n\n";
        // The frame the reader saw around the number travels with the number.
        for (const f of frameText()) md += "> " + f + "\n>\n";
        md += "\n";
        // Attributed, and below the tool's own count — not passed off as the
        // report's opening statement, which is where an unchecked model total
        // used to sit.
        if (data.summary) md += "**The AI's own summary**, quoted unchecked — any count or claim in it is the model's, not this tool's:\n\n> " + mdText(data.summary) + "\n\n";
        if (caveats && caveats.length) {
          md += "## What this check could not do\n\n";
          for (const c of caveats) md += "- " + mdText(c) + "\n";
          md += "\n";
        }
        // `scheme` is null when the screen refused to show a scheme at all. The
        // report must refuse it too, rather than printing a table of em-dashes
        // the reader will take for an answer.
        const d = scheme ? data.design : null;
        if (d) {
          md += "## Study design scheme\n\n";
          md += "_Drawn by this tool from the text. It is not evidence that the protocol contains a study-design diagram — see the verdict on that item. A window marked as assumed was not read from the protocol; the AI does not always declare an assumption, so an unmarked window is not a guarantee either._\n\n";
          md += "- **Design:** " + mdField(d.designType, "—") + "\n- **Population:** " + mdField(d.population, "—") + "\n- **Exposure:** " + mdField(d.exposure, "—") + "\n- **Comparator:** " + mdField(d.comparator, "—") + "\n- **Outcome:** " + mdField(d.outcome, "—") + "\n- **Index date:** " + mdField(d.indexDate, "—") + "\n\n";
          if (scheme.kept.length || scheme.dropped.length) {
            md += "Timeline (days relative to index):\n\n";
            // The windows the diagram drew, and the ones it could not — never the
            // raw list, which prints "day null → 0" for a window the report's own
            // caveats say was unusable.
            for (const w of scheme.kept) {
              const asm = assumedNote(w);
              md += "- " + mdText(w.label || w.kind) + ": day " + w.startDay + " → " + w.endDay +
                (asm ? " — DURATION ASSUMED BY THE AI (“" + mdText(asm) + "”), not stated in the text" : (w.note ? " (" + mdText(w.note) + ")" : "")) + "\n";
            }
            for (const x of scheme.dropped) md += "- " + mdText(x.name) + ": NOT USABLE — " + mdField(x.why, "no start/end day") + "; this window was not drawn and is not part of the scheme\n";
            md += "\n";
          }
          const critList = (title, key) => {
            const L = scheme.lists[key];
            md += "**" + title + ":** " + (L.items.length ? "\n" + L.items.map((x) => "  - " + mdText(x)).join("\n") : "none stated") + "\n";
            if (L.note) md += "  - _⚠ " + mdText(L.note) + "._\n";
            md += "\n";
          };
          critList("Inclusion", "inclusion");
          critList("Exclusion", "exclusion");
          critList("Covariates", "covariates");
        }
        if (Array.isArray(delivRows) && delivRows.length) {
          md += "## Planned outputs & figures (shell tables, Love plot, …)\n\n";
          // Read off the page, the way frameText() does for the score's framing
          // paragraphs: the export used to carry its own shorter sentence
          // ("“Absent” means the protocol does not pre-specify the output…"),
          // which defined the word one way while the screen defined it another.
          // Guarded the way frameText's `.filter(Boolean)` guards its own: if
          // the paragraph is ever renamed or removed, emit nothing rather than
          // a bare "__", which CommonMark renders as literal underscores.
          if (delivNoteText()) md += "_" + delivNoteText() + "_\n\n";
          for (const x of delivRows) {
            md += "- **" + mdText(x.name) + (x.extra ? delivExtraLabel : "") +
              (x.guessed ? mdText(delivGuessLabel(x.guessed)) : "") +
              "** — _" + ((DELIV_META[x.status] || DELIV_META.unassessed).label) + "_\n";
            if (x.evidence) md += "  - Evidence: " + mdText(x.evidence) + "\n";
            if (showSuggestion(x)) md += "  - Suggestion: " + mdText(suggestionText(x)) + "\n";
            if (showNaNote(x)) md += "  - " + NA_NOTE_LABEL + " " + mdText(suggestionText(x)) + "\n";
          }
          md += "\n";
        }
        for (const sec of fw.checklist) {
          md += "## " + sec.section + "\n\n";
          for (const it of sec.items) {
            const v = byId.get(it.id);
            md += "- **" + it.id + ". " + it.label + "** — _" + STATUS_META[v.status].label + "_\n";
            if (v.evidence) md += "  - Evidence: " + mdText(v.evidence) + "\n";
            if (showSuggestion(v)) md += "  - Suggestion: " + mdText(suggestionText(v)) + "\n";
            if (showNaNote(v)) md += "  - " + NA_NOTE_LABEL + " " + mdText(suggestionText(v)) + "\n";
          }
          md += "\n";
        }
        md += "---\n\n" + fw.name + ": " + fw.citation + " " + fw.url + "\n";
        const url = URL.createObjectURL(new Blob([md], { type: "text/markdown" }));
        const a = document.createElement("a");
        a.href = url; a.download = reportStem(fw, source, date) + ".md";
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }

      // ── Word (.docx) report, stamped with the PHDc logo ──
      async function loadLogo() {
        try { const r = await fetch(LOGO_URL); if (!r.ok) return null; return new Uint8Array(await r.arrayBuffer()); }
        catch { return null; }
      }

      async function downloadWord() {
        if (!lastReport) return;
        // Everything about this button's progress and failure belongs next to the
        // button. The library it needs is fetched from a CDN some institutional
        // proxies block, and that failure used to be reported only in #status,
        // far off the top of the screen, up to 20 seconds later.
        const wordBtn = $("downloadword"), dlErr = $("dlerr");
        dlErr.classList.add("hidden");
        wordBtn.disabled = true;
        const label = wordBtn.textContent;
        wordBtn.textContent = "Building…";
        setStatus("Building Word document…");
        try {
          await loadScript(DOCX);
          const D = window.docx;
          const { data, counts, fw, byId, caveats, delivRows, scheme, source } = lastReport;
          const date = (source && source.date) || new Date().toISOString().slice(0, 10);
          const FONT = "Calibri";
          const logo = await loadLogo();
          const text = (t, o = {}) => new D.TextRun({ text: String(t == null ? "" : t), font: FONT, size: 20, ...o });
          const para = (runs, o = {}) => new D.Paragraph({ children: Array.isArray(runs) ? runs : [runs], spacing: { before: 40, after: 40, ...(o.spacing || {}) }, ...o });
          const h1 = (t) => new D.Paragraph({ heading: D.HeadingLevel.HEADING_1, spacing: { before: 220, after: 80 }, children: [text(t, { bold: true, size: 26, color: "21443E" })] });
          const h2 = (t) => new D.Paragraph({ spacing: { before: 140, after: 40 }, children: [text(t, { bold: true, size: 21 })] });
          const STCOL = { met: "16A34A", partial: "D97706", missing: "DC2626", na: "64748B", unassessed: "94A3B8", notscored: "64748B", present: "16A34A", absent: "DC2626" };

          const children = [];
          if (logo) children.push(new D.Paragraph({ spacing: { after: 120 }, children: [new D.ImageRun({ data: logo, transformation: { width: 210, height: 51 } })] }));
          children.push(para([text(fw.name + " conformance report", { bold: true, size: 32 })], { spacing: { after: 40 } }));
          children.push(para([text("Population Health Data Center · checked " + date + " · AI-assisted self-check (Google Gemini) — not a substitute for peer review.", { italics: true, color: "777777", size: 16 })], { spacing: { after: 60 } }));
          children.push(para([text(sourceLine(source), { bold: true, size: 18 })], { spacing: { after: 160 } }));
          // Same refusal to mislead as the Markdown export: the report is not
          // withheld once the input has moved on, but it says so in the file.
          const staleW = staleReasons();
          if (staleW.length) {
            children.push(para([text("⚠ This report was already out of date when it was downloaded.", { bold: true, color: "8A5A00" })], { spacing: { before: 60 } }));
            for (const r of staleW) children.push(para([text("•  " + r.file, { color: "8A5A00", size: 18 })]));
            children.push(para([text("It was not re-run. Every verdict below describes the input named above and nothing else.", { color: "8A5A00", size: 18, italics: true })], { spacing: { after: 140 } }));
          }

          children.push(para([
            text("Tally: ", { bold: true }),
            text(counts.met + " met", { color: STCOL.met, bold: true }), text(" · "),
            text(counts.partial + " partial", { color: STCOL.partial, bold: true }), text(" · "),
            text(counts.missing + " missing", { color: STCOL.missing, bold: true }),
            ...(counts.na ? [text(" · " + counts.na + " N/A", { color: STCOL.na })] : []),
            ...(counts.unassessed ? [text(" · " + counts.unassessed + " NOT ASSESSED", { color: STCOL.unassessed, bold: true })] : []),
            ...(counts.notscored ? [text(" · " + counts.notscored + " NOT SCORED", { color: STCOL.notscored, bold: true })] : []),
            text("  —  " + counts.met + " of " + (counts.met + counts.partial + counts.missing) + " assessable items met."),
          ], { spacing: { after: 80 } }));
          children.push(para([text(summaryEl.textContent)], { spacing: { after: 80 } }));
          // The frame the reader saw around the number travels with the number.
          for (const f of frameText()) children.push(para([text(f, { size: 17, color: "555555", italics: true })]));
          if (data.summary) {
            children.push(para([text("The AI's own summary, quoted unchecked — any count or claim in it is the model's, not this tool's:", { bold: true, size: 18 })], { spacing: { before: 140 } }));
            children.push(para([text("“" + data.summary + "”", { italics: true })], { spacing: { after: 80 } }));
          }

          if (caveats && caveats.length) {
            children.push(h1("What this check could not do"));
            for (const c of caveats) children.push(para([text("•  " + c, { size: 18, color: "8A5A00" })]));
          }

          const d = scheme ? data.design : null;
          if (d) {
            children.push(h1("Study design scheme"));
            children.push(para([text("Drawn by this tool from the text. It is not evidence that the protocol contains a study-design diagram — see the verdict on that item. A window marked as assumed was not read from the protocol; the AI does not always declare an assumption, so an unmarked window is not a guarantee either.", { italics: true, size: 16, color: "777777" })]));
            const field = (k, v) => para([text(k + ": ", { bold: true }), text(v || "—")]);
            children.push(field("Design", d.designType));
            children.push(field("Population", d.population));
            children.push(field("Exposure", d.exposure));
            children.push(field("Comparator", d.comparator));
            children.push(field("Outcome", d.outcome));
            children.push(field("Index date (time zero)", d.indexDate));
            if (scheme.kept.length || scheme.dropped.length) {
              children.push(h2("Timeline (days relative to index)"));
              for (const w of scheme.kept) {
                const asm = assumedNote(w);
                children.push(para([
                  text("•  " + (w.label || w.kind) + ": day " + w.startDay + " → " + w.endDay + (!asm && w.note ? " (" + w.note + ")" : "")),
                  ...(asm ? [text("  — duration assumed by the AI (“" + asm + "”), not stated in the text", { color: "8A5A00", bold: true })] : []),
                ]));
              }
              for (const x of scheme.dropped) {
                children.push(para([
                  text("•  " + x.name + ": "),
                  text("NOT USABLE — " + (x.why || "no start/end day") + "; not drawn and not part of the scheme", { color: "DC2626", bold: true }),
                ]));
              }
            }
            const critBlock = (title, key) => {
              const L = scheme.lists[key];
              children.push(h2(title));
              if (L.items.length) for (const x of L.items) children.push(para([text("•  " + x)]));
              else children.push(para([text("none stated", { italics: true, color: "999999" })]));
              if (L.note) children.push(para([text("⚠ " + L.note + ".", { size: 17, color: "8A5A00", italics: true })]));
            };
            critBlock("Inclusion criteria", "inclusion");
            critBlock("Exclusion criteria", "exclusion");
            critBlock("Covariates", "covariates");
          }

          if (Array.isArray(delivRows) && delivRows.length) {
            children.push(h1("Planned outputs & figures"));
            if (delivNoteText()) children.push(para([text(delivNoteText(), { italics: true, size: 16, color: "777777" })]));
            for (const x of delivRows) {
              const lab = (DELIV_META[x.status] || DELIV_META.unassessed).label;
              children.push(para([
                text(x.name + (x.extra ? delivExtraLabel : "") + (x.guessed ? delivGuessLabel(x.guessed) : "") + " — ", { bold: true }),
                text(lab, { color: STCOL[x.status] || STCOL.unassessed, bold: true })]));
              if (x.evidence) children.push(para([text("Evidence: " + x.evidence, { size: 18, color: "555555" })]));
              if (showSuggestion(x)) children.push(para([text("Suggestion: " + suggestionText(x), { size: 18, color: "555555" })]));
              if (showNaNote(x)) children.push(para([text(NA_NOTE_LABEL + " " + suggestionText(x), { size: 18, color: "777777" })]));
            }
          }

          for (const sec of fw.checklist) {
            children.push(h1(sec.section));
            for (const it of sec.items) {
              const v = byId.get(it.id);
              const lab = STATUS_META[v.status].label;
              children.push(para([text(it.id + ". " + it.label + "  ", { bold: true }), text("[" + lab + "]", { color: STCOL[v.status] || STCOL.unassessed, bold: true })]));
              if (v.evidence) children.push(para([text("Evidence: " + v.evidence, { size: 18, color: "555555" })]));
              if (showSuggestion(v)) children.push(para([text("Suggestion: " + suggestionText(v), { size: 18, color: "555555" })]));
              if (showNaNote(v)) children.push(para([text(NA_NOTE_LABEL + " " + suggestionText(v), { size: 18, color: "777777" })]));
            }
          }
          children.push(para([text(fw.name + ": " + fw.citation + " " + fw.url, { italics: true, size: 16, color: "777777" })], { spacing: { before: 300 } }));

          const doc = new D.Document({
            creator: "PHDc Protocol Checker",
            title: fw.name + " conformance report",
            styles: { default: { document: { run: { font: FONT, size: 20 } } } },
            sections: [{ properties: {}, children }],
          });
          const blob = await D.Packer.toBlob(doc);
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url; a.download = reportStem(fw, source, date) + ".docx";
          document.body.appendChild(a); a.click(); a.remove();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
          setStatus("");
        } catch (e) {
          const msg = "The Word file could not be built. " + (e && e.message ? e.message : String(e)) +
            " The Markdown report next to this button is produced entirely in your browser and does not need it.";
          dlErr.textContent = msg;
          dlErr.classList.remove("hidden");
          setStatus("");
        } finally {
          wordBtn.disabled = false;
          wordBtn.textContent = label;
        }
      }

      // Plain-language line under the framework picker: which guideline this is,
      // and what kind of document it was written for. Beginners pick TARGET for a
      // protocol without realising it is a guideline for finished papers.
      function refreshFrameworkNote() {
        const fw = fwOf(getFramework());
        const kindLine = fw.kind === "protocol template"
          ? "a protocol template — it asks whether each element is written down and operationally defined before the study runs."
          : "a reporting guideline for a completed study — on an unpublished protocol its results and discussion items describe what you will have to report later, not what you have done.";
        fwNoteEl.innerHTML = "<strong>" + escapeHtml(fw.name) + "</strong> is " + kindLine +
          ' <a class="text-brand-700 hover:underline" href="' + escapeHtml(fw.url) + '" target="_blank" rel="noopener">Source ↗</a>' +
          // Said BEFORE the request is spent, not only afterwards. Checking a
          // protocol against a reporting guideline reliably returns a near-perfect
          // score, because "a flow diagram is planned" reads as the item being met.
          (fw.kind === "protocol template" ? "" :
            '<br><span class="text-amber-800">⚠ If what you are checking is a <strong>protocol</strong> rather than a finished paper, expect a near-perfect score that means very little — ' +
            escapeHtml(fw.name) + ' asks for results you have not produced yet. Check a protocol against ' +
            escapeHtml(FRAMEWORKS[DEFAULT_FRAMEWORK].name) + ' instead.</span>');
      }
      // Moving the picker used to change nothing but this note: the results card
      // below went on reading "HARPER conformance", and the download button went
      // on producing a HARPER file, while the picker said TARGET.
      document.querySelectorAll('input[name="framework"]').forEach((r) => r.addEventListener("change", () => {
        refreshFrameworkNote();
        refreshStaleness();
      }));
      refreshFrameworkNote();

      checkBtn.addEventListener("click", () => runCheck(getFramework()));
      $("downloadword").addEventListener("click", downloadWord);
      alsoTargetBtn.addEventListener("click", () => {
        const r = document.querySelector('input[name="framework"][value="target"]');
        if (r) r.checked = true;
        refreshFrameworkNote();
        runCheck("target");
      });
      clearBtn.addEventListener("click", () => {
        resetFileInput();
        textEl.value = ""; lastReport = null;
        fileErr.classList.add("hidden");
        $("dlerr").classList.add("hidden");
        resultsEl.classList.add("hidden"); runErrEl.classList.add("hidden"); tteEl.classList.add("hidden");
        refreshInputNote(); setStatus("");
      });
      $("download").addEventListener("click", downloadReport);
    </script>
  )}
</BaseLayout>
