---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Networks, centres, and collaborations Daniel works within. Modelled on the
// AsPEN site's "open source / friendship links" page. `image` is a path under
// public/images/. `heightClass` tunes
// each logo so they read at a similar visual scale despite different aspects.
const networks = [
  {
    name: "Population Health Data Center, NCKU",
    href: "https://www.phdcenter.org.tw/",
    image: "networks/phdc.png",
    heightClass: "max-h-20",
    tagline:
      "PHDc at National Cheng Kung University — Daniel's home centre and the data infrastructure behind much of his Taiwan-based real-world-evidence work.",
    taglineZh:
      "成大群體健康數據中心（PHDc）是我所在的研究中心，我在台灣做的 real-world evidence 研究，多數建立在這裡的資料基礎建設上。",
  },
  {
    name: "Asian Pharmacoepidemiology Network",
    href: "https://www.aspensig.asia/",
    image: "networks/aspen.png",
    heightClass: "max-h-32",
    tagline:
      "AsPEN — a Special Interest Group of ISPE advancing multi-national database research across the Asia/Pacific region, where Daniel serves as Chair, after two years as education co-lead (2024–2026).",
    taglineZh:
      "AsPEN 是 ISPE 的 Special Interest Group，推動亞太地區的跨國資料庫研究。我在 2024–2026 年擔任 education co-lead，現任 Chair。",
  },
  {
    name: "NeuroGEN",
    href: "https://neurogen.hku.hk/",
    image: "networks/neurogen.png",
    heightClass: "max-h-20",
    tagline:
      "The Neurological and mental health Global Epidemiology Network — a multi-database platform spanning Asia, Oceania, Europe, and North America, where Daniel is an active member and led the development of its data repository in 2023.",
    taglineZh:
      "NeuroGEN（Neurological and mental health Global Epidemiology Network）是橫跨亞洲、大洋洲、歐洲與北美的多資料庫平台。我是成員之一，並在 2023 年主導建置它的 data repository。",
  },
  {
    name: "DARWIN EU",
    href: "https://www.darwin-eu.org/",
    image: "networks/darwin-eu.png",
    heightClass: "max-h-32",
    tagline:
      "Data Analysis and Real World Interrogation Network — the European Medicines Agency's federated real-world-evidence network.",
    taglineZh:
      "DARWIN EU（Data Analysis and Real World Interrogation Network）是歐洲藥品管理局（EMA）的聯邦式 real-world evidence 網絡。",
  },
];
---

<BaseLayout
  title="Networks & collaborations — Daniel Tsai"
  titleZh="合作網絡｜蔡相德 Daniel Tsai"
  description="The networks, centres, and collaborations Daniel Tsai works within: PHDc, AsPEN, NeuroGEN, and DARWIN EU."
  descriptionZh="蔡相德參與的研究中心與合作網絡：PHDc、AsPEN、NeuroGEN 與 DARWIN EU。"
>
  <PageHeader
    eyebrow="Collaborations"
    eyebrowZh="合作"
    title="Networks"
    titleZh="合作網絡"
    description="The networks, centres, and collaborations I work within."
    descriptionZh="我參與的研究中心與合作網絡。"
  />

  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid gap-6 sm:grid-cols-2">
      {networks.map((n) => (
        <a href={n.href} target="_blank" rel="noopener noreferrer"
           class="group flex flex-col border border-slate-200 rounded-2xl p-8 bg-white hover:shadow-md hover:border-brand-400 transition">
          <div class="h-36 flex items-center">
            <img src={`${base}/images/${n.image}`} alt={n.name} class:list={[n.heightClass, "w-auto max-w-full object-contain"]} />
          </div>
          <p class="mt-6 text-sm text-slate-700 leading-relaxed flex-1"><span class="l-en">{n.tagline}</span><span class="l-zh">{n.taglineZh}</span></p>
          <p class="mt-4 text-xs text-brand-700 font-semibold group-hover:underline">
            {n.href.replace(/^https?:\/\//, "").replace(/\/$/, "")} ↗
          </p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-16 -mt-6">
    <p class="text-sm text-slate-600">
      <span class="l-en">Which countries and databases my papers draw on is shown on the</span><span class="l-zh">我的論文用過哪些國家與資料庫，請看首頁的</span>
      <a href={`${base}/#map`} class="font-semibold text-brand-700 hover:underline"><span class="l-en">research map on the home page</span><span class="l-zh">研究地圖</span> →</a>
    </p>
  </section>
</BaseLayout>
