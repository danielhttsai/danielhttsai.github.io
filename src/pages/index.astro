---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchMap from "../components/ResearchMap.astro";
import type { Pub } from "../components/PublicationItem.astro";
import pubs from "../data/publications.json";
import metrics from "../data/metrics.json";
import social from "../data/social-posts.json";
import { MAP_STATS } from "../data/research";
import { toolsList } from "../data/tools";
import StatsBar from "../components/StatsBar.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Featured paper for the home "Latest" band — the flagship first-author study.
// Pulled live from publications.json so its links/format stay in sync.
const FEATURED_DOI = "10.1192/bjp.2024.283";
const featured = (pubs as Pub[]).find((p) => p.doi.toLowerCase() === FEATURED_DOI);

// The two newest posts in each language's feed (LinkedIn on the English page,
// Facebook on the Chinese one), shown as plain text cards: the embeds
// themselves live on /posts, where their weight is expected.
const fmt = (d: string, zh = false) => {
  const [y, m, day] = d.split("-").map(Number);
  return zh ? `${y} 年 ${m} 月 ${day} 日` : new Date(Date.UTC(y, m - 1, day)).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
};
const latestEn = social.linkedin.slice(0, 2);
const latestZh = social.facebook.slice(0, 2);

const skills = [
  { group: "Statistical computing", groupZh: "統計軟體", items: [["SAS", "SAS"], ["Stata", "Stata"], ["SPSS", "SPSS"], ["R", "R"]] },
  { group: "Methods", groupZh: "研究方法", items: [["Comparative effectiveness", "Comparative effectiveness"], ["Causal inference", "因果推論"], ["Target trial emulation", "Target trial emulation"], ["Self-controlled designs", "Self-controlled designs"]] },
  { group: "Data", groupZh: "資料", items: [["Claims databases (NHIRD, 20M+)", "健保申報資料庫（NHIRD，超過 2,000 萬人）"], ["Electronic health records", "電子病歷"], ["Biomedical / registry linkage", "生物資料庫與登錄資料串聯"]] },
  { group: "Domains", groupZh: "研究領域", items: [["Pharmacoepidemiology", "藥物流行病學"], ["Policy research", "政策研究"], ["AI × geriatric medicine", "AI × 高齡醫學"]] },
];

const tools = [
  {
    name: "Protocol Generator",
    blurb:
      "Build a publication-ready pharmacoepidemiology protocol (ACNU, case-crossover, descriptive, or self-controlled case-series) with a phenotype library that says which definitions carry a validation study, feasibility checks across Asian databases, and one-click Word / Markdown export.",
    blurbZh:
      "草擬可直接投稿的藥物流行病學研究計畫書（ACNU、case-crossover、描述性分析或 self-controlled case series）。Phenotype library 會標出哪些定義有 validation study，並檢查亞洲各資料庫是否做得到，一鍵匯出 Word 或 Markdown。",
    href: `${base}/tools/protocol-generator`,
    cta: "Open the tool",
    ctaZh: "打開工具",
    external: false,
    tag: "Design Infrastructure",
    tagZh: "研究設計",
  },
  {
    name: "Protocol Checker",
    blurb:
      "The flip side of the generator: upload an existing protocol and get an AI-assisted, item-by-item read on whether it conforms to HARPER (the ISPE/ISPOR protocol template) or TARGET — with an auto-drawn study-design scheme, a planned-outputs review, and fixes for anything missing.",
    blurbZh:
      "Generator 的反面：上傳一份現成的計畫書，由 AI 協助逐項檢查是否符合 HARPER（ISPE／ISPOR 的計畫書範本）或 TARGET，並自動畫出 study design 示意圖、檢視預定產出，缺什麼就告訴你怎麼補。",
    href: `${base}/tools/protocol-checker`,
    cta: "Open the checker",
    ctaZh: "打開 Checker",
    external: false,
    tag: "Design Infrastructure",
    tagZh: "研究設計",
  },
  {
    name: "RWE Studio",
    blurb:
      "Upload a small, messy hospital dataset and — entirely in your browser — profile and clean it into a tidy master file, map columns to a study design (with AI causal-covariate triage), and run the analysis in real R via WebR. Nothing is uploaded.",
    blurbZh:
      "上傳一份小而亂的醫院資料，全程在瀏覽器裡完成：盤點並清理成整齊的主檔，把欄位對應到研究設計（AI 協助判斷哪些共變項該放），再透過 WebR 用真正的 R 執行分析。資料不會上傳。",
    href: `${base}/tools/rwe-studio`,
    cta: "Open RWE Studio",
    ctaZh: "打開 RWE Studio",
    external: false,
    tag: "Analysis Infrastructure",
    tagZh: "資料分析",
  },
  {
    name: "PHDc RWE Toolbox",
    blurb:
      "A real-world-evidence utility from the Population Health Data Center for exploring and operationalising claims-based study designs.",
    blurbZh:
      "成大群體健康數據中心（PHDc）開發的 real-world evidence 工具，用來了解並實際操作以健保申報資料為基礎的研究設計。",
    href: `${base}/tools/phdc-rwe-tool`,
    cta: "Launch the toolbox",
    ctaZh: "打開工具箱",
    external: false,
    tag: "RWE utility",
    tagZh: "RWE 工具",
  },
  {
    name: "NHIRD Data Dictionary",
    blurb:
      "A searchable codebook for Taiwan's NHIRD and Health & Welfare Data Center datasets — variables, formats, and cross-dataset linkages, structured on the DIVERSE data-source framework.",
    blurbZh:
      "可搜尋的 codebook，涵蓋台灣 NHIRD 與衛生福利資料科學中心的資料檔：變項、格式，以及檔案之間怎麼串聯，依 DIVERSE 資料來源架構整理。",
    href: "https://danielhttsai.github.io/nhird-data-dictionary/",
    cta: "Open the dictionary",
    ctaZh: "打開資料字典",
    external: false,
    tag: "Data Infrastructure",
    tagZh: "資料基礎建設",
  },
  {
    name: "ACB Calculator",
    blurb:
      "Scores a patient's total anticholinergic burden across 6 international scales and quantifies 30-day risk of cardiovascular events, pneumonia, and out-of-hospital cardiac arrest — with OCR drug-history capture and printable reports. Built on three Taiwan NHI studies (BMJ, Clin Epidemiol, Eur Heart J).",
    blurbZh:
      "用 6 種國際量表計算病人的 anticholinergic burden 總分，並量化 30 天內發生心血管事件、肺炎與到院前心跳停止的風險；可用 OCR 擷取用藥紀錄，也能列印報告。根據三篇台灣健保研究（BMJ、Clin Epidemiol、Eur Heart J）。",
    href: `${base}/tools/acb-calculator`,
    cta: "Open ACB calculator",
    ctaZh: "打開 ACB 計算機",
    external: false,
    tag: "Clinical tool",
    tagZh: "臨床工具",
  },
];
---

<BaseLayout
  tint={true}
  descriptionZh="蔡相德（Daniel Tsai）是成大群體健康數據中心（PHDc）的博士後研究員，專長為 comparative effectiveness research、因果推論，以及 real-world evidence 的工具與基礎建設。"
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-20 pb-16">
    <div class="grid md:grid-cols-[1fr_auto] gap-8 md:gap-12 items-center">
      <img
        src={`${base}/images/daniel-cartoon.png`}
        alt="Cartoon portrait of Daniel Tsai"
        width="500" height="880"
        class="order-1 md:order-2 h-44 md:h-64 lg:h-72 w-auto justify-self-start md:justify-self-end"
      />
      <div class="order-2 md:order-1">
        <p class="uppercase tracking-widest text-xs text-brand-600 font-semibold mb-3">
          <span class="l-en">Pharmacoepidemiology · Real-World Evidence</span><span class="l-zh">藥物流行病學 · Real-World Evidence</span>
        </p>
        <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 leading-tight">
          <span class="l-en">Daniel Tsai</span><span class="l-zh">蔡相德 <span class="text-slate-500 font-bold text-2xl md:text-3xl align-middle">Daniel Tsai</span></span>
        </h1>
        <p class="mt-5 text-lg md:text-xl text-slate-700 max-w-2xl leading-relaxed font-medium">
          <span class="l-en">Building the <strong class="text-brand-700">infrastructure for real-world evidence</strong> — the tools, methods, and multi-country data networks that turn routine health data into causal answers.</span>
          <span class="l-zh">打造<strong class="text-brand-700">真實世界證據的基礎建設</strong>：用工具、方法與跨國資料網絡，把日常累積的健康資料變成因果問題的答案。</span>
        </p>
        <p class="mt-4 text-base text-slate-600 max-w-2xl leading-relaxed">
          <span class="l-en">Postdoctoral research fellow at the <a href="https://www.phdcenter.org.tw/" target="_blank" rel="noopener" class="text-brand-700 font-semibold hover:underline">Population Health Data Center (PHDc), NCKU</a>, specialising in comparative effectiveness and policy research. Chair of <strong class="text-slate-800">AsPEN</strong> and active member of <strong class="text-slate-800">NeuroGEN</strong>.</span>
          <span class="l-zh"><a href="https://www.phdcenter.org.tw/" target="_blank" rel="noopener" class="text-brand-700 font-semibold hover:underline">成大群體健康數據中心（PHDc）</a>博士後研究員，專長為 comparative effectiveness research 與政策研究。現任 <strong class="text-slate-800">AsPEN</strong> Chair，也是 <strong class="text-slate-800">NeuroGEN</strong> 的成員。</span>
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}/tools/protocol-generator`} class="bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-3 rounded-xl transition shadow-sm">
            <span class="l-en">Try the Protocol Generator</span><span class="l-zh">試用 Protocol Generator</span> →
          </a>
          <a href={`${base}/about`} class="bg-white border border-slate-300 text-slate-700 hover:border-brand-600 hover:text-brand-700 font-semibold px-6 py-3 rounded-xl transition">
            <span class="l-en">About me &amp; publications</span><span class="l-zh">關於我與論文</span>
          </a>
        </div>
        <div class="mt-8 flex items-center gap-5">
          <a href="mailto:danielhttsai@gmail.com" aria-label="Email" title="Email" class="text-[#EA4335] hover:opacity-75 transition">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"/></svg>
          </a>
          <a href="https://scholar.google.com/citations?user=3IxiZOoAAAAJ" target="_blank" rel="noopener" aria-label="Google Scholar" title="Google Scholar" class="text-[#4285F4] hover:opacity-75 transition">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
          </a>
          <a href="https://orcid.org/0000-0003-2841-0338" target="_blank" rel="noopener" aria-label="ORCID" title="ORCID" class="text-[#A6CE39] hover:opacity-75 transition">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/daniel-hsiang-te-tsai/" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn" class="text-[#0A66C2] hover:opacity-75 transition">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest / featured paper -->
  {featured && (
    <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pb-4">
      <div class="rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-50 to-white p-6 sm:p-8">
        <div class="flex items-center justify-between gap-4 flex-wrap mb-4">
          <p class="text-sm font-bold text-brand-700">📰 <span class="l-en">Fresh off the press</span><span class="l-zh">最新發表</span></p>
          <a href={`${base}/publications`} class="text-sm font-semibold text-brand-700 hover:underline"><span class="l-en">All publications</span><span class="l-zh">所有論文</span> →</a>
        </div>
        <div class="flex flex-col sm:flex-row gap-6 items-start">
          <a href={`https://doi.org/${featured.doi}`} target="_blank" rel="noopener" class="shrink-0 self-center sm:self-start">
            <img
              src={`${base}/images/papers/trd-ap.jpg`}
              alt="First page of the British Journal of Psychiatry article"
              width="144" height="204"
              class="w-32 sm:w-36 rounded-lg shadow-md ring-1 ring-slate-200 hover:shadow-lg transition"
            />
          </a>
          <div class="flex-1 min-w-0">
            <p class="text-slate-700 leading-relaxed">
              <span class="l-en">Latest study in the <strong class="text-slate-900">British Journal of Psychiatry</strong></span>
              <span class="l-zh">最新研究刊登於 <strong class="text-slate-900">British Journal of Psychiatry</strong></span>
            </p>
            <p class="mt-1 mb-3 text-sm text-slate-600 leading-relaxed">
              <span class="l-en">A target trial emulation across Taiwan's National Health Insurance data examining how antipsychotic augmentation relates to suicide risk in treatment-resistant depression.</span>
              <span class="l-zh">以台灣全民健保資料進行 target trial emulation，探討治療抗性憂鬱症合併使用抗精神病藥物與自殺風險的關係。</span>
            </p>
            <a href={`https://doi.org/${featured.doi}`} target="_blank" rel="noopener" class="inline-block text-sm font-semibold text-brand-700 hover:underline"><span class="l-en">Read the paper</span><span class="l-zh">閱讀論文</span> →</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Numbers: all computed from the site's own data at build time -->
  <StatsBar stats={[
    { value: pubs.length, label: { en: "Publications", zh: "論文" } },
    { value: Number(metrics.citations), label: { en: "Citations", zh: "被引用次數" } },
    { value: Number(metrics.hIndex), label: { en: "h-index", zh: "h-index" } },
    { value: MAP_STATS.countries, label: { en: "Countries and regions", zh: "國家與地區" }, sublabel: { en: "with person-level data", zh: "個人層級資料" } },
    { value: toolsList(base).length, label: { en: "Open tools", zh: "開放工具" }, sublabel: { en: "free, in the browser", zh: "免費、在瀏覽器執行" } },
  ]} />

  <!-- Skills -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-2xl font-bold text-slate-900"><span class="l-en">Technical expertise</span><span class="l-zh">專業技能</span></h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {skills.map((s) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="font-bold text-slate-900"><span class="l-en">{s.group}</span><span class="l-zh">{s.groupZh}</span></h3>
          <ul class="mt-3 space-y-1.5">
            {s.items.map(([en, zh]) => (
              <li class="text-sm text-slate-600 flex gap-2">
                <span class="text-brand-500 mt-0.5">▸</span><span><span class="l-en">{en}</span><span class="l-zh">{zh}</span></span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- RWE Tools -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-2xl font-bold text-slate-900"><span class="l-en">RWE tools</span><span class="l-zh">RWE 工具</span></h2>
    <p class="mt-2 text-slate-600 max-w-2xl">
      <span class="l-en">Open-access utilities I build and maintain for real-world-evidence research — each runs right here on this site.</span>
      <span class="l-zh">我開發並維護的 real-world evidence 開放工具，每一個都能直接在本站使用。</span>
    </p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((t) => (
        <a
          href={t.href}
          target={t.external ? "_blank" : undefined}
          rel={t.external ? "noopener" : undefined}
          class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:border-brand-400 transition"
        >
          <span class="self-start text-[11px] uppercase tracking-wide font-semibold text-brand-600 bg-brand-50 rounded-full px-2.5 py-1"><span class="l-en">{t.tag}</span><span class="l-zh">{t.tagZh}</span></span>
          <h3 class="mt-4 text-lg font-bold text-slate-900 group-hover:text-brand-700">{t.name}</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed flex-1"><span class="l-en">{t.blurb}</span><span class="l-zh">{t.blurbZh}</span></p>
          <span class="mt-5 text-sm font-semibold text-brand-700"><span class="l-en">{t.cta}</span><span class="l-zh">{t.ctaZh}</span> {t.external ? "↗" : "→"}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Research map: lives here and nowhere else (links elsewhere point at /#map) -->
  <section id="map" class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 scroll-mt-20">
    <h2 class="text-2xl font-bold text-slate-900"><span class="l-en">Research map</span><span class="l-zh">研究地圖</span></h2>
    <p class="mt-2 text-slate-600 max-w-2xl">
      <span class="l-en">The countries and databases behind my published papers: {MAP_STATS.databases} data sources in {MAP_STATS.countries} countries and regions. Pick a bubble to see its databases and papers.</span>
      <span class="l-zh">我已發表論文用過的國家與資料庫：{MAP_STATS.countries} 個國家與地區、{MAP_STATS.databases} 個資料來源。點一個圓，就能看到那裡的資料庫和論文。</span>
    </p>
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 sm:p-6 shadow-sm">
      <ResearchMap />
    </div>
  </section>

  <!-- Latest posts (LinkedIn on the English page, Facebook on the Chinese one) -->
  {(latestEn.length > 0 || latestZh.length > 0) && (
    <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex items-baseline justify-between gap-4 flex-wrap">
        <h2 class="text-2xl font-bold text-slate-900"><span class="l-en">Latest posts</span><span class="l-zh">最新貼文</span></h2>
        <a href={`${base}/posts`} class="text-sm font-semibold text-brand-700 hover:underline"><span class="l-en">All posts</span><span class="l-zh">所有貼文</span> →</a>
      </div>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 l-en">
        {latestEn.map((p) => (
          <a href={`${base}/posts`} class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:border-brand-400 transition">
            <div class="flex flex-wrap items-center gap-2 text-[11px] mb-2">
              <span class="rounded-full bg-brand-50 text-brand-700 font-semibold px-2 py-0.5">LinkedIn</span>
              <span class="text-slate-500">{fmt(p.date)}</span>
            </div>
            <p class="text-sm text-slate-700 leading-relaxed flex-1 line-clamp-4">{p.text}</p>
            <span class="mt-4 text-sm font-semibold text-brand-700 group-hover:underline">Read →</span>
          </a>
        ))}
        {latestEn.length === 0 && (
          <a href={social.profiles.linkedin} target="_blank" rel="noopener" class="text-sm font-semibold text-brand-700 hover:underline">Follow me on LinkedIn ↗</a>
        )}
      </div>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 l-zh">
        {latestZh.map((p) => (
          <a href={`${base}/posts`} class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:border-brand-400 transition">
            <div class="flex flex-wrap items-center gap-2 text-[11px] mb-2">
              <span class="rounded-full bg-brand-50 text-brand-700 font-semibold px-2 py-0.5">Facebook</span>
              <span class="text-slate-500">{fmt(p.date, true)}</span>
            </div>
            <p class="text-sm text-slate-700 leading-relaxed flex-1 line-clamp-4">{p.text}</p>
            <span class="mt-4 text-sm font-semibold text-brand-700 group-hover:underline">閱讀全文 →</span>
          </a>
        ))}
        {latestZh.length === 0 && (
          <a href={social.profiles.facebook} target="_blank" rel="noopener" class="text-sm font-semibold text-brand-700 hover:underline">到 Facebook 追蹤我 ↗</a>
        )}
      </div>
    </section>
  )}

